// The import list's one script: it fills when an import reports, and comes
// down on its own clock once the last of the batch has been over a while.

use editor;

pub class Imports {
    node: Node,
    editor: editor::Editor?,
    until: float,
}

impl Imports {
    pub fn init() {
        let source = scene::get_node("Editor");
        self.editor = source.script;
        self.until = 0.0;
        events::listen(self.node, "assets_changed", source);
    }

    pub fn on_assets_changed(_change: any) {
        self.refresh();
    }

    /// The clock: the frame the repaint it asked for ran, once the list is due
    /// to come down.
    pub fn update(_delta_time: float) {
        if self.until > 0.0 && engine::unix_time() >= self.until {
            self.refresh();
        }
    }

    fn refresh() {
        let view = self.editor.unwrap().imports_fill();
        self.node.set_visible(view.shown);
        let bar = self.node.get_node("Bar");
        bar.set_visible(view.bar);
        bar.widget_range.value = view.value;
        self.until = view.until;
        if view.until > 0.0 {
            ui::request_repaint(ui::RepaintOptions { after: view.until - engine::unix_time() + 0.05 });
        }
    }
}
