// The import list's one script: it fills when an import reports, and comes
// down on its own clock once the last of the batch has been over a while.

pub class Imports {
    node: Node,
    editor: Node,
    until: float,
}

impl Imports {
    pub fn init() {
        self.editor = scene::get_node("Editor");
        self.until = 0.0;
        events::listen(self.node, "assets_changed", self.editor);
    }

    pub fn on_assets_changed(_change: any) {
        self.refresh();
    }

    /// The clock: the frame the repaint it asked for ran, once the list is due
    /// to come down.
    pub fn update(_dt: float) {
        if self.until > 0.0 && engine::unix_time() >= self.until {
            self.refresh();
        }
    }

    fn refresh() {
        let view = self.editor.call("imports_fill");
        if !(view.kind() == "map") {
            return;
        }
        self.node.patch_component("widget", map().with("visible", view.get("shown")));
        self.node.get_node("Bar").patch_component("widget", map().with("visible", view.get("bar")).with("value", view.get("value")));
        self.until = view.get("until").as_float();
        if view.get("until").as_float() > 0.0 {
            ui::request_repaint(map().with("after", view.get("until").as_float() - engine::unix_time() + 0.05));
        }
    }
}
