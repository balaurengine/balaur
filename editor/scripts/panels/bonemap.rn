// The Bone map tab's one script: the Editor fills it when the map or the
// selection moved, and it hands back the verbs. A row's own buttons pick,
// open and empty it.

const VERBS = ["guess", "clear", "save"];

pub fn init(this) {
    this.editor = scene::get_node("Editor");
    for word in ["bonemap_changed", "outline_changed"] {
        events::listen(this.node, word, this.editor);
    }
}

pub fn on_bonemap_changed(this, _change) {
    refresh(this);
}

pub fn on_outline_changed(this, _change) {
    refresh(this);
}

pub fn on_widget_event(this, event, node, value) {
    if event == "click" {
        for verb in VERBS {
            if node.name() == verb {
                this.editor.call("bonemap_verb", verb);
            }
        }
    }
}

/// Fill what shows: on a word, and from the dock once it is visible.
pub fn refresh(this) {
    if this.node.get_component("widget", "visible") == false {
        return;
    }
    this.editor.call("bonemap_fill");
}
