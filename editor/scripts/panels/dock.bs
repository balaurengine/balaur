// A dock's one script: its tab row and which of its panels shows. One file
// for the three docks, each told its side by the node it is on; the Editor
// owns which panels a dock holds and fills its row when asked.

use editor;
use signals;
use words::sides;

pub class Dock {
    node: Node,
    side: str,
    editor: editor::Editor?,
}

fn side_of(name: str) -> str {
    if name == "LeftSheet" {
        sides::LEFT
    } else if name == "RightSheet" {
        sides::RIGHT
    } else {
        sides::BOTTOM
    }
}

impl Dock {
    pub fn init() {
        self.side = side_of(self.node.name());
        let source = scene::root().get_node("Editor");
        self.editor = source.script;
        events::listen(self.node, signals::DOCKS, source);
    }

    pub fn on_docks_changed(_change: any) {
        // A panel this shows fills on the same word, heard after this: it
        // listened once its dock had, as the dock's child.
        self.editor.unwrap().dock_fill(self.side);
    }

    /// A tab's name pressed, by the tile it sits in.
    pub fn tab_picked(_value: any, node: Node) {
        self.editor.unwrap().dock_tab_picked(self.side, node.parent().name());
    }

    /// A tab's close mark pressed.
    pub fn tab_closed(_value: any, node: Node) {
        self.editor.unwrap().dock_tab_closed(node.parent().name());
    }

    /// A panel picked from "+N", by its name.
    pub fn more_picked(value: any) {
        self.editor.unwrap().dock_more_picked(self.side, value.as_str());
    }

    /// The fold, which shuts this dock to its handle.
    pub fn fold(_value: any, _node: Node) {
        self.editor.unwrap().dock_folded(self.side);
    }
}
