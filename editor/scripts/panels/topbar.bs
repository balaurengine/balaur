// The top bar's one script: the brand, its menu and the strip, filled by the
// Editor when what they show moved. A control's own handler runs first, then
// the bar fills again to show what it changed.

use editor;

pub class Topbar {
    node: Node,
    editor: editor::Editor?,
}

impl Topbar {
    pub fn init() {
        let source = scene::get_node("Editor");
        self.editor = source.script;
        events::listen(self.node, "chrome_changed", source);
    }

    pub fn on_chrome_changed(_change: any) {
        self.editor.unwrap().chrome_fill();
    }

    pub fn refill() {
        self.editor.unwrap().chrome_fill();
    }
}
