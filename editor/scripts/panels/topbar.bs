// The top bar's one script: the brand, its menu and the strip, filled by the
// Editor when what they show moved. A control's own handler runs first, then
// the bar fills again to show what it changed.

use editor;
use signals;

pub class Topbar {
    node: Node,
    editor: editor::Editor?,
}

impl Topbar {
    pub fn init() {
        let source = scene::root().get_node("Editor");
        self.editor = source.script;
        events::listen(self.node, signals::CHROME, source);
    }

    pub fn on_chrome_changed(_change: any) {
        self.editor.unwrap().chrome_fill();
    }

    /// A button of the strip, named for the command it runs.
    pub fn pressed(_value: any, node: Node) {
        self.editor.unwrap().command(node.name());
    }

    /// A document's tab picked, by the tile it sits in.
    pub fn doc_picked(_value: any, node: Node) {
        self.editor.unwrap().doc_picked(node.parent().name());
    }

    /// A document's tab closed.
    pub fn doc_closed(_value: any, node: Node) {
        self.editor.unwrap().doc_closed(node.parent().name());
    }

    /// A panel's row in the brand menu: it shuts, or comes back.
    pub fn panel_toggled(_value: any, node: Node) {
        self.editor.unwrap().panel_toggled(node.name());
    }

    pub fn refill() {
        self.editor.unwrap().chrome_fill();
    }
}
