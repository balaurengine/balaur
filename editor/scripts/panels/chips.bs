// The chip strip's one script: the workspace's chips, filled by the Editor on
// a word.

use editor;
use signals;

pub class Chips {
    node: Node,
    editor: editor::Editor?,
}

impl Chips {
    pub fn init() {
        let source = scene::root().get_node("Editor");
        self.editor = source.script;
        events::listen(self.node, signals::STAGE, source);
    }

    pub fn on_stage_changed(_change: any) {
        self.refresh();
    }

    /// A chip pressed: a toggle, a Polygon mode or a camera slot, by its row.
    pub fn pressed(_value: any, node: Node) {
        self.editor.unwrap().chip_pressed(node.parent().name(), node.name());
        self.refresh();
    }

    /// One of the Polygon mode's settings moved.
    pub fn option_changed(value: any, node: Node) {
        self.editor.unwrap().chip_option(node.name(), value);
        self.refresh();
    }

    /// A view mode picked from the View chip's menu.
    pub fn view_picked(value: any) {
        self.editor.unwrap().view_picked(value.as_str());
        self.refresh();
    }

    pub fn refill() {
        self.refresh();
    }

    fn refresh() {
        let shown = self.editor.unwrap().chips_fill();
        self.node.set_visible(shown);
    }
}
