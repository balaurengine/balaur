// The chip strip's one script: the workspace's chips, filled by the Editor on
// a word. The scene is the document, so the chips step back until the
// pointer comes for them, the way a canvas tool's context bar does.

use editor;

pub class Chips {
    node: Node,
    editor: editor::Editor?,
    near: bool,
}

impl Chips {
    pub fn init() {
        let source = scene::get_node("Editor");
        self.editor = source.script;
        self.near = false;
        events::listen(self.node, "stage_changed", source);
    }

    pub fn on_stage_changed(_change: any) {
        self.refresh();
    }

    pub fn on_pointer_enter() {
        self.near = true;
        self.refresh();
    }

    pub fn on_pointer_exit() {
        self.near = false;
        self.refresh();
    }

    /// A chip has run its own handler by now, so what is left is to show what
    /// it changed.
    pub fn refill() {
        self.refresh();
    }

    fn refresh() {
        let shown = self.editor.unwrap().chips_fill(self.near);
        self.node.set_visible(shown);
    }
}
