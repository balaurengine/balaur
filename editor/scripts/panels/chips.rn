// The chip strip's one script: the workspace's chips, filled by the Editor on
// a word. The scene is the document, so the chips step back until the
// pointer comes for them, the way a canvas tool's context bar does.

pub fn init(this) {
    this.editor = scene::get_node("Editor");
    this.near = false;
    events::listen(this.node, "stage_changed", this.editor);
}

pub fn on_stage_changed(this, _change) {
    refresh(this);
}

pub fn on_pointer_enter(this) {
    this.near = true;
    refresh(this);
}

pub fn on_pointer_exit(this) {
    this.near = false;
    refresh(this);
}

/// A chip has run its own handler by now, so what is left is to show what
/// it changed.
pub fn on_widget_event(this, event, node, value) {
    if event == "click" {
        refresh(this);
    }
}

fn refresh(this) {
    let shown = this.editor.call("chips_fill", this.near);
    this.node.patch_component("widget", #{ visible: shown == true });
}
