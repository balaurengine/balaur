// The Weights tab's one script: the Editor fills it when the polygon, its
// pick or the selection moved, and it hands back the verbs. A weight's own
// field writes itself, and a vertex's or bone's own button picks it.

const VERBS = ["bind", "unbind", "normalize", "auto", "smooth", "all"];

pub fn init(this) {
    this.editor = scene::get_node("Editor");
    for word in ["weights_changed", "outline_changed", "inspector_changed"] {
        events::listen(this.node, word, this.editor);
    }
}

pub fn on_weights_changed(this, _change) {
    refresh(this);
}

pub fn on_outline_changed(this, _change) {
    refresh(this);
}

pub fn on_inspector_changed(this, _change) {
    refresh(this);
}

pub fn on_widget_event(this, event, node, value) {
    if event == "click" {
        for verb in VERBS {
            if node.name() == verb {
                this.editor.call("weights_verb", verb);
            }
        }
    }
    if event == "click" || event == "change" {
        refresh(this);
    }
}

/// Fill what shows: on a word, and from the dock once it is visible.
pub fn refresh(this) {
    if this.node.get_component("widget", "visible") == false {
        return;
    }
    this.editor.call("weights_fill");
}
