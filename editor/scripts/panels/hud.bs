// The HUD's one script: the axes, the zoom and the folded bottom dock's
// handle along the scene's foot, shown and read as the Editor says.

pub class Hud {
    node: Node,
    editor: Node,
}

impl Hud {
    pub fn init() {
        self.editor = scene::get_node("Editor");
        events::listen(self.node, "stage_changed", self.editor);
    }

    pub fn on_stage_changed(_change: any) {
        self.refresh();
    }

    pub fn zoom_out() {
        self.editor.call("stage_verb", "zoom_out");
    }

    pub fn zoom_in() {
        self.editor.call("stage_verb", "zoom_in");
    }

    pub fn open_bottom() {
        self.editor.call("stage_verb", "open_bottom");
    }

    fn refresh() {
        let view = self.editor.call("hud_view");
        if !(view.kind() == "map") {
            return;
        }
        self.node.widget.visible = view["shown"].as_bool();
        self.node.widget.height = view["height"].as_float();
        self.node.patch_component("widget", { "inset": view["inset"] });
        if !view["shown"].as_bool() {
            return;
        }
        let axes = self.node.get_node("Axes/Row");
        axes.get_node("X").patch_component("widget", { "text_color": view["x_ink"].as_str() });
        axes.get_node("Y").patch_component("widget", { "text_color": view["y_ink"].as_str() });
        let zoom = self.node.get_node("Zoom/Row");
        for name in ["Out", "In"] {
            let patched = zoom.get_node(name);
            patched.widget.width = view["step"].as_float();
            patched.widget.height = view["step"].as_float();
            patched.patch_component("widget", { "text_color": view["quiet_ink"].as_str() });
        }
        zoom.get_node("In").widget.icon = view["add_icon"].as_str();
        zoom.get_node("Reading").widget.text = view["zoom"].as_str();
        let bottom = self.node.get_node("Bottom");
        bottom.widget.visible = view["bottom"].as_bool();
        let patched = bottom.get_node("Open");
        patched.widget.icon = view["bottom_icon"].as_str();
        patched.widget.width = view["step"].as_float() + 6.0;
        patched.widget.height = view["step"].as_float() + 6.0;
        patched.patch_component("widget", { "text_color": view["quiet_ink"].as_str() });
    }
}
