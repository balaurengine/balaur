// The HUD's one script: the axes, the zoom and the folded bottom dock's
// handle along the scene's foot, shown and read as the Editor says.

use editor;

pub class Hud {
    node: Node,
    editor: editor::Editor?,
}

impl Hud {
    pub fn init() {
        let source = scene::get_node("Editor");
        self.editor = source.script;
        events::listen(self.node, "stage_changed", source);
    }

    pub fn on_stage_changed(_change: any) {
        self.refresh();
    }

    pub fn zoom_out() {
        self.editor.unwrap().stage_verb("zoom_out");
    }

    pub fn zoom_in() {
        self.editor.unwrap().stage_verb("zoom_in");
    }

    pub fn open_bottom() {
        self.editor.unwrap().stage_verb("open_bottom");
    }

    fn refresh() {
        let view = self.editor.unwrap().hud_view();
        self.node.set_visible(view.shown);
        self.node.widget.height = view.height;
        self.node.patch_component("widget", { "inset": view.inset });
        if !view.shown {
            return;
        }
        let axes = self.node.get_node("Axes/Row");
        axes.get_node("X").patch_component("widget", { "text_color": view.x_ink });
        axes.get_node("Y").patch_component("widget", { "text_color": view.y_ink });
        let zoom = self.node.get_node("Zoom/Row");
        for name in ["Out", "In"] {
            let patched = zoom.get_node(name);
            patched.widget.width = view.step;
            patched.widget.height = view.step;
            patched.patch_component("widget", { "text_color": view.quiet_ink });
        }
        zoom.get_node("In").widget_button.icon = view.add_icon;
        zoom.get_node("Reading").widget.text = view.zoom;
        let bottom = self.node.get_node("Bottom");
        bottom.set_visible(view.bottom);
        let patched = bottom.get_node("Open");
        patched.widget_button.icon = view.bottom_icon;
        patched.widget.width = view.step + 6.0;
        patched.widget.height = view.step + 6.0;
        patched.patch_component("widget", { "text_color": view.quiet_ink });
    }
}
