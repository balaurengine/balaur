// The HUD's one script: the axes, the zoom and the folded bottom dock's
// handle along the scene's foot, shown and read as the Editor says.

pub class Hud {
    node: Node,
    editor: Node,
}

impl Hud {
    pub fn init() {
        self.editor = scene::get_node("Editor");
        events::listen(self.node, "stage_changed", self.editor);
    }

    pub fn on_stage_changed(_change: any) {
        self.refresh();
    }

    pub fn on_widget_event(event: str, node: Node, value: any) {
        if event != "click" {
            return;
        }
        let name = node.name();
        let verb = if name == "Out" {
            "zoom_out"
        } else if name == "In" {
            "zoom_in"
        } else if name == "Open" {
            "open_bottom"
        } else {
            ""
        };
        if verb != "" {
            self.editor.call("stage_verb", verb);
        }
    }

    fn refresh() {
        let view = self.editor.call("hud_view");
        if !(view.kind() == "map") {
            return;
        }
        self.node.patch_component("widget", { "visible": view["shown"], "inset": view["inset"], "height": view["height"] });
        if !view["shown"].as_bool() {
            return;
        }
        let axes = self.node.get_node("Axes/Row");
        axes.get_node("X").patch_component("widget", { "text_color": view["x_ink"] });
        axes.get_node("Y").patch_component("widget", { "text_color": view["y_ink"] });
        let zoom = self.node.get_node("Zoom/Row");
        for name in ["Out", "In"] {
            zoom.get_node(name).patch_component("widget", {
                "width": view["step"],
                "height": view["step"],
                "text_color": view["quiet_ink"],
            });
        }
        zoom.get_node("In").patch_component("widget", { "icon": view["add_icon"] });
        zoom.get_node("Reading").patch_component("widget", { "text": view["zoom"] });
        let bottom = self.node.get_node("Bottom");
        bottom.patch_component("widget", { "visible": view["bottom"] });
        bottom.get_node("Open").patch_component("widget", {
            "icon": view["bottom_icon"],
            "width": view["step"].as_float() + 6.0,
            "height": view["step"].as_float() + 6.0,
            "text_color": view["quiet_ink"],
        });
    }
}
