// A live meter's one script, the Profiler's or the Cost tab's: what the engine
// measured, read four times a second while the tab shows. The one panel that
// reads on a clock, because what it shows is the cost of the frames.

pub class Meter {
    node: Node,
    what: str,
    editor: Node,
    titled: str,
    next: float,
}

const EVERY: float = 0.25;

impl Meter {
    pub fn init() {
        self.what = if self.node.name() == "Profiler" { "profiler" } else { "cost" };
        self.editor = scene::get_node("Editor");
        self.titled = "";
        self.next = 0.0;
    }

    /// What the dock calls once it has made this tab visible: the first sample,
    /// which starts the clock.
    pub fn refresh() {
        self.sample();
    }

    /// The clock: a frame the repaint it scheduled ran, while the tab shows.
    pub fn update(_delta_time: float) {
        if self.next > 0.0 && engine::unix_time() >= self.next {
            self.sample();
        }
    }

    pub fn scripts() {
        self.editor.call("profiler_scripts");
        self.sample();
    }

    fn sample() {
        if self.node.visible() == false {
            // Hidden: no clock until it shows again.
            self.next = 0.0;
            return;
        }
        self.next = engine::unix_time() + EVERY;
        ui::request_repaint(ui::RepaintOptions { after: EVERY });
        let view = self.editor.call("meter_view", self.what);
        if !(view.kind() == "map") {
            return;
        }
        let table = self.node.get_node("Table");
        let titled = "{view["titles"]}";
        if titled != self.titled {
            // Widths only when the columns change: stating them every time would
            // snap the reader's own drag away.
            self.titled = titled;
            table.widget_table.titles = view["titles"];
            table.widget_table.widths = view["widths"];
            table.widget_table.sort = "";
            table.widget.reverse = false;
        }
        table.widget.options = view["items"];
        table.set_visible(view["items"].len() > 0);
        let patched = self.node.get_node("Nothing");
        patched.set_visible(view["says"].as_str() != "");
        patched.widget.text = view["says"].as_str();
        let tools = self.node.get_node("Tools");
        tools.get_node("Headline").widget.text = view["headline"].as_str();
        if self.what == "profiler" {
            tools.get_node("Scripts").widget.checked = view["scripts"].as_bool();
        }
    }
}
