// A live meter's one script, the Profiler's or the Cost tab's: what the engine
// measured, read four times a second while the tab shows. The one panel that
// reads on a clock, because what it shows is the cost of the frames.

const EVERY = 0.25;

pub fn init(this) {
    this.what = if this.node.name() == "Profiler" { "profiler" } else { "cost" };
    this.editor = scene::get_node("Editor");
    this.titled = "";
    this.next = 0.0;
}

/// What the dock calls once it has made this tab visible: the first sample,
/// which starts the clock.
pub fn refresh(this) {
    sample(this);
}

/// The clock: a frame the repaint it scheduled ran, while the tab shows.
pub fn update(this, _dt) {
    if this.next > 0.0 && engine::unix_time() >= this.next {
        sample(this);
    }
}

pub fn on_widget_event(this, event, node, value) {
    if event == "click" && node.name() == "Scripts" {
        this.editor.call("profiler_scripts");
        sample(this);
    }
}

fn sample(this) {
    if this.node.get_component("widget", "visible") == false {
        // Hidden: no clock until it shows again.
        this.next = 0.0;
        return;
    }
    this.next = engine::unix_time() + EVERY;
    ui::request_repaint(#{ after: EVERY });
    let view = this.editor.call("meter_view", this.what);
    if !(view is Object) {
        return;
    }
    let table = this.node.get_node("Table");
    let titled = format!("{:?}", view.titles);
    if titled != this.titled {
        // Widths only when the columns change: stating them every time would
        // snap the reader's own drag away.
        this.titled = titled;
        table.patch_component("widget", #{
            titles: view.titles, widths: view.widths, sort: "", reverse: false,
        });
    }
    table.patch_component("widget", #{ options: view.items, visible: view.items.len() > 0 });
    this.node.get_node("Nothing").patch_component("widget", #{
        visible: view.says != "", text: view.says,
    });
    let tools = this.node.get_node("Tools");
    tools.get_node("Headline").patch_component("widget", #{ text: view.headline });
    if this.what == "profiler" {
        tools.get_node("Scripts").patch_component("widget", #{ checked: view.scripts });
    }
}
