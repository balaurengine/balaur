// The shell keys' one script: a chord clicks its button, and the button's
// name is the command the Editor runs. F5 is play until a script stops, and
// then it and the step keys are the debugger's.

const STOPPED = ["continue", "step_over", "step_into", "step_out"];

pub fn init(this) {
    this.editor = scene::get_node("Editor");
    events::listen(this.node, "debugger_changed", this.editor);
}

/// A script stopped or went on, or play started or stopped.
pub fn on_debugger_changed(this, _change) {
    refresh(this);
}

pub fn on_widget_event(this, event, node, value) {
    if event == "click" {
        this.editor.call("command", node.name());
    }
}

fn refresh(this) {
    let state = this.editor.call("keys_view");
    if !(state is Object) {
        return;
    }
    for name in STOPPED {
        this.node.get_node(name).patch_component("widget", #{ enabled: state.stopped });
    }
    this.node.get_node("play").patch_component("widget", #{ enabled: !state.stopped });
    this.node.get_node("break").patch_component("widget", #{ enabled: state.playing && !state.stopped });
}
