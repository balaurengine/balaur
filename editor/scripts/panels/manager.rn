// The start screen's one script: its head, its tabs and the page under them,
// filled by the Editor when what they show moved or the screen was resized.
// The toolbar's verbs are this panel's own; a row's run their own handlers.

const VERBS = ["Import", "Open", "New"];

pub fn init(this) {
    this.editor = scene::get_node("Editor");
    events::listen(this.node, "manager_changed", this.editor);
    events::listen(this.node, "resized", this.node.get_node("ManagerBody"));
}

pub fn on_manager_changed(this, _change) {
    this.editor.call("manager_fill");
}

/// The page's width moved, which decides how many cards go across.
pub fn on_resized(this, _box) {
    this.editor.call("manager_fill");
}

pub fn on_widget_event(this, event, node, value) {
    let name = node.name();
    if name == "Filter" && event == "change" {
        this.editor.call("manager_filter", value);
    } else if event == "click" && VERBS.iter().any(|verb| verb == name) && node.parent().name() == "Tools" {
        this.editor.call("manager_verb", name);
    } else if event == "click" || event == "change" || event == "submit" {
        this.editor.call("manager_fill");
    }
}
