// The import list's one script: it fills when an import reports, and comes
// down on its own clock once the last of the batch has been over a while.

pub fn init(this) {
    this.editor = scene::get_node("Editor");
    this.until = 0.0;
    events::listen(this.node, "assets_changed", this.editor);
}

pub fn on_assets_changed(this, _change) {
    refresh(this);
}

/// The clock: the frame the repaint it asked for ran, once the list is due
/// to come down.
pub fn update(this, _dt) {
    if this.until > 0.0 && engine::unix_time() >= this.until {
        refresh(this);
    }
}

fn refresh(this) {
    let view = this.editor.call("imports_fill");
    if !(view is Object) {
        return;
    }
    this.node.patch_component("widget", #{ visible: view.shown });
    this.node.get_node("Bar").patch_component("widget", #{ visible: view.bar, value: view.value });
    this.until = view.until;
    if view.until > 0.0 {
        ui::request_repaint(#{ after: view.until - engine::unix_time() + 0.05 });
    }
}
