// The Library tab's one script: it lights the kind, fills that kind's cards or
// the templates from what the Editor hands it, and answers a pick of either.

pub class Library {
    node: Node,
    editor: Node,
}

fn KINDS() -> [str] {
    ["material", "sky", "model", "scene", "rig", "addon", "template", "deps", "forge"]
}

impl Library {
    pub fn init() {
        self.editor = scene::get_node("Editor");
        events::listen(self.node, "library_changed", self.editor);
        events::listen(self.node, "outline_changed", self.editor);
    }

    pub fn on_library_changed(_change: any) {
        self.refresh();
    }

    /// The theme moved, which inks the cards.
    pub fn on_outline_changed(_change: any) {
        self.refresh();
    }

    pub fn kind(_value: any, node: Node) {
        self.editor.call("library_kind", node.name());
    }

    // A pick places, so the same card twice places twice: the row is read and
    // let go rather than kept lit.
    pub fn card_clicked(_value: any, node: Node) {
        let row = node.widget.text;
        node.widget.text = "";
        if row != "" {
            self.editor.call("library_pick", row);
        }
    }

    /// Fill what shows from the Editor's answer: on a word that it moved, and
    /// from the dock once it has made this panel visible.
    pub fn refresh() {
        if self.node.visible() == false {
            return;
        }
        let view = self.editor.call("library_view");
        if !(view.kind() == "map") {
            return;
        }
        let kinds = self.node.get_node("Kinds");
        for kind in KINDS() {
            kinds.get_node(kind).widget.checked = kind == view["kind"].as_str();
        }
        let patched = self.node.get_node("Note");
        patched.set_visible(view["says"].as_str() != "");
        patched.widget.text = view["says"].as_str();
        let cards = !view["templates"].as_bool() && view["items"].len() > 0;
        let table = view["templates"].as_bool() && view["items"].len() > 0;
        let patched = self.node.get_node("Cards");
        patched.set_visible(cards);
        patched.widget.options = if cards { view["items"] } else { [] };
        let patched = self.node.get_node("Table");
        patched.set_visible(table);
        patched.widget.options = if table { view["items"] } else { [] };
    }
}
