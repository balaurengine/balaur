// The Library tab's one script: it lights the kind, fills that kind's cards or
// the templates from what the Editor hands it, and answers a pick of either.

use editor;
use signals;

const FORGE: str = "forge";
const MATERIAL: str = "material";
const MODEL: str = "model";
const SCENE: str = "scene";
const SKY: str = "sky";

pub class Library {
    node: Node,
    editor: editor::Editor?,
}

fn KINDS() -> [str] {
    [MATERIAL, SKY, MODEL, SCENE, "rig", "addon", "template", "deps", FORGE]
}

impl Library {
    pub fn init() {
        let source = scene::get_node("Editor");
        self.editor = source.script;
        events::listen(self.node, signals::DOCKS, source);
        events::listen(self.node, "library_changed", source);
        events::listen(self.node, signals::OUTLINE, source);
    }

    pub fn on_library_changed(_change: any) {
        self.refresh();
    }

    /// The theme moved, which inks the cards.
    pub fn on_outline_changed(_change: any) {
        self.refresh();
    }

    pub fn kind(_value: any, node: Node) {
        self.editor.unwrap().library_kind(node.name());
    }

    // A pick places, so the same card twice places twice: the row is read and
    // let go rather than kept lit.
    pub fn card_clicked(_value: any, node: Node) {
        let row = node.widget.text;
        node.widget.text = "";
        if row != "" {
            self.editor.unwrap().library_pick(row);
        }
    }

    /// Laid out on screen by the dock, a frame after `docks_changed`: what it
    /// skipped while hidden fills now.
    pub fn on_visibility_changed(visible: bool) {
        if visible {
            self.refresh();
        }
    }

    /// The dock showed or hid this panel: shown, it fills.
    pub fn on_docks_changed(_change: any) {
        if self.node.visible() {
            self.refresh();
        }
    }

    /// Fill what shows from the Editor's answer: on a word that it moved, and
    /// from the dock once it has made this panel visible.
    pub fn refresh() {
        if self.node.visible() == false {
            return;
        }
        let view = self.editor.unwrap().library_view();
        let kinds = self.node.get_node("Kinds");
        for kind in KINDS() {
            kinds.get_node(kind).widget_check.checked = kind == view.kind;
        }
        let patched = self.node.get_node("Note");
        patched.set_visible(view.says != "");
        patched.widget.text = view.says;
        let cards = !view.templates && view.items.len() > 0;
        let table = view.templates && view.items.len() > 0;
        let patched = self.node.get_node("Cards");
        patched.set_visible(cards);
        patched.widget_rows.items = if cards { view.items } else { [] };
        let patched = self.node.get_node("Table");
        patched.set_visible(table);
        patched.widget_rows.items = if table { view.items } else { [] };
    }
}
