// The Import tab's one script: the file the Assets tab has selected, filled
// by the Editor when the selection, the file or a setting moved.

pub class Import {
    node: Node,
    editor: Node,
}

impl Import {
    pub fn init() {
        self.editor = scene::get_node("Editor");
        for word in ["assets_changed", "outline_changed"] {
            events::listen(self.node, word, self.editor);
        }
    }

    pub fn on_assets_changed(_change: any) {
        self.refresh();
    }

    pub fn on_outline_changed(_change: any) {
        self.refresh();
    }

    /// A field has run its own handler by now, so what is left is to show what
    /// it changed.
    pub fn refill() {
        self.refresh();
    }

    /// Fill what shows: on a word, and from the dock once it is visible.
    pub fn refresh() {
        if self.node.visible() == false {
            return;
        }
        let view = self.editor.call("import_fill");
        if !(view.kind() == "map") {
            return;
        }
        let patched = self.node.get_node("Name");
        patched.set_visible(view["ready"].as_bool());
        patched.widget.text = view["name"].as_str();
        let patched = self.node.get_node("From");
        patched.set_visible(view["ready"].as_bool());
        patched.widget.text = view["from"].as_str();
        let patched = self.node.get_node("Nothing");
        patched.set_visible(!view["ready"].as_bool());
        patched.widget.text = view["says"].as_str();
        self.node.get_node("Scroll").set_visible(view["ready"].as_bool());
    }
}
