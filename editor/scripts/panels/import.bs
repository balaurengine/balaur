// The Import tab's one script: the file the Assets tab has selected, filled
// by the Editor when the selection, the file or a setting moved.

use editor;

pub class Import {
    node: Node,
    editor: editor::Editor?,
}

impl Import {
    pub fn init() {
        let source = scene::get_node("Editor");
        self.editor = source.script;
        events::listen(self.node, "docks_changed", source);
        for word in ["assets_changed", "outline_changed"] {
            events::listen(self.node, word, source);
        }
    }

    pub fn on_assets_changed(_change: any) {
        self.refresh();
    }

    pub fn on_outline_changed(_change: any) {
        self.refresh();
    }

    /// A field has run its own handler by now, so what is left is to show what
    /// it changed.
    pub fn refill() {
        self.refresh();
    }

    /// The dock showed or hid this panel: shown, it fills.
    pub fn on_docks_changed(_change: any) {
        if self.node.visible() {
            self.refresh();
        }
    }

    /// Fill what shows: on a word, and from the dock once it is visible.
    pub fn refresh() {
        if self.node.visible() == false {
            return;
        }
        let view = self.editor.unwrap().import_fill();
        let patched = self.node.get_node("Name");
        patched.set_visible(view.ready);
        patched.widget.text = view.name;
        let patched = self.node.get_node("From");
        patched.set_visible(view.ready);
        patched.widget.text = view.from;
        let patched = self.node.get_node("Nothing");
        patched.set_visible(!view.ready);
        patched.widget.text = view.says;
        self.node.get_node("Scroll").set_visible(view.ready);
    }
}
