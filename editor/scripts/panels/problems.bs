// The Problems tab's one script: it fills its list when the check's findings
// move, and hands the Editor a pick to open.

use editor;
use signals;

pub class Problems {
    node: Node,
    editor: editor::Editor?,
}

impl Problems {
    pub fn init() {
        let source = scene::get_node("Editor");
        self.editor = source.script;
        events::listen(self.node, signals::DOCKS, source);
        for word in [signals::PROBLEMS_CHANGED, signals::OUTLINE] {
            events::listen(self.node, word, source);
        }
    }

    pub fn on_problems_changed(_change: any) {
        self.refresh();
    }

    pub fn on_outline_changed(_change: any) {
        self.refresh();
    }

    pub fn list_picked(_value: any, node: Node) {
        let row = node.widget.text;
        node.widget.text = "";
        if row != "" {
            self.editor.unwrap().problems_pick(row);
        }
    }

    /// Laid out on screen by the dock, a frame after `docks_changed`: what it
    /// skipped while hidden fills now.
    pub fn on_visibility_changed(visible: bool) {
        if visible {
            self.refresh();
        }
    }

    /// The dock showed or hid this panel: shown, it fills.
    pub fn on_docks_changed(_change: any) {
        if self.node.visible() {
            self.refresh();
        }
    }

    /// Fill what shows from the Editor's answer: on a word that it moved, and
    /// from the dock once it has made this panel visible.
    pub fn refresh() {
        let view = self.editor.unwrap().problems_view();
        let patched = self.node.get_node("List");
        patched.widget_rows.items = view.items;
        patched.set_visible(view.items.len() > 0);
        let patched = self.node.get_node("Nothing");
        patched.set_visible(view.says != "");
        patched.widget.text = view.says;
    }
}
