// The Timeline tab's one script: the Editor fills it when the clip, the
// playhead or the room moved, and it hands back the scrubber, the key verbs
// and a clip asked for. A key's own dot seeks to it.

use editor;
use signals;

const RESIZED: str = "resized";

pub class Timeline {
    node: Node,
    editor: editor::Editor?,
}

impl Timeline {
    pub fn init() {
        let source = scene::get_node("Editor");
        self.editor = source.script;
        events::listen(self.node, signals::DOCKS, source);
        for word in [signals::TIMELINE, signals::PLAY, signals::OUTLINE] {
            events::listen(self.node, word, source);
        }
        events::listen(self.node, RESIZED, self.node);
    }

    pub fn on_timeline_changed(_change: any) {
        self.refresh();
    }

    pub fn on_play_frame(_change: any) {
        self.refresh();
    }

    pub fn on_outline_changed(_change: any) {
        self.refresh();
    }

    /// The lanes are laid out against the tab's width.
    pub fn on_resized(_box: any) {
        self.refresh();
    }

    pub fn seek(value: any) {
        self.editor.unwrap().timeline_seek(value.as_float());
    }

    pub fn clip_changed(value: any, node: Node) {
        self.editor.unwrap().timeline_clip(node.name(), value);
    }

    pub fn verb(_value: any, node: Node) {
        self.editor.unwrap().timeline_verb(node.name());
    }

    pub fn refill() {
        self.refresh();
    }

    /// Laid out on screen by the dock, a frame after `docks_changed`: what it
    /// skipped while hidden fills now.
    pub fn on_visibility_changed(visible: bool) {
        if visible {
            self.refresh();
        }
    }

    /// The dock showed or hid this panel: shown, it fills.
    pub fn on_docks_changed(_change: any) {
        if self.node.visible() {
            self.refresh();
        }
    }

    /// Fill what shows: on a word, and from the dock once it is visible.
    pub fn refresh() {
        if self.node.visible() == false {
            return;
        }
        self.editor.unwrap().timeline_fill();
    }
}
