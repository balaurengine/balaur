// The Timeline tab's one script: the Editor fills it when the clip, the
// playhead or the room moved, and it hands back the scrubber, the key verbs
// and a clip asked for. A key's own dot seeks to it.

pub class Timeline {
    node: Node,
    editor: Node,
}

impl Timeline {
    pub fn init() {
        self.editor = scene::get_node("Editor");
        for word in ["timeline_changed", "play_frame", "outline_changed"] {
            events::listen(self.node, word, self.editor);
        }
        events::listen(self.node, "resized", self.node);
    }

    pub fn on_timeline_changed(_change: any) {
        self.refresh();
    }

    pub fn on_play_frame(_change: any) {
        self.refresh();
    }

    pub fn on_outline_changed(_change: any) {
        self.refresh();
    }

    /// The lanes are laid out against the tab's width.
    pub fn on_resized(_box: any) {
        self.refresh();
    }

    pub fn seek(value: any) {
        self.editor.call("timeline_seek", value);
    }

    pub fn clip_changed(value: any, node: Node) {
        self.editor.call("timeline_clip", node.name(), value);
    }

    pub fn verb(_value: any, node: Node) {
        self.editor.call("timeline_verb", node.name());
    }

    pub fn refill() {
        self.refresh();
    }

    /// Fill what shows: on a word, and from the dock once it is visible.
    pub fn refresh() {
        if self.node.widget.visible == false {
            return;
        }
        self.editor.call("timeline_fill");
    }
}
