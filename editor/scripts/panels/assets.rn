// The Assets tab's one script: it fills the cards and the strip over them
// from what the Editor, which owns the files, hands it, and answers both.

const VERBS = ["Up", "Import", "Folder", "Rename", "Delete"];

pub fn init(this) {
    this.query = "";
    this.renaming = false;
    this.editor = scene::get_node("Editor");
    events::listen(this.node, "assets_changed", this.editor);
    events::listen(this.node, "outline_changed", this.editor);
}

/// A file was made, moved or reloaded, a card picked or an import moved on.
pub fn on_assets_changed(this, _change) {
    refresh(this);
}

/// The theme moved, which inks the cards.
pub fn on_outline_changed(this, _change) {
    refresh(this);
}

pub fn on_widget_event(this, event, node, value) {
    let name = node.name();
    if name == "Search" && event == "change" {
        this.query = value;
        refresh(this);
    } else if name == "Cards" && event == "click" {
        // A second click on the selected card reports the same row, and that
        // is the one that opens it, so the click is heard rather than a change.
        this.editor.call("assets_pick", node.get_component("widget", "text"));
    } else if name == "Cards" && event == "drop" {
        this.editor.call("assets_dropped", value);
    } else if name == "Name" && event == "submit" {
        this.editor.call("assets_verb", "rename_to", value);
    } else if event == "click" && VERBS.iter().any(|verb| verb == name) {
        this.editor.call("assets_verb", name, "");
    }
}

/// Fill what shows from the Editor's answer: on a word that it moved, and
/// from the dock once it has made this panel visible.
pub fn refresh(this) {
    // A hidden browser lists nothing: it is filled again when it shows.
    if this.node.get_component("widget", "visible") == false {
        return;
    }
    let view = this.editor.call("assets_view", this.query);
    if !(view is Object) {
        return;
    }
    let tools = this.node.get_node("Tools");
    tools.get_node("Up").patch_component("widget", #{ visible: view.dir != "" });
    tools.get_node("Where").patch_component("widget", #{ visible: !view.renaming, text: view.where });
    // The field's text only as it opens: a refresh while it is up would take
    // the typing back.
    let field = #{ visible: view.renaming };
    if view.renaming && !this.renaming {
        field.text = view.name;
    }
    this.renaming = view.renaming;
    tools.get_node("Name").patch_component("widget", field);
    tools.get_node("Count").patch_component("widget", #{ text: view.count });
    tools.get_node("Import").patch_component("widget", #{
        text: view.import_text, tooltip: view.import_tip, checked: view.importing,
    });
    tools.get_node("Folder").patch_component("widget", #{ text: view.folder_text });
    tools.get_node("Rename").patch_component("widget", #{
        role: if view.chosen { "action_dock" } else { "action_dock_quiet" },
        tooltip: if view.chosen { "Rename the selected item" } else { "Select an item first" },
    });
    tools.get_node("Delete").patch_component("widget", #{
        role: if view.chosen { "action_dock_danger" } else { "action_dock_quiet" },
        tooltip: if view.chosen { "Delete the selected item" } else { "Select an item first" },
    });
    this.node.get_node("Cards").patch_component("widget", #{ options: view.items, text: view.picked });
}
