// The Output tab's one script: it fills the log list when the engine says
// lines arrived, and answers its clear, its levels and its search.

use editor;
use signals;

const ALL: str = "all";
const ERROR: str = "error";

pub class Output {
    node: Node,
    level: str,
    query: str,
    editor: editor::Editor?,
}

fn LEVELS() -> [str] {
    [ERROR, "warn", ALL]
}

impl Output {
    pub fn init() {
        self.level = ALL;
        self.query = "";
        let source = scene::get_node("Editor");
        self.editor = source.script;
        events::listen(self.node, signals::DOCKS, source);
        events::listen(self.node, "logged");
        events::listen(self.node, signals::OUTLINE, source);
    }

    pub fn on_logged(_total: any) {
        self.refresh();
    }

    /// The theme moved, which inks the lines.
    pub fn on_outline_changed(_change: any) {
        self.refresh();
    }

    pub fn clear() {
        self.editor.unwrap().output_clear();
        self.refresh();
    }

    pub fn level_picked(_value: any, node: Node) {
        self.level = node.name();
        self.refresh();
    }

    pub fn search_typed(value: any) {
        self.query = value.as_str();
        self.refresh();
    }

    /// The dock showed or hid this panel: shown, it fills.
    pub fn on_docks_changed(_change: any) {
        if self.node.visible() {
            self.refresh();
        }
    }

    /// Fill what shows from the Editor's answer: on a word that it moved, and
    /// from the dock once it has made this panel visible.
    pub fn refresh() {
        // A hidden log costs nothing: it is filled again when it shows.
        if self.node.visible() == false {
            return;
        }
        let view = self.editor.unwrap().output_view(self.level, self.query);
        self.node.get_node("Log").widget_rows.items = view.items;
        let patched = self.node.get_node("Nothing");
        patched.set_visible(view.says != "");
        patched.widget.text = view.says;
        let tools = self.node.get_node("Tools");
        for level in LEVELS() {
            let on = level == self.level;
            // A chip's own lit state: the theme dresses it, nothing here names a
            // colour.
            tools.get_node(level).widget_check.checked = on;
        }
    }
}
