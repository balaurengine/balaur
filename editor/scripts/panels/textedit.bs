// The text edit field's one script: up over a text node double-clicked or
// added, it hands what is typed to the Editor. Enter or a click away submits
// it, which keeps it; Escape is a blur alone, which drops it.

use editor;

pub class Textedit {
    node: Node,
    editor: editor::Editor?,
    open: bool,
}

impl Textedit {
    pub fn init() {
        let source = scene::get_node("Editor");
        self.editor = source.script;
        self.open = false;
        events::listen(self.node, "textedit_changed", source);
    }

    pub fn on_textedit_changed(_change: any) {
        let view = self.editor.unwrap().textedit_view();
        let field = self.node.get_node("Field");
        if view.open && !self.open {
            self.node.set_visible(true);
            self.node.widget.x = view.x;
            self.node.widget.y = view.y;
            field.widget.text = view.text;
            field.widget.width = view.width - 20.0;
            field.widget.font_size = view.size;
            ui::set_focus(field);
        } else if !view.open {
            self.node.set_visible(false);
        }
        self.open = view.open;
    }

    pub fn typed(value: any) {
        self.editor.unwrap().textedit_typed(value.as_str());
    }

    pub fn submitted(value: any) {
        self.editor.unwrap().textedit_submit(value.as_str());
    }

    pub fn blurred() {
        self.editor.unwrap().textedit_close();
    }
}
