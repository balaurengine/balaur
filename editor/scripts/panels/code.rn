// The code sheet's one script: it shows the file the Editor says is open,
// hands it what is typed, where the caret went and which gutter line was
// clicked, and writes the text again only when the buffer changed under it.

pub fn init(this) {
    this.editor = scene::get_node("Editor");
    this.path = "";
    this.rev = -1;
    for word in [
        "code_changed", "outline_changed", "inspector_changed", "chrome_changed",
        "stage_changed", "problems_changed", "debugger_changed",
    ] {
        events::listen(this.node, word, this.editor);
    }
}

pub fn on_code_changed(this, _change) {
    refresh(this);
}

pub fn on_outline_changed(this, _change) {
    refresh(this);
}

pub fn on_inspector_changed(this, _change) {
    refresh(this);
}

pub fn on_chrome_changed(this, _change) {
    refresh(this);
}

pub fn on_stage_changed(this, _change) {
    refresh(this);
}

pub fn on_problems_changed(this, _change) {
    refresh(this);
}

pub fn on_debugger_changed(this, _change) {
    refresh(this);
}

pub fn on_widget_event(this, event, node, value) {
    if node.name() != "Editor" {
        return;
    }
    if event == "change" {
        this.editor.call("code_typed", value);
    } else if event == "caret" {
        this.editor.call("code_caret", value);
    } else if event == "gutter" {
        this.editor.call("code_gutter", value);
    }
}

fn refresh(this) {
    let view = this.editor.call("code_view");
    if !(view is Object) {
        return;
    }
    this.node.patch_component("widget", #{ visible: view.shown, inset: view.inset });
    if !view.shown {
        return;
    }
    this.node.get_node("Note").patch_component("widget", #{ visible: view.note != "", text: view.note });
    let scroll = this.node.get_node("Scroll");
    scroll.patch_component("widget", #{ visible: view.note == "" });
    if view.note != "" {
        return;
    }
    let look = view.look;
    // The text only when the buffer moved under the editor: what is typed is
    // the widget's own, and writing it back would put the caret at the end.
    if view.path != this.path || view.rev != this.rev {
        look.text = view.text;
        this.path = view.path;
        this.rev = view.rev;
    }
    scroll.get_node("Editor").patch_component("widget", look);
    if view.scroll_to >= 0.0 {
        scroll.patch_component("widget", #{ scroll_offset: [0.0, view.scroll_to] });
    }
}
