// The input overlay's one script: it hears the keys, actions and buttons as
// they go down and up, and the pointer as it moves, and places its chips,
// ripples and drawn pointer from that. Nothing here reads the input itself.

/// What marks an action's name among the keys held, as `inputview.bs`'s
/// `ACTION` reads it.
const ACTION: str = "action:";

use editor;

pub class Inputview {
    node: Node,
    editor: editor::Editor?,
    shown: bool,
    chips: any,
    rings: [Ring],
    next_ring: int,
    at: At,
    factor: float,
}

pub struct At {
    x: float,
    y: float,
}

pub struct Design {
    x: float,
    y: float,
}

pub struct Ring {
    slot: int,
    until: float,
}

// How long a chip stays up after its key or button went back up, in seconds:
// a tap is a few frames, which nobody watching a clip would catch.
const HOLD: float = 1.0;

// How long a click's ripple grows for, and how wide it starts and ends.
const RIPPLE: float = 1.1;

const RIPPLE_FROM: float = 18.0;

const RIPPLE_TO: float = 140.0;

const RINGS: int = 4;

// The drawn pointer; the image's tip is its top-left corner.
const PRESS: float = 22.0;

impl Inputview {
    pub fn init() {
        let source = scene::get_node("Editor");
        self.editor = source.script;
        self.shown = false;
        // A chip's name, and when it goes: zero while it is held.
        self.chips = {};
        self.rings = [];
        self.next_ring = 0;
        self.at = At { x: 0.0, y: 0.0 };
        self.factor = 1.0;
        for word in ["pointer_moved", "pointer_pressed", "pointer_released"] {
            events::listen(self.node, word);
        }
        for word in ["inputview_changed", "stage_changed"] {
            events::listen(self.node, word, source);
        }
    }

    /// The overlay was turned on or off, or the stage it sits under moved.
    pub fn on_inputview_changed(_change: any) {
        self.show();
    }

    pub fn on_stage_changed(_change: any) {
        self.show();
    }

    pub fn on_key_down(key: str) {
        self.hold(self.editor.unwrap().inputview_key(key));
    }

    pub fn on_key_up(key: str) {
        self.let_go(self.editor.unwrap().inputview_key(key));
    }

    pub fn on_action(name: str) {
        self.hold(ACTION + name);
    }

    pub fn on_action_released(name: str) {
        self.let_go(ACTION + name);
    }

    pub fn on_pointer_moved(spot: any) {
        if !self.shown {
            return;
        }
        let design_point = self.design(spot[0], spot[1]);
        let design_x = design_point.x;
        let design_y = design_point.y;
        self.at = At { x: design_x, y: design_y };
        let patched = self.node.get_node("Pointer");
        patched.set_visible(true);
        patched.patch_component("widget", { "inset": [design_x, design_y, -1.0, -1.0] });
        self.node.get_node("Press").patch_component("widget", {
            "inset": [design_x - PRESS / 2.0, design_y - PRESS / 2.0, -1.0, -1.0],
        });
    }

    pub fn on_pointer_pressed(event: any) {
        self.hold(button_label(event["button"]).as_str());
        if !self.shown {
            return;
        }
        let design_point = self.design(event["x"], event["y"]);
        let design_x = design_point.x;
        let design_y = design_point.y;
        self.ripple(design_x, design_y);
        if event["button"].as_str() == "left" {
            let patched = self.node.get_node("Press");
            patched.set_visible(true);
            patched.patch_component("widget", { "inset": [design_x - PRESS / 2.0, design_y - PRESS / 2.0, -1.0, -1.0] });
        }
    }

    pub fn on_pointer_released(event: any) {
        self.let_go(button_label(event["button"]).as_str());
        if event["button"].as_str() == "left" {
            self.node.get_node("Press").set_visible(false);
        }
    }

    /// The clock: a chip let go a moment ago comes down, and a ripple that ran
    /// its course goes, on the frame the repaint each asked for runs.
    pub fn update(_delta_time: float) {
        let now = engine::unix_time();
        let gone: [str] = [];
        for name in self.chips.keys() {
            let until = self.chips[name];
            if until.as_float() > 0.0 && now >= until.as_float() {
                gone.push(name);
            }
        }
        for name in gone {
            self.chips.remove(name);
        }
        if gone.len() > 0 {
            self.chips();
        }
        let kept: [Ring] = [];
        for ring in self.rings {
            if now >= ring.until {
                self.node.get_node("Wash{ring.slot}").set_visible(false);
                self.node.get_node("Ring{ring.slot}").set_visible(false);
            } else {
                kept.push(ring);
            }
        }
        self.rings = kept;
        // A ripple the engine is easing moves on frames nothing else asks for.
        if kept.len() > 0 {
            ui::request_repaint();
        }
    }

    fn show() {
        let view = self.editor.unwrap().inputview_view();
        self.shown = view.shown;
        self.factor = view.factor;
        self.node.set_visible(view.shown);
        self.node.get_node("Chips").patch_component("widget", { "inset": [view.chips_x, view.chips_y, -1.0, -1.0] });
    }

    // Window pixels as the overlay's design pixels.
    fn design(window_x: any, window_y: any) -> Design {
        let factor = if self.factor > 0.0 { self.factor } else { 1.0 };
        Design { x: window_x.as_float() / factor, y: window_y.as_float() / factor }
    }

    fn hold(name: str) {
        if name == "" {
            return;
        }
        self.chips[name] = 0.0;
        self.chips();
    }

    fn let_go(name: str) {
        if !self.chips.has(name) {
            return;
        }
        self.chips[name] = engine::unix_time() + HOLD;
        ui::request_repaint(ui::RepaintOptions { after: HOLD + 0.05 });
    }

    fn chips() {
        if !self.shown {
            return;
        }
        let names: [str] = [];
        for name in self.chips.keys() {
            names.push(name);
        }
        names.sort();
        self.editor.unwrap().inputview_chips(names);
    }
}

fn button_label(button: any) -> any {
    if button.as_str() == "left" {
        "LMB"
    } else if button.as_str() == "right" {
        "RMB"
    } else if button.as_str() == "middle" {
        "MMB"
    } else {
        button
    }
}

// A ring that grows out from the click, and the wash under it: the engine
// eases both, and the clock takes them away once they ran.
impl Inputview {
    fn ripple(click_x: any, click_y: any) {
        let slot = self.next_ring % RINGS;
        self.next_ring += 1;
        for name in ["Wash{slot}", "Ring{slot}"] {
            let node = self.node.get_node(name);
            node.set_visible(true);
            node.widget.width = RIPPLE_FROM;
            node.widget.height = RIPPLE_FROM;
            node.widget.corner_radius = RIPPLE_FROM / 2.0;
            node.patch_component("widget", { "inset": [click_x.as_float() - RIPPLE_FROM / 2.0, click_y.as_float() - RIPPLE_FROM / 2.0, -1.0, -1.0] });
            // Centred on the click as it grows, so the box's corner moves too.
            let from = [click_x.as_float() - RIPPLE_FROM / 2.0, click_y.as_float() - RIPPLE_FROM / 2.0, -1.0, -1.0];
            let to = [click_x.as_float() - RIPPLE_TO / 2.0, click_y.as_float() - RIPPLE_TO / 2.0, -1.0, -1.0];
            animation::tween(node, animation::Tween {
                steps: [
                    animation::Step { property: "widget/width", from: RIPPLE_FROM, to: RIPPLE_TO, duration: RIPPLE, ease: animation::EASE_OUT_CUBIC, parallel: false },
                    animation::Step { property: "widget/height", from: RIPPLE_FROM, to: RIPPLE_TO, duration: RIPPLE, ease: animation::EASE_OUT_CUBIC, parallel: true },
                    animation::Step {
                        property: "widget/corner_radius",
                        from: RIPPLE_FROM / 2.0,
                        to: RIPPLE_TO / 2.0,
                        duration: RIPPLE,
                        ease: animation::EASE_OUT_CUBIC,
                        parallel: true,
                    },
                    animation::Step { property: "widget/inset", from: from, to: to, duration: RIPPLE, ease: animation::EASE_OUT_CUBIC, parallel: true },
                ],
            });
        }
        self.rings.push(Ring { slot: slot, until: engine::unix_time() + RIPPLE });
        ui::request_repaint(ui::RepaintOptions { after: RIPPLE + 0.05 });
    }
}
