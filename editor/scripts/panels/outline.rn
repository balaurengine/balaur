// The Outline tab's one script: it fills its list from the rows the Editor
// builds for the workspace, and hands it a pick.

pub fn init(this) {
    this.editor = scene::get_node("Editor");
    for word in ["outline_changed", "inspector_changed", "docks_changed"] {
        events::listen(this.node, word, this.editor);
    }
}

pub fn on_outline_changed(this, _change) {
    refresh(this);
}

pub fn on_inspector_changed(this, _change) {
    refresh(this);
}

pub fn on_docks_changed(this, _change) {
    refresh(this);
}

pub fn on_widget_event(this, event, node, value) {
    if event != "change" || node.name() != "List" {
        return;
    }
    let row = node.get_component("widget", "text");
    node.patch_component("widget", #{ text: "" });
    if row != "" {
        this.editor.call("secondary_pick", row);
    }
}

fn refresh(this) {
    let items = this.editor.call("secondary_view");
    if items is Vec {
        this.node.get_node("List").patch_component("widget", #{ options: items });
    }
}
