// The picker's one script: the command palette, the node picker and rename
// take turns on it, and whichever is up fills it through the Editor. What is
// typed runs the field's own handler first, then the rows follow it.

pub fn init(this) {
    this.editor = scene::get_node("Editor");
    events::listen(this.node, "picker_changed", this.editor);
}

pub fn on_picker_changed(this, _change) {
    this.editor.call("picker_fill");
}

pub fn on_widget_event(this, event, node, value) {
    if event == "closed" && node.name() == this.node.name() {
        this.editor.call("picker_closed");
        return;
    }
    if event == "click" || event == "change" || event == "submit" {
        this.editor.call("picker_fill");
    }
}
