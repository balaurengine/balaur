// The Weights tab's one script: the Editor fills it when the polygon, its
// pick or the selection moved, and it hands back the verbs. A weight's own
// field writes itself, and a vertex's or bone's own button picks it.

use editor;
use signals;

pub class Weights {
    node: Node,
    editor: editor::Editor?,
}

impl Weights {
    pub fn init() {
        let source = scene::get_node("Editor");
        self.editor = source.script;
        events::listen(self.node, signals::DOCKS, source);
        for word in ["weights_changed", signals::OUTLINE, signals::INSPECTOR] {
            events::listen(self.node, word, source);
        }
    }

    pub fn on_weights_changed(_change: any) {
        self.refresh();
    }

    pub fn on_outline_changed(_change: any) {
        self.refresh();
    }

    pub fn on_inspector_changed(_change: any) {
        self.refresh();
    }

    pub fn verb(_value: any, node: Node) {
        self.editor.unwrap().weights_verb(node.name());
        self.refresh();
    }

    pub fn refill() {
        self.refresh();
    }

    /// The dock showed or hid this panel: shown, it fills.
    pub fn on_docks_changed(_change: any) {
        if self.node.visible() {
            self.refresh();
        }
    }

    /// Fill what shows: on a word, and from the dock once it is visible.
    pub fn refresh() {
        if self.node.visible() == false {
            return;
        }
        self.editor.unwrap().weights_fill();
    }
}
