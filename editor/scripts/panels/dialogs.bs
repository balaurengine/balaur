// The plugin dialogs' one script: the Editor fills them when a plugin says
// what they show moved, the document moved, or the stage they sit on did.

pub class Dialogs {
    node: Node,
    editor: Node,
}

impl Dialogs {
    pub fn init() {
        self.editor = scene::get_node("Editor");
        for word in ["plugins_changed", "outline_changed", "stage_changed"] {
            events::listen(self.node, word, self.editor);
        }
    }

    pub fn on_plugins_changed(_change: any) {
        self.editor.call("dialogs_fill");
    }

    pub fn on_outline_changed(_change: any) {
        self.editor.call("dialogs_fill");
    }

    pub fn on_stage_changed(_change: any) {
        self.editor.call("dialogs_fill");
    }

    /// A control has run its own handler by now, so what is left is to show
    /// what it changed.
    pub fn on_widget_event(event: str, node: Node, value: any) {
        if event == "click" || event == "change" || event == "submit" {
            self.editor.call("dialogs_fill");
        }
    }
}
