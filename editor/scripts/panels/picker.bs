// The picker's one script: the command palette, the node picker and rename
// take turns on it, and whichever is up fills it through the Editor. What is
// typed runs the field's own handler first, then the rows follow it.

use editor;

pub class Picker {
    node: Node,
    editor: editor::Editor?,
}

impl Picker {
    pub fn init() {
        let source = scene::root().get_node("Editor");
        self.editor = source.script;
        events::listen(self.node, "picker_changed", source);
    }

    pub fn on_picker_changed(_change: any) {
        self.editor.unwrap().picker_fill();
    }

    pub fn closed() {
        self.editor.unwrap().picker_closed();
    }

    pub fn typed(value: any) {
        self.editor.unwrap().picker_typed(value.as_str());
        self.refill();
    }

    pub fn submitted(value: any) {
        self.editor.unwrap().picker_submitted(value.as_str());
        self.refill();
    }

    /// A row picked, by its key.
    pub fn picked(value: any) {
        self.editor.unwrap().picker_picked(value.as_str());
        self.refill();
    }

    /// Rename's command pressed.
    pub fn applied(_value: any, _node: Node) {
        self.editor.unwrap().rename_apply();
        self.refill();
    }

    pub fn refill() {
        self.editor.unwrap().picker_fill();
    }
}
