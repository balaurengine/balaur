// The picker's one script: the command palette, the node picker and rename
// take turns on it, and whichever is up fills it through the Editor. What is
// typed runs the field's own handler first, then the rows follow it.

use editor;

pub class Picker {
    node: Node,
    editor: editor::Editor?,
}

impl Picker {
    pub fn init() {
        let source = scene::get_node("Editor");
        self.editor = source.script;
        events::listen(self.node, "picker_changed", source);
    }

    pub fn on_picker_changed(_change: any) {
        self.editor.unwrap().picker_fill();
    }

    pub fn closed() {
        self.editor.unwrap().picker_closed();
    }

    pub fn refill() {
        self.editor.unwrap().picker_fill();
    }
}
