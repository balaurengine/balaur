// The refactor sheet's one script: the name and what it becomes go to the
// Editor as they are typed, and it says back what would change.

pub fn init(this) {
    this.editor = scene::get_node("Editor");
    this.open = false;
    events::listen(this.node, "refactor_changed", this.editor);
}

pub fn on_refactor_changed(this, _change) {
    refresh(this);
}

pub fn on_widget_event(this, event, node, value) {
    let name = node.name();
    if (name == "From" || name == "To") && event == "change" {
        this.editor.call("refactor_set", name, value);
    } else if name == "Apply" && event == "click" {
        this.editor.call("refactor_apply");
    } else if name == "Cancel" && event == "click" {
        this.editor.call("refactor_close");
    }
}

fn refresh(this) {
    let view = this.editor.call("refactor_view");
    if !(view is Object) {
        return;
    }
    this.node.patch_component("widget", #{ visible: view.open });
    if !view.open {
        this.open = false;
        return;
    }
    this.node.get_node("Title").patch_component("widget", #{ text: view.title });
    // The fields' text only as the sheet opens: after that it is what is typed.
    if !this.open {
        this.node.get_node("From").patch_component("widget", #{ text: view.from, placeholder: view.from_hint });
        this.node.get_node("To").patch_component("widget", #{ text: view.to, placeholder: view.to_hint });
        ui::set_focus(this.node.get_node(if view.from == "" { "From" } else { "To" }));
    }
    this.open = true;
    this.node.get_node("Count").patch_component("widget", #{ text: view.count });
    this.node.get_node("Hits").patch_component("widget", #{ options: view.hits });
    this.node.get_node("Verbs/Apply").patch_component("widget", #{ enabled: view.ready });
}
