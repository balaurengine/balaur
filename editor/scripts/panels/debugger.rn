// The Debugger tab's one script: it shows the stop the Editor heard from the
// engine, or what to do while there is none, and answers the steps, pause,
// break on error and a frame picked in the stack.

const STEPS = ["continue", "over", "into", "out"];

pub fn init(this) {
    this.editor = scene::get_node("Editor");
    events::listen(this.node, "debugger_changed", this.editor);
    events::listen(this.node, "outline_changed", this.editor);
}

/// A script stopped or went on, play started or stopped, or a frame was
/// picked.
pub fn on_debugger_changed(this, _change) {
    refresh(this);
}

/// The theme moved, which inks the stack.
pub fn on_outline_changed(this, _change) {
    refresh(this);
}

pub fn on_widget_event(this, event, node, value) {
    if event != "click" {
        return;
    }
    let name = node.name();
    if STEPS.iter().any(|step| step == name) {
        this.editor.call("debugger_step", name);
    } else if name == "Pause" {
        this.editor.call("debugger_pause");
    } else if name == "BreakOnError" {
        this.editor.call("debugger_break_on_error");
        refresh(this);
    } else if name == "Stack" {
        this.editor.call("debugger_frame", node.get_component("widget", "text"));
    }
}

/// Fill what shows from the Editor's answer: on a word that it moved, and
/// from the dock once it has made this panel visible.
pub fn refresh(this) {
    if this.node.get_component("widget", "visible") == false {
        return;
    }
    let view = this.editor.call("debugger_view");
    if !(view is Object) {
        return;
    }
    let tools = this.node.get_node("Tools");
    tools.get_node("Pause").patch_component("widget", #{ visible: view.can_pause });
    for (n, step) in STEPS.iter().enumerate() {
        let shown = #{ visible: view.stopped };
        if view.stopped {
            shown.text = view.steps[n];
        }
        tools.get_node(step).patch_component("widget", shown);
    }
    tools.get_node("Where").patch_component("widget", #{ text: view.where });
    tools.get_node("Threw").patch_component("widget", #{ visible: view.threw != "", text: view.threw });
    tools.get_node("BreakOnError").patch_component("widget", #{ checked: view.break_on_error });
    this.node.get_node("Stack").patch_component("widget", #{
        visible: view.stopped, options: view.frames, text: view.picked,
    });
}
