// The Output tab's one script: it fills the log list when the engine says
// lines arrived, and answers its clear, its levels and its search.

const LEVELS = ["error", "warn", "all"];

pub fn init(this) {
    this.level = "all";
    this.query = "";
    this.editor = scene::get_node("Editor");
    events::listen(this.node, "logged");
    events::listen(this.node, "outline_changed", this.editor);
}

pub fn on_logged(this, _total) {
    refresh(this);
}

/// The theme moved, which inks the lines.
pub fn on_outline_changed(this, _change) {
    refresh(this);
}

pub fn on_widget_event(this, event, node, value) {
    let name = node.name();
    if name == "Clear" && event == "click" {
        this.editor.call("output_clear");
    } else if LEVELS.iter().any(|level| level == name) && event == "click" {
        this.level = name;
    } else if name == "Search" && event == "change" {
        this.query = value;
    } else {
        return;
    }
    refresh(this);
}

/// Fill what shows from the Editor's answer: on a word that it moved, and
/// from the dock once it has made this panel visible.
pub fn refresh(this) {
    // A hidden log costs nothing: it is filled again when it shows.
    if this.node.get_component("widget", "visible") == false {
        return;
    }
    let view = this.editor.call("output_view", this.level, this.query);
    if !(view is Object) {
        return;
    }
    this.node.get_node("Log").patch_component("widget", #{ options: view.items });
    this.node.get_node("Nothing").patch_component("widget", #{
        visible: view.says != "", text: view.says,
    });
    let tools = this.node.get_node("Tools");
    for level in LEVELS {
        let on = level == this.level;
        // A chip's own lit state: the theme dresses it, nothing here names a
        // colour.
        tools.get_node(level).patch_component("widget", #{ checked: on });
    }
}
