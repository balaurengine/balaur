// The Docs tab's one script: it shows the module the Editor says is picked,
// filtered by its own search, and tells the Editor a new pick.

pub fn init(this) {
    this.query = "";
    this.editor = scene::get_node("Editor");
    for word in ["docs_changed", "outline_changed"] {
        events::listen(this.node, word, this.editor);
    }
}

pub fn on_docs_changed(this, _change) {
    refresh(this);
}

pub fn on_outline_changed(this, _change) {
    refresh(this);
}

pub fn on_widget_event(this, event, node, value) {
    if event != "change" {
        return;
    }
    let name = node.name();
    if name == "Module" {
        this.editor.call("docs_pick", value);
    } else if name == "Search" {
        this.query = value;
    } else {
        return;
    }
    refresh(this);
}

/// Fill what shows from the Editor's answer: on a word that it moved, and
/// from the dock once it has made this panel visible.
pub fn refresh(this) {
    if this.node.get_component("widget", "visible") == false {
        return;
    }
    let view = this.editor.call("docs_view", this.query);
    if !(view is Object) {
        return;
    }
    this.node.get_node("Tools/Module").patch_component("widget", #{
        options: view.modules, text: view.pick,
    });
    this.node.get_node("List").patch_component("widget", #{ options: view.items });
    this.node.get_node("Nothing").patch_component("widget", #{
        visible: view.says != "", text: view.says,
    });
}
