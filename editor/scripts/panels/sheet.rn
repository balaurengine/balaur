// The sheet's one script: whichever screen is up fills it through the Editor
// on a word, and again after a control's own handler ran. Escape or a click
// on the dim shuts it.

pub fn init(this) {
    this.editor = scene::get_node("Editor");
    events::listen(this.node, "sheet_changed", this.editor);
}

pub fn on_sheet_changed(this, _change) {
    this.editor.call("sheet_fill");
}

pub fn on_widget_event(this, event, node, value) {
    if event == "closed" && node.name() == this.node.name() {
        this.editor.call("sheet_closed");
        return;
    }
    if event == "click" || event == "change" || event == "submit" || event == "commit" {
        this.editor.call("sheet_fill");
    }
}
