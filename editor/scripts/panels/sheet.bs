// The sheet's one script: whichever screen is up fills it through the Editor
// on a word, and again after a control's own handler ran. Escape or a click
// on the dim shuts it.

use editor;

pub class Sheet {
    node: Node,
    editor: editor::Editor?,
}

impl Sheet {
    pub fn init() {
        let source = scene::root().get_node("Editor");
        self.editor = source.script;
        events::listen(self.node, "sheet_changed", source);
    }

    pub fn on_sheet_changed(_change: any) {
        self.editor.unwrap().sheet_fill();
    }

    pub fn closed() {
        self.editor.unwrap().sheet_closed();
    }

    pub fn close_pressed(_value: any, _node: Node) {
        self.editor.unwrap().sheet_close();
    }

    /// A page of the sidebar picked.
    pub fn side_picked(value: any) {
        self.editor.unwrap().sheet_side_picked(value.as_str());
        self.refill();
    }

    /// What was typed in the sidebar's search.
    pub fn side_searched(value: any) {
        self.editor.unwrap().sheet_side_searched(value.as_str());
        self.refill();
    }

    pub fn refill() {
        self.editor.unwrap().sheet_fill();
    }
}
