// The sheet's one script: whichever screen is up fills it through the Editor
// on a word, and again after a control's own handler ran. Escape or a click
// on the dim shuts it.

use editor;

pub class Sheet {
    node: Node,
    editor: editor::Editor?,
}

impl Sheet {
    pub fn init() {
        let source = scene::get_node("Editor");
        self.editor = source.script;
        events::listen(self.node, "sheet_changed", source);
    }

    pub fn on_sheet_changed(_change: any) {
        self.editor.unwrap().sheet_fill();
    }

    pub fn closed() {
        self.editor.unwrap().sheet_closed();
    }

    pub fn refill() {
        self.editor.unwrap().sheet_fill();
    }
}
