// The sheet's one script: whichever screen is up fills it through the Editor
// on a word, and again after a control's own handler ran. Escape or a click
// on the dim shuts it.

pub class Sheet {
    node: Node,
    editor: Node,
}

impl Sheet {
    pub fn init() {
        self.editor = scene::get_node("Editor");
        events::listen(self.node, "sheet_changed", self.editor);
    }

    pub fn on_sheet_changed(_change: any) {
        self.editor.call("sheet_fill");
    }

    pub fn closed() {
        self.editor.call("sheet_closed");
    }

    pub fn refill() {
        self.editor.call("sheet_fill");
    }
}
