// The Inspector's one script: it answers every control in its scene and has
// the Editor, which owns the document, fill the form's rows.

pub fn init(this) {
    this.query = "";
    this.editor = scene::get_node("Editor");
    events::listen(this.node, "outline_changed", this.editor);
    events::listen(this.node, "inspector_changed", this.editor);
}

/// The document, the selection or what a row shows moved: the native rows
/// read their component again too.
pub fn on_outline_changed(this, _change) {
    refresh(this);
    ui::reread(this.node);
}

pub fn on_inspector_changed(this, _change) {
    refresh(this);
    ui::reread(this.node);
}

pub fn on_widget_event(this, event, node, value) {
    // Where the pointer or the scroll went changes nothing the form shows.
    if event == "scrolled" || event == "focus" || event == "blur" {
        return;
    }
    let name = node.name();
    if name == "Search" && event == "change" {
        this.query = value;
    } else if name == "Add" && event == "click" {
        this.editor.call("inspector_add");
        return;
    }
    // Any other control is a row of the form, whose handler has already run
    // and may have moved what the form is built from.
    refresh(this);
}

fn refresh(this) {
    let view = this.editor.call("inspector_view");
    if !(view is Object) {
        return;
    }
    let head = this.node.get_node("Head");
    let nothing = this.node.get_node("Nothing");
    if !view.selected {
        for one in [head, this.node.get_node("Search"), this.node.get_node("Scroll"), this.node.get_node("Foot")] {
            one.patch_component("widget", #{ visible: false });
        }
        nothing.patch_component("widget", #{ visible: true });
        return;
    }
    nothing.patch_component("widget", #{ visible: false });
    for one in [head, this.node.get_node("Search"), this.node.get_node("Scroll"), this.node.get_node("Foot")] {
        one.patch_component("widget", #{ visible: true });
    }
    head.get_node("Name").patch_component("widget", #{
        text: view.name, icon: view.icon, icon_color: view.icon_color,
    });
    head.get_node("Type").patch_component("widget", #{ text: view.kind });
    this.node.get_node("Foot").get_node("Add").patch_component("widget", #{ icon: view.add_icon });
    this.editor.call("inspector_fill", this.query);
}
