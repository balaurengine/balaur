// The refactor sheet's one script: the name and what it becomes go to the
// Editor as they are typed, and it says back what would change.

pub class Refactor {
    node: Node,
    editor: Node,
    open: bool,
}

impl Refactor {
    pub fn init() {
        self.editor = scene::get_node("Editor");
        self.open = false;
        events::listen(self.node, "refactor_changed", self.editor);
    }

    pub fn on_refactor_changed(_change: any) {
        self.refresh();
    }

    pub fn field_typed(value: any, node: Node) {
        self.editor.call("refactor_set", node.name(), value);
    }

    pub fn apply() {
        self.editor.call("refactor_apply");
    }

    pub fn cancel() {
        self.editor.call("refactor_close");
    }

    fn refresh() {
        let view = self.editor.call("refactor_view");
        if !(view.kind() == "map") {
            return;
        }
        self.node.set_visible(view["open"].as_bool());
        if !view["open"].as_bool() {
            self.open = false;
            return;
        }
        self.node.get_node("Title").widget.text = view["title"].as_str();
        // The fields' text only as the sheet opens: after that it is what is typed.
        if !self.open {
            self.node.get_node("From").widget.text = view["from"].as_str();
            self.node.get_node("From").widget_field.placeholder = view["from_hint"].as_str();
            self.node.get_node("To").widget.text = view["to"].as_str();
            self.node.get_node("To").widget_field.placeholder = view["to_hint"].as_str();
            ui::set_focus(self.node.get_node(if view["from"].as_str() == "" { "From" } else { "To" }));
        }
        self.open = true;
        self.node.get_node("Count").widget.text = view["count"].as_str();
        self.node.get_node("Hits").widget_rows.items = view["hits"];
        self.node.get_node("Verbs/Apply").widget.enabled = view["ready"].as_bool();
    }
}
