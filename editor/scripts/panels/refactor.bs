// The refactor sheet's one script: the name and what it becomes go to the
// Editor as they are typed, and it says back what would change.

use editor;

pub class Refactor {
    node: Node,
    editor: editor::Editor?,
    open: bool,
}

impl Refactor {
    pub fn init() {
        let source = scene::get_node("Editor");
        self.editor = source.script;
        self.open = false;
        events::listen(self.node, "refactor_changed", source);
    }

    pub fn on_refactor_changed(_change: any) {
        self.refresh();
    }

    pub fn field_typed(value: any, node: Node) {
        self.editor.unwrap().refactor_set(node.name(), value.as_str());
    }

    pub fn apply() {
        self.editor.unwrap().refactor_apply();
    }

    pub fn cancel() {
        self.editor.unwrap().refactor_close();
    }

    fn refresh() {
        let view = self.editor.unwrap().refactor_view();
        self.node.set_visible(view.open);
        if !view.open {
            self.open = false;
            return;
        }
        self.node.get_node("Title").widget.text = view.title;
        // The fields' text only as the sheet opens: after that it is what is typed.
        if !self.open {
            self.node.get_node("From").widget.text = view.from;
            self.node.get_node("From").widget_field.placeholder = view.from_hint;
            self.node.get_node("To").widget.text = view.to;
            self.node.get_node("To").widget_field.placeholder = view.to_hint;
            ui::set_focus(self.node.get_node(if view.from == "" { "From" } else { "To" }));
        }
        self.open = true;
        self.node.get_node("Count").widget.text = view.count;
        self.node.get_node("Hits").widget_rows.items = view.hits;
        self.node.get_node("Verbs/Apply").widget.enabled = view.ready;
    }
}
