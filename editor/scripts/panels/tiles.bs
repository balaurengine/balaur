// The Tiles tab's one script: it has the Editor fill its chips and its atlas
// when the tilemap, the selection or the brush moved, and answers a tile pick.

use editor;

pub class Tiles {
    node: Node,
    editor: editor::Editor?,
}

pub struct Parameters {
    items: any,
    text: any,
}

impl Tiles {
    pub fn init() {
        let source = scene::get_node("Editor");
        self.editor = source.script;
        events::listen(self.node, "docks_changed", source);
        events::listen(self.node, "tiles_changed", source);
        events::listen(self.node, "outline_changed", source);
    }

    pub fn on_tiles_changed(_change: any) {
        self.refresh();
    }

    /// The selection or the document moved, which picks the tilemap.
    pub fn on_outline_changed(_change: any) {
        self.refresh();
    }

    /// A chip has run its own handler by now, so what is left is to show what
    /// it changed; a card is a tile picked.
    pub fn card_clicked(_value: any, node: Node) {
        self.editor.unwrap().tiles_pick(node.widget.text);
    }

    pub fn refill() {
        self.refresh();
    }

    /// The dock showed or hid this panel: shown, it fills.
    pub fn on_docks_changed(_change: any) {
        if self.node.visible() {
            self.refresh();
        }
    }

    /// Fill what shows from the Editor's answer: on a word that it moved, and
    /// from the dock once it has made this panel visible.
    pub fn refresh() {
        if self.node.visible() == false {
            return;
        }
        let view = self.editor.unwrap().tiles_fill();
        let cards = view.items.len() > 0;
        let list = self.node.get_node("Cards");
        list.set_visible(cards);
        list.widget_rows.items = view.items;
        list.widget.text = view.picked;
        if cards {
            list.widget_list.sheet = view.sheet;
        }
    }
}
