// The tool rail's one script: the workspace's tools, filled by the Editor when
// the workspace, the tool or the room moved, and the folded left dock's
// handle over them. A mark runs its tool itself, then the rail fills again.

pub class Rail {
    node: Node,
    editor: Node,
}

impl Rail {
    pub fn init() {
        self.editor = scene::get_node("Editor");
        events::listen(self.node, "rail_changed", self.editor);
        events::listen(self.node, "stage_changed", self.editor);
    }

    pub fn on_rail_changed(_change: any) {
        self.editor.call("rail_fill");
    }

    pub fn on_stage_changed(_change: any) {
        self.handle();
    }

    pub fn open_left() {
        self.editor.call("stage_verb", "open_left");
    }

    pub fn refill() {
        self.editor.call("rail_fill");
    }

    fn handle() {
        let view = self.editor.call("stage_view");
        if !(view.kind() == "map") {
            return;
        }
        let sheet = self.node.get_node("RailTop/Handle");
        sheet.set_visible(view["rail_handle"].as_bool());
        sheet.patch_component("widget", { "padding": view["pad"] });
        let patched = sheet.get_node("Open");
        patched.widget.icon = view["left"]["icon"].as_str();
        patched.widget.tooltip = view["left"]["tooltip"].as_str();
        patched.widget.width = view["diameter"].as_float();
        patched.widget.height = view["diameter"].as_float();
        patched.widget.corner_radius = view["diameter"].as_float() / 2.0;
    }
}
