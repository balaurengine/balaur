// The tool rail's one script: the workspace's tools, filled by the Editor when
// the workspace, the tool or the room moved, and the folded left dock's
// handle over them. A mark runs its tool itself, then the rail fills again.

use editor;

pub class Rail {
    node: Node,
    editor: editor::Editor?,
}

impl Rail {
    pub fn init() {
        let source = scene::get_node("Editor");
        self.editor = source.script;
        events::listen(self.node, "rail_changed", source);
        events::listen(self.node, "stage_changed", source);
    }

    pub fn on_rail_changed(_change: any) {
        self.editor.unwrap().rail_fill();
    }

    pub fn on_stage_changed(_change: any) {
        self.handle();
    }

    pub fn open_left() {
        self.editor.unwrap().stage_verb("open_left");
    }

    pub fn refill() {
        self.editor.unwrap().rail_fill();
    }

    fn handle() {
        let view = self.editor.unwrap().stage_view();
        let sheet = self.node.get_node("RailTop/Handle");
        sheet.set_visible(view.rail_handle);
        sheet.patch_component("widget", { "padding": view.pad });
        let patched = sheet.get_node("Open");
        patched.widget_button.icon = view.left.icon;
        patched.widget.tooltip = view.left.tooltip;
        patched.widget.width = view.diameter;
        patched.widget.height = view.diameter;
        patched.widget.corner_radius = view.diameter / 2.0;
    }
}
