// The viewport lines' one script: the Editor draws them again and keeps them
// when the document, the selection, the tool, play, the camera or a file moved.

use editor;

pub class Overlays {
    node: Node,
    editor: editor::Editor?,
}

impl Overlays {
    pub fn init() {
        let source = scene::get_node("Editor");
        self.editor = source.script;
        for word in [
            "outline_changed",
            "inspector_changed",
            "stage_changed",
            "play_frame",
            "timeline_changed",
            "recordings_changed",
            "plugins_changed",
            "chrome_changed",
        ] {
            events::listen(self.node, word, source);
        }
        events::listen(self.node, "camera_moved");
        events::listen(self.node, "assets_reloaded");
    }

    pub fn on_outline_changed(_change: any) {
        self.editor.unwrap().overlays_fill();
    }

    pub fn on_inspector_changed(_change: any) {
        self.editor.unwrap().overlays_fill();
    }

    pub fn on_stage_changed(_change: any) {
        self.editor.unwrap().overlays_fill();
    }

    pub fn on_play_frame(_change: any) {
        self.editor.unwrap().overlays_fill();
    }

    pub fn on_timeline_changed(_change: any) {
        self.editor.unwrap().overlays_fill();
    }

    pub fn on_recordings_changed(_change: any) {
        self.editor.unwrap().overlays_fill();
    }

    pub fn on_plugins_changed(_change: any) {
        self.editor.unwrap().overlays_fill();
    }

    pub fn on_chrome_changed(_change: any) {
        self.editor.unwrap().overlays_fill();
    }

    pub fn on_camera_moved(_nothing: any) {
        self.editor.unwrap().overlays_fill();
    }

    pub fn on_assets_reloaded(_generation: any) {
        self.editor.unwrap().overlays_fill();
    }
}
