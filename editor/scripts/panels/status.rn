// The status strip's one script: what the editor is doing, how big the scene
// is, and the workspace and tool in hand, filled when any of them moved.

pub fn init(this) {
    this.editor = scene::get_node("Editor");
    events::listen(this.node, "status_changed", this.editor);
}

pub fn on_status_changed(this, _change) {
    this.editor.call("status_fill");
}
