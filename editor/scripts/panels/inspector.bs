// The Inspector's one script: it answers every control in its scene and has
// the Editor, which owns the document, fill the form's rows.

pub class Inspector {
    node: Node,
    query: str,
    editor: Node,
}

impl Inspector {
    pub fn init() {
        self.query = "";
        self.editor = scene::get_node("Editor");
        events::listen(self.node, "outline_changed", self.editor);
        events::listen(self.node, "inspector_changed", self.editor);
    }

    /// The document, the selection or what a row shows moved: the native rows
    /// read their component again too.
    pub fn on_outline_changed(_change: any) {
        self.refresh();
        ui::reread(self.node);
    }

    pub fn on_inspector_changed(_change: any) {
        self.refresh();
        ui::reread(self.node);
    }

    pub fn on_widget_event(event: str, node: Node, value: any) {
        // Where the pointer or the scroll went changes nothing the form shows.
        if event == "scrolled" || event == "focus" || event == "blur" {
            return;
        }
        let name = node.name();
        if name == "Search" && event == "change" {
            self.query = value.as_str();
        } else if name == "Add" && event == "click" {
            self.editor.call("inspector_add");
            return;
        }
        // Any other control is a row of the form, whose handler has already run
        // and may have moved what the form is built from.
        self.refresh();
    }

    fn refresh() {
        let view = self.editor.call("inspector_view");
        if !(view.kind() == "map") {
            return;
        }
        let head = self.node.get_node("Head");
        let nothing = self.node.get_node("Nothing");
        if !view.get("selected").as_bool() {
            for one in [head, self.node.get_node("Search"), self.node.get_node("Scroll"), self.node.get_node("Foot")] {
                one.patch_component("widget", map().with("visible", false));
            }
            nothing.patch_component("widget", map().with("visible", true));
            return;
        }
        nothing.patch_component("widget", map().with("visible", false));
        for one in [head, self.node.get_node("Search"), self.node.get_node("Scroll"), self.node.get_node("Foot")] {
            one.patch_component("widget", map().with("visible", true));
        }
        head.get_node("Name").patch_component("widget", map()
            .with("text", view.get("name"))
            .with("icon", view.get("icon"))
            .with("icon_color", view.get("icon_color")));
        head.get_node("Type").patch_component("widget", map().with("text", view.get("kind")));
        self.node.get_node("Foot").get_node("Add").patch_component("widget", map().with("icon", view.get("add_icon")));
        self.editor.call("inspector_fill", self.query);
    }
}
