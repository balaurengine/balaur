// The Inspector's one script: it answers the head's controls, says when the
// form must follow, and has the Editor, which owns the document, build the
// rows. A hidden Inspector does nothing, and is filled when it is shown.

use editor;
use signals;

const RESIZED: str = "resized";

pub class Inspector {
    node: Node,
    query: str,
    editor: editor::Editor?,
}

impl Inspector {
    pub fn init() {
        self.query = "";
        let source = scene::get_node("Editor");
        self.editor = source.script;
        events::listen(self.node, signals::OUTLINE, source);
        events::listen(self.node, signals::INSPECTOR, source);
        events::listen(self.node, signals::PLUGINS_CHANGED, source);
        events::listen(self.node, RESIZED, self.node.get_node("Scroll"));
    }

    /// The document or the selection moved.
    pub fn on_outline_changed(_change: any) {
        self.refresh();
    }

    /// What the form is built from beside them moved, or a frame of play,
    /// where the rows on screen read their values again and nothing else.
    pub fn on_inspector_changed(_change: any) {
        if self.node.visible_in_tree() && !self.editor.unwrap().inspector_reread() {
            self.refresh();
        }
    }

    pub fn on_plugins_changed(_change: any) {
        self.refresh();
    }

    pub fn on_resized(_box: any) {
        self.editor.unwrap().inspector_resized();
    }

    /// The form scrolled to `[x, y]`.
    pub fn scrolled(offset: any) {
        self.editor.unwrap().inspector_scrolled(offset[1].as_float());
    }

    pub fn search_typed(value: any) {
        self.query = value.as_str();
        self.refresh();
    }

    pub fn add() {
        self.editor.unwrap().inspector_add();
    }

    // A plugin's drawer wrote through the Editor and may have moved what the
    // form is built from.
    pub fn refill() {
        self.refresh();
    }

    fn refresh() {
        if !self.node.visible_in_tree() {
            return;
        }
        let view = self.editor.unwrap().inspector_view();
        let head = self.node.get_node("Head");
        let nothing = self.node.get_node("Nothing");
        if !view.selected {
            for one in [head, self.node.get_node("Search"), self.node.get_node("Scroll"), self.node.get_node("Foot")] {
                one.set_visible(false);
            }
            nothing.set_visible(true);
            return;
        }
        nothing.set_visible(false);
        for one in [head, self.node.get_node("Search"), self.node.get_node("Scroll"), self.node.get_node("Foot")] {
            one.set_visible(true);
        }
        let patched = head.get_node("Name");
        patched.widget.text = view.name;
        patched.widget_button.icon = view.icon;
        patched.widget_button.icon_color = view.icon_color;
        head.get_node("Type").widget.text = view.kind;
        self.node.get_node("Foot").get_node("Add").widget_button.icon = view.add_icon;
        self.editor.unwrap().inspector_fill(self.query);
    }
}
