// The Tiles tab's one script: it has the Editor fill its chips and its atlas
// when the tilemap, the selection or the brush moved, and answers a tile pick.

pub fn init(this) {
    this.editor = scene::get_node("Editor");
    events::listen(this.node, "tiles_changed", this.editor);
    events::listen(this.node, "outline_changed", this.editor);
}

pub fn on_tiles_changed(this, _change) {
    refresh(this);
}

/// The selection or the document moved, which picks the tilemap.
pub fn on_outline_changed(this, _change) {
    refresh(this);
}

/// A chip has run its own handler by now, so what is left is to show what
/// it changed; a card is a tile picked.
pub fn on_widget_event(this, event, node, value) {
    if node.name() == "Cards" && event == "click" {
        this.editor.call("tiles_pick", node.get_component("widget", "text"));
        return;
    }
    if event == "click" || event == "change" {
        refresh(this);
    }
}

/// Fill what shows from the Editor's answer: on a word that it moved, and
/// from the dock once it has made this panel visible.
pub fn refresh(this) {
    if this.node.get_component("widget", "visible") == false {
        return;
    }
    let view = this.editor.call("tiles_fill");
    if !(view is Object) {
        return;
    }
    let cards = view.items.len() > 0;
    let params = #{ visible: cards, options: view.items, text: view.picked };
    if cards {
        params.sheet = view.sheet;
    }
    this.node.get_node("Cards").patch_component("widget", params);
}
