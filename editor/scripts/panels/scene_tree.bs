// The Scene tab's one script: it answers every control in its scene and
// fills the tree from the rows the Editor, which owns the document, hands it.

pub class SceneTree {
    node: Node,
    query: str,
    facet: str,
    editor: Node,
}

/// The component tag the facet labelled `label` filters on; "" for all.
fn facet_tag(label: any) -> str {
    if label.as_str() == "3D" {
        "3d"
    } else if label.as_str() == "2D" {
        "2d"
    } else if label.as_str() == "Physics" {
        "physics"
    } else if label.as_str() == "Rendering" {
        "render"
    } else if label.as_str() == "UI" {
        "ui"
    } else if label.as_str() == "Script" {
        "script"
    } else {
        ""
    }
}

impl SceneTree {
    pub fn init() {
        self.query = "";
        self.facet = "";
        self.editor = scene::get_node("Editor");
        events::listen(self.node, "outline_changed", self.editor);
    }

    /// The Editor's word that the document, the selection, a lock or a warning
    /// moved.
    pub fn on_outline_changed(_change: any) {
        self.refresh();
    }

    pub fn on_widget_event(event: str, node: Node, value: any) {
        let name = node.name();
        if name == "Add" && event == "click" {
            self.editor.call("scene_add");
            return;
        }
        if event != "change" {
            return;
        }
        if name == "Search" {
            self.query = value.as_str();
            self.refresh();
        } else if name == "Facet" {
            self.facet = facet_tag(value);
            self.refresh();
        } else if name == "Tree" {
            // `text` is the row the click landed on. The set the tree lit is the
            // Editor's to decide, so the rows are filled again from its answer
            // even when the pick changed nothing.
            let row = node.get_component("widget", "text");
            node.patch_component("widget", map().with("text", ""));
            if row.as_str() != "" {
                self.editor.call("outline_pick", row);
            }
            self.refresh();
        }
    }

    /// Search the tree for `query`, as the `find:` start state does.
    pub fn find(query: str) {
        self.query = query;
        self.node.get_node("Find/Search").patch_component("widget", map().with("text", query));
        self.refresh();
    }

    fn refresh() {
        let view = self.editor.call("outline_view", self.query, self.facet);
        if !(view.kind() == "map") {
            return;
        }
        self.node.get_node("Find/Add").patch_component("widget", map().with("icon", view.get("add_icon")));
        let tree = self.node.get_node("Tree");
        let nothing = self.node.get_node("Nothing");
        if view.get("filtering") && view.get("items").len() == 0 {
            tree.patch_component("widget", map().with("visible", false));
            nothing.patch_component("widget", map().with("visible", true).with("text", view.get("nothing")));
            return;
        }
        nothing.patch_component("widget", map().with("visible", false));
        tree.patch_component("widget", map()
            .with("visible", true)
            .with("options", view.get("items"))
            .with("selection", view.get("chosen")));
    }
}
