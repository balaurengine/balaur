// The Scene tab's one script: it answers every control in its scene and
// fills the tree from the rows the Editor, which owns the document, hands it.

pub class SceneTree {
    node: Node,
    query: str,
    facet: str,
    editor: Node,
    /// What names the rows the tree holds.
    drawn: str,
}

/// The component tag the facet labelled `label` filters on; "" for all.
fn facet_tag(label: any) -> str {
    if label.as_str() == "3D" {
        "3d"
    } else if label.as_str() == "2D" {
        "2d"
    } else if label.as_str() == "Physics" {
        "physics"
    } else if label.as_str() == "Rendering" {
        "render"
    } else if label.as_str() == "UI" {
        "ui"
    } else if label.as_str() == "Script" {
        "script"
    } else {
        ""
    }
}

impl SceneTree {
    pub fn init() {
        self.query = "";
        self.facet = "";
        self.drawn = "";
        self.editor = scene::get_node("Editor");
        events::listen(self.node, "outline_changed", self.editor);
    }

    /// The Editor's word that the document, the selection, a lock or a warning
    /// moved.
    pub fn on_outline_changed(_change: any) {
        self.refresh();
    }

    pub fn add() {
        self.editor.call("scene_add");
    }

    pub fn search_typed(value: any) {
        self.query = value.as_str();
        self.refresh();
    }

    pub fn facet_picked(value: any) {
        self.facet = facet_tag(value);
        self.refresh();
    }

    // `text` is the row the click landed on. The set the tree lit is the
    // Editor's to decide, so it is filled again from its answer even when the
    // pick changed nothing.
    pub fn tree_picked(_value: any, node: Node) {
        let row = node.widget.text;
        node.widget.text = "";
        if row != "" {
            self.editor.call("outline_pick", row);
        }
        self.refresh();
    }

    /// Search the tree for `query`, as the `find:` start state does.
    pub fn find(query: str) {
        self.query = query;
        self.node.get_node("Find/Search").widget.text = query;
        self.refresh();
    }

    fn refresh() {
        let view = self.editor.call("outline_view", self.query, self.facet, self.drawn);
        if !(view.kind() == "map") {
            return;
        }
        self.node.get_node("Find/Add").widget_button.icon = view["add_icon"].as_str();
        let tree = self.node.get_node("Tree");
        let nothing = self.node.get_node("Nothing");
        if view["filtering"].as_bool() && view["empty"].as_bool() {
            tree.set_visible(false);
            nothing.set_visible(true);
            nothing.widget.text = view["nothing"].as_str();
            return;
        }
        nothing.set_visible(false);
        tree.set_visible(true);
        if view["stamp"].as_str() != self.drawn {
            tree.widget_rows.items = view["items"];
            self.drawn = view["stamp"].as_str();
        }
        tree.widget_rows.selection = view["chosen"];
    }
}
