// The shell keys' one script: a chord's row names the command the Editor
// runs, and the command table says which of a chord's rows would act.

use editor;

pub class Keys {
    node: Node,
    editor: editor::Editor?,
}

impl Keys {
    pub fn init() {
        self.editor = scene::root().get_node("Editor").script;
    }

    pub fn on_shortcut_pressed(name: str) {
        self.editor.unwrap().key_pressed(name);
    }
}
