// The shell keys' one script: a chord clicks its button, and the button's
// name is the command the Editor runs. F5 is play until a script stops, and
// then it and the step keys are the debugger's.

use editor;
use signals;
use words::verbs;

pub class Keys {
    node: Node,
    editor: editor::Editor?,
}

fn STOPPED() -> [str] {
    ["continue", verbs::STEP_OVER, verbs::STEP_INTO, verbs::STEP_OUT]
}

impl Keys {
    pub fn init() {
        let source = scene::get_node("Editor");
        self.editor = source.script;
        events::listen(self.node, signals::DEBUGGER_CHANGED, source);
    }

    /// A script stopped or went on, or play started or stopped.
    pub fn on_debugger_changed(_change: any) {
        self.refresh();
    }

    pub fn pressed(_value: any, node: Node) {
        self.editor.unwrap().command(node.name());
    }

    fn refresh() {
        let state = self.editor.unwrap().keys_view();
        for name in STOPPED() {
            self.node.get_node(name).widget.enabled = state.stopped;
        }
        self.node.get_node(verbs::PLAY).widget.enabled = !state.stopped;
        self.node.get_node("break").widget.enabled = state.playing && !state.stopped;
    }
}
