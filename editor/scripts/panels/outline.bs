// The Outline tab's one script: it fills its list from the rows the Editor
// builds for the workspace, and hands it a pick.

pub class Outline {
    node: Node,
    editor: Node,
}

impl Outline {
    pub fn init() {
        self.editor = scene::get_node("Editor");
        for word in ["outline_changed", "inspector_changed", "docks_changed"] {
            events::listen(self.node, word, self.editor);
        }
    }

    pub fn on_outline_changed(_change: any) {
        self.refresh();
    }

    pub fn on_inspector_changed(_change: any) {
        self.refresh();
    }

    pub fn on_docks_changed(_change: any) {
        self.refresh();
    }

    pub fn list_picked(_value: any, node: Node) {
        let row = node.widget.text;
        node.widget.text = "";
        if row != "" {
            self.editor.call("secondary_pick", row);
        }
    }

    fn refresh() {
        let items = self.editor.call("secondary_view");
        if items.kind() == "list" {
            self.node.get_node("List").widget.items = items;
        }
    }
}
