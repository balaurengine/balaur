// The Outline tab's one script: it fills its list from the rows the Editor
// builds for the workspace, and hands it a pick.

use editor;
use signals;

pub class Outline {
    node: Node,
    editor: editor::Editor?,
}

impl Outline {
    pub fn init() {
        let source = scene::get_node("Editor");
        self.editor = source.script;
        for word in [signals::OUTLINE, signals::INSPECTOR, signals::DOCKS] {
            events::listen(self.node, word, source);
        }
    }

    pub fn on_outline_changed(_change: any) {
        self.refresh();
    }

    pub fn on_inspector_changed(_change: any) {
        self.refresh();
    }

    pub fn on_docks_changed(_change: any) {
        self.refresh();
    }

    pub fn list_picked(_value: any, node: Node) {
        let row = node.widget.text;
        node.widget.text = "";
        if row != "" {
            self.editor.unwrap().secondary_pick(row);
        }
    }

    fn refresh() {
        let items = self.editor.unwrap().secondary_view();
        self.node.get_node("List").widget_rows.items = items;
    }
}
