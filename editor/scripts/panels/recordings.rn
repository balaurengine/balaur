// The Recordings tab's one script: it has the Editor fill a row a recording
// when one is made, kept or dropped, and answers the verify switch.

pub fn init(this) {
    this.editor = scene::get_node("Editor");
    events::listen(this.node, "recordings_changed", this.editor);
}

pub fn on_recordings_changed(this, _change) {
    refresh(this);
}

/// The verify switch is this panel's own; a row's verbs have run their
/// handlers by now, so what is left is to show what they changed.
pub fn on_widget_event(this, event, node, value) {
    if event != "click" {
        return;
    }
    if node.name() == "Verify" {
        this.editor.call("recordings_verify");
    }
    refresh(this);
}

/// Fill what shows from the Editor's answer: on a word that it moved, and
/// from the dock once it has made this panel visible.
pub fn refresh(this) {
    if this.node.get_component("widget", "visible") == false {
        return;
    }
    let view = this.editor.call("recordings_fill");
    if !(view is Object) {
        return;
    }
    this.node.get_node("Tools/Verify").patch_component("widget", #{ checked: view.verify });
    this.node.get_node("Nothing").patch_component("widget", #{ visible: view.count == 0 });
}
