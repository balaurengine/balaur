// The Debugger tab's one script: it shows the stop the Editor heard from the
// engine, or what to do while there is none, and answers the steps, pause,
// break on error and a frame picked in the stack.

use editor;

pub class Debugger {
    node: Node,
    editor: editor::Editor?,
}

pub struct Shown {
    text: any,
}

fn STEPS() -> [str] {
    ["continue", "over", "into", "out"]
}

impl Debugger {
    pub fn init() {
        let source = scene::get_node("Editor");
        self.editor = source.script;
        events::listen(self.node, "docks_changed", source);
        events::listen(self.node, "debugger_changed", source);
        events::listen(self.node, "outline_changed", source);
    }

    /// A script stopped or went on, play started or stopped, or a frame was
    /// picked.
    pub fn on_debugger_changed(_change: any) {
        self.refresh();
    }

    /// The theme moved, which inks the stack.
    pub fn on_outline_changed(_change: any) {
        self.refresh();
    }

    pub fn step(_value: any, node: Node) {
        self.editor.unwrap().debugger_step(node.name());
    }

    pub fn pause() {
        self.editor.unwrap().debugger_pause();
    }

    pub fn break_on_error() {
        self.editor.unwrap().debugger_break_on_error();
        self.refresh();
    }

    pub fn frame_clicked(_value: any, node: Node) {
        self.editor.unwrap().debugger_frame(node.widget.text);
    }

    /// The dock showed or hid this panel: shown, it fills.
    pub fn on_docks_changed(_change: any) {
        if self.node.visible() {
            self.refresh();
        }
    }

    /// Fill what shows from the Editor's answer: on a word that it moved, and
    /// from the dock once it has made this panel visible.
    pub fn refresh() {
        if self.node.visible() == false {
            return;
        }
        let view = self.editor.unwrap().debugger_view();
        let tools = self.node.get_node("Tools");
        tools.get_node("Pause").set_visible(view.can_pause);
        let steps = STEPS();
        for index in 0..steps.len() {
            let step = steps[index];
            let shown = Shown { text: nil };
            if view.stopped {
                shown.text = view.steps[index];
            }
            tools.get_node(step).set_visible(view.stopped);
            tools.get_node(step).patch_component("widget", shown);
        }
        tools.get_node("Where").widget.text = view.where;
        let patched = tools.get_node("Threw");
        patched.set_visible(view.threw != "");
        patched.widget.text = view.threw;
        tools.get_node("BreakOnError").widget_check.checked = view.break_on_error;
        let patched = self.node.get_node("Stack");
        patched.set_visible(view.stopped);
        patched.widget_rows.items = view.frames;
        patched.widget.text = view.picked;
    }
}
