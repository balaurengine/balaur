// The Debugger tab's one script: it shows the stop the Editor heard from the
// engine, or what to do while there is none, and answers the steps, pause,
// break on error and a frame picked in the stack.

pub class Debugger {
    node: Node,
    editor: Node,
}

pub struct Shown {
    text: any,
}

fn STEPS() -> [str] {
    ["continue", "over", "into", "out"]
}

impl Debugger {
    pub fn init() {
        self.editor = scene::get_node("Editor");
        events::listen(self.node, "debugger_changed", self.editor);
        events::listen(self.node, "outline_changed", self.editor);
    }

    /// A script stopped or went on, play started or stopped, or a frame was
    /// picked.
    pub fn on_debugger_changed(_change: any) {
        self.refresh();
    }

    /// The theme moved, which inks the stack.
    pub fn on_outline_changed(_change: any) {
        self.refresh();
    }

    pub fn step(_value: any, node: Node) {
        self.editor.call("debugger_step", node.name());
    }

    pub fn pause() {
        self.editor.call("debugger_pause");
    }

    pub fn break_on_error() {
        self.editor.call("debugger_break_on_error");
        self.refresh();
    }

    pub fn frame_clicked(_value: any, node: Node) {
        self.editor.call("debugger_frame", node.widget.text);
    }

    /// Fill what shows from the Editor's answer: on a word that it moved, and
    /// from the dock once it has made this panel visible.
    pub fn refresh() {
        if self.node.visible() == false {
            return;
        }
        let view = self.editor.call("debugger_view");
        if !(view.kind() == "map") {
            return;
        }
        let tools = self.node.get_node("Tools");
        tools.get_node("Pause").set_visible(view["can_pause"].as_bool());
        let steps = STEPS();
        for index in 0..steps.len() {
            let step = steps[index];
            let shown = Shown { text: nil };
            if view["stopped"].as_bool() {
                shown.text = view["steps"][index];
            }
            tools.get_node(step).set_visible(view["stopped"].as_bool());
            tools.get_node(step).patch_component("widget", shown);
        }
        tools.get_node("Where").widget.text = view["where"].as_str();
        let patched = tools.get_node("Threw");
        patched.set_visible(view["threw"].as_str() != "");
        patched.widget.text = view["threw"].as_str();
        tools.get_node("BreakOnError").widget_check.checked = view["break_on_error"].as_bool();
        let patched = self.node.get_node("Stack");
        patched.set_visible(view["stopped"].as_bool());
        patched.widget_rows.items = view["frames"];
        patched.widget.text = view["picked"].as_str();
    }
}
