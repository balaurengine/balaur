// The Assets tab's one script: it fills the cards and the strip over them
// from what the Editor, which owns the files, hands it, and answers both.

pub class Assets {
    node: Node,
    query: str,
    renaming: bool,
    editor: Node,
}

pub struct Field {
    visible: any,
    text: any,
}

impl Assets {
    pub fn init() {
        self.query = "";
        self.renaming = false;
        self.editor = scene::get_node("Editor");
        events::listen(self.node, "assets_changed", self.editor);
        events::listen(self.node, "outline_changed", self.editor);
    }

    /// A file was made, moved or reloaded, a card picked or an import moved on.
    pub fn on_assets_changed(_change: any) {
        self.refresh();
    }

    /// The theme moved, which inks the cards.
    pub fn on_outline_changed(_change: any) {
        self.refresh();
    }

    pub fn search_typed(value: any) {
        self.query = value.as_str();
        self.refresh();
    }

    // A second click on the selected card reports the same row, and that is
    // the one that opens it, so the click is heard rather than a change.
    pub fn card_clicked(_value: any, node: Node) {
        self.editor.call("assets_pick", node.widget.text);
    }

    pub fn card_dropped(value: any) {
        self.editor.call("assets_dropped", value);
    }

    pub fn name_submitted(value: any) {
        self.editor.call("assets_verb", "rename_to", value);
    }

    pub fn verb(_value: any, node: Node) {
        self.editor.call("assets_verb", node.name(), "");
    }

    /// Fill what shows from the Editor's answer: on a word that it moved, and
    /// from the dock once it has made this panel visible.
    pub fn refresh() {
        // A hidden browser lists nothing: it is filled again when it shows.
        if self.node.widget.visible == false {
            return;
        }
        let view = self.editor.call("assets_view", self.query);
        if !(view.kind() == "map") {
            return;
        }
        let tools = self.node.get_node("Tools");
        tools.get_node("Up").widget.visible = view["dir"].as_str() != "";
        let patched = tools.get_node("Where");
        patched.widget.visible = !view["renaming"].as_bool();
        patched.widget.text = view["where"].as_str();
        // The field's text only as it opens: a refresh while it is up would take
        // the typing back.
        let field = Field { visible: view["renaming"], text: nil };
        if view["renaming"].as_bool() && !self.renaming {
            field.text = view["name"];
        }
        self.renaming = view["renaming"].as_bool();
        tools.get_node("Name").patch_component("widget", field);
        tools.get_node("Count").widget.text = view["count"].as_str();
        let patched = tools.get_node("Import");
        patched.widget.text = view["import_text"].as_str();
        patched.widget.tooltip = view["import_tip"].as_str();
        patched.widget.checked = view["importing"].as_bool();
        tools.get_node("Folder").widget.text = view["folder_text"].as_str();
        tools.get_node("Local").widget.visible = view["local"].as_bool();
        let patched = tools.get_node("Move");
        patched.widget.visible = view["move_to"].as_str() != "";
        patched.widget.tooltip = "Move the selected item into deps/{view["move_to"].as_str()}";
        tools.get_node("Update").widget.visible = view["update"].as_bool();
        let patched = tools.get_node("Source");
        patched.widget.visible = view["source_tip"].as_str() != "";
        patched.widget.tooltip = view["source_tip"].as_str();
        let patched = tools.get_node("Rename");
        patched.widget.role = if view["chosen"].as_bool() { "action_dock" } else { "action_dock_quiet" };
        patched.widget.tooltip = if view["chosen"].as_bool() { "Rename the selected item" } else { "Select an item first" };
        let patched = tools.get_node("Delete");
        patched.widget.role = if view["chosen"].as_bool() { "action_dock_danger" } else { "action_dock_quiet" };
        patched.widget.tooltip = if view["chosen"].as_bool() { "Delete the selected item" } else { "Select an item first" };
        let patched = self.node.get_node("Cards");
        patched.widget.options = view["items"];
        patched.widget.text = view["picked"].as_str();
    }
}
