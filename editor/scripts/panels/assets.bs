// The Assets tab's one script: it fills the cards and the strip over them
// from what the Editor, which owns the files, hands it, and answers both.

pub class Assets {
    node: Node,
    query: str,
    renaming: bool,
    editor: Node,
}

pub struct Field {
    visible: any,
    text: any,
}

fn VERBS() -> [str] {
    ["Up", "Import", "Folder", "Local", "Move", "Source", "Update", "Rename", "Delete"]
}

impl Assets {
    pub fn init() {
        self.query = "";
        self.renaming = false;
        self.editor = scene::get_node("Editor");
        events::listen(self.node, "assets_changed", self.editor);
        events::listen(self.node, "outline_changed", self.editor);
    }

    /// A file was made, moved or reloaded, a card picked or an import moved on.
    pub fn on_assets_changed(_change: any) {
        self.refresh();
    }

    /// The theme moved, which inks the cards.
    pub fn on_outline_changed(_change: any) {
        self.refresh();
    }

    pub fn on_widget_event(event: str, node: Node, value: any) {
        let name = node.name();
        if name == "Search" && event == "change" {
            self.query = value.as_str();
            self.refresh();
        } else if name == "Cards" && event == "click" {
            // A second click on the selected card reports the same row, and that
            // is the one that opens it, so the click is heard rather than a change.
            self.editor.call("assets_pick", node.widget.text);
        } else if name == "Cards" && event == "drop" {
            self.editor.call("assets_dropped", value);
        } else if name == "Name" && event == "submit" {
            self.editor.call("assets_verb", "rename_to", value);
        } else if event == "click" && is_verb(name, VERBS()) {
            self.editor.call("assets_verb", name, "");
        }
    }

    /// Fill what shows from the Editor's answer: on a word that it moved, and
    /// from the dock once it has made this panel visible.
    pub fn refresh() {
        // A hidden browser lists nothing: it is filled again when it shows.
        if self.node.widget.visible == false {
            return;
        }
        let view = self.editor.call("assets_view", self.query);
        if !(view.kind() == "map") {
            return;
        }
        let tools = self.node.get_node("Tools");
        tools.get_node("Up").widget.visible = view["dir"].as_str() != "";
        tools.get_node("Where").patch_component("widget", { "visible": !view["renaming"].as_bool(), "text": view["where"] });
        // The field's text only as it opens: a refresh while it is up would take
        // the typing back.
        let field = Field { visible: view["renaming"], text: nil };
        if view["renaming"].as_bool() && !self.renaming {
            field.text = view["name"];
        }
        self.renaming = view["renaming"].as_bool();
        tools.get_node("Name").patch_component("widget", field);
        tools.get_node("Count").widget.text = view["count"].as_str();
        tools.get_node("Import").patch_component("widget", {
            "text": view["import_text"],
            "tooltip": view["import_tip"],
            "checked": view["importing"],
        });
        tools.get_node("Folder").widget.text = view["folder_text"].as_str();
        tools.get_node("Local").widget.visible = view["local"].as_bool();
        tools.get_node("Move").patch_component("widget", {
            "visible": view["move_to"].as_str() != "",
            "tooltip": "Move the selected item into deps/{view["move_to"].as_str()}",
        });
        tools.get_node("Update").widget.visible = view["update"].as_bool();
        tools.get_node("Source").patch_component("widget", {
            "visible": view["source_tip"].as_str() != "",
            "tooltip": view["source_tip"],
        });
        tools.get_node("Rename").patch_component("widget", {
            "role": if view["chosen"].as_bool() { "action_dock" } else { "action_dock_quiet" },
            "tooltip": if view["chosen"].as_bool() { "Rename the selected item" } else { "Select an item first" },
        });
        tools.get_node("Delete").patch_component("widget", {
            "role": if view["chosen"].as_bool() { "action_dock_danger" } else { "action_dock_quiet" },
            "tooltip": if view["chosen"].as_bool() { "Delete the selected item" } else { "Select an item first" },
        });
        self.node.get_node("Cards").patch_component("widget", { "options": view["items"], "text": view["picked"] });
    }
}

fn is_verb(name: str, items: [str]) -> bool {
    for verb in items {
        if verb == name {
            return true;
        }
    }
    false
}
