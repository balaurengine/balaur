// The Assets tab's one script: it fills the cards and the strip over them
// from what the Editor, which owns the files, hands it, and answers both.

use editor;

pub class Assets {
    node: Node,
    query: str,
    renaming: bool,
    editor: editor::Editor?,
}

pub struct Field {
    text: any,
}

impl Assets {
    pub fn init() {
        self.query = "";
        self.renaming = false;
        let source = scene::get_node("Editor");
        self.editor = source.script;
        events::listen(self.node, "docks_changed", source);
        events::listen(self.node, "assets_changed", source);
        events::listen(self.node, "outline_changed", source);
    }

    /// A file was made, moved or reloaded, a card picked or an import moved on.
    pub fn on_assets_changed(_change: any) {
        self.refresh();
    }

    /// The theme moved, which inks the cards.
    pub fn on_outline_changed(_change: any) {
        self.refresh();
    }

    pub fn search_typed(value: any) {
        self.query = value.as_str();
        self.refresh();
    }

    // A second click on the selected card reports the same row, and that is
    // the one that opens it, so the click is heard rather than a change.
    pub fn card_clicked(_value: any, node: Node) {
        self.editor.unwrap().assets_pick(node.widget.text);
    }

    pub fn card_dropped(value: any) {
        self.editor.unwrap().assets_dropped(value);
    }

    pub fn name_submitted(value: any) {
        self.editor.unwrap().assets_verb("rename_to", value.as_str());
    }

    pub fn verb(_value: any, node: Node) {
        self.editor.unwrap().assets_verb(node.name(), "");
    }

    /// The dock showed or hid this panel: shown, it fills.
    pub fn on_docks_changed(_change: any) {
        if self.node.visible() {
            self.refresh();
        }
    }

    /// Fill what shows from the Editor's answer: on a word that it moved, and
    /// from the dock once it has made this panel visible.
    pub fn refresh() {
        // A hidden browser lists nothing: it is filled again when it shows.
        if self.node.visible() == false {
            return;
        }
        let view = self.editor.unwrap().assets_view(self.query);
        let tools = self.node.get_node("Tools");
        tools.get_node("Up").set_visible(view.dir != "");
        let patched = tools.get_node("Where");
        patched.set_visible(!view.renaming);
        patched.widget.text = view.where;
        // The field's text only as it opens: a refresh while it is up would take
        // the typing back.
        let field = Field { text: nil };
        if view.renaming && !self.renaming {
            field.text = view.name;
        }
        self.renaming = view.renaming;
        tools.get_node("Name").set_visible(view.renaming);
        tools.get_node("Name").patch_component("widget", field);
        tools.get_node("Count").widget.text = view.count;
        let patched = tools.get_node("Import");
        patched.widget.text = view.import_text;
        patched.widget.tooltip = view.import_tip;
        patched.widget_check.checked = view.importing;
        tools.get_node("Folder").widget.text = view.folder_text;
        tools.get_node("Local").set_visible(view.local);
        let patched = tools.get_node("Move");
        patched.set_visible(view.move_to != "");
        patched.widget.tooltip = "Move the selected item into deps/{view.move_to}";
        tools.get_node("Update").set_visible(view.update);
        let patched = tools.get_node("Source");
        patched.set_visible(view.source_tip != "");
        patched.widget.tooltip = view.source_tip;
        let patched = tools.get_node("Rename");
        patched.widget.role = if view.chosen { "action_dock" } else { "action_dock_quiet" };
        patched.widget.tooltip = if view.chosen { "Rename the selected item" } else { "Select an item first" };
        let patched = tools.get_node("Delete");
        patched.widget.role = if view.chosen { "action_dock_danger" } else { "action_dock_quiet" };
        patched.widget.tooltip = if view.chosen { "Delete the selected item" } else { "Select an item first" };
        let patched = self.node.get_node("Cards");
        patched.widget_rows.items = view.items;
        patched.widget.text = view.picked;
    }
}
