// The completion list's one script: up under the caret while the Editor has
// something to offer, its keys move the pick, accept it or close the list,
// and a row clicked is accepted.

pub class Complete {
    node: Node,
    editor: Node,
}

fn KEYS() -> [str] {
    ["Up", "Down", "Accept", "Tab", "Close"]
}

impl Complete {
    pub fn init() {
        self.editor = scene::get_node("Editor");
        events::listen(self.node, "complete_changed", self.editor);
    }

    pub fn on_complete_changed(_change: any) {
        self.refresh();
    }

    pub fn on_widget_event(event: str, node: Node, value: any) {
        if event != "click" {
            return;
        }
        let name = node.name();
        if is_key(name, KEYS()) {
            self.editor.call("complete_key", name);
        } else if name == "List" {
            self.editor.call("complete_pick", node.widget.text);
        }
    }

    fn refresh() {
        let view = self.editor.call("complete_view");
        if !(view.kind() == "map") {
            return;
        }
        self.node.patch_component("widget", { "visible": view["open"], "x": view["x"], "y": view["y"] });
        if !view["open"].as_bool() {
            return;
        }
        self.node.get_node("List").patch_component("widget", {
            "options": view["items"],
            "text": view["picked"],
            "height": view["list_h"],
        });
        self.node.get_node("Doc").patch_component("widget", { "visible": view["doc"].as_str() != "", "text": view["doc"] });
    }
}

fn is_key(name: str, items: [str]) -> bool {
    for key in items {
        if key == name {
            return true;
        }
    }
    false
}
