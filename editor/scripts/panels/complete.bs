// The completion list's one script: up under the caret while the Editor has
// something to offer, its keys move the pick, accept it or close the list,
// and a row clicked is accepted.

pub class Complete {
    node: Node,
    editor: Node,
}

fn KEYS() -> [str] {
    ["Up", "Down", "Accept", "Tab", "Close"]
}

impl Complete {
    pub fn init() {
        self.editor = scene::get_node("Editor");
        events::listen(self.node, "complete_changed", self.editor);
    }

    pub fn on_complete_changed(_change: any) {
        self.refresh();
    }

    pub fn on_widget_event(event: str, node: Node, value: any) {
        if event != "click" {
            return;
        }
        let name = node.name();
        if is_key(name, KEYS()) {
            self.editor.call("complete_key", name);
        } else if name == "List" {
            self.editor.call("complete_pick", node.get_component("widget", "text"));
        }
    }

    fn refresh() {
        let view = self.editor.call("complete_view");
        if !(view.kind() == "map") {
            return;
        }
        self.node.patch_component("widget", map().with("visible", view.get("open")).with("x", view.get("x")).with("y", view.get("y")));
        if !view.get("open").as_bool() {
            return;
        }
        self.node.get_node("List").patch_component("widget", map()
            .with("options", view.get("items"))
            .with("text", view.get("picked"))
            .with("height", view.get("list_h")));
        self.node.get_node("Doc").patch_component("widget", map().with("visible", view.get("doc").as_str() != "").with("text", view.get("doc")));
    }
}

fn is_key(name: str, items: [str]) -> bool {
    for key in items {
        if key == name {
            return true;
        }
    }
    false
}
