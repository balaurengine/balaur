// The completion list's one script: up under the caret while the Editor has
// something to offer, its keys move the pick, accept it or close the list,
// and a row clicked is accepted.

pub class Complete {
    node: Node,
    editor: Node,
}

impl Complete {
    pub fn init() {
        self.editor = scene::get_node("Editor");
        events::listen(self.node, "complete_changed", self.editor);
    }

    pub fn on_complete_changed(_change: any) {
        self.refresh();
    }

    pub fn key(_value: any, node: Node) {
        self.editor.call("complete_key", node.name());
    }

    pub fn list_clicked(_value: any, node: Node) {
        self.editor.call("complete_pick", node.widget.text);
    }

    fn refresh() {
        let view = self.editor.call("complete_view");
        if !(view.kind() == "map") {
            return;
        }
        self.node.set_visible(view["open"].as_bool());
        self.node.widget.x = view["x"].as_float();
        self.node.widget.y = view["y"].as_float();
        if !view["open"].as_bool() {
            return;
        }
        let patched = self.node.get_node("List");
        patched.widget_rows.items = view["items"];
        patched.widget.text = view["picked"].as_str();
        patched.widget.height = view["list_h"].as_float();
        let patched = self.node.get_node("Doc");
        patched.set_visible(view["doc"].as_str() != "");
        patched.widget.text = view["doc"].as_str();
    }
}
