// The code sheet's one script: it shows the file the Editor says is open,
// hands it what is typed, where the caret went and which gutter line was
// clicked, and writes the text again only when the buffer changed under it.

use editor;
use signals;
use words::components;
use words::dock_fields;

pub class Code {
    node: Node,
    editor: editor::Editor?,
    path: str,
    rev: int,
}

impl Code {
    pub fn init() {
        let source = scene::get_node("Editor");
        self.editor = source.script;
        self.path = "";
        self.rev = -1;
        for word in [
            signals::CODE_CHANGED,
            signals::OUTLINE,
            signals::INSPECTOR,
            signals::CHROME,
            signals::STAGE,
            signals::PROBLEMS_CHANGED,
            signals::DEBUGGER_CHANGED,
        ] {
            events::listen(self.node, word, source);
        }
    }

    pub fn on_code_changed(_change: any) {
        self.refresh();
    }

    pub fn on_outline_changed(_change: any) {
        self.refresh();
    }

    pub fn on_inspector_changed(_change: any) {
        self.refresh();
    }

    pub fn on_chrome_changed(_change: any) {
        self.refresh();
    }

    pub fn on_stage_changed(_change: any) {
        self.refresh();
    }

    pub fn on_problems_changed(_change: any) {
        self.refresh();
    }

    pub fn on_debugger_changed(_change: any) {
        self.refresh();
    }

    pub fn typed(value: any) {
        self.editor.unwrap().code_typed(value.as_str());
    }

    pub fn caret(value: any) {
        self.editor.unwrap().code_caret(value);
    }

    pub fn gutter(value: any) {
        self.editor.unwrap().code_gutter(value.as_int());
    }

    fn refresh() {
        let view = self.editor.unwrap().code_view();
        self.node.set_visible(view.shown);
        self.node.patch_component(components::WIDGET, { dock_fields::INSET: view.inset });
        if !view.shown {
            return;
        }
        let patched = self.node.get_node("Note");
        patched.set_visible(view.note != "");
        patched.widget.text = view.note;
        let scroll = self.node.get_node("Scroll");
        scroll.set_visible(view.note == "");
        if view.note != "" {
            return;
        }
        let editor = scroll.get_node("Editor");
        // The text only when the buffer moved under the editor: what is typed is
        // the widget's own, and writing it back would put the caret at the end.
        if view.path != self.path || view.rev != self.rev {
            editor.widget.text = view.text.as_str();
            self.path = view.path;
            self.rev = view.rev;
        }
        editor.patch_component("widget_code", view.look);
        if view.scroll_to >= 0.0 {
            scroll.widget_scroll.scroll_offset = vec2(0.0, view.scroll_to);
        }
    }
}
