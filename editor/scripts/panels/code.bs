// The code sheet's one script: it shows the file the Editor says is open,
// hands it what is typed, where the caret went and which gutter line was
// clicked, and writes the text again only when the buffer changed under it.

pub class Code {
    node: Node,
    editor: Node,
    path: str,
    rev: int,
}

impl Code {
    pub fn init() {
        self.editor = scene::get_node("Editor");
        self.path = "";
        self.rev = -1;
        for word in [
            "code_changed",
            "outline_changed",
            "inspector_changed",
            "chrome_changed",
            "stage_changed",
            "problems_changed",
            "debugger_changed",
        ] {
            events::listen(self.node, word, self.editor);
        }
    }

    pub fn on_code_changed(_change: any) {
        self.refresh();
    }

    pub fn on_outline_changed(_change: any) {
        self.refresh();
    }

    pub fn on_inspector_changed(_change: any) {
        self.refresh();
    }

    pub fn on_chrome_changed(_change: any) {
        self.refresh();
    }

    pub fn on_stage_changed(_change: any) {
        self.refresh();
    }

    pub fn on_problems_changed(_change: any) {
        self.refresh();
    }

    pub fn on_debugger_changed(_change: any) {
        self.refresh();
    }

    pub fn on_widget_event(event: str, node: Node, value: any) {
        if node.name() != "Editor" {
            return;
        }
        if event == "change" {
            self.editor.call("code_typed", value);
        } else if event == "caret" {
            self.editor.call("code_caret", value);
        } else if event == "gutter" {
            self.editor.call("code_gutter", value);
        }
    }

    fn refresh() {
        let view = self.editor.call("code_view");
        if !(view.kind() == "map") {
            return;
        }
        self.node.patch_component("widget", { "visible": view["shown"], "inset": view["inset"] });
        if !view["shown"].as_bool() {
            return;
        }
        self.node.get_node("Note").patch_component("widget", { "visible": view["note"].as_str() != "", "text": view["note"] });
        let scroll = self.node.get_node("Scroll");
        scroll.patch_component("widget", { "visible": view["note"].as_str() == "" });
        if view["note"].as_str() != "" {
            return;
        }
        let editor = scroll.get_node("Editor");
        // The text only when the buffer moved under the editor: what is typed is
        // the widget's own, and writing it back would put the caret at the end.
        if view["path"].as_str() != self.path || view["rev"].as_int() != self.rev {
            editor.patch_component("widget", { "text": view["text"] });
            self.path = view["path"].as_str();
            self.rev = view["rev"].as_int();
        }
        editor.patch_component("widget_code", view["look"]);
        if view["scroll_to"].as_float() >= 0.0 {
            scroll.patch_component("widget_scroll", { "scroll_offset": [0.0, view["scroll_to"]] });
        }
    }
}
