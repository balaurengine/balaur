// The plugin dialogs' one script: the Editor fills them when a plugin says
// what they show moved, the document moved, or the stage they sit on did.

pub fn init(this) {
    this.editor = scene::get_node("Editor");
    for word in ["plugins_changed", "outline_changed", "stage_changed"] {
        events::listen(this.node, word, this.editor);
    }
}

pub fn on_plugins_changed(this, _change) {
    this.editor.call("dialogs_fill");
}

pub fn on_outline_changed(this, _change) {
    this.editor.call("dialogs_fill");
}

pub fn on_stage_changed(this, _change) {
    this.editor.call("dialogs_fill");
}

/// A control has run its own handler by now, so what is left is to show
/// what it changed.
pub fn on_widget_event(this, event, node, value) {
    if event == "click" || event == "change" || event == "submit" {
        this.editor.call("dialogs_fill");
    }
}
