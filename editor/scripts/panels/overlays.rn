// The viewport lines' one script: the Editor draws them again and keeps them
// when the document, the selection, the tool, play, the camera or a file moved.

pub fn init(this) {
    this.editor = scene::get_node("Editor");
    for word in [
        "outline_changed", "inspector_changed", "stage_changed", "play_frame", "timeline_changed",
        "recordings_changed", "plugins_changed", "chrome_changed",
    ] {
        events::listen(this.node, word, this.editor);
    }
    events::listen(this.node, "camera_moved");
    events::listen(this.node, "assets_reloaded");
}

pub fn on_outline_changed(this, _change) {
    this.editor.call("overlays_fill");
}

pub fn on_inspector_changed(this, _change) {
    this.editor.call("overlays_fill");
}

pub fn on_stage_changed(this, _change) {
    this.editor.call("overlays_fill");
}

pub fn on_play_frame(this, _change) {
    this.editor.call("overlays_fill");
}

pub fn on_timeline_changed(this, _change) {
    this.editor.call("overlays_fill");
}

pub fn on_recordings_changed(this, _change) {
    this.editor.call("overlays_fill");
}

pub fn on_plugins_changed(this, _change) {
    this.editor.call("overlays_fill");
}

pub fn on_chrome_changed(this, _change) {
    this.editor.call("overlays_fill");
}

pub fn on_camera_moved(this, _nothing) {
    this.editor.call("overlays_fill");
}

pub fn on_assets_reloaded(this, _generation) {
    this.editor.call("overlays_fill");
}
