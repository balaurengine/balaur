// Persona bar (56 px) and status bar (28 px).

use crate::defs;
use crate::model;
use crate::shell;
use crate::style;
use crate::theme;

fn plural(n, word) {
    if n == 1 { word } else { word + "s" }
}

pub fn persona_bar(S) {
    let k = S.theme;
    ui::top_panel("persona", #{ height: 56, fill: k.panel, padding_x: 12 }, || {
        ui::horizontal(#{ height: 56 }, || {
            // Brand: the balaur mark + wordmark.
            ui::image("assets/balaur-logo.png", #{ height: 24, radius: 12, bg: "#ffffff", padding: 3 });
            ui::add_space(5);
            ui::label("balaur", #{ size: 17, font: "heading", strong: true, color: k.text });
            ui::add_space(12);

            // Persona group: sunken pill container.
            ui::frame(#{ fill: k.sunken, stroke: k.line_soft, radius: 19, padding_x: 3, padding_y: 3 }, || {
                ui::horizontal(#{ height: 32, tight: true }, || {
                    ui::spacing(2, 0);
                    for p in defs::personas() {
                        let active = S.persona == p.id;
                        let label = if S.compact { "" } else { p.name };
                        if ui::pill(label, #{
                            height: 32, size: 13, font: "heading",
                            icon: p.icon, tooltip: p.name,
                            fill: if active { k.accent_fill } else { "#00000000" },
                            color: if active { k.on_accent } else { k.dim },
                        }) {
                            shell::set_persona(S, p.id);
                        }
                    }
                });
            });

            ui::right(|| {
                // Theme button.
                if ui::circle_button(if k.dark { "☾" } else { "☀" }, #{
                    d: 32, size: 15, fill: k.sunken, stroke: k.line_soft,
                    color: k.dim, tooltip: "Toggle theme",
                }) {
                    theme::set_dark(S, !k.dark);
                }
                ui::add_space(8);
                // Command pill.
                if ui::pill(if S.compact { "" } else { "Run a command" }, #{
                    height: 32, size: 12, icon: "⌕", fill: k.sunken,
                    stroke: k.line_soft, color: k.faint, tooltip: "⌘K",
                }) {
                    shell::open_palette(S, "");
                }
                ui::add_space(12);
                // Transport: stop, pause, play (declared right to left).
                ui::frame(#{ fill: k.sunken, stroke: k.line_soft, radius: 19, padding_x: 3, padding_y: 3 }, || {
                    ui::horizontal(#{ height: 32, width: 106 }, || {
                        ui::spacing(2, 0);
                        if ui::circle_button("▶", #{
                            d: 32, size: 14,
                            fill: if S.playing { k.accent_fill } else { "#00000000" },
                            color: if S.playing { k.on_accent } else { k.dim },
                            tooltip: "Run scene",
                        }) {
                            shell::toggle_play(S);
                        }
                        let paused = S.playing && physics::is_paused();
                        if ui::circle_button("⏸", #{
                            d: 32, size: 14,
                            fill: if paused { k.accent_fill } else { "#00000000" },
                            color: if paused { k.on_accent } else { k.dim },
                            tooltip: "Pause simulation",
                        }) {
                            physics::set_paused(!physics::is_paused());
                        }
                        if ui::circle_button("■", #{ d: 32, size: 12, color: k.dim, tooltip: "Stop" }) {
                            shell::stop_play(S);
                        }
                    });
                });
            });
        });
    });
}

pub fn status_bar(S) {
    let k = S.theme;
    ui::bottom_panel("status", #{ height: 28, fill: k.panel, padding_x: 12 }, || {
        ui::horizontal(#{ height: 28 }, || {
            ui::spacing(16, 0);
            let stopped = S.paused is Object;
            ui::dot(if stopped { k.accent } else if S.playing { k.sage } else { k.faint }, 6);
            // Measured, not asserted: the bar used to claim 60 fps whatever
            // the frame actually cost.
            let mode = if stopped {
                format!("paused · {}:{}", S.paused_rel, S.paused.line)
            } else if S.playing {
                format!("playing · {} fps", S.fps as i64)
            } else {
                "editing"
            };
            ui::label(mode, style::mono_sm(k.dim));
            let (nodes, scripts) = model::stats(S);
            ui::label(format!("{} {} · {} {}", nodes, plural(nodes, "node"), scripts, plural(scripts, "script")),
                style::mono_sm(k.dim));
            ui::dot(k.sage, 6);
            ui::label("Rune VM warm", style::mono_sm(k.dim));
            ui::label("kiss3d · wgpu", style::mono_sm(k.dim));
            ui::right(|| {
                let pname = defs::persona_name(S.persona);
                ui::label(format!("{} persona · {}", pname, defs::tool_name(S.tool)), style::mono_sm(k.dim));
            });
        });
    });
}
