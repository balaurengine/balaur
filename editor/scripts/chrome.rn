// The persona bar, and the status strip the bottom dock carries.

// Brand and transport get the same width so the personas land centred.
const SIDE_W = 104.0;
const PAD_X = 10.0;

use crate::defs;
use crate::icons;
use crate::model;
use crate::shell;
use crate::style;
use crate::theme;

// The edited project's mark, when it ships one, else balaur's. A project
// that brought its own logo gets its own name beside it too.
fn brand_logo(S) {
    for rel in ["icon.png", "assets/icon.png", "assets/logo.png"] {
        if fs::exists(S.game_root + "/" + rel) {
            return S.game_root + "/" + rel;
        }
    }
    ""
}

fn brand(S) {
    let logo = brand_logo(S);
    // `return`: a bare tuple after an `if` block parses as a call on the
    // block's value.
    if logo == "" {
        return ("assets/balaur-logo.png", "balaur");
    }
    return (logo, S.game_name);
}

fn plural(n, word) {
    if n == 1 { word } else { word + "s" }
}

pub fn persona_bar(S) {
    let k = S.theme;
    style::bar(k, "persona", S.layout.bar, PAD_X, || {
        ui::horizontal(#{ height: 36 }, || {
            ui::add_space(2);
            let (logo, name) = brand(S);
            ui::image(logo, #{ height: 26, radius: 13, bg: "#ffffff", padding: 3 });
            if !S.compact {
                ui::add_space(7);
                ui::label(name, #{ size: 16, font: "heading", color: k.text });
            }
            ui::add_space(12);
            for p in defs::personas() {
                let active = S.persona == p.id;
                let label = if S.compact { "" } else { p.name };
                if ui::pill(label, #{
                    role: if active { "navtab_on" } else { "navtab" },
                    icon: p.icon, tooltip: p.name,
                }) {
                    shell::set_persona(S, p.id);
                }
            }
            // What the row actually used, so the next frame's rect is its
            // content and the personas land centred.
            let used = (S.layout.bar.w - 2.0 * PAD_X) - ui::available_width();
            S.layout.bar_fit = used + SIDE_W + 2.0 * PAD_X;
            ui::right(|| {
                ui::horizontal(#{ height: 36, width: SIDE_W }, || {
                    ui::right(|| transport(S, k));
                });
            });
        });
    });
}

// Play, pause and stop. A loaded session pauses through the player: pausing
// physics alone would let the scripts run on and the replay would stop
// reproducing the recording.
fn transport(S, k) {
    // No frame: a panel inside a panel reads as two things when it is one.
    {
        ui::horizontal(#{ height: 30, width: 96, tight: true }, || {
            ui::spacing(4, 0);
            if ui::circle_button(icons::ui("play"), #{
                role: if S.playing { "transport_on" } else { "transport" },
                tooltip: "Run scene",
            }) {
                shell::toggle_play(S);
            }
            let replaying = crate::session::loaded(S);
            let paused = if replaying {
                replay::state() == replay::STATE_PAUSED
            } else {
                S.playing && (physics::is_paused())
            };
            if ui::circle_button(icons::ui("pause"), #{
                role: if paused { "transport_on" } else { "transport" },
                tooltip: if replaying { "Pause playback" } else { "Pause simulation" },
            }) {
                if replaying {
                    crate::session::toggle_pause(S);
                } else {
                    physics::set_paused(!physics::is_paused());
                }
            }
            if ui::circle_button(icons::ui("stop"), #{ role: "transport", tooltip: "Stop" }) {
                if replaying {
                    crate::session::close(S);
                } else {
                    shell::stop_play(S);
                }
            }
        });
    }
}

// The command pill and the theme switch, opposite the persona bar.
pub fn command_bar(S) {
    let k = S.theme;
    let r = S.layout.cmd;
    ui::overlay("cmd", #{ x: r.x, y: r.y, w: r.w, h: r.h }, || {
        ui::horizontal(#{ height: 30 }, || {
            if ui::pill(if S.compact { "" } else { "Run a command" }, #{
                height: 30, size: 12, radius: 8, icon: icons::ui("search"),
                fill: k.panel, color: k.faint, tooltip: "⌘K",
            }) {
                shell::open_palette(S, "");
            }
            ui::right(|| {
                if ui::pill(if k.dark { icons::ui("dark") } else { icons::ui("light") }, #{
                    height: 30, min_width: 30, size: 15, radius: 8,
                    fill: k.panel, color: k.dim, tooltip: "Toggle theme",
                }) {
                    theme::set_dark(S, !k.dark);
                }
            });
        });
    });
}

/// The status strip, drawn inside the bottom dock's foot.
pub fn status_row(S) {
    let k = S.theme;
    let r = S.layout.status;
    if r.w <= 0.0 {
        return;
    }
    ui::overlay("status", #{ x: r.x, y: r.y, w: r.w, h: r.h, padding_x: 10 }, || {
    ui::horizontal(#{ height: 22 }, || {
        ui::spacing(14, 0);
        ui::add_space(4);
        let stopped = S.debug.paused is Object;
        ui::dot(if stopped { k.accent } else if S.playing { k.sage } else { k.faint }, 5);
        let mode = if stopped {
            format!("paused · {}:{}", S.debug.paused_rel, S.debug.paused.line)
        } else if S.playing {
            let recording = if S.session.recording != "" { "recording · " } else { "" };
            format!("playing · {}{} fps", recording, S.fps as i64)
        } else {
            "editing"
        };
        ui::label(mode, style::mono_sm(k.dim));
        // Narrow: the columns go one at a time rather than running together.
        let room = r.w;
        if room > 300.0 {
            let (nodes, scripts) = model::stats(S);
            ui::label(format!("{} {} · {} {}", nodes, plural(nodes, "node"), scripts, plural(scripts, "script")),
                style::mono_sm(k.faint));
        }
        if room > 560.0 {
            ui::label("kiss3d · wgpu", style::mono_sm(k.faint));
        }
        if room > 420.0 {
            ui::right(|| {
                ui::add_space(4);
                let pname = defs::persona_name(S.persona);
                ui::label(format!("{} · {}", pname, defs::tool_name(S.tool)), style::mono_sm(k.faint));
            });
        }
    });
    });
}
