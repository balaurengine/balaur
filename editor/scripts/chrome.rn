// The one bar across the top — brand, personas, the open documents, and the
// transport, command and theme controls — and the status strip the bottom
// dock carries at its foot, which is all of it once minimised.

use crate::defs;
use crate::history;
use crate::icons;
use crate::model;
use crate::shell;
use crate::theme;
use crate::util;

// What the head sheet keeps inside its edge, plus the row's own first step.
const PAD_X = 7.0;
// The brand mark, and the name beside it when there is room.
const MARK_W = 24.0;
const NAME_W = 52.0;
// The transport's three buttons: 26 px each on 3 px spacing, in an 87 px block.
const BUTTON_PITCH = 29.0;
const BLOCK_W = 87.0;
// The theme switch and the command pill at the bar's right end.
const THEME_W = 26.0;
const CMD_W = 118.0;
const CMD_W_COMPACT = 26.0;
// One document tab, as the showcase's pointer estimates it.
const TAB_W = 104.0;
// The bar's own row, a step shorter in a small window.
fn row_h(S) {
    if S.compact { 26.0 } else { 30.0 }
}

// The edited project's mark, when it ships one, else balaur's. A project
// that brought its own logo gets its own name beside it too.
fn brand_logo(S) {
    for rel in ["icon.png", "assets/icon.png", "assets/logo.png"] {
        if fs::exists(S.game_root + "/" + rel) {
            return S.game_root + "/" + rel;
        }
    }
    ""
}

// Answered once per session: whether the project ships a mark is three disk
// reads, and the bar asked for them on every frame it drew.
fn brand(S) {
    let found = S.brand;
    if !(found is Object) {
        let logo = brand_logo(S);
        found = if logo == "" {
            #{ logo: "assets/balaur-logo.png", name: "Balaur" }
        } else {
            #{ logo: logo, name: S.game_name }
        };
        S.brand = found;
    }
    found
}

fn plural(n, word) {
    if n == 1 { word } else { word + "s" }
}

// Where the first persona pill starts, after the brand.
fn personas_x(S) {
    let name = if S.compact { 0.0 } else { 3.0 + NAME_W };
    S.layout.bar.x + PAD_X + 2.0 + MARK_W + name + 8.0
}

/// Where one persona pill's centre lands in the bar, in design px, so the
/// showcase's drawn cursor can be put on the pill its verb presses.
pub fn persona_spot(S, id) {
    let bar = S.layout.bar;
    let per = crate::layout::persona_w(S);
    let slot = 0;
    for (i, p) in defs::personas().iter().enumerate() {
        if p.id == id {
            slot = i;
        }
    }
    let found = strip_spot(S, slot);
    if let Some(spot) = found {
        return spot;
    }
    // `return`: a bare tuple after a block parses as a call on the block.
    return (personas_x(S) + ((slot as f64) + 0.5) * per, bar.y + bar.h / 2.0);
}

/// Where a document tab's centre lands: the scene's, then the script's.
pub fn doc_spot(S, id) {
    let bar = S.layout.bar;
    let per = crate::layout::persona_w(S);
    let first = personas_x(S) + (defs::personas().len() as f64) * per + 12.0;
    let slot = if id == "script" { 1.0 } else { 0.0 };
    let found = strip_spot(S, defs::personas().len() + (slot as i64));
    if let Some(spot) = found {
        return spot;
    }
    return (first + slot * (TAB_W + 4.0) + TAB_W / 2.0, bar.y + bar.h / 2.0);
}

/// Where one of the transport's three buttons sits: play, pause, stop.
pub fn transport_spot(S, n) {
    let bar = S.layout.bar;
    let found = strip_spot(S, transport_slot(S) + n);
    if let Some(spot) = found {
        return spot;
    }
    let cmd = if S.compact { CMD_W_COMPACT } else { CMD_W };
    let block = bar.x + bar.w - PAD_X - THEME_W - 4.0 - cmd - 6.0 - BLOCK_W;
    return (block + 14.0 + (n as f64) * BUTTON_PITCH, bar.y + bar.h / 2.0);
}

// The transport comes after the personas, the open documents, the split, the
// focus and the spring that pushes the right end over.
fn transport_slot(S) {
    defs::personas().len() + doc_controls(S, S.theme, row_h(S) - 4.0).len() + 3
}

/// The centre of the strip's `slot`-th control, in design px, from the node it
/// was drawn on; `None` until it has drawn, when a caller estimates instead.
fn strip_spot(S, slot) {
    let strip = scene::get_node(STRIP_NODE);
    if util::is_nil(strip) {
        return None;
    }
    let kids = strip.children();
    if slot < 0 || slot >= kids.len() {
        return None;
    }
    let box = ui::widget_rect(kids[slot]);
    if util::is_nil(box) {
        return None;
    }
    Some((box.x + box.w / 2.0, box.y + box.h / 2.0))
}

// The strip beside the brand, which every control past it lives on.
const STRIP_NODE = "Editor/Shell/Head/HeadRow/HeadStrip";
const BRAND_NODE = "Editor/Shell/Head/HeadRow/Brand";
const STATUS_NODE = "Editor/Shell/Body/Centre/Bottom/Status";

/// The brand: the project's mark and name on the menu node the scene lays
/// out, and the menu's rows under it. Filled once a pass, like the strip.
pub fn top_bar(S) {
    let k = S.theme;
    let mark = brand(S);
    let node = scene::get_node(BRAND_NODE);
    if !util::is_nil(node) {
        node.patch_component("widget", #{
            source: mark.logo, text: mark.name, trailing: icons::ui("caret-down"),
            height: row_h(S) - 4.0, showing: S.menu_open,
        });
    }
    crate::pool::strip(S, BRAND_NODE, crate::menu::rows(S));
    crate::pool::strip(S, STRIP_NODE, bar_controls(S, k));
}

// Everything on the bar past the brand, in the order it reads: the personas,
// the open documents, then the split, and the right end after a spring.
fn bar_controls(S, k) {
    let h = row_h(S) - 4.0;
    let out = [];
    for p in defs::personas() {
        let id = p.id;
        out.push(#{
            kind: "button", height: h,
            role: if S.persona == id { "navtab_on" } else { "navtab" },
            text: if S.compact { "" } else { p.name },
            icon: p.icon, tooltip: p.name,
            on: |_| { shell::set_persona(S, id); },
        });
    }
    for entry in doc_controls(S, k, h) {
        out.push(entry);
    }
    out.push(#{
        kind: "button", height: h, icon: icons::ui("split"),
        role: if S.split { "navtab_on" } else { "navtab" },
        text: if S.compact { "" } else { "Split" },
        tooltip: "Show the code and the viewport at once (⌘\\)",
        on: |_| { shell::toggle_split(S); },
    });
    // Beside the split, because the two are the same question: how much of the
    // window the code is worth.
    let can_focus = S.focus || shell::focus_target(S);
    out.push(#{
        kind: "button", height: h,
        icon: icons::ui(if S.focus { "unfocus" } else { "focus" }),
        role: if S.focus { "navtab_on" } else { "navtab" },
        text: if S.compact { "" } else { "Focus" },
        disabled: !can_focus,
        tooltip: if S.focus {
            "Put the docks back (⇧⌘\\)"
        } else if can_focus {
            "Give the code the whole window (⇧⌘\\)"
        } else {
            "The selection has no script to focus"
        },
        on: |_| { shell::toggle_focus(S); },
    });
    // The spring: what is after it sits against the bar's right edge.
    out.push(#{ kind: "row", grow: 1 });
    for entry in transport_controls(S) {
        out.push(entry);
    }
    out.push(#{
        kind: "button", height: row_h(S), width: THEME_W, role: "bar",
        text: "", icon: if k.dark { icons::ui("dark") } else { icons::ui("light") },
        tooltip: "Toggle theme",
        on: |_| { theme::set_dark(S, !k.dark); },
    });
    out.push(#{
        kind: "button", height: row_h(S), role: "bar",
        text: if S.compact { "" } else { "Run a command" }, icon: icons::ui("search"),
        tooltip: "⌘K",
        on: |_| { shell::open_palette(S, ""); },
    });
    out
}

// The open documents: the scene, always; the selection's script and the event
// bindings while they are open. Only the last two close.
fn doc_controls(S, k, h) {
    let node = model::selected_node(S);
    let out = [];
    let scene = util::last_segment(S.scene_rel) + (if history::dirty(S) { " ●" } else { "" });
    for entry in doc_tab(S, "scene", icons::panel("scene"), scene, false, h) {
        out.push(entry);
    }
    if S.script_open {
        let label = match model::script_rel(node) {
            Some(script) => {
                let dirty = S.script_dirty.contains_key(S.game_root + "/" + script);
                util::last_segment(script) + (if dirty { " ●" } else { "" })
            }
            None => "no script",
        };
        for entry in doc_tab(S, "script", icons::ui("scriptfile"), label, true, h) {
            out.push(entry);
        }
    }
    if S.events_open {
        for entry in doc_tab(S, "events", icons::ui("events"), "events", true, h) {
            out.push(entry);
        }
    }
    out
}

// One tab: the label, and the close mark beside it when it closes.
fn doc_tab(S, id, icon, label, closable, h) {
    let active = S.doctab == id;
    let role = if active { "navtab_on" } else { "navtab" };
    // Built by pushing: a `[` after an `if` block is read as indexing it.
    let inner = [];
    inner.push(#{
        kind: "button", height: h, text: label, icon: icon, role: role,
        radius: 0, fill: "none", padding_x: 7,
        on: |_| { shell::open_doc(S, id); },
    });
    if closable {
        inner.push(#{
            kind: "button", height: h, width: 13, padding_x: 0, text: "",
            icon: icons::ui("close"),
            role: role, radius: 0, fill: "none", tooltip: "Close",
            on: |_| { shell::close_doc(S, id); },
        });
    }
    inner.push(#{ kind: "row", width: 5 });
    // One tile: the row carries the fill and the corners, and the halves
    // inside it paint nothing.
    let out = [];
    out.push(#{
        height: h, radius: 5, controls: inner,
        fill: if active { "accent_soft" } else { "none" },
    });
    out
}

// Play, pause and stop; the last two are off until something runs.
fn transport_controls(S) {
    let replaying = crate::session::loaded(S);
    let running = S.playing || replaying;
    let paused = if replaying {
        replay::state() == replay::STATE_PAUSED
    } else {
        S.playing && (physics::is_paused())
    };
    [
        #{
            kind: "button", text: "", icon: icons::ui("play"), height: row_h(S),
            role: if S.playing { "transport_on" } else { "transport" },
            tooltip: if S.playing { "Stop the scene (F5)" } else { "Run the scene (F5)" },
            on: |_| { shell::toggle_play(S); },
        },
        #{
            kind: "button", text: "", icon: icons::ui("pause"), disabled: !running,
            height: row_h(S),
            role: if paused { "transport_on" } else { "transport" },
            tooltip: if !running {
                "Run the scene first"
            } else if replaying {
                "Pause playback"
            } else {
                "Pause simulation"
            },
            on: |_| {
                if replaying {
                    crate::session::toggle_pause(S);
                } else {
                    physics::set_paused(!physics::is_paused());
                }
            },
        },
        #{
            kind: "button", text: "", icon: icons::ui("stop"), disabled: !running,
            height: row_h(S), role: "transport",
            tooltip: if running { "Stop" } else { "Nothing is running" },
            on: |_| {
                if replaying {
                    crate::session::close(S);
                } else {
                    shell::stop_play(S);
                }
            },
        },
    ]
}

/// The status strip: what the editor is doing, how big the scene is, and the
/// persona and tool in hand. `room` is the width it has; `trailing` draws
/// whatever the dock wants at the far right, which minimised is the handle
/// that reopens it.
/// The status strip's controls. The scene owns the row; this says what goes
/// in it, so the theme dresses the labels rather than the call site.
pub fn status_bar(S, k, room) {
    crate::pool::strip(S, STATUS_NODE, status_controls(S, k, room));
}

fn status_mode(S) {
    if S.debug.paused is Object {
        return format!("paused · {}:{}", S.debug.paused_rel, S.debug.paused.line);
    }
    if S.playing {
        let recording = if S.session.recording != "" { "recording · " } else { "" };
        return format!("playing · {}{} fps", recording, S.fps as i64);
    }
    "editing"
}

fn status_controls(S, k, room) {
    let stopped = S.debug.paused is Object;
    let lamp = if stopped { k.accent } else if S.playing { k.sage } else { k.faint };
    let out = [
        #{ kind: "row", width: 6 },
        #{ kind: "row", width: 5, height: 5, radius: 3, fill: lamp },
        #{ kind: "label", text: status_mode(S), role: "meta",
          text_color: k.dim },
    ];
    // Narrow: the columns go one at a time rather than running together.
    if room > 300.0 {
        let (nodes, scripts) = model::stats(S);
        out.push(#{
            kind: "label", role: "meta", text_color: k.faint,
            text: format!("{} {} · {} {}", nodes, plural(nodes, "node"), scripts,
                plural(scripts, "script")),
        });
    }
    if room > 560.0 {
        out.push(#{ kind: "label", text: "kiss3d · wgpu", role: "meta",
            text_color: k.faint });
    }
    out.push(#{ kind: "row", grow: 1 });
    if room > 420.0 {
        out.push(#{
            kind: "label", role: "meta", text_color: k.faint,
            text: format!("{} · {}", defs::persona_name(S.persona), defs::tool_name(S.tool)),
        });
    }
    out.push(#{ kind: "row", width: 6 });
    out
}
