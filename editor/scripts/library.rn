// The library dock: stock materials, skies, models, lighting setups and
// project templates.
// Placing one copies its files in and then does what dropping them would.

use crate::dock;
use crate::dropin;
use crate::icons;
use crate::model;
use crate::style;
use crate::util;

pub fn state() {
    #{ kind: "material", catalogue: () }
}

/// The kinds the dock filters by, in the order the chips offer them.
pub fn kinds() {
    [
        ["material", "Materials"], ["sky", "Skies"], ["model", "Models"],
        ["scene", "Lighting"], ["rig", "Rigs"], ["addon", "Addons"],
        ["template", "Templates"],
    ]
}

/// The library's own directory, inside the editor project rather than the
/// edited one: `fs` resolves a bare path against the editor.
const ROOT = "library";

/// The manifest, read once per session. A library that fails to parse is
/// reported once and treated as empty.
fn catalogue(S) {
    let held = S.library.catalogue;
    if held is Object {
        return held;
    }
    let text = fs::read(ROOT + "/manifest.toml");
    if !(text is String) {
        log::warn("no library manifest at " + ROOT);
        S.library.catalogue = #{ entries: [], templates: [] };
        return S.library.catalogue;
    }
    let (ok, parsed) = script::attempt(|| toml::parse(text));
    if !ok {
        log::warn("the library manifest does not parse");
        S.library.catalogue = #{ entries: [], templates: [] };
        return S.library.catalogue;
    }
    let table = util::obj(parsed);
    S.library.catalogue = #{
        entries: util::vec(table.get("entries").unwrap_or([])),
        templates: util::vec(table.get("templates").unwrap_or([])),
    };
    S.library.catalogue
}

/// Copy one library file into the edited project, keeping its directory and
/// never writing over a file already there: a project with its own
/// `materials/metal.toml` keeps it, and the library's lands beside it.
/// Answers the project-relative path, or `None` when it could not be read.
fn install(S, rel) {
    let from = ROOT + "/" + rel;
    if !fs::exists(from) {
        log::warn("the library has no " + rel);
        return None;
    }
    // Rune's `String` has no `rsplit_once`; the directory is everything up to
    // the last separator, which one split gives.
    let parts = rel.split('/').collect::<Vec>();
    let dir = if parts.len() > 1 {
        util::join(parts[..parts.len() - 1], "/")
    } else {
        ""
    };
    if dir != "" {
        fs::mkdir(S.game_root + "/" + dir);
    }
    let target = free_name(S, rel);
    fs::copy(from, S.game_root + "/" + target);
    model::forget(S, None);
    Some(target)
}

/// Copy a library directory into the project at the same path. One already
/// there is kept as it is, and said so: the game's copy may carry edits.
fn install_tree(S, rel) {
    let from = ROOT + "/" + rel;
    if !fs::exists(from) {
        log::warn("the library has no " + rel);
        return;
    }
    let to = S.game_root + "/" + rel;
    if fs::exists(to) {
        log::info(rel + " is already in the project");
        return;
    }
    copy_tree(from, to);
    model::forget(S, None);
    log::info("added " + rel);
}

/// Every file under `from`, into `to`, directories included.
fn copy_tree(from, to) {
    fs::mkdir(to);
    for f in util::vec(fs::list(from)) {
        if f.is_dir {
            copy_tree(from + "/" + f.name, to + "/" + f.name);
        } else {
            fs::copy(from + "/" + f.name, to + "/" + f.name);
        }
    }
}

/// `rel`, or `rel` with a number before its extension when the project
/// already has that file.
fn free_name(S, rel) {
    if !fs::exists(S.game_root + "/" + rel) {
        return rel;
    }
    let cut = util::index_of(rel, ".");
    let stem = match cut {
        Some(at) => rel[..at],
        None => rel,
    };
    let extension = if rel.len() > stem.len() { rel[stem.len()..] } else { "" };
    let n = 2;
    while fs::exists(S.game_root + "/" + format!("{}_{}{}", stem, n, extension)) {
        n += 1;
    }
    format!("{}_{}{}", stem, n, extension)
}

/// Put an entry into the project: its own file, then whatever it needs.
pub fn place(S, entry) {
    // An addon is a directory a game requires by path, so it lands at that
    // path or not at all: a numbered copy would answer no `require`.
    if entry.kind == "addon" {
        install_tree(S, entry.file);
        return;
    }
    for needed in util::vec(entry.get("needs").unwrap_or([])) {
        install(S, needed);
    }
    let rel = match install(S, entry.file) {
        Some(rel) => rel,
        None => return,
    };
    // Rune's `match` has no or-patterns, so the two kinds that instance are
    // one condition rather than two arms.
    if entry.kind == "sky" {
        // A sky is already under `skies/`, so only the naming is left.
        dropin::name_sky(S, rel, "library sky");
    } else if entry.kind == "scene" || entry.kind == "model" || entry.kind == "rig" {
        // A lighting setup, a model and a rig are all scenes: instanced where
        // a dropped one would be, with the scripts a rig needs already in.
        dropin::take(S, S.game_root + "/" + rel);
    } else {
        // A material is a file the inspector then points a node at, so the
        // placing is the copy and the log line says where it landed.
        log::info("added " + rel);
    }
}

/// Point the selected node's 3D shape at a library material, which is what a
/// designer means by dropping one onto something.
pub fn apply_material(S, entry) {
    if !crate::model::has_selection(S) {
        return;
    }
    for needed in util::vec(entry.get("needs").unwrap_or([])) {
        install(S, needed);
    }
    let rel = match install(S, entry.file) {
        Some(rel) => rel,
        None => return,
    };
    let node = S.doc[S.sel];
    let key = if node.contains_key("mesh") {
        "mesh"
    } else if node.contains_key("shape3d") {
        "shape3d"
    } else {
        log::info("select a node with a 3D shape to give it " + entry.name);
        return;
    };
    model::set_component_prop(S, key, "material", rel);
    log::info(format!("{} is now {}", node.name, entry.name));
}

/// A mark per kind, so a card says what it places before its name is read.
fn kind_icon(kind) {
    if kind == "material" {
        return icons::workspace("ui");
    }
    if kind == "sky" {
        return icons::ui("viewmode");
    }
    if kind == "rig" {
        return icons::panel("bonemap");
    }
    if kind == "addon" {
        return icons::workspace("script");
    }
    return icons::panel("scene");
}

/// The dock. One chip row, then a grid of cards for the chosen kind.
pub fn panel(S, k) {
    let known = catalogue(S);
    let chips = [];
    for chip in kinds() {
        // Bound afresh: a closure made in a loop captures the binding.
        let id = chip[0];
        chips.push(#{
            kind: "button", text: chip[1],
            role: if S.library.kind == id { "chip_on" } else { "chip" },
            on: |_| { S.library.kind = id; },
        });
    }
    crate::docks::chrome_rows(S, [chips]);
    if S.library.kind == "template" {
        dock::hide_cards();
        templates(S, k, known);
        return;
    }
    dock::hide_table();
    let shown = [];
    for entry in known.entries {
        if util::obj(entry).get("kind").unwrap_or("") == S.library.kind {
            shown.push(util::obj(entry));
        }
    }
    if shown.len() == 0 {
        dock::hide_cards();
        style::empty(k, "nothing of that kind in the library");
        return;
    }
    show_cards(S, k, shown);
}

// The entries as cards on the bottom dock's `list` node: the kind's mark, the
// entry's name, and its note as the hover.
fn show_cards(S, k, shown) {
    let items = [];
    for entry in shown {
        items.push(util::row(kind_icon(entry.kind), entry.name,
            entry.get("note").unwrap_or(""), k.text));
    }
    util::fill(dock::CARDS_NODE, #{
        options: items, visible: true, columns: 5, text: "",
    });
    let picked = util::taken(dock::CARDS_NODE);
    for (n, item) in items.iter().enumerate() {
        if item == picked {
            let held = shown[n];
            if held.kind == "material" {
                apply_material(S, held);
            } else {
                place(S, held);
            }
        }
    }
}

/// The templates a new project starts from, on the dock's `table` node: a
/// name, what it makes, and the command a click copies.
///
/// Listed rather than placed, because a template makes a project and the
/// editor is already in one.
fn templates(S, k, known) {
    if known.templates.len() == 0 {
        dock::hide_table();
        style::empty(k, "no templates in the library");
        return;
    }
    ui::add_space(2);
    ui::horizontal(#{ height: 18 }, || {
        ui::add_space(8);
        ui::label("a row is copied as the command that makes it", style::mono_sm(k.faint));
    });
    let items = [];
    let commands = [];
    for row in known.templates {
        let entry = util::obj(row);
        let command = format!("balaur new my-game --template {}", entry.id);
        items.push(util::cells([entry.name, entry.get("note").unwrap_or(""), command]));
        commands.push(command);
    }
    dock::show_table(
        ["template", "what it makes", "the command it is made with"],
        ["1", "1.6", "2"],
        items,
    );
    let picked = dock::taken_table();
    for (n, item) in items.iter().enumerate() {
        if item == picked {
            ui::set_clipboard(commands[n]);
            log::info("copied: " + commands[n]);
        }
    }
}
