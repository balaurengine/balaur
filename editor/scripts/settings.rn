// The settings screen: every setting the engine, its plugins and this game
// declare, grouped by the first segment of its path and searchable by any.

use crate::style;
use crate::util;

// The search field this screen filters with; `crate::search` keys its own
// buffer by the same id.
const FIELD = "settings";

pub fn state() {
    #{
        // The category showing, "" until the first is picked.
        at: "",
        dirty: false,
        // What `editor/appearance/compact` asks for, which the window width
        // can only add to.
        compact: false,
        // Where `--state settingsdemo` has got to; -1 when it is not running.
        demo: -1,
        // The tag the header offers an override for, "" for none: one choice
        // for the page, as Godot's "Override For", not a picker per row.
        target: "",
    }
}

// The search box's own buffer is the query: typing in it and a deep link
// write the same text. Non-empty means the list is results, not categories.
fn set_query(S, text) {
    S.search[FIELD] = text;
}

pub fn query(S) {
    crate::search::query(S, FIELD)
}

// Open on a search, for a screenshot or a "configure this" link that knows
// the word but not the page.
pub fn open_search(S, query) {
    open(S);
    set_query(S, query);
}

// Open at a named category, for a screenshot or a deep link from a dock.
pub fn open_at(S, category) {
    open(S);
    S.settings.at = category;
}

pub fn open(S) {
    crate::window::show(S, "settings");
    load_files(S);
}

/// Read both settings files and apply what the editor acts on. Called at boot
/// and again when the window opens, so a hand edit between the two is not
/// silently reverted on the next write.
pub fn load_files(S) {
    // With no project open there is no manifest to read: a relative path off
    // an empty root is a path outside every root there is.
    if S.game_root != "" {
        let manifest = fs::read(S.game_root + "/project.toml");
        if manifest is String {
            settings::merge_toml(manifest);
        }
    }
    let prefs = fs::read(prefs_path());
    if prefs is String {
        settings::merge_toml(prefs);
    }
    apply(S);
}

// The editor's own settings are the person's, in the folder every project shares.
pub fn prefs_path() {
    project::editor_data_directory() + "/editor.toml"
}

// Categories in definition order, project first: a game author looks for what
// ships far more often than for what does not.
fn categories() {
    let seen = [];
    for scope in ["project", "editor"] {
        for def in settings::all() {
            if def.scope == scope && !seen.iter().any(|c| c == def.category) {
                seen.push(def.category);
            }
        }
    }
    seen
}

// A category with anything that ships is a project one; its editor-only
// rows follow under their own heading.
fn scope_of(category) {
    let found = #{ any: false };
    for def in settings::all() {
        if def.category == category {
            if def.scope == "project" {
                return "project";
            }
            found.any = true;
        }
    }
    if found.any { "editor" } else { "project" }
}

fn current(S) {
    let all = categories();
    if all.is_empty() {
        return "";
    }
    if all.iter().any(|c| c == S.settings.at) {
        return S.settings.at;
    }
    all[0]
}

// What the list shows: the search results when there is a query, otherwise
// everything in the chosen category.
fn showing(S) {
    let query = query(S).to_lowercase();
    let rows = [];
    for def in settings::all() {
        let matches = if query == "" {
            def.category == current(S)
        } else {
            // The path and the help both, so "packet" finds `multiplayer/loss`
            // by its sentence when its name does not say it.
            def.path.to_lowercase().contains(query)
                || util::obj(def.spec).get("help").unwrap_or("").to_lowercase().contains(query)
        };
        if matches {
            rows.push(def);
        }
    }
    rows.sort_by(|a, b| rank_of(a).partial_cmp(rank_of(b)).unwrap());
    rows
}

// Project rows before editor ones, each in the order it asks for.
fn rank_of(def) {
    let tail = if def.scope == "editor" { 100000.0 } else { 0.0 };
    tail + order_of(def)
}

fn order_of(def) {
    util::f(util::obj(def.spec).get("order").unwrap_or(1000.0))
}

// `editor/appearance/theme` groups under "appearance"; `physics/gravity`
// under nothing, since there is nothing between its category and its key.
fn group_of(def) {
    let parts = def.label.split('/').collect::<Vec>();
    if parts.len() < 2 { "" } else { parts[0] }
}

// The last segment: what a row is labelled inside its group.
fn key_of(def) {
    let parts = def.path.split('/').collect::<Vec>();
    parts[parts.len() - 1]
}

// Write both files. Only the paths a scope defines are touched, so a comment
// or an unrelated table in project.toml survives.
pub fn commit(S) {
    let path = S.game_root + "/project.toml";
    let existing = fs::read(path);
    fs::write(path, settings::to_toml("project", if existing is String { existing } else { "" }));
    commit_prefs(S);
    S.settings.dirty = false;
}

/// The editor's half alone: what a self-test can round-trip without rewriting
/// the game's manifest.
pub fn commit_prefs(S) {
    let prefs = fs::read(prefs_path());
    fs::write(prefs_path(), settings::to_toml("editor", if prefs is String { prefs } else { "" }));
}

// Under this the list of categories goes above the rows rather than beside
// them: two columns of 190 and a row's own controls do not fit a phone.
const STACK_BELOW = 520.0;

// The sidebar's own column, and the air between it and the rows. A row that
// measured the whole sheet wrapped its help under the sidebar and ran past
// the sheet's edge.
const SIDEBAR_W = 190.0;
const SIDEBAR_GAP = 20.0;

/// What a settings row has across it: the sheet, less the sidebar where one
/// is beside it.
fn row_w(S) {
    let inner = crate::window::inner_w(S);
    if ui::window_size()[0] < STACK_BELOW {
        return inner;
    }
    util::max(inner - SIDEBAR_W - SIDEBAR_GAP, 160.0)
}

pub fn draw(S) {
    let k = S.theme;
    let stacked = ui::window_size()[0] < STACK_BELOW;
    let hosts = crate::window::sheet_form(S, "settings", "Settings", || { save_button(S, k); });
    if util::is_nil(hosts) {
        return;
    }
    // Narrow, the categories go above the rows rather than beside them: a
    // sidebar and a column of settings leave neither enough room.
    crate::pool::strip(S, hosts.side + "/SheetSideRows", if stacked { [] } else { side_controls(S, k) });
    util::fill(hosts.side, #{ visible: !stacked });
    let specs = form_specs(S, k);
    if stacked {
        specs.insert(0, picker_spec(S));
    }
    crate::pool::sync(S, hosts.form, specs, label_w(S), stacked);
}


/// The label column a settings row keeps, and the picker a narrow sheet
/// shows in place of its sidebar.
fn label_w(S) {
    util::clamp(row_w(S) * 0.42, 120.0, 260.0)
}

fn picker_spec(S) {
    let names = [];
    for category in categories() {
        names.push(category);
    }
    #{ full: true, height: crate::style::row_h(S), controls: [#{
        kind: "dropdown", role: "choice_form", grow: 1,
        text: current(S), options: names,
        on: |picked| {
            set_query(S, "");
            S.settings.at = picked;
        },
    }] }
}


fn save_button(S, k) {
    if !S.settings.dirty {
        return;
    }
    if ui::button("Save", #{ height: 24, font_size: style::MD, corner_radius: 8, fill: k.primary_fill, text_color: k.text_on_primary }) {
        commit(S);
    }
}

/// The column down the left: the search box, and a row per category under
/// the scope it belongs to.
fn side_controls(S, k) {
    let out = [crate::search::control(S, FIELD, "Search", SIDEBAR_W)];
    let scope = "";
    for name in categories() {
        // Bound afresh: a closure made in a loop captures the binding.
        let category = name;
        let here = scope_of(category);
        if here != scope {
            scope = here;
            out.push(#{
                kind: "label", role: "text_caption",
                text: if scope == "project" { "PROJECT" } else { "THIS EDITOR" },
            });
        }
        let on = query(S) == "" && category == current(S);
        out.push(#{
            kind: "button", text: category,
            role: "item_sidebar", checked: on,
            on: |_| {
                set_query(S, "");
                S.settings.at = category;
            },
        });
    }
    out
}

/// Every row the form shows: a note at its head, a heading per group, and a
/// row per setting with its help under it.
fn form_specs(S, k) {
    let rows = showing(S);
    let out = [];
    let h = crate::style::row_h(S);
    if query(S) != "" {
        out.push(note_spec(format!("{} matching \"{}\"", rows.len(), query(S))));
    } else if scope_of(current(S)) == "project" {
        out.push(#{ full: true, height: 34, slot_role: "layout_actions", controls: [
            #{
                kind: "label", role: "text_caption", grow: 1,
                text: "Written to project.toml, and shipped with the game.",
            },
            target_control(S),
        ] });
    } else {
        out.push(note_spec("Kept in this editor only, and never written to the project."));
    }
    if rows.is_empty() {
        out.push(note_spec(crate::search::nothing_says(query(S))));
        return out;
    }
    // Grouped by the middle of the path, in the order the first setting of
    // each group asks for. A search result skips the headings: its rows show
    // whole paths, and a heading would say the same thing.
    let searching = query(S) != "";
    let group = "";
    let scope = scope_of(current(S));
    for def in rows {
        if !searching && def.scope != scope {
            scope = def.scope;
            group = "";
            out.push(head_spec("THIS EDITOR"));
        }
        let here = group_of(def);
        if !searching && here != group {
            group = here;
            if group != "" {
                out.push(head_spec(group.to_uppercase()));
            }
        }
        let path = def.path;
        let controls = [editor_control(S, def, path)];
        if path == crate::theme::SETTING {
            controls.push(#{
                kind: "button", role: "action_form_primary", text: "Edit…",
                tooltip: "Open the Theme dialog",
                on: |_| { crate::themewin::open(S); },
            });
        }
        out.push(#{
            label: if searching { path } else { key_of(def) },
            height: h, slot_role: "layout_actions",
            controls: controls,
        });
        let spec = util::obj(def.spec);
        let help = spec.get("help").unwrap_or("");
        if help != "" {
            let tail = if def.applies_now { "" } else { "  ·  takes effect on the next run" };
            out.push(note_spec(help + tail));
        }
        for tag in settings::overrides(path) {
            // Bound afresh: a closure made in a loop captures the binding.
            let on = tag;
            let at = override_path(on, path);
            out.push(#{
                label: "  on " + on, height: h, slot_role: "layout_actions",
                controls: [
                    editor_control(S, def, at),
                    #{
                        kind: "button", role: "chip_quiet", text: "×",
                        tooltip: "Reset this override",
                        on: |_| {
                            settings::clear(at);
                            S.settings.dirty = true;
                        },
                    },
                ],
            });
        }
    }
    out
}

/// A line of prose across both columns, and a group's heading.
fn note_spec(text) {
    #{ full: true, height: 0, controls: [#{
        kind: "label", role: "text_caption", grow: 1, wrap: true, text: text,
    }] }
}

fn head_spec(text) {
    #{ full: true, height: 24, controls: [#{
        kind: "label", role: "text_caption", grow: 1, text: text,
    }] }
}




// The page's one override choice. The dropdown draws what it is handed, so the
// prompt is its own text until a tag is picked.
/// Which override a project setting is written to, or none.
fn target_control(S) {
    let options = ["none"];
    for tag in settings::known_tags() {
        options.push(tag);
    }
    #{
        kind: "dropdown", role: "choice_form", width: 170,
        text: if S.settings.target == "" { "override for…" } else { "override for " + S.settings.target },
        options: options,
        on: |picked| {
            S.settings.target = if picked == "none" { "" } else { picked };
        },
    }
}

fn override_path(tag, path) {
    "override/" + tag + "/" + path
}

// `base`, never `get`: the editor edits what the file says. A screen showing
// the override this machine happened to match would write it onto the key it
// overrides.
/// The control one setting's row carries, by the schema's datatype.
fn editor_control(S, def, path) {
    let spec = util::obj(def.spec);
    let datatype = spec.get("type").unwrap_or("string");
    let value = settings::base(path);
    if datatype == "bool" {
        return #{
            kind: "switch", role: "switch_form", checked: value == true,
            on: |on| { write(S, path, on); },
        };
    }
    if datatype == "enum" {
        // The theme's choices are files, so they are listed, not declared.
        let named = path == crate::theme::SETTING;
        return #{
            kind: "dropdown", role: "choice_form", grow: 1,
            text: if value is String { value } else { "" },
            options: if named { crate::theme::names() } else { util::vec(spec.get("options").unwrap_or([])) },
            on: |picked| { write(S, path, picked); },
        };
    }
    if datatype == "int" || datatype == "float" {
        let low = util::f(spec.get("min").unwrap_or(0.0));
        let high = util::f(spec.get("max").unwrap_or(if datatype == "int" { 1000000.0 } else { 1.0 }));
        // A setting declared with no default reads as nil, and `() as f64` is
        // a runtime error; the control starts at its floor instead.
        let now = if value is Tuple { low } else { util::f(value) };
        let whole = datatype == "int";
        return #{
            kind: "number_field", role: "input_number", grow: 1,
            value: now, min: low, max: high, step: if whole { 1.0 } else { 0.01 },
            on: |v| {
                write(S, path, if whole { math::round(v) as i64 } else { v });
            },
        };
    }
    // Everything else reads and writes as text, a comma-separated list
    // included: a row of its own per entry would be a page per setting.
    let shown = if datatype == "list" {
        commas(value)
    } else if value is String {
        value
    } else if value is Tuple {
        ""
    } else {
        format!("{}", value)
    };
    #{
        kind: "text_field", role: "input_form", grow: 1, text: shown,
        on_submit: |text| {
            write(S, path, if datatype == "list" { split_commas(text) } else { text });
        },
    }
}


// A list as one line, and back. `Vec` has no join, so the separator is put
// in by hand.
fn commas(value) {
    let out = "";
    for item in util::vec(value) {
        if out != "" {
            out += ", ";
        }
        out += `${item}`;
    }
    out
}

fn split_commas(text) {
    let out = [];
    for part in text.split(',') {
        let item = part.trim();
        if item != "" {
            out.push(item);
        }
    }
    out
}

pub fn write(S, path, value) {
    settings::set(path, value);
    S.settings.dirty = true;
    apply(S);
}

// Editor settings take effect as they change, not on save: a theme you have
// to save to see is a theme you cannot preview.
pub fn apply(S) {
    let theme_name = settings::get(crate::theme::SETTING);
    if theme_name is String {
        crate::theme::use_named(S, theme_name);
    }
    let scale = settings::get("editor/appearance/ui_scale");
    if !(scale is Tuple) {
        crate::shell::ask_ui_scale(S, util::f(scale));
    }
    // Kept apart from `S.compact`, which the window width also writes: the
    // setting forces compact on, it never forces it off.
    let compact = settings::get("editor/appearance/compact");
    if compact is bool {
        S.settings.compact = compact;
    }
    let verify = settings::get("editor/recordings/verify");
    if verify is bool {
        S.session.verify = verify;
    }
}
