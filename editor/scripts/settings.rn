// The settings screen: every setting the engine, its plugins and this game
// declare, grouped by the first segment of its path and searchable by any.

use crate::style;
use crate::util;

// The search field this screen filters with; `crate::search` keys its own
// buffer by the same id.
const FIELD = "settings";

pub fn state() {
    #{
        // The category showing, "" until the first is picked.
        at: "",
        dirty: false,
        // The search box. Non-empty means the list is results, not categories.
        query: "",
        // What `editor/appearance/compact` asks for, which the window width
        // can only add to.
        compact: false,
        // Where `--state settingsdemo` has got to; -1 when it is not running.
        demo: -1,
        // The tag the header offers an override for, "" for none: one choice
        // for the page, as Godot's "Override For", not a picker per row.
        target: "",
    }
}

// The query lives in two places — this, and the search field's own buffer —
// so whatever moves one writes both.
fn set_query(S, text) {
    S.settings.query = text;
    S.search[FIELD] = text;
}

// Open on a search, for a screenshot or a "configure this" link that knows
// the word but not the page.
pub fn open_search(S, query) {
    open(S);
    set_query(S, query);
}

// Open at a named category, for a screenshot or a deep link from a dock.
pub fn open_at(S, category) {
    open(S);
    S.settings.at = category;
}

pub fn open(S) {
    crate::window::show(S, "settings");
    load_files(S);
}

/// Read both settings files and apply what the editor acts on. Called at boot
/// and again when the window opens, so a hand edit between the two is not
/// silently reverted on the next write.
pub fn load_files(S) {
    let manifest = fs::read(S.game_root + "/project.toml");
    if manifest is String {
        settings::load(manifest);
    }
    let prefs = fs::read(prefs_path());
    if prefs is String {
        settings::load(prefs);
    }
    apply(S);
}

// The editor's own settings live beside its sessions, not in any project.
pub fn prefs_path() {
    engine::user_data_dir() + "/settings.toml"
}

// Categories in definition order, project first: a game author looks for what
// ships far more often than for what does not.
fn categories() {
    let seen = [];
    for scope in ["project", "editor"] {
        for def in settings::all() {
            if def.scope == scope && !seen.iter().any(|c| c == def.category) {
                seen.push(def.category);
            }
        }
    }
    seen
}

fn scope_of(category) {
    for def in settings::all() {
        if def.category == category {
            return def.scope;
        }
    }
    "project"
}

fn current(S) {
    let all = categories();
    if all.is_empty() {
        return "";
    }
    if all.iter().any(|c| c == S.settings.at) {
        return S.settings.at;
    }
    all[0]
}

// What the list shows: the search results when there is a query, otherwise
// everything in the chosen category.
fn showing(S) {
    let query = S.settings.query.to_lowercase();
    let rows = [];
    for def in settings::all() {
        let matches = if query == "" {
            def.category == current(S)
        } else {
            // The path and the help both, so "packet" finds `netcode/loss`
            // by its sentence when its name does not say it.
            def.path.to_lowercase().contains(query)
                || util::obj(def.spec).get("help").unwrap_or("").to_lowercase().contains(query)
        };
        if matches {
            rows.push(def);
        }
    }
    rows.sort_by(|a, b| order_of(a).partial_cmp(order_of(b)).unwrap());
    rows
}

fn order_of(def) {
    util::f(util::obj(def.spec).get("order").unwrap_or(1000.0))
}

// `editor/appearance/theme` groups under "appearance"; `physics/gravity`
// under nothing, since there is nothing between its category and its key.
fn group_of(def) {
    let parts = def.label.split('/').collect::<Vec>();
    if parts.len() < 2 { "" } else { parts[0] }
}

// The last segment: what a row is labelled inside its group.
fn key_of(def) {
    let parts = def.path.split('/').collect::<Vec>();
    parts[parts.len() - 1]
}

// Write both files. Only the paths a scope defines are touched, so a comment
// or an unrelated table in project.toml survives.
pub fn commit(S) {
    let path = S.game_root + "/project.toml";
    let existing = fs::read(path);
    fs::write(path, settings::to_toml("project", if existing is String { existing } else { "" }));
    commit_prefs(S);
    S.settings.dirty = false;
}

/// The editor's half alone: what a self-test can round-trip without rewriting
/// the game's manifest.
pub fn commit_prefs(S) {
    let prefs = fs::read(prefs_path());
    fs::write(prefs_path(), settings::to_toml("editor", if prefs is String { prefs } else { "" }));
}

pub fn draw(S) {
    let k = S.theme;
    crate::window::sheet(S, "settings", "Settings", || { save_button(S, k); }, || {
        ui::horizontal(#{ height: 0 }, || {
            sidebar(S, k);
            ui::add_space(20);
            body(S, k);
        });
    });
}

fn save_button(S, k) {
    if !S.settings.dirty {
        return;
    }
    if ui::pill("Save", #{ height: 24, size: style::MD, radius: 8, fill: k.accent_fill, color: k.on_accent }) {
        commit(S);
    }
}

fn sidebar(S, k) {
    ui::vertical(|| {
        // The field owns the text while it is being typed; `set_query` owns it
        // whenever anything else changes it.
        S.settings.query = crate::search::field(S, k, FIELD, "Search", 190.0);
        ui::add_space(10);
        let scope = "";
        for category in categories() {
            let here = scope_of(category);
            if here != scope {
                scope = here;
                ui::add_space(6);
                ui::label(
                    if scope == "project" { "PROJECT" } else { "THIS EDITOR" },
                    style::mono_sm(k.faint),
                );
                ui::add_space(4);
            }
            let on = S.settings.query == "" && category == current(S);
            if ui::pill(category, #{
                height: 24, size: style::MD, radius: 8, min_width: 190,
                fill: if on { k.sunken } else { k.panel },
                color: if on { k.text } else { k.dim },
            }) {
                set_query(S, "");
                S.settings.at = category;
            }
        }
    });
}

fn body(S, k) {
    let rows = showing(S);
    ui::vertical(|| {
        if S.settings.query != "" {
            ui::label(format!("{} matching \"{}\"", rows.len(), S.settings.query), style::mono_sm(k.faint));
        } else if scope_of(current(S)) == "project" {
            ui::horizontal(#{ height: 24 }, || {
                ui::label("Written to project.toml, and shipped with the game.", style::mono_sm(k.faint));
                ui::right(|| {
                    target_picker(S, k);
                });
            });
        } else {
            ui::label("Kept in this editor only, and never written to the project.", style::mono_sm(k.faint));
        }
        ui::add_space(10);
        if rows.is_empty() {
            crate::search::nothing(k, S.settings.query);
            return;
        }
        // Grouped by the middle of the path, in the order the first setting
        // of each group asks for. A search result skips the headings: its
        // rows show whole paths, and a heading would say the same thing.
        let searching = S.settings.query != "";
        // Starts as the empty group, so ungrouped rows at the top of a page
        // get no heading and the first real group does.
        let group = "";
        for def in rows {
            let here = group_of(def);
            if !searching && here != group {
                group = here;
                if group != "" {
                    ui::add_space(6);
                    ui::label(group.to_uppercase(), style::mono_sm(k.faint));
                    ui::add_space(4);
                }
            }
            row(S, k, def);
        }
    });
}

// One setting: its path, its editor, and the line of help underneath. A
// search result shows the whole path, since the category is not on screen.
fn row(S, k, def) {
    let name = if S.settings.query == "" { key_of(def) } else { def.path };
    ui::horizontal(#{ height: 24 }, || {
        ui::label(name, style::mono(k.text));
        ui::right(|| {
            edit(S, k, def, def.path);
        });
    });
    let spec = util::obj(def.spec);
    let help = spec.get("help").unwrap_or("");
    if help != "" {
        let suffix = if def.applies_now { "" } else { "  ·  takes effect on the next run" };
        // Wrapped: one long sentence otherwise widens the page, and every
        // editor aligned to its right edge goes off the sheet with it.
        ui::label(help + suffix, util::merge(style::mono_sm(k.faint), #{ wrap: true }));
    }
    if def.scope == "project" {
        overrides(S, k, def);
    }
    ui::add_space(8);
}

// The answers this key has besides the one above: one row per tag the project
// overrides it for, and, when the header names a tag, a pill that adds one.
fn overrides(S, k, def) {
    let held = settings::overrides(def.path);
    for tag in held {
        let path = override_path(tag, def.path);
        ui::horizontal(#{ height: 22 }, || {
            ui::label("  on " + tag, style::mono_sm(k.dim));
            ui::right(|| {
                if ui::pill("×", #{ height: 20, size: style::SM, radius: 6, fill: k.panel, color: k.faint }) {
                    settings::clear(path);
                    S.settings.dirty = true;
                }
                ui::add_space(6);
                edit(S, k, def, path);
            });
        });
    }
    let tag = S.settings.target;
    if tag == "" || held.iter().any(|t| t == tag) {
        return;
    }
    if ui::pill("+ on " + tag, #{ height: 20, size: style::SM, radius: 6, fill: k.panel, color: k.faint }) {
        // Seeded with what the key already answers, so the row that appears
        // says what it is overriding rather than a type's empty value.
        settings::set(override_path(tag, def.path), settings::base(def.path));
        S.settings.dirty = true;
    }
}

// The page's one override choice. The dropdown draws what it is handed, so the
// prompt is its own text until a tag is picked.
fn target_picker(S, k) {
    let options = ["none"];
    for tag in settings::known_tags() {
        options.push(tag);
    }
    let showing = if S.settings.target == "" { "override for…" } else { "override for " + S.settings.target };
    let (picked, changed) = ui::dropdown("settings:target", showing, options,
        #{ width: 170, size: style::SM, color: k.dim });
    if changed {
        S.settings.target = if picked == "none" { "" } else { picked };
    }
}

fn override_path(tag, path) {
    "override/" + tag + "/" + path
}

// `base`, never `get`: the editor edits what the file says. A screen showing
// the override this machine happened to match would write it onto the key it
// overrides.
fn edit(S, k, def, path) {
    let spec = util::obj(def.spec);
    let datatype = spec.get("type").unwrap_or("string");
    let value = settings::base(path);
    if datatype == "bool" {
        let (on, changed) = ui::toggle(value == true, #{ role: "toggle",
            on_fill: k.accent_fill, off_fill: k.sunken,
            on_knob: k.on_accent, off_knob: k.faint,
        });
        if changed {
            write(S, path, on);
        }
    } else if datatype == "float" {
        let low = util::f(spec.get("min").unwrap_or(0.0));
        let high = util::f(spec.get("max").unwrap_or(1.0));
        // A setting declared with no default reads as nil, and `() as f64` is
        // a runtime error; the slider starts at its floor instead.
        let now = if value is Tuple { low } else { util::f(value) };
        let (v, changed) = ui::slider(now, low, high, #{ width: 220 });
        if changed {
            write(S, path, v);
        }
    } else if datatype == "int" {
        let low = util::f(spec.get("min").unwrap_or(0.0));
        let high = util::f(spec.get("max").unwrap_or(1000000.0));
        // A drag rather than the slider a float gets: a count is read as
        // often as it is changed, and the slider draws no number at all.
        let now = if value is i64 { util::f(value) } else { low };
        let (v, changed) = ui::drag_value(now, #{
            width: 220.0, speed: 0.05, decimals: 0,
            fill: k.sunken, stroke: k.line, color: k.text,
        });
        if changed {
            write(S, path, math::round(util::clamp(v, low, high)) as i64);
        }
    } else if datatype == "enum" {
        let (v, changed) = ui::dropdown(
            "set:" + path,
            if value is String { value } else { "" },
            util::vec(spec.get("options").unwrap_or([])),
            #{ width: 220, size: style::MD, height: 24, color: k.text },
        );
        if changed {
            write(S, path, v);
        }
    } else if datatype == "strings" {
        // Comma-separated: a list of globs or ranges is short, and a row of
        // its own per entry would be a page per setting.
        let (text, _, submitted) = ui::text_field("set:" + path, "",
            util::merge(style::field(k, 220.0), #{ value: commas(value) }));
        if submitted {
            write(S, path, split_commas(text));
        }
    } else if datatype == "flags" {
        let held = util::vec(value);
        ui::horizontal(#{ height: 22 }, || {
            for option in util::vec(spec.get("options").unwrap_or([])) {
                let on = held.iter().any(|h| h == option);
                if ui::pill(option, #{
                    height: 20, size: style::SM, radius: 6,
                    fill: if on { k.accent_fill } else { k.panel },
                    color: if on { k.on_accent } else { k.dim },
                }) {
                    let next = [];
                    for name in held {
                        if name != option {
                            next.push(name);
                        }
                    }
                    if !on {
                        next.push(option);
                    }
                    write(S, path, next);
                }
                ui::add_space(4);
            }
        });
    } else {
        // Committed on submit rather than per keystroke: a settings file
        // rewritten on every character is noise in a diff.
        let (text, _, submitted) = ui::text_field("set:" + path, "",
            util::merge(style::field(k, 220.0), #{
                value: if value is String { value } else { "" },
            }));
        if submitted {
            write(S, path, text);
        }
    }
}

// A list as one line, and back. `Vec` has no join, so the separator is put
// in by hand.
fn commas(value) {
    let out = "";
    for item in util::vec(value) {
        if out != "" {
            out += ", ";
        }
        out += `${item}`;
    }
    out
}

fn split_commas(text) {
    let out = [];
    for part in text.split(',') {
        let item = part.trim();
        if item != "" {
            out.push(item);
        }
    }
    out
}

pub fn write(S, path, value) {
    settings::set(path, value);
    S.settings.dirty = true;
    apply(S);
}

// Editor settings take effect as they change, not on save: a theme you have
// to save to see is a theme you cannot preview.
pub fn apply(S) {
    let theme_name = settings::get("editor/appearance/theme");
    if theme_name is String {
        crate::theme::set_dark(S, theme_name == "dark");
    }
    let scale = settings::get("editor/appearance/ui_scale");
    if !(scale is Tuple) {
        crate::shell::set_ui_scale(S, util::f(scale));
    }
    // Kept apart from `S.compact`, which the window width also writes: the
    // setting forces compact on, it never forces it off.
    let compact = settings::get("editor/appearance/compact");
    if compact is bool {
        S.settings.compact = compact;
    }
    let verify = settings::get("editor/sessions/verify");
    if verify is bool {
        S.session.verify = verify;
    }
}
