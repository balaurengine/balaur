// The settings screen: every page the engine and its plugins declare, in one
// sheet over the shell.
//
// Nothing here knows what a setting means. The engine declares each page with
// a schema in the same shape a component uses, and this renders whatever is
// in it — so a plugin adding a page needs no editor change, exactly as a
// plugin adding a component needs none.
//
// Two scopes, kept visibly apart. A project setting is the game's: it goes to
// `project.toml`, ships, and belongs in version control. An editor setting is
// this developer's: it goes to the editor's own data directory and never near
// the project, so turning on packet loss to test rollback cannot be committed
// by accident.

use crate::icons;
use crate::style;
use crate::util;

pub fn state() {
    #{
        open: false,
        // The category showing, "" until the first page is picked.
        at: "",
        // Set when a value changed and the file has not caught up yet.
        dirty: false,
    }
}

pub fn open(S) {
    S.settings.open = true;
    // Start from what the project actually says rather than the defaults, so
    // an unsaved manifest edit is not silently reverted on the next write.
    let manifest = fs::read(S.game_root + "/project.toml");
    if manifest is String {
        settings::load_project(manifest);
    }
    let prefs = fs::read(prefs_path());
    if prefs is String {
        settings::load_project(prefs);
    }
}

pub fn close(S) {
    S.settings.open = false;
}

// The editor's own settings live beside its sessions, not in any project.
fn prefs_path() {
    engine::user_data_dir() + "/settings.toml"
}

// Pages in declaration order, project first: a game author looks for what
// ships far more often than for what does not.
fn pages() {
    let project = [];
    let editor = [];
    for page in settings::pages() {
        if page.scope == "project" {
            project.push(page);
        } else {
            editor.push(page);
        }
    }
    let all = [];
    for page in project { all.push(page); }
    for page in editor { all.push(page); }
    all
}

fn current(S) {
    let all = pages();
    if all.is_empty() {
        return ();
    }
    for page in all {
        if page.category == S.settings.at {
            return page;
        }
    }
    all[0]
}

// Write both files. Project settings only touch the keys a page declares, so
// a hand-written comment or an unrelated table survives.
fn commit(S) {
    let path = S.game_root + "/project.toml";
    let existing = fs::read(path);
    let manifest = if existing is String { existing } else { "" };
    let written = settings::project_toml(manifest);
    fs::write(path, written);
    fs::write(prefs_path(), settings::editor_toml());
    S.settings.dirty = false;
}

pub fn draw(S) {
    if !S.settings.open {
        return;
    }
    let k = S.theme;
    let r = S.layout.viewport;
    // Inset from the shell so the sheet reads as over it rather than as
    // another dock.
    let pad = 48.0;
    let x = r.x + pad;
    let y = r.y + pad;
    let w = util::max(560.0, r.w - pad * 2.0);
    let h = util::max(360.0, r.h - pad * 2.0);
    ui::overlay("settings", #{ x: x, y: y, w: w, h: h, fill: k.panel, radius: 12 }, || {
        ui::vertical(#{}, || {
            head(S, k);
            ui::horizontal(#{}, || {
                categories(S, k);
                page_body(S, k, w);
            });
        });
    });
}

fn head(S, k) {
    ui::horizontal(#{ height: 40 }, || {
        ui::add_space(14);
        ui::label("Settings", style::mono_lg(k.text));
        ui::right(|| {
            ui::add_space(10);
            if ui::pill("Close", #{ height: 26, size: 12, radius: 8, fill: k.sunken, color: k.dim }) {
                close(S);
            }
            if S.settings.dirty {
                ui::add_space(8);
                if ui::pill("Save", #{ height: 26, size: 12, radius: 8, fill: k.accent_fill, color: k.on_accent }) {
                    commit(S);
                }
            }
        });
    });
}

fn categories(S, k) {
    ui::vertical(#{ width: 180 }, || {
        let scope = "";
        for page in pages() {
            // One heading per scope, so the difference between "ships with
            // the game" and "mine" is visible rather than documented.
            if page.scope != scope {
                scope = page.scope;
                ui::add_space(8);
                ui::label(
                    if scope == "project" { "PROJECT" } else { "THIS EDITOR" },
                    style::mono_sm(k.faint),
                );
                ui::add_space(4);
            }
            let here = current(S);
            let on = here is Object && here.category == page.category;
            if ui::pill(page.category, #{
                height: 26, size: 12, radius: 8, min_width: 160,
                fill: if on { k.sunken } else { k.panel },
                color: if on { k.text } else { k.dim },
            }) {
                S.settings.at = page.category;
            }
        }
    });
}

fn page_body(S, k, w) {
    let page = current(S);
    if !(page is Object) {
        ui::label("No settings are declared.", style::mono(k.dim));
        return;
    }
    ui::vertical(#{ width: w - 200.0 }, || {
        ui::add_space(6);
        ui::label(
            if page.scope == "project" {
                "Written to project.toml, and shipped with the game."
            } else {
                "Kept in this editor only, and never written to the project."
            },
            style::mono_sm(k.faint),
        );
        ui::add_space(10);
        for key in util::keys_sorted(page.schema) {
            row(S, k, page.table, key, page.schema[key]);
        }
    });
}

// One setting: its name, its editor, and the line of help underneath.
fn row(S, k, table, key, spec) {
    let value = settings::get(table, key);
    ui::horizontal(#{ height: 26 }, || {
        ui::label(key, style::mono(k.text));
        ui::right(|| {
            edit(S, k, table, key, spec, value);
        });
    });
    let help = spec.get("help");
    if help is String {
        ui::label(help, style::mono_sm(k.faint));
        ui::add_space(8);
    }
}

fn edit(S, k, table, key, spec, value) {
    let datatype = spec.get("type").unwrap_or("string");
    if datatype == "bool" {
        let (on, changed) = ui::toggle(value == true, #{ role: "toggle",
            on_fill: k.accent_fill, off_fill: k.sunken,
            on_knob: k.on_accent, off_knob: k.faint,
        });
        if changed {
            write(S, table, key, on);
        }
    } else if datatype == "float" {
        let low = util::f(spec.get("min").unwrap_or(0.0));
        let high = util::f(spec.get("max").unwrap_or(1.0));
        let (v, changed) = ui::slider(util::f(value), low, high, #{ width: 220 });
        if changed {
            write(S, table, key, v);
        }
    } else if datatype == "enum" {
        let options = util::vec(spec.get("options").unwrap_or([]));
        let (v, changed) = ui::dropdown(
            format!("set:{}:{}", table, key),
            if value is String { value } else { "" },
            options,
            #{ width: 220, size: 11.5, height: 22, color: k.text },
        );
        if changed {
            write(S, table, key, v);
        }
    } else {
        let (v, changed) = ui::text_field(
            format!("set:{}:{}", table, key),
            if value is String { value } else { "" },
            #{ width: 220 },
        );
        if changed {
            write(S, table, key, v);
        }
    }
}

fn write(S, table, key, value) {
    settings::set(table, key, value);
    S.settings.dirty = true;
}
