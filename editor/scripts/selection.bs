// The selection as an ordered set. `state.selected` is its head and stays the active
// node, so every command reading one index is unchanged; a command over many
// iterates here instead.

use editor;
use model;
use rig;
use signals;
use util;

/// A selected root's pose when a drag began, so each frame applies a delta
/// to that rather than to where the last frame left it.
pub struct RootPose {
    index: int,
    position: [float],
    scale: [float],
    rotation: [float],
    world: [float],
}

/// Replace the set with one node and make it active. Every writer of `state.selected`
/// goes through this: a stale `state.selected_rows` is a selection the gizmo disagrees with.
pub fn only(state: &mut editor::State, row: int) {
    state.selected_rows = [row];
    state.selected = row;
    signals::selected(state);
}

/// Every selected index, active first.
pub fn all(state: editor::State) -> [int] {
    if state.selected_rows.len() > 0 {
        return state.selected_rows;
    }
    // Empty, not `[-1]`: a click on empty space deselects, and a loop over
    // this must then do nothing rather than index the document with -1.
    if state.selected < 0 {
        return [];
    }
    // `return`: a list after a block reads as indexing the block.
    return [state.selected];
}

pub fn count(state: editor::State) -> int {
    all(state).len()
}

pub fn contains(state: editor::State, row: int) -> bool {
    util::int_contains(all(state), row)
}

/// Add or drop one node; an added one becomes active. Dropping the last one
/// leaves nothing selected, which the panels and tools draw as an empty
/// frame.
pub fn toggle(state: &mut editor::State, row: int) {
    let selected_rows = state.selected_rows;
    let at = util::int_position(selected_rows, row);
    if at != nil {
        if selected_rows.len() > 1 {
            selected_rows.remove(at.unwrap());
            state.selected = selected_rows[0];
        }
    } else {
        selected_rows.insert(0, row);
        state.selected = row;
    }
    signals::selected(state);
}

/// Extend the set to the document rows between the active node and `row`, for
/// a shift-click in the tree.
pub fn extend_to(state: &mut editor::State, row: int) {
    let lowest = util::int_min(state.selected, row);
    let highest = util::int_max(state.selected, row);
    let out = [row];
    for candidate in lowest..highest + 1 {
        if candidate != row {
            out.push(candidate);
        }
    }
    state.selected_rows = out;
    state.selected = row;
    signals::selected(state);
}

/// Select nothing: a click on empty space in the viewport, or a delete that
/// took the last selected row. `state.selected` of -1 is the no-selection the panels
/// and tools already test for.
pub fn clear(state: &mut editor::State) {
    state.selected_rows = [];
    state.selected = -1;
    signals::selected(state);
}

/// Select exactly these rows; the first is active. An empty list is ignored.
pub fn set(state: &mut editor::State, rows: [int]) {
    if rows.len() == 0 {
        return;
    }
    state.selected_rows = rows;
    state.selected = rows[0];
    signals::selected(state);
}

pub fn select_all(state: &mut editor::State) {
    let rows: [int] = [];
    for row in 0..state.nodes.len() {
        if !is_locked(state, row) {
            rows.push(row);
        }
    }
    set(state, rows);
}

/// Drop rows the scene no longer has.
pub fn clamp(state: &mut editor::State) {
    let rows: [int] = [];
    for row in all(state) {
        if row >= 0 && row < state.nodes.len() && !util::int_contains(rows, row) {
            rows.push(row);
        }
    }
    if rows.len() == 0 {
        rows = [util::int_max(0, util::int_min(state.selected, state.nodes.len() - 1))];
    }
    state.selected_rows = rows;
    state.selected = rows[0];
    signals::selected(state);
}

fn id_of(state: editor::State, row: int) -> str {
    let found = model::node(state, row);
    if found.is_valid() { found.stable_id() } else { "" }
}

/// The selected rows with any descendant of another selected row dropped: a
/// shared delta applied to both would move the child twice.
pub fn roots(state: editor::State) -> [int] {
    let rows = all(state);
    let out: [int] = [];
    for row in rows {
        let nested = false;
        for other in rows {
            if other != row && model::is_within(model::node(state, row), model::node(state, other)) {
                nested = true;
            }
        }
        if !nested {
            out.push(row);
        }
    }
    out
}

/// Locked rows are skipped by the gizmo, by picking and by box select. Editor
/// state keyed by id, never written to the file: a lock nobody can see in the
/// document is a lock nobody can explain.
pub fn is_locked(state: editor::State, row: int) -> bool {
    state.locks.has(id_of(state, row))
}

pub fn set_locked(state: &mut editor::State, row: int, locked: bool) {
    let id = id_of(state, row);
    if id == "" {
        return;
    }
    if locked {
        state.locks[id] = true;
    } else {
        state.locks.remove(id);
    }
    signals::outline(state);
}

pub fn unlock_all(state: &mut editor::State) {
    state.locks = {};
    signals::outline(state);
}

/// Every selected root's transform, taken once when a drag starts so each
/// frame applies a delta to the pose the drag began from.
pub fn snapshot(state: editor::State) -> [RootPose] {
    let out: [RootPose] = [];
    for row in roots(state) {
        let found = model::node(state, row);
        if is_locked(state, row) || !found.is_valid() {
            continue;
        }
        out.push(RootPose {
            index: row,
            position: util::xyz(found.transform.position),
            scale: util::xyz(found.transform.scale),
            rotation: model::transform_part(found, animation::PROPERTY_ROTATION_EULER, [0.0, 0.0, 0.0]),
            world: util::xyz(found.transform.global_position()),
        });
    }
    out
}

// Each axis to the nearest half unit, for the Snap chip.
fn snapped(position: [float]) -> [float] {
    [math::round(position[0] * 2.0) / 2.0, math::round(position[1] * 2.0) / 2.0, math::round(position[2] * 2.0) / 2.0]
}

/// Offset every row in a snapshot by one world delta. `snap_to` rounds the
/// result to half units when the Snap chip is on.
pub fn move_by(state: &mut editor::State, snap: [RootPose], delta: [float], snap_to: bool) {
    for entry in snap {
        let position = util::vector_add(entry.position, delta);
        if snap_to {
            position = snapped(position);
        }
        model::set_transform(state, entry.index, rig::Parts { position: position, rotation_euler: [], scale: [] });
    }
}

/// Multiply every row's scale by `factors`, and move it away from `pivot` by
/// the same amount so a set scales as one body.
pub fn scale_by(state: &mut editor::State, snap: [RootPose], factors: [float], pivot: [float]) {
    let many = snap.len() > 1;
    for entry in snap {
        let scaled = [entry.scale[0] * factors[0], entry.scale[1] * factors[1], entry.scale[2] * factors[2]];
        let parts = rig::Parts { position: [], rotation_euler: [], scale: scaled };
        if many {
            let offset = util::vector_subtract(entry.world, pivot);
            let moved = [offset[0] * factors[0], offset[1] * factors[1], offset[2] * factors[2]];
            parts.position = util::vector_add(entry.position, util::vector_subtract(moved, offset));
        }
        model::set_transform(state, entry.index, parts);
    }
}

/// Turn every row about its own axis, and about `pivot` when more than one is
/// selected, so a set rotates as one body.
pub fn rotate_by(state: &mut editor::State, snap: [RootPose], axis: int, angle: float, pivot: [float]) {
    let many = snap.len() > 1;
    for entry in snap {
        let parts = rig::Parts { position: [], rotation_euler: util::rotate_euler(entry.rotation, axis, angle), scale: [] };
        if many {
            let turned = util::rotate_about(entry.world, pivot, axis, angle);
            parts.position = util::vector_add(entry.position, util::vector_subtract(turned, entry.world));
        }
        model::set_transform(state, entry.index, parts);
    }
}

/// Offset every selected root by a world delta, read from where it is now.
pub fn nudge(state: &mut editor::State, delta: [float], snap_to: bool) {
    for row in roots(state) {
        let found = model::node(state, row);
        if is_locked(state, row) || !found.is_valid() {
            continue;
        }
        let position = util::vector_add(util::xyz(found.transform.position), delta);
        if snap_to {
            position = snapped(position);
        }
        model::set_transform(state, row, rig::Parts { position: position, rotation_euler: [], scale: [] });
    }
}

/// Turn every selected root about one of its own axes by `angle`.
pub fn spin(state: &mut editor::State, axis: int, angle: float) {
    for row in roots(state) {
        let found = model::node(state, row);
        if is_locked(state, row) || !found.is_valid() {
            continue;
        }
        let rotation = util::xyz(found.transform.rotation_euler);
        rotation[axis] = rotation[axis] + angle;
        model::set_transform(state, row, rig::Parts { position: [], rotation_euler: rotation, scale: [] });
    }
}

/// Multiply every selected root's scale by one factor.
pub fn grow(state: &mut editor::State, factor: float, planar: bool) {
    for row in roots(state) {
        let found = model::node(state, row);
        if is_locked(state, row) || !found.is_valid() {
            continue;
        }
        let scale = found.transform.scale;
        let depth = if planar { scale.z } else { scale.z * factor };
        model::set_transform(state, row, rig::Parts { position: [], rotation_euler: [], scale: [scale.x * factor, scale.y * factor, depth] });
    }
}
