// What the Editor node tells the panels, as events they listen for. Each is
// emitted once however many edits a frame makes: the guard is cleared when
// the Editor hears its own event, at the next pump.

use center;
use chrome;
use editor;
use layout;
use lint;
use session;
use util;
use viewport;
use words::dock_fields;
use words::layout_fields;
use words::roles;
use words::tabs;
use words::tools;
use words::verbs;

internal const OUTLINE: str = "outline_changed";
internal const INSPECTOR: str = "inspector_changed";
internal const DOCKS: str = "docks_changed";
internal const PLAY: str = "play_frame";
internal const CHROME: str = "chrome_changed";
internal const STATUS: str = "status_changed";
internal const RAIL: str = "rail_changed";
internal const STAGE: str = "stage_changed";
const ASSETS: str = "assets";
const ASSETS_RELOADED: str = "assets_reloaded";
const FILES_CHANGED: str = "files_changed";
const BONEMAP: str = "bonemap";
const CODE: str = "code";
const COMPLETE: str = "complete";
const DEBUGGER: str = "debugger";
const DOCS: str = "docs";
const INPUTVIEW: str = "inputview";
const MACHINE: str = "machine";
const MANAGER: str = "manager";
const PLUGINS: str = "plugins";
const PROBLEMS: str = "problems";
const REFACTOR: str = "refactor";
const RESIZED: str = "resized";
const TEXTEDIT: str = "textedit";
internal const ASSETS_CHANGED: str = "assets_changed";
internal const CODE_CHANGED: str = "code_changed";
internal const DEBUGGER_CHANGED: str = "debugger_changed";
internal const PLUGINS_CHANGED: str = "plugins_changed";
internal const PROBLEMS_CHANGED: str = "problems_changed";
internal const RECORDINGS: str = "recordings_changed";
internal const TIMELINE: str = "timeline_changed";

/// The document's outline, a lock, a warning or the selection moved.
event outline_changed;
/// What the Inspector's form is built from moved.
event inspector_changed;
/// What a dock's tab row and its panel are built from moved.
event docks_changed;
/// A frame of play went by.
event play_frame;
/// What the top bar is built from moved.
event chrome_changed;
/// What the status strip is built from moved.
event status_changed;
/// What the rail is built from moved.
event rail_changed;
/// What the stage's chrome is built from moved.
event stage_changed;

/// What one panel shows moved, one event for each of `panels()`.
event problems_changed;
event docs_changed;
event assets_changed;
event library_changed;
event tiles_changed;
event machine_changed;
event recordings_changed;
event debugger_changed;
event sheet_changed;
event picker_changed;
event manager_changed;
event textedit_changed;
event plugins_changed;
event inputview_changed;
event code_changed;
event complete_changed;
event refactor_changed;
event timeline_changed;
event weights_changed;
event bonemap_changed;

/// What a panel showing one thing of the Editor's listens for, as
/// `<what>_changed`: the Problems list, the Docs page, the files, the library,
/// the tile brush, the state machine, the recordings and the debugger.
fn panels() -> [str] {
    [
        PROBLEMS, DOCS, ASSETS, verbs::LIBRARY, tools::TILES, MACHINE, tabs::RECORDINGS, DEBUGGER,
        roles::SHEET, "picker", MANAGER, TEXTEDIT, PLUGINS, INPUTVIEW,
        CODE, COMPLETE, REFACTOR, verbs::TIMELINE, tabs::WEIGHTS, BONEMAP,
    ]
}

/// Have the Editor hear its own words, which is what clears the guard. Here
/// rather than in editor.bs, where `events` names the Events view's module.
pub fn hear_own(editor: Node) {
    for name in [OUTLINE, INSPECTOR, DOCKS, PLAY, CHROME, STATUS, RAIL, STAGE] {
        events::listen(editor, name, editor);
    }
    for what in panels() {
        events::listen(editor, "{what}_changed", editor);
    }
}

/// Have the Editor hear when one of the shell's boxes moved, which lays the
/// shell out again.
pub fn hear_boxes(state: editor::State, editor: Node) {
    for id in layout::watched() {
        let found = layout::box_node(state, id);
        if !util::is_nil(found) {
            events::listen(editor, RESIZED, found);
        }
    }
}

/// Have the Editor hear what the engine says from no node: a project file
/// reloaded, a script stopped or let go, a paste no field took, text or an
/// image, files dropped, and what the pointer did, which is when the
/// viewport's tools look at it.
pub fn hear_engine(editor: Node) {
    for word in [
        ASSETS_RELOADED, FILES_CHANGED, "debugger_stopped", "debugger_resumed", "pasted", "image_pasted",
        "pointer_moved", "pointer_pressed", "pointer_released", "pointer_scrolled", "pointer_gestured",
        "files_dropped",
    ] {
        events::listen(editor, word);
    }
}

/// Clear the guard on `name`, as the Editor hears it back.
pub fn heard(state: &mut editor::State, name: str) {
    state.told[name] = false;
}

fn tell(state: &mut editor::State, name: str) {
    let held = state.told[name];
    if held != nil && held.as_bool() {
        return;
    }
    state.told[name] = true;
    scene::get_node("Editor").emit(name);
}

/// The document, a lock or a warning moved: what a panel showing the
/// document's outline listens for, with the rows it holds out of date.
pub fn outline(state: &mut editor::State) {
    state.outline_rows += 1;
    tell(state, OUTLINE);
    bars(state);
}

/// Only the selection moved: the same word, with the rows as they were.
pub fn selected(state: &mut editor::State) {
    tell(state, OUTLINE);
    bars(state);
}

/// What the Inspector's form is built from beside the outline moved: the
/// workspace, the tool, play, the polygon being edited, the clip, the doc tab
/// or the screen's class. Called wherever one is written, so a write that
/// leaves it as it was says nothing.
pub fn inspector(state: &mut editor::State) {
    let polygon: any = state.polygon;
    let key: any = [
        state.workspace, state.tool, state.playing, polygon, "{state.clip}",
        state.shader_rel, state.doctab, state.compact, state.touchscreen,
    ];
    if key == state.inspector_key {
        return;
    }
    state.inspector_key = key;
    tell(state, INSPECTOR);
    bars(state);
}

/// The Inspector's whole form filled again, its key or not: a run of edits
/// its rows followed alone has stopped (`model::follow_changes`).
pub fn refill_inspector(state: &mut editor::State) {
    tell(state, INSPECTOR);
    bars(state);
}

/// A frame of play: every live value the Inspector and the state machine
/// show may have moved.
pub fn playing_frame(state: &mut editor::State) {
    tell(state, INSPECTOR);
    tell(state, PLAY);
    bars(state);
}

/// What a dock's tab row and its panel are built from moved: which panels
/// each dock holds and shows, a dock's width, the workspace (which names the
/// outline's tab), the screen's class, the Problems count, a plugin's dock,
/// and whether a recording is open, which the Recordings tab gives way to.
/// Called wherever one is written; a write that leaves the key says nothing.
pub fn docks(state: &mut editor::State) {
    let counts = lint::counts(state);
    // The text, not the map: a key holding `state.docks` itself is the map it is
    // compared against, and never differs from it.
    let key: any = [
        "{state.docks}", state.layout[dock_fields::LEFT][layout_fields::WIDTH], state.layout[dock_fields::RIGHT][layout_fields::WIDTH], state.layout[dock_fields::BOTTOM][layout_fields::WIDTH],
        state.workspace, state.compact, counts.errors + counts.warnings, state.registry.panels.len(),
        session::loaded(state),
    ];
    if key == state.docks_key {
        return;
    }
    state.docks_key = key;
    tell(state, DOCKS);
    bars(state);
}

/// Whether what the viewport's lines are drawn from beside the outline and
/// the Inspector's words moved: the tools' hover, a drag, the box select.
/// Asked after the pointer did something, and true whenever a drag is under
/// way or the pointer is over the stage, where a tool's lines follow it.
pub fn overlays_moved(state: &mut editor::State, over: bool) -> bool {
    let hot: any = viewport::hot_part(state);
    let marquee: any = state.gizmo.marquee;
    let rig: any = state.rig.hover;
    let pen: any = state.pen.hover;
    let tile: any = state.tiles.hover;
    let anchor: any = state.tiles.anchor;
    let polygon: any = state.polygon.hover;
    // Their text: a hover the state keeps as a map is the one the last key
    // held, and never differs from it.
    let key: any = "{[hot, marquee, rig, pen, tile, anchor, polygon]}";
    let moving = state.gizmo.drag != nil || state.camera_drag >= 0;
    if !over && !moving && key == state.overlays_key {
        return false;
    }
    state.overlays_key = key;
    true
}

/// What one panel shows moved, `what` being one of `panels()`: emitted as
/// `<what>_changed`, once a frame.
pub fn changed(state: &mut editor::State, what: str) {
    tell(state, "{what}_changed");
    bars(state);
}

/// The top bar, the status strip, the rail and the stage chrome are built
/// from what the other words cover and a little besides, so each of those
/// asks after both; each says only when its own key moved. Called where the
/// little besides is written.
pub fn bars(state: &mut editor::State) {
    chrome(state);
    status(state);
    rail(state);
    stage(state);
}

fn stage(state: &mut editor::State) {
    let key: any = center::stage_key(state);
    if key == state.stage_key {
        return;
    }
    state.stage_key = key;
    tell(state, STAGE);
}

fn rail(state: &mut editor::State) {
    let key: any = center::rail_key(state);
    if key == state.rail_key {
        return;
    }
    state.rail_key = key;
    tell(state, RAIL);
}

fn chrome(state: &mut editor::State) {
    let key: any = chrome::key(state);
    if key == state.chrome_key {
        return;
    }
    state.chrome_key = key;
    tell(state, CHROME);
}

fn status(state: &mut editor::State) {
    let key: any = chrome::status_key(state);
    if key == state.status_key {
        return;
    }
    state.status_key = key;
    tell(state, STATUS);
}
