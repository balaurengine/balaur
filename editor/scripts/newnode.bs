// The node picker: every preset and component, grouped by dimension tag, or
// what the selection can be changed to. A soft body asks what it is built
// from first. Esc, a scrim click or a pick closes it.

use editor;
use form;
use icons;
use model;
use pool;
use presets;
use recipes;
use search;
use style;
use textedit;
use util;
use window;
use words::fields;
use words::form_fields;
use words::hooks;
use words::inspector_fields;
use words::layout_fields;
use words::project_fields;
use words::roles;
use words::theme_tokens;

pub struct Entry {
    internal name: str,
    internal note: str,
    internal tags: str,
    internal group: str,
    internal preset: bool,
    internal label: str,
    internal parts: any,
}

// Group order, each a tag the engine already carries. A row is filed under
// the first group whose tag it has, so a `2d` `physics` preset lands in 2D
// rather than twice.
fn groups() -> [[str]] {
    [["3d", "3D"], ["2d", "2D"], ["ui", "UI"], ["physics", "Physics"], ["", "Other"]]
}

/// Which group a tag list belongs to: the first that matches, `Other` if none.
fn group_of(tags: [str]) -> str {
    for group in groups() {
        if group[0] == "" || util::contains(tags, group[0]) {
            return group[1];
        }
    }
    "Other"
}

fn entry(name: str, note: str, tags: [str], preset: bool) -> Entry {
    Entry { name: name, note: note, tags: util::join(tags, " "), group: group_of(tags), preset: preset, label: "", parts: nil }
}

// Asked once per opening rather than once per frame: the recipes are read
// from their files and the registry walked whole.
pub fn catalogue(state: &mut editor::State) -> [Entry] {
    if state.newnode_cache != nil {
        return state.newnode_cache.unwrap();
    }
    let rows = if state.newnode_soft != "" {
        recipes::soft_sources(state, state.newnode_soft == "2d")
    } else if state.newnode_change {
        changes(state)
    } else {
        everything(state)
    };
    state.newnode_cache = rows;
    rows
}

// What the selected node can become, filed like the presets it names.
fn changes(state: editor::State) -> [Entry] {
    let rows: [Entry] = [];
    for target in recipes::targets(state, state.selected) {
        rows.push(entry(target.name, target.note, target.tags, true));
    }
    rows
}

fn everything(state: editor::State) -> [Entry] {
    let rows: [Entry] = [];
    let named: [str] = [];
    for preset in presets::all(state) {
        rows.push(entry(preset.name, preset.description, preset.tags, true));
        named.push(preset.name);
    }
    // Components too, so a node can be made of one thing the presets do not
    // cover; `camera3d` has no preset and is still a node someone adds.
    for name in scene::component_types() {
        // `transform` is not a node to add: `add_child` has already given the
        // new node one, and every node in the tree carries it. A component a
        // preset is named for is that preset's row, once.
        if name == model::TRANSFORM || util::contains(named, name) {
            continue;
        }
        let tags = scene::component_tags(name);
        rows.push(entry(name, "", if tags != nil { tags.unwrap() } else { [] }, false));
    }
    rows
}

pub fn open(state: &mut editor::State) {
    state.newnode = true;
    state.newnode_query = "";
    state.newnode_cache = nil;
    state.newnode_change = false;
    state.newnode_soft = "";
    window::picker_changed(state);
}

/// The picker over what the selected node can be changed to.
pub fn open_change(state: &mut editor::State) {
    if !model::has_selection(state) {
        return;
    }
    open(state);
    state.newnode_change = true;
    window::picker_changed(state);
}

pub fn close(state: &mut editor::State) {
    state.newnode = false;
    state.newnode_change = false;
    state.newnode_soft = "";
    window::picker_shut(state);
}

pub fn place(state: &mut editor::State, row: Entry) {
    // A soft body is built from something, so it asks what before building:
    // unless a node being changed already draws a thing to build it from.
    let soft = recipes::soft_dimension(row.name);
    let drawn = state.newnode_change && recipes::soft_body_source(state, state.selected) != nil;
    if row.preset && soft != "" && !drawn {
        state.newnode_soft = soft;
        state.newnode_query = "";
        state.newnode_cache = nil;
        return;
    }
    if state.newnode_change {
        recipes::change_type(state, state.selected, row.name);
    } else {
        add(state, row.name);
    }
    close(state);
}

/// Add a node of `kind` under the selection: a text opens ready to type
/// over, its words selected.
pub fn add(state: &mut editor::State, kind: str) {
    model::add_child(state, kind);
    textedit::open_added(state);
}

// A source picked in the soft body's step: a new child built from it, or the
// node being changed rebuilt from it.
pub fn place_source(state: &mut editor::State, source: Entry) {
    if state.newnode_change {
        recipes::give_soft_body(state, state.selected, source);
    } else {
        recipes::add_soft_body(state, source);
    }
    close(state);
}

/// Fill the picker: what its script asks for while the node picker is up.
pub fn fill(state: &mut editor::State) {
    let row_height = util::max(style::row_height(state), 30.0);
    let specs = if state.newnode_soft != "" { source_specs(state, state.theme, row_height) } else { row_specs(state, state.theme, row_height) };
    let placeholder = if state.newnode_soft != "" {
        "Build the soft body from a shape or a file…"
    } else if state.newnode_change {
        let picked = model::selected_node(state);
        "Change {if picked.is_valid() { picked.name() } else { "the node" }} to…"
    } else {
        "Nodes, components, 2d, physics…"
    };
    let mark = if state.newnode_change { icons::ui("reset") } else { icons::ui(icons::ADD) };
    let host = window::picker(state, {
        layout_fields::WIDTH: 520.0,
        fields::MARK: mark,
        form_fields::PLACEHOLDER: placeholder,
        form_fields::QUERY: state.newnode_query,
        form_fields::ROWS_H: (specs.len() as float) * (row_height + 2.0) + 4.0,
        form_fields::ON_CHANGE: hooks::HANDLE,
        form_fields::ON_SUBMIT: hooks::HANDLE_SUBMIT,
        fields::DATA: { fields::FN: on_query_typed, project_fields::SUBMIT: on_query_submitted },
    });
    form::fill(host, specs);
}

fn on_query_typed(state: &mut editor::State, data: any, text: any) {
    state.newnode_query = text.as_str();
}

fn on_query_submitted(state: &mut editor::State, data: any, text: any) {
    state.newnode_query = text.as_str();
}

/// Every row the picker shows: the empty node ahead of the groups, then a
/// heading and its matches per group.
fn row_specs(state: &mut editor::State, tokens: any, row_height: float) -> [form::Row] {
    let query = state.newnode_query.to_lower();
    let rows = catalogue(state);
    let out: [form::Row] = [];
    // Ahead of the groups and in none of them: a node with no components has
    // no dimension to be filed under.
    if !state.newnode_change && (query == "" || "empty node".contains(query)) {
        out.push(row_spec(row_height, "Empty node  ·  a transform and nothing else", icons::node("world"), tokens[theme_tokens::TEXT_SUBTLE].as_str(), add_empty, {}));
    }
    for group in groups() {
        let title = group[1];
        let shown: [Entry] = [];
        for row in rows {
            // The tags join the haystack, so "physics" or "2d" narrows the
            // list even where the name does not say it.
            let haystack = (row.name + " " + row.note + " " + row.tags).to_lower();
            if row.group == title && (query == "" || haystack.contains(query)) {
                shown.push(row);
            }
        }
        if shown.len() == 0 {
            continue;
        }
        out.push(caption_row(title, 20.0, false));
        for row in shown {
            // The type's own mark and colour, the same pair the inspector and
            // the tree draw a component with.
            let mark = icons::component(row.name);
            let caption = if row.note == "" { row.name } else { row.name + "  ·  " + row.note };
            out.push(row_spec(row_height, caption, mark.glyph, tint_of(tokens, mark.token), place_row, { fields::ROW: row }));
        }
    }
    if out.len() == 0 {
        out.push(caption_row(search::nothing_says(state.newnode_query), 0.0, true));
    }
    out
}

fn caption_row(text: str, height: float, wrap: bool) -> form::Row {
    let label: ui::Control = ui::Control { kind: ui::WIDGET_LABEL, role: roles::TEXT_CAPTION, grow: 1, text: text, wrap: wrap };
    form::Row { height: height, controls: [label] }
}

// A component's own colour token, or the plain text colour.
fn tint_of(tokens: any, token: str) -> str {
    let tint = tokens[token];
    if tint == nil { tokens[theme_tokens::PRIMARY_TEXT].as_str() } else { tint.as_str() }
}

fn add_empty(state: &mut editor::State, _data: any, _value: any) {
    model::add_child(state);
    close(state);
}

fn place_row(state: &mut editor::State, data: any, _value: any) {
    let row: Entry = data[fields::ROW];
    place(state, row);
}

/// The soft body's second step: a shape, or a file in the project, to build
/// it from.
fn source_specs(state: &mut editor::State, tokens: any, row_height: float) -> [form::Row] {
    let query = state.newnode_query.to_lower();
    let out = [caption_row("Soft body from", 20.0, false)];
    for source in catalogue(state) {
        let caption = source.label + "  ·  " + source.note;
        if query != "" && !caption.to_lower().contains(query) {
            continue;
        }
        let keys = source.parts.keys();
        let mark = icons::component(if keys.len() > 0 { keys[0] } else { "" });
        out.push(row_spec(row_height, caption, mark.glyph, tint_of(tokens, mark.token), place_source_row, { inspector_fields::SOURCE: source }));
    }
    out
}

fn place_source_row(state: &mut editor::State, data: any, _value: any) {
    let source: Entry = data[inspector_fields::SOURCE];
    place_source(state, source);
}

// `icon_color` is the component's own mark colour, which is data rather than
// styling: the tree and the inspector draw the same pair.
fn row_spec(row_height: float, caption: str, mark: str, color: str, handler: fn(&mut editor::State, any, any), data: any) -> form::Row {
    let button = pool::on(ui::Control {
        kind: ui::WIDGET_BUTTON,
        role: roles::ITEM_PICKER,
        grow: 1,
        text: caption,
        icon: mark,
        icon_color: color,
    }, handler, data);
    form::Row { height: row_height, controls: [button] }
}
