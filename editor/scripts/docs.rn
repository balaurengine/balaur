// The Docs dock: the script reference, from the live engine rather than a
// file. A go-to-definition on `physics2d::raycast` lands here, because engine
// API has no source file to open.

use crate::search;
use crate::style;
use crate::util;

pub fn state() {
    #{ modules: (), pick: "", fn_pick: "" }
}

// Every module, parsed once per session: `script::api` rebuilds the whole
// reference on each call, which is not a per-frame cost worth paying.
fn modules(S) {
    if S.docs.modules is Vec {
        return S.docs.modules;
    }
    S.docs.pick = if S.docs.pick == "" { "engine" } else { S.docs.pick };
    let text = script::api();
    if text == "" {
        S.docs.modules = [];
        return S.docs.modules;
    }
    let parsed = util::obj(json::parse(text));
    S.docs.modules = parsed.get("modules").unwrap_or([]);
    S.docs.modules
}

/// Show a module's page, and one of its functions when named.
/// `shell::goto_definition` calls this when the definition is engine API.
pub fn show(S, module, name) {
    S.docs.pick = module;
    S.docs.fn_pick = name;
    crate::docks::show(S, "docs");
}

// The module the dock is showing, or the first that matches the filter.
fn current(S, list) {
    for m in list {
        if m.name == S.docs.pick {
            return Some(m);
        }
    }
    None
}

/// The module picker and a filter over its functions. In the body rather than
/// the tab row: the dock carries fourteen tabs, and these would sit on them.
fn controls(S, k, list) {
    ui::horizontal(#{ height: 24 }, || {
        ui::add_space(6);
        let names = [];
        for m in list {
            names.push(m.name);
        }
        let (picked, changed) = ui::dropdown("docs-module", S.docs.pick, names, #{
            width: 150, size: style::SM, height: 24, color: k.text,
        });
        if changed {
            S.docs.pick = picked;
            S.docs.fn_pick = "";
        }
        ui::add_space(6);
        search::field(S, k, "docs", "Search", 150.0);
    });
}

pub fn draw(S, k) {
    let list = modules(S);
    if list.len() == 0 {
        style::empty(k, "the engine reported no modules");
        return;
    }
    controls(S, k, list);
    let found = current(S, list);
    let m = match found {
        Some(m) => m,
        None => {
            style::empty(k, "pick a module");
            return;
        }
    };
    let query = search::query(S, "docs");
    let signatures = util::obj(m.signatures);
    let docs = util::obj(m.docs);
    let items = [];
    if m.doc != "" {
        items.push("\u{1f}" + m.doc + "\u{1f}\u{1f}" + k.dim);
    }
    let shown = 0;
    for name in m.functions {
        if !search::matches(query, name) {
            continue;
        }
        shown += 1;
        let picked = name == S.docs.fn_pick;
        let sig = signatures.get(name).unwrap_or("");
        items.push("\u{1f}" + name + sig + "\u{1f}\u{1f}" + if picked { k.accent } else { k.text });
        let doc = docs.get(name).unwrap_or("");
        if doc != "" {
            items.push("\u{1f}\t  " + doc + "\u{1f}\u{1f}" + k.faint);
        }
    }
    if query == "" {
        for c in m.constants {
            items.push("\u{1f}" + format!("{}  {}", c.name, c.value) + "\u{1f}\u{1f}" + k.faint);
        }
    }
    crate::dock::show_log(items);
    if shown == 0 && query != "" {
        search::nothing(k, query);
    }
}
