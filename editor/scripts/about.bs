// The About sheet: which build this is, the line it follows, and whether that
// line has moved on. The check and the install are the Engine tab's own, so
// the sheet and the start screen say the same thing.

use editor;
use manager;
use pool;
use util;
use window;

const SHEET: str = "about";

const SITE: str = "https://balaurengine.org";

const SOURCE: str = "https://github.com/balaurengine/balaur";

const LABEL_WIDTH: float = 96.0;

/// Show the sheet. Opening it is asking, so the feed is read once here unless
/// the start screen already read it.
pub fn open(state: &mut editor::State) {
    window::show(state, SHEET);
    if !state.manager.asked && !manager::in_tab() {
        manager::check(state);
    }
}

/// Fill the sheet: what its script asks for when About is up.
pub fn fill(state: &mut editor::State) {
    let hosts = window::sheet_form(state, SHEET, "About Balaur", []);
    if util::is_nil(hosts) {
        return;
    }
    let hosts = hosts.unwrap();
    pool::sync(state, hosts.form, specs(state), LABEL_WIDTH, false);
}

/// Every row the sheet shows: which build this is, the line it follows, and
/// where to read more.
fn specs(state: editor::State) -> [any] {
    let mine = util::map_or_empty(release::installed());
    let out: [any] = [
        {
            "full": true,
            "height": 56,
            "slot_role": "layout_actions",
            "controls": [
                {
                    "kind": "panel",
                    "role": "sheet_logo",
                    "controls": [
                        { "kind": "image", "image": manager::LOGO, "width": 44 },
                    ],
                },
                {
                    "kind": "column",
                    "role": "layout_about",
                    "controls": [
                        { "kind": "label", "role": "text_title", "text": "Balaur " + mine["version"].as_str() },
                        { "kind": "label", "role": "text_caption", "text": manager::build_line(mine) },
                    ],
                },
            ],
        },
    ];
    fact(out, "Version", mine["version"].as_str());
    fact(out, "Build", (if mine["source"].as_bool() == true { "from a checkout" } else { mine["id"] }).as_str());
    fact(out, "Channel", (if mine["channel"].as_str() == "" { "none" } else { mine["channel"] }).as_str());
    fact(out, "Platform", engine::target().os.as_str());
    fact(out, "License", "MIT");
    // A tab runs the build the page served it, so it has no line to follow.
    if !manager::in_tab() {
        update_rows(state, mine, out);
    }
    out.push({
        "full": true,
        "height": 30,
        "slot_role": "layout_actions",
        "controls": [
            link("balaurengine.org", SITE),
            link("Source", SOURCE),
        ],
    });
    out
}

// One label and its value, the value in the monospace a build id reads in.
fn fact(out: [any], name: str, value: str) {
    out.push({
        "full": false,
        "height": 22,
        "controls": [
            {
                "kind": "label",
                "role": "text_code",
                "grow": 1,
                "text": value,
            },
        ],
        "label": name,
    });
}

fn link(text: str, url: str) -> any {
    {
        "kind": "button",
        "role": "chip",
        "text": text,
        "tooltip": url,
        "on": "handle",
        "data": { "fn": on_link_clicked, "url": url },
    }
}

fn on_link_clicked(state: any, data: any, _value: any) {
    let url: str = data["url"];
    engine::open_url(url);
}

// Where this build's line stands, the press that asks again, and the newest
// release on it when there is one to move to; then what the check said and
// how far an install has got.
fn update_rows(state: editor::State, mine: any, out: [any]) {
    let tokens = state.theme;
    // A source build follows no line; the nightly is what it is nearest to.
    let line = if mine["channel"].as_str() == "" { "nightly" } else { mine["channel"] };
    let newest = manager::newest_on(state, line.as_str());
    let fresh = newest["order"].as_str() == "newer";
    let controls: [any] = [
        {
            "kind": "label",
            "role": "text_code",
            "font_size": 11,
            "grow": 1,
            "text": line.as_str() + ": " + manager::standing(state, line.as_str()),
            "text_color": (if fresh { tokens["success_text"] } else { tokens["text_subtle"] }).as_str(),
        },
    ];
    // Up to date already says it; only a release to move to gets a press.
    if newest["id"].as_str() != "" && newest["order"].as_str() != "same" {
        let press = manager::press_spec(state, newest, mine);
        if press.kind() == "map" {
            controls.push(press);
        }
    }
    controls.push({
        "kind": "button",
        "role": "action_form",
        "text": if state.manager.reading { "Checking" } else { "Check" },
        "on": "handle",
        "data": { "fn": on_check_clicked },
    });
    out.push({ "full": true, "height": 30, "slot_role": "layout_actions", "controls": controls });
    if mine["held"].as_str() != "" {
        out.push(say(mine["held"].as_str(), tokens["text_subtle"].as_str()));
    }
    let said = if state.manager.failed != "" { state.manager.failed } else { state.manager.note };
    if said != "" {
        out.push(say(said, (if state.manager.failed != "" { tokens["warning_text"] } else { tokens["text_subtle"] }).as_str()));
    }
    if manager::installing(state) {
        out.push({
            "full": true,
            "height": 22,
            "slot_role": "layout_actions",
            "controls": manager::progress_controls(state),
        });
    }
}

fn on_check_clicked(state: &mut editor::State, data: any, _value: any) {
    manager::check(state);
}

fn say(text: str, ink: str) -> any {
    {
        "full": true,
        "height": 0,
        "controls": [
            {
                "kind": "label",
                "role": "text_code_quiet",
                "font_size": 11,
                "grow": 1,
                "wrap": true,
                "text": text,
                "text_color": ink,
            },
        ],
    }
}
