// The About sheet: which build this is, the line it follows, and whether that
// line has moved on. The check and the install are the Engine tab's own, so
// the sheet and the start screen say the same thing.

use editor;
use form;
use manager;
use util;
use window;
use words::fields;
use words::general;
use words::inspector_fields;
use words::log_fields;
use words::roles;
use words::statuses;
use words::theme_tokens;

const SHEET: str = "about";
const URL: str = "url";

const SITE: str = "https://balaurengine.org";

const SOURCE: str = "https://github.com/balaurengine/balaur";

const LABEL_WIDTH: float = 96.0;

/// Show the sheet. Opening it is asking, so the feed is read once here unless
/// the start screen already read it.
pub fn open(state: &mut editor::State) {
    window::show(state, SHEET);
    if !state.manager.asked && !manager::in_tab() {
        manager::check(state);
    }
}

/// Fill the sheet: what its script asks for when About is up.
pub fn fill(state: &mut editor::State) {
    let hosts = window::sheet_form(state, SHEET, "About Balaur", []);
    if util::is_nil(hosts) {
        return;
    }
    let hosts = hosts.unwrap();
    form::fill(hosts.form, specs(state), LABEL_WIDTH, false);
}

/// Every row the sheet shows: which build this is, the line it follows, and
/// where to read more.
fn specs(state: editor::State) -> [form::Row] {
    let mine = util::map_or_empty(release::installed());
    let out: [form::Row] = [
        form::Row {
            height: 56,
            slot_role: roles::LAYOUT_ACTIONS,
            controls: [
                ui::Control {
                    kind: ui::WIDGET_PANEL,
                    role: roles::SHEET_LOGO,
                    controls: [
                        ui::Control { kind: ui::WIDGET_IMAGE, image: manager::LOGO, width: 44 },
                    ],
                },
                ui::Control {
                    kind: ui::WIDGET_COLUMN,
                    role: "layout_about",
                    controls: [
                        ui::Control { kind: ui::WIDGET_LABEL, role: roles::TEXT_TITLE, text: "Balaur " + mine[fields::VERSION].as_str() },
                        ui::Control { kind: ui::WIDGET_LABEL, role: roles::TEXT_CAPTION, text: manager::build_line(mine) },
                    ],
                },
            ],
        },
    ];
    fact(out, "Version", mine[fields::VERSION].as_str());
    fact(out, "Build", (if mine[inspector_fields::SOURCE].as_bool() == true { "from a checkout" } else { mine[fields::ID].as_str() }));
    fact(out, "Channel", (if mine[log_fields::CHANNEL].as_str() == "" { general::NONE } else { mine[log_fields::CHANNEL].as_str() }));
    fact(out, "Platform", engine::target().os);
    fact(out, "License", "MIT");
    // A tab runs the build the page served it, so it has no line to follow.
    if !manager::in_tab() {
        update_rows(state, mine, out);
    }
    out.push(form::Row {
        height: 30,
        slot_role: roles::LAYOUT_ACTIONS,
        controls: [
            link("balaurengine.org", SITE),
            link("Source", SOURCE),
        ],
    });
    out
}

// One label and its value, the value in the monospace a build id reads in.
fn fact(out: [form::Row], name: str, value: str) {
    out.push(form::Row {
        height: 22,
        controls: [
            ui::Control {
                kind: ui::WIDGET_LABEL,
                role: roles::TEXT_CODE,
                grow: 1,
                text: value,
            },
        ],
        label: name,
    });
}

fn link(text: str, url: str) -> ui::Control {
    ui::Control {
        kind: ui::WIDGET_BUTTON,
        role: roles::CHIP,
        text: text,
        tooltip: url,
        on_click: "handle",
        data: { fields::FN: on_link_clicked, URL: url },
    }
}

fn on_link_clicked(state: any, data: any, _value: any) {
    let url: str = data[URL].as_str();
    engine::open_url(url);
}

// Where this build's line stands, the press that asks again, and the newest
// release on it when there is one to move to; then what the check said and
// how far an install has got.
fn update_rows(state: editor::State, mine: any, out: [form::Row]) {
    let tokens = state.theme;
    // A source build follows no line; the nightly is what it is nearest to.
    let line = if mine[log_fields::CHANNEL].as_str() == "" { "nightly" } else { mine[log_fields::CHANNEL].as_str() };
    let newest = manager::newest_on(state, line);
    let fresh = newest[fields::ORDER].as_str() == statuses::NEWER;
    let controls: [ui::Control] = [
        ui::Control {
            kind: ui::WIDGET_LABEL,
            role: roles::TEXT_CODE,
            font_size: 11,
            grow: 1,
            text: line + ": " + manager::standing(state, line),
            text_color: (if fresh { tokens[theme_tokens::SUCCESS_TEXT] } else { tokens[theme_tokens::TEXT_SUBTLE] }).as_str(),
        },
    ];
    // Up to date already says it; only a release to move to gets a press.
    if newest[fields::ID].as_str() != "" && newest[fields::ORDER].as_str() != statuses::SAME {
        let press = manager::press_spec(state, newest, mine);
        if press != nil {
            controls.push(press.unwrap());
        }
    }
    controls.push(ui::Control {
        kind: ui::WIDGET_BUTTON,
        role: roles::ACTION_FORM,
        text: if state.manager.reading { "Checking" } else { "Check" },
        on_click: "handle",
        data: { fields::FN: on_check_clicked },
    });
    out.push(form::Row { height: 30, slot_role: roles::LAYOUT_ACTIONS, controls: controls });
    if mine[inspector_fields::HELD].as_str() != "" {
        out.push(say(mine[inspector_fields::HELD].as_str(), tokens[theme_tokens::TEXT_SUBTLE].as_str()));
    }
    let said = if state.manager.failed != "" { state.manager.failed } else { state.manager.note };
    if said != "" {
        out.push(say(said, (if state.manager.failed != "" { tokens[theme_tokens::WARNING_TEXT] } else { tokens[theme_tokens::TEXT_SUBTLE] }).as_str()));
    }
    if manager::installing(state) {
        out.push(form::Row {
            height: 22,
            slot_role: roles::LAYOUT_ACTIONS,
            controls: manager::progress_controls(state),
        });
    }
}

fn on_check_clicked(state: &mut editor::State, data: any, _value: any) {
    manager::check(state);
}

fn say(text: str, ink: str) -> form::Row {
    form::Row {
        height: 0,
        controls: [
            ui::Control {
                kind: ui::WIDGET_LABEL,
                role: roles::TEXT_CODE_QUIET,
                font_size: 11,
                grow: 1,
                wrap: true,
                text: text,
                text_color: ink,
            },
        ],
    }
}
