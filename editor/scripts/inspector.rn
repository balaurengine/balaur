// Inspector (308 px): live node properties, editable, per-persona sections.

use crate::anim;
use crate::icons;
use crate::model;
use crate::polygon;
use crate::rig;
use crate::shell;
use crate::style;
use crate::util;

const LABEL_W = 82.0;
// A section heading that folds its rows away on click. Returns whether the
// caller should draw them; the fold state lives on `S.collapsed` beside the
// tree's, under an `inspector/` key so the two never collide.
fn section(S, k, title) {
    let key = format!("inspector/{}", title);
    let open = !S.collapsed.contains_key(key);
    let (mark, tint) = icons::component(title.to_lowercase());
    fold_row(S, "section", open, title.to_uppercase(), mark,
        k.get(tint).unwrap_or(k.dim), || {
            if open {
                S.collapsed[key] = true;
            } else {
                S.collapsed.remove(key);
            }
        });
    open
}

/// A fold's heading, as a full-width row of two nodes: the caret, then the
/// title that toggles it. `role` names the three theme entries the row takes,
/// so a section and a subsection differ by their theme and nothing else.
fn fold_row(S, role, open, text, icon, icon_color, toggle) {
    fold_row_with(S, role, open, text, icon, icon_color, toggle, []);
}

/// A fold's heading with verbs of its own after it, for a section that can be
/// taken off the node.
fn fold_row_with(S, role, open, text, icon, icon_color, toggle, extra) {
    let controls = [
        #{
            kind: "label", role: role + "_caret",
            text: if open { icons::ui("caret-open") } else { icons::ui("caret-shut") },
        },
        #{
            kind: "button", role: role + "_head", grow: 1,
            text: text, icon: icon, icon_color: icon_color,
            on: |_| { toggle(); },
        },
    ];
    for one in extra {
        controls.push(one);
    }
    push(S, #{ full: true, height: row_h(S), slot_role: role + "_fold", controls: controls });
}

// The host the pool builds the rows on, and the hatch a drawn row names.
const FORM_NODE = "Editor/Shell/Body/Right/RightSheet/RightScroll/RightForm";
const ROW_HATCH = "draw_form_row";

/// A form row and the control inside it, taller where a finger picks them.
fn row_h(S) {
    style::row_h(S)
}

fn control_h(S) {
    if S.touchscreen { 29.0 } else { 20.0 }
}

// The rows this frame wants, and the closures the drawn ones run. Built as
// the sections walk the selection, then handed to `pool::sync` in one go.
fn open_form(S) {
    S.form = [];
    S.form_draws = [];
    S.form_cursor = 0;
}

fn push(S, spec) {
    let extra = S.get("row_after").unwrap_or(());
    if extra is Object && spec.contains_key("controls") {
        S.row_after = ();
        let controls = spec.controls;
        controls.push(extra);
    }
    S.form.push(spec);
}

/// Start and finish a form, for a panel other than the inspector that fills
/// the same pool: the right sheet has one, and one panel is up at a time.
pub fn open_pool(S) {
    open_form(S);
}

pub fn close_pool(S) {
    crate::pool::sync(S, FORM_NODE, S.form, label_w(S), stacked(S));
}

/// One labelled row of controls, for a panel describing its own form.
pub fn form_row(S, label, controls) {
    push(S, #{ label: label, controls: controls });
}




/// A property's value as its row draws it. `unit` is display only: the
/// component, the scene file and a script all hold what the schema declares,
/// and `min`, `max` and `step` are written in the unit shown.
fn shown_as(spec, v) {
    if spec.get("unit").unwrap_or("") == "degrees" { math::deg(v) } else { v }
}

/// The inverse of `shown_as`, for the value a row writes back.
fn stored_as(spec, v) {
    if spec.get("unit").unwrap_or("") == "degrees" { math::rad(v) } else { v }
}

/// A property's full label, and what its schema says it is under it.
fn prop_tip(prop, spec) {
    let label = util::prop_label(prop);
    let description = spec.get("description").unwrap_or("");
    if description == "" { label } else { label + "\n" + description }
}

/// A drawn row spanning both columns, for a heading or a note.
fn wide_row(S, height, body) {
    S.form_draws.push(body);
    push(S, #{ full: true, height: height, draw: ROW_HATCH });
}

/// Stop drawing the form, for a right dock showing something else.
pub fn hide_form() {
    crate::pool::hide(FORM_NODE);
}

/// Run the next drawn row. The pool draws its visible children in the order
/// they were pushed, so one cursor keeps the two in step.
///
/// A hatch can fire before the panel has described a single row — the frame a
/// dock is switched away from still draws what the last one left — so a
/// cursor past the end draws nothing rather than failing the frame.
pub fn draw_row(S) {
    let n = S.form_cursor;
    S.form_cursor = n + 1;
    let found = S.form_draws.get(n);
    if let Some(body) = found {
        body();
    }
}

// The label column, derived from the form: at a width neither column fits,
// the label gives way first and the control keeps a usable size.
fn label_w(S) {
    util::clamp(form_w(S) * 0.34, 46.0, LABEL_W)
}


// The form's own width, as its rows were last drawn: a frame late, like every
// box the layout reads back, and the sheet's inside until there is a frame.
fn form_w(S) {
    let host = scene::get_node(FORM_NODE);
    if !util::is_nil(host) {
        let r = ui::widget_rect(host);
        if !util::is_nil(r) && r.w > 0.0 {
            return r.w;
        }
    }
    S.layout.right.w - 16.0
}

// The control width the rows were drawn at. Under it the label goes above the
// control and each takes the whole row, as Godot's inspector does in a
// narrow dock.
const CONTROL_MIN = 180.0;

/// Whether a row puts its label above its control rather than beside it.
pub fn stacked(S) {
    form_w(S) - label_w(S) - 6.0 < CONTROL_MIN
}


// A row that came from a prefab says so, and says where an edit will land.
// The rows below belong to the active node; an edit reaches every selected
// node that carries the same component (`docs/PLAN-editor-ergonomics.md` §5).
fn multi_note(S) {
    let n = crate::selection::count(S);
    if n < 2 {
        return;
    }
    push(S, #{ full: true, height: row_h(S) + 4.0, controls: [#{
        kind: "panel", role: "multi_note", grow: 1,
        icon: icons::ui("select-all"),
        text: if S.compact {
            format!("{} nodes selected", n)
        } else {
            format!("{} nodes selected · editing applies to all", n)
        },
    }] });
}

fn instance_note(S, k) {
    let node = model::selected_node(S);
    if !model::is_instanced(node) {
        return;
    }
    // A prefab path is as long as the project makes it, so the column cuts it.
    push(S, #{ full: true, height: row_h(S) + 8.0, controls: [#{
        role: "note_box", grow: 1, controls: [
            #{
                kind: "label", role: "note_line", grow: 1,
                text: icons::ui("instance") + " from " + model::prefab_of(S, node),
            },
            #{
                kind: "button", role: "prefab_open", text: "open",
                tooltip: "Edit the prefab itself, for every instance of it",
                on: |_| { model::open_prefab(S); },
            },
        ],
    }] });
    push(S, #{ full: true, height: row_h(S), controls: [#{
        kind: "label", role: "meta", grow: 1,
        text: "edits become overrides on " + node.at,
    }] });
}

// An instance node's own row: which prefab it builds, and a way into it.
fn instance_source_row(S, k, node) {
    if !node.contains_key("instance") {
        return;
    }
    push(S, #{ label: "Instance", height: row_h(S), controls: [#{
        role: "prefab_box", grow: 1, controls: [
            #{ kind: "label", role: "prefab_name", grow: 1, truncate: true, text: node.instance },
            #{
                kind: "button", role: "prefab_open", text: "open",
                tooltip: "Edit the prefab itself, for every instance of it",
                on: |_| { model::open_prefab(S); },
            },
        ],
    }] });
}

// The script's path is a field: typing a name moves the file, and the
// picker beside it attaches one that already exists.
fn script_section(S, k, title) {
    let node = model::selected_node(S);
    if !section(S, k, title) {
        return;
    }
    let has = node.contains_key("script");
    push(S, #{ label: "Script", height: row_h(S), slot_role: "verb_row", controls: [
        #{
            kind: "field", role: "path_field", grow: 1,
            text: model::script_rel(node).unwrap_or(""),
            placeholder: "scripts/name.rn",
            on_submit: |text| { shell::set_script_path(S, text); },
        },
        #{
            kind: "dropdown", role: "pick", text: "pick",
            options: shell::script_files(S),
            on: |picked| { shell::set_script_path(S, picked); },
        },
    ] });
    let verbs = if has {
        [
            #{
                kind: "button", role: "row_action_on", text: "open",
                tooltip: "Edit it in the code pane",
                on: |_| { shell::set_persona(S, "script"); },
            },
            #{
                kind: "button", role: "row_action_warn", text: "remove",
                tooltip: "Detach the script from this node; the file stays",
                on: |_| { shell::detach_script(S); },
            },
        ]
    } else {
        [#{
            kind: "button", role: "row_action_on", text: icons::ui("add") + " new script",
            tooltip: "Write scripts/" + node.name.to_lowercase() + ".rn and attach it",
            on: |_| { shell::attach_script(S); },
        }]
    };
    verb_row(S, "", verbs);
    script_props_rows(S, k, node);
}

// What the script declares tunable, one row per export. A value differing
// from the default is the node's own; everything else is inherited, so a
// changed default reaches every node that left it alone.
fn script_props_rows(S, k, node) {
    let rel = match model::script_rel(node) {
        Some(rel) => rel,
        None => return,
    };
    let declared = model::exports(S, rel);
    if declared.is_empty() {
        return;
    }
    let props = model::script_props(node);
    wide_row(S, 20, || {
        style::section_label(k, "properties");
    });
    for export in declared {
        let overridden = props.contains_key(export.name);
        let value = if overridden { props[export.name] } else { export["default"] };
        // The export row *is* a spec, in the schema's own vocabulary, so the
        // rows a script declares reach the same editors a component's do:
        // an enum gets the dropdown, a node the picker, an asset the row.
        let spec = util::copy(export);
        spec.remove("name");
        // Rune has no computed key in an object literal, and `prop_row`
        // reads the value out of a table by name.
        let data = #{};
        data[export.name] = value;
        prop_row(S, k, SCRIPT_PROPS, export.name, spec, data);
        if overridden {
            let name = export.name;
            let back = export["default"];
            push(S, #{ label: "", height: 22, controls: [#{
                kind: "button", height: control_h(S), text: "reset", role: "chip", width: 52,
                tooltip: "Back to the script's default",
                on: |_| { model::set_script_prop(S, name, back); },
            }] });
        }
    }
}

// Save as file promotes the inline definition to `animations/<node>.toml`,
// Make inline copies a file back onto the node; neither touches the clip itself.
fn clip_source_row(S, k, node) {
    let path = anim::library_path(node);
    let inline = path.is_none();
    // The clip's file: a library path is longer than the row, so it is cut.
    push(S, #{ label: "Source", height: row_h(S), slot_role: "verb_row", controls: [
        #{ kind: "label", role: "readonly_value", grow: 1, truncate: true, text: path.unwrap_or("— inline —") },
        #{
            kind: "button", role: "clip_verb",
            text: if inline { "save as file" } else { "make inline" },
            tooltip: if inline {
                "Write this clip to animations/ and reference it"
            } else {
                "Copy this file's clip onto the node"
            },
            on: |_| {
                if inline {
                    anim::promote(S);
                } else {
                    anim::make_inline(S);
                }
            },
        },
    ] });
}

// Godot's two rest-pose verbs, for a node with bones under it (or a bone).
fn skeleton_section(S, k) {
    let (node, found) = model::selected(S);
    if found.is_none() {
        return;
    }
    let count = rig::bone_count(S, S.sel);
    if count == 0 && S.mode2d {
        return;
    }
    if !section(S, k, "Skeleton") {
        return;
    }
    let what = if rig::is_bone(node) { "this bone and below" } else { format!("under {}", node.name) };
    // The node's own name is in the line, so the column cuts it.
    verb_row(S, "Bones", [
        #{ kind: "label", role: "value", grow: 1, truncate: true, text: format!("{} · {}", count, what) },
        #{
            kind: "button", role: "row_action_on", text: icons::ui("add") + " bone",
            tooltip: "Grow a bone under this node (in 2D, the Rig bone tool places one by clicking)",
            on: |_| {
                if let Some(found) = model::live(S, S.sel) {
                    let p = found.transform.global_position();
                    rig::add_bone(S, S.sel, p.x, p.y + 1.0);
                }
            },
        },
    ]);
    if count == 0 {
        return;
    }
    verb_row(S, "Rest pose", [
        #{
            kind: "button", role: "row_action", text: "reset",
            tooltip: "Reset to Rest Pose: pose every bone here at its rest",
            on: |_| { rig::apply_rest(S); },
        },
        #{
            kind: "button", role: "row_action_sage", text: "overwrite",
            tooltip: "Overwrite Rest Pose: the pose every bone is in now becomes its rest",
            on: |_| { rig::overwrite_rest(S); },
        },
    ]);
    let mirrors = [];
    for over in ["x", "y"] {
        // Bound afresh: a closure made in a loop captures the binding.
        let axis = over;
        mirrors.push(#{
            kind: "button", role: "row_action", text: axis,
            tooltip: format!("Reflect every bone's rest over this node's {} axis, and hand each bone's rest to the one whose name differs by a side", axis),
            on: |_| { rig::mirror(S, axis); },
        });
    }
    verb_row(S, "Mirror", mirrors);
    let built = node.contains_key("ragdoll");
    let ragdoll = [#{
        kind: "button", role: "row_action_sage",
        text: if built { "rebuild" } else { "physical bones" },
        tooltip: "Create Physical Skeleton: a body and a capsule per bone, hinged to its parent's, driven back onto the rig by the ragdoll component's blend",
        on: |_| { rig::physical_bones(S); },
    }];
    if built {
        ragdoll.push(#{ kind: "label", role: "meta", grow: 1, text_align: "end", text: "blend below" });
    }
    verb_row(S, "Ragdoll", ragdoll);
}

/// A labelled row of verbs, spaced the way the theme spaces a row of them.
fn verb_row(S, label, controls) {
    push(S, #{ label: label, height: row_h(S), slot_role: "verb_row", controls: controls });
}

// What the Polygon tool works on: the vertex and polygon counts, the rig's
// bones to paint with, and the brush.
fn polygon_section(S, k) {
    let node = model::selected_node(S);
    if polygon::component(node).is_none() {
        return;
    }
    let occluding = polygon::occluding(S);
    if !section(S, k, if occluding { "Occluder" } else { "Polygon" }) {
        return;
    }
    let mesh = match polygon::mesh(S) {
        Some(mesh) => mesh,
        None => {
            push(S, #{ label: "Mesh", height: row_h(S), controls: [#{
                kind: "label", role: "meta", grow: 1,
                text: if polygon::editable(S) {
                    "empty — trace it with the Polygon tool"
                } else {
                    "a file; make it inline to edit"
                },
            }] });
            return;
        }
    };
    let positions = util::vec(mesh.get("positions").unwrap_or([]));
    let internal = polygon::internal_count(mesh);
    push(S, #{ label: "Vertices", height: row_h(S), controls: [#{
        kind: "label", role: "value", grow: 1,
        text: format!("{} · {} internal", positions.len(), internal),
    }] });
    // An occluder is the outline and nothing else: no triangles, no rig, no
    // brush. Its one row is the count above.
    if occluding {
        return;
    }
    let drawn = util::vec(mesh.get("polygons").unwrap_or([])).len();
    let polygons = [#{
        kind: "label", role: "value", grow: 1,
        text: if drawn == 0 { "outline, automatic" } else { format!("{} drawn", drawn) },
    }];
    if drawn > 0 {
        polygons.push(#{
            kind: "button", role: "row_action", text: "clear",
            tooltip: "Back to filling the outline automatically",
            on: |_| { polygon::clear_polygons(S); },
        });
    }
    verb_row(S, "Polygons", polygons);
    verb_row(S, "Trace", [
        #{
            kind: "button", role: "row_action_sage", text: "from alpha",
            tooltip: "Walk the texture's alpha and write the outline it finds as this polygon's points, replacing what is here",
            on: |_| { polygon::trace(S); },
        },
        #{
            kind: "drag_value", grow: 1, value: S.polygon.tolerance,
            step: 0.1, min: 0.0, max: 64.0, placeholder: "px",
            on: |v| { S.polygon.tolerance = v; },
        },
    ]);
    let mirrors = [];
    for over in ["x", "y"] {
        let axis = over;
        mirrors.push(#{
            kind: "button", role: "row_action", text: axis,
            tooltip: format!("Reflect the picked vertices over this node's {} axis, and hand each bone's weights to the bone whose name differs by a side", axis),
            on: |_| { polygon::mirror(S, axis); },
        });
    }
    mirrors.push(#{
        kind: "label", role: "meta", grow: 1, text_align: "end",
        text: if polygon::has_pick(S) {
            format!("{} picked", polygon::picked(S).len())
        } else {
            "whole mesh"
        },
    });
    verb_row(S, "Mirror", mirrors);
    if S.persona == "anim" {
        let deformed = polygon::deformed(S);
        verb_row(S, "Deform", [
            #{
                kind: "button", role: "row_action_on", text: "key",
                tooltip: "Key every vertex's offset from its authored position on the armed clip, at the playhead",
                on: |_| { polygon::key_deform(S); },
            },
            #{
                kind: "button", role: "row_action", text: "clear",
                tooltip: "Put every vertex back on its authored position",
                on: |_| { polygon::clear_deform(S); },
            },
            #{
                kind: "label", grow: 1, text_align: "end",
                role: if deformed { "answer_on" } else { "meta" },
                text: if deformed { "deformed" } else { "at rest" },
            },
        ]);
    }
    verb_row(S, "Bones", [#{
        kind: "button", role: "row_action_sage", text: "sync to rig",
        tooltip: "Sync Bones to Polygon: list the rig's bones, keeping weights already painted",
        on: |_| { polygon::sync_bones(S); },
    }]);
    for (n, bone) in polygon::bones(S).iter().enumerate() {
        // Bound afresh: a closure made in a loop captures the binding.
        let at = n;
        let held = bone;
        push(S, #{ full: true, height: row_h(S), controls: [#{
            kind: "button", grow: 1, text: held.path, icon: "⋈",
            role: if S.polygon.bone == Some(at) { "bone_row_on" } else { "bone_row" },
            tooltip: "Paint this bone's weights in the Weights mode",
            on: |_| { S.polygon.bone = Some(at); },
        }] });
    }
    verb_row(S, "Brush", [
        #{
            kind: "drag_value", grow: 1, value: S.polygon.radius,
            step: 0.5, min: 2.0, max: 400.0, placeholder: "px",
            on: |v| { S.polygon.radius = v; },
        },
        #{
            kind: "drag_value", grow: 1, value: S.polygon.strength,
            step: 0.01, min: 0.01, max: 2.0, placeholder: "×",
            on: |v| { S.polygon.strength = v; },
        },
    ]);
}

// The clip belongs to the player: the selection or its nearest animated
// ancestor, so a bone shows the character's clip, not one of its own.
fn animation_section(S, k) {
    let (node, _, _) = anim::player(S);
    if !section(S, k, "Animation") {
        return;
    }
    let def = match anim::definition(S) {
        Some(def) => def,
        None => {
            push(S, #{ label: "Clip", height: row_h(S) + 6.0, controls: [#{
                kind: "button", role: "make_row", grow: 1,
                text: icons::ui("add") + " Create clip",
                on: |_| { anim::ensure_clip(S); },
            }] });
            return;
        }
    };
    // The clip and the rate are `animation.autoplay` and `animation.speed`,
    // edited in the player's own ANIMATION section rather than twice.
    clip_source_row(S, k, node);
    // No `min`: a `drag_value` runs free only while `min` and `max` are both
    // left at 0 and 1, and naming one would clamp the clip to the other.
    push(S, #{ label: "Length", height: row_h(S), controls: [#{
        kind: "drag_value", grow: 1, value: anim::length(def),
        step: 0.01, suffix: " s",
        on: |v| {
            def.length = util::max(0.1, v);
            anim::touch(S);
        },
    }] });
    // The engine's own vocabulary, not a boolean: pingpong is a third answer
    // and a toggle cannot say it.
    push(S, #{ label: "Loop", height: row_h(S), controls: [#{
        kind: "dropdown", grow: 1,
        text: def.get("loop").unwrap_or(animation::LOOP_NONE),
        options: [animation::LOOP_NONE, animation::LOOP_LOOP, animation::LOOP_PINGPONG],
        on: |v| {
            def["loop"] = v;
            anim::touch(S);
        },
    }] });
    push(S, #{ label: "Keys", height: row_h(S), controls: [#{
        kind: "label", role: "value", grow: 1,
        text: format!("{} on {} tracks", anim::key_count(def), anim::tracks(def).len()),
    }] });
}

// Interface persona: the real surface is the `ui` scripting module.
fn interface_section(S, k) {
    let node = model::selected_node(S);
    if !section(S, k, "Interface") {
        return;
    }
    let draws = model::draws_ui(S, node);
    push(S, #{ label: "Draws UI", height: row_h(S), controls: [#{
        kind: "label", grow: 1,
        role: if draws { "answer_yes" } else { "answer_no" },
        text: if draws { "yes · draw_ui()" } else { "no" },
    }] });
    if !S.chip_state.contains_key("ui") {
        S.chip_state["ui"] = #{};
    }
    let chips = S.chip_state["ui"];
    push(S, #{ label: "Safe area", height: row_h(S), controls: [#{
        kind: "switch", role: "switch",
        checked: chips.get("safe").unwrap_or(false) == true,
        on: |on| { chips.safe = on; },
    }] });
}

// Write an inline definition to its type's directory and point the property at
// the project-relative path — an absolute one would not survive another machine.
fn promote_asset(S, at, asset_type, dir, reference) {
    let node = S.doc[S.sel];
    let (ok, definition) = script::attempt(|| assets::load(reference));
    if !ok || !(definition is Object) {
        log::warn(format!("cannot read the inline {}: {:?}", asset_type, definition));
        return;
    }
    definition["type"] = asset_type;
    let rel = format!("{}/{}.toml", dir, node.name.to_lowercase());
    let (written, err) = script::attempt(|| assets::save(S.game_root + "/" + rel, definition));
    if !written {
        log::warn(format!("cannot write {}: {:?}", rel, err));
        return;
    }
    write_at(S, at, rel);
    log::info(format!("saved {}", rel));
}

// Copy a file's definition onto the node, so the scene owns it outright.
// `duplicate` reads past the cache, which is what makes the copy private
// rather than a second name for the shared one.
fn inline_asset(S, at, reference) {
    let (ok, copy) = script::attempt(|| assets::duplicate(S.game_root + "/" + reference));
    if !ok || !(copy is Object) {
        log::warn(format!("cannot inline {}: {:?}", reference, copy));
        return;
    }
    write_at(S, at, copy);
    log::info(format!("{} is now inline on {}", reference, S.doc[S.sel].name));
}

fn as_text(value) {
    if value is String {
        value
    } else if value is Tuple || value is Vec || value is Object {
        // A list has no text form, and a field is not where one is edited.
        ""
    } else {
        // `{:?}`: a value with no display of its own must not take the
        // inspector's whole draw down.
        format!("{:?}", value)
    }
}

// Where an editor writes: the component or script, the property, and the steps
// into its value. `whole` is the fallback where nothing live answers.
pub fn at_top(comp, prop, whole) {
    #{ comp: comp, prop: prop, path: [], label: util::prop_label(prop), whole: whole }
}

pub fn at_step(at, step, label) {
    let path = at.path.clone();
    path.push(step);
    #{ comp: at.comp, prop: at.prop, path: path, label: label, whole: at.whole }
}


/// A row's label, and what its spec says it is under it.
fn row_tip(at, spec) {
    let description = spec.get("description").unwrap_or("");
    if description == "" { at.label } else { at.label + "\n" + description }
}

/// The property's value as it stands now, so one entry's edit keeps the
/// rest: the row was built before the edit and holds what it started from.
fn current_whole(S, at) {
    if at.comp == SCRIPT_PROPS {
        let props = model::script_props(S.doc[S.sel]);
        let found = props.get(at.prop);
        let held = match found {
            Some(found) => found,
            None => at.whole,
        };
        return held;
    }
    read_now(S, at.comp, at.prop, at.whole)
}

/// What sits at a cursor now, for an editor rebuilding a value one part at a
/// time.
fn held_now(S, at, fallback) {
    let whole = current_whole(S, at);
    let found = inner_at(whole, at.path, at.path.len());
    match found {
        Some(found) => found,
        None => fallback,
    }
}

/// The value `path`'s first `depth` steps lead to, or `None` where a step
/// names nothing.
fn inner_at(holder, path, depth) {
    let found = holder;
    for i in 0..depth {
        let step = path[i];
        if found is Vec {
            if !(step is i64) || step < 0 || step >= found.len() as i64 {
                return None;
            }
            found = found[step];
        } else if found is Object {
            let inner = found.get(step);
            found = match inner {
                Some(inner) => inner,
                None => return None,
            };
        } else {
            return None;
        }
    }
    Some(found)
}

/// An edit at a cursor: the whole property is written, with this one part of
/// it replaced, because a write takes a property whole.
pub fn write_at(S, at, value) {
    if at.path.is_empty() {
        write(S, at.comp, at.prop, value);
        return;
    }
    let whole = util::deep(current_whole(S, at));
    let holder = inner_at(whole, at.path, at.path.len() - 1);
    let step = at.path[at.path.len() - 1];
    match holder {
        Some(holder) => {
            holder[step] = value;
        }
        None => return,
    }
    write(S, at.comp, at.prop, whole);
}

/// Take one entry out of the list or map the cursor names.
pub fn drop_entry(S, at, step) {
    let whole = util::deep(current_whole(S, at));
    let holder = inner_at(whole, at.path, at.path.len());
    match holder {
        Some(holder) => {
            holder.remove(step);
        }
        None => return,
    }
    write(S, at.comp, at.prop, whole);
}

/// Add one entry to the list or map the cursor names, at the spec's own
/// default: `complete_property` wrote one in for every nested spec.
pub fn add_entry(S, at, of, key) {
    let fresh = of.get("default").unwrap_or("");
    let whole = util::deep(current_whole(S, at));
    let holder = inner_at(whole, at.path, at.path.len());
    match holder {
        Some(holder) => {
            if holder is Vec {
                holder.push(fresh);
            } else {
                holder[key] = fresh;
            }
        }
        None => return,
    }
    write(S, at.comp, at.prop, whole);
}

/// A key no entry of this map holds yet, so adding twice adds two.
fn fresh_key(held, numbered) {
    let n = 0;
    let key = if numbered { "0" } else { "key" };
    while held.contains_key(key) {
        n += 1;
        key = if numbered { format!("{}", n) } else { format!("key{}", n) };
    }
    key
}

/// Draw `body` with a control after it that takes `step` out of the list or
/// map at `at`, so an entry is removable whichever editor draws it.
fn with_remove(S, at, step, body) {
    let held = S.get("row_after").unwrap_or(());
    S.row_after = #{
        kind: "button", text: icons::ui("close"), role: "chip",
        width: 22, height: control_h(S), tooltip: "Take this one out",
        on: |_| { drop_entry(S, at, step); },
    };
    body();
    S.row_after = held;
}

// The `comp` an editor is given when it is editing a script's exported
// property rather than a component. No component can be named this — a
// component name is an identifier — so the two never collide.
const SCRIPT_PROPS = "script/props";

// Where an edited value goes. Every editor writes through here, so the same
// editors serve components and script properties both.
fn write(S, comp, prop, value) {
    if comp == SCRIPT_PROPS {
        model::set_script_prop(S, prop, value);
        return;
    }
    model::set_component_prop(S, comp, prop, value);
    // The clip the Timeline holds was named by the value just written, so the
    // cache goes and the engine is handed the clip again.
    if comp == "animation" {
        S.clip = None;
        anim::arm(S);
    }
}

// A set drawn from the schema's `options`: one pill per option, filled when
// held. A checkbox grid in everything but the shape of the control.
fn edit_flags(S, k, at, spec, value) {
    let held = util::vec(value);
    let controls = [];
    for option in util::vec(spec.get("options").unwrap_or([])) {
        // Bound afresh: a closure made in a loop captures the binding, and the
        // loop's own moves on to the next option.
        let name = option;
        let on = util::contains(held, name);
        controls.push(#{
            kind: "button", text: name, role: if on { "flag_on" } else { "flag" },
            on: |_| {
                let next = [];
                for other in held {
                    if other != name {
                        next.push(other);
                    }
                }
                if !on {
                    next.push(name);
                }
                write_at(S, at, next);
            },
        });
    }
    push(S, #{
        label: at.label, tooltip: row_tip(at, spec),
        controls: controls,
    });
}

// Another node, by path. The field takes what a scene file takes; the
// dropdown lists every node in the document as an absolute path, which is
// what a leading `/` means to the engine's resolver.
fn edit_node(S, k, at, spec, value) {
    let paths = ["— none —"];
    for node in S.doc {
        paths.push("/" + model::node_path(S.doc, node));
    }
    push(S, #{
        label: at.label, tooltip: row_tip(at, spec),
        height: row_h(S), slot_role: "verb_row",
        controls: [
            #{
                kind: "field", grow: 1, text: as_text(value), placeholder: "— none —",
                on_submit: |text| { write_at(S, at, text); },
            },
            #{
                kind: "dropdown", role: "pick", text: "pick", options: paths,
                on: |picked| {
                    write_at(S, at, if picked == "— none —" { "" } else { picked });
                },
            },
        ],
    });
}

// One editor per schema datatype, looked up rather than branched on, so a
// plugin can register an editor for a datatype the editor has never heard of.
fn editors() {
    #{
        "float": edit_float,
        "int": edit_int,
        "bool": edit_bool,
        "enum": edit_enum,
        "vec2": edit_vector,
        "vec3": edit_vector,
        "vec4": edit_vector,
        "color": edit_color,
        "asset": edit_asset,
        "flags": edit_flags,
        "node": edit_node,
        "list": edit_list,
        "map": edit_map,
        "record": edit_record,
    }
}

// A list: what it holds and how many, then a row an entry, each drawn by the
// editor its `of` spec asks for and each removable.
fn edit_list(S, k, at, spec, value) {
    let held = util::vec(value);
    let of = util::obj(spec.get("of").unwrap_or(#{}));
    holder_row(S, k, at, spec, format!("{} · {}", of.get("type").unwrap_or("?"), held.len()), || {
        add_entry(S, at, of, "");
    });
    for i in 0..held.len() {
        let index = i;
        let inner = at_step(at, index, format!("{}", index));
        with_remove(S, at, index, || {
            draw_value(S, k, inner, of, held[index]);
        });
    }
}

// A map: the same, with each row labelled by its key. A key is renamed by
// taking the entry out and adding it again, which is what keeps the row one
// control wide.
fn edit_map(S, k, at, spec, value) {
    let held = util::obj(value);
    let of = util::obj(spec.get("of").unwrap_or(#{}));
    let numbered = spec.get("key").unwrap_or("string") == "int";
    let keys = util::keys_sorted(held);
    holder_row(S, k, at, spec, format!("{} · {}", of.get("type").unwrap_or("?"), keys.len()), || {
        add_entry(S, at, of, fresh_key(held, numbered));
    });
    for key in keys {
        let step = key;
        let inner = at_step(at, step, step);
        with_remove(S, at, step, || {
            draw_value(S, k, inner, of, held[step]);
        });
    }
}

// A record: one row a declared field, each of its own type. The fields are
// the schema's, so there is nothing to add or take away.
fn edit_record(S, k, at, spec, value) {
    let held = util::obj(value);
    let fields = util::obj(spec.get("fields").unwrap_or(#{}));
    let names = util::keys_sorted(fields);
    // A record naming a class says which: the rows are its fields, and the
    // script is handed that class back.
    let note = match spec.get("class") {
        Some(class) => format!("{} · {}", class, names.len()),
        None => format!("{} fields", names.len()),
    };
    holder_row(S, k, at, spec, note, ());
    for name in names {
        let field = name;
        let of = util::obj(fields[field]);
        let inner = at_step(at, field, util::prop_label(field));
        let now = match held.get(field) {
            Some(now) => now,
            None => of.get("default").unwrap_or(""),
        };
        draw_value(S, k, inner, of, now);
    }
}

// What a composite says about itself before its rows: the label, what it
// holds, and where an `add` is one of the things it takes.
fn holder_row(S, k, at, spec, note, add) {
    let controls = [#{ kind: "label", grow: 1, text: note, role: "meta" }];
    // Unit is the empty tuple, which is what a record passes: its fields are
    // the schema's and there is nothing to add.
    if !(add is Tuple) {
        controls.push(#{
            kind: "button", text: icons::ui("add"), role: "chip",
            width: 22, height: control_h(S), tooltip: "Add one",
            on: |_| { add(); },
        });
    }
    push(S, #{ label: at.label, tooltip: row_tip(at, spec), controls: controls });
}

/// One property, in whichever of the two rows its spec asks for.
fn property_row(S, k, comp, prop, spec, data) {
    if spec.get("readonly").unwrap_or(false) == true {
        readonly_row(S, prop, spec, data);
    } else {
        prop_row(S, k, comp, prop, spec, data);
    }
}

/// A fold inside a component section, for the properties a schema files under
/// a `group`. Shut to begin with -- a property is grouped precisely because it
/// is not one of the handful worth the room -- so the state kept is which ones
/// were opened, not which were shut.
fn subsection(S, comp, group, count) {
    let key = format!("{}/{}", comp, group);
    // A search reaches into the folds: a property nobody can see is one the
    // box cannot find.
    let open = S.opened.contains_key(key)
        || crate::search::query(S, "inspector") != "";
    fold_row(S, "subsection", open,
        format!("{} · {}", util::prop_label(group), count), "", "", || {
            if open {
                S.opened.remove(key);
            } else {
                S.opened[key] = true;
            }
        });
    open
}

fn prop_row(S, k, comp, prop, spec, data) {
    let value = match data.get(prop) {
        Some(value) => value,
        None => spec.get("default").unwrap_or(()),
    };
    draw_value(S, k, at_top(comp, prop, value), spec, value);
}

/// One value at a cursor, drawn by whatever its spec asks for. A composite
/// calls back into this for what it holds, so a list of colours is a row of
/// colour editors and nothing had to know both.
fn draw_value(S, k, at, spec, value) {
    // A plugin's editor for this datatype wins over the built-in, which is
    // what lets a project draw a curve or a colour ramp its own way.
    match crate::plugins::editor(S, spec["type"]) {
        Some(draw) => {
            draw(S, k, at, spec, value);
            return;
        }
        None => (),
    }
    let editor = match editors().get(spec["type"]) {
        Some(editor) => editor,
        None => edit_text,
    };
    editor(S, k, at, spec, value);
}

// The schema's `min` and `max` as the write must respect them. The control
// itself drags free: a clamp on the widget makes a value unreachable by
// typing, which is how a range is escaped when a scene wants one.
fn clamped(spec, v) {
    let out = v;
    // Rune rejects `if let Some(x) = x`: the binding is in scope before the
    // scrutinee is read, so the name has to differ.
    let floor = spec.get("min");
    if let Some(value) = floor {
        out = util::max(util::f(value), out);
    }
    let ceiling = spec.get("max");
    if let Some(value) = ceiling {
        out = util::min(util::f(value), out);
    }
    out
}

fn number_of(value) {
    if value is Tuple { 0.0 } else { util::f(value) }
}

fn edit_float(S, k, at, spec, value) {
    push(S, #{ label: at.label, tooltip: row_tip(at, spec), controls: [#{
        kind: "drag_value", grow: 1,
        value: shown_as(spec, number_of(value)),
        step: spec.get("step").unwrap_or(0.02),
        on: |v| { write_at(S, at, stored_as(spec, clamped(spec, v))); },
    }] });
}

fn edit_int(S, k, at, spec, value) {
    push(S, #{ label: at.label, tooltip: row_tip(at, spec), controls: [#{
        kind: "drag_value", grow: 1,
        value: number_of(value),
        step: spec.get("step").unwrap_or(1.0),
        on: |v| { write_at(S, at, math::round(clamped(spec, v)) as i64); },
    }] });
}

fn edit_bool(S, k, at, spec, value) {
    push(S, #{ label: at.label, tooltip: row_tip(at, spec), controls: [#{
        kind: "check", text: "",
        checked: value == true,
        on: |on| { write_at(S, at, on); },
    }] });
}

fn edit_enum(S, k, at, spec, value) {
    push(S, #{ label: at.label, tooltip: row_tip(at, spec), controls: [#{
        kind: "dropdown", grow: 1,
        text: as_text(value),
        options: util::vec(spec.get("options").unwrap_or([])),
        on: |picked| { write_at(S, at, picked); },
    }] });
}

// A swatch that opens egui's picker, and the channels beside it: a colour is
// the one vector nobody reads as numbers.
fn edit_color(S, k, at, spec, value) {
    let held = util::vec(value);
    let text = format!("{} {} {} {}",
        fixed(channel(held, 0, 1.0), 2), fixed(channel(held, 1, 1.0), 2),
        fixed(channel(held, 2, 1.0), 2), fixed(channel(held, 3, 1.0), 2));
    push(S, #{ label: at.label, tooltip: row_tip(at, spec), controls: [
        #{ kind: "color", width: 34, color: held, on: |rgba| { write_at(S, at, rgba); } },
        #{ kind: "label", grow: 1, text: text, role: "meta" },
    ] });
}

fn channel(v, i, fallback) {
    match v.get(i) {
        Some(x) => util::f(x),
        None => fallback,
    }
}

// vec2 and vec3 are one editor: a drag value a component, differing only in
// how many and what they are lettered.
fn edit_vector(S, k, at, spec, value) {
    let datatype = spec["type"];
    let held = util::vec(value);
    let wide = datatype == "color" || datatype == "vec4";
    let count = if wide { 4 } else if datatype == "vec2" { 2 } else { 3 };
    let letters = if datatype == "color" { ["r", "g", "b", "a"] } else { ["x", "y", "z", "w"] };
    let fallback = if datatype == "color" { 1.0 } else { 0.0 };
    let controls = [];
    for i in 0..count {
        let slot = i;
        controls.push(#{
            kind: "drag_value", grow: 1,
            value: shown_as(spec, channel(held, slot, fallback)),
            step: spec.get("step").unwrap_or(if datatype == "color" { 0.005 } else { 0.02 }),
            placeholder: letters[slot],
            on: |v| {
                let out = [];
                for n in 0..count {
                    out.push(channel(util::vec(held_now(S, at, held)), n, fallback));
                }
                out[slot] = if datatype == "color" {
                    util::clamp(v, 0.0, 1.0)
                } else {
                    stored_as(spec, v)
                };
                write_at(S, at, out);
            },
        });
    }
    push(S, #{ label: at.label, tooltip: row_tip(at, spec), controls: controls });
}

// The vector as it stands now, so writing one component keeps the others: the
// spec was built before the edit and holds the value the reader started from.
fn read_now(S, comp, prop, fallback) {
    let found = match model::live(S, S.sel) {
        Some(found) => found,
        None => return fallback,
    };
    let data = util::obj(found.get_component(comp));
    match data.get(prop) {
        Some(value) => value,
        None => fallback,
    }
}

// A reference, or an inline definition the engine reports as a `#!` digest. A
// type that declares no directory cannot be promoted, so it gets no button.
fn edit_asset(S, k, at, spec, value) {
    let asset_type = spec.get("asset").unwrap_or("");
    // An empty material draws with the nearest one up, so the field says which
    // and where from: `red ← Rig`.
    let (inherited, from, here) = if asset_type == "material" && as_text(value) == "" {
        inherited_material(S)
    } else {
        ("", "", false)
    };
    let placeholder = if inherited == "" {
        "— none —"
    } else {
        format!("{} ← {}", inherited_label(S, inherited), util::last_segment(from))
    };
    let reference = model::relative_file(S, as_text(value));
    let inline = reference.starts_with("#!");
    let dir = if asset_type != "" { assets::directory(asset_type) } else { "" };
    let controls = [if inline {
        #{ kind: "label", role: "readonly_value", grow: 1, text: "— inline —" }
    } else {
        #{
            kind: "field", grow: 1, text: reference, placeholder: placeholder,
            on_submit: |text| { write_at(S, at, text); },
        }
    }];
    if dir != "" {
        controls.push(#{
            kind: "button", role: "clip_verb",
            text: if inline { "save as file" } else { "make inline" },
            tooltip: if inline {
                format!("Write this {} to {}/ and reference it", asset_type, dir)
            } else {
                "Copy this file's definition onto the node"
            },
            on: |_| {
                if inline {
                    promote_asset(S, at, asset_type, dir, reference);
                } else {
                    inline_asset(S, at, reference);
                }
            },
        });
    }
    push(S, #{
        label: at.label, tooltip: row_tip(at, spec),
        height: row_h(S), slot_role: "verb_row", controls: controls,
    });
    // Not when the node's own `material` component is the source: it draws them.
    if asset_type == "material" && !here {
        // The live spelling, which the editor's own engine can load and save.
        let own = as_text(value);
        let loadable = if own == "" { inherited } else { own };
        material_rows(S, k, loadable);
    }
}

/// What the placeholder calls an inherited material: its file's stem.
fn inherited_label(S, reference) {
    let file = model::relative_file(S, reference);
    if file.starts_with("#!") {
        "inline"
    } else {
        util::last_segment(file).replace(".toml", "")
    }
}

/// The material the selection draws with while it names none, the path of the
/// node naming it, and whether that is the selection itself. The nearest one
/// up wins, and the walk stops at the edited scene.
fn inherited_material(S) {
    let found = match model::live(S, S.sel) {
        Some(found) => found,
        None => return ("", "", false),
    };
    let at = found;
    while at is balaur::Node && at.is_valid() {
        let own = at.material();
        if own != "" {
            return (own, at.path(), at.path() == found.path());
        }
        if S.mirror is balaur::Node && at.path() == S.mirror.path() {
            break;
        }
        at = at.parent();
    }
    ("", "", false)
}

// The values a material's shader takes, read off the linked shader so the
// rows cannot drift from it. One that will not link has none.
fn material_rows(S, k, reference) {
    if reference == "" {
        return;
    }
    let (ok, definition) = script::attempt(|| assets::load(reference));
    let shader = if ok && definition is Object {
        definition.get("shader").unwrap_or("")
    } else {
        ""
    };
    if shader != "" {
        shader_row(S, k, reference, shader);
        feature_rows(S, k, reference, util::obj(util::obj(definition).get("features").unwrap_or(#{})));
    }
    for p in render::material_params(reference) {
        material_row(S, k, reference, p["name"], p["type"], p["value"]);
    }
}

/// Which `.wesl` the material draws with: a picker over the project's own
/// shaders, and a click on the name opens it in the code pane.
fn shader_row(S, k, reference, shader) {
    // By leaf: an inlined material's `shader` is the absolute path the mirror
    // resolved, and what a person picks from is the file's name.
    let choices = [];
    for f in model::list(S, "shaders") {
        if !f.is_dir && f.name.ends_with(".wesl") {
            choices.push(f.name);
        }
    }
    let current = util::last_segment(shader);
    if !util::contains(choices, current) {
        choices.insert(0, current);
    }
    push(S, #{ label: "  Shader", height: row_h(S), slot_role: "shader_row", controls: [
        #{
            kind: "button", role: "shader_open", text: icons::ui("open"),
            tooltip: "Edit " + current,
            on: |_| {
                S.shader_rel = model::relative_file(S, shader);
                S.doctab = "script";
            },
        },
        #{
            kind: "dropdown", grow: 1, text: current, options: choices,
            on: |picked| {
                if picked != current {
                    write_material_key(S, reference, "shader", "shaders/" + picked);
                }
            },
        },
    ] });
}

/// The `@if` flags the shader declares, as toggles. A material naming one the
/// shader does not have is what the flag list is read from, so a hand-written
/// feature still shows.
fn feature_rows(S, k, reference, features) {
    for key in util::keys_sorted(features) {
        // Bound afresh: a closure made in a loop captures the binding.
        let name = key;
        push(S, #{ label: "  @" + name, height: row_h(S), controls: [#{
            kind: "switch", role: "switch", checked: features[name] == true,
            on: |on| { write_material_feature(S, reference, name, on); },
        }] });
    }
}

/// Write one top-level key of a `material` asset.
fn write_material_key(S, reference, key, value) {
    let (ok, definition) = script::attempt(|| assets::load(reference));
    if !ok || !(definition is Object) {
        log::warn(format!("cannot read the material {}", reference));
        return;
    }
    definition[key] = value;
    let (written, err) = script::attempt(|| assets::save(reference, definition));
    if !written {
        log::warn(format!("cannot write {}: {:?}", reference, err));
    }
}

fn write_material_feature(S, reference, name, on) {
    let (ok, definition) = script::attempt(|| assets::load(reference));
    if !ok || !(definition is Object) {
        return;
    }
    let features = util::obj(definition.get("features").unwrap_or(#{}));
    features[name] = on;
    definition["features"] = features;
    let (written, err) = script::attempt(|| assets::save(reference, definition));
    if !written {
        log::warn(format!("cannot write {}: {:?}", reference, err));
    }
}

fn material_row(S, k, reference, name, datatype, value) {
    // Indented, because these belong to the row above rather than the node.
    let control = if datatype == "color" {
        // `material_params` hands a colour back as a `balaur::Color`.
        let channels = if value is balaur::Color {
            [value.r, value.g, value.b, value.a]
        } else {
            util::vec(value)
        };
        #{
            kind: "color", width: 34, color: channels,
            on: |rgba| { write_material_param(S, reference, name, rgba); },
        }
    } else if datatype == "float" {
        #{
            kind: "drag_value", grow: 1, value: util::f(value), step: 0.001,
            on: |v| { write_material_param(S, reference, name, v); },
        }
    } else if datatype == "texture" {
        // A slot names an image, or nothing: the picker is over what the
        // project has under `art/`, plus the choice of no map at all.
        let current = if value is String { value } else { "" };
        let choices = ["none"];
        for f in model::list(S, "art") {
            if !f.is_dir {
                choices.push("art/" + f.name);
            }
        }
        #{
            kind: "dropdown", grow: 1,
            text: if current == "" { "none" } else { current },
            options: choices,
            on: |picked| {
                write_material_param(S, reference, name, if picked == "none" { "" } else { picked });
            },
        }
    } else {
        let count = if datatype == "vec2" { 2 } else { 3 };
        let letters = ["x", "y", "z"];
        let held = util::vec(value);
        let cells = [];
        for i in 0..count {
            // Bound afresh: a closure made in a loop captures the binding.
            let slot = i;
            cells.push(#{
                kind: "drag_value", grow: 1, step: 0.02, placeholder: letters[slot],
                value: match held.get(slot) { Some(x) => util::f(x), None => 0.0 },
                on: |v| {
                    let out = [];
                    for n in 0..count {
                        out.push(match held.get(n) { Some(x) => util::f(x), None => 0.0 });
                    }
                    out[slot] = v;
                    write_material_param(S, reference, name, out);
                },
            });
        }
        #{ grow: 1, controls: cells }
    };
    // Indented, because these belong to the row above rather than the node.
    push(S, #{
        label: "  " + util::prop_label(name), tooltip: util::prop_label(name),
        height: row_h(S), controls: [control],
    });
}


// Write one value into the material's `[params]` table. Saving is what
// relinks it, so a dragged value shows in the viewport.
fn write_material_param(S, reference, name, value) {
    let (ok, definition) = script::attempt(|| assets::load(reference));
    if !ok || !(definition is Object) {
        log::warn(format!("cannot read the material {}: {:?}", reference, definition));
        return;
    }
    let params = match definition.get("params") {
        Some(existing) => existing,
        None => #{},
    };
    // An empty texture slot is cleared rather than written as "": a param
    // naming no file is not a param.
    if value is String && value == "" {
        params.remove(name);
    } else {
        params[name] = value;
    }
    definition["params"] = params;
    let (written, err) = script::attempt(|| assets::save(reference, definition));
    if !written {
        log::warn(format!("cannot write {}: {:?}", reference, err));
    }
}

// Anything with no registered editor: its text, straight through.
fn edit_text(S, k, at, spec, value) {
    push(S, #{ label: at.label, tooltip: row_tip(at, spec), controls: [#{
        kind: "field", grow: 1, role: "field",
        text: model::relative_file(S, as_text(value)),
        placeholder: "— empty —",
        on: |text| { write_at(S, at, text); },
    }] });
}

fn fixed(v, decimals) {
    match decimals {
        0 => format!("{:.0}", v),
        1 => format!("{:.1}", v),
        3 => format!("{:.3}", v),
        4 => format!("{:.4}", v),
        _ => format!("{:.2}", v),
    }
}

// A `readonly` property is engine output (widget.clicked): a write here would
// be overwritten next frame, so it renders as a plain value with nothing to
// focus.
fn readonly_text(spec, value) {
    let datatype = spec["type"];
    if datatype == "float" {
        fixed(shown_as(spec, if value is Tuple { 0.0 } else { util::f(value) }),
            util::i(spec.get("decimals").unwrap_or(2)))
    } else if datatype == "bool" {
        if value == true { "true" } else { "false" }
    } else if datatype == "vec2" || datatype == "vec3" || datatype == "color" {
        let count = if datatype == "color" { 4 } else if datatype == "vec2" { 2 } else { 3 };
        let v = util::vec(value);
        let parts = [];
        for i in 0..count {
            let fallback = if datatype == "color" { 1.0 } else { 0.0 };
            let held = match v.get(i) { Some(x) => util::f(x), None => fallback };
            parts.push(format!("{:.2}", shown_as(spec, held)));
        }
        util::join(parts, ", ")
    } else {
        as_text(value)
    }
}

fn readonly_row(S, prop, spec, data) {
    let value = match data.get(prop) {
        Some(value) => value,
        None => spec.get("default").unwrap_or(()),
    };
    // A read-only value is whatever the component reports, a joined list
    // included: it gets the column, and is cut off at its end.
    push(S, #{
        label: util::prop_label(prop), tooltip: prop_tip(prop, spec),
        controls: [
            #{
                kind: "label", role: "readonly_value", grow: 1, truncate: true,
                text: readonly_text(spec, value),
            },
            #{ kind: "label", role: "readonly_tag", text: "read-only" },
        ],
    });
}

// A pointer at the Events view, in place of a section no derived editor can
// draw: the rows are tables, not properties.
fn bindings_note(S, k) {
    section(S, k, "BINDINGS");
    push(S, #{ full: true, height: row_h(S) + 2.0, controls: [#{
        kind: "button", role: "note_action", grow: 1,
        text: format!("{} row(s) · open the Events view", crate::events::rows(S).len()),
        icon: icons::ui("events"),
        on: |_| { shell::open_doc(S, "events"); },
    }] });
}

/// The node's components with each above the ones it needs, so the transform a
/// body and a bone both expect sits under them rather than over them.
///
/// Kahn's order over `expects`: a component is drawn once nothing left still
/// needs it. A cycle keeps registration order for what is left of it rather
/// than dropping those sections.
fn ordered_components(S, names) {
    let waiting = #{};
    for name in names {
        waiting[name] = 0;
    }
    for name in names {
        for need in model::expects(S, name) {
            if waiting.contains_key(need) {
                waiting[need] = waiting[need] + 1;
            }
        }
    }
    let out = [];
    let left = names;
    for _ in 0..names.len() {
        if left.is_empty() {
            break;
        }
        let ready = [];
        let held = [];
        for name in left {
            if waiting[name] == 0 {
                ready.push(name);
            } else {
                held.push(name);
            }
        }
        if ready.is_empty() {
            for name in held {
                out.push(name);
            }
            return out;
        }
        for name in ready {
            out.push(name);
            for need in model::expects(S, name) {
                if waiting.contains_key(need) {
                    waiting[need] = waiting[need] - 1;
                }
            }
        }
        left = held;
    }
    out
}

// One auto-generated section per component present on the node.
// `filter` limits which components a persona shows (`None` = all).
fn component_sections(S, k, filter) {
    let found = match model::live(S, S.sel) {
        Some(found) => found,
        None => return,
    };
    // Advisory only: the component is applied and working as far as the
    // engine is concerned, but it has nothing to act on yet.
    let unmet = #{};
    for warning in util::vec(scene::unmet_expectations(found)) {
        unmet[warning.component] = util::join(util::vec(warning.expects), ", ");
    }
    let query = crate::search::query(S, "inspector");
    for comp in ordered_components(S, util::vec(found.component_names())) {
        let shown = match filter {
            Some(filter) => util::contains(filter, comp),
            None => true,
        };
        if !shown {
            continue;
        }
        // Its rows are a table of tables, which no derived editor can draw
        // and the Events view already draws properly.
        if comp == "bindings" {
            bindings_note(S, k);
            continue;
        }
        // The component's name and every property it has, so a query for a
        // property finds the section that holds it.
        let props = util::join(util::keys_sorted(S.schemas.get(comp).unwrap_or(#{})), " ");
        if !crate::search::matches(query, format!("{} {}", comp, props)) {
            continue;
        }
        let key = format!("inspector/{}", comp);
        let open = !S.collapsed.contains_key(key);
        let held = comp;
        let (mark, tint) = icons::component(held);
        fold_row_with(S, "section", open, held.to_uppercase(), mark,
            k.get(tint).unwrap_or(k.dim), || {
                if open {
                    S.collapsed[key] = true;
                } else {
                    S.collapsed.remove(key);
                }
            }, [#{
                kind: "button", role: "section_drop", text: icons::ui("close"),
                tooltip: "Remove component",
                on: |_| { model::remove_component(S, held); },
            }]);
        if !open {
            continue;
        }
        if let Some(needs) = unmet.get(comp) {
            push(S, #{ full: true, height: 0, controls: [#{
                kind: "label", role: "warn_note", grow: 1, wrap: true,
                text: format!("⚠ needs one of: {}", needs),
            }] });
        }
        let schema = model::schema(S, comp);
        let data = util::obj(found.get_component(comp));
        let grouped = #{};
        let order = [];
        for prop in util::keys_sorted(schema) {
            let spec = schema[prop];
            let group = spec.get("group").unwrap_or("");
            if group == "" {
                property_row(S, k, comp, prop, spec, data);
                continue;
            }
            if !grouped.contains_key(group) {
                grouped[group] = [];
                order.push(group);
            }
            grouped[group].push(prop);
        }
        order.sort();
        for group in order {
            if !subsection(S, comp, group, grouped[group].len()) {
                continue;
            }
            for prop in grouped[group] {
                property_row(S, k, comp, prop, schema[prop], data);
            }
        }
    }
}

fn events_section(S, k) {
    let node = model::selected_node(S);
    if !section(S, k, "Events") {
        return;
    }
    let script = match model::script_rel(node) {
        Some(script) => script,
        None => {
            wide_row(S, row_h(S) + 2.0, || {
                style::empty(k, "no script attached");
            });
            return;
        }
    };
    for hook in model::hooks(S, script) {
        let held = hook;
        wide_row(S, row_h(S) + 2.0, || {
            style::hook_pill(k, held.name, held.name + "()", "→ engine");
        });
    }
}

pub fn body(S, k) {
    let node = model::selected_node(S);
    ui::add_space(2);
    ui::horizontal(#{ height: row_h(S) }, || {
        let (icon, token) = model::node_icon(node);
        ui::label(icon, #{ size: style::LG, color: k.get(token).unwrap_or(k.accent) });
        ui::add_space(7);
        // One line: the name, then its type beside it. The panel is narrow
        // and a second row was a whole line of height for four words.
        ui::label(node.name, #{
            size: style::LG, font: ui::FONT_HEADING, strong: true, color: k.text, truncate: true,
        });
        ui::add_space(6);
        ui::label(model::node_type(node),
            util::merge(style::mono_sm(k.faint), #{ truncate: true }));
    });
    ui::add_space(3);
    crate::search::field(S, k, "inspector", "Search", ui::available_width());
    // Every row is a node now: the sections describe them, and the pool makes
    // and reuses them under the sheet's scroll.
    open_form(S);
    multi_note(S);
    instance_note(S, k);
    instance_source_row(S, k, node);
    if S.persona == "phys" {
        component_sections(S, k, Some(["body", "collider", "body2d", "collider2d"]));
        polygon_section(S, k);
        script_section(S, k, "Script");
    } else if S.persona == "script" {
        script_section(S, k, "Attached script");
    } else if S.persona == "anim" {
        skeleton_section(S, k);
        polygon_section(S, k);
        animation_section(S, k);
        component_sections(S, k, Some(["animation", "state_machine", "bone2d", "bone3d", "polygon", "transform"]));
        script_section(S, k, "Script");
    } else if S.persona == "ui" {
        component_sections(S, k, Some(["widget"]));
        interface_section(S, k);
        script_section(S, k, "Script");
    } else {
        skeleton_section(S, k);
        polygon_section(S, k);
        component_sections(S, k, None);
        script_section(S, k, "Script");
    }
    events_section(S, k);
    crate::plugins::draw_sections(S, k, node);
    crate::pool::sync(S, FORM_NODE, S.form, label_w(S), stacked(S));
}

/// The one control under the scroll, so a long form cannot push it away.
pub fn foot_controls(S) {
    [#{
        kind: "button", role: "button", height: 30, width: 0.0, grow: 1.0,
        icon: icons::ui("add"), text: "Add component",
        on: |_| { shell::open_palette(S, "add "); },
    }]
}
