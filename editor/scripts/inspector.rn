// Inspector (308 px): live node properties, editable, per-persona sections.

use crate::anim;
use crate::icons;
use crate::model;
use crate::polygon;
use crate::rig;
use crate::shell;
use crate::style;
use crate::util;

const LABEL_W = 82.0;
// Control area width: 308 panel − 24 padding − 84 label − spacing.
const CONTROL_W = 184.0;
// A section heading that folds its rows away on click. Returns whether the
// caller should draw them; the fold state lives on `S.collapsed` beside the
// tree's, under an `inspector/` key so the two never collide.
fn section(S, k, title) {
    let key = format!("inspector/{}", title);
    let open = !S.collapsed.contains_key(key);
    let (mark, tint) = icons::component(title.to_lowercase());
    wide_row(S, 24, || {
        ui::horizontal(#{ height: 20 }, || {
            ui::add_space(2);
            ui::label(if open { icons::ui("caret-open") } else { icons::ui("caret-shut") },
                #{ size: style::SM, color: k.faint });
            ui::add_space(4);
            if ui::pill(title.to_uppercase(), util::merge(style::heading(k), #{
                height: 20, radius: 4, align: ui::ALIGN_LEFT,
                icon: mark, icon_size: style::MD, icon_color: k.get(tint).unwrap_or(k.dim),
            })) {
                if open {
                    S.collapsed[key] = true;
                } else {
                    S.collapsed.remove(key);
                }
            }
        });
    });
    open
}

// The host the pool builds the rows on, and the hatch a drawn row names.
const FORM_NODE = "Editor/Shell/Body/Right/RightSheet/RightScroll/RightForm";
const ROW_HATCH = "draw_form_row";

// The rows this frame wants, and the closures the drawn ones run. Built as
// the sections walk the selection, then handed to `pool::sync` in one go.
fn open_form(S) {
    S.form = [];
    S.form_draws = [];
    S.form_cursor = 0;
}

fn push(S, spec) {
    S.form.push(spec);
}

/// Start and finish a form, for a panel other than the inspector that fills
/// the same pool: the right sheet has one, and one panel is up at a time.
pub fn open_pool(S) {
    open_form(S);
}

pub fn close_pool(S) {
    crate::pool::sync(S, FORM_NODE, S.form, label_w(S), control_w(S));
}

/// One labelled row of controls, for a panel describing its own form.
pub fn form_row(S, label, controls) {
    push(S, #{ label: label, controls: controls });
}

/// A row the caller draws: a label column and a `draw` node beside it, so the
/// bespoke rows a control table cannot describe are nodes like the rest.
fn row(S, k, label, body) {
    tip_row(S, k, label, "", body);
}

/// A drawn row whose label says more on hover: the label column is 82 px and
/// cuts what does not fit, so the tooltip is where the whole of it lives.
fn tip_row(S, k, label, tooltip, body) {
    S.form_draws.push(body);
    push(S, #{ label: label, tooltip: tooltip, height: 24, draw: ROW_HATCH });
}

/// A drawn row for one schema property, labelled and described from its spec.
fn spec_row(S, k, prop, spec, body) {
    tip_row(S, k, util::prop_label(prop), prop_tip(prop, spec), body);
}

/// A property's value as its row draws it. `unit` is display only: the
/// component, the scene file and a script all hold what the schema declares,
/// and `min`, `max` and `step` are written in the unit shown.
fn shown_as(spec, v) {
    if spec.get("unit").unwrap_or("") == "degrees" { math::deg(v) } else { v }
}

/// The inverse of `shown_as`, for the value a row writes back.
fn stored_as(spec, v) {
    if spec.get("unit").unwrap_or("") == "degrees" { math::rad(v) } else { v }
}

/// A property's full label, and what its schema says it is under it.
fn prop_tip(prop, spec) {
    let label = util::prop_label(prop);
    let description = spec.get("description").unwrap_or("");
    if description == "" { label } else { label + "\n" + description }
}

/// A drawn row spanning both columns, for a heading or a note.
fn wide_row(S, height, body) {
    S.form_draws.push(body);
    push(S, #{ full: true, height: height, draw: ROW_HATCH });
}

/// Stop drawing the form, for a right dock showing something else.
pub fn hide_form() {
    crate::pool::hide(FORM_NODE);
}

/// Run the next drawn row. The pool draws its visible children in the order
/// they were pushed, so one cursor keeps the two in step.
///
/// A hatch can fire before the panel has described a single row — the frame a
/// dock is switched away from still draws what the last one left — so a
/// cursor past the end draws nothing rather than failing the frame.
pub fn draw_row(S) {
    let n = S.form_cursor;
    S.form_cursor = n + 1;
    let found = S.form_draws.get(n);
    if let Some(body) = found {
        body();
    }
}

// The two columns of a row, both derived from the panel: at a width neither
// fits, the label gives way first and the control keeps a usable size.
fn label_w(S) {
    util::clamp(S.layout.right.w * 0.34, 46.0, LABEL_W)
}

fn control_w(S) {
    util::max(72.0, util::min(320.0, S.layout.right.w - 22.0 - label_w(S)))
}

// A full-width row inside the panel: the sheet less its padding.
fn panel_w(S) {
    util::max(S.layout.right.w - 26.0, 150.0)
}

fn value_field(k, value, opts) {
    ui::drag_value(value, #{
        width: opts.get("width").unwrap_or(184.0),
        speed: opts.get("speed").unwrap_or(0.02),
        decimals: opts.get("decimals").unwrap_or(2),
        suffix: opts.get("suffix").unwrap_or(()),
        fill: k.sunken, stroke: k.line, color: k.text,
    })
}

// A row that came from a prefab says so, and says where an edit will land.
// The rows below belong to the active node; an edit reaches every selected
// node that carries the same component (`docs/PLAN-editor-ergonomics.md` §5).
fn multi_note(S, k) {
    let n = crate::selection::count(S);
    if n < 2 {
        return;
    }
    ui::add_space(4);
    ui::horizontal(#{ height: 24 }, || {
        ui::add_space(2);
        let note = if S.compact {
            format!("{} nodes selected", n)
        } else {
            format!("{} nodes selected · editing applies to all", n)
        };
        ui::pill(note, #{
            height: 24, size: style::SM, radius: 4, min_width: panel_w(S) - 16.0,
            align: ui::ALIGN_LEFT, fill: k.accent_soft, color: k.accent,
            icon: icons::ui("select-all"), icon_size: style::SM,
        });
    });
}

fn instance_note(S, k) {
    let node = model::selected_node(S);
    if !model::is_instanced(node) {
        return;
    }
    wide_row(S, 54, || {
    ui::add_space(6);
    ui::horizontal((), || {
        ui::add_space(8);
        ui::frame(#{ fill: k.sunken, radius: 12, padding_x: 10 }, || {
            ui::horizontal(#{ height: 24 }, || {
                // A prefab path is as long as the project makes it: ellipsis
                // rather than a note that stretches the panel.
                ui::horizontal(#{ height: 24, width: panel_w(S) - 90.0 }, || {
                    ui::label(icons::ui("instance") + " from " + model::prefab_of(S, node),
                        util::merge(style::mono_sm(k.dim), #{ truncate: true }));
                });
                ui::add_space(8);
                if ui::pill("open", #{
                    height: 20, size: style::SM, fill: k.panel, color: k.dim,
                    tooltip: "Edit the prefab itself, for every instance of it",
                }) {
                    model::open_prefab(S);
                }
            });
        });
    });
    ui::horizontal((), || {
        ui::add_space(10);
        ui::label("edits become overrides on " + node.at,
            util::merge(style::mono_sm(k.faint), #{ truncate: true }));
    });
    });
}

// An instance node's own row: which prefab it builds, and a way into it.
fn instance_source_row(S, k, node) {
    if !node.contains_key("instance") {
        return;
    }
    row(S, k, "Instance", || {
        ui::frame(#{ fill: k.sage_soft, stroke: k.sage, radius: 14, padding_x: 11 }, || {
            ui::horizontal(#{ height: 30, width: control_w(S) - 24.0 }, || {
                ui::label(node.instance,
                    util::merge(style::mono(k.sage), #{ truncate: true }));
                ui::right(|| {
                    if ui::pill("open", #{
                        height: 20, size: style::SM, strong: true,
                        fill: k.panel, color: k.dim,
                        tooltip: "Edit the prefab itself, for every instance of it",
                    }) {
                        model::open_prefab(S);
                    }
                });
            });
        });
    });
}

// The script's path is a field: typing a name moves the file, and the
// picker beside it attaches one that already exists.
fn script_section(S, k, title) {
    let node = model::selected_node(S);
    if !section(S, k, title) {
        return;
    }
    let has = node.contains_key("script");
    row(S, k, "Script", || {
        let id = format!("script:{}", S.sel);
        let (text, _, submitted) = ui::text_field(id, "scripts/name.rn",
            util::merge(style::field(k, control_w(S) - 52.0),
                #{ value: model::script_rel(node).unwrap_or(""), color: k.sage }));
        if submitted {
            shell::set_script_path(S, text);
        }
        ui::right(|| {
            let (picked, changed) = ui::dropdown(format!("pick:{}", id), "pick", shell::script_files(S), #{
                width: 46, size: style::SM, height: 20, color: k.text,
            });
            if changed {
                shell::set_script_path(S, picked);
            }
        });
    });
    row(S, k, "", || {
        if has {
            if ui::pill("open", #{ role: "row_action_on", tooltip: "Edit it in the code pane" }) {
                shell::set_persona(S, "script");
            }
            ui::add_space(6);
            if ui::pill("remove", #{
                role: "row_action", color: k.accent,
                tooltip: "Detach the script from this node; the file stays",
            }) {
                shell::detach_script(S);
            }
        } else if ui::pill(icons::ui("add") + " new script", #{
            role: "row_action_on",
            tooltip: "Write scripts/" + node.name.to_lowercase() + ".rn and attach it",
        }) {
            shell::attach_script(S);
        }
    });
    script_props_rows(S, k, node);
}

// What the script declares tunable, one row per export. A value differing
// from the default is the node's own; everything else is inherited, so a
// changed default reaches every node that left it alone.
fn script_props_rows(S, k, node) {
    let rel = match model::script_rel(node) {
        Some(rel) => rel,
        None => return,
    };
    let declared = model::exports(S, rel);
    if declared.is_empty() {
        return;
    }
    let props = model::script_props(node);
    wide_row(S, 20, || {
        style::section_label(k, "properties");
    });
    for export in declared {
        let overridden = props.contains_key(export.name);
        let value = if overridden { props[export.name] } else { export["default"] };
        // The export row *is* a spec, in the schema's own vocabulary, so the
        // rows a script declares reach the same editors a component's do:
        // an enum gets the dropdown, a node the picker, an asset the row.
        let spec = util::copy(export);
        spec.remove("name");
        // Rune has no computed key in an object literal, and `prop_row`
        // reads the value out of a table by name.
        let data = #{};
        data[export.name] = value;
        prop_row(S, k, SCRIPT_PROPS, export.name, spec, data);
        if overridden {
            let name = export.name;
            let back = export["default"];
            push(S, #{ label: "", height: 22, controls: [#{
                kind: "button", height: 20, text: "reset", role: "chip", width: 52,
                tooltip: "Back to the script's default",
                on: |_| { model::set_script_prop(S, name, back); },
            }] });
        }
    }
}

// Save as file promotes the inline definition to `animations/<node>.toml`,
// Make inline copies a file back onto the node; neither touches the clip itself.
fn clip_source_row(S, k, node) {
    let path = anim::library_path(node);
    row(S, k, "Source", || {
        // The clip's file, ellipsised: a library path is longer than the row.
        ui::horizontal(#{ height: 24, width: control_w(S) - 96.0 }, || {
            ui::label(path.unwrap_or("— inline —"),
                util::merge(style::mono(k.faint), #{ truncate: true }));
        });
        ui::right(|| {
            let inline = path.is_none();
            let label = if inline { "save as file" } else { "make inline" };
            if ui::pill(label, #{
                height: 20, size: style::SM, strong: true,
                tooltip: if inline {
                    "Write this clip to animations/ and reference it"
                } else {
                    "Copy this file's clip onto the node"
                },
                fill: k.sage_soft, color: k.sage,
            }) {
                if inline {
                    anim::promote(S);
                } else {
                    anim::make_inline(S);
                }
            }
        });
    });
}

// Godot's two rest-pose verbs, for a node with bones under it (or a bone).
fn skeleton_section(S, k) {
    let (node, found) = model::selected(S);
    if found.is_none() {
        return;
    }
    let count = rig::bone_count(S, S.sel);
    if count == 0 && S.mode2d {
        return;
    }
    if !section(S, k, "Skeleton") {
        return;
    }
    row(S, k, "Bones", || {
        let what = if rig::is_bone(node) { "this bone and below" } else { format!("under {}", node.name) };
        // The node's own name is in the line: ellipsis, not a wider panel.
        ui::horizontal(#{ height: 24, width: control_w(S) - 76.0 }, || {
            ui::label(format!("{} · {}", count, what),
                util::merge(style::mono(k.text), #{ truncate: true }));
        });
        ui::right(|| {
            if ui::pill(icons::ui("add") + " bone", #{
                role: "row_action_on",
                tooltip: "Grow a bone under this node (in 2D, the Rig bone tool places one by clicking)",
            }) {
                if let Some(found) = model::live(S, S.sel) {
                    let p = found.global_position();
                    rig::add_bone(S, S.sel, p.x, p.y + 1.0);
                }
            }
        });
    });
    if count == 0 {
        return;
    }
    row(S, k, "Rest pose", || {
        if ui::pill("reset", #{
            role: "row_action",
            tooltip: "Reset to Rest Pose: pose every bone here at its rest",
        }) {
            rig::apply_rest(S);
        }
        ui::add_space(6);
        if ui::pill("overwrite", #{
            role: "row_action", fill: k.sage_soft, color: k.sage,
            tooltip: "Overwrite Rest Pose: the pose every bone is in now becomes its rest",
        }) {
            rig::overwrite_rest(S);
        }
    });
    row(S, k, "Mirror", || {
        for axis in ["x", "y"] {
            if ui::pill(axis, #{
                role: "row_action",
                tooltip: format!("Reflect every bone's rest over this node's {} axis, and hand each bone's rest to the one whose name differs by a side", axis),
            }) {
                rig::mirror(S, axis);
            }
            ui::add_space(6);
        }
    });
    row(S, k, "Ragdoll", || {
        let built = node.contains_key("ragdoll");
        if ui::pill(if built { "rebuild" } else { "physical bones" }, #{
            role: "row_action", fill: k.sage_soft, color: k.sage,
            tooltip: "Create Physical Skeleton: a body and a capsule per bone, hinged to its parent's, driven back onto the rig by the ragdoll component's blend",
        }) {
            rig::physical_bones(S);
        }
        if built {
            ui::right(|| {
                ui::label("blend below", style::mono_sm(k.faint));
            });
        }
    });
}

// What the Polygon tool works on: the vertex and polygon counts, the rig's
// bones to paint with, and the brush.
fn polygon_section(S, k) {
    let node = model::selected_node(S);
    if polygon::component(node).is_none() {
        return;
    }
    let occluding = polygon::occluding(S);
    if !section(S, k, if occluding { "Occluder" } else { "Polygon" }) {
        return;
    }
    let mesh = match polygon::mesh(S) {
        Some(mesh) => mesh,
        None => {
            row(S, k, "Mesh", || {
                let text = if polygon::editable(S) {
                    "empty — trace it with the Polygon tool"
                } else {
                    "a file; make it inline to edit"
                };
                ui::label(text, style::mono_sm(k.faint));
            });
            return;
        }
    };
    let positions = util::vec(mesh.get("positions").unwrap_or([]));
    let internal = polygon::internal_count(mesh);
    row(S, k, "Vertices", || {
        ui::label(format!("{} · {} internal", positions.len(), internal), style::mono(k.text));
    });
    // An occluder is the outline and nothing else: no triangles, no rig, no
    // brush. Its one row is the count above.
    if occluding {
        return;
    }
    row(S, k, "Polygons", || {
        let count = util::vec(mesh.get("polygons").unwrap_or([])).len();
        ui::label(if count == 0 { "outline, automatic" } else { format!("{} drawn", count) },
            style::mono(k.text));
        if count > 0 {
            ui::right(|| {
                if ui::pill("clear", #{
                    height: 20, size: style::SM, strong: true,
                    tooltip: "Back to filling the outline automatically",
                    fill: k.sunken, color: k.dim,
                }) {
                    polygon::clear_polygons(S);
                }
            });
        }
    });
    row(S, k, "Trace", || {
        if ui::pill("from alpha", #{
            role: "row_action", fill: k.sage_soft, color: k.sage,
            tooltip: "Walk the texture's alpha and write the outline it finds as this polygon's points, replacing what is here",
        }) {
            polygon::trace(S);
        }
        ui::right(|| {
            let (tolerance, changed) = ui::drag_value(S.polygon.tolerance, #{
                width: 56, speed: 0.1, decimals: 1, min: 0.0, max: 64.0,
                prefix: "px", prefix_color: k.accent,
                fill: k.sunken, stroke: k.line, color: k.text,
            });
            if changed {
                S.polygon.tolerance = tolerance;
            }
        });
    });
    row(S, k, "Mirror", || {
        for axis in ["x", "y"] {
            if ui::pill(axis, #{
                role: "row_action",
                tooltip: format!("Reflect the picked vertices over this node's {} axis, and hand each bone's weights to the bone whose name differs by a side", axis),
            }) {
                polygon::mirror(S, axis);
            }
            ui::add_space(6);
        }
        ui::right(|| {
            ui::label(if polygon::has_pick(S) {
                format!("{} picked", polygon::picked(S).len())
            } else {
                "whole mesh"
            }, style::mono_sm(k.faint));
        });
    });
    if S.persona == "anim" {
        row(S, k, "Deform", || {
            if ui::pill("key", #{
                role: "row_action", fill: k.accent_soft, color: k.accent,
                tooltip: "Key every vertex's offset from its authored position on the armed clip, at the playhead",
            }) {
                polygon::key_deform(S);
            }
            ui::add_space(6);
            if ui::pill("clear", #{
                role: "row_action",
                tooltip: "Put every vertex back on its authored position",
            }) {
                polygon::clear_deform(S);
            }
            ui::right(|| {
                ui::label(if polygon::deformed(S) { "deformed" } else { "at rest" },
                    style::mono_sm(if polygon::deformed(S) { k.accent } else { k.faint }));
            });
        });
    }
    row(S, k, "Bones", || {
        if ui::pill("sync to rig", #{
            height: 24, size: style::SM, strong: true,
            tooltip: "Sync Bones to Polygon: list the rig's bones, keeping weights already painted",
            fill: k.sage_soft, color: k.sage,
        }) {
            polygon::sync_bones(S);
        }
    });
    for (i, bone) in polygon::bones(S).iter().enumerate() {
        let active = S.polygon.bone == Some(i);
        ui::horizontal(#{ height: 24 }, || {
            ui::spacing(8, 0);
            ui::add_space(label_w(S));
            if ui::pill(bone.path, #{
                height: 24, size: style::SM, align: ui::ALIGN_LEFT, min_width: CONTROL_W,
                icon: "⋈", icon_size: style::SM,
                fill: if active { k.accent_soft } else { k.sunken },
                color: if active { k.accent } else { k.text },
                tooltip: "Paint this bone's weights in the Weights mode",
            }) {
                S.polygon.bone = Some(i);
            }
        });
    }
    row(S, k, "Brush", || {
        let w = CONTROL_W / 2.0 - 5.0;
        let (radius, ch) = ui::drag_value(S.polygon.radius, #{
            width: w, speed: 0.5, decimals: 0, prefix: "px", prefix_color: k.accent,
            fill: k.sunken, stroke: k.line, color: k.text,
        });
        if ch {
            S.polygon.radius = util::clamp(radius, 2.0, 400.0);
        }
        let (strength, ch2) = ui::drag_value(S.polygon.strength, #{
            width: w, speed: 0.01, decimals: 2, prefix: "×", prefix_color: k.accent,
            fill: k.sunken, stroke: k.line, color: k.text,
        });
        if ch2 {
            S.polygon.strength = util::clamp(strength, 0.01, 2.0);
        }
    });
}

// The clip belongs to the player: the selection or its nearest animated
// ancestor, so a bone shows the character's clip, not one of its own.
fn animation_section(S, k) {
    let (node, _, _) = anim::player(S);
    if !section(S, k, "Animation") {
        return;
    }
    let def = match anim::definition(S) {
        Some(def) => def,
        None => {
            row(S, k, "Clip", || {
                if ui::pill(icons::ui("add") + " Create clip", #{
                    height: 30, size: style::MD, strong: true,
                    min_width: CONTROL_W,
                    fill: k.accent_soft, color: k.accent,
                }) {
                    anim::ensure_clip(S);
                }
            });
            return;
        }
    };
    // The clip and the rate are `animation.autoplay` and `animation.speed`,
    // edited in the player's own ANIMATION section rather than twice.
    clip_source_row(S, k, node);
    row(S, k, "Length", || {
        let (v, ch) = value_field(k, anim::length(def), #{ speed: 0.01, suffix: " s" });
        if ch {
            def.length = util::max(0.1, v);
            anim::touch(S);
        }
    });
    row(S, k, "Loop", || {
        // The engine's own vocabulary, not a boolean: pingpong is a third
        // answer and a toggle cannot say it.
        let (v, ch) = ui::dropdown(format!("loop:{}", S.sel), def.get("loop").unwrap_or("none"), ["none", "loop", "pingpong"], #{
            width: control_w(S), size: style::MD, height: 24, color: k.text,
        });
        if ch {
            def["loop"] = v;
            anim::touch(S);
        }
    });
    row(S, k, "Keys", || {
        ui::label(format!("{} on {} tracks", anim::key_count(def), anim::tracks(def).len()),
            style::mono(k.text));
    });
}

// Interface persona: the real surface is the `ui` scripting module.
fn interface_section(S, k) {
    let node = model::selected_node(S);
    if !section(S, k, "Interface") {
        return;
    }
    let draws = model::draws_ui(S, node);
    row(S, k, "Draws UI", || {
        ui::label(if draws { "yes · draw_ui()" } else { "no" }, style::mono(if draws { k.sage } else { k.faint }));
    });
    row(S, k, "Safe area", || {
        if !S.chip_state.contains_key("ui") {
            S.chip_state["ui"] = #{};
        }
        let chips = S.chip_state["ui"];
        let (on, ch) = ui::toggle(chips.get("safe").unwrap_or(false) == true, #{ role: "toggle",
            on_fill: k.accent_fill, off_fill: k.sunken,
            on_knob: k.on_accent, off_knob: k.faint,
        });
        if ch {
            chips.safe = on;
        }
    });
}

// Write an inline definition to its type's directory and point the property at
// the project-relative path — an absolute one would not survive another machine.
fn promote_asset(S, comp, prop, asset_type, dir, reference) {
    let node = S.doc[S.sel];
    let (ok, definition) = script::attempt(|| assets::load(reference));
    if !ok || !(definition is Object) {
        log::warn(format!("cannot read the inline {}: {:?}", asset_type, definition));
        return;
    }
    definition["type"] = asset_type;
    let rel = format!("{}/{}.toml", dir, node.name.to_lowercase());
    let (written, err) = script::attempt(|| assets::save(S.game_root + "/" + rel, definition));
    if !written {
        log::warn(format!("cannot write {}: {:?}", rel, err));
        return;
    }
    write(S, comp, prop, rel);
    log::info(format!("saved {}", rel));
}

// Copy a file's definition onto the node, so the scene owns it outright.
// `duplicate` reads past the cache, which is what makes the copy private
// rather than a second name for the shared one.
fn inline_asset(S, comp, prop, reference) {
    let (ok, copy) = script::attempt(|| assets::duplicate(S.game_root + "/" + reference));
    if !ok || !(copy is Object) {
        log::warn(format!("cannot inline {}: {:?}", reference, copy));
        return;
    }
    write(S, comp, prop, copy);
    log::info(format!("{} is now inline on {}", reference, S.doc[S.sel].name));
}

fn as_text(value) {
    if value is String {
        value
    } else if value is Tuple || value is Vec || value is Object {
        // A list has no text form, and a field is not where one is edited.
        ""
    } else {
        // `{:?}`: a value with no display of its own must not take the
        // inspector's whole draw down.
        format!("{:?}", value)
    }
}

// The `comp` an editor is given when it is editing a script's exported
// property rather than a component. No component can be named this — a
// component name is an identifier — so the two never collide.
const SCRIPT_PROPS = "script/props";

// Where an edited value goes. Every editor writes through here, so the same
// six editors serve components and script properties both.
fn write(S, comp, prop, value) {
    if comp == SCRIPT_PROPS {
        model::set_script_prop(S, prop, value);
        return;
    }
    model::set_component_prop(S, comp, prop, value);
    // The clip the Timeline holds was named by the value just written, so the
    // cache goes and the engine is handed the clip again.
    if comp == "animation" {
        S.clip = None;
        anim::arm(S);
    }
}

// A set drawn from the schema's `options`: one pill per option, filled when
// held. A checkbox grid in everything but the shape of the control.
fn edit_flags(S, k, comp, prop, spec, value) {
    let held = util::vec(value);
    spec_row(S, k, prop, spec, || {
        for name in util::vec(spec.get("options").unwrap_or([])) {
            let on = util::contains(held, name);
            if ui::pill(name, #{
                height: 20, size: style::SM, strong: on,
                fill: if on { k.accent_fill } else { k.sunken },
                color: if on { k.on_accent } else { k.dim },
            }) {
                let next = [];
                for other in held {
                    if other != name {
                        next.push(other);
                    }
                }
                if !on {
                    next.push(name);
                }
                write(S, comp, prop, next);
            }
        }
    });
}

// Another node, by path. The field takes what a scene file takes; the
// dropdown lists every node in the document as an absolute path, which is
// what a leading `/` means to the engine's resolver.
fn edit_node(S, k, comp, prop, spec, value) {
    spec_row(S, k, prop, spec, || {
        let id = format!("node:{}:{}:{}", comp, prop, S.sel);
        let (text, _, submitted) = ui::text_field(id, "— none —",
            util::merge(style::field(k, CONTROL_W - 78.0), #{ value: as_text(value) }));
        if submitted {
            write(S, comp, prop, text);
        }
        let paths = ["— none —"];
        for node in S.doc {
            paths.push("/" + model::node_path(S.doc, node));
        }
        ui::right(|| {
            let (picked, changed) = ui::dropdown(format!("pick:{}", id), "pick", paths, #{
                width: 74, size: style::SM, height: 20, color: k.text,
            });
            if changed {
                write(S, comp, prop, if picked == "— none —" { "" } else { picked });
            }
        });
    });
}

// One editor per schema datatype, looked up rather than branched on, so a
// plugin can register an editor for a datatype the editor has never heard of.
fn editors() {
    #{
        "float": edit_float,
        "int": edit_int,
        "bool": edit_bool,
        "enum": edit_enum,
        "vec2": edit_vector,
        "vec3": edit_vector,
        "color": edit_color,
        "asset": edit_asset,
        "flags": edit_flags,
        "node": edit_node,
    }
}

/// One property, in whichever of the two rows its spec asks for.
fn property_row(S, k, comp, prop, spec, data) {
    if spec.get("readonly").unwrap_or(false) == true {
        readonly_row(S, k, prop, spec, data);
    } else {
        prop_row(S, k, comp, prop, spec, data);
    }
}

/// A fold inside a component section, for the properties a schema files under
/// a `group`. Shut to begin with -- a property is grouped precisely because it
/// is not one of the handful worth the room -- so the state kept is which ones
/// were opened, not which were shut.
fn subsection(S, k, comp, group, count) {
    let key = format!("{}/{}", comp, group);
    // A search reaches into the folds: a property nobody can see is one the
    // box cannot find.
    let open = S.opened.contains_key(key)
        || crate::search::query(S, "inspector") != "";
    wide_row(S, 22, || {
        ui::horizontal(#{ height: 20 }, || {
            ui::add_space(14);
            ui::label(if open { icons::ui("caret-open") } else { icons::ui("caret-shut") },
                #{ size: style::SM, color: k.faint });
            ui::add_space(4);
            if ui::pill(format!("{} · {}", util::prop_label(group), count), #{
                height: 20, size: style::SM, radius: 4, align: ui::ALIGN_LEFT,
                min_width: panel_w(S) - 40.0, fill: k.sunken, color: k.dim,
            }) {
                if open {
                    S.opened.remove(key);
                } else {
                    S.opened[key] = true;
                }
            }
        });
    });
    open
}

fn prop_row(S, k, comp, prop, spec, data) {
    let value = match data.get(prop) {
        Some(value) => value,
        None => spec.get("default").unwrap_or(()),
    };
    // A plugin's editor for this datatype wins over the built-in, which is
    // what lets a project draw a curve or a colour ramp its own way.
    match crate::plugins::editor(S, spec["type"]) {
        Some(draw) => {
            draw(S, k, #{ comp: comp, prop: prop }, spec, value);
            return;
        }
        None => (),
    }
    let editor = match editors().get(spec["type"]) {
        Some(editor) => editor,
        None => edit_text,
    };
    editor(S, k, comp, prop, spec, value);
}

// The schema's `min` and `max` as the write must respect them. The control
// itself drags free: a clamp on the widget makes a value unreachable by
// typing, which is how a range is escaped when a scene wants one.
fn clamped(spec, v) {
    let out = v;
    // Rune rejects `if let Some(x) = x`: the binding is in scope before the
    // scrutinee is read, so the name has to differ.
    let floor = spec.get("min");
    if let Some(value) = floor {
        out = util::max(util::f(value), out);
    }
    let ceiling = spec.get("max");
    if let Some(value) = ceiling {
        out = util::min(util::f(value), out);
    }
    out
}

fn number_of(value) {
    if value is Tuple { 0.0 } else { util::f(value) }
}

fn edit_float(S, k, comp, prop, spec, value) {
    push(S, #{ label: util::prop_label(prop), tooltip: prop_tip(prop, spec), controls: [#{
        kind: "drag_value", grow: 1,
        value: shown_as(spec, number_of(value)),
        step: spec.get("step").unwrap_or(0.02),
        on: |v| { write(S, comp, prop, stored_as(spec, clamped(spec, v))); },
    }] });
}

fn edit_int(S, k, comp, prop, spec, value) {
    push(S, #{ label: util::prop_label(prop), tooltip: prop_tip(prop, spec), controls: [#{
        kind: "drag_value", grow: 1,
        value: number_of(value),
        step: spec.get("step").unwrap_or(1.0),
        on: |v| { write(S, comp, prop, math::round(clamped(spec, v)) as i64); },
    }] });
}

fn edit_bool(S, k, comp, prop, spec, value) {
    push(S, #{ label: util::prop_label(prop), tooltip: prop_tip(prop, spec), controls: [#{
        kind: "check", text: "",
        checked: value == true,
        on: |on| { write(S, comp, prop, on); },
    }] });
}

fn edit_enum(S, k, comp, prop, spec, value) {
    push(S, #{ label: util::prop_label(prop), tooltip: prop_tip(prop, spec), controls: [#{
        kind: "dropdown", grow: 1,
        text: as_text(value),
        options: util::vec(spec.get("options").unwrap_or([])),
        on: |picked| { write(S, comp, prop, picked); },
    }] });
}

// A swatch that opens egui's picker, and the channels beside it: a colour is
// the one vector nobody reads as numbers.
fn edit_color(S, k, comp, prop, spec, value) {
    let held = util::vec(value);
    let text = format!("{} {} {} {}",
        fixed(channel(held, 0, 1.0), 2), fixed(channel(held, 1, 1.0), 2),
        fixed(channel(held, 2, 1.0), 2), fixed(channel(held, 3, 1.0), 2));
    push(S, #{ label: util::prop_label(prop), tooltip: prop_tip(prop, spec), controls: [
        #{ kind: "color", width: 34, color: held, on: |rgba| { write(S, comp, prop, rgba); } },
        #{ kind: "label", grow: 1, text: text, role: "meta" },
    ] });
}

fn channel(v, i, fallback) {
    match v.get(i) {
        Some(x) => util::f(x),
        None => fallback,
    }
}

// vec2 and vec3 are one editor: a drag value a component, differing only in
// how many and what they are lettered.
fn edit_vector(S, k, comp, prop, spec, value) {
    let datatype = spec["type"];
    let held = util::vec(value);
    let count = if datatype == "color" { 4 } else if datatype == "vec2" { 2 } else { 3 };
    let letters = if datatype == "color" { ["r", "g", "b", "a"] } else { ["x", "y", "z"] };
    let fallback = if datatype == "color" { 1.0 } else { 0.0 };
    let controls = [];
    for i in 0..count {
        let slot = i;
        controls.push(#{
            kind: "drag_value", grow: 1,
            value: shown_as(spec, channel(held, slot, fallback)),
            step: spec.get("step").unwrap_or(if datatype == "color" { 0.005 } else { 0.02 }),
            placeholder: letters[slot],
            on: |v| {
                let out = [];
                for n in 0..count {
                    out.push(channel(util::vec(read_now(S, comp, prop, held)), n, fallback));
                }
                out[slot] = if datatype == "color" {
                    util::clamp(v, 0.0, 1.0)
                } else {
                    stored_as(spec, v)
                };
                write(S, comp, prop, out);
            },
        });
    }
    push(S, #{ label: util::prop_label(prop), tooltip: prop_tip(prop, spec), controls: controls });
}

// The vector as it stands now, so writing one component keeps the others: the
// spec was built before the edit and holds the value the reader started from.
fn read_now(S, comp, prop, fallback) {
    let found = match model::live(S, S.sel) {
        Some(found) => found,
        None => return fallback,
    };
    let data = util::obj(found.get_component(comp));
    match data.get(prop) {
        Some(value) => value,
        None => fallback,
    }
}

// A reference, or an inline definition the engine reports as a `#!` digest. A
// type that declares no directory cannot be promoted, so it gets no button.
fn edit_asset(S, k, comp, prop, spec, value) {
    spec_row(S, k, prop, spec, || {
        let reference = model::relative_file(S, as_text(value));
        let inline = reference.starts_with("#!");
        let asset_type = spec.get("asset").unwrap_or("");
        let dir = if asset_type != "" { assets::directory(asset_type) } else { "" };
        if inline {
            ui::label("— inline —", style::mono(k.faint));
        } else {
            let id = format!("asset:{}:{}:{}", comp, prop, S.sel);
            let width = if dir == "" { CONTROL_W } else { CONTROL_W - 78.0 };
            let (text, _, submitted) = ui::text_field(id, "— none —",
                util::merge(style::field(k, width), #{ value: reference }));
            if submitted {
                write(S, comp, prop, text);
            }
        }
        if dir == "" {
            return;
        }
        ui::right(|| {
            let label = if inline { "save as file" } else { "make inline" };
            if ui::pill(label, #{
                height: 20, size: style::SM, strong: true,
                tooltip: if inline {
                    format!("Write this {} to {}/ and reference it", asset_type, dir)
                } else {
                    "Copy this file's definition onto the node"
                },
                fill: k.sage_soft, color: k.sage,
            }) {
                if inline {
                    promote_asset(S, comp, prop, asset_type, dir, reference);
                } else {
                    inline_asset(S, comp, prop, reference);
                }
            }
        });
    });
    if spec.get("asset").unwrap_or("") == "material" {
        material_rows(S, k, model::relative_file(S, as_text(value)));
    }
}

// The values a material's shader takes, read off the linked shader so the
// rows cannot drift from it. One that will not link has none.
fn material_rows(S, k, reference) {
    if reference == "" {
        return;
    }
    let (ok, definition) = script::attempt(|| assets::load(reference));
    let shader = if ok && definition is Object {
        definition.get("shader").unwrap_or("")
    } else {
        ""
    };
    if shader != "" {
        shader_row(S, k, reference, shader);
        feature_rows(S, k, reference, util::obj(util::obj(definition).get("features").unwrap_or(#{})));
    }
    for p in render::material_params(reference) {
        material_row(S, k, reference, p["name"], p["type"], p["value"]);
    }
}

/// Which `.wesl` the material draws with: a picker over the project's own
/// shaders, and a click on the name opens it in the code pane.
fn shader_row(S, k, reference, shader) {
    // By leaf: an inlined material's `shader` is the absolute path the mirror
    // resolved, and what a person picks from is the file's name.
    let choices = [];
    for f in model::list(S, "shaders") {
        if !f.is_dir && f.name.ends_with(".wesl") {
            choices.push(f.name);
        }
    }
    let current = util::last_segment(shader);
    if !util::contains(choices, current) {
        choices.insert(0, current);
    }
    row(S, k, "  Shader", || {
        if ui::pill(icons::ui("open"), #{
            role: "icon_button", min_width: 22, height: 24,
            tooltip: "Edit " + current, fill: k.sage_soft, color: k.sage,
        }) {
            S.shader_rel = model::relative_file(S, shader);
            S.doctab = "script";
        }
        ui::add_space(4);
        let (picked, changed) = ui::dropdown(
            format!("shader:{}", reference), current, choices,
            #{ width: control_w(S) - 26.0, size: style::SM, height: 24, color: k.text },
        );
        if changed && picked != current {
            write_material_key(S, reference, "shader", "shaders/" + picked);
        }
    });
}

/// The `@if` flags the shader declares, as toggles. A material naming one the
/// shader does not have is what the flag list is read from, so a hand-written
/// feature still shows.
fn feature_rows(S, k, reference, features) {
    for name in util::keys_sorted(features) {
        let on = features[name] == true;
        row(S, k, "  @" + name, || {
            let (v, changed) = ui::toggle(on, #{ role: "toggle",
                on_fill: k.accent_fill, off_fill: k.sunken,
                on_knob: k.on_accent, off_knob: k.faint,
            });
            if changed {
                write_material_feature(S, reference, name, v);
            }
        });
    }
}

/// Write one top-level key of a `material` asset.
fn write_material_key(S, reference, key, value) {
    let (ok, definition) = script::attempt(|| assets::load(reference));
    if !ok || !(definition is Object) {
        log::warn(format!("cannot read the material {}", reference));
        return;
    }
    definition[key] = value;
    let (written, err) = script::attempt(|| assets::save(reference, definition));
    if !written {
        log::warn(format!("cannot write {}: {:?}", reference, err));
    }
}

fn write_material_feature(S, reference, name, on) {
    let (ok, definition) = script::attempt(|| assets::load(reference));
    if !ok || !(definition is Object) {
        return;
    }
    let features = util::obj(definition.get("features").unwrap_or(#{}));
    features[name] = on;
    definition["features"] = features;
    let (written, err) = script::attempt(|| assets::save(reference, definition));
    if !written {
        log::warn(format!("cannot write {}: {:?}", reference, err));
    }
}

fn material_row(S, k, reference, name, datatype, value) {
    // Indented, because these belong to the row above rather than the node.
    tip_row(S, k, "  " + util::prop_label(name), util::prop_label(name), || {
        if datatype == "color" {
            let (rgba, changed) = ui::color(#{ value: util::vec(value) });
            if changed {
                write_material_param(S, reference, name, rgba);
            }
        } else if datatype == "float" {
            let (v, changed) = value_field(k, util::f(value), #{ decimals: 3 });
            if changed {
                write_material_param(S, reference, name, v);
            }
        } else if datatype == "texture" {
            // A slot names an image, or nothing: the picker is over what the
            // project has under `art/`, plus the choice of no map at all.
            let current = if value is String { value } else { "" };
            let choices = ["none"];
            for f in model::list(S, "art") {
                if !f.is_dir {
                    choices.push("art/" + f.name);
                }
            }
            let (picked, changed) = ui::dropdown(
                format!("mat:{}:{}", reference, name),
                if current == "" { "none" } else { current },
                choices,
                #{ width: control_w(S), size: style::MD, height: 24, color: k.text },
            );
            if changed {
                write_material_param(S, reference, name, if picked == "none" { "" } else { picked });
            }
        } else {
            let count = if datatype == "vec2" { 2 } else { 3 };
            let letters = ["x", "y", "z"];
            let w = CONTROL_W / (count as f64) - 5.0;
            let v = util::vec(value);
            let cell = #{ changed: false, out: [] };
            for i in 0..count {
                cell.out.push(match v.get(i) { Some(x) => util::f(x), None => 0.0 });
                let (nv, ch) = ui::drag_value(cell.out[i], #{
                    width: w, speed: 0.02, decimals: 3,
                    prefix: letters[i], prefix_color: k.accent,
                    fill: k.sunken, stroke: k.line, color: k.text,
                });
                if ch {
                    cell.out[i] = nv;
                    cell.changed = true;
                }
            }
            if cell.changed {
                write_material_param(S, reference, name, cell.out);
            }
        }
    });
}

// Write one value into the material's `[params]` table. Saving is what
// relinks it, so a dragged value shows in the viewport.
fn write_material_param(S, reference, name, value) {
    let (ok, definition) = script::attempt(|| assets::load(reference));
    if !ok || !(definition is Object) {
        log::warn(format!("cannot read the material {}: {:?}", reference, definition));
        return;
    }
    let params = match definition.get("params") {
        Some(existing) => existing,
        None => #{},
    };
    // An empty texture slot is cleared rather than written as "": a param
    // naming no file is not a param.
    if value is String && value == "" {
        params.remove(name);
    } else {
        params[name] = value;
    }
    definition["params"] = params;
    let (written, err) = script::attempt(|| assets::save(reference, definition));
    if !written {
        log::warn(format!("cannot write {}: {:?}", reference, err));
    }
}

// Anything with no registered editor: its text, straight through.
fn edit_text(S, k, comp, prop, spec, value) {
    push(S, #{ label: util::prop_label(prop), tooltip: prop_tip(prop, spec), controls: [#{
        kind: "field", grow: 1, role: "field",
        text: model::relative_file(S, as_text(value)),
        placeholder: "— empty —",
        on: |text| { write(S, comp, prop, text); },
    }] });
}

fn fixed(v, decimals) {
    match decimals {
        0 => format!("{:.0}", v),
        1 => format!("{:.1}", v),
        3 => format!("{:.3}", v),
        4 => format!("{:.4}", v),
        _ => format!("{:.2}", v),
    }
}

// A `readonly` property is engine output (widget.clicked): a write here would
// be overwritten next frame, so it renders as a plain value with nothing to
// focus.
fn readonly_text(spec, value) {
    let datatype = spec["type"];
    if datatype == "float" {
        fixed(shown_as(spec, if value is Tuple { 0.0 } else { util::f(value) }),
            util::i(spec.get("decimals").unwrap_or(2)))
    } else if datatype == "bool" {
        if value == true { "true" } else { "false" }
    } else if datatype == "vec2" || datatype == "vec3" || datatype == "color" {
        let count = if datatype == "color" { 4 } else if datatype == "vec2" { 2 } else { 3 };
        let v = util::vec(value);
        let parts = [];
        for i in 0..count {
            let fallback = if datatype == "color" { 1.0 } else { 0.0 };
            let held = match v.get(i) { Some(x) => util::f(x), None => fallback };
            parts.push(format!("{:.2}", shown_as(spec, held)));
        }
        util::join(parts, ", ")
    } else {
        as_text(value)
    }
}

fn readonly_row(S, k, prop, spec, data) {
    let value = match data.get(prop) {
        Some(value) => value,
        None => spec.get("default").unwrap_or(()),
    };
    spec_row(S, k, prop, spec, || {
        // A read-only value is whatever the component reports, a joined list
        // included: it gets the column, and an ellipsis past its end.
        ui::horizontal(#{ height: 24, width: control_w(S) - 62.0 }, || {
            ui::label(readonly_text(spec, value),
                util::merge(style::mono(k.faint), #{ truncate: true }));
        });
        ui::right(|| {
            ui::label("read-only", #{ size: style::SM, color: k.faint });
        });
    });
}

// A pointer at the Events view, in place of a section no derived editor can
// draw: the rows are tables, not properties.
fn bindings_note(S, k) {
    section(S, k, "BINDINGS");
    wide_row(S, 26, || {
        ui::horizontal(#{ height: 24 }, || {
            ui::add_space(2);
            if ui::pill(format!("{}  {} row(s) · open the Events view",
                icons::ui("events"), crate::events::rows(S).len()), #{
                height: 24, size: style::SM, align: ui::ALIGN_LEFT,
                min_width: panel_w(S) - 16.0,
                fill: k.sunken, color: k.text,
            }) {
                shell::open_doc(S, "events");
            }
        });
    });
}

/// The node's components with each above the ones it needs, so the transform a
/// body and a bone both expect sits under them rather than over them.
///
/// Kahn's order over `expects`: a component is drawn once nothing left still
/// needs it. A cycle keeps registration order for what is left of it rather
/// than dropping those sections.
fn ordered_components(S, names) {
    let waiting = #{};
    for name in names {
        waiting[name] = 0;
    }
    for name in names {
        for need in model::expects(S, name) {
            if waiting.contains_key(need) {
                waiting[need] = waiting[need] + 1;
            }
        }
    }
    let out = [];
    let left = names;
    for _ in 0..names.len() {
        if left.is_empty() {
            break;
        }
        let ready = [];
        let held = [];
        for name in left {
            if waiting[name] == 0 {
                ready.push(name);
            } else {
                held.push(name);
            }
        }
        if ready.is_empty() {
            for name in held {
                out.push(name);
            }
            return out;
        }
        for name in ready {
            out.push(name);
            for need in model::expects(S, name) {
                if waiting.contains_key(need) {
                    waiting[need] = waiting[need] - 1;
                }
            }
        }
        left = held;
    }
    out
}

// One auto-generated section per component present on the node.
// `filter` limits which components a persona shows (`None` = all).
fn component_sections(S, k, filter) {
    let found = match model::live(S, S.sel) {
        Some(found) => found,
        None => return,
    };
    // Advisory only: the component is applied and working as far as the
    // engine is concerned, but it has nothing to act on yet.
    let unmet = #{};
    for warning in util::vec(scene::unmet_expectations(found)) {
        unmet[warning.component] = util::join(util::vec(warning.expects), ", ");
    }
    let query = crate::search::query(S, "inspector");
    for comp in ordered_components(S, util::vec(found.component_names())) {
        let shown = match filter {
            Some(filter) => util::contains(filter, comp),
            None => true,
        };
        if !shown {
            continue;
        }
        // Its rows are a table of tables, which no derived editor can draw
        // and the Events view already draws properly.
        if comp == "bindings" {
            bindings_note(S, k);
            continue;
        }
        // The component's name and every property it has, so a query for a
        // property finds the section that holds it.
        let props = util::join(util::keys_sorted(S.schemas.get(comp).unwrap_or(#{})), " ");
        if !crate::search::matches(query, format!("{} {}", comp, props)) {
            continue;
        }
        let key = format!("inspector/{}", comp);
        let open = !S.collapsed.contains_key(key);
        let held = comp;
        let (mark, tint) = icons::component(held);
        wide_row(S, 24, || {
            ui::horizontal(#{ height: 20 }, || {
                ui::add_space(2);
                ui::label(if open { icons::ui("caret-open") } else { icons::ui("caret-shut") },
                    #{ size: style::SM, color: k.faint });
                ui::add_space(4);
                if ui::pill(held.to_uppercase(), util::merge(style::heading(k), #{
                    icon: mark, icon_size: style::MD, icon_color: k.get(tint).unwrap_or(k.dim), height: 20,
                    align: ui::ALIGN_LEFT, radius: 4,
                })) {
                    if open {
                        S.collapsed[key] = true;
                    } else {
                        S.collapsed.remove(key);
                    }
                }
                ui::right(|| {
                    ui::add_space(2);
                    if ui::pill(icons::ui("close"), #{
                        height: 20, size: style::SM, strong: true, tooltip: "Remove component",
                        fill: k.sunken, color: k.faint,
                    }) {
                        model::remove_component(S, held);
                    }
                });
            });
        });
        if !open {
            continue;
        }
        if let Some(needs) = unmet.get(comp) {
            wide_row(S, 34, || {
                ui::label(format!("⚠ needs one of: {}", needs), #{
                    size: style::SM, color: k.get("warn").unwrap_or(k.faint), wrap: true,
                });
            });
        }
        let schema = model::schema(S, comp);
        let data = util::obj(found.get_component(comp));
        let grouped = #{};
        let order = [];
        for prop in util::keys_sorted(schema) {
            let spec = schema[prop];
            let group = spec.get("group").unwrap_or("");
            if group == "" {
                property_row(S, k, comp, prop, spec, data);
                continue;
            }
            if !grouped.contains_key(group) {
                grouped[group] = [];
                order.push(group);
            }
            grouped[group].push(prop);
        }
        order.sort();
        for group in order {
            if !subsection(S, k, comp, group, grouped[group].len()) {
                continue;
            }
            for prop in grouped[group] {
                property_row(S, k, comp, prop, schema[prop], data);
            }
        }
    }
}

fn events_section(S, k) {
    let node = model::selected_node(S);
    if !section(S, k, "Events") {
        return;
    }
    let script = match model::script_rel(node) {
        Some(script) => script,
        None => {
            wide_row(S, 26, || {
                style::empty(k, "no script attached");
            });
            return;
        }
    };
    for hook in model::hooks(S, script) {
        let held = hook;
        wide_row(S, 26, || {
            style::hook_pill(k, held.name, held.name + "()", "→ engine");
        });
    }
}

pub fn body(S, k) {
    let node = model::selected_node(S);
    ui::add_space(2);
    ui::horizontal(#{ height: 24 }, || {
        let (icon, token) = model::node_icon(node);
        ui::label(icon, #{ size: style::LG, color: k.get(token).unwrap_or(k.accent) });
        ui::add_space(7);
        // One line: the name, then its type beside it. The panel is narrow
        // and a second row was a whole line of height for four words.
        ui::label(node.name, #{
            size: style::LG, font: ui::FONT_HEADING, strong: true, color: k.text, truncate: true,
        });
        ui::add_space(6);
        ui::label(model::node_type(node),
            util::merge(style::mono_sm(k.faint), #{ truncate: true }));
    });
    multi_note(S, k);
    ui::add_space(3);
    crate::search::field(S, k, "inspector", "Search", panel_w(S) - 16.0);
    // Every row is a node now: the sections describe them, and the pool makes
    // and reuses them under the sheet's scroll.
    open_form(S);
    instance_note(S, k);
    instance_source_row(S, k, node);
    if S.persona == "phys" {
        component_sections(S, k, Some(["body", "collider", "body2d", "collider2d"]));
        polygon_section(S, k);
        script_section(S, k, "Script");
    } else if S.persona == "script" {
        script_section(S, k, "Attached script");
    } else if S.persona == "anim" {
        skeleton_section(S, k);
        polygon_section(S, k);
        animation_section(S, k);
        component_sections(S, k, Some(["animation", "bone2d", "bone3d", "polygon", "transform"]));
        script_section(S, k, "Script");
    } else if S.persona == "ui" {
        component_sections(S, k, Some(["widget"]));
        interface_section(S, k);
        script_section(S, k, "Script");
    } else {
        skeleton_section(S, k);
        polygon_section(S, k);
        component_sections(S, k, None);
        script_section(S, k, "Script");
    }
    events_section(S, k);
    crate::plugins::draw_sections(S, k, node);
    crate::pool::sync(S, FORM_NODE, S.form, label_w(S), control_w(S));
}

/// The one control under the scroll, so a long form cannot push it away.
pub fn foot_controls(S) {
    [#{
        kind: "button", role: "button", height: 30,
        width: S.layout.right.w - 26.0,
        icon: icons::ui("add"), text: "Add component",
        on: |_| { shell::open_palette(S, "add "); },
    }]
}
