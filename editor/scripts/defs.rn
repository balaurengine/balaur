
use crate::icons;

pub fn personas() {
    [
        #{ id: "scene", name: "Scene", icon: icons::persona("scene") },
        #{ id: "script", name: "Script", icon: icons::persona("script") },
        #{ id: "anim", name: "Animate", icon: icons::persona("anim") },
        #{ id: "phys", name: "Physics", icon: icons::persona("phys") },
        #{ id: "ui", name: "Interface", icon: icons::persona("ui") },
    ]
}

/// The panels a persona opens, per dock, and which of them it brings
/// forward. A persona says what to have open, not what may be opened: the
/// logo menu adds and the tab marks close whatever the work needs after that.
pub fn persona_docks(id) {
    match id {
        "script" => docks(["scene", "outline"], ["output", "problems", "docs", "debugger"], ["inspector"]),
        "anim" => docks(["scene", "outline"], ["timeline", "output", "library"], ["inspector"]),
        "phys" => docks(["scene"], ["output", "problems", "profiler"], ["inspector"]),
        "ui" => docks(["scene", "outline"], ["output", "problems", "assets"], ["inspector", "import"]),
        _ => docks(["scene", "outline"], ["output", "problems", "assets"], ["inspector", "import"]),
    }
}

fn docks(left, bottom, right) {
    #{
        left: #{ tabs: left, active: left[0], shut: false },
        bottom: #{ tabs: bottom, active: bottom[0], shut: false },
        right: #{ tabs: right, active: right[0], shut: false },
    }
}

pub fn persona_name(id) {
    for p in personas() {
        if p.id == id {
            return p.name;
        }
    }
    id
}

// Only tools something reads: a button that sets `S.tool` and is then ignored
// advertises an editor that does not exist. Re-add each on its `gizmo` handler.
pub fn tools(persona) {
    match persona {
        "scene" => ["select", "move", "rotate", "scale", "pen", "tiles", "zoom"],
        "anim" => ["select", "move", "bone", "polygon", "key", "zoom"],
        "phys" => ["select", "move", "polygon", "zoom"],
        "ui" => ["select", "move", "zoom"],
        _ => [],
    }
}

pub fn tool_name(tool) {
    match tool {
        "select" => "Select",
        "move" => "Translate",
        "rotate" => "Rotate",
        "scale" => "Scale",
        "zoom" => "Zoom",
        "key" => "Key frame",
        "bone" => "Rig bone",
        "polygon" => "Polygon",
        "pen" => "Pen",
        "tiles" => "Tiles",
        _ => tool,
    }
}

pub fn tool_icon(tool) {
    icons::tool(tool)
}

// Viewport overlay chips per persona: `[key, label, default_on]`. A chip with
// no third entry is engine-backed: `shell::chip_value` reads it live each frame.
pub fn chips(persona) {
    match persona {
        "scene" => [["proj", "3D · Perspective", true], ["snap", "Snap 8 px", false], ["guides", "Guides", false], ["lights", "Lights", true]],
        "anim" => [["path", "Motion path", true], ["snap", "Snap 8 px", false]],
        "phys" => [["colliders", "Show colliders", true], ["sleep", "Sleep bodies"]],
        "ui" => [["safe", "Safe area", true], ["res", "1920 × 1080", false]],
        _ => [],
    }
}
