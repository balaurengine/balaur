// The editor's verbs on its state `S`: selection, personas, play, the
// palette, breakpoints, the pause, and the start-up states.

use crate::anim;
use crate::history;
use crate::model;
use crate::theme;
use crate::util;

/// The debugger's own state, hung on `S.debug`. `demo` drives the breakdemo
/// self-test's step/continue alternation.
pub fn debug_state() {
    #{ frame: 0, breakpoints: #{}, paused: (), paused_rel: "", demo: None }
}

pub fn choose(S, i) {
    if i != S.sel {
        history::commit(S);
    }
    S.sel = i;
}

// History owns the document; the mirror is rebuilt from it here, because
// history must not depend on `model` (model records into history).
fn step(S, label, moved) {
    let moved = match moved {
        Some(moved) => moved,
        None => {
            log::info(format!("nothing to {}", label));
            return;
        }
    };
    // Rebuilding stops play, so read the flag before it is cleared: a
    // keystroke aimed at the document should not silently kill the game.
    let was_playing = S.playing;
    crate::session::end(S, "stop");
    model::build_mirror(S);
    if was_playing {
        log::info(format!("{} stopped the running scene", label));
    }
    theme::apply(S);
    apply_camera(S);
    log::info(format!("{}: {}", label, moved));
}

pub fn undo(S) {
    step(S, "undo", history::undo(S));
}

pub fn redo(S) {
    step(S, "redo", history::redo(S));
}

pub fn set_persona(S, id) {
    S.persona = id;
    S.tool = "select";
    S.doctab = if id == "script" { "script" } else { "scene" };
    crate::docks::show(S, if id == "anim" { "timeline" } else { "output" });
}

// Show the code and the viewport at once, or go back to one at a time. The
// split is only ever drawn over a document, so turning it on opens one.
pub fn toggle_split(S) {
    S.split = !S.split;
    if S.split && S.doctab == "events" {
        S.doctab = "scene";
    }
}

pub fn set_zoom(S, z) {
    S.zoom = util::clamp(z, 25.0, 400.0);
    apply_camera(S);
}

pub fn open_palette(S, query) {
    S.palette = true;
    S.palette_query = query;
    // Dropped on every opening, so a component a reloaded plugin registered is
    // in the list the next time it is asked for.
    S.palette_cache = ();
    ui::set_text("palette-query", query);
}

pub fn set_ui_scale(S, f) {
    S.ui_scale = util::clamp(f, 0.75, 2.5);
    ui::set_scale(S.ui_scale);
}

pub fn close_palette(S) {
    S.palette = false;
}

pub fn toggle_play(S) {
    if S.playing {
        stop_play(S);
    } else {
        // Recording starts before the scripts attach: an `init` that opens a
        // socket belongs inside the session, and one that takes an await
        // token has to take the id the replay will hand back.
        crate::session::start(S);
        // Real play-in-editor: attach the game's scripts to the mirrored
        // nodes (their init sets up physics etc.), then run.
        model::attach_game_scripts(S);
        S.playing = true;
        crate::docks::show(S, "output");
        physics::set_paused(false);
        // The mirror was built with every player held (model::build_mirror);
        // play is what lets the engine advance them.
        anim::resume_all(S);
        log::info("play: running " + S.game_name);
    }
}

pub fn stop_play(S) {
    if S.playing {
        log::info("stop: scene reset");
    }
    crate::session::end(S, "stop");
    model::build_mirror(S);
    // The game may have restyled the viewport (background, camera).
    theme::apply(S);
    apply_camera(S);
}

// Viewport chip side effects (chips themselves live in center.rn).
pub fn on_chip(S, persona, key, value) {
    if persona == "phys" && key == "sleep" {
        physics::set_sleeping_allowed(value);
    }
}

// The other half of the pair: chips that command the engine read their
// state back from it, so nothing is mirrored in `S.chip_state`. `None` for a
// chip the editor owns outright.
pub fn chip_value(S, persona, key) {
    if persona == "phys" && key == "sleep" {
        return Some(physics::sleeping_allowed());
    }
    None
}

// Breakpoints are kept per game-relative script path; the host keys the
// same file by the absolute path play attaches it under.
pub fn breakpoint_lines(S, rel) {
    let lines = util::vec(S.debug.breakpoints.get(rel).unwrap_or([]));
    lines.sort();
    lines
}

pub fn toggle_breakpoint(S, rel, line) {
    let lines = breakpoint_lines(S, rel);
    let kept = [];
    let had = false;
    for l in lines {
        if l == line {
            had = true;
        } else {
            kept.push(l);
        }
    }
    if !had {
        kept.push(line);
    }
    // The host reports where each request landed: a blank line moves to the
    // next line with code.
    S.debug.breakpoints[rel] = util::vec(debugger::set_breakpoints(S.game_root + "/" + rel, kept));
}

// Game-relative path of a script the host reports by absolute key.
pub fn script_rel(S, path) {
    let prefix = S.game_root + "/";
    if path.starts_with(prefix) {
        return path[prefix.len()..];
    }
    path
}

// The pause is over the moment it is asked to go; the poll would only
// notice next frame, and a pause that follows at once must read as new.
pub fn resume(S, mode) {
    debugger::resume(mode);
    S.debug.paused = ();
}

// A fresh pause: show the script and the frame it stopped in.
pub fn on_pause(S, p) {
    S.debug.paused_rel = script_rel(S, p.path);
    S.debug.frame = 0;
    let stopped = p.node.path();
    for (i, node) in S.doc.iter().enumerate() {
        let same = match model::live(S, i) {
            Some(found) => found.path() == stopped,
            None => false,
        };
        if same || node.get("script") == Some(S.debug.paused_rel) {
            choose(S, i);
            break;
        }
    }
    set_persona(S, "script");
    crate::docks::show(S, "debugger");
    log::info(format!("paused at {}:{} ({})", S.debug.paused_rel, p.line, p.reason));
}

pub fn attach_script(S) {
    let node = S.doc[S.sel];
    if node.contains_key("script") {
        return;
    }
    let path = "scripts/" + node.name.to_lowercase() + ".rn";
    let abs = S.game_root + "/" + path;
    if !fs::exists(abs) {
        fs::write(abs, "pub fn init(this) {\n}\n\npub fn update(this, dt) {\n}\n");
    }
    history::record(S, "attach script", None);
    model::forget(S, None);
    node.script = path;
    log::info("attached " + path + " (undo detaches it; the file stays)");
}

const BASE_EYE = [9.0, 6.0, 13.0];
const TARGET = [0.0, 1.0, 0.0];

pub fn apply_camera(S) {
    if model::is_2d(S) {
        // Keep the current pan; zoom in logical px per world unit.
        let (cx, cy, _) = render::camera_2d();
        render::set_camera_2d(cx, cy, 55.0 * S.zoom / 100.0);
        return;
    }
    let scale = 100.0 / S.zoom;
    render::set_camera(
        TARGET[0] + (BASE_EYE[0] - TARGET[0]) * scale,
        TARGET[1] + (BASE_EYE[1] - TARGET[1]) * scale,
        TARGET[2] + (BASE_EYE[2] - TARGET[2]) * scale,
        TARGET[0], TARGET[1], TARGET[2],
    );
}

// Draw what a shader's line computes, for every pixel that reaches it.
// Clicking the marked line again puts the picture back.
pub fn toggle_shader_preview(S, rel, line) {
    if S.preview_line == line && S.preview_rel == rel {
        S.preview_line = 0;
        S.preview_rel = "";
        render::set_shader_preview("", 0);
    } else {
        S.preview_line = line;
        S.preview_rel = rel;
        render::set_shader_preview(rel, line);
    }
}

// cmd+S saves the visible script buffer when the code editor is open, the
// scene document otherwise.
pub fn save_active(S) {
    // A shader is not a script: it is written and the watcher relinks the
    // materials naming it, with no unit to rebuild.
    if S.shader_rel != "" && S.doctab == "script" {
        let abs = S.game_root + "/" + S.shader_rel;
        if let Some(buffer) = S.script_buffers.get(abs) {
            fs::write(abs, buffer);
            S.script_dirty.remove(abs);
            // The watcher covers the editor's own root, not the game's.
            assets::invalidate();
            log::info("saved " + S.shader_rel);
        }
        return;
    }
    let node = S.doc[S.sel];
    let in_script = (S.persona == "script" || S.doctab == "script") && node.contains_key("script");
    if in_script {
        let rel = model::script_rel(node).unwrap_or("");
        let abs = S.game_root + "/" + rel;
        if let Some(buffer) = S.script_buffers.get(abs) {
            fs::write(abs, buffer);
            model::forget(S, Some(rel));
            S.script_dirty.remove(abs);
            // A recording cannot survive its own code changing: the frames
            // after a reload came from a different game. The session ends
            // here, and what it caught until now is kept.
            crate::session::end(S, "reload");
            // The reload is also the compile: it builds the unit whether or
            // not the script is live, and leaves the old one running on a
            // failure, so a save that does not compile can say so.
            let (ok, err) = script::attempt(|| engine::reload_script(abs));
            // A save is the one moment the whole project is known good or
            // not; the idle sweep only catches up to it.
            crate::lint::run(S);
            if ok {
                log::info("saved " + rel);
            } else {
                // Rune renders a caret diagram against the absolute key it
                // was given, and `attempt` calls every failure a panic; this
                // one is always a compile error, and the dock is narrow.
                for line in err.split('\n') {
                    let clean = line.replace(S.game_root + "/", "");
                    log::error(clean.replace("Panicked: ", ""));
                }
            }
        }
        return;
    }
    // An external clip is its own file; an inline one rides along with the
    // scene. `anim::save` knows which it is looking at.
    anim::save(S);
    model::save(S);
}

// Rebuild every attached script's unit from disk, the way a save does for the
// one file it wrote. A recording cannot span the change, so it ends first.
pub fn reload_scripts(S) {
    let paths = #{};
    for node in S.doc {
        if let Some(rel) = model::script_rel(node) {
            paths[rel] = true;
        }
    }
    crate::session::end(S, "reload");
    model::forget(S, None);
    let done = 0;
    for rel in util::keys_sorted(paths) {
        let abs = S.game_root + "/" + rel;
        let (ok, err) = script::attempt(|| engine::reload_script(abs));
        if ok {
            done += 1;
        } else {
            for line in err.split('\n') {
                let clean = line.replace(S.game_root + "/", "");
                log::error(clean.replace("Panicked: ", ""));
            }
        }
    }
    crate::lint::run(S);
    log::info(format!("reloaded {} of {} script(s)", done, paths.len()));
}

fn select_named(S, name) {
    for (i, node) in S.doc.iter().enumerate() {
        if node.name == name {
            S.sel = i;
        }
    }
}

// One handler per start-up state, looked up rather than branched on, so a
// self-test or a plugin registers its own.
fn states() {
    #{
        "palette": state_palette,
        "light": state_light,
        "play": state_play,
        "input": state_input,
        "animdemo": state_animdemo,
        "layoutdemo": crate::selftest::layout,
        "fontdemo": state_fontdemo,
        "undodemo": crate::selftest::undo,
        "breakdemo": break_demo,
        "rigdemo": crate::selftest::rigging,
        "polydemo": crate::selftest::polygons,
        "clipdemo": crate::selftest::clipboard,
        "assetdemo": crate::selftest::assets,
        "pickdemo": crate::selftest::picking,
        "propsdemo": crate::selftest::script_props,
        "instancedemo": crate::selftest::instances,
        "timingsdemo": crate::selftest::timings,
        "placedemo": crate::selftest::placing,
        "lintdemo": crate::selftest::linting,
        "sessiondemo": crate::selftest::sessions,
        "themedemo": crate::selftest::theme_switch,
        "settingsdemo": crate::selftest::settings_screen,
        // The editor's half of the plugin seam; `counter.rn` registers the
        // plugin's half under the same name and both run.
        "counterdemo": crate::selftest::plugin_docks,
        "settings": crate::settings::open,
    }
}

// States written `<prefix><argument>`, which take the rest of the string.
fn prefixed_states() {
    [
        ("find:", state_find),
        ("settings?", state_settings_search),
        ("settings:", state_settings),
        ("shot=", state_shot),
        ("frames=", state_frames),
        ("show:", state_show),
        ("tool:", state_tool),
        ("dock:", state_dock),
        ("tab:", state_tab),
        ("shut:", state_shut),
        ("scale:", state_scale),
        ("move:", state_move),
        ("mode:", state_mode),
        ("select:", state_select),
        ("zoom:", state_zoom),
    ]
}

fn state_settings(S, category) {
    crate::settings::open_at(S, category);
}

fn state_settings_search(S, query) {
    crate::settings::open_search(S, query);
}

// `find:<query>` fills the scene tree's search, for a screenshot.
fn state_find(S, query) {
    S.search["tree"] = query;
}

// One start-up state, mirroring the design prototype's startPersona prop. A
// plugin may extend a built-in state rather than replace it, so both run.
pub fn apply_start_state(S, start) {
    for (prefix, run) in prefixed_states() {
        if start.starts_with(prefix) {
            run(S, start[prefix.len()..]);
            return;
        }
    }
    let ran = false;
    match states().get(start) {
        Some(run) => {
            run(S);
            ran = true;
        }
        None => (),
    }
    match crate::plugins::start_state(S, start) {
        Some(run) => {
            run(S);
            ran = true;
        }
        None => (),
    }
    if !ran && start != "" {
        state_persona(S, start);
    }
}

// Screenshot the shell once the first frames have laid it out, for a visual
// check of an editor state a headless run cannot show.
fn state_shot(S, path) {
    S.shot = Some(path);
}
// Every other frame from frame 30, so a clip is 30 fps and skips the frames
// the layout takes to settle.
fn state_frames(S, dir) {
    fs::mkdir(dir);
    S.capture = #{ dir: dir, from: 30, every: 2, n: 0 };
}
fn state_input(S) {
    S.show_input = true;
}
fn state_show(S, name) {
    crate::showcase::start(S, name);
}

fn state_tool(S, tool) {
    S.tool = tool;
}

// `tab:<id>` picks a document tab; `tab:split` opens the code beside the
// viewport. Both are shell state a screenshot cannot otherwise reach.
fn state_tab(S, tab) {
    if tab == "split" {
        S.split = true;
    } else {
        S.doctab = tab;
    }
}

fn state_fontdemo(S) {
    S.fontdemo = true;
}

// `scale:<f>`: the UI scale, which is what decides how many design pixels the
// window has. A narrow layout is reachable no other way from a fixed capture.
fn state_scale(S, arg) {
    let (ok, v) = script::attempt(|| json::parse(arg));
    if ok {
        set_ui_scale(S, util::f(v));
    }
}

fn state_shut(S, side) {
    if side == "rail" {
        S.rail_shut = true;
        return;
    }
    S.docks[side].shut = true;
}

// `move:<panel>:<side>`: put a panel in another dock, as its tab menu does.
fn state_move(S, arg) {
    let parts = arg.split(':').collect::<Vec>();
    if parts.len() == 2 {
        crate::docks::move_to(S, parts[0], parts[1]);
    }
}

fn state_dock(S, dock) {
    crate::docks::show(S, dock);
}

fn state_mode(S, mode) {
    crate::polygon::set_mode(S, mode);
}

// Self-test state: select a node by name (e.g. select:Pig1).
fn state_select(S, name) {
    select_named(S, name);
}
fn state_zoom(S, pct) {
    let (ok, v) = script::attempt(|| json::parse(pct));
    set_zoom(S, if ok { util::f(v) } else { 100.0 });
}

fn state_palette(S) {
    open_palette(S, "");
}

fn state_light(S) {
    theme::set_dark(S, false);
}

fn state_play(S) {
    toggle_play(S);
}

// Self-test state: author a clip on the Spinner when the mirror resolved it,
// otherwise on any resolved node — keying reads a live transform.
fn state_animdemo(S) {
    let pick = None;
    for (i, node) in S.doc.iter().enumerate() {
        if model::live(S, i).is_some() && (pick.is_none() || node.name == "Spinner") {
            pick = Some(i);
        }
    }
    match pick {
        None => log::warn("animdemo: the mirror resolved no node to animate"),
        Some(i) => {
            S.sel = i;
            anim::ensure_clip(S);
            anim::add_key(S, 0.0);
            let (_, found) = model::selected(S);
            let found_some = found;
            if let Some(found) = found_some {
                found.set_position(2.5, 2.5, 0.0);
                found.set_rotation_euler(0.0, math::rad(180.0), 0.0);
                anim::add_key(S, 1.0);
                found.set_position(2.5, 0.5, 0.0);
                anim::add_key(S, 2.0);
                anim::seek(S, 0.6);
            }
        }
    }
    set_persona(S, "anim");
}

// A bare name is a persona; the script persona also picks a scripted node so
// the centre pane has something to show.
fn state_persona(S, name) {
    set_persona(S, name);
    if name == "script" {
        for (i, node) in S.doc.iter().enumerate() {
            if node.contains_key("script") {
                S.sel = i;
                break;
            }
        }
    }
}

// Self-test state: a breakpoint on the first scripted node's update, then
// play; `update` alternates a step and a continue on every pause.
pub fn break_demo(S) {
    for (i, node) in S.doc.iter().enumerate() {
        let script_some = node.get("script");
        if let Some(script) = script_some {
            S.sel = i;
            let text = model::source(S, script).unwrap_or("");
            let (_, hooks) = crate::highlight::analyze(text);
            for hook in hooks {
                if hook.name == "update" {
                    toggle_breakpoint(S, script, hook.line + 1);
                }
            }
            break;
        }
    }
    S.debug.demo = Some(0);
    toggle_play(S);
}
