// The Weights dock: the picked vertices as a table, one number per bone,
// editable in place, with the five verbs a rigger reaches for. Everything
// here writes through `history`, so one undo takes back a whole Normalise.

use editor;
use form;
use history;
use model;
use polygon;
use rig;
use signals;
use themewin;
use util;
use words::fields;
use words::geometry_fields;
use words::layout_fields;
use words::panel_keys;
use words::project_fields;
use words::roles;
use words::theme_tokens;

const ALL: str = "all";
const AUTO: str = "auto";
const BIND: str = "bind";
const NORMALIZE: str = "normalize";
const SMOOTH: str = "smooth";
const UNBIND: str = "unbind";
const WEIGHTS: str = "weights";

pub class WeightsState {
    editing: int?,
}

// The mesh under edit, its bones, and the vertices listed.
struct Table {
    mesh: any,
    bones: any,
    at: [int],
}

const NAME_WIDTH: float = 92.0;

const CELL_WIDTH: float = 58.0;

const ROW_HEIGHT: float = 22.0;

// A weight under this is noise from a brush pass and is dropped rather than
// written; four decimals is already more than a rig needs.
const EPSILON: float = 0.0005;

/// The dock's own state, hung on `state.weights`.
pub fn state() -> WeightsState {
    WeightsState { editing: nil }
}

// The table, or nil when the selection is not a weighted polygon.
fn table(state: editor::State) -> Table? {
    let mesh = polygon::mesh(state);
    if mesh == nil {
        return nil;
    }
    let bones = polygon::bones(state);
    if bones.len() == 0 {
        return nil;
    }
    Table { mesh: mesh, bones: bones, at: polygon::picked(state) }
}

fn weight_of(bone: any, at: int) -> float {
    (util::list_or_empty(bone[geometry_fields::WEIGHTS])[at]).as_float()
}

fn set_weight(bone: any, at: int, value: float) {
    if bone[geometry_fields::WEIGHTS].kind() != types::KIND_LIST {
        let none: [float] = [];
        bone[geometry_fields::WEIGHTS] = none;
    }
    let weights = bone[geometry_fields::WEIGHTS];
    while weights.len() <= at {
        weights.push(0.0);
    }
    let clamped = util::clamp(value, 0.0, 1.0);
    weights[at] = if clamped < EPSILON { 0.0 } else { clamped };
}

// Every verb records first and pushes the polygon after, the one shape every
// edit in this dock takes: `begin` before the change, `done` after it.
fn begin(state: &mut editor::State, label: str) -> bool {
    if !polygon::editable(state) {
        log::warn("this polygon's mesh is a file; embed it to edit its weights");
        return false;
    }
    history::record(state, label);
    true
}

fn done(state: &mut editor::State) {
    polygon::write(state);
    signals::changed(state, WEIGHTS);
}

// Bind: give every listed vertex all of its weight to the active bone.
pub fn bind(state: &mut editor::State) {
    let maybe_listing = table(state);
    if maybe_listing == nil {
        return;
    }
    let listing = maybe_listing.unwrap();
    if state.polygon.bone == nil {
        log::warn("pick a bone in the inspector before binding to it");
        return;
    }
    let active = state.polygon.bone.unwrap();
    if !begin(state, "bind vertices") {
        return;
    }
    for at in listing.at {
        for bone_index in 0..listing.bones.len() {
            set_weight(listing.bones[bone_index], at, if bone_index == active { 1.0 } else { 0.0 });
        }
    }
    done(state);
    log::info("{listing.at.len()} vertices bound to {listing.bones[active]["path"]}");
}

// Unbind: take the listed vertices off every bone, so they ride the node.
pub fn unbind(state: &mut editor::State) {
    let maybe_listing = table(state);
    if maybe_listing == nil {
        return;
    }
    let listing = maybe_listing.unwrap();
    if !begin(state, "unbind vertices") {
        return;
    }
    for at in listing.at {
        for bone in listing.bones {
            set_weight(bone, at, 0.0);
        }
    }
    done(state);
    log::info("{listing.at.len()} vertices unbound");
}

// Normalise: scale each listed vertex's weights so they sum to one. The
// engine renormalises at load anyway; doing it here is what makes the numbers
// on screen the numbers that will be used.
pub fn normalize(state: &mut editor::State) {
    let maybe_listing = table(state);
    if maybe_listing == nil {
        return;
    }
    let listing = maybe_listing.unwrap();
    if !begin(state, "normalize weights") {
        return;
    }
    for at in listing.at {
        let total = 0.0;
        for bone in listing.bones {
            total += weight_of(bone, at);
        }
        if total <= EPSILON {
            continue;
        }
        for bone in listing.bones {
            set_weight(bone, at, weight_of(bone, at) / total);
        }
    }
    done(state);
}

// Auto: weight each listed vertex by how near it is to each bone's segment —
// the same segment `rig::geometry` draws — falling off with the square of the
// distance, which is what makes a joint blend rather than switch.
pub fn auto(state: &mut editor::State) {
    let maybe_listing = table(state);
    if maybe_listing == nil {
        return;
    }
    let listing = maybe_listing.unwrap();
    let segments = bone_segments(state, listing.bones);
    if segments.len() == 0 {
        log::warn("none of the polygon's bones resolve to a node to measure from");
        return;
    }
    let frame = polygon::world_frame(state);
    if frame == nil || !begin(state, "auto weights") {
        return;
    }
    for at in listing.at {
        let point = polygon::world_point(state, listing.mesh, frame.unwrap(), at);
        let near: [float] = [];
        let total = 0.0;
        for segment in segments {
            let distance = if segment != nil { rig::segment_distance(point, segment.unwrap().origin, segment.unwrap().tip) } else { -1.0 };
            // A vertex sitting on a bone would divide by zero; the floor
            // is a millimetre at the scale a 2D rig is built in.
            let weight = if distance < 0.0 { 0.0 } else { 1.0 / util::max(distance * distance, 1e-6) };
            near.push(weight);
            total += weight;
        }
        for bone_index in 0..listing.bones.len() {
            set_weight(listing.bones[bone_index], at, if total > 0.0 { near[bone_index] / total } else { 0.0 });
        }
    }
    done(state);
    log::info("{listing.at.len()} vertices weighted by distance");
}

// Smooth: replace each listed vertex's weights with the average over itself
// and the vertices sharing an edge with it, once. Repeated clicks blur
// further, which is how a rigger actually uses it.
pub fn smooth(state: &mut editor::State) {
    let maybe_listing = table(state);
    if maybe_listing == nil {
        return;
    }
    let listing = maybe_listing.unwrap();
    let neighbours = edges(listing.mesh);
    if !begin(state, "smooth weights") {
        return;
    }
    // Read the whole table first: smoothing in place would feed each
    // vertex the neighbour that was already smoothed.
    let count = listing.mesh[geometry_fields::POSITIONS].len();
    let was: [[float]] = [];
    for bone in listing.bones {
        let row: [float] = [];
        for vertex in 0..count {
            row.push(weight_of(bone, vertex));
        }
        was.push(row);
    }
    for at in listing.at {
        let ring = util::list_or_empty(neighbours["{at}"]);
        for bone_index in 0..listing.bones.len() {
            let total = was[bone_index][at];
            for neighbour in ring {
                total += was[bone_index][neighbour.as_int()];
            }
            set_weight(listing.bones[bone_index], at, total / ((ring.len() + 1) as float));
        }
    }
    done(state);
}

// Which vertices share an edge with which, from the outline and every drawn
// polygon, keyed by the vertex as text. Built once per call: a mesh here is
// hundreds of vertices, not hundreds of thousands.
fn edges(mesh: any) -> any {
    let out: any = {};
    let outline = mesh[geometry_fields::POSITIONS].len() - polygon::internal_count(mesh);
    for vertex in 0..outline {
        join(out, vertex, if vertex == outline - 1 { 0 } else { vertex + 1 });
    }
    for ring in util::list_or_empty(mesh["polygons"]) {
        for corner in 0..ring.len() {
            join(out, ring[corner].as_int(), ring[if corner == ring.len() - 1 { 0 } else { corner + 1 }].as_int());
        }
    }
    out
}

// `first` and `second` as each other's neighbours.
fn join(out: any, first: int, second: int) {
    for pair in [[first, second], [second, first]] {
        let key = "{pair[0]}";
        if out[key].kind() != types::KIND_LIST {
            let none: [int] = [];
            out[key] = none;
        }
        let ring = out[key];
        let seen = false;
        for neighbour in ring {
            if neighbour.as_int() == pair[1] {
                seen = true;
            }
        }
        if !seen {
            ring.push(pair[1]);
        }
    }
}

// Each bone's world segment, in the polygon's bone order, or nil for one
// whose node is not there.
fn bone_segments(state: editor::State, bones: any) -> [rig::Geometry?] {
    let root = polygon::rig_root(state);
    if !root.is_valid() {
        return [];
    }
    let out: [rig::Geometry?] = [];
    for bone in bones {
        let found = root.get_node(bone[project_fields::PATH].as_str());
        let doc_index = model::index_of_node(state, found);
        out.push(if doc_index != nil { rig::geometry(state, doc_index.unwrap()) } else { nil });
    }
    out
}

// The tab's own scene, under the bottom dock.
const PANEL: str = "Editor/Shell/Body/Centre/Bottom/Weights";

/// Fill the tab from the polygon: the verbs' scope, a head a bone, and a row a
/// listed vertex with a field a weight. Called by its script on a word.
pub fn fill(state: editor::State) {
    let maybe_listing = table(state);
    if maybe_listing == nil {
        util::set_visible(PANEL + "/Missing", true);
        util::set_visible(PANEL + "/Body", false);
        return;
    }
    let listing = maybe_listing.unwrap();
    util::set_visible(PANEL + "/Missing", false);
    util::set_visible(PANEL + "/Body", true);
    let picked = polygon::has_pick(state);
    util::set_text(PANEL + "/Body/Verbs/Scope", if picked { "{listing.at.len()} picked" } else { "all {listing.at.len()}" });
    util::set_visible(PANEL + "/Body/Verbs/all", picked);
    ui::fill_strip(PANEL + "/Body/Header", header(state, listing));
    let rows: [form::Row] = [];
    for at in listing.at {
        rows.push(vertex_row(state, listing, at));
    }
    form::fill(PANEL + "/Body/Scroll/Rows", rows);
}

/// A verb by the name of its button.
pub fn verb(state: &mut editor::State, name: str) {
    if name == BIND {
        bind(state);
    } else if name == UNBIND {
        unbind(state);
    } else if name == NORMALIZE {
        normalize(state);
    } else if name == AUTO {
        auto(state);
    } else if name == SMOOTH {
        smooth(state);
    } else if name == ALL {
        polygon::clear_pick(state);
    }
}

fn label(text: str, width: float, role: str) -> ui::Control {
    ui::Control { kind: ui::WIDGET_LABEL, role: role, font_size: 11, width: width, text: text }
}

fn header(state: editor::State, listing: Table) -> [ui::Control] {
    let out = [label("vertex", NAME_WIDTH, roles::TEXT_CODE_QUIET)];
    let active = if state.polygon.bone != nil { state.polygon.bone.unwrap() } else { -1 };
    for bone_index in 0..listing.bones.len() {
        let path = listing.bones[bone_index][project_fields::PATH].as_str();
        // The bone's own last segment: a full path is wider than the column
        // and the tooltip carries the rest.
        out.push(ui::Control {
            kind: ui::WIDGET_BUTTON,
            role: roles::CHIP,
            width: CELL_WIDTH,
            height: 20,
            text: util::leaf(path),
            tooltip: path,
            checked: active == bone_index,
            on_click: "handle",
            data: { fields::FN: pick_bone, layout_fields::AT: bone_index },
        });
    }
    out.push(label("sum", CELL_WIDTH, roles::TEXT_CODE_QUIET));
    out
}

fn pick_bone(state: &mut editor::State, data: any, _value: any) {
    state.polygon.bone = data[layout_fields::AT].as_int();
    signals::inspector(state);
}

fn vertex_row(state: editor::State, listing: Table, at: int) -> form::Row {
    let hover = state.polygon.hover != nil && state.polygon.hover.unwrap() == at;
    let controls: [ui::Control] = [
        ui::Control {
            kind: ui::WIDGET_BUTTON,
            role: roles::CHIP,
            width: NAME_WIDTH - 6.0,
            height: 20,
            text: "{at}",
            tooltip: "Show this vertex alone in the viewport",
            checked: hover,
            on_click: "handle",
            data: { fields::FN: show_vertex_alone, layout_fields::AT: at },
        },
    ];
    let total = 0.0;
    for bone_at in 0..listing.bones.len() {
        let was = weight_of(listing.bones[bone_at], at);
        total += was;
        controls.push(ui::Control {
            kind: ui::WIDGET_NUMBER_FIELD,
            width: CELL_WIDTH - 6.0,
            value: was,
            drag_speed: 0.01,
            decimals: 2,
            min: 0.0,
            max: 1.0,
            fill: if was > 0.0 { theme_tokens::BG_CONTROL } else { themewin::GROUND },
            on_change: "handle",
            data: { fields::FN: type_weight, panel_keys::BONE: bone_at, layout_fields::AT: at },
        });
    }
    // A sum that is not one is what a Normalise is for, so it is said rather
    // than silently corrected.
    let off = util::abs(total - 1.0) > 0.01 && total > 0.0;
    controls.push(label(util::fixed(total, 2), CELL_WIDTH, if off { "text_caption_primary" } else { roles::TEXT_CODE_QUIET }));
    form::Row { height: ROW_HEIGHT, controls: controls }
}

fn show_vertex_alone(state: &mut editor::State, data: any, _value: any) {
    polygon::pick_vertex(state, data[layout_fields::AT].as_int(), false);
}

fn type_weight(state: &mut editor::State, data: any, now: any) {
    if begin(state, "set weight") {
        // By its place: the table this row was filled from is a frame old.
        set_weight(polygon::bones(state)[data[panel_keys::BONE].as_int()], data[layout_fields::AT].as_int(), now.as_float());
        done(state);
    }
}
