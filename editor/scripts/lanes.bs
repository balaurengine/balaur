//! The Recordings tab while one is open: the replay's transport and lanes.

use editor;
use session;
use signals;
use style;
use util;
use words::changes;
use words::components;
use words::dock_fields;
use words::fields;
use words::glyphs;
use words::layout_fields;
use words::roles;
use words::schema_fields;

const LANES: str = "Editor/Shell/Body/Centre/Bottom/Lanes";

const LANE_SCENE: str = "scenes/items/lane.toml";

const LINE_SCENE: str = "scenes/items/event_line.toml";

const MARK_SCENE: str = "scenes/items/lane_mark.toml";

// A lane's name among the rows, and a line's, each before its place.
const LANE: str = "L";

const LINE: str = "E";

const MARKS: str = "Marks";

const PADDING_X: str = "padding_x";

// A scroll bar's width, which the marks stay clear of.
const SCROLL_BAR: float = 16.0;

/// One lane of the Timeline or a recording: its lamp role, or "" for none,
/// its name, and its marks.
pub struct Lane {
    internal lamp: str,
    internal name: str,
    internal marks: [Mark],
}

/// A lane's mark: `x` across its lane, held down once the playhead has passed it.
pub struct Mark {
    internal x: float,
    internal passed: bool,
    internal tooltip: str,
}

/// Lay `lanes` under `host`, each a `scenes/items/lane.toml` whose marks are
/// `mark_scene`s across `marks_width`, then `lines`, each the three things a
/// `scenes/items/event_line.toml` says. A lane is named `L<n>` and a mark by
/// its place in it, which is what a press hands back.
pub fn fill_lanes(state: editor::State, host: Node, lanes: [Lane], lines: [[str]], mark_scene: str, marks_width: float) {
    let items: [scene::RepeatItem] = [];
    for at in 0..lanes.len() {
        items.push(scene::RepeatItem { key: LANE + "{at}", scene: LANE_SCENE });
    }
    for at in 0..lines.len() {
        items.push(scene::RepeatItem { key: LINE + "{at}", scene: LINE_SCENE });
    }
    let nodes = scene::repeat(host, items);
    let half = style::role_size_in_pixels(state, roles::CHIP_QUIET, layout_fields::HEIGHT, 20.0) / 2.0;
    let tall = style::role_size_in_pixels(state, roles::LAYOUT_LANE, layout_fields::HEIGHT, 20.0);
    for at in 0..lanes.len() {
        let lane = lanes[at];
        let row = nodes[at];
        let lamp = row.get_node("Lamp");
        lamp.set_visible(lane.lamp != "");
        if lane.lamp != "" {
            lamp.widget.role = lane.lamp;
        }
        let name = row.get_node("Name");
        name.widget.text = lane.name;
        name.widget.tooltip = lane.name;
        let strip = row.get_node(MARKS);
        strip.widget.width = marks_width;
        strip.widget.height = tall;
        let marks: [scene::RepeatItem] = [];
        for index in 0..lane.marks.len() {
            marks.push(scene::RepeatItem { key: "{index}", scene: mark_scene });
        }
        let placed = scene::repeat(strip, marks);
        for index in 0..lane.marks.len() {
            let mark = lane.marks[index];
            let node = placed[index];
            node.patch_component(components::WIDGET, { dock_fields::INSET: [mark.x - half, 0.0, -1.0, -1.0] });
            node.widget_check.checked = mark.passed;
            node.widget.tooltip = mark.tooltip;
        }
    }
    for at in 0..lines.len() {
        let row = nodes[lanes.len() + at];
        row.get_node("Tick").widget.text = lines[at][0];
        row.get_node("Kind").widget.text = lines[at][1];
        row.get_node("Label").widget.text = lines[at][2];
    }
}

/// A pressed mark's lane and place in it, from the mark's node: nil for a
/// node that is not one.
pub fn mark_place(node: Node) -> [int]? {
    let lane = node.parent().parent().name();
    if !lane.starts_with(LANE) {
        return nil;
    }
    return [lane.slice(LANE.len(), lane.len()).parse_int(), node.name().parse_int()];
}

/// Where a lane's marks start across it, with its lamp or without.
pub fn marks_x(state: editor::State, lamp: bool) -> float {
    let gap = style::role_size_in_pixels(state, roles::LAYOUT_LANE, layout_fields::GAP, 6.0);
    let lit = if lamp { style::role_size_in_pixels(state, roles::MARK_LAMP, layout_fields::WIDTH, 6.0) + gap } else { 0.0 };
    style::role_size_in_pixels(state, roles::LAYOUT_LANE, PADDING_X, 8.0) + lit + style::role_size_in_pixels(state, roles::TEXT_LANE, layout_fields::WIDTH, 150.0) + gap
}

/// How wide a lane's marks run in the panel at `host`.
pub fn marks_width(state: editor::State, host: str, lamp: bool) -> float {
    let far = style::role_size_in_pixels(state, roles::LAYOUT_LANE, PADDING_X, 8.0) + SCROLL_BAR;
    math::max(120.0, util::drawn_width(host) - marks_x(state, lamp) - far)
}

/// Fill the recording lanes: the transport and scrubber, where the replay
/// parted from the recording, a lane a kind of event with its marks placed by
/// tick against the tab's width, and everything recorded at the playhead.
pub fn fill(state: editor::State) {
    let split = replay::divergence_tick();
    let first = state.session.first;
    let last = state.session.last;
    let span = math::max(1.0, (last - first) as float);
    let lane_width = marks_width(state, LANES, false);
    let playing = replay::state() == replay::STATE_PLAYING;
    util::set_text(LANES + "/Head/Play", if playing { "Pause" } else { "Play" });
    let play = scene::root().get_node(LANES + "/Head/Play");
    if play.is_valid() {
        play.widget_button.icon = if playing { glyphs::PAUSE } else { glyphs::PLAY };
    }
    // Before the first frame is fed the position is one tick short of the
    // session's start, which is off the near end of the ruler.
    let at = math::max(0.0, (replay::position() - first) as float);
    util::fill_beside(LANES + "/Head/Scrub", components::WIDGET_RANGE, { fields::VALUE: at, schema_fields::MAX: span });
    util::set_text(LANES + "/Head/At", "{replay::position()} / {last}");
    // A divergence is information, not a failure: the replay ran, and this is
    // the tick at which it stopped reproducing what was recorded.
    let parted = if split != nil { "parted from the recording at tick {split.unwrap().tick}" } else { "" };
    let filled = scene::root().get_node(LANES + "/Parted");
    if filled.is_valid() {
        filled.set_visible(parted != "");
        filled.widget.text = parted;
    }
    let lanes: [Lane] = [];
    for recorded in state.session.lanes {
        let marks: [Mark] = [];
        for recorded_mark in recorded.marks {
            let tick = recorded_mark.tick;
            let mark_x = math::clamp(((tick.as_int() - first) as float) / span, 0.0, 1.0) * lane_width;
            marks.push(Mark { x: mark_x, passed: tick.as_int() <= replay::position(), tooltip: "{tick}: {recorded_mark.label}" });
        }
        lanes.push(Lane { lamp: "", name: recorded.name, marks: marks });
    }
    // Everything recorded at the tick the playhead is on, in the order it
    // happened.
    let lines: [[str]] = [];
    for event in replay::events(state.session.at, state.session.at) {
        lines.push(["{event.tick}", event.kind, event.label]);
    }
    fill_lanes(state, scene::root().get_node(LANES + "/Scroll/Rows"), lanes, lines, MARK_SCENE, lane_width);
}

/// A mark pressed: the replay seeks to its tick.
pub fn mark_pressed(state: &mut editor::State, node: Node) {
    let place = mark_place(node);
    if place == nil {
        return;
    }
    let lane = place.unwrap()[0];
    let index = place.unwrap()[1];
    if lane < state.session.lanes.len() && index < state.session.lanes[lane].marks.len() {
        session::seek(state, state.session.lanes[lane].marks[index].tick.as_int());
    }
}

/// The lanes' transport, by the name of the button pressed.
pub fn pressed(state: &mut editor::State, name: str) {
    if name == "Play" {
        session::toggle_pause(state);
    } else if name == "Step" {
        session::step(state);
    } else {
        session::close(state);
    }
    signals::changed(state, changes::RECORDINGS);
}

/// The scrubber, at `ticks` ticks into the recording.
pub fn seek(state: &mut editor::State, ticks: float) {
    session::seek(state, state.session.first + (ticks as int));
    signals::changed(state, changes::RECORDINGS);
}
