//! The Recordings tab while one is open: the replay's transport and lanes.

use editor;
use pool;
use session;
use signals;
use style;
use util;
use words::changes;
use words::components;
use words::fields;
use words::glyphs;
use words::layout_fields;
use words::log_fields;
use words::roles;
use words::schema_fields;

const LANES: str = "Editor/Shell/Body/Centre/Bottom/Lanes";

const PADDING_X: str = "padding_x";

// A scroll bar's width, which the marks stay clear of.
const SCROLL_BAR: float = 16.0;

/// One lane of the Timeline or a recording: its lamp in `lamp`, a lamp role or
/// "" for none, its name, then `marks` across `marks_width`.
pub fn lane(state: editor::State, lamp: str, name: str, marks: [ui::Control], marks_width: float) -> ui::Control {
    let controls: [ui::Control] = [];
    if lamp != "" {
        controls.push(ui::Control { kind: ui::WIDGET_ROW, role: lamp });
    }
    controls.push(ui::Control { kind: ui::WIDGET_LABEL, role: roles::TEXT_LANE, truncate: true, tooltip: name, text: name });
    controls.push(ui::Control {
        kind: ui::WIDGET_ROW,
        width: marks_width,
        height: style::role_size_in_pixels(state, roles::LAYOUT_LANE, layout_fields::HEIGHT, 20.0),
        controls: marks,
    });
    line(controls)
}

/// A row in a lane's look that is not a lane: what happened at a tick.
pub fn line(controls: [ui::Control]) -> ui::Control {
    // A group of controls has no air of its own; this one's is the role's.
    ui::Control { kind: ui::WIDGET_ROW, role: roles::LAYOUT_LANE, align_items: ui::ALIGN_CENTER, controls: controls }
}

/// A lane's mark centred on `x`, held down once the playhead has passed it;
/// a press calls `data`'s handler.
pub fn mark(state: editor::State, x: float, passed: bool, tooltip: str, data: any) -> ui::Control {
    let half = style::role_size_in_pixels(state, roles::CHIP_QUIET, layout_fields::HEIGHT, 20.0) / 2.0;
    ui::Control {
        kind: ui::WIDGET_BUTTON,
        role: roles::CHIP_QUIET,
        text: "",
        icon: glyphs::DOT,
        checked: passed,
        absolute: true,
        inset: ui::Sides { left: x - half, top: 0.0, right: -1.0, bottom: -1.0 },
        tooltip: tooltip,
        on_click: "handle", target: pool::editor(),
        data: data,
    }
}

/// Where a lane's marks start across it, with its lamp or without.
pub fn marks_x(state: editor::State, lamp: bool) -> float {
    let gap = style::role_size_in_pixels(state, roles::LAYOUT_LANE, layout_fields::GAP, 6.0);
    let lit = if lamp { style::role_size_in_pixels(state, roles::MARK_LAMP, layout_fields::WIDTH, 6.0) + gap } else { 0.0 };
    style::role_size_in_pixels(state, roles::LAYOUT_LANE, PADDING_X, 8.0) + lit + style::role_size_in_pixels(state, roles::TEXT_LANE, layout_fields::WIDTH, 150.0) + gap
}

/// How wide a lane's marks run in the panel at `host`.
pub fn marks_width(state: editor::State, host: str, lamp: bool) -> float {
    let far = style::role_size_in_pixels(state, roles::LAYOUT_LANE, PADDING_X, 8.0) + SCROLL_BAR;
    math::max(120.0, util::drawn_width(host) - marks_x(state, lamp) - far)
}

/// Fill the recording lanes: the transport and scrubber, where the replay
/// parted from the recording, a lane a kind of event with its marks placed by
/// tick against the tab's width, and everything recorded at the playhead.
pub fn fill(state: editor::State) {
    let split = replay::divergence_tick();
    let first = state.session.first;
    let last = state.session.last;
    let span = math::max(1.0, (last - first) as float);
    let lane_width = marks_width(state, LANES, false);
    let playing = replay::state() == replay::STATE_PLAYING;
    util::set_text(LANES + "/Head/Play", if playing { "Pause" } else { "Play" });
    let play = scene::root().get_node(LANES + "/Head/Play");
    if play.is_valid() {
        play.widget_button.icon = if playing { glyphs::PAUSE } else { glyphs::PLAY };
    }
    // Before the first frame is fed the position is one tick short of the
    // session's start, which is off the near end of the ruler.
    let at = math::max(0.0, (replay::position() - first) as float);
    util::fill_beside(LANES + "/Head/Scrub", components::WIDGET_RANGE, { fields::VALUE: at, schema_fields::MAX: span });
    util::set_text(LANES + "/Head/At", "{replay::position()} / {last}");
    // A divergence is information, not a failure: the replay ran, and this is
    // the tick at which it stopped reproducing what was recorded.
    let parted = if split != nil { "parted from the recording at tick {split.unwrap().tick}" } else { "" };
    let filled = scene::root().get_node(LANES + "/Parted");
    if filled.is_valid() {
        filled.set_visible(parted != "");
        filled.widget.text = parted;
    }
    let rows: [ui::Control] = [];
    for recorded in state.session.lanes {
        let marks: [ui::Control] = [];
        for recorded_mark in recorded.marks {
            let tick = recorded_mark.tick;
            let mark_x = math::clamp(((tick.as_int() - first) as float) / span, 0.0, 1.0) * lane_width;
            let passed = tick.as_int() <= replay::position();
            marks.push(mark(state, mark_x, passed, "{tick}: {recorded_mark.label}", { fields::FN: on_mark_pressed, log_fields::TICK: tick }));
        }
        rows.push(lane(state, "", recorded.name, marks, lane_width));
    }
    // Everything recorded at the tick the playhead is on, in the order it
    // happened.
    for event in replay::events(state.session.at, state.session.at) {
        rows.push(line([
            ui::Control { kind: ui::WIDGET_LABEL, role: roles::TEXT_CODE_CAPTION, text: "{event.tick}" },
            ui::Control { kind: ui::WIDGET_LABEL, role: roles::TEXT_CODE_CAPTION, text: event.kind },
            ui::Control { kind: ui::WIDGET_LABEL, role: roles::TEXT_CODE, text: event.label },
        ]));
    }
    ui::fill_strip(LANES + "/Scroll/Rows", rows);
}

fn on_mark_pressed(state: &mut editor::State, data: any, _value: any) {
    session::seek(state, data[log_fields::TICK].as_int());
}

/// The lanes' transport, by the name of the button pressed.
pub fn verb(state: &mut editor::State, verb: str) {
    if verb == "Play" {
        session::toggle_pause(state);
    } else if verb == "Step" {
        session::step(state);
    } else {
        session::close(state);
    }
    signals::changed(state, changes::RECORDINGS);
}

/// The scrubber, at `ticks` ticks into the recording.
pub fn seek(state: &mut editor::State, ticks: float) {
    session::seek(state, state.session.first + (ticks as int));
    signals::changed(state, changes::RECORDINGS);
}
