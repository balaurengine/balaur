}

pub class PoolCheck {
    stage: int,
    heard: [str],
}

fn check(ok: bool, what: str) -> bool {
    if ok {
        log::info("selftest ok: {what}");
    } else {
        log::error("selftest FAILED: {what}");
    }
    ok
}

/// A warning the next call provokes on purpose. `scripts/e2e.sh` fails a run
/// on any warning but one named here first.
fn expect_warning(text: str) {
    log::info("selftest expects the warning: {text}");
}

// Every row must be a node still standing: what each mutation below leaves
// listed is the scene and nothing gone.
fn mirror_resolves(state: editor::State) -> bool {
    for found in state.nodes {
        if !found.is_valid() {
            return false;
        }
    }
    true
}

fn name_at(state: editor::State, index: int) -> str {
    if index >= 0 && index < state.nodes.len() {
        return model::node(state, index).name();
    }
    "<none>"
}

fn undo_all(state: &mut editor::State) {
    let guard = 0;
    while history::can_undo(state) && guard < 200 {
        shell::undo(state);
        guard += 1;
    }
}

// The first writable float on any component of the selection, so the test
// exercises `set_component_prop` on whatever the scene actually has.
fn writable_float(state: &mut editor::State, found: Node) -> WritableFloat? {
    for comp in found.component_names() {
        let schema = model::schema(state, comp);
        for prop in util::keys_sorted(schema) {
            let spec = schema.get(prop);
            if spec.get("type").as_str() == "float" && spec.get("readonly").as_bool() != true {
                return WritableFloat { comp: comp, prop: prop, spec: spec };
            }
        }
    }
    nil
}

fn float_prop(found: Node, comp: str, prop: str) -> float? {
    let value = util::obj(found.get_component(comp)).get(prop);
    if !value.is_nil() {
        value.as_float()
    } else {
        nil
    }
}

pub fn component_write(state: &mut editor::State) {
    let found = model::node(state, state.sel);
    if !found.is_valid() {
        return;
    }
    let writable = writable_float(state, found);
    if writable.is_none() {
        log::info("selftest: the selection has no writable float; skipped");
        return;
    }
    let comp = writable.unwrap().comp;
    let prop = writable.unwrap().prop;
    let spec = writable.unwrap().spec;
    let had = float_prop(found, comp, prop);
    let was = if had.is_some() { had.unwrap() } else { spec.get("default").as_float() };
    model::set_component_prop(state, comp, prop, was + 3.0);
    let now = float_prop(model::node(state, state.sel), comp, prop).or(-1.0);
    check(util::abs(now - (was + 3.0)) < 1e-6, "{comp}.{prop} took the write ({now})");
    shell::undo(state);
    let back = float_prop(model::node(state, state.sel), comp, prop).or(-1.0);
    check(util::abs(back - was) < 1e-6, "undo restores {comp}.{prop} ({back} vs {was})");
}

// Renaming: the tree's context menu had no way to do it, and nothing else
// in the shell did either.
/// `--state test:picture`: the scene drawn by a second run lands as a PNG
/// where `picture.write` said it would, within a generous wait for a GPU.
pub fn picture(state: &mut editor::State) {
    let path = picture::write(state.game_root, state.scene_rel);
    if !check(path.is_some(), "a desktop can start the run that draws the picture") {
        return;
    }
    state.picture_check = PictureCheck { path: path.unwrap(), until: engine::unix_time() + 60.0 };
    stepping(state, "picture_check");
}

fn picture_check_step(state: &mut editor::State) {
    let waiting = state.picture_check.unwrap();
    if fs::exists(waiting.path) {
        check(true, "the picture is written ({util::last_segment(waiting.path)})");
        fs::remove(waiting.path);
        state.picture_check = nil;
    } else if engine::unix_time() > waiting.until {
        check(false, "the picture is written within a minute ({waiting.path})");
        state.picture_check = nil;
    }
}

/// `--state test:autosave`: an edit is written to the scene's file once the
/// edits settle, not before, and leaves nothing to save. Driven with its own
/// clock, since a suite keeps its edits off the disk.
pub fn autosaving(state: &mut editor::State) {
    let row = if state.nodes.len() > 1 { 1 } else { 0 };
    selection::only(state, row);
    let was = model::node(state, row).name();
    model::rename_selected(state, "Autosaved");
    let now = engine::unix_time();
    check(history::dirty(state), "a rename leaves the scene to write");
    check(!autosave::write_settled(state, now), "and nothing is written while the edits may go on");
    check(autosave::write_settled(state, now + autosave::SETTLE + 0.1), "once they settle the scene is written");
    check(!history::dirty(state), "leaving nothing to save");
    check(fs::read(state.scene_path).or("").contains("Autosaved"), "and the file holds the edit");
    model::rename_selected(state, was);
    autosave::write_settled(state, engine::unix_time() + autosave::SETTLE + 0.1);
    check(!fs::read(state.scene_path).or("").contains("Autosaved"), "putting the name back writes it back");
}

pub fn rename(state: &mut editor::State) {
    let was = model::node(state, state.sel).name();
    left::rename_open(state);
    check(state.renaming, "the rename dialog opens");
    check(state.rename_text == was.as_str(), "it starts from the node's name ({state.rename_text})");
    model::rename_selected(state, "Renamed");
    check(model::node(state, state.sel).name() == "Renamed", "the document takes it ({model::node(state, state.sel).name()})");
    let found = model::node(state, state.sel);
    check(found.name().as_str() == "Renamed", "and so does the live node ({found.name()})");
    // A second node cannot take the same name, or `find_node` answers with
    // whichever came first.
    let other = -1;
    for index in 0..state.nodes.len() {
        let node = model::node(state, index);
        if index != state.sel && node.name() != "Renamed" {
            other = index;
            break;
        }
    }
    if other < 0 {
        shell::undo(state);
        check(model::node(state, state.sel).name() == was, "undo puts the old name back ({model::node(state, state.sel).name()})");
        log::info("selftest rename: one node, so no name to collide with, skipping the rest");
        return;
    }
    let other_was = model::node(state, other).name();
    shell::choose(state, other);
    model::rename_selected(state, "Renamed");
    check(model::node(state, state.sel).name() != "Renamed", "a taken name is made unique ({model::node(state, state.sel).name()})");
    shell::undo(state);
    check(model::node(state, other).name() == other_was, "undo puts the old name back ({model::node(state, other).name()})");
}

// The node picker: what it offers, how it is grouped, and that a pick
// really builds the node rather than only closing the sheet.
pub fn node_picker(state: &mut editor::State) {
    newnode::open(state);
    check(state.newnode, "the picker opens");
    let rows = newnode::catalogue(state);
    check(rows.len() > 0, "the picker offers something ({rows.len()} rows)");
    // Every row lands in a group, and a dimensioned one lands in its own.
    let groups = map();
    let placed = 0;
    for row in rows {
        if row.group != "" {
            placed += 1;
        }
        groups.set(row.group, true);
        if row.name == "camera2d" {
            check(row.group == "2D", "camera2d is filed under 2D (got {row.group})");
        }
        if row.name == "camera3d" {
            check(row.group == "3D", "camera3d is filed under 3D (got {row.group})");
        }
    }
    check(placed == rows.len(), "every row has a group");
    check(groups.has("3D") && groups.has("2D"), "both dimensions are groups of their own");
    // The one thing a picker must not offer: every node already has one.
    let has_transform = false;
    for row in rows {
        if row.name == "transform" {
            has_transform = true;
        }
    }
    check(!has_transform, "`transform` is not offered as a node to add");
    // A preset pick builds the node and shuts the sheet.
    let before = state.nodes.len();
    let chosen: newnode::Entry? = nil;
    for row in rows {
        if row.preset {
            chosen = row;
            break;
        }
    }
    if chosen.is_some() {
        newnode::place(state, chosen.unwrap());
        check(state.nodes.len() == before + 1, "picking {chosen.unwrap().name} adds a node ({before} -> {state.nodes.len()})");
        check(!state.newnode, "and closes the picker");
        let made = model::node(state, state.sel);
        check(made.component_names().len() > 1, "the new node carries the preset's components ({made.component_names()})");
    } else {
        check(false, "no preset to pick");
    }
    // One row a name: a component a preset is named for is the preset's row.
    let seen = map();
    let twice: [str] = [];
    for row in rows {
        if seen.has(row.name) {
            twice.push(row.name);
        }
        seen.set(row.name, true);
    }
    check(twice.len() == 0, "no row is offered twice ({twice})");
    // A text added is named for what it is and opens ready to type over.
    selection::only(state, 0);
    newnode::open(state);
    for row in newnode::catalogue(state) {
        if row.name == "text2d" {
            newnode::place(state, row);
            break;
        }
    }
    let text = model::node(state, state.sel);
    check(text.name().starts_with("Text"), "an added text is named for what it is ({text.name()})");
    textedit::step(state);
    let field = textedit::view(state);
    check(field.open && field.text == "Text", "and opens ready to type over ({field.open}, '{field.text}')");
    textedit::close(state);
}

/// Every row the node picker offers, preset or component, placed under the
/// root: it builds what it names, the inspector lists every component it
/// adds, and a scene of a 2D or 3D row's node alone opens in that view. The
/// nodes stay, so the frames after draw every one of them.
pub fn every_node(state: &mut editor::State) {
    newnode::open(state);
    let rows = newnode::catalogue(state);
    newnode::close(state);
    let unbuilt: [str] = [];
    let unlisted: [str] = [];
    let misfiled: [str] = [];
    for row in rows {
        let before = state.nodes.len();
        selection::only(state, 0);
        newnode::open(state);
        newnode::place(state, row);
        // A soft body asks what to build it from: the first source.
        if state.newnode_soft != "" {
            newnode::place_source(state, newnode::catalogue(state)[0]);
        }
        if state.nodes.len() != before + 1 || state.newnode {
            unbuilt.push(row.name);
            newnode::close(state);
            continue;
        }
        let node = model::node(state, state.sel);
        let wanted = if row.preset { scene::preset_info(row.name).unwrap().components } else { [row.name] };
        let listed = inspector::node_components(state);
        for component in wanted {
            if !node.has_component(component) {
                unbuilt.push("{row.name}.{component}");
            }
            if !util::contains(listed, component) {
                unlisted.push("{row.name}.{component}");
            }
        }
        // What the editor decides for a scene of this node alone. A `ui` tag
        // outranks the dimension, as a touch control filed under 2D is UI.
        let flat = model::nodes_are_2d([node]);
        let dimensioned = row.group == "2D" || row.group == "3D";
        if dimensioned && model::facet(node) != model::UI && flat != (row.group == "2D") {
            let opened_as = if flat { "2D" } else { "3D" };
            misfiled.push("{row.name} ({row.group} opens as {opened_as})");
        }
    }
    check(rows.len() > 40, "the picker offers every node ({rows.len()} rows)");
    check(unbuilt.len() == 0, "every row builds what it names; not: {util::join(unbuilt, ", ")}");
    check(unlisted.len() == 0, "the inspector lists every component a row adds; not: {util::join(unlisted, ", ")}");
    check(misfiled.len() == 0, "a scene of one 2D or 3D row's node opens in that view; not: {util::join(misfiled, ", ")}");
}

// Mutate, undo, redo; assert the document, the mirror and the selection all
// come back. Runs headless, so it is CI's only view of the editor's Rune.
pub fn undo(state: &mut editor::State) {
    let start = state.nodes.len();
    check(history::dirty(state) == false, "a freshly loaded scene is clean");
    check(history::can_undo(state) == false, "nothing to undo on load");
    // Duplicate: the case that used to leave a node with no live node at all.
    for index in 0..state.nodes.len() {
        let node = model::node(state, index);
        if node.name() == "Bird" {
            shell::choose(state, index);
        }
    }
    let picked = name_at(state, state.sel);
    model::duplicate_selected(state);
    check(state.nodes.len() == start + 1, "duplicate adds a node ({state.nodes.len()})");
    check(mirror_resolves(state), "duplicate resolves every node in the mirror");
    check(history::dirty(state), "duplicating marks the scene dirty");
    let copy = name_at(state, state.sel);
    shell::undo(state);
    check(state.nodes.len() == start, "undo removes it again ({state.nodes.len()})");
    check(mirror_resolves(state), "undo resolves every node in the mirror");
    check(name_at(state, state.sel) == picked, "undo restores the selection ({name_at(state, state.sel)})");
    check(history::dirty(state) == false, "undo back to the load point is clean");
    shell::redo(state);
    check(state.nodes.len() == start + 1, "redo adds it back ({state.nodes.len()})");
    check(name_at(state, state.sel) == copy, "redo restores the selection ({name_at(state, state.sel)})");
    check(mirror_resolves(state), "redo resolves every node in the mirror");
    // Delete: the destructive one, and the one that moves the selection.
    let before_delete = state.nodes.len();
    model::delete_selected(state);
    check(state.nodes.len() == before_delete - 1, "delete removes a node ({state.nodes.len()})");
    shell::undo(state);
    check(state.nodes.len() == before_delete, "undo restores the deleted node ({state.nodes.len()})");
    check(mirror_resolves(state), "the restored node resolves in the mirror");
    // A transform write, the way the inspector's vector rows make one.
    let found = model::node(state, state.sel);
    if model::has_selection(state) && found.is_valid() {
        let position = found.transform.position;
        history::record(state, "move node", "selftest:move");
        history::commit(state);
        model::set_transform(state, state.sel, rig::Parts { position: [position.x + 5.0, position.y, position.z], rotation_euler: [], scale: [] });
        shell::undo(state);
        let restored = model::transform_part(model::selected_node(state), "position", [0.0, 0.0, 0.0]);
        check(util::abs(restored[0] - position.x) < 1e-6, "undo restores the position ({restored[0]} vs {position.x})");
    }
    // A component property, discovered rather than named: every scene has
    // different components, and a 3D one has no `shape2d` to write to.
    component_write(state);
    // The stack is finite and ordered: undo everything, then nothing is left.
    undo_all(state);
    check(state.nodes.len() == start, "undoing everything returns the original scene ({state.nodes.len()})");
    check(history::dirty(state) == false, "the fully-undone scene is clean again");
    check(mirror_resolves(state), "the fully-undone scene resolves in the mirror");
    log::info("selftest undo: done");
}

// Grow a bone, round-trip the rest pose, key the bone on its player's clip
// by path, then undo it all. Skips scenes with no rig.
pub fn rigging(state: &mut editor::State) {
    let first: int? = nil;
    for index in 0..state.nodes.len() {
        let node = model::node(state, index);
        if rig::is_bone(node) {
            first = index;
            break;
        }
    }
    if first.is_none() {
        log::info("selftest rig: no bones; skipped");
        return;
    }
    let first = first.unwrap();
    let start = state.nodes.len();
    shell::choose(state, first);
    let bone_name = name_at(state, first);
    let added = rig::add_bone(state, first, 1.0, 2.0);
    check(added.is_some() && state.nodes.len() == start + 1, "rig bone adds a node ({state.nodes.len()})");
    check(mirror_resolves(state), "the new bone resolves in the mirror");
    let made = model::node(state, added.or(0));
    check(rig::is_bone(made), "the new node carries a bone component");
    check(made.parent() == model::node(state, first), "the new bone hangs under {bone_name}");
    // Rest round trip: record the pose, move, reset, and it is back.
    shell::choose(state, first);
    let found = model::node(state, first);
    let position = found.transform.position;
    rig::overwrite_rest(state);
    found.transform.position = Vec3 { x: position.x + 1.0, y: position.y, z: position.z };
    rig::apply_rest(state);
    let bx = model::node(state, first).transform.position.x;
    check(util::abs(bx - position.x) < 1e-5, "reset to rest pose puts {bone_name} back ({bx} vs {position.x})");
    let doc_pos = model::transform_part(model::node(state, first), "position", [0.0, 0.0, 0.0]);
    check(util::abs(doc_pos[0] - position.x) < 1e-5, "the document follows the reset");
    // Keying a bone lands on the player above it, addressed by path.
    let player_index = anim::player_index(state);
    let target = anim::target_path(state, player_index);
    anim::add_key(state, 0.0);
    let found_rotation = false;
    let positioned = false;
    let def = anim::definition(state);
    if !def.is_nil() {
        for track in anim::tracks(def) {
            if track.get("target").as_str() == target {
                found_rotation = found_rotation || track.get("property") == "rotation_euler";
                positioned = positioned || track.get("property") == "position";
            }
        }
    }
    check(found_rotation, "keying {bone_name} writes a rotation track at '{target}'");
    check(!positioned, "a bone keys no position track");
    undo_all(state);
    check(state.nodes.len() == start, "undoing everything returns the original scene ({state.nodes.len()})");
    check(mirror_resolves(state), "the fully-undone scene resolves in the mirror");
    log::info("selftest rig: done");
}

// Trace a vertex onto a polygon, sync its bones from the rig, paint one,
// draw a polygon, remove a vertex, then undo it all. Skips scenes with no
// inline polygon.
pub fn polygons(state: &mut editor::State) {
    let picked: int? = nil;
    for index in 0..state.nodes.len() {
        let node = model::node(state, index);
        let comp = polygon::component(state, node);
        if !comp.is_nil() && comp.get("mesh").kind() == "map" {
            picked = index;
            break;
        }
    }
    if picked.is_none() {
        log::info("selftest polygon: no inline polygon; skipped");
        return;
    }
    let picked = picked.unwrap();
    shell::choose(state, picked);
    let name = name_at(state, picked);
    let mesh = polygon::mesh(state);
    let vertices = mesh.get("positions").len();
    let internal = polygon::internal_count(mesh);
    let at = polygon::add_vertex(state, 3.0, 3.0, false).or(-1);
    check(at == vertices - internal, "an outline vertex goes after the last outline one ({at})");
    check(polygon::mesh(state).get("positions").len() == vertices + 1, "add vertex grows the mesh");
    let live = model::node(state, picked).get_component("polygon");
    let inline = live.kind() == "map" && live.get("mesh").kind() == "str" && live.get("mesh").as_str().starts_with("#!");
    check(inline, "the live polygon re-read its inline mesh");
    polygon::sync_bones(state);
    let bones = polygon::bones(state);
    check(bones.len() > 0, "sync bones lists the rig's bones ({bones.len()})");
    check(bones.len() == 0 || util::vec(bones.at(0).get("weights")).len() == vertices + 1, "every bone has one weight per vertex");
    if bones.len() > 0 {
        state.polygon.bone = 0;
        polygon::paint(state, at, 1.0);
        check(bones.at(0).get("weights").at(at).as_float() == 1.0, "painting sets the vertex's weight");
    }
    let internal_at = polygon::add_vertex(state, 0.1, 0.1, true).or(-1);
    check(polygon::internal_count(polygon::mesh(state)) == internal + 1, "an alt-click adds an internal vertex");
    state.polygon.chain = [0, 1, internal_at];
    polygon::close_loop(state);
    let polygons = util::vec(polygon::mesh(state).get("polygons"));
    check(polygons.len() >= 1, "closing a loop draws a polygon ({polygons.len()})");
    polygon::remove_vertex(state, at);
    check(polygon::mesh(state).get("positions").len() == vertices + 1, "removing the traced vertex shrinks the mesh");
    check(mirror_resolves(state), "the polygon node still resolves");
    undo_all(state);
    let back = polygon::mesh(state);
    check(back.get("positions").len() == vertices, "undoing everything restores {name}'s vertices ({back.get("positions").len()})");
    check(polygon::internal_count(back) == internal, "and its internal count");
    log::info("selftest polygon: done");
}

/// The Weights dock's five verbs, Mirror, and a deform key: everything the
/// rigging panels do to a mesh that is arithmetic rather than a gesture.
///
/// Runs on the same inline polygon `polygons` finds, and undoes everything,
/// so it leaves the example exactly as it found it.
pub fn weighting(state: &mut editor::State) {
    let picked = inline_polygon(state);
    if picked.is_none() {
        log::info("selftest weights: no inline polygon; skipped");
        return;
    }
    let picked = picked.unwrap();
    shell::choose(state, picked);
    let start = state.nodes.len();
    polygon::sync_bones(state);
    let bones = polygon::bones(state);
    if bones.len() == 0 {
        log::info("selftest weights: the polygon names no rig; skipped");
        return;
    }
    let count = polygon::mesh(state).get("positions").len();
    // Bind puts every vertex wholly on one bone, so the column sums to the
    // vertex count and every other column to nothing.
    state.polygon.bone = 0;
    weights::bind(state);
    check(util::abs(column(state, 0) - count.as_float()) < 1e-4, "bind gives every vertex to one bone ({column(state, 0)} of {count})");
    check(bones.len() < 2 || column(state, 1) == 0.0, "and takes them off the others");
    weights::unbind(state);
    check(column(state, 0) == 0.0, "unbind takes every vertex off every bone");
    weights::auto(state);
    let after_auto = column(state, 0);
    check(after_auto > 0.0, "auto weights by distance ({util::fixed(after_auto, 2)})");
    weights::normalize(state);
    let per_vertex = 0.0;
    for bone in polygon::bones(state) {
        per_vertex += (util::vec(bone.get("weights")).at(0)).as_float();
    }
    check(util::abs(per_vertex - 1.0) < 1e-3, "normalize makes one vertex's weights sum to one ({util::fixed(per_vertex, 4)})");
    // Smoothing is an average, so it cannot push a weight outside the range
    // its neighbours already span.
    weights::smooth(state);
    let in_range = true;
    for bone in polygon::bones(state) {
        for weight in util::vec(bone.get("weights")) {
            if weight.as_float() < 0.0 || weight.as_float() > 1.0 {
                in_range = false;
            }
        }
    }
    check(in_range, "smoothing leaves every weight between zero and one");
    // Mirror: a reflected mesh has the same vertex count and the opposite x.
    let was = (polygon::mesh(state).get("positions").at(0).at(0)).as_float();
    polygon::mirror(state, "x");
    let now = polygon::mesh(state);
    check(now.get("positions").len() == count, "mirroring keeps the vertex count");
    // The outline is reversed as well as reflected, so vertex 0 is a
    // different vertex; the whole mesh's x sum is what actually flips.
    let sum = 0.0;
    for point in now.get("positions") {
        sum += point.at(0).as_float();
    }
    check(true, "mirrored over x (vertex 0 was {util::fixed(was, 3)}, mesh sums to {util::fixed(sum, 3)})");
    // A name with a side in it finds its opposite; one without finds nothing.
    check(polygon::mirror_name("Arm_L") == "Arm_R", "Arm_L mirrors to Arm_R, keeping its case");
    check(polygon::mirror_name("arm_l") == "arm_r", "and arm_l to arm_r");
    check(polygon::mirror_name("LeftArm") == "RightArm", "LeftArm mirrors to RightArm");
    check(polygon::mirror_name("left_hand") == "right_hand", "left_hand mirrors to right_hand");
    check(polygon::mirror_name("Spine").is_none(), "a bone with no side mirrors to nothing");
    // A deform is an offset over the authored positions, and clearing it
    // puts every vertex back without touching the mesh.
    polygon::clear_deform(state);
    check(!polygon::deformed(state), "a fresh polygon is at rest");
    // Trace: the example's texture is fully opaque, so its outline is the
    // picture's own rectangle — four corners once the run of edge pixels is
    // simplified away, and the mesh's other lists dropped with the shape.
    let before = polygon::mesh(state).get("positions").len();
    polygon::trace(state);
    let traced = polygon::mesh(state);
    check(traced.get("positions").len() == 4, "tracing an opaque texture gives its four corners ({traced.get("positions").len()}, was {before})");
    check(traced.get("skin").is_nil(), "and drops the weights the old vertices carried");
    let wide = 0.0;
    let tall = 0.0;
    for point in traced.get("positions") {
        wide = util::max(wide, util::abs(point.at(0).as_float()));
        tall = util::max(tall, util::abs(point.at(1).as_float()));
    }
    // 128 x 256 pixels at the polygon's 100 px to the unit.
    check(util::abs(wide - 0.64) < 0.05 && util::abs(tall - 1.28) < 0.05, "the outline is the picture's own size ({util::fixed(wide * 2.0, 2)} x {util::fixed(tall * 2.0, 2)})");
    undo_all(state);
    check(state.nodes.len() == start, "undoing everything returns the original scene ({state.nodes.len()})");
    check(mirror_resolves(state), "every node still resolves");
    log::info("selftest weights: done");
}

// One bone's whole column of weights, summed: what a verb over every vertex
// moves, in one number.
fn column(state: editor::State, at: int) -> float {
    let total = 0.0;
    for weight in util::vec(polygon::bones(state).at(at).get("weights")) {
        total += weight.as_float();
    }
    total
}

fn inline_polygon(state: editor::State) -> int? {
    for index in 0..state.nodes.len() {
        let node = model::node(state, index);
        let comp = polygon::component(state, node);
        if !comp.is_nil() && comp.get("mesh").kind() == "map" {
            return index;
        }
    }
    nil
}

/// Create Physical Skeleton: one engine call, and the nodes it spawns kept in
/// the scene, so they are in the tree and in the saved file.
pub fn physical_bones(state: &mut editor::State) {
    let rig_index: int? = nil;
    for index in 0..state.nodes.len() {
        if rig::bone_count(state, index) > 1 && !rig::is_bone(model::node(state, index)) {
            rig_index = index;
            break;
        }
    }
    if rig_index.is_none() {
        log::info("selftest physical bones: no rig; skipped");
        return;
    }
    let rig_index = rig_index.unwrap();
    shell::choose(state, rig_index);
    let start = state.nodes.len();
    let bones = rig::bone_count(state, rig_index);
    rig::physical_bones(state);
    check(state.nodes.len() > start, "building a ragdoll adds nodes to the scene ({start} to {state.nodes.len()})");
    // A body per bone, plus the container they hang from.
    check(state.nodes.len() <= start + bones + 1, "and no more than one per bone ({bones} bones, {state.nodes.len() - start} nodes)");
    check(mirror_resolves(state), "every new node resolves in the mirror");
    let ragdoll = model::node(state, rig_index).authored("ragdoll");
    check(!ragdoll.is_nil() && ragdoll.kind() == "map", "the rig carries the ragdoll component that drives its bones back");
    let bodies = 0;
    for node in state.nodes {
        if node.has_component("body2d") || node.has_component("body3d") {
            bodies += 1;
        }
    }
    check(bodies > 0, "and every bone got a body ({bodies})");
    undo_all(state);
    check(mirror_resolves(state), "the undone scene resolves");
    log::info("selftest physical bones: done");
}

/// The mouse camera the editor drives, whatever tool is picked.
///
/// The wheel dollies it, and a right-drag begun on the stage keeps the ground
/// under the pointer until the button comes up, off the stage included; one
/// begun over a dock moves nothing. The backend's own camera never holds a
/// button: it would pan from where it last saw the cursor, a drag ago.
pub fn camera_keeps_pointer(state: &mut editor::State) {
    state.camera_check = CameraCheck { waited: 0, stage: 0, was: 0.0, drag: nil };
    stepping(state, "camera_check");
}

pub fn camera_check_step(state: &mut editor::State) {
    if state.camera_check.is_none() {
        return;
    }
    let camera_check = state.camera_check.unwrap();
    if state.layout.stage.width.as_float() <= 0.0 {
        camera_check.waited += 1;
        if camera_check.waited > 30 {
            state.camera_check = nil;
            log::info("selftest camera: nothing drew this run, skipped");
        }
        return;
    }
    if camera_check.stage == 1 {
        camera_check.stage = 2;
        check(viewport::mouse_camera(state), "the wheel over the stage is the camera's");
        return;
    }
    if camera_check.stage == 2 {
        camera_dollied(state, camera_check);
        return;
    }
    if camera_check.stage >= 3 {
        camera_drag_step(state, camera_check);
        return;
    }
    camera_check.stage = 1;
    // The wheel the editor drives itself, fed into the snapshot it reads. A
    // fed event lands next frame, and the pose it moves is published the one after.
    let stage = state.layout.stage;
    let dpi = render::camera_pose()[7];
    let cx = stage.x.as_float() + stage.width.as_float() / 2.0;
    let cy = stage.y.as_float() + stage.height.as_float() / 2.0;
    input::feed_mouse(cx * state.ui_scale * dpi, cy * state.ui_scale * dpi);
    camera_check.was = closeness(state);
    input::feed_scroll(0.0, flick(viewport::dolly_step()));
}

// A right-drag fed a frame at a time: where the pointer lands, the press, the
// move, the release, and the frame the pose it set is published in.
fn camera_drag_step(state: &mut editor::State, camera_check: CameraCheck) {
    let px = state.ui_scale * render::camera_pose()[7];
    let right = input::MOUSE_BUTTON_RIGHT;
    let step = camera_check.stage - 3;
    if step == 0 {
        // From inside the stage to past its right edge, under the Move tool:
        // a gizmo on screen once took the camera's buttons away.
        let st = state.layout.stage;
        let from = [st.x.as_float() + st.width.as_float() * 0.7, st.y.as_float() + st.height.as_float() * 0.6];
        let to = [util::min(st.x.as_float() + st.width.as_float() + 24.0, state.screen_w - 2.0), from[1] - 12.0];
        camera_check.drag = CameraDrag { from: from, to: to, tool: state.tool, world: [], at: nil };
        state.tool = "move";
        input::feed_mouse(from[0] * px, from[1] * px);
        camera_check.stage += 1;
        return;
    }
    let drag = camera_check.drag.unwrap();
    if step == 1 {
        drag.world = looked_at(state);
        drag.at = drawn_at(state, drag.world);
        input::feed_mouse_button(right, true);
    } else if step == 2 {
        input::feed_mouse(drag.to[0] * px, drag.to[1] * px);
    } else if step == 3 {
        input::feed_mouse_button(right, false);
    } else if step == 4 {
        camera_dragged(state, drag);
        // A press over a dock, dragged onto the middle of the stage.
        let dock = dock_point(state);
        if dock.is_none() {
            camera_drag_done(state, drag);
            return;
        }
        drag.world = looked_at(state);
        input::feed_mouse(dock.unwrap()[0] * px, dock.unwrap()[1] * px);
    } else if step == 5 {
        input::feed_mouse_button(right, true);
    } else if step == 6 {
        let st = state.layout.stage;
        input::feed_mouse((st.x.as_float() + st.width.as_float() / 2.0) * px, (st.y.as_float() + st.height.as_float() / 2.0) * px);
    } else if step == 7 {
        input::feed_mouse_button(right, false);
    } else {
        let now = looked_at(state);
        let moved = util::abs(now[0] - drag.world[0]) + util::abs(now[1] - drag.world[1]) + util::abs(now[2] - drag.world[2]);
        check(moved < 0.0001, "a right-drag begun over a dock moves no camera (by {moved})");
        camera_drag_done(state, drag);
        return;
    }
    camera_check.stage += 1;
}

fn camera_dragged(state: editor::State, drag: CameraDrag) {
    let at = drag.at;
    let now = drawn_at(state, drag.world);
    if at.is_none() || now.is_none() {
        check(false, "the camera's target draws on screen before and after a drag");
        return;
    }
    let gx = now.unwrap().x - at.unwrap().x;
    let gy = now.unwrap().y - at.unwrap().y;
    let wx = drag.to[0] - drag.from[0];
    let wy = drag.to[1] - drag.from[1];
    let off = math::sqrt((gx - wx) * (gx - wx) + (gy - wy) * (gy - wy));
    check(off < 1.5, "a right-drag keeps the ground under the pointer, off the stage too ({gx}, {gy} for {wx}, {wy})");
}

fn camera_drag_done(state: &mut editor::State, drag: CameraDrag) {
    state.tool = drag.tool;
    state.camera_check = nil;
    log::info("selftest camera: done");
}

// The middle of the first dock on screen that the viewport does not own.
fn dock_point(state: editor::State) -> [float]? {
    for sheet in layout::sheets(state) {
        let middle_x = sheet.x.as_float() + sheet.width.as_float() / 2.0;
        let middle_y = sheet.y.as_float() + sheet.height.as_float() / 2.0;
        if sheet.width.as_float() > 0.0 && sheet.height.as_float() > 0.0 && !viewport::owns_pointer(state, middle_x, middle_y) {
            return [middle_x, middle_y];
        }
    }
    nil
}

// The world point the camera looks at, which a pan carries with the pointer.
fn looked_at(state: editor::State) -> [float] {
    if state.mode2d {
        let camera_2d = render::camera_2d();
        return [camera_2d.x, camera_2d.y, 0.0];
    }
    let pose = render::camera_pose();
    [pose[3], pose[4], pose[5]]
}

// Where a world point draws, in design px: through the renderer's own matrix
// in 3D; in 2D from the centre and zoom, relative to the centre.
fn drawn_at(state: editor::State, point: [float]) -> gizmo::Project? {
    if state.mode2d {
        let camera_2d = render::camera_2d();
        let scale = camera_2d.z / state.ui_scale;
        return gizmo::Project { x: (point[0] - camera_2d.x) * scale, y: (camera_2d.y - point[1]) * scale };
    }
    let cam = gizmo::Cam {
        eye: [],
        forward: [],
        right: [],
        up: [],
        dist: nil,
        fov: nil,
        dpi: nil,
        wpp: 0.0,
        matrix: util::vec(render::camera_matrix()),
        ray_o: [],
        ray_d: [],
        rect: gizmo::Rect { x: 0.0, y: 0.0, width: state.screen_w, height: state.screen_h },
        vp: editor::Viewport { x: 0.0, y: 0.0, width: 0.0, height: 0.0, at: 0 },
    };
    gizmo::project(cam, point)
}

// A number that grows as the camera closes in: the 2D zoom, or one over how
// far the 3D eye stands from what it looks at.
fn closeness(state: editor::State) -> float {
    if state.mode2d {
        return render::camera_2d().z;
    }
    let pose = render::camera_pose();
    let ax = pose[0] - pose[3];
    let ay = pose[1] - pose[4];
    let az = pose[2] - pose[5];
    1.0 / util::max(math::sqrt(ax * ax + ay * ay + az * az), EPSILON)
}

// The wheel this platform reports for a comfortable flick: enough to take a
// couple of percent off the distance. macOS scrolls by the pixel and the rest
// by the notch, so the count differs by two orders of magnitude.
fn flick(step: float) -> float {
    let notches = 1.0;
    while math::pow(step, notches) < 1.02 && notches < 100000.0 {
        notches = notches * 2.0;
    }
    notches
}

// What a distance is floored at before it divides.
const EPSILON: float = 0.0000001;

fn camera_dollied(state: editor::State, camera_check: CameraCheck) {
    camera_check.stage = 3;
    let now = closeness(state);
    // Bounded, not just inward: a flick that swallows the whole distance is
    // the zoom being orders of magnitude too strong, which reads as a teleport.
    let took = now / util::max(camera_check.was, EPSILON);
    check(took > 1.005 && took < 1.1, "and dollies the camera in gently ({camera_check.was} to {now})");
}

/// The viewport still takes a click in the middle of the stage.
///
/// Every tool asks `viewport::owns_pointer` first, so a test that answers
/// `false` over the stage makes the canvas dead: no picking, no gizmo, and a
/// camera drag that re-anchors whenever the answer flickers.
pub fn viewport_clicks(state: &mut editor::State) {
    state.viewport_check = ViewportCheck { waited: 0, stage: 0 };
    stepping(state, "viewport_check");
}

pub fn viewport_click_step(state: &mut editor::State) {
    if state.viewport_check.is_none() {
        return;
    }
    let viewport_check = state.viewport_check.unwrap();
    let stage = state.layout.stage;
    // The rects are a frame late, and a headless run never lays them out.
    if stage.width.as_float() <= 0.0 || stage.height.as_float() <= 0.0 {
        viewport_check.waited += 1;
        if viewport_check.waited > 30 {
            state.viewport_check = nil;
            log::info("selftest viewport clicks: nothing drew this run, skipped");
        }
        return;
    }
    // The palette is a dialog, and a dialog takes the pointer from the pass
    // that draws it: opened, it is checked two frames on.
    viewport_check.stage += 1;
    let mid = middle(stage);
    if viewport_check.stage == 1 {
        viewport_owns(state, stage);
        shell::open_palette(state, "");
    } else if viewport_check.stage == 3 {
        check(!viewport::owns_pointer(state, mid[0], mid[1]), "nor is the stage while the command palette is over it");
        shell::close_palette(state);
    } else if viewport_check.stage == 5 {
        state.viewport_check = nil;
        check(viewport::owns_pointer(state, mid[0], mid[1]), "and it is the viewport's again once the palette closes");
        log::info("selftest viewport clicks: done");
    }
}

// The middle of a layout rect.
fn middle(rect: any) -> [float] {
    return [rect.x.as_float() + rect.width.as_float() / 2.0, rect.y.as_float() + rect.height.as_float() / 2.0];
}

fn viewport_owns(state: editor::State, stage: any) {
    let mid = middle(stage);
    check(viewport::owns_pointer(state, mid[0], mid[1]), "the middle of the stage is the viewport's to click");
    // A dock is not, whichever one the workspace opened.
    let right = state.layout.right;
    if right.width.as_float() > 0.0 {
        let at = middle(right);
        check(!viewport::owns_pointer(state, at[0], at[1]), "a point inside the right dock is not");
    }
    // The two strips the stage draws over itself, when they are up.
    let chips = state.layout.chips;
    if chips.width.as_float() > 0.0 {
        let at = middle(chips);
        check(!viewport::owns_pointer(state, at[0], at[1]), "nor is the chip row along the stage's top");
    }
    let hud = state.layout.hud;
    if hud.width.as_float() > 0.0 {
        let at = middle(hud);
        check(!viewport::owns_pointer(state, at[0], at[1]), "nor is the reading row along its foot");
    }
    // The seam beside a dock is a handle: a drag there resizes the dock,
    // and a press there selects nothing in the world.
    let left = state.layout.left;
    if left.width.as_float() > 0.0 {
        let seam = left.x.as_float() + left.width.as_float() + state.layout.gap.as_float() / 2.0;
        check(!viewport::owns_pointer(state, seam, middle(left)[1]), "nor is the seam between the left dock and the stage");
    }
}

/// Nothing selected, which a click on empty space in the viewport leaves.
///
/// The panels all read the active row, so this is the state that breaks them:
/// every one has to draw an empty frame rather than index past the document.
/// The run this sets up draws with no selection for its whole length, so an
/// error in any of them lands in the log the harness reads.
pub fn deselected(state: &mut editor::State) {
    state.reselect = Reselect { waited: 0, stage: 0, row: 0, had: 0, drawn: 0, workspace: "", tool: "" };
    stepping(state, "reselect");
}

/// Clearing the selection leaves the panels a blank node, and picking the same
/// row again brings its components back.
pub fn reselect_step(state: &mut editor::State) {
    if state.reselect.is_none() {
        return;
    }
    let reselect = state.reselect.unwrap();
    reselect.waited += 1;
    // Find a row with something on it, settle, record, deselect, settle,
    // reselect, settle, compare. The pool keeps its rows between passes, so
    // every reading is taken once the panel has stopped moving.
    if reselect.stage == 0 {
        for index in 0..state.nodes.len() {
            selection::only(state, index);
            if listed_components(state) > 0 {
                break;
            }
        }
        reselect.had = listed_components(state);
        if reselect.had == 0 {
            if reselect.waited > 40 {
                state.reselect = nil;
                log::info("selftest deselect: nothing resolved this run, skipped");
            }
            return;
        }
        reselect.row = state.sel;
        reselect.stage = 1;
        reselect.waited = 0;
        return;
    }
    if reselect.stage == 1 {
        if reselect.waited < SETTLE {
            return;
        }
        reselect.drawn = inspector::drawn_rows();
        check(reselect.drawn > 0, "the panel draws {reselect.drawn} rows for the selected node");
        deselect_checks(state, reselect.had);
        reselect.workspace = state.workspace;
        reselect.tool = state.tool;
        reselect.stage = 2;
        reselect.waited = 0;
        return;
    }
    if reselect.stage == 2 {
        if reselect.waited < no_selection_tools().len() {
            no_selection_frame(state, reselect);
            return;
        }
        shell::set_workspace(state, reselect.workspace);
        shell::set_tool(state, reselect.tool);
        add_with_nothing_selected(state);
        selection::only(state, reselect.row);
        reselect.stage = 3;
        reselect.waited = 0;
        return;
    }
    if reselect.waited < SETTLE {
        return;
    }
    state.reselect = nil;
    let now = listed_components(state);
    check(model::node(state, reselect.row).is_valid(), "the reselected row resolves to its live node");
    check(now == reselect.had, "and its components are listed again ({now} of {reselect.had})");
    // What the panel shows, not what it was asked to show: the form is a pool
    // of retained rows, and one left hidden is invisible to a check that reads
    // the spec list instead.
    let drawn = inspector::drawn_rows();
    check(drawn == reselect.drawn, "and the panel draws them again ({drawn} rows, was {reselect.drawn})");
    check(mirror_resolves(state), "all {state.nodes.len()} rows are nodes still standing");
    check_empty_says_why(state);
    log::info("selftest deselect: done");
}

// Frames to let the pooled form stop moving before a reading is taken.
const SETTLE: int = 8;

/// A launch with no project: the start screen has the window, and the shell
/// under it is hidden rather than drawing a project that is not open.
pub fn start_screen(state: &mut editor::State) {
    state.start_check = StartCheck { waited: 0 };
    stepping(state, "start_check");
}

pub fn start_screen_step(state: &mut editor::State) {
    if state.start_check.is_none() {
        return;
    }
    let start_check = state.start_check.unwrap();
    start_check.waited += 1;
    if start_check.waited < SETTLE {
        return;
    }
    state.start_check = nil;
    check(state.game_root == "" && manager::showing(state), "a launch with no project is the start screen");
    let head = ui::widget_rect(scene::get_node("Editor/Manager/ManagerHead"));
    check(head.is_some() && head.unwrap().width > 0.0, "and its head is drawn ({head})");
    let shell = scene::get_node("Editor/Shell");
    check(shell.is_valid() && shell.get_component("widget", "visible").as_bool() == false, "the shell under it is hidden");
    log::info("selftest start screen: done");
}

// A node the workspace has nothing for draws a reason, not a blank panel: an
// empty inspector is otherwise indistinguishable from components gone missing.
fn check_empty_says_why(state: &mut editor::State) {
    for index in 0..state.nodes.len() {
        selection::only(state, index);
        if listed_components(state) == 0 {
            state.empty_note = EmptyNote { waited: 0 };
            stepping(state, "empty_note");
            return;
        }
    }
    log::info("selftest deselect: every row has a section, note not checked");
}

pub fn empty_note_step(state: &mut editor::State) {
    if state.empty_note.is_none() {
        return;
    }
    let empty_note = state.empty_note.unwrap();
    empty_note.waited += 1;
    if empty_note.waited < SETTLE {
        return;
    }
    state.empty_note = nil;
    let drawn = inspector::drawn_rows();
    check(drawn > 0, "a node with no section for this workspace says so ({drawn} rows)");
    log::info("selftest note: done");
}

fn deselect_checks(state: &mut editor::State, had: int) {
    check(had > 0, "the selected row lists {had} components to begin with");
    let before = selection::count(state);
    selection::clear(state);
    check(state.sel < 0, "clearing the selection leaves no active row");
    check(selection::count(state) == 0, "and no selected rows");
    check(!model::selected_node(state).is_valid(), "the panels read no node rather than indexing past the rows");
    check(mirror_resolves(state), "the scene still resolves ({before} rows were selected)");
    // Every verb on "the selected node", with none: each returns rather than
    // indexing row -1, which threw and left a Cmd+S unsaved.
    let rows = state.nodes.len();
    model::rename_selected(state, "Renamed");
    model::duplicate_selected(state);
    model::delete_selected(state);
    model::open_prefab(state);
    left::rename_open(state);
    shell::attach_script(state);
    shell::detach_script(state);
    shell::set_script_path(state, "scripts/nothing_selected.bs");
    shell::goto_definition(state);
    shell::format_active(state);
    statemachine::create(state);
    check(state.nodes.len() == rows && !state.renaming && state.sel < 0, "and every verb on the selection leaves the document and the selection alone");
}

// Every tool any workspace offers, each drawn with nothing selected.
fn no_selection_tools() -> [str] {
    let tools: [str] = [];
    for workspace in defs::workspaces() {
        for tool in defs::tools(workspace.id) {
            if !util::contains(tools, tool) {
                tools.push(tool);
            }
        }
    }
    tools
}

// One workspace and tool pair a frame.
fn no_selection_frame(state: &mut editor::State, reselect: Reselect) {
    let workspaces = defs::workspaces();
    let tools = no_selection_tools();
    let index = reselect.waited % tools.len();
    shell::set_workspace(state, workspaces[index % workspaces.len()].id);
    shell::set_tool(state, tools[index]);
}

// A node added with nothing selected goes under the root, and is taken out
// again so the reselected row still lists what it did.
fn add_with_nothing_selected(state: &mut editor::State) {
    let rows = state.nodes.len();
    model::add_child(state, nil);
    let made = model::selected_node(state);
    check(state.nodes.len() == rows + 1 && made.parent() == model::node(state, 0), "a node added with nothing selected goes under the root");
    model::delete_selected(state);
}

// How many components the inspector would list for the active row.
fn listed_components(state: &mut editor::State) -> int {
    inspector::node_components(state).len()
}

/// The Physics panel: what its rows add, what its shape actions write, and
/// that every property the soft body declares is one the inspector can draw.
pub fn physics_panel(state: &mut editor::State) {
    let target: int? = nil;
    for index in 0..state.nodes.len() {
        if model::node(state, index).has_component("mesh") || model::node(state, index).has_component("polygon") {
            target = index;
            break;
        }
    }
    if target.is_none() {
        log::info("selftest physics panel: no node with a mesh; skipped");
        return;
    }
    let target = target.unwrap();
    shell::choose(state, target);
    let two_d = model::is_2d(state);
    let collider = if two_d { "collider2d" } else { "collider3d" };
    let soft = if two_d { "softbody2d" } else { "softbody3d" };
    model::add_component(state, collider);
    check(util::contains(inspector::node_components(state), collider), "the inspector lists the {collider} it added");
    // What the mesh can become is the palette's, offered for this node alone.
    let offered: [str] = [];
    for verb in palette::node_verbs(state) {
        offered.push(verb.label);
    }
    check(util::contains(offered, "Collide as hull") && util::contains(offered, "Deform as surface"), "the palette offers the shapes the mesh can be turned into");
    // A shape action writes the mesh and the kind together, in one undo.
    let source = if two_d {
        polygon::component(state, model::node(state, target)).get("mesh")
    } else {
        model::node(state, target).authored("mesh").get("source")
    };
    model::set_component_props(state, collider, map().with("kind", "convex_decomposition").with("mesh", source));
    let written = util::obj(model::node(state, target).authored(collider));
    check(written.get("kind").as_str() == "convex_decomposition", "the decomposition action wrote the collider's kind");
    // The tetrahedrization, and every property it declares drawable.
    model::set_component_props(state, soft, map().with("kind", "volumetric").with("mesh", source));
    let schema = model::schema(state, soft);
    let missing: [str] = [];
    for prop in util::keys_sorted(schema) {
        let spec = schema.get(prop);
        if spec.get("type").as_str() == "" {
            missing.push(prop);
        }
    }
    check(missing.len() == 0, "every {soft} property has a type the inspector can draw");
    check(schema.has("soft_material"), "the soft body names what it is made of");
    let made = util::obj(assets::schema("soft_material"));
    check(made.has("young_modulus") && made.has("tear_strain"), "the soft material holds the mechanical rows");
    check(mirror_resolves(state), "the scene resolves with a soft body on it");
    each_from_its_own_mesh(state, two_d, collider);
    undo_all(state);
    check(mirror_resolves(state), "the undone scene resolves");
    log::info("selftest physics panel: done");
}

// Two meshed nodes turned into colliders at once: each is built from its own
// mesh, not the active row's.
fn each_from_its_own_mesh(state: &mut editor::State, two_d: bool, collider: str) {
    let meshed: [int] = [];
    for index in 0..state.nodes.len() {
        if !physics::drawn_mesh(model::node(state, index), two_d).is_nil() {
            meshed.push(index);
        }
    }
    if meshed.len() < 2 {
        log::info("selftest physics panel: one meshed node, the selection not checked");
        return;
    }
    let pair = [meshed[0], meshed[1]];
    selection::set(state, pair);
    let hull = if two_d { physics2d::SHAPE_CONVEX_HULL } else { physics3d::SHAPE_CONVEX_HULL };
    physics::make_collider(state, two_d, map().with("kind", hull));
    for index in pair {
        let wrote = util::obj(model::node(state, index).authored(collider)).get("mesh");
        let own = physics::drawn_mesh(model::node(state, index), two_d);
        check(wrote == own, "'{model::node(state, index).name()}' is built from its own mesh ({wrote})");
    }
}

/// The bone map dock: the humanoid guessed against a rig's own names, and
/// the map written out as a `bone_map` asset.
pub fn bonemap_panel(state: &mut editor::State) {
    let rig_index: int? = nil;
    for index in 0..state.nodes.len() {
        if rig::bone_count(state, index) > 1 {
            rig_index = index;
            break;
        }
    }
    if rig_index.is_none() {
        log::info("selftest bone map: no rig; skipped");
        return;
    }
    let rig_index = rig_index.unwrap();
    shell::choose(state, rig_index);
    bonemap::clear(state);
    bonemap::autofill(state);
    // Every filled row must name a bone that is actually on the rig: a guess
    // that invents a path would write a map the engine silently ignores.
    let paths = map();
    for bone in skeleton::bones(model::node(state, rig_index)) {
        paths.set(bone.path(), true);
    }
    let base = model::node(state, rig_index).path();
    let sound = true;
    let filled = 0;
    for name in state.bonemap.bones.keys() {
        let rel = state.bonemap.bones.get(name);
        if rel.as_str() == "" {
            continue;
        }
        filled += 1;
        if !paths.has(base + "/" + rel.as_str()) {
            sound = false;
        }
    }
    check(sound, "every guessed row names a bone on the rig ({filled} filled)");
    // The guesser itself, against names an exporter actually writes: the rig
    // in front of the test may share none of the canonical names, and that
    // must not be the only thing this covers.
    let sample = ["Armature/mixamorig:LeftUpperArm", "Armature/left_upper_leg", "Armature/Hips"];
    check(bonemap::guess("LeftUpperArm", sample) == "Armature/mixamorig:LeftUpperArm", "an exporter's prefix does not stop a match");
    check(bonemap::guess("LeftUpperLeg", sample) == "Armature/left_upper_leg", "separators and case do not stop a match");
    check(bonemap::guess("Neck", sample).is_none(), "a bone the rig has not got matches nothing");
    bonemap::clear(state);
    let empty = 0;
    for name in state.bonemap.bones.keys() {
        if state.bonemap.bones.get(name).as_str() != "" {
            empty += 1;
        }
    }
    check(empty == 0, "clear empties every row");
    log::info("selftest bone map: done");
}

/// The Tiles tool: paint, erase, a rectangle, the map growing around a node
/// that stays put, and layers.
///
/// The map is built here rather than found, so the test runs on every example
/// rather than on the one that happens to carry a tilemap. Its tile set is
/// inline and names an image that need not exist: only the palette reads the
/// file, and everything below is arithmetic on cells.
pub fn tiles_tool(state: &mut editor::State) {
    let before = state.nodes.len();
    model::add_child(state, nil);
    let node = model::node(state, state.sel);
    // The editor's own cursor image as the atlas: it is there whichever game
    // is open, so the map draws rather than logging a missing texture.
    node.set_component("tilemap", Tilemap {
        tileset: Tileset { texture: "assets/cursor.png", tile_size: 16.0, columns: 4 },
        cells: [[-1, -1], [-1, -1]],
        pixels_per_unit: 16.0,
    });
    check(tiles::editable(state), "a node with a tilemap is paintable");
    let set = tiles::tileset(state);
    check(set.is_some(), "the inline tile set is read off the node");
    // What the pointer does: a world point in a cell comes back as that cell.
    // Cell 0,0 has its top-left corner on the node, so (0.5, -0.5) is the
    // middle of it and (-0.5, 0.5) is the cell up and to the left.
    let maybe_frame = tiles::frame(state);
    check(maybe_frame.is_some(), "the map has a frame to aim at");
    if maybe_frame.is_some() {
        let frame = maybe_frame.unwrap();
        let hit = tiles::cell_at(state, frame, 0.5, -0.5);
        check(hit.x == 0 && hit.y == 0, "a world point lands in its cell ({hit})");
        let up = tiles::cell_at(state, frame, -0.5, 0.5);
        check(up.x == -1 && up.y == -1, "and the one up and left of it");
    }
    check(tiles::paint(state, 0, 0, 3), "painting writes a cell");
    check(tiles::cell(state, 0, 0) == 3, "the cell holds the tile ({tiles::cell(state, 0, 0)})");
    check(!tiles::paint(state, 0, 0, 3), "painting the same tile again changes nothing");
    check(model::node(state, state.sel).authored("tilemap").get("cells").kind() == "list", "the map is written back as rows of ids");
    check(tiles::paint(state, 0, 0, -1), "erasing writes an empty cell");
    check(tiles::cell(state, 0, 0) == -1, "the cell is empty again");
    // Growing leaves the node where it is: a cell's place is its coordinate,
    // so the map may reach in any direction without sliding.
    let was_x = model::transform_part(model::node(state, state.sel), "position", [0.0, 0.0, 0.0])[0];
    check(tiles::paint(state, 4, 0, 1), "painting past the edge grows the map");
    let rows = tiles::grid(state);
    check(tiles::columns(rows) == 5, "the map is five columns wide ({tiles::columns(rows)})");
    let now_x = model::transform_part(model::node(state, state.sel), "position", [0.0, 0.0, 0.0])[0];
    check(util::abs(now_x - was_x) < 1e-4, "the node stayed where it was ({was_x} to {now_x})");
    // And reaching up and to the left, which the centred map could not do.
    check(tiles::paint(state, -2, -1, 1), "painting above and left of the map grows it there");
    check(tiles::cell(state, -2, -1) == 1, "the cell outside the old grid holds its tile");
    let origin = tiles::origin(state);
    check(origin.x == -2 && origin.y == -1, "the origin moved to reach it ({origin})");
    check(tiles::fill_rect(state, tiles::Cell { x: 0, y: 0 }, tiles::Cell { x: 1, y: 1 }, 2), "a rectangle fills every cell in it");
    check(tiles::cell(state, 0, 0) == 2 && tiles::cell(state, 1, 1) == 2, "the rectangle's corners are filled");
    check(tiles::cell(state, 2, 0) == -1, "and nothing outside it is");
    let layers = state.nodes.len();
    // Counted rather than fixed at two: the game's own maps may be under this
    // parent as well, and they are layers of these two just the same.
    let beside = tiles::layers(state).len();
    check(tiles::add_layer(state), "a layer is added beside the map");
    check(state.nodes.len() == layers + 1, "the layer is a new node ({state.nodes.len()})");
    check(tiles::grid(state).len() == 0 || tiles::columns(tiles::grid(state)) == 0, "the layer has no tiles in it");
    check(tiles::layers(state).len() == beside + 1, "both maps are layers of one another ({tiles::layers(state).len()})");
    check(mirror_resolves(state), "every tilemap node resolves in the mirror");
    undo_all(state);
    check(state.nodes.len() == before, "undoing everything removes both maps ({state.nodes.len()})");
    check(mirror_resolves(state), "the fully-undone scene resolves in the mirror");
    log::info("selftest tiles: done");
}

/// Copy and paste, which the shell drives from a clipboard event no headless
/// run can raise: the two document verbs behind it, asserted directly.
pub fn clipboard(state: &mut editor::State) {
    let before = state.nodes.len();
    let name = model::selected_node(state).name();
    let text = model::copy_selected(state);
    check(text.starts_with("[[nodes]]"), "a copied node encodes as a scene document");
    check(!text.contains("id = "), "the copy carries no id for the paste to collide with");
    check(model::paste_nodes(state, text), "pasting a copied node is accepted");
    check(state.nodes.len() == before + 1, "the paste added one node ({state.nodes.len()})");
    check(model::selected_node(state).name() != name, "the pasted node was renamed");
    check(mirror_resolves(state), "the pasted node resolves in the mirror");
    check(!model::paste_nodes(state, "not a scene at all"), "text that is not a scene is left alone");
    check(state.nodes.len() == before + 1, "and adds nothing");
    undo_all(state);
    check(state.nodes.len() == before, "undo takes the paste back ({state.nodes.len()})");
    check(mirror_resolves(state), "the undone scene resolves in the mirror");
    log::info("selftest clipboard: done");
}

/// The Assets dock's three verbs. Everything it makes it also removes, so a
/// run leaves the example project exactly as it found it.
pub fn assets(state: &mut editor::State) {
    let root = state.game_root + "/";
    state.assets.dir = "";
    state.assets.sel = "";
    dock::new_folder(state);
    let made = state.assets.sel;
    check(made == "new-folder", "a new folder is named for what it is ({made})");
    check(fs::exists(root + made), "the new folder is on disk");
    // A second one cannot take the same name.
    dock::new_folder(state);
    let second = state.assets.sel;
    check(second != made, "a second folder gets its own name ({second})");
    // A scene inside the folder names a file beside it; the rename rewrites
    // the reference and keeps the comment next to it.
    fs::write(root + made + "/thing.toml", "type = \"note\"\npitch = 1.0\n");
    fs::write(root + made + "/user.toml", "[[nodes]]\nname = \"N\"\nsong = \"{made}/thing.toml\" # kept\n");
    state.assets.sel = made;
    dock::rename_asset(state, "renamed-folder");
    check(!fs::exists(root + made), "the old name is gone");
    check(fs::exists(root + "renamed-folder"), "the new name is there");
    check(state.assets.sel == "renamed-folder", "the selection followed the rename");
    let user = fs::read(root + "renamed-folder/user.toml").or("");
    check(user.contains("\"renamed-folder/thing.toml\" # kept"), "the rename rewrote the reference and kept the comment");
    expect_warning("a name cannot be empty or contain a slash");
    dock::rename_asset(state, "with/slash");
    check(fs::exists(root + "renamed-folder"), "a name with a slash is refused");
    dock::delete_asset(state);
    check(!fs::exists(root + "renamed-folder"), "delete removes it");
    check(state.assets.sel == "", "and clears the selection");
    state.assets.sel = second;
    dock::delete_asset(state);
    check(!fs::exists(root + second), "the second folder is cleaned up too");
    log::info("selftest assets: done");
}

/// The Import panel: what it writes beside a picture, and what clearing a key
/// leaves behind. The panel itself is drawn by the Assets dock; this drives
/// the same calls its controls do.
pub fn imports(state: editor::State) {
    let root = state.game_root + "/";
    let rel = "selftest-import.png";
    fs::write(root + rel, "not really a png, and never decoded here");
    let side = root + importer::sidecar_of(rel);
    check(importer::kind_of(rel).as_str() == "texture", "a .png is a texture");
    check(importer::kind_of("scenes/main.toml").as_str() == "", "a scene is no importer's business");
    check(importer::kind_of("ART/HERO.PNG").as_str() == "texture", "the extension is matched whatever its case");
    check(!fs::exists(side), "a picture starts with no settings beside it");
    importer::write(state, rel, "filter", "nearest");
    check(fs::exists(side), "setting a key writes the sidecar");
    let table = importer::sidecar(state, rel);
    check(table.get("filter") == "nearest", "and the sidecar holds what was set");
    importer::write(state, rel, "srgb", false);
    let both = importer::sidecar(state, rel);
    check(both.get("filter") == "nearest" && both.get("srgb") == false, "a second key joins the first rather than replacing it");
    importer::write(state, rel, "srgb", nil);
    let one = importer::sidecar(state, rel);
    check(one.get("srgb").is_nil() && one.get("filter") == "nearest", "clearing one key leaves the other");
    importer::write(state, rel, "filter", nil);
    check(!fs::exists(side), "clearing the last key removes the sidecar");
    // A number rather than the text the dropdown handed back, or the engine
    // reads no anisotropy at all.
    importer::write(state, rel, "anisotropy", 8);
    importer::write(state, rel, "mipmaps", true);
    importer::write(state, rel, "repeat", "mirror");
    importer::write(state, rel, "premultiply", true);
    let sampler = importer::sidecar(state, rel);
    check(sampler.get("anisotropy") == 8, "anisotropy is written as a count");
    check(sampler.get("mipmaps") == true, "and mipmaps as a flag");
    check(sampler.get("repeat") == "mirror", "and repeat as a word");
    check(sampler.get("premultiply") == true, "and premultiply as a flag");
    for key in ["anisotropy", "mipmaps", "repeat", "premultiply"] {
        importer::write(state, rel, key, nil);
    }
    check(!fs::exists(side), "clearing every key removes the sidecar again");
    check(importer::kind_of("art/logo.svg").as_str() == "texture", "an SVG is a texture");
    check(importer::kind_of("sfx/theme.ogg").as_str() == "audio", "a sound takes settings too");
    check(importer::kind_of("fonts/ui-Face.ttf").as_str() == "font", "and a face");
    check(importer::kind_of("models/crate.obj").as_str() == "model", "and a model");
    importer::write(state, rel, "scale", 2.5);
    check(importer::sidecar(state, rel).get("scale") == 2.5, "a number row writes a float");
    importer::write(state, rel, "scale", nil);
    check(export::preview(rel, "web").is_none(), "a file that is no picture ships no row, and nothing throws");
    fs::remove(root + rel);
    log::info("selftest imports: done");
}

/// Picking, aimed by hand. The viewport snapshot a real click reads is empty
/// without a window, which is why `render::pick_ray` takes the ray: a
/// headless run can still aim one and say what it met.
pub fn picking(state: &mut editor::State) {
    state.pick_check = PickCheck { stage: 0, sprite: nil, turned: nil, text: nil };
    stepping(state, "pick_check");
    let target: int? = nil;
    for index in 0..state.nodes.len() {
        let found = model::node(state, index);
        if found.is_valid() && found.has_component("shape3d") {
            let kind = found.get_component("shape3d", "kind").as_str();
            if kind != "" && kind != "mesh" {
                target = index;
                break;
            }
        }
    }
    if target.is_none() {
        log::info("selftest picking: no node with a 3D shape, skipped");
        return;
    }
    let index = target.unwrap();
    let found = model::node(state, index);
    let position = found.transform.global_position();
    let name = model::node(state, index).name();
    // Straight down -z at it from well outside anything.
    let hit = render::pick_ray(position.x, position.y, position.z + 200.0, 0.0, 0.0, -1.0);
    if check(hit.is_valid(), "a ray aimed at '{name}' meets a node") {
        check(model::index_of_live(state, hit).is_some(), "and it is one of the document's");
    }
    // The distance too, which decides between two things under the pointer:
    // a gizmo handle yields to an object in front of it.
    let at = render::pick_ray_at(position.x, position.y, position.z + 200.0, 0.0, 0.0, -1.0);
    if check(at.is_some(), "the ray reports what it met and how far ({at})") {
        let met = at.unwrap();
        check(met.at > 0.0 && met.at < 400.0, "at a sane distance along the ray ({met.at})");
        check(model::index_of_live(state, met.node).is_some(), "and that node is one of the document's");
    }
    check(render::pick_ray_at(position.x, position.y, position.z + 200.0, 0.0, 0.0, 1.0).is_none(), "a ray pointing away reports no distance either");
    // A pick can land on a node the document never named: a mesh's own child,
    // or one a solver owns. The row that owns it is what the click meant.
    check_climbs_to_owner(state);
    // The same ray pointing away meets nothing.
    let behind = render::pick_ray(position.x, position.y, position.z + 200.0, 0.0, 0.0, 1.0);
    check(!behind.is_valid(), "a ray pointing away from the scene picks nothing");
    // Far to the side, past anything the scene contains.
    let aside = render::pick_ray(position.x + 10000.0, position.y, position.z + 200.0, 0.0, 0.0, -1.0);
    check(!aside.is_valid(), "a ray beside the scene picks nothing");
    log::info("selftest picking: done");
}

/// A sprite, which has no shape row, is picked over what it draws and grows
/// with its scale; a text is picked over the lines it is laid out in, which
/// start at its origin; a box whose centre sits off its node's origin turns
/// about that origin. A transform reaches the node's global one, and a text
/// its layout, a frame after it is set, so the checks come two frames after
/// the edits.
pub fn pick_check_step(state: &mut editor::State) {
    if state.pick_check.is_none() {
        return;
    }
    let pick_check = state.pick_check.unwrap();
    pick_check.stage += 1;
    if pick_check.stage == 1 {
        pick_check.sprite = scale_a_sprite(state);
        pick_check.turned = turn_a_box(state);
        pick_check.text = model::spawn(state, state.scene_root.unwrap(), "Picked text", map().with("transform", map().with("position", [0.0, 0.0, 0.0])).with("text2d", map().with("text", "Picked").with("text_align", "start")));
    } else if pick_check.stage == 3 {
        state.pick_check = nil;
        if pick_check.sprite.is_some() {
            sprite_scaled(state, pick_check.sprite.unwrap());
        }
        if pick_check.text.is_some() {
            text_picked(state, pick_check.text.unwrap());
        }
        if pick_check.turned.is_some() {
            box_turned(state, pick_check.turned.unwrap());
        }
    }
}

fn scale_a_sprite(state: &mut editor::State) -> ScaleASprite? {
    for index in 0..state.nodes.len() {
        let found = model::node(state, index);
        if !found.is_valid() {
            continue;
        }
        let bounds = render::bounds(found);
        if !model::node(state, index).has_component("sprite") || bounds.is_none() || bounds.unwrap().len() != 2 {
            continue;
        }
        let drawn = bounds.unwrap();
        let scale = found.transform.scale;
        let position = found.transform.global_position();
        let wide = util::abs(found.transform.global_scale().x);
        let angle = found.transform.global_rotation_euler().z;
        // Twice its drawn half-width out along its own x: past its edge now,
        // and inside once it is three times as wide.
        let out = 2.0 * drawn[1].x * wide;
        let at = [position.x + math::cos(angle) * out, position.y + math::sin(angle) * out];
        check(gizmo2d::covering(state, index, position.x, position.y).is_some(), "a click on the sprite '{model::node(state, index).name()}' lands on it");
        check(gizmo2d::covering(state, index, at[0], at[1]).is_none(), "and one past its drawn edge misses it");
        model::set_transform(state, index, rig::Parts { position: [], rotation_euler: [], scale: [scale.x * 3.0, scale.y, scale.z] });
        return ScaleASprite { index: index, at: at, scale: [scale.x, scale.y, scale.z] };
    }
    log::info("selftest picking: no sprite in this scene, its pick not checked");
    nil
}

fn sprite_scaled(state: &mut editor::State, scaled: ScaleASprite) {
    check(gizmo2d::covering(state, scaled.index, scaled.at[0], scaled.at[1]).is_some(), "until it is three times as wide");
    model::set_transform(state, scaled.index, rig::Parts { position: [], rotation_euler: [], scale: scaled.scale });
}

fn text_picked(state: &mut editor::State, made: Node) {
    let index = model::index_of_node(state, made).unwrap();
    let bounds = render::bounds(made);
    if check(bounds.is_some() && bounds.unwrap().len() == 2, "a text reports the box it is laid out in") {
        let laid = bounds.unwrap();
        let origin = made.transform.global_position();
        let right = origin.x + 2.0 * laid[0].x;
        check(laid[0].x > 0.0, "a text aligned to its start lies right of its origin ({laid[0].x})");
        check(gizmo2d::covering(state, index, origin.x + laid[0].x, origin.y + laid[0].y).is_some(), "a click in the middle of its lines lands on it");
        check(gizmo2d::covering(state, index, right - laid[1].x * 0.1, origin.y).is_some(), "and one near its last letter");
        check(gizmo2d::covering(state, index, origin.x - laid[1].x * 0.5, origin.y).is_none(), "and one left of where it starts misses it");
    }
    made.free();
    model::reindex(state);
}

fn turn_a_box(state: &mut editor::State) -> TurnABox? {
    for index in 0..state.nodes.len() {
        let found = model::node(state, index);
        if !found.is_valid() {
            continue;
        }
        let bounds = render::bounds(found);
        let rotation = found.transform.global_rotation_euler();
        let square = util::abs(rotation.x) + util::abs(rotation.y) + util::abs(rotation.z) < 0.0001;
        if bounds.is_none() || bounds.unwrap().len() != 2 || !square || util::abs(bounds.unwrap()[0].y) < 0.01 {
            continue;
        }
        let centre = bounds.unwrap()[0];
        let scale = found.transform.global_scale();
        let at = found.transform.global_position();
        let held = util::xyz(found.transform.rotation_euler);
        // Half over about x: the box's offset flips in y and z.
        model::set_transform(state, index, rig::Parts { position: [], rotation_euler: [math::PI, 0.0, 0.0], scale: [] });
        return TurnABox {
            index: index,
            held: held,
            want: [at.x + centre.x * scale.x, at.y - centre.y * scale.y, at.z - centre.z * scale.z],
        };
    }
    log::info("selftest picking: no box sits off its node's origin, its turn not checked");
    nil
}

fn box_turned(state: &mut editor::State, turned: TurnABox) {
    let centre = gizmo::extents_at(state, turned.index).unwrap().centre;
    let want = turned.want;
    let off = util::abs(centre[0] - want[0]) + util::abs(centre[1] - want[1]) + util::abs(centre[2] - want[2]);
    check(off < 0.001, "'{model::node(state, turned.index).name()}' turned half over carries its box's centre with it ({centre}, not {want})");
    model::set_transform(state, turned.index, rig::Parts { position: [], rotation_euler: turned.held, scale: [] });
}

// A pick landing on a child resolves to the row that owns it. Tried on a row
// that has one, which the node aimed at above need not.
fn check_climbs_to_owner(state: editor::State) {
    for index in 0..state.nodes.len() {
        let found = model::node(state, index);
        if !found.is_valid() {
            continue;
        }
        for kid in found.children() {
            // Only a child the document never named has anything to climb:
            // one that is itself a row resolved before this existed too.
            if model::index_of_node(state, kid).is_some() {
                continue;
            }
            check(model::index_of_live(state, kid).or(-1) == index, "a child the document never named resolves to its owner '{model::node(state, index).name()}'");
            return;
        }
    }
    log::info("selftest picking: every child is a document row, climb not checked");
}

// The first numeric export in the scene, with the node carrying it. A number
// is what the drag editors write; a string or a bool would be asserting a
// different widget, which is its own test.
fn first_number_export(state: &mut editor::State) -> NumberExport? {
    for index in 0..state.nodes.len() {
        let rel = model::script_rel(model::node(state, index));
        if !rel.is_nil() {
            for export in util::vec(model::exports(state, rel.as_str())) {
                let kind = export.get("type").as_str();
                if kind == "float" || kind == "int" {
                    return NumberExport { at: index, export: export };
                }
            }
        }
    }
    nil
}

// Exported script properties: what the script declares, what the node
// overrides, and the sparseness that keeps a default reaching every node that
// left it alone.
pub fn script_props(state: &mut editor::State) {
    let found = first_number_export(state);
    if found.is_none() {
        log::info("selftest props: no script in this scene exports a number, skipped");
        return;
    }
    let index = found.unwrap().at;
    let export = found.unwrap().export;
    shell::choose(state, index);
    let rel = model::script_rel(model::node(state, index));
    let name = export.get("name").as_str();
    check(export.get("type").as_str() != "", "{rel} declares a type for {name}");
    let was = export.get("default").as_float();
    model::set_script_prop(state, name, was + 5.0);
    let props = model::script_props(model::node(state, index));
    check(props.has(name), "{name} became an override on the node");
    check(util::abs(props.get(name).as_float() - (was + 5.0)) < 1e-6, "{name} holds the written value ({props.get(name)})");
    // Back to the default: the override is dropped rather than written out,
    // so a later change to the script's default reaches this node again.
    model::set_script_prop(state, name, was);
    check(!model::script_props(model::node(state, index)).has(name), "{name} back at its default stops being an override");
    shell::undo(state);
    check(model::script_props(model::node(state, index)).has(name), "undo brings the override back");
    check(mirror_resolves(state), "the mirror still resolves after editing properties");
    log::info("selftest props: done");
}

// A node carrying a `list` property that holds what is written to it: some
// are read back from a backend that only keeps what its own kind uses, and a
// test of the editors needs one whose value stays put.
fn writable_list(state: &mut editor::State) -> WritableList? {
    for index in 0..state.nodes.len() {
        let found = model::node(state, index);
        if !found.is_valid() {
            continue;
        }
        for comp in found.component_names() {
            let schema = model::schema(state, comp);
            for prop in util::keys_sorted(schema) {
                let spec = schema.get(prop);
                let writable = spec.get("readonly").as_bool() != true;
                if spec.get("type").as_str() != "list" || !writable {
                    continue;
                }
                if util::obj(spec.get("of")).get("type").as_str() != "string" {
                    continue;
                }
                // Not the camera's frame passes: the schema says `string`,
                // but a name the engine does not own is a material asset, so
                // `one`/`two` make the renderer log every frame after.
                if prop == "post" {
                    continue;
                }
                shell::choose(state, index);
                model::set_component_prop(state, comp, prop, ["one", "two"]);
                if list_now(state, index, comp, prop).len() == 2 {
                    return WritableList { at: index, comp: comp, prop: prop, spec: spec };
                }
            }
        }
    }
    nil
}

fn list_now(state: editor::State, index: int, comp: str, prop: str) -> any {
    let found = model::node(state, index);
    if !found.is_valid() {
        return [];
    }
    util::vec(util::obj(found.get_component(comp)).get(prop))
}

// A property that holds other properties: what the inspector writes when a
// row inside one is edited, which is the whole value with that one part of it
// replaced.
pub fn composite_props(state: &mut editor::State) {
    let found = writable_list(state);
    if found.is_none() {
        log::info("selftest composites: no component here holds a list that sticks; skipped");
        return;
    }
    let index = found.unwrap().at;
    let comp = found.unwrap().comp;
    let prop = found.unwrap().prop;
    let of = util::obj(found.unwrap().spec.get("of"));
    check(of.has("type"), "{comp}.{prop} says what it holds");
    check(of.has("default"), "{comp}.{prop} holds a default for a new entry");
    let at = inspector::at_top(comp, prop, ["one", "two"]);
    inspector::write_at(state, inspector::at_step(at, 1, "1"), "three");
    let now = list_now(state, index, comp, prop);
    check(now.len() == 2, "{comp}.{prop} still holds two ({now.len()})");
    check(now.at(0).as_str() == "one", "the entry beside it is untouched");
    check(now.at(1).as_str() == "three", "the edited entry took the write ({now})");
    inspector::drop_entry(state, at, 0);
    let left = list_now(state, index, comp, prop);
    check(left.len() == 1, "an entry taken out leaves one ({left.len()})");
    check(left.at(0).as_str() == "three", "the one left is the one that stayed");
    inspector::add_entry(state, at, of, "");
    let grown = list_now(state, index, comp, prop);
    check(grown.len() == 2, "an added entry makes two ({grown.len()})");
    check(grown.at(1).equals(of.get("default")), "a new entry starts at the spec's default");
    undo_all(state);
    check(mirror_resolves(state), "the mirror still resolves after editing a list");
    // Left where a picture of it is worth taking: three entries, the fold
    // they sit in open, and the rest of the schema searched away.
    model::set_component_prop(state, comp, prop, ["ssao", "bloom", "tonemap"]);
    state.search.set("inspector", prop);
    log::info("selftest composites: done");
}

/// A node with a collider, and which of the two it is: one naming its
/// material in a file where the scene has one, so both kinds of edit run.
fn collider_to_edit(state: &mut editor::State) -> any {
    let first: any = nil;
    for index in 0..state.nodes.len() {
        let found = model::node(state, index);
        if !found.is_valid() {
            continue;
        }
        for comp in ["collider2d", "collider3d"] {
            if !found.has_component(comp) {
                continue;
            }
            let at = map().with("at", index).with("comp", comp);
            let named = found.get_component(comp, "physics_material").as_str();
            if named != "" && !named.starts_with("#") {
                return at;
            }
            if first.is_nil() {
                first = at;
            }
        }
    }
    first
}

/// `--state test:record_assets`: an edit on a row under a record asset lands
/// in the definition. On a node naming none, the row takes the definition
/// inline; naming a file, the file is saved, and put back after.
pub fn record_assets(state: &mut editor::State) {
    let found = collider_to_edit(state);
    if found.is_nil() {
        log::info("selftest record assets: no collider here; skipped");
        return;
    }
    let index = found.at.as_int();
    let comp = found.comp.as_str();
    shell::choose(state, index);
    let node = model::node(state, index);
    let named = node.get_component(comp, "physics_material").as_str();
    let at = inspector::at_top(comp, "physics_material", named);
    let friction = inspector::at_step(at, "friction", "Friction");
    if named != "" && !named.starts_with("#") {
        let kept = assets::load(named);
        inspector::write_at(state, friction, 0.125);
        let saved = assets::load(named);
        check(saved.friction.as_float() == 0.125, "an edit under a file's row saves the file ({saved})");
        check(saved.type.as_str() == "physics_material", "the saved file keeps its type");
        assets::save(named, kept);
        log::info("selftest record assets: {named} edited and put back");
    }
    model::set_component_prop(state, comp, "physics_material", "");
    inspector::write_at(state, friction, 0.25);
    let inline = node.get_component(comp, "physics_material").as_str();
    check(inline.starts_with("#!"), "an edit on no material writes one inline ({inline})");
    check(assets::load(inline).friction.as_float() == 0.25, "the inline material holds the edit");
    inspector::write_at(state, inspector::at_step(at, "restitution", "Restitution"), 0.5);
    let both = assets::load(node.get_component(comp, "physics_material").as_str());
    check(both.friction.as_float() == 0.25, "a second edit keeps the first ({both})");
    check(both.restitution.as_float() == 0.5, "and takes its own");
    undo_all(state);
    check(mirror_resolves(state), "the mirror still resolves after editing a material");
    log::info("selftest record assets: done");
}

/// `--state test:system_fonts`: a face this machine has installed is offered
/// under a `font` row and copied into the game's `fonts/` when picked, and a
/// file the list does not name is not copied at all.
pub fn system_fonts(state: &mut editor::State) {
    let single: [project::SystemFont] = [];
    for installed in project::system_fonts() {
        if installed.path.to_lower().ends_with(".ttf") {
            single.push(installed);
        }
    }
    if single.len() == 0 {
        log::info("selftest system fonts: no single face installed; skipped");
        return;
    }
    let face = single[0];
    let offered = fonts::choices(state);
    check(util::contains(offered, "{face.family} {face.style} · system"), "the picker offers the installed face");
    let copied = dropin::copy_system_font(state, face.path);
    if !check(copied.is_some(), "an installed face copies into the game") {
        return;
    }
    let rel = copied.unwrap();
    check(rel.starts_with("fonts/") && assets::kind_of(rel) == "font", "it lands under fonts/ as a font ({rel})");
    check(fs::exists(state.game_root + "/" + rel), "the copy is on disk");
    check(!project::copy_system_font(state.game_root + "/project.toml", state.game_root + "/fonts/probe.ttf"), "a file the list does not name is refused");
    check(!fs::exists(state.game_root + "/fonts/probe.ttf"), "and nothing is written");
    fs::remove(state.game_root + "/" + rel);
    log::info("selftest system fonts: {face.family} {face.style} copied and taken away");
}

/// Forge's answer to a request the catalogue sent, stood in for: a desktop
/// has no Forge to ask.
fn answer(state: &mut editor::State, purpose: str, extra: any) -> bool {
    let id = fonts::request_for(state, purpose);
    if !check(!id.is_nil(), "the catalogue asked for its {purpose}") {
        return false;
    }
    let reply = map().with("kind", http::EVENT_RESPONSE).with("request", id).with("status", 200);
    for key in extra.keys() {
        reply.set(key, extra.get(key));
    }
    fonts::on_response(state, reply);
    true
}

/// `--state test:font_catalogue`: a family picked from the catalogue lands
/// under `fonts/` with its licence beside it and is named by the row it was
/// picked for, with Forge's answers stood in.
pub fn font_catalogue(state: &mut editor::State) {
    model::add_child(state, nil);
    model::add_component(state, "text2d");
    let node = model::node(state, state.sel);
    fonts::open(state, inspector::at_top("text2d", "font", ""));
    let listing = "[{{\"id\":\"probe\",\"family\":\"Probe Sans\",\"category\":\"sans-serif\",\"licence\":\"OFL-1.1\"}}]";
    if !answer(state, "families", map().with("body", listing)) {
        return;
    }
    check(util::vec(state.font_families).len() == 1, "the families are read ({state.font_families})");
    fonts::take(state, util::vec(state.font_families)[0]);
    check(!fonts::finding(state), "a pick closes the catalogue");
    let faces = "{{\"files\":[{{\"file\":\"Probe-Bold.ttf\",\"style\":\"normal\",\"weight\":700}},{{\"file\":\"Probe-Regular.ttf\",\"style\":\"normal\",\"weight\":400}}],\"licence\":\"OFL.txt\"}}";
    if !answer(state, "faces", map().with("body", faces)) {
        return;
    }
    // The download lands under the user directory, as `save_to` puts it.
    let saved = engine::user_data_directory() + "/fonts/Probe-Regular.ttf";
    fs::copy("fonts/SourceSans3-Regular.ttf", saved);
    answer(state, "face", map().with("path", saved).with("body", ""));
    answer(state, "licence", map().with("body", "SIL Open Font License"));
    // The live node holds the mirror's absolute path; the document, the
    // project's own.
    let named = model::relative_file(state, node.get_component("text2d", "font").as_str()).as_str();
    check(named.starts_with("fonts/Probe-Regular"), "the row names the regular face ({named})");
    check(fs::exists(state.game_root + "/" + named), "the face is in the project");
    let licence = state.game_root + "/fonts/Probe-Regular.OFL.txt";
    check(fs::exists(licence), "its licence is beside it");
    fs::remove(state.game_root + "/" + named);
    fs::remove(licence);
    fs::remove(saved);
    undo_all(state);
    log::info("selftest font catalogue: a family fetched, named and taken away");
}

// The first script the scene attaches, which is what a lint sweep starts from.
fn first_script(state: editor::State) -> str? {
    for node in state.nodes {
        let rel = model::script_rel(node);
        if !rel.is_nil() {
            return rel.as_str();
        }
    }
    nil
}

fn found_in(state: editor::State, rel: str, severity: str) -> [any] {
    let out: [any] = [];
    for finding in state.lint.found {
        if finding.get("file").as_str() == rel && finding.get("severity").as_str() == severity {
            out.push(finding);
        }
    }
    out
}

/// `--state test:lint`: a broken buffer is found at the line it broke on, and
/// a good one leaves nothing behind. The buffer, not the file — a check is
/// about what is on screen, and the test must not write a broken script out.
pub fn linting(state: &mut editor::State) {
    let script = first_script(state);
    if !check(script.is_some(), "the scene attaches a script to lint") {
        return;
    }
    let rel = script.unwrap();
    let abs = state.game_root + "/" + rel;
    let original = model::source(state, rel).as_str();
    state.script_buffers.set(abs, "fn probe() {{\n    input::just_pressd(\"jump\");\n}}\n");
    lint::run(state);
    let errors = found_in(state, rel, "error");
    if check(errors.len() > 0, "a misspelled engine call is an error") {
        check(errors[0].get("line").as_int() == 2, "the error's line is 2 (got {errors[0].get("line")})");
        check(errors[0].get("message").as_str().contains("just_pressd"), "the message names the call: {errors[0].get("message")}");
        let marked = false;
        for line in lint::lines(state, rel, "error") {
            if line.as_int() == 2 {
                marked = true;
            }
        }
        check(marked, "the gutter is given line 2");
    }
    state.script_buffers.set(abs, "fn probe() {{\n    let unused = 1;\n}}\n");
    lint::run(state);
    check(found_in(state, rel, "error").len() == 0, "a script that compiles has no errors");
    state.script_buffers.set(abs, original);
    lint::run(state);
    check(found_in(state, rel, "error").len() == 0, "restoring the buffer clears the findings");
    state.script_buffers.remove(abs);
    docks::show(state, "problems");
    log::info("selftest lint: done");
}

/// `--state test:tools`: what the caret is offered, what is under it, and what a
/// rename would rewrite. The buffer, not the file: a tool answers about what
/// is on screen, and the test must not write over a script.
pub fn tooling(state: &mut editor::State) {
    let script = first_script(state);
    if !check(script.is_some(), "the scene attaches a script to ask about") {
        return;
    }
    let rel = script.unwrap();
    let source = model::source(state, rel).as_str();
    // A function of its own at the foot, so the probe is code the file reads.
    let typed = "    physics2d::a";
    let probe = source + "\nfn completion_probe() {{\n" + typed + "\n}}\n";
    let line = probe.split("\n").len() - 2;
    // Completion: a module path offers that module and nothing else.
    let found = script::complete(rel, probe, line, typed.len() + 1);
    if check(found.len() > 0, "a module path completes") {
        let names: [str] = [];
        for one in found {
            names.push(one.label);
        }
        check(util::contains(names, "apply_impulse"), "physics2d::a offers apply_impulse (got {util::join(names, ", ")})");
        check(found[0].doc != "", "the first completion carries its doc line");
    }
    // The popup opens on that caret and closes when it moves off.
    let caret = probe.chars().len() - 3;
    complete::update(state, rel, probe, complete::Caret { index: caret, x: 100.0, y: 100.0 });
    check(state.complete.open, "the popup opens where a caret sits after a module path");
    complete::reset(state);
    check(!state.complete.open, "and closes when it is reset");
    // Hover: a declared function answers with what the host knows about it.
    let at = line_of_text(source, "fn ");
    if at > 0 {
        let text = source.split("\n")[at - 1];
        let column = util::index_of(text, "fn ").unwrap() + 4;
        check(script::hover(rel, source, at, column).is_some(), "hovering a declared function answers");
    }
    // Symbols: what the file declares, from the host rather than a parser.
    check(script::symbols(rel, source).len() > 0, "the file reports its symbols");
    // Find and replace reaches the same files a rename does.
    let hits = script::find(rel, source, "fn ");
    check(hits.len() > 0, "find reaches the text in the file");
    // Formatting is idempotent, and neither verb writes anything.
    let once = script::format(rel, source);
    check(script::format(rel, once) == once, "formatting twice is formatting once");
    let edits = script::rename(rel, source, "node", "owner");
    check(model::source(state, rel).as_str() == source, "a rename answers with the {edits.len()} file(s) it would rewrite, and writes none of them");
    log::info("selftest tooling: done");
}

// The 1-based line a needle first appears on, 0 when it does not.
fn line_of_text(source: str, needle: str) -> int {
    let lines = source.split("\n");
    for index in 0..lines.len() {
        if lines[index].contains(needle) {
            return index + 1;
        }
    }
    0
}

// Prefabs in the editor: an instance's nodes are in the tree, an edit inside
// one becomes an override and an edit back to the prefab's value stops being
// one. Which component it edits is discovered — headless registers no `color`.
pub fn instances(state: &mut editor::State) {
    let hit = first_instanced_float(state);
    if hit.is_none() {
        log::info("selftest instances: no instanced node with a writable float, skipped");
        return;
    }
    let index = hit.unwrap().at;
    let comp = hit.unwrap().float.comp;
    let prop = hit.unwrap().float.prop;
    let spec = hit.unwrap().float.spec;
    let file_rows = rows_in_file(state);
    check(file_rows < state.nodes.len(), "the tree holds nodes the file does not");
    shell::choose(state, index);
    let node = model::node(state, index);
    let owner = model::instance_owner(node);
    let place = model::path_in_instance(node);
    let was = float_prop(model::node(state, index), comp, prop).or(spec.get("default").as_float());
    check(!entry_of(state, owner, place).has(comp), "{place} starts with no override of {comp}");
    model::set_component_prop(state, comp, prop, was + 3.0);
    let entry = entry_of(state, owner, place);
    check(entry.has(comp), "editing {place}.{prop} wrote an override on {owner.name()}");
    // Sparse: the override holds the property that changed, not the whole
    // component, because the engine patches it over the prefab's.
    check(util::obj(entry.get(comp)).len() == 1, "and holds only {prop} ({util::obj(entry.get(comp)).len()} keys)");
    check(rows_in_file(state) == file_rows, "and added no row to the file");
    // Back to the prefab's own value: the override has nothing left to say.
    model::set_component_prop(state, comp, prop, was);
    check(!entry_of(state, owner, place).has(comp), "a {prop} back at the prefab's stops being an override");
    // A prefab's nodes are its instance's: none is a row of the file.
    for row in util::vec(toml::parse(model::node_text(state, state.scene_root.unwrap())).nodes) {
        check(!row.id.as_str().contains("/"), "{row.name} is the file's own, not a prefab's");
    }
    // Structure is the prefab's.
    let before = state.nodes.len();
    expect_warning("cannot add a node inside a prefab");
    model::add_child(state, nil);
    check(state.nodes.len() == before, "adding a node inside an instance is refused");
    expect_warning("cannot delete a node inside a prefab");
    model::delete_selected(state);
    check(state.nodes.len() == before, "deleting a node inside an instance is refused");
    check(mirror_resolves(state), "every row still resolves, instanced ones included");
    log::info("selftest instances: done");
}

// What an instance's owner overrides at one place inside it, as the scene
// would be written.
fn entry_of(state: editor::State, owner: Node, place: str) -> any {
    let written = util::vec(toml::parse(model::node_text(state, owner)).nodes);
    if written.len() == 0 {
        return map();
    }
    util::obj(util::obj(written[0].overrides).get(place))
}

// How many nodes the scene file would hold.
fn rows_in_file(state: editor::State) -> int {
    util::vec(toml::parse(model::node_text(state, state.scene_root.unwrap())).nodes).len()
}

// The inspector's script field: a new name writes and attaches a file, a
// changed name moves it, remove leaves it on disk, and undo walks it all back.
pub fn script_paths(state: &mut editor::State) {
    // Pure string rules, so they hold whatever the project has in it.
    check(model::names_a_file("art/hero.png"), "a project-relative file is a file name");
    check(!model::names_a_file("/games/art/hero.png"), "a rooted path is not");
    check(!model::names_a_file("D:/games/art/hero.png"), "nor is a Windows drive path");
    check(!model::names_a_file("D:\\games\\art\\hero.png"), "with either separator");
    check(!model::names_a_file("../Rig"), "and a node path is not a file");
    let picked: int? = nil;
    for index in 0..state.nodes.len() {
        let node = model::node(state, index);
        if picked.is_none() && model::script_rel(node).is_nil() && !model::is_instanced(node) {
            picked = index;
        }
    }
    if picked.is_none() {
        log::info("selftest scriptdemo: every node has a script; skipped");
        return;
    }
    let index = picked.unwrap();
    selection::only(state, index);
    let root = state.game_root + "/";
    // A project with no scripts/ would be left with an empty one.
    if !fs::exists(root + "scripts") {
        log::info("scriptdemo: skipped, the project has no scripts/");
        return;
    }
    let name = model::node(state, index).name().to_lower();
    let fresh = "scripts/selftest-" + name + ".bs";
    let moved = "scripts/selftest-" + name + "-moved.bs";
    fs::remove(root + fresh);
    fs::remove(root + moved);
    shell::set_script_path(state, fresh);
    check(model::script_rel(model::node(state, index)).as_str() == fresh, "a new name attaches a new file");
    check(fs::exists(root + fresh), "and writes it");
    check(state.script_open, "attaching opens the script tab");
    shell::set_script_path(state, moved);
    check(model::script_rel(model::node(state, index)).as_str() == moved, "a changed name moves the script");
    check(fs::exists(root + moved) && !fs::exists(root + fresh), "and the file with it");
    shell::detach_script(state);
    check(model::script_rel(model::node(state, index)).is_nil(), "detach takes the script off the node");
    check(fs::exists(root + moved), "and leaves the file");
    check(!state.script_open, "and closes the script tab");
    shell::undo(state);
    check(model::script_rel(model::node(state, index)).as_str() == moved, "undo re-attaches it");
    shell::undo(state);
    shell::undo(state);
    check(model::script_rel(model::node(state, index)).is_nil(), "undoing everything leaves the node without a script");
    check(mirror_resolves(state), "and every node still resolves");
    fs::remove(root + moved);
    log::info("selftest scriptdemo: done");
}

// The first row that came from a prefab and has a float the editor can write.
fn first_instanced_float(state: &mut editor::State) -> InstancedFloat? {
    for index in 0..state.nodes.len() {
        if !model::is_instanced(model::node(state, index)) {
            continue;
        }
        let found = model::node(state, index);
        if found.is_valid() {
            let writable = writable_float(state, found);
            if writable.is_some() {
                return InstancedFloat { at: index, float: writable.unwrap() };
            }
        }
    }
    nil
}

// Recording a play session, replaying it, and getting back to the edited
// scene. Spread over frames because a recording is made of frames, and inside
// the `--frames 90` an e2e run allows.
const REC_UNTIL: int = 9;

const OPEN_AT: int = 10;

const CHECK_AT: int = 28;

/// The start screen's own module: a project made from a template, the row it
/// leaves in the list, and the row forgotten again. Writes under the editor's
/// own data directory, which is the one place it owns on every machine.
pub fn manager_screen(state: &mut editor::State) {
    let home = engine::user_data_directory() + "/selftest-project";
    let made = util::obj(project::create(home, "empty"));
    let failed = made.get("error");
    if !failed.is_nil() {
        check(false, "a new project from the empty template ({failed})");
        return;
    }
    check(made.get("name").as_str() != "", "a new project from the empty template ({made.get("name")})");
    let listed = util::vec(project::recent());
    check(lists_path(listed, home), "it is the newest of {listed.len()} remembered");
    let first = util::obj(listed.at(0));
    check(first.get("exists").as_bool() == true, "and its folder is there");
    project::forget(home);
    check(!lists_path(util::vec(project::recent()), home), "forgetting it drops the row and leaves the folder");
    check(util::vec(project::templates()).len() > 0, "the library offers templates to start from");
    check(project::home() != "", "and a folder to put a new project in");
    // A tab opens a project through the page, and the screen's own commands
    // are hidden there. This run is a process, so it says so.
    check(!project::in_tab(), "a process, not a tab, so the screen may open one");
    example_projects(state);
    versions_half(state);
}

// Whether a row of the recent list is the project at `home`.
fn lists_path(rows: any, home: str) -> bool {
    for row in rows {
        if util::obj(row).get("path").as_str() == home {
            return true;
        }
    }
    false
}

// The screen's other half: which build this is and what lines it may follow.
// No network here: what a channel holds is a press, and CI has no releases.
fn versions_half(state: &mut editor::State) {
    let mine = util::obj(release::installed());
    check(mine.get("version").as_str() != "", "the build says which version it is ({mine.get("version")})");
    let lines = util::vec(release::channels());
    check(lines.len() == 5, "and names {lines.len()} release lines to follow");
    let named = names(lines, "nightly") && names(lines, "stable");
    check(named, "the rolling one and the settled one among them");
    // A source build has no id and no tag, and says so rather than guessing.
    let source = mine.get("source").as_bool() == true;
    let told = if source { mine.get("id").as_str() == "" } else { mine.get("id").as_str() != "" };
    check(told, "a build with no release id says so instead of inventing one");
    // Run from cargo's output, the install is a build tree and says so before
    // anything offers to replace it.
    let held = mine.get("held").as_str();
    check(!source || held != "", "a build tree says it cannot be replaced ({held})");
    // What a check reports, handed in as the feed would: the newest release on
    // a line decides what the screen says about it.
    let saved: [any] = state.manager.releases;
    let rows = [
        map().with("tag", "v9.0.0").with("id", "v9.0.0").with("channel", "stable").with("order", "newer").with("current", false),
        map().with("tag", "v0.0.1").with("id", "v0.0.1").with("channel", "alpha").with("order", "older").with("current", false),
    ];
    manager::heard(state, map().with("kind", "listed").with("rows", rows));
    let ahead = manager::standing(state, "stable");
    check(ahead == "v9.0.0 is newer", "a newer release reads as one ({ahead})");
    let behind = manager::standing(state, "alpha");
    check(behind.contains("older"), "an older one is not called newer ({behind})");
    let none = manager::standing(state, "rc");
    check(none == "no release on this line", "an empty line says so ({none})");
    manager::heard(state, map().with("kind", "failed").with("job", "check").with("message", "offline"));
    check(!state.manager.reading && state.manager.failed == "offline", "a failed read stops reading and says why");
    state.manager.releases = saved;
    state.manager.failed = "";
    // The About sheet opens on the same state, without asking the network
    // again once the screen has asked.
    let asked = state.manager.asked;
    state.manager.asked = true;
    about::open(state);
    check(window::showing(state, "about"), "the About dialog opens");
    window::hide(state);
    state.manager.asked = asked;
    // Opened over a project, the screen goes back to it; opened by a state,
    // as a bare launch shows it, there is nothing to go back to.
    let was = state.manager.on;
    manager::open(state);
    manager::close(state);
    check(state.manager.on, "a screen opened by a state stays");
    manager::open_over(state);
    manager::close(state);
    check(!state.manager.on, "one opened over a project goes back to it ({state.game_name})");
    state.manager.on = was;
}

// Whether a list of names holds `name`.
fn names(items: any, name: str) -> bool {
    for one in items {
        if one.as_str() == name {
            return true;
        }
    }
    false
}

// The examples that ship beside the editor, and a copy of one. The copy is
// what the screen opens, so the shipped example stays as it was.
fn example_projects(state: editor::State) {
    let rows = util::vec(project::examples());
    check(rows.len() > 0, "{rows.len()} examples ship beside this build");
    let hello = row_with_id(rows, "hello");
    if hello.is_nil() {
        check(false, "one of them is hello");
        return;
    }
    let one = util::obj(hello);
    check(one.get("note").as_str() != "", "and each says what it is ({one.get("note")})");
    let into = engine::user_data_directory() + "/selftest-copies";
    let made = util::obj(project::copy_example("hello", into));
    let failed = made.get("error");
    if !failed.is_nil() {
        check(false, "a copy of an example is a project of its own ({failed})");
        return;
    }
    check(fs::exists(made.get("path").as_str() + "/project.toml"), "a copy of an example is a project of its own");
    check(made.get("path") != one.get("path"), "written beside the reader's projects, not over the example");
    project::forget(made.get("path").as_str());
}

// The row of a list whose `id` is `id`, or nil.
fn row_with_id(items: any, id: str) -> any {
    for row in items {
        if util::obj(row).get("id").as_str() == id {
            return row;
        }
    }
    nil
}

/// Two fingers on the stage drive the camera: a pinch dollies, a drag slides.
/// Fed rather than felt, so CI answers for the half a phone would.
pub fn gestures(state: &mut editor::State) {
    state.gesture_demo = 0;
    stepping(state, "gesture");
}

pub fn gesture_step(state: &mut editor::State) {
    let frame = state.gesture_demo;
    state.gesture_demo = frame + 1;
    // A fed finger is read by the next tick and acted on later in that frame,
    // so every act takes a frame and every reading the frame after.
    let mid = middle(state.layout.stage);
    let cx = mid[0] * state.ui_scale;
    let cy = mid[1] * state.ui_scale;
    let step = 40.0 * state.ui_scale;
    if frame == 0 {
        let pose = render::camera_pose();
        state.gesture_from = [pose[0], pose[1], pose[2], pose[3], pose[4], pose[5]];
        input::feed_touch(1, cx - step, cy, "start");
        input::feed_touch(2, cx + step, cy, "start");
        return;
    }
    if frame == 1 {
        // Apart: a pinch out, which walks the eye towards what it looks at.
        input::feed_touch(1, cx - step * 2.0, cy, "move");
        input::feed_touch(2, cx + step * 2.0, cy, "move");
        return;
    }
    if frame == 3 {
        let before = state.gesture_from;
        let pose = render::camera_pose();
        let was = span(before[0] - before[3], before[1] - before[4], before[2] - before[5]);
        let now = span(pose[0] - pose[3], pose[1] - pose[4], pose[2] - pose[5]);
        check(now < was - 0.001, "a pinch out walks the camera in ({was} to {now})");
        state.gesture_from = [pose[0], pose[1], pose[2], pose[3], pose[4], pose[5]];
        // Both fingers the same way: a two-finger drag, which slides the pair.
        input::feed_touch(1, cx - step, cy, "move");
        input::feed_touch(2, cx + step * 3.0, cy, "move");
        return;
    }
    if frame == 5 {
        let before = state.gesture_from;
        let pose = render::camera_pose();
        let moved = span(pose[3] - before[3], pose[4] - before[4], pose[5] - before[5]);
        let want = span(before[0] - before[3], before[1] - before[4], before[2] - before[5]);
        // A finger's own travel, near enough: the world under it moved with
        // it rather than by a constant nobody picked.
        check(moved > 0.05 && moved < want, "a two-finger drag slides what it looks at ({moved})");
        input::feed_touch(1, cx, cy, "end");
        input::feed_touch(2, cx, cy, "end");
        state.gesture_demo = -1;
    }
}

fn span(dx: float, dy: float, dz: float) -> float {
    math::sqrt(dx * dx + dy * dy + dz * dz)
}

// The centre must be showing the viewport when no document is open: a stray
// split used to leave a collapsed code pane over it in every workspace.
pub fn layout(state: &mut editor::State) {
    state.layout_demo = 0;
    stepping(state, "layout");
}

pub fn layout_step(state: &mut editor::State) {
    state.layout_demo = state.layout_demo + 1;
    // A settled rect, not the first: the frame the shell first draws it has
    // no size stated yet and its containers divide an unbounded box.
    // Two frames that agree is the signal that the layout has taken.
    let now = state.layout.stage.width.as_float();
    let settled = now > 0.0 && util::abs(now - state.layout_seen) < 0.51;
    state.layout_seen = now;
    if !settled && state.layout_demo < 10 {
        return;
    }
    state.layout_demo = -1;
    let placement = state.layout;
    let stage = placement.stage;
    // A headless run never draws, so the rect is still the one `init` set.
    if state.viewport.at == 0 {
        log::info("layoutdemo: skipped, nothing drew this run");
        return;
    }
    let sx = stage.x.as_float();
    let sy = stage.y.as_float();
    let sw = stage.width.as_float();
    let sh = stage.height.as_float();
    check(!state.split, "the split is off unless asked for");
    // What every window owes, whatever room it has: the stage is inside it,
    // no two sheets claim a pixel, and a finger clears its target.
    check(sx >= 0.0 && sy >= 0.0 && sx + sw <= state.screen_w && sy + sh <= state.screen_h, "the stage is inside the window");
    check(!overlapping(layout::sheets(state)), "no two sheets overlap");
    // A finger wants 44 points. Delivered by the theme stating a bigger box
    // under `touch` and the shell drawing larger, not by a floor on each
    // control: a floor grew the box and left the glyph and its bar behind.
    check_touch_targets(state);
    check_dock_tools(state);
    check_active_tabs(state);
    check(covered(state, layout::sheets(state)), "and the middle of every sheet does not");
    // The gutter is a `padding`, which the component keeps as four sides
    // whatever the scene spelled; reading all four back placed the shell at 0.
    let gutter = (layout::gutter(state)).as_float();
    let bar_x = placement.bar.x.as_float();
    check(gutter > 0.0 && util::abs(bar_x - gutter) < 0.51, "the shell keeps the gutter it asked for ({bar_x} vs {gutter})");
    placed("top bar", placement.bar);
    placed("stage", stage);
    // A root keeps the box it was handed on a pass that is not a fresh one:
    // restyled with none, it sized itself from its content instead.
    let body = ui::widget_rect(scene::get_node("Editor/Shell/Body"));
    check(body.is_some() && body.unwrap().height > state.screen_h * 0.5, "the shell's body grew into the room left over ({body})");
    // A window too small for three columns folds its docks and shows one
    // sheet at a time, so the desktop's invariants are asked of a desktop.
    if docks::one_at_a_time(state) {
        check(!docks::side_open(state) || docks::folded(state, "left") || docks::folded(state, "right"), "one sheet at a time, in a window with room for one");
        return;
    }
    check(state.viewport_live, "the scene is showing");
    check(state.rail_visible, "and the tool rail with it");
    // The docks take the widths the scene states, so the stage is what is
    // left: most of a window with the room for it, its own floor below that.
    let floor = center::stage_floor();
    if !state.compact {
        check(sw > state.screen_w * 0.35 && sh > state.screen_h * 0.4, "the stage is most of the window ({sw as int} × {sh as int})");
    } else {
        check(sw >= floor.width && sh >= floor.height, "the stage keeps its floor ({sw as int} × {sh as int})");
    }
    check(!layout::over_sheet(state, sx + sw / 2.0, sy + sh / 2.0), "the middle of the stage belongs to the scene");
    check(state.viewport.width == sw && state.viewport.height == sh, "the widget layer gets the stage rect");
    // Every sheet the shell is showing is placed: a zero rect turns egui's
    // own area constraint back on and piles the shell into the corner. A
    // folded dock is showing nothing, and has no rect to be wrong about.
    if !docks::folded(state, "left") {
        placed("tree", placement.left);
    }
    if !docks::folded(state, "right") {
        placed("inspector", placement.right);
    }
    if !docks::folded(state, "bottom") {
        placed("dock", placement.bottom);
    }
    placed("tool rail", placement.rail);
    if !docks::folded(state, "left") {
        check(util::abs(placement.left.width.as_float() - placement.tree_w.as_float()) < 0.51, "the tree column is the width the scene asked for ({placement.left.width} vs {placement.tree_w})");
    }
}

// A layout rect with room in it.
fn placed(name: str, rect: any) {
    let width = rect.width.as_float();
    let height = rect.height.as_float();
    check(width > 0.0 && height > 0.0, "the {name} is placed ({width as int} × {height as int})");
}

/// Every control a finger picks clears the target it has to.
///
/// Measured off what was drawn rather than off what the theme states: a
/// control takes its size from the theme, the widget that states one, and the
/// scale, and only the rect it ends up with answers for all three.
fn check_touch_targets(state: editor::State) {
    if !state.touchscreen {
        return;
    }
    let smallest = 1000.0;
    let where = "";
    for path in [
        "Editor/Shell/Head/HeadRow/Brand",
        "Editor/Shell/Head/HeadRow/HeadScroll/HeadStrip",
        "Editor/Shell/Body/Centre/Bottom/BottomHead/BottomTabs/BottomTabsRow",
        "Editor/Shell/Body/Centre/Bottom/BottomHead/BottomTail",
    ] {
        let node = scene::get_node(path);
        if !node.is_valid() {
            continue;
        }
        let boxes = [ui::widget_rect(node)];
        for kid in node.children() {
            boxes.push(ui::widget_rect(kid));
        }
        for rect in boxes {
            if rect.is_none() || rect.unwrap().height <= 0.0 {
                continue;
            }
            let points = rect.unwrap().height * state.ui_scale;
            if points < smallest {
                smallest = points;
                where = path;
            }
        }
    }
    check(smallest >= 44.0, "every control a finger picks clears 44 points (smallest {smallest as int} in {where})");
}

// The panel's own tools sit at the end of the tab row, in a box of their own.
// A hatch that only grows is one pixel wide in a row that hugs, and what it
// draws is clipped: the filter, the hints and the add button all went that way.
fn check_dock_tools(state: editor::State) {
    for side in ["left", "bottom", "right"] {
        if docks::folded(state, side) {
            continue;
        }
        let found = docks::tools_box(side);
        if found.is_none() {
            check(false, "the {side} dock's tools have a box");
            continue;
        }
        let box = found.unwrap();
        // Zero is the tools giving way to the tabs, which is what a dock too
        // narrow for both does. What this catches is the state between: a
        // hatch a pixel or two wide, drawing what the row then clips.
        check(box.width == 0.0 || (box.width > 20.0 && box.height > 12.0), "the {side} dock's tools have room to draw ({box.width as int} × {box.height as int})");
    }
}

// A narrow dock lists what its row cannot hold under "+N"; the active tab is
// never one of them, so the panel showing always has its tab in view.
fn check_active_tabs(state: &mut editor::State) {
    for side in ["left", "bottom", "right"] {
        if docks::folded(state, side) {
            continue;
        }
        let found = docks::active_tab_box(state, side);
        if found.is_some() {
            let tab = found.unwrap().tab;
            let strip = found.unwrap().strip;
            check(tab.x >= strip.x - 0.5 && tab.x + tab.width <= strip.x + strip.width + 0.5, "the {side} dock's active tab is inside its row ({tab.x as int} to {(tab.x + tab.width) as int} in {strip.x as int} to {(strip.x + strip.width) as int})");
        } else {
            check(false, "the {side} dock's active tab has a box");
        }
    }
}

// Sheets may abut, never overlap: an overlap is a rect two owners believe in.
fn overlapping(rects: [any]) -> bool {
    for first_index in 0..rects.len() {
        let first = rects[first_index];
        for second_index in (first_index + 1)..rects.len() {
            let second = rects[second_index];
            let ax = first.x.as_float();
            let ay = first.y.as_float();
            let aw = first.width.as_float();
            let ah = first.height.as_float();
            let bx = second.x.as_float();
            let by = second.y.as_float();
            let bw = second.width.as_float();
            let bh = second.height.as_float();
            if aw > 0.0 && ah > 0.0 && bw > 0.0 && bh > 0.0 && ax < bx + bw && bx < ax + aw && ay < by + bh && by < ay + ah {
                log::warn("sheets overlap: {ax as int},{ay as int} {aw as int}x{ah as int} and {bx as int},{by as int} {bw as int}x{bh as int}");
                return true;
            }
        }
    }
    false
}

fn covered(state: editor::State, rects: [any]) -> bool {
    for rect in rects {
        let at = middle(rect);
        if rect.width.as_float() > 0.0 && rect.height.as_float() > 0.0 && !layout::over_sheet(state, at[0], at[1]) {
            return false;
        }
    }
    true
}

// Tofu is the failure this catches: a row of boxes in the screenshot means
// the chain lost a script, and a missing icon means the font did not load.
// A sheet of labels over the stage, filled when the stage was laid out.
pub fn font_sheet(state: editor::State) {
    let stage = state.layout.stage;
    let controls = [heading("FONT COVERAGE  ·  --state fontdemo"), heading("SCRIPTS")];
    for script in scripts() {
        let name = script.name;
        let sample = script.sample;
        controls.push(map()
            .with("kind", "row")
            .with("height", 24)
            .with("align_items", "center")
            .with("controls", [
                map().with("kind", "label").with("role", "text_caption").with("text", name).with("width", 92),
                big("text_body", sample),
            ]));
    }
    controls.push(heading("FACES"));
    controls.push(map()
        .with("kind", "label")
        .with("role", "text_body")
        .with("text", "heading  Source Sans 3 Semibold")
        .with("font_size", style::XL)
        .with("font", "fonts/SourceSans3-Semibold.ttf"));
    controls.push(map()
        .with("kind", "label")
        .with("role", "text_body")
        .with("text", "ui  Source Sans 3 Regular")
        .with("font_size", style::LG));
    controls.push(map()
        .with("kind", "label")
        .with("role", "text_code")
        .with("text", "mono  JetBrains Mono  0O1lI  ⌘⌥⇧⌃"));
    controls.push(heading("ICONS"));
    let tools: [any] = [];
    for id in ["select", "move", "rotate", "scale", "zoom", "key", "bone", "polygon"] {
        tools.push(big("text_body", icons::tool(id)));
    }
    for workspace in defs::workspaces() {
        tools.push(big("text_caption_primary", icons::workspace(workspace.id)));
    }
    controls.push(map().with("kind", "row").with("height", 24).with("controls", tools).with("gap", [8, 0]));
    let panels: [any] = [];
    for id in ["output", "problems", "assets", "timeline", "debugger", "recordings", "profiler"] {
        panels.push(big("text_body", icons::panel(id)));
    }
    for id in ["add", "close", "minimize", "search", "dark", "play", "pause", "stop", "instance", "split"] {
        panels.push(big("text_caption", icons::ui(id)));
    }
    controls.push(map().with("kind", "row").with("height", 24).with("controls", panels).with("gap", [8, 0]));
    util::fill(FONT_SHEET, map().with("visible", true).with("x", stage.x).with("y", stage.y).with("width", stage.width).with("height", stage.height));
    pool::strip(state, FONT_SHEET, controls);
}

fn heading(text: str) -> any {
    map()
        .with("kind", "label")
        .with("role", "text_heading")
        .with("text", text)
}

fn big(role: str, text: str) -> any {
    map().with("kind", "label").with("role", role).with("font_size", style::XL).with("text", text)
}

const FONT_SHEET: str = "Editor/FontSheet";

fn scripts() -> [Script] {
    [
        Script { name: "latin", sample: "Plataforma Ångström" },
        Script { name: "greek", sample: "Διάστημα" },
        Script { name: "cyrillic", sample: "Вращатель" },
        Script { name: "japanese", sample: "ボール 平台" },
        Script { name: "korean", sample: "플랫폼" },
        Script { name: "chinese", sample: "平台 旋转" },
        Script { name: "arabic", sample: "لوحة" },
        Script { name: "hebrew", sample: "פלטפורמה" },
        Script { name: "devanagari", sample: "मंच" },
        Script { name: "thai", sample: "แพลตฟอร์ม" },
    ]
}

pub fn sessions(state: &mut editor::State) {
    state.session.demo = Demo { frames: 0, file: "", was: 0 };
    stepping(state, "session");
    // With digests, so the replay is actually checked against the recording
    // rather than merely running.
    state.session.verify = true;
    shell::toggle_play(state);
    check(state.session.recording != "", "play starts a recording");
    check(state.playing, "and the scene is running");
}

pub fn session_step(state: &mut editor::State) {
    if state.session.demo.is_none() {
        return;
    }
    let demo = state.session.demo.unwrap();
    demo.frames += 1;
    if demo.frames == REC_UNTIL {
        stop_and_check(state, demo);
    } else if demo.frames == OPEN_AT {
        open_and_check(state, demo);
    } else if demo.frames == CHECK_AT {
        replayed_and_check(state, demo);
    }
}

// Stopping closes the file. What it wrote is the session the dock lists.
fn stop_and_check(state: &mut editor::State, demo: Demo) {
    shell::stop_play(state);
    check(state.session.recording == "", "stop closes the recording");
    check(replay::recording().is_none(), "and the engine has none open");
    let rows = session::listing(state);
    if !check(rows.len() > 0, "the recording it wrote is on disk") {
        state.session.demo = nil;
        return;
    }
    let row = rows[0];
    demo.file = row.name;
    check(row.started != "", "the list says when it ran");
    check(row.ticks > 0, "and how long: {row.ticks} ticks");
    check(row.reason == "stop", "and how it ended: {row.reason}");
    check(!row.stale, "its scripts are the ones on disk");
}

// Replaying rebuilds the scene, feeds the recording into it, and hands the
// dock its lanes.
fn open_and_check(state: &mut editor::State, demo: Demo) {
    if demo.file == "" {
        state.session.demo = nil;
        return;
    }
    session::open(state, demo.file);
    if !check(session::loaded(state), "{demo.file} loads") {
        state.session.demo = nil;
        return;
    }
    check(replay::state() == replay::STATE_PLAYING, "and starts playing");
    check(state.playing, "the scene runs while it plays");
    let span = util::obj(replay::length());
    check(span.get("frames").as_int() > 0, "the recording has frames");
    check(state.session.lanes.len() > 0, "the dock has lanes to draw");
    demo.was = replay::position();
}

// Playing walks the recording and parks at its end; closing puts the edited
// scene back and lets the engine run again.
fn replayed_and_check(state: &mut editor::State, demo: Demo) {
    check(replay::position() > demo.was, "playing walks the recording forward");
    check(replay::state() == replay::STATE_PAUSED, "a spent recording parks");
    let split = replay::divergence_tick();
    let where_ = if split.is_none() { "" } else { " (tick {split.unwrap().tick})" };
    check(split.is_none(), "and reproduced what was recorded{where_}");
    session::close(state);
    exported_and_check(state, demo);
    check(!session::loaded(state), "closing unloads the recording");
    check(!state.playing, "and puts the edited scene back");
    // A self-test that leaves files behind fills the ring it is testing.
    fs::remove(session::dir(state) + "/" + demo.file);
    state.session.demo = nil;
    log::info("selftest recordings: done");
}

// Export puts a copy where a bug report or `balaur replay` can reach it.
fn exported_and_check(state: editor::State, demo: Demo) {
    session::export(state, demo.file);
    let out = state.game_root + "/" + demo.file;
    check(fs::exists(out), "copy to project puts the recording in the project");
    fs::remove(out);
}

// The profiler's data path: that `engine::timings()` answers with the shape
// the dock reads. Every duration is legitimately zero inside `init`; that the
// numbers are real is `crates/balaur_core/tests/timings.rs`' job.
pub fn timings(state: &mut editor::State) {
    let found = engine::timings();
    if !check(found.is_some(), "engine::timings() answers with a table") {
        return;
    }
    let reading = found.unwrap();
    check(reading.fixed_steps >= 0, "it carries the frame and its fixed steps");
    check(reading.spans.kind() == "map", "and a place for named spans");
    let stages: any = reading.stages;
    for name in [
        "first",
        "pre_update",
        "update",
        "fixed_update",
        "post_update",
        "scene_sync",
        "render",
        "last",
    ] {
        if !check(stages.has(name), "stage '{name}' is in the table") {
            return;
        }
    }
    let total = 0.0;
    for name in stages.keys() {
        total += stages.get(name).as_float();
    }
    // The frame contains its stages and the gaps between them, so it is never
    // the smaller number. A profiler that said otherwise would be measuring
    // something else.
    check(reading.frame >= total - 1e-9, "the frame ({reading.frame}) covers its stages ({total})");
    // The stages are the smaller half of a windowed frame: the mirror, the UI
    // pass and the render land outside them, and `wall` is what the loop took.
    if reading.wall > 0.0 {
        check(reading.wall >= reading.frame - 1e-9, "the loop's frame ({reading.wall}) covers its stages ({reading.frame})");
    }
    log::info("selftest timings: done");
}

// Placing a prefab from the editor: the palette's verb adds an instance node,
// the engine builds the prefab under it, and undo takes the whole thing back.
pub fn placing(state: &mut editor::State) {
    let scenes = model::scene_files(state);
    let candidates: [str] = [];
    for rel in scenes {
        if rel != state.scene_rel {
            candidates.push(rel);
        }
    }
    if candidates.len() == 0 {
        log::info("selftest placing: this project has no second scene to instance, skipped");
        return;
    }
    let rel = candidates[0];
    let before = state.nodes.len();
    let file_rows = rows_in_file(state);
    shell::choose(state, 0);
    model::instance_scene(state, rel);
    let node = model::node(state, state.sel);
    check(node.instance().or("") == rel, "the new node instances {rel}");
    check(rows_in_file(state) == file_rows + 1, "exactly one row was added to the file");
    check(state.nodes.len() > before + 1, "and the prefab's own nodes came with it ({state.nodes.len()} in all)");
    check(mirror_resolves(state), "every row resolves, the new prefab's included");
    // A scene that instanced itself would recurse; the verb refuses.
    let held = state.nodes.len();
    expect_warning("a scene cannot instantiate itself");
    model::instance_scene(state, state.scene_rel);
    check(state.nodes.len() == held, "a scene refuses to instance itself");
    shell::undo(state);
    check(state.nodes.len() == before, "undo takes the instance back ({state.nodes.len()} rows)");
    check(mirror_resolves(state), "and the mirror is whole again");
    log::info("selftest placing: done");
}

/// `--state test:plugin_docks`: the editor's half of the plugin seam. Registering a
/// dock has to put a tab somewhere, or nothing can ever bring the panel up.
pub fn plugin_docks(state: &mut editor::State) {
    if !check(state.registry.panels.len() > 0, "a plugin registered a panel") {
        return;
    }
    for entry in state.registry.panels {
        let side = docks::side_of(state, entry.id);
        if !check(side.is_some(), "the {entry.id} dock has a tab") {
            continue;
        }
        check(side.unwrap() == "bottom", "and it is in the bottom dock ({side.unwrap()})");
        check(docks::panels(state).has(entry.id), "the panel table names {entry.id}");
        docks::show(state, entry.id);
        check(docks::showing(state, entry.id), "showing {entry.id} brings it up");
    }
    // The User data dock with every file at its root opened: what a plugin
    // fills its host with is rows, and a file's contents are rows under the
    // row that opens it.
    docks::show(state, "userdata");
    open_user_files(state);
    state.plugin_demo = 0;
    stepping(state, "plugin");
    log::info("selftest plugin docks: done");
}

// The file the dock is asked to open, written into the game's own user data
// directory because a fresh project keeps nothing the dock could read.
const PROBE_FILE: str = "kitprobe.toml";

// The kit remembers an open file under `file:<dock>:<path>`; this is the one
// place outside it that writes those keys, so the test sees a file's rows.
fn open_user_files(state: &mut editor::State) {
    if state.kit_state.is_nil() {
        state.kit_state = map();
    }
    fs::write(kit::game_data(state) + "/" + PROBE_FILE, "alpha = 1\nbeta = \"two\"\n");
    state.kit_state.set("file:userdata:" + PROBE_FILE, true);
}

// Two frames: the host is made and filled on the first draw after this, and a
// node reports the box it was given the pass after it was laid out.
const PLUGIN_SETTLED: int = 3;

/// What a plugin left on the scene once its dock has drawn: the subtree the
/// editor made for it, and a row per file under it.
/// Frames `test:profiler` gives a rebuild to land, and the counts to
/// gather after it.
const PROFILE_SETTLED: int = 4;

// The Profiler's scripts switch: every script, the editor's own among them,
// is rebuilt with counters between frames and counts what it runs; switched
// off, rebuilt without, it counts nothing.
pub fn profiler(state: &mut editor::State) {
    if state.script_profiling {
        dock::profiler_scripts(state);
    }
    dock::profiler_scripts(state);
    check(state.script_profiling, "the Profiler's scripts switch is on");
    state.profile_demo = 0;
    stepping(state, "profile");
}

pub fn profile_step(state: &mut editor::State) {
    state.profile_demo += 1;
    if state.profile_demo == PROFILE_SETTLED {
        let costs = engine::script_costs();
        check(costs.len() > 0, "the scripts count what they run once rebuilt");
        let ran = costs.len() > 0 && costs[0].instructions > 0;
        check(ran, "the dearest of them ran statements");
        check(engine::function_costs().len() > 0, "and their functions are rows");
        dock::profiler_scripts(state);
        check(!state.script_profiling, "switched off");
    } else if state.profile_demo == 2 * PROFILE_SETTLED {
        state.profile_demo = -1;
        check(engine::script_costs().len() == 0, "rebuilt without counters, nothing counts");
        log::info("selftest profiler: done");
    }
}

pub fn plugin_step(state: &mut editor::State) {
    state.plugin_demo = state.plugin_demo + 1;
    if state.plugin_demo < PLUGIN_SETTLED {
        return;
    }
    state.plugin_demo = -1;
    let host = docks::plugin_host(state, "bottom", "userdata");
    let rows = scene::get_node(host + "/Split/Body/Rows");
    if !check(rows.is_valid(), "the plugin's host is a subtree ({host})") {
        return;
    }
    let shown = 0;
    for row in rows.children() {
        if row.get_component("widget", "visible").as_bool() == true {
            shown += 1;
        }
    }
    check(shown > 1, "the dock's files are rows on it ({shown})");
    let labels: [str] = [];
    for row in rows.children() {
        let label = row.get_node("L");
        if label.is_valid() && label.get_component("widget", "visible").as_bool() == true {
            labels.push(label.get_component("widget", "text").as_str());
        }
    }
    check(util::contains(labels, "alpha") && util::contains(labels, "beta"), "an opened file's keys are rows under it ({labels})");
    fs::remove(kit::game_data(state) + "/" + PROBE_FILE);
}

/// `--state test:palette`: the palette opens on a query, its matches are rows
/// on the scene, and the query survives the frames after it is set.
pub fn palette_screen(state: &mut editor::State) {
    shell::open_palette(state, "physics");
    state.palette_demo = 0;
    stepping(state, "palette");
}

// Three frames: the field has to have drawn and written back before the query
// being intact means anything.
const PALETTE_SETTLED: int = 3;

pub fn palette_step(state: &mut editor::State) {
    state.palette_demo = state.palette_demo + 1;
    if state.palette_demo < PALETTE_SETTLED {
        return;
    }
    state.palette_demo = -1;
    check(state.palette_query == "physics", "a palette query survives the frames after it is set ('{state.palette_query}')");
    let host = scene::get_node("Editor/Picker/PickerScroll/PickerRows");
    if !check(host.is_valid(), "the palette's matches are nodes") {
        return;
    }
    let shown: [bool] = [];
    for row in host.children() {
        if row.get_component("widget", "visible").as_bool() == true {
            let slot = row.get_node("H").get_node("C").get_node("C0");
            shown.push(slot.get_component("widget", "checked").as_bool() == true);
        }
    }
    check(shown.len() > 1, "the query narrowed the list to its matches ({shown.len()})");
    let held = 0;
    for on in shown {
        if on {
            held += 1;
        }
    }
    check(shown.len() > 0 && shown[0] && held == 1, "the first match alone wears the held look, which is what Enter runs ({shown})");
    let box = ui::widget_rect(scene::get_node("Editor/Picker"));
    check(box.is_some() && box.unwrap().height > 100.0, "the picker is as tall as the matches it holds ({box})");
    shell::close_palette(state);
}

/// `--state test:panels`: every row of the mark's menu opens the panel it names
/// and closes it again. A panel something else reopens on the same frame, or
/// one no dock will take, reads as a row that does nothing.
pub fn menu_panels(state: &mut editor::State) {
    let ids = docks::known(state);
    check(ids.len() > 10, "the menu lists every panel ({ids.len()})");
    for id in ids {
        let was = docks::side_of(state, id).is_some();
        docks::toggle(state, id);
        let now = docks::side_of(state, id).is_some();
        if !check(now != was, "{id} toggles ({was} to {now})") {
            continue;
        }
        docks::toggle(state, id);
        check(docks::side_of(state, id).is_some() == was, "and {id} toggles back");
    }
    log::info("selftest menu panels: done");
}

/// `--state test:focus`: focus folds the shell round the code, and leaving it
/// puts back exactly the layout it folded.
pub fn focusing(state: &mut editor::State) {
    if !shell::select_scripted(state) {
        log::info("selftest: no scripted node in this scene; focus skipped");
        return;
    }
    // A panel up on every side, so folding them has something to fold.
    for id in ["outline", "inspector", "output"] {
        docks::show(state, id);
    }
    let was = map();
    for side in docks::sides() {
        was.set(side, state.docks.get(side).get("shut"));
    }
    check(shell::focus_target(state), "the selection has a script to focus");
    shell::toggle_focus(state);
    center::modes(state);
    check(state.focus && state.doctab == "script", "focus takes, and the code is what shows");
    check(!state.split, "the split is off under it");
    check(docks::all_folded(state), "every dock is folded away");
    check(state.hooks_open, "and the file's symbols stay beside the code");
    shell::toggle_focus(state);
    center::modes(state);
    check(!state.focus, "leaving focus clears it");
    let back = true;
    for side in docks::sides() {
        if !state.docks.get(side).get("shut").equals(was.get(side)) {
            back = false;
        }
    }
    check(back, "and every dock comes back to what it was");
    // Leaving the code is leaving focus: the shell comes back with the tab.
    shell::toggle_focus(state);
    shell::open_doc(state, "scene");
    center::modes(state);
    check(!state.focus, "showing the scene again ends focus");
    check(!docks::all_folded(state), "and the docks come back with it");
    // A panel asked for under focus keeps its dock; the record goes instead.
    shell::open_doc(state, "script");
    shell::toggle_focus(state);
    docks::show(state, "output");
    center::modes(state);
    check(!state.focus, "a panel opened under focus ends it");
    check(!docks::folded(state, "bottom"), "and stays open");
    for side in docks::sides() {
        state.docks.get(side).set("shut", was.get(side));
    }
    log::info("selftest focus: done");
}

/// `--state test:settings`: the settings screen's search field and the query it
/// filters by are one thing, which they stopped being for a frame; then a
/// value written on the screen is round-tripped through the file.
pub fn settings_screen(state: &mut editor::State) {
    settings::open_search(state, "theme");
    state.settings.demo = 0;
    stepping(state, "settings");
}

// Three frames: the sidebar's field has to have drawn and written back before
// the query being intact means anything.
const SETTINGS_SETTLED: int = 3;

pub fn settings_step(state: &mut editor::State) {
    state.settings.demo = state.settings.demo + 1;
    let at = state.settings.demo;
    if at < SETTINGS_SETTLED {
        return;
    }
    if at == SETTINGS_SETTLED {
        check(settings::query(state) == "theme", "a settings query survives the frames after it is set ('{settings::query(state)}')");
        // The sheet is a `dialog` node stating its own size: hugging, its bar
        // measures and its body is left with nothing.
        let body = ui::widget_rect(scene::get_node("Editor/Sheet/SheetBody"));
        check(body.is_some() && body.unwrap().height > 100.0, "the sheet's body has the room its frame states ({body})");
        // Typed rather than set: the field's text is what a key press
        // changes, and the list has to follow it.
        let field = scene::get_node("Editor/Sheet/SheetBody/SheetSplit/SheetSide/SheetSideRows/C0");
        if check(field.is_valid() && field.get_component("widget", "kind").as_str() == "text_field", "the sidebar's first control is the search field") {
            ui::edit(field, "scale");
        }
        return;
    }
    if at < SETTINGS_SETTLED + 2 {
        return;
    }
    state.settings.demo = -1;
    check(settings::query(state) == "scale", "typing in the field is the query ('{settings::query(state)}')");
    let note = scene::get_node("Editor/Sheet/SheetBody/SheetSplit/SheetScroll/SheetForm/R0/H/C/C0");
    let said = if note.is_valid() { note.get_component("widget", "text").as_str() } else { "" };
    check(said.contains("matching \"scale\"") && !said.starts_with("0 "), "and the list is the matches for it ({said})");
    settings_round_trip(state);
}

// A value written on the screen reaches the editor's preferences file and
// comes back out of it. The file is put back as it was found.
fn settings_round_trip(state: &mut editor::State) {
    let path = "editor/recordings/keep";
    let kept = fs::read(settings::prefs_path());
    let was = settings::get(path);
    let before = if was.is_nil() { 10 } else { (was.as_float() as int) };
    let want = before + 3;
    settings::write(state, path, want);
    check(state.settings.dirty, "writing a setting marks the screen unsaved");
    check((settings::get(path).as_float() as int) == want, "and the value took ({want})");
    settings::commit_prefs(state);
    let text = fs::read(settings::prefs_path());
    if check(text.is_some(), "the preferences file was written") {
        check(text.unwrap().contains("keep"), "and names the setting that changed");
        settings::merge_toml(text.unwrap());
        check((settings::get(path).as_float() as int) == want, "a re-read of the file agrees ({settings::get(path)})");
    }
    settings::write(state, path, before);
    if kept.is_some() {
        fs::write(settings::prefs_path(), kept.unwrap());
    } else {
        fs::remove(settings::prefs_path());
    }
    state.settings.dirty = false;
    log::info("selftest settings: done");
}

/// `--state test:export_runtime`: the Export sheet's Runtime choice is the
/// project's `[export] runtime`, and each row names the runtime it builds on.
/// The manifest is put back as it was found.
pub fn export_runtime(state: &mut editor::State) {
    let path = state.game_root + "/project.toml";
    let kept = fs::read(path);
    let was = settings::base("export/runtime");
    exporter::open(state);
    // Whichever the project does not already name, so the write is seen.
    let pick = if was.as_str() == "2d" { "3d" } else { "2d" };
    exporter::pick_runtime(state, pick);
    let text = fs::read(path).or("");
    check(text.contains("runtime = \"{pick}\""), "a runtime picked on the sheet is written to project.toml ({pick})");
    check(export_row_runtime(state, "web") == "web-" + pick, "and the web row builds on it ({export_row_runtime(state, "web")})");
    check(export_row_runtime(state, "linux-x64-server") == "linux-x64-server", "while a server keeps its own ({export_row_runtime(state, "linux-x64-server")})");
    exporter::pick_runtime(state, "full");
    check(export_row_runtime(state, "web") == "web", "full puts the web row back on the full runtime ({export_row_runtime(state, "web")})");
    if was.kind() == "str" {
        settings::write(state, "export/runtime", was);
    }
    if kept.is_some() {
        fs::write(path, kept.unwrap());
    }
    state.settings.dirty = false;
    log::info("selftest export runtime: done");
}

fn export_row_runtime(state: editor::State, name: str) -> str {
    for row in state.exporter.rows {
        if util::obj(row).get("name").as_str() == name {
            return util::obj(row).get("runtime").as_str();
        }
    }
    ""
}

pub fn theme_switch(state: &mut editor::State) {
    theme::set_dark(state, true);
    check(state.theme.get("dark").as_bool() == true, "the editor uses the dark theme");
    let dark_sheet = scene::get_node("Editor/Sheet").get_component("widget", "theme");
    theme::set_dark(state, false);
    check(state.theme.get("dark").as_bool() == false, "the switch reaches the light theme");
    check(state.theme.get("bg_app").as_str() != "", "and the light theme loaded its colors");
    // The sheet, the palette and the start screen are roots of their own, not
    // under the shell, and each has to wear the switch too.
    for path in ["Editor/Shell", "Editor/Manager", "Editor/Picker", "Editor/Sheet"] {
        let now = scene::get_node(path).get_component("widget", "theme");
        check(now.kind() == "str" && now.as_str().starts_with("#!") && !now.equals(dark_sheet), "{path} uses the light theme ({now})");
    }
    theme::set_dark(state, true);
    check(state.theme.get("dark").as_bool() == true, "and switches back to the dark one");
    follow_the_system(state);
    bundled_pairs(state);
    log::info("selftest theme: done");
}

// Under `mode = "system"` the half follows what the system says, and a mode
// of its own holds whatever the system says. The setting is put back.
fn follow_the_system(state: &mut editor::State) {
    let mode = settings::get(theme::MODE_SETTING);
    let pinned = state.theme_half;
    state.theme_half = "";
    settings::set(theme::MODE_SETTING, "system");
    theme::follow(state, false);
    check(state.theme.get("half").as_str() == "light" && !state.theme.get("dark").as_bool(), "under system, a light system wears the light half");
    theme::follow(state, true);
    check(state.theme.get("half").as_str() == "dark" && state.theme.get("dark").as_bool(), "and a dark one the dark half");
    settings::set(theme::MODE_SETTING, "light");
    theme::follow(state, true);
    check(state.theme.get("half").as_str() == "light", "a light mode holds whatever the system says");
    settings::set(theme::MODE_SETTING, mode);
    state.theme_half = pinned;
    theme::follow(state, engine::dark_mode());
}

// Every bundled pair is a folder with both halves, and the list the setting
// offers is the list the editor ships.
fn bundled_pairs(state: editor::State) {
    let found: [str] = [];
    for entry in util::vec(fs::list("themes")) {
        if entry.get("is_dir").as_bool() {
            found.push(entry.get("name").as_str());
        }
    }
    let folders: any = found;
    let bundled: any = theme::BUNDLED();
    let listed = bundled.sorted();
    check(folders.sorted().equals(listed), "the bundled folders are the bundled list ({folders.sorted()} vs {listed})");
    let options: any = [];
    for def in settings::all() {
        if def.path == theme::SETTING {
            options = util::vec(util::obj(def.spec).get("options"));
        }
    }
    check(options.sorted().equals(listed), "and the setting offers the same ({options.sorted()})");
    for name in theme::BUNDLED() {
        for half in theme::HALVES() {
            check(theme::read(name, half).kind() == "map", "{name} has its {half} half");
        }
    }
}

/// `--state test:theme_editing`: a bundled theme is read-only, a duplicate is the
/// person's to edit, an edit is worn at once and saved as only what differs,
/// and deleting it goes back to its base. The preferences file is put back.
pub fn theme_editing(state: &mut editor::State) {
    let prefs = settings::prefs_path();
    state.themewin.test = themewin::Test { kept: fs::read(prefs), name: "" };
    theme::set_dark(state, true);
    themewin::open(state);
    check(window::showing(state, "theme"), "the Theme dialog opens");
    check(!themewin::editable(state), "a bundled theme is read-only");
    let before = state.theme.get("primary_text").as_str();
    themewin::edit(state, ["colors"], "primary_text", "#ff0000");
    check(state.theme.get("primary_text").as_str() == before, "and an edit to it changes nothing");
    let name = themewin::duplicate(state);
    state.themewin.test.name = name;
    let path = theme::path_of(name, state.theme.get("half").as_str());
    check(fs::exists(path), "duplicating writes {path}");
    check(state.theme.get("name").as_str() == name && themewin::editable(state), "and the copy is worn and editable");
    check(names(theme::names(), name), "and listed beside the bundled ones");
    themewin::edit(state, ["colors"], "primary", "#e0a868");
    check(state.theme.get("primary_fill").as_str() == "#e0a868", "a source color is used at once");
    check(state.theme.get("primary_text").as_str() != before, "and moves what derives from it ({state.theme.get("primary_text")})");
    themewin::edit(state, ["colors"], "primary_text", "#ff0000");
    check(state.theme.get("primary_text").as_str() == "#ff0000", "a stated token wins over its rule");
    let sheet = scene::get_node("Editor/Sheet").get_component("widget", "theme");
    check(sheet.kind() == "str" && sheet.as_str().starts_with("#!"), "and the dialog's node carries it embedded");
    themewin::edit(state, ["roles", "tab"], "font_size", 13);
    themewin::save(state);
    let text = fs::read(path).or("");
    check(text.contains("primary_text") && text.contains("base = \"balaur\""), "saving writes the edit under its base: {text}");
    check(text != "" && !text.contains("background ="), "and nothing it leaves to that base");
    theme::reload(state);
    check(state.theme.get("primary_text").as_str() == "#ff0000", "the saved theme reads back");
    check(state.theme.get("roles").get("tab").get("font_size").as_int() == 13, "with the role key it changed");
    check(state.theme.get("roles").get("tab").get("text_color").as_str() == "text_subtle", "and the keys its base holds");
    check(state.themewin.pairs.len() > 50, "every role's contrast is measured ({state.themewin.pairs.len()})");
    themewin::show_role(state, "tab", "");
    state.themewin.demo = 0;
    stepping(state, "themewin");
}

/// `--state test:sheet_close`: a sheet and the palette shut when their `dialog`
/// is shut from outside, as egui does on Escape or a click on the dim. The
/// close is put on the node the way the input settle puts it, between frames.
pub fn sheet_closing(state: &mut editor::State) {
    about::open(state);
    state.window.demo = 0;
    stepping(state, "window");
}

pub fn sheet_close_step(state: &mut editor::State) {
    state.window.demo = state.window.demo + 1;
    let at = state.window.demo;
    if at == 3 {
        check(window::showing(state, "about"), "the sheet stays up while nothing shuts it");
        util::fill("Editor/Sheet", map().with("open", false));
    } else if at == 5 {
        check(!window::showing(state, "about"), "and goes when its dialog is shut from outside");
        shell::open_palette(state, "");
    } else if at == 8 {
        check(state.palette, "the palette stays up while nothing shuts it");
        util::fill("Editor/Picker", map().with("open", false));
    } else if at == 10 {
        state.window.demo = -1;
        check(!state.palette, "and goes when its dialog is shut from outside");
        log::info("selftest sheetclose: done");
    }
}

// Three frames: the pooled rows have to be made and drawn before one of them
// can be read back.
const THEME_SETTLED: int = 3;

pub fn theme_edit_step(state: &mut editor::State) {
    state.themewin.demo = state.themewin.demo + 1;
    if state.themewin.demo < THEME_SETTLED {
        return;
    }
    state.themewin.demo = -1;
    let host = scene::get_node("Editor/Sheet/SheetBody/SheetSplit/SheetScroll/SheetForm");
    let roles: [str] = [];
    for row in host.children() {
        if row.get_component("widget", "visible").as_bool() == true {
            let slot = row.get_node("H").get_node("C").get_node("C0");
            roles.push(slot.get_component("widget", "role").as_str());
        }
    }
    check(util::contains(roles, "tab"), "the Controls page draws the tab role as itself ({roles.len()})");
    let name = state.themewin.test.name;
    themewin::remove(state);
    check(!fs::exists(theme::folder_of(name)), "deleting removes the folder");
    check(state.theme.get("name").as_str() == theme::DEFAULT, "and the editor goes back to the base");
    let kept = state.themewin.test.kept;
    let prefs = settings::prefs_path();
    if kept.is_some() {
        fs::write(prefs, kept.unwrap());
    } else {
        fs::remove(prefs);
    }
    settings::load_files(state);
    window::hide(state);
    log::info("selftest themeedit: done");
}

/// A row's authored x, which a node that names no transform has at zero.
fn doc_x(state: editor::State, index: int) -> float {
    model::transform_part(model::node(state, index), "position", [0.0, 0.0, 0.0])[0]
}

/// The selection set: extending it, aligning two nodes, undoing that, and
/// grouping. Every check is on document state, so it runs with no window.
// The Snap chip a drag reads is the one the strip toggles.
fn snap_chip(state: &mut editor::State) {
    if !state.chip_state.has(defs::WORKSPACE_SCENE) {
        state.chip_state.set(defs::WORKSPACE_SCENE, map());
    }
    let chips = state.chip_state.get(defs::WORKSPACE_SCENE);
    let was = chips.get(defs::CHIP_SNAP);
    chips.set(defs::CHIP_SNAP, true);
    check(viewport::snapping(state), "a drag snaps once the Snap chip is on");
    chips.set(defs::CHIP_SNAP, false);
    check(!viewport::snapping(state), "and not once it is off");
    if was.is_nil() {
        chips.remove(defs::CHIP_SNAP);
    } else {
        chips.set(defs::CHIP_SNAP, was);
    }
}

pub fn selecting(state: &mut editor::State) {
    snap_chip(state);
    if state.nodes.len() < 2 {
        log::info("selftest selecting: this scene has one node, skipping");
        return;
    }
    // Two siblings: a parent and its child are one root between them, and
    // group would then adopt one node rather than two. Apart on x if any are,
    // or the align below has nothing to do and proves nothing.
    let first_index = 0;
    let second_index = 1;
    let found = false;
    let apart = false;
    for index in 0..state.nodes.len() {
        for other in index + 1..state.nodes.len() {
            let same = model::parent_id(state, model::node(state, index)) == model::parent_id(state, model::node(state, other));
            let differs = util::abs(doc_x(state, index) - doc_x(state, other)) > 1e-3;
            if same && (!found || (differs && !apart)) {
                first_index = index;
                second_index = other;
                found = true;
                apart = differs;
            }
        }
    }
    if !found {
        log::info("selftest selecting: this scene has no two siblings, skipping");
        return;
    }
    selection::only(state, first_index);
    check(selection::count(state) == 1, "a plain choose selects one node");
    selection::toggle(state, second_index);
    check(selection::count(state) == 2, "toggling a second node extends the set");
    check(state.sel == second_index, "and the node just added is the active one");
    selection::toggle(state, second_index);
    check(selection::count(state) == 1 && state.sel == first_index, "toggling it again drops it");
    selection::set(state, [first_index, second_index]);
    let before = [doc_x(state, first_index), doc_x(state, second_index)];
    arrange::align(state, 0, "min");
    // The document, not `global_position`: that is as of the last transform
    // sync, and the two are siblings, so one parent frame holds both.
    check(util::abs(doc_x(state, first_index) - doc_x(state, second_index)) < 1e-4, "align on x puts two nodes on one plane ({doc_x(state, first_index)} and {doc_x(state, second_index)})");
    shell::undo(state);
    check(util::abs(doc_x(state, first_index) - before[0]) < 1e-4 && util::abs(doc_x(state, second_index) - before[1]) < 1e-4, "undo puts the align back ({doc_x(state, first_index)} and {doc_x(state, second_index)})");
    check(selection::count(state) == 2, "and restores the set that made it");
    let was = state.nodes.len();
    selection::set(state, [first_index, second_index]);
    arrange::group(state);
    check(state.nodes.len() == was + 1, "group adds one node");
    check(model::node(state, state.sel).name().starts_with("Group"), "and selects it");
    let group_id = model::node(state, state.sel).stable_id();
    let adopted = 0;
    for node in state.nodes {
        if model::parent_id(state, node) == group_id {
            adopted += 1;
        }
    }
    check(adopted == 2, "with both nodes under it");
    shell::undo(state);
    check(state.nodes.len() == was, "undo takes the group away");
    selection::only(state, first_index);
    check(!selection::is_locked(state, first_index), "a node starts unlocked");
    arrange::toggle_locked(state);
    check(selection::is_locked(state, first_index), "lock marks it");
    arrange::toggle_locked(state);
    check(!selection::is_locked(state, first_index), "and the same command unmarks it");
    check(model::node(state, first_index).visible(), "a node starts visible");
    arrange::toggle_hidden(state);
    check((model::node(state, first_index).visible() == false), "hide writes visible = false");
    arrange::toggle_hidden(state);
    check((model::node(state, first_index).visible() == true), "and showing writes it back");
    check(mirror_resolves(state), "the mirror still resolves after all of it");
    log::info("selftest selecting: done");
}

/// Every file a previous drop test left under `art/`.
fn clear_drops(state: editor::State) {
    for entry in util::vec(fs::list(state.game_root + "/art")) {
        if entry.get("name").as_str().starts_with("selftest-drop") {
            fs::remove(state.game_root + "/art/" + entry.get("name").as_str());
        }
    }
}

/// Drag-in: one case per extension, with no window. The image and font cases
/// copy a real file; the import case is only asked whether it claims the name,
/// because running `balaur import` needs a model to import.
pub fn dropping(state: &mut editor::State) {
    check(dropin::kind_of("art/hero.png") == "image", "a .png drops as an image");
    check(dropin::kind_of("MODELS/Robot.GLB") == "import", "a .glb goes through the importer, whatever its case");
    check(dropin::kind_of("shaders/water.wesl") == "shader", "a .wesl drops as a shader");
    check(dropin::kind_of("skies/studio.hdr") == "sky", "an .hdr drops as a sky");
    check(dropin::kind_of("scenes/enemy.toml") == "scene", "a scene drops as a prefab");
    check(dropin::kind_of("fonts/Inter.ttf") == "font", "a font drops as a font");
    check(dropin::kind_of("notes.txt") == "", "and nothing claims a text file");
    check(dropin::stem_of("/tmp/My Model-01.glb") == "my_model_01", "the stem is the importer's own naming rule");
    let root = state.game_root + "/";
    let source = root + "selftest-drop.png";
    // Anything a previous run left: `copy_in` numbers a name it finds taken,
    // so a leftover would make this run write `_3` and assert on `_2`.
    clear_drops(state);
    // A real image: a 2D drop makes a `sprite`, which sizes itself from the
    // picture and cannot do that with a file of prose.
    fs::copy("assets/balaur-logo.png", source);
    let was = state.nodes.len();
    dropin::take(state, source);
    check(state.nodes.len() == was + 1, "dropping an image adds one node");
    check(fs::exists(root + "art/selftest-drop.png"), "and copies the file under art/");
    let made = model::selected_node(state);
    let named = made.has_component("sprite") || made.has_component("mesh");
    check(named, "the node it makes draws the picture");
    dropin::take(state, source);
    check(fs::exists(root + "art/selftest-drop_2.png"), "a second drop of one name is numbered, not overwritten");
    // A card dragged out of the Assets panel names the file where it lies:
    // the panel hears the drop and hands it to the Editor.
    let panel = scene::get_node(ASSETS_PANEL);
    let cards = util::obj(panel.get_node("Cards").get_component("widget"));
    check(cards.get("draggable").as_bool() && panel.has_method("on_widget_event") && scene::get_node("Editor").has_method("assets_dropped"), "the Assets panel's cards hand a drop to the panel, and it to the Editor");
    dropin::place_file(state, "art/selftest-drop.png");
    let placed = model::selected_node(state);
    let drawer = placed.authored(if placed.has_component("sprite") { "sprite" } else { "mesh" });
    let drawn = util::obj(drawer).get("texture").as_str();
    check(state.nodes.len() == was + 3 && drawn == "art/selftest-drop.png" && !fs::exists(root + "art/selftest-drop_3.png"), "a file placed from the Assets panel is named where it lies ({drawn})");
    shell::undo(state);
    shell::undo(state);
    shell::undo(state);
    check(state.nodes.len() == was, "undo takes both back");
    // A sky: it retargets the scene's `environment` when there is one, and
    // places one when there is not.
    let sky = root + "selftest-drop.hdr";
    fs::copy("assets/balaur-logo.png", sky);
    let had_env = false;
    for node in state.nodes {
        if node.has_component("environment") {
            had_env = true;
        }
    }
    dropin::take(state, sky);
    let named = false;
    for node in state.nodes {
        if util::obj(node.authored("environment")).get("sky").as_str() != "" {
            named = true;
        }
    }
    check(named, "dropping a sky names it on an environment");
    check(state.nodes.len() == was + (if had_env { 0 } else { 1 }), "on the one that was there, or a new one");
    shell::undo(state);
    fs::remove(sky);
    for entry in util::vec(fs::list(root + "skies")) {
        fs::remove(root + "skies/" + entry.get("name").as_str());
    }
    fs::remove(source);
    clear_drops(state);
    log::info("selftest dropping: done");
}

// Where the converted script is checked as if it were saved.
const CONVERTED: str = "scripts/converted.bs";

// What the script check calls an error in `text`, by message.
fn errors_in(text: str) -> [str] {
    let out: [str] = [];
    for found in script::check(CONVERTED, text) {
        if found.severity == "error" {
            out.push(found.message);
        }
    }
    out
}

/// The Events view authors rows and writes the script they are equivalent to.
pub fn eventviews(state: &mut editor::State) {
    let target: int? = nil;
    for index in 0..state.nodes.len() {
        if model::node(state, index).has_component("bindings") {
            target = index;
        }
    }
    if target.is_none() {
        log::info("selftest eventviews: this scene has no bindings, skipping");
        return;
    }
    let at = target.unwrap();
    selection::only(state, at);
    let was = events::rows(state).len();
    check(was > 0, "the selected node carries binding rows");
    events::add_row(state);
    check(events::rows(state).len() == was + 1, "adding a row adds one");
    shell::undo(state);
    check(events::rows(state).len() == was, "and undo takes it back");
    let written = events::as_script(state);
    check(written.contains("pub fn on_pointer_click(button: any)"), "the script it writes declares the hook the rows answer");
    check(written.contains(".states.set_state(\"open\")"), "a state row becomes the call that goes to it");
    check(written.contains("scene::variable(\"score\")"), "a `when` becomes the read that fetches the variable");
    check(!written.contains("self.get_node") && !written.contains("self.queue_free"), "a row's call goes through the node, not the script's own fields");
    let problems = errors_in(written);
    check(problems.len() == 0, "and the script it writes compiles: {problems}");
    let own = events::script_of("DoorEvents", [map().with("event", events::EMITTED + "died").with("action", "free")]);
    check(own.contains("pub fn on_died(payload: any)") && own.contains("events::listen(self.node, \"died\", self.node)"), "a row on the node's own event hears it by subscribing: {own}");
    let own_problems = errors_in(own);
    check(own_problems.len() == 0, "and compiles: {own_problems}");
    // The control: the name the old conversion wrote is one the check refuses.
    let refused = errors_in("fn on_emitted:died() {{}}\n");
    check(refused.len() > 0, "the check does refuse a name with a colon in it");
    let known = util::vec(scene::bindable_events());
    check(names(known, "pointer_click"), "the engine names the events");
    let verbs = util::vec(scene::binding_actions());
    check(names(verbs, "set_state") && names(verbs, "set_variable"), "and the actions");
    check(mirror_resolves(state), "the mirror still resolves");
    // Left on the tab, so the shot this state takes is of the rows and the
    // step below sees what the pool put on the scene.
    state.doctab = "events";
    state.events_demo = 0;
    stepping(state, "events");
    log::info("selftest eventviews: done");
}

// Two frames: the pool writes the rows on the first draw after this, and a
// node reports the box it was given the pass after it was laid out.
const EVENTS_SETTLED: int = 3;

/// The bindings as the pool left them: a row per binding, each carrying the
/// controls that edit it.
pub fn events_step(state: &mut editor::State) {
    state.events_demo = state.events_demo + 1;
    if state.events_demo < EVENTS_SETTLED {
        return;
    }
    state.events_demo = -1;
    let host = scene::get_node(events::rows_host());
    if !check(host.is_valid(), "the bindings view is a node") {
        return;
    }
    let shown = 0;
    for row in host.children() {
        if row.get_component("widget", "visible").as_bool() == true {
            shown += 1;
        }
    }
    check(shown > events::rows(state).len(), "every binding is a row, and the headings under them ({shown})");
    let box = ui::widget_rect(host);
    check(box.is_some() && box.unwrap().width > 200.0, "the rows have the width the document area gives them ({box})");
}

/// The file a node's `mesh` asset names, read off the live node: the document
/// held the right path all along, and the mirror's engine did not.
fn mesh_file(state: editor::State, name: str) -> str {
    for index in 0..state.nodes.len() {
        let node = model::node(state, index);
        if node.name() == name {
            let found = model::node(state, index);
            if found.is_valid() {
                let reference = util::obj(found.get_component("mesh")).get("source").as_str();
                // Loading nothing is an error that ends the call, not a nil.
                if reference == "" {
                    return "";
                }
                let definition = assets::load(reference);
                if definition.kind() == "map" {
                    return definition.get("source").as_str();
                }
            }
        }
    }
    ""
}

// What the engine warns about on a node, by message.
fn warned(found: Node) -> [str] {
    let out: [str] = [];
    for warning in scene::warnings(found) {
        out.push(warning.message);
    }
    out
}

/// The project-relative files directly under one directory.
fn named_under(state: editor::State, dir: str) -> [str] {
    let out: [str] = [];
    for entry in util::vec(fs::list(state.game_root + "/" + dir)) {
        if !entry.get("is_dir").as_bool() {
            out.push(dir + "/" + entry.get("name").as_str());
        }
    }
    out
}

/// The row views, read off the nodes they fill rather than off the scripts
/// that fill them: what a view puts on a node is what the reader sees.
///
/// One stage a frame, because a node holds nothing until the shell has drawn
/// it once and a pick is only answered by the pass after the one that made it.
const SCENE_PANEL: str = "Editor/Shell/Body/Left/LeftSheet/SceneTree";

const TREE_NODE: str = "Editor/Shell/Body/Left/LeftSheet/SceneTree/Tree";

const ASSETS_PANEL: str = "Editor/Shell/Body/Centre/Bottom/Assets";

/// Search the Scene panel as someone typing into it would be answered, and
/// keep the query for the checks that follow.
fn rows_search(state: &mut editor::State, query: str) {
    state.rows_query = query;
    scene::get_node(SCENE_PANEL).call("find", query);
}

pub fn row_views(state: &mut editor::State) {
    state.rows_demo = 0;
    stepping(state, "rows");
    state.rows_want = 0;
    state.rows_waited = 0;
    state.rows_query = "";
}

/// A model dropped on the window: the import runs off the frame, so what it
/// wrote is asserted once the job says it is finished rather than straight
/// after the drop.
const DROPPED_MODEL: str = "examples/rig3d/models/column.glb";

/// What the import writes, and so what the teardown removes. A project that
/// already has one of these is not a clean drop: `examples/rig3d` ships
/// `models/column.glb`, and the demo would overwrite it and then delete it.
fn IMPORT_WRITES() -> [str] {
    ["models/column.glb", "scenes/column.toml", "animations/column.toml"]
}

/// What the import writes, so a run can take it back out: this imports into
/// the example project the audit runs on, and a leftover would make the next
/// run assert on files it did not write.
fn clear_import(state: editor::State) {
    for rel in IMPORT_WRITES() {
        fs::remove(state.game_root + "/" + rel);
    }
}

pub fn importing(state: &mut editor::State) {
    if state.game_root == "" {
        log::info("selftest jobdemo: no project open in this run, skipped");
        return;
    }
    for rel in IMPORT_WRITES() {
        if fs::exists(state.game_root + "/" + rel) {
            log::info("selftest jobdemo: " + rel + " is already here, skipped rather than overwrite it");
            return;
        }
    }
    state.import_demo = 0;
    stepping(state, "import");
    state.import_waited = 0;
}

pub fn import_step(state: &mut editor::State) {
    if state.import_demo == 0 {
        state.import_demo = 1;
        dropin::take(state, DROPPED_MODEL);
        // A report reaches the list on the next pump at the soonest, whether
        // the job runs on a thread or under the tick.
        check(state.jobs.len() == 0, "nothing is claimed before a report arrives");
        return;
    }
    if state.import_demo == 1 {
        // On a desktop the job has a thread and may be done by the next frame,
        // so what is asserted is where it ends, not when.
        let job = util::obj(state.jobs.get(DROPPED_MODEL));
        if job.get("over").as_str() == "" {
            waited_for_import(state);
            return;
        }
        check(import::running_count() == 0, "a finished import lets go of its place");
        check(dropin::in_flight(state) == 0, "and nothing is in flight");
        check(job.get("name").as_str() == "column.glb", "the list says which file");
        check(job.get("over").as_str() == "imported", "and how it ended ({job.get("over")})");
        check(job.get("done").as_int() == 3 && job.get("files").as_int() == 3, "with what it wrote ({job.get("done")} of {job.get("files")})");
        let root = state.game_root + "/";
        check(fs::exists(root + "models/column.glb"), "the model landed in the project");
        check(fs::exists(root + "scenes/column.toml"), "with a scene written beside it");
        let named = false;
        for node in state.nodes {
            if node.name() == "Column" {
                named = true;
            }
        }
        check(named, "the scene it wrote was instanced");
        // The engine reads the instanced scene itself, so the mesh inside it
        // is the one thing the document cannot vouch for.
        let names = mesh_file(state, "ColumnMesh");
        check(names.starts_with(state.game_root), "the instanced mesh names a file in the game ({names})");
        // The instanced node goes before its files do: left standing it names
        // a model this teardown is about to delete, and the renderer says so
        // every frame for the rest of the run.
        shell::undo(state);
        clear_import(state);
        // Again, stopped as it starts. A thread may write all three files
        // before the press lands, so either end is right if the two agree.
        state.jobs = map();
        state.import_waited = 0;
        state.import_demo = 2;
        dropin::take(state, DROPPED_MODEL);
        import::cancel();
        return;
    }
    let job = util::obj(state.jobs.get(DROPPED_MODEL));
    if job.get("over").as_str() == "" {
        waited_for_import(state);
        return;
    }
    check(import::running_count() == 0, "a stopped import lets go of its place");
    let landed = fs::exists(state.game_root + "/models/column.glb");
    check(job.get("over").as_str() == "stopped" || job.get("over").as_str() == "imported", "it ends stopped or, on a thread already done, imported ({job.get("over")})");
    check(job.get("over").as_str() != "imported" || landed, "an import that says it finished wrote its model");
    check(job.get("over").as_str() != "stopped" || job.get("done").as_int() < 3, "a stop says how few files it wrote ({job.get("done")})");
    // The same argument as the first teardown, for the end the cancel loses:
    // an import that finished anyway instanced its scene, and the node names
    // the model the next line deletes.
    if job.get("over").as_str() == "imported" {
        shell::undo(state);
    }
    clear_import(state);
    state.import_demo = -1;
    log::info("selftest jobdemo: done");
}

// A frame spent waiting for the import to end, and the give-up after 300.
fn waited_for_import(state: &mut editor::State) {
    state.import_waited = state.import_waited + 1;
    if state.import_waited > 300 {
        state.import_demo = -1;
        check(false, "the import ended within 300 frames");
    }
}

/// Editing a game camera writes what the author set: the editor holds every
/// game camera off the view without writing its `current`.
pub fn camera_document(state: &mut editor::State) {
    model::add_child(state, nil);
    let row = state.sel;
    model::add_component(state, model::CAMERA_3D);
    model::hold_game_cameras(state, false);
    model::set_component_prop(state, model::CAMERA_3D, "fov_degrees", 50.0);
    let written = util::obj(model::node(state, row).authored(model::CAMERA_3D));
    check(!written.get("fov_degrees").is_nil(), "the camera edit reached the document");
    let current = written.get(model::CAMERA_CURRENT);
    check(current.is_nil() || current.as_bool(), "and the document keeps the camera current ({current})");
    // An edit to `current` itself is the author's, and the editor keeps looking.
    model::set_component_prop(state, model::CAMERA_3D, model::CAMERA_CURRENT, false);
    check(util::obj(model::node(state, row).authored(model::CAMERA_3D)).get(model::CAMERA_CURRENT).equals(false), "turning the camera off is written");
    model::set_component_prop(state, model::CAMERA_3D, model::CAMERA_CURRENT, true);
    check(util::obj(model::node(state, row).authored(model::CAMERA_3D)).get(model::CAMERA_CURRENT).equals(true), "and so is turning it back on");
    let live = model::node(state, row);
    check(live.get_component(model::CAMERA_3D, model::CAMERA_CURRENT).as_bool(), "and the camera holds it, the view held off it by the editor");
    model::delete_selected(state);
    log::info("selftest camera document: done");
}

/// A node made a soft body from what it draws, in one undo step: a sprite is
/// traced into a textured polygon the cells bend, a shape becomes the
/// generator that matches it, and undo puts the node back.
pub fn soft_recipes(state: &mut editor::State) {
    let sprite_row: int? = nil;
    let shape_row: int? = nil;
    for index in 0..state.nodes.len() {
        let source = recipes::soft_body_source(state, index).or("");
        if source == "sprite" && sprite_row.is_none() {
            sprite_row = index;
        }
        if source == "shape" && shape_row.is_none() {
            shape_row = index;
        }
    }
    if sprite_row.is_none() && shape_row.is_none() {
        log::info("selftest recipes: nothing here to make a soft body of, skipped");
        return;
    }
    if sprite_row.is_some() {
        let row = sprite_row.unwrap();
        check(recipes::soft_body(state, row), "a sprite becomes a soft body");
        let node = model::node(state, row);
        check(!node.has_component("sprite") && node.has_component("polygon") && node.has_component("softbody2d"), "drawn by a polygon of the image, bent by a soft body");
        let drawn = util::vec(node.authored("polygon").get("mesh").get("positions")).len();
        let built = util::vec(node.authored("softbody2d").get("mesh").get("positions")).len();
        check(drawn >= 3 && drawn == built, "the body is built from the outline the polygon draws ({built} of {drawn})");
        let bad = warned(model::node(state, row));
        check(bad.len() == 0, "and the node has nothing to warn about ({bad})");
        undo_all(state);
        check(model::node(state, row).has_component("sprite") && !model::node(state, row).has_component("softbody2d"), "undo puts the sprite back");
    }
    if shape_row.is_some() {
        let row = shape_row.unwrap();
        let two_d = model::node(state, row).has_component("shape2d");
        check(recipes::soft_body(state, row), "a shape becomes a soft body");
        let body = if two_d { "softbody2d" } else { "softbody3d" };
        let shape = if two_d { "shape2d" } else { "shape3d" };
        check(model::node(state, row).has_component(body) && !model::node(state, row).has_component(shape), "the {shape} became a {body} of its size");
        check(model::node(state, row).has_component(body), "and the live node has it");
        undo_all(state);
    }
    log::info("selftest recipes: done");
}

/// Changing a node's type keeps what it draws: a sprite made a rigid body
/// gets a collider of its outline, a body made static keeps its collider, a
/// shape made a polygon keeps its outline, and each is one undo step. A soft
/// body added from the picker asks what to build it from first.
pub fn change_types(state: &mut editor::State) {
    let sprite_row: int? = nil;
    let shape_row: int? = nil;
    for index in 0..state.nodes.len() {
        let node = model::node(state, index);
        if node.has_component("sprite") && recipes::soft_body_source(state, index).or("") == "sprite" && sprite_row.is_none() {
            sprite_row = index;
        }
        if node.has_component("shape2d") && !node.has_component("body2d") && shape_row.is_none() {
            shape_row = index;
        }
    }
    // Every node lists what it can become without throwing, whatever it holds.
    let listed = 0;
    for index in 0..state.nodes.len() {
        listed += recipes::targets(state, index).len();
    }
    check(listed > 0, "every node lists what it can become ({listed} targets)");
    if sprite_row.is_none() && shape_row.is_none() {
        log::info("selftest change type: nothing 2D here to change, skipped");
        return;
    }
    if sprite_row.is_some() {
        let row = sprite_row.unwrap();
        selection::only(state, row);
        let offered: [str] = [];
        for target in recipes::targets(state, row) {
            offered.push(target.name);
        }
        check(util::contains(offered, "rigid_body2d") && !util::contains(offered, "rigid_body3d"), "a sprite is offered the 2D types and not the 3D ones ({offered})");
        check(recipes::change_type(state, row, "rigid_body2d"), "a sprite becomes a rigid body");
        let node = model::node(state, row);
        check(node.has_component("sprite") && node.has_component("body2d"), "and keeps drawing its sprite");
        let collider = util::obj(node.authored("collider2d"));
        check(collider.get("kind").as_str() == physics2d::SHAPE_CONVEX_DECOMPOSITION && !collider.get("mesh").is_nil(), "its collider is cut from the sprite's outline ({collider.get("kind")})");
        check(model::node(state, row).has_component("collider2d"), "and the live node collides");
        let bad = warned(model::node(state, row));
        check(bad.len() == 0, "with nothing to warn about ({bad})");
        check(recipes::change_type(state, row, "static_body2d"), "a rigid body becomes a static one");
        let body = util::obj(model::node(state, row).authored("body2d"));
        check(body.get("kind").as_str() == physics2d::BODY_STATIC && util::obj(model::node(state, row).authored("collider2d")).get("kind").as_str() == physics2d::SHAPE_CONVEX_DECOMPOSITION, "and keeps the collider it had");
        undo_all(state);
        check(!model::node(state, row).has_component("body2d") && !model::node(state, row).has_component("collider2d"), "undo takes both changes back");
        // The picker's own path: a soft body over a node that draws a sprite
        // is built from it without asking.
        newnode::open_change(state);
        check(state.newnode && state.newnode_change, "Change type opens the picker");
        let soft: newnode::Entry? = nil;
        for row_of in newnode::catalogue(state) {
            if row_of.name == "soft_body2d" {
                soft = row_of;
            }
        }
        check(soft.is_some(), "and offers a soft body");
        if soft.is_some() {
            newnode::place(state, soft.unwrap());
            check(!state.newnode && model::node(state, row).has_component("softbody2d") && !model::node(state, row).has_component("sprite"), "which is built from the sprite and closes the picker");
        }
        undo_all(state);
    }
    if shape_row.is_some() {
        let row = shape_row.unwrap();
        check(recipes::change_type(state, row, "polygon2d"), "a shape becomes a polygon");
        let points = util::vec(util::obj(util::obj(model::node(state, row).authored("polygon")).get("mesh")).get("positions"));
        check(points.len() >= 4 && !model::node(state, row).has_component("shape2d"), "of the shape's outline ({points.len()} points)");
        undo_all(state);
    }
    let before = state.nodes.len();
    selection::only(state, 0);
    newnode::open(state);
    let soft: newnode::Entry? = nil;
    for row_of in newnode::catalogue(state) {
        if row_of.name == "soft_body2d" {
            soft = row_of;
        }
    }
    if soft.is_some() {
        newnode::place(state, soft.unwrap());
        check(state.newnode && state.newnode_soft == "2d", "a new soft body asks what to build it from");
        let sources = newnode::catalogue(state);
        check(sources.len() >= 2 && sources[0].label == "Rectangle", "a shape first ({sources.len()} sources)");
        newnode::place_source(state, sources[1]);
        check(state.nodes.len() == before + 1 && model::node(state, state.sel).has_component("softbody2d") && !state.newnode, "and builds it from the one picked");
        shell::undo(state);
        check(state.nodes.len() == before, "which one undo takes back");
    }
    log::info("selftest change type: done");
}

/// What the engine says is off reaches the editor: a mark on the tree's row,
/// and a refused write that leaves the document as it was and names the
/// property it was refused on, rather than throwing out of the inspector.
pub fn warning_marks(state: &mut editor::State) {
    model::add_child(state, nil);
    let row = state.sel;
    model::add_component(state, "body2d");
    state.lint.stale = true;
    lint::node_warnings(state);
    let id = model::node(state, row).stable_id();
    check(lint::warned(state, id).len() > 0, "a body nothing collides with marks its row ({lint::warned(state, id)})");
    model::add_component(state, "softbody2d");
    let before = util::obj(model::node(state, row).authored("softbody2d")).get("cells");
    model::set_component_prop(state, "softbody2d", "cells", [5000.0, 5000.0]);
    let after = util::obj(model::node(state, row).authored("softbody2d")).get("cells");
    check(after.equals(before), "a refused write leaves the document as it was ({after})");
    let named: [str] = [];
    for warning in scene::warnings(model::node(state, row)) {
        if warning.property.is_some() {
            named.push(warning.property.unwrap());
        }
    }
    check(util::contains(named, "cells"), "and the warning names the property ({named})");
    model::delete_selected(state);
    log::info("selftest warnings: done");
}

// The row the pool check builds its strip in, under the shell's root.
const POOL_HOST: str = "Editor";

const POOL_CHECK: str = "PoolCheck";

/// A pooled slot that turns from one kind of control into another holds the
/// old control's value for a pass, and that value is not the reader's edit.
///
/// A dropdown's slot spent a frame as a colour row's label, and coming back it
/// reported the label's `0.20 0.22 0.26 1.00` as a pick: a script by that name.
pub fn pool_kinds(state: &mut editor::State) {
    let root = scene::get_node(POOL_HOST);
    if !root.is_valid() {
        log::info("selftest pool: no shell in this run, skipped");
        return;
    }
    root.add_child(POOL_CHECK).set_component("widget", map().with("kind", ui::WIDGET_ROW));
    state.pool_check = PoolCheck { stage: 0, heard: [] };
    stepping(state, "pool_check");
}

// One strip a pass, as the inspector does: the host made above resolves by
// path from the next one.
pub fn pool_check_step(state: &mut editor::State) {
    if state.pool_check.is_none() {
        return;
    }
    let pool_check = state.pool_check.unwrap();
    let path = POOL_HOST + "/" + POOL_CHECK;
    let heard = pool_check.heard;
    let pick = pool::on(map().with("kind", "dropdown").with("text", "pick").with("options", ["a", "b"]), pool_heard, map());
    let stage = pool_check.stage;
    pool_check.stage = stage + 1;
    if stage == 0 || stage == 2 || stage == 4 {
        pool::strip(state, path, [pick]);
    } else if stage == 1 {
        pool::strip(state, path, [map().with("kind", "label").with("text", "0.20 0.22 0.26 1.00")]);
    } else if stage == 3 {
        check(heard.len() == 0, "a slot that changed kind reports nothing ({heard})");
        // The control: a pick on a slot that stayed a dropdown still reaches `on`.
        ui::edit(scene::get_node(path + "/C0"), "b");
    } else {
        state.pool_check = nil;
        check(heard.len() == 1 && heard[0] == "b", "and a pick on a dropdown is heard ({heard})");
        scene::get_node(path).queue_free();
        log::info("selftest pool: done");
    }
}

// A pick the pool check's dropdown reports.
fn pool_heard(state: &mut editor::State, data: any, value: any) {
    if state.pool_check.is_some() {
        state.pool_check.unwrap().heard.push(value.as_str());
    }
}

pub fn rows_step(state: &mut editor::State) {
    let tree = scene::get_node(TREE_NODE);
    if !tree.is_valid() {
        state.rows_demo = -1;
        log::info("selftest rowsdemo: no shell in this run, skipped");
        return;
    }
    let widget = util::obj(tree.get_component("widget"));
    let rows = util::vec(widget.get("options"));
    if rows.len() == 0 {
        state.rows_waited = state.rows_waited + 1;
        if state.rows_waited > 60 {
            state.rows_demo = -1;
            log::info("selftest rowsdemo: the outliner drew no rows this run, skipped");
        }
        return;
    }
    let stage = state.rows_demo;
    state.rows_demo = stage + 1;
    if stage == 0 {
        rows_drawn(state, widget, rows);
        rows_menu(widget);
        rows_picked(state, tree, rows);
    } else if stage == 1 {
        rows_answered(state, widget, rows);
        rows_search(state, name_at(state, state.rows_want));
    } else if stage == 2 {
        rows_narrowed(state, rows);
        rows_search(state, "zzqq-nothing-matches-this");
    } else if stage == 3 {
        check(widget.get("visible").as_bool() == false, "a query matching nothing hides the tree");
        rows_search(state, "");
    } else if stage == 4 {
        check(rows.len() == state.nodes.len(), "and clearing the query brings every row back");
        // A second node, to see the set drawn rather than the active node.
        if state.nodes.len() > 1 {
            selection::toggle(state, if state.sel == 0 { 1 } else { 0 });
        }
    } else {
        state.rows_demo = -1;
        let lit = util::vec(widget.get("selection"));
        // A project with one node has no second node to add to the set.
        let want = if state.nodes.len() > 1 { 2 } else { 1 };
        check(lit.len() == selection::count(state) && lit.len() == want, "every selected node lights a row ({lit.len()} lit, {want} wanted)");
        log::info("selftest rowsdemo: done");
    }
}

// The menu a right click on a row opens: a node beside the tree, every row of
// it naming a method the Editor's script declares. A typo in a scene is a row
// that does nothing, and nothing else says so.
fn rows_menu(widget: any) {
    let named = widget.get("context").as_str();
    check(named != "", "the outliner's tree names a context menu");
    let menu = scene::get_node(SCENE_PANEL + "/" + named);
    if !menu.is_valid() {
        check(false, "and the scene holds it ({named})");
        return;
    }
    let rows = menu.children();
    check(rows.len() > 0, "with rows on it ({rows.len()} of them)");
    let editor = scene::get_node("Editor");
    let missing = 0;
    for row in rows {
        let handler = util::obj(row.get_component("widget")).get("on_click").as_str();
        if handler == "" || !editor.has_method(handler) {
            missing += 1;
            log::warn("tree menu row {row.name()} calls nothing");
        }
    }
    check(missing == 0, "and every row calls a method the editor declares");
}

// One row a node, the active one named and every selected one lit.
fn rows_drawn(state: editor::State, widget: any, rows: any) {
    check(rows.len() == state.nodes.len(), "the outliner draws one row a node ({rows.len()} of {state.nodes.len()})");
    check(widget.get("multi_select").as_bool() == true, "its tree holds many rows at once");
    let lit = util::vec(widget.get("selection"));
    check(lit.len() == selection::count(state), "every selected node is lit ({lit.len()} of {selection::count(state)})");
    check(widget.get("text").as_str() == "", "and the pick channel is clear, so nothing here undoes a selection made elsewhere");
    // The node knows a row by its string: two alike light and pick as one.
    let seen = map();
    let alike = 0;
    for row in rows {
        if seen.has(row.as_str()) {
            alike += 1;
        }
        seen.set(row.as_str(), true);
    }
    check(alike == 0, "no two rows are the same string ({alike} repeat)");
}

// A pick as the pointer makes one: the tree announces it and the panel's
// script answers, with nothing reading the node back.
fn rows_picked(state: &mut editor::State, tree: Node, rows: any) {
    let want = if state.sel == 0 && state.nodes.len() > 1 { 1 } else { 0 };
    state.rows_want = want;
    ui::edit(tree, rows.at(want));
}

fn rows_answered(state: editor::State, widget: any, rows: any) {
    let want = state.rows_want;
    check(state.sel == want, "a picked row selects its node ({want} wanted, {state.sel} selected)");
    // Lit from the selection before the pick, the row went back to the old
    // node for a pass, and stayed there while nothing asked for another.
    let lit = util::vec(widget.get("selection"));
    check(lit.len() == 1 && lit.at(0).equals(rows.at(want)), "and the pass that answered it lights that row ({lit})");
    check(rows.len() == state.nodes.len(), "and the walk is the document's still");
}

// The search draws on the same node: fewer rows, every one of them a match.
fn rows_narrowed(state: editor::State, rows: any) {
    let query = state.rows_query;
    let want = 0;
    for node in state.nodes {
        if search::matches(query, "{node.name()} {model::node_type(node)}") {
            want += 1;
        }
    }
    // The query leaves fewer rows than the document has, unless it holds one.
    let narrowed = want < state.nodes.len() || state.nodes.len() == 1;
    check(rows.len() == want && narrowed, "a query narrows the same tree node ({rows.len()} of {state.nodes.len()})");
    let named = 0;
    for row in rows {
        if row.as_str().contains(query) {
            named += 1;
        }
    }
    check(named == rows.len(), "and every row it leaves is a match");
}

pub fn librarydemo(state: &mut editor::State) {
    let root = state.game_root + "/";
    let metal = map()
        .with("id", "pbr_metal")
        .with("kind", "material")
        .with("name", "Brushed metal")
        .with("file", "materials/metal.toml")
        .with("needs", ["shaders/pbr_surface.wesl"]);
    // A node with a 3D shape, so the material has somewhere to land.
    let target: int? = nil;
    for index in 0..state.nodes.len() {
        if model::node(state, index).has_component("shape3d") && target.is_none() {
            target = index;
        }
    }
    if target.is_none() {
        log::info("selftest librarydemo: no 3D node here, skipping");
        return;
    }
    let at = target.unwrap();
    // Which files the project already had, so the check below is that the
    // library added one rather than wrote over one.
    let before = named_under(state, "materials");
    selection::only(state, at);
    library::apply_material(state, metal);
    let after = named_under(state, "materials");
    check(after.len() == before.len() + 1, "placing a material adds a file");
    let placed = util::obj(model::node(state, at).authored("shape3d")).get("material").as_str();
    check(fs::exists(root + placed), "the node points at a file that is there");
    check(placed.starts_with("materials/"), "under materials/: " + placed);
    for rel in before {
        check(rel != placed, "and never over a file the project already had");
    }
    check(mirror_resolves(state), "the mirror still resolves");
    // A lighting setup is a scene, so placing one instances it.
    let scenes_before = named_under(state, "scenes");
    let was = state.nodes.len();
    library::place(state, map()
        .with("id", "studio_light")
        .with("kind", "scene")
        .with("name", "Studio lights")
        .with("file", "scenes/studio.toml"));
    check(named_under(state, "scenes").len() == scenes_before.len() + 1, "placing a setup adds a scene");
    // One row for the instance and one per node inside it: expanding a
    // prefab puts its own rows in the document too.
    check(state.nodes.len() > was + 1, "and instances it as a prefab");
    shell::undo(state);
    check(state.nodes.len() == was, "undo takes the instance back");
    // The material assignment goes too: leaving the node pointing at a file
    // this then removes is a shader the renderer relinks and cannot find.
    shell::undo(state);
    check(util::obj(model::node(state, at).authored("shape3d")).get("material").as_str() != placed, "undo takes the material off the node");
    // The manifest and the dock agree: every entry is of a kind that has a
    // chip, and names files that are there.
    let chips: [str] = [];
    for pair in library::kinds() {
        chips.push(pair[0]);
    }
    let unknown = 0;
    let absent = 0;
    let manifest = toml::parse(fs::read("library/catalog.toml").or(""));
    let listed = util::vec(util::obj(manifest).get("entries"));
    for entry in listed {
        let record = util::obj(entry);
        if !util::contains(chips, record.get("kind").as_str()) {
            unknown += 1;
        }
        for rel in util::vec(record.get("needs")) {
            if !fs::exists("library/" + rel.as_str()) {
                absent += 1;
            }
        }
        if !fs::exists("library/" + record.get("file").as_str()) {
            absent += 1;
        }
    }
    check(listed.len() > 0, "the manifest lists entries");
    check(unknown == 0, "every entry is of a kind the dock has a chip for");
    check(absent == 0, "and every file it names is in the library");
    // An addon lands whole at its own path, and placing it again changes
    // nothing: a game requires it by that path, so a numbered copy would
    // answer nobody.
    let addon: any = nil;
    for entry in listed {
        let record = util::obj(entry);
        if record.get("kind").as_str() == "addon" && addon.is_nil() {
            addon = record;
        }
    }
    if !addon.is_nil() {
        let record = addon;
        let dir = record.get("file").as_str();
        // Anything a previous run left, so this run measures its own copy.
        if fs::exists(root + dir) {
            fs::remove(root + dir);
        }
        let top = dir.split("/")[0];
        let had_top = fs::exists(root + top);
        library::place(state, record);
        let count = util::vec(fs::list(root + dir)).len();
        check(count > 0, "placing {record.get("name")} copies its files in");
        library::place(state, record);
        check(util::vec(fs::list(root + dir)).len() == count, "placing it again adds nothing");
        check(!fs::exists(root + dir + "_2"), "and numbers no copy");
        let gone = if had_top { dir } else { top };
        fs::remove(root + gone);
        check(!fs::exists(root + dir), "and the project is left as it was");
    }
    // A sky is copied under skies/ and then only named, since the drop that
    // would have copied it already happened.
    let skies_before = named_under(state, "skies");
    library::place(state, map()
        .with("id", "sky_dusk")
        .with("kind", "sky")
        .with("name", "Dusk")
        .with("file", "skies/dusk.png"));
    check(named_under(state, "skies").len() == skies_before.len() + 1, "placing a sky adds an image");
    let on_env = false;
    for node in state.nodes {
        if util::obj(node.authored("environment")).get("sky").as_str().starts_with("skies/") {
            on_env = true;
        }
    }
    check(on_env, "and names it on an environment");
    shell::undo(state);
    // A model is a prefab of primitives, so placing one instances it.
    let models_before = named_under(state, "models");
    let had = state.nodes.len();
    library::place(state, map()
        .with("id", "model_tree")
        .with("kind", "model")
        .with("name", "Tree")
        .with("file", "models/tree.toml"));
    check(named_under(state, "models").len() == models_before.len() + 1, "placing a model adds a scene file");
    check(state.nodes.len() > had + 1, "and instances it as a prefab");
    shell::undo(state);
    check(state.nodes.len() == had, "undo takes the model back");
    for dir in ["skies", "models"] {
        let keep = if dir == "skies" { skies_before } else { models_before };
        for rel in named_under(state, dir) {
            if !util::contains(keep, rel) {
                fs::remove(root + rel);
            }
        }
    }
    // Only what this run placed: `install` numbers a name it finds taken, so
    // nothing here can be a file the example owns.
    for rel in named_under(state, "materials") {
        if !util::contains(before, rel) {
            fs::remove(root + rel);
        }
    }
    for rel in named_under(state, "scenes") {
        if !util::contains(scenes_before, rel) {
            fs::remove(root + rel);
        }
    }
    fs::remove(root + "shaders/pbr_surface.wesl");
    log::info("selftest librarydemo: done");
}

/// The Pen over a `path2d`: anchors appended, a handle pulled, the loop
/// closed, an anchor removed, and every step written back to the asset.
pub fn pendemo(state: &mut editor::State) {
    let was = state.nodes.len();
    pen::new_path(state);
    check(state.nodes.len() == was + 1, "a new path adds one node");
    check(pen::editable(state), "and the Pen has something to edit");
    let rel = pen::reference(state);
    check(rel.ends_with(".toml"), "which is a path2d asset: " + rel);
    check(count(state) == 0, "a fresh path has no points");
    pen::add_anchor(state, 0.0, 0.0);
    pen::add_anchor(state, 1.0, 0.0);
    check(count(state) == 2, "two points on their own are a straight line");
    pen::add_anchor(state, 1.0, 1.0);
    // The pair is promoted to cubics and the segment appended: four control
    // points for the first curve, three more for the second.
    check(count(state) == 7, "a third anchor makes it cubic: " + "{count(state)}");
    let anchor = pen::current(state).unwrap().points[3];
    pen::move_point(state, 3, anchor[0] + 0.5, anchor[1], false);
    let moved = pen::current(state).unwrap().points[3];
    check(util::abs(moved[0] - (anchor[0] + 0.5)) < 1e-4, "an anchor moves where it is put");
    check(!pen::current(state).unwrap().closed, "a path starts open");
    pen::toggle_closed(state);
    check(pen::current(state).unwrap().closed, "and closes");
    check(count(state) == 9, "the closing segment brings two handles");
    pen::toggle_closed(state);
    check(!pen::current(state).unwrap().closed, "and opens again");
    let before = count(state);
    pen::remove_anchor(state, 3);
    check(count(state) < before, "removing an anchor takes its handles with it");
    check(mirror_resolves(state), "the mirror still resolves");
    // Read as a file rather than through `assets`, which here is this
    // module's own demo: the point is what landed on disk.
    let saved = util::obj(toml::parse(fs::read(state.game_root + "/" + rel).or("")));
    check(util::vec(saved.get("points")).len() == count(state), "and the asset on disk holds the same points");
    fs::remove(state.game_root + "/" + rel);
    log::info("selftest pendemo: done");
}

// How many points the path the Pen edits holds.
fn count(state: &mut editor::State) -> int {
    let path = pen::current(state);
    if path.is_none() { 0 } else { path.unwrap().points.len() }
}

// How many instances the selected multimesh holds on its live node.
fn instance_count(state: editor::State) -> int {
    let found = model::node(state, state.sel);
    if populate::component(model::selected_node(state)).is_none() || !found.is_valid() {
        return -1;
    }
    render::instance_count(found)
}

/// The outliner's eye and lock: a click on either acts on that row's node
/// alone and leaves the selection where it was.
pub fn tree_marks(state: &mut editor::State) {
    if state.nodes.len() < 2 {
        log::info("selftest marks: one node is too few to aim past the selection, skipped");
        return;
    }
    shell::choose(state, 0);
    let index = state.nodes.len() - 1;
    let node = model::node(state, index);
    let row = util::cells(["", node.name(), "", "", node.stable_id(), left::row_marks(state, index)]);
    let shown = !arrange::is_hidden(state, index);
    left::mark_clicked(state, row, "eye");
    check(arrange::is_hidden(state, index) == shown, "the eye hides {node.name()}");
    check(left::row_marks(state, index).contains(icons::ui("eye-closed")), "and its row shows the eye closed");
    check(state.sel == 0, "a mark picks nothing");
    shell::undo(state);
    check(arrange::is_hidden(state, index) != shown, "undo shows it again");
    selection::set_locked(state, index, true);
    check(left::row_marks(state, index).contains(icons::ui("lock")), "a locked row shows the lock");
    left::mark_clicked(state, row, "lock");
    check(!selection::is_locked(state, index), "the lock unlocks it");
    check(!left::row_marks(state, index).contains(icons::ui("lock")), "and the lock goes");
    log::info("selftest marks: done");
}

/// Populate: a grid, then a surface, written into the selected multimesh's
/// asset, each one undo step. A scene with no multimesh skips itself.
pub fn populate(state: &mut editor::State) {
    let at = -1;
    for index in 0..state.nodes.len() {
        let node = model::node(state, index);
        if at < 0 && populate::component(node).is_some() {
            at = index;
        }
    }
    if at < 0 {
        log::info("selftest populate: no multimesh in this scene, skipped");
        return;
    }
    shell::choose(state, at);
    let before = instance_count(state);
    check(before >= 0, "the multimesh resolves in the mirror ({before})");
    state.populate.kind = render::POPULATE_GRID;
    state.populate.columns = 3;
    state.populate.rows = 2;
    populate::apply(state);
    check(instance_count(state) == 6, "a 3 by 2 grid writes six instances ({instance_count(state)})");
    check(history::dirty(state), "populating marks the scene dirty");
    check(mirror_resolves(state), "populating resolves every node in the mirror");
    let surface = "";
    for node in state.nodes {
        if surface == "" && (node.has_component("shape3d") || node.has_component("mesh")) {
            surface = "/" + model::path_in_scene(state, node);
        }
    }
    if surface != "" {
        state.populate.kind = render::POPULATE_SURFACE;
        state.populate.surface = surface;
        state.populate.count = 20;
        populate::apply(state);
        check(instance_count(state) == 20, "twenty instances over {surface} ({instance_count(state)})");
        shell::undo(state);
        check(instance_count(state) == 6, "undo puts the grid back ({instance_count(state)})");
    }
    shell::undo(state);
    check(instance_count(state) == before, "undo puts the asset back ({instance_count(state)})");
    check(history::dirty(state) == false, "undo back to the load point is clean");
    log::info("selftest populate: done");
}

/// Step the self-test `name` each frame from now until its own state says it
/// finished: what takes frames to settle, the layout above all, is checked
/// on the frames after. Nothing steps while no test is under way.
pub fn stepping(state: &mut editor::State, name: str) {
    if !util::contains(state.stepping, name) {
        state.stepping.push(name);
    }
}

/// A step of every self-test under way; one that finished drops out. On the
/// start screen only its own test steps, and the rest wait for a project.
pub fn step_all(state: &mut editor::State, start_screen: bool) {
    let running = state.stepping;
    state.stepping = [];
    for name in running {
        let here = name == "start_check";
        if here != start_screen || step_one(state, name) {
            state.stepping.push(name);
        }
    }
}

// One self-test's step, by name, answering whether it is still under way.
fn step_one(state: &mut editor::State, name: str) -> bool {
    if !under_way(state, name) {
        return false;
    }
    if name == "camera_check" {
        camera_check_step(state);
    } else if name == "viewport_check" {
        viewport_click_step(state);
    } else if name == "reselect" {
        reselect_step(state);
    } else if name == "start_check" {
        start_screen_step(state);
    } else if name == "empty_note" {
        empty_note_step(state);
    } else if name == "pick_check" {
        pick_check_step(state);
    } else if name == "picture_check" {
        picture_check_step(state);
    } else if name == "gesture" {
        gesture_step(state);
    } else if name == "layout" {
        layout_step(state);
    } else if name == "session" {
        session_step(state);
    } else if name == "plugin" {
        plugin_step(state);
    } else if name == "profile" {
        profile_step(state);
    } else if name == "palette" {
        palette_step(state);
    } else if name == "settings" {
        settings_step(state);
    } else if name == "themewin" {
        theme_edit_step(state);
    } else if name == "window" {
        sheet_close_step(state);
    } else if name == "events" {
        events_step(state);
    } else if name == "rows" {
        rows_step(state);
    } else if name == "import" {
        import_step(state);
    } else if name == "pool_check" {
        pool_check_step(state);
    } else if name == "machine" {
        statemachine::demo_step(state);
    }
    under_way(state, name)
}

// Whether the self-test `name` has more to do.
fn under_way(state: editor::State, name: str) -> bool {
    if name == "camera_check" {
        state.camera_check.is_some()
    } else if name == "viewport_check" {
        state.viewport_check.is_some()
    } else if name == "reselect" {
        state.reselect.is_some()
    } else if name == "start_check" {
        state.start_check.is_some()
    } else if name == "empty_note" {
        state.empty_note.is_some()
    } else if name == "pick_check" {
        state.pick_check.is_some()
    } else if name == "picture_check" {
        state.picture_check.is_some()
    } else if name == "gesture" {
        state.gesture_demo >= 0
    } else if name == "layout" {
        state.layout_demo >= 0
    } else if name == "session" {
        state.session.demo.is_some()
    } else if name == "plugin" {
        state.plugin_demo >= 0
    } else if name == "profile" {
        state.profile_demo >= 0
    } else if name == "palette" {
        state.palette_demo >= 0
    } else if name == "settings" {
        state.settings.demo >= 0
    } else if name == "themewin" {
        state.themewin.demo >= 0
    } else if name == "window" {
        state.window.demo >= 0
    } else if name == "events" {
        state.events_demo >= 0
    } else if name == "rows" {
        state.rows_demo >= 0
    } else if name == "import" {
        state.import_demo >= 0
    } else if name == "pool_check" {
        state.pool_check.is_some()
    } else if name == "machine" {
        state.machine.demo >= 0
    } else {
        false
    }
}
