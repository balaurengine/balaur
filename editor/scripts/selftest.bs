// Start-up states that exercise the editor and assert the result. `log::error`
// is the failure channel: `scripts/e2e.sh` fails any run that logs one.

use editor;
use gizmo;
use history;
use model;
use sceneedit;
use shell;
use statemachine;
use tests::viewport_checks;
use tests::panel_checks;
use tests::shell_checks;
use tests::project_checks;
use util;

pub struct WritableFloat {
    internal component: str,
    internal property: str,
    internal spec: any,
}

pub class CameraCheck {
    internal waited: int,
    internal stage: int,
    internal was: float,
    internal drag: CameraDrag?,
}

pub class CameraDrag {
    internal from: [float],
    internal to: [float],
    internal tool: str,
    internal world: [float],
    internal at: gizmo::Project?,
}

pub class ViewportCheck {
    internal waited: int,
    internal stage: int,
}

pub class Reselect {
    internal waited: int,
    internal stage: int,
    internal row: int,
    internal had: int,
    internal drawn: int,
    internal workspace: str,
    internal tool: str,
}

pub class StartCheck {
    internal waited: int,
}

pub class EmptyNote {
    internal waited: int,
}

pub struct Tilemap {
    internal tileset: Tileset,
    internal cells: InlineCells,
    internal pixels_per_unit: float,
}

pub struct InlineCells {
    internal kind: str,
    internal rows: [[int]],
}

pub struct Tileset {
    internal texture: str,
    internal tile_size: float,
    internal columns: int,
}

/// The picture `test:picture` waits for, and how long it waits.
pub class PictureCheck {
    path: str,
    until: float,
}

pub class PickCheck {
    internal stage: int,
    internal sprite: ScaleASprite?,
    internal turned: TurnABox?,
    internal text: Node?,
}

pub struct ScaleASprite {
    internal index: int,
    internal at: [float],
    internal scale: [float],
}

pub struct TurnABox {
    internal index: int,
    internal held: [float],
    internal want: [float],
}

pub struct NumberExport {
    internal at: int,
    internal export: any,
}

pub struct WritableList {
    internal at: int,
    internal component: str,
    internal property: str,
    internal spec: any,
}

pub struct InstancedFloat {
    internal at: int,
    internal float: WritableFloat,
}

pub struct Script {
    internal name: str,
    internal sample: str,
}

pub class Demo {
    internal frames: int,
    internal file: str,
    internal was: int,
}

pub class PoolCheck {
    internal stage: int,
    internal heard: [str],
}

internal fn check(ok: bool, what: str) -> bool {
    if ok {
        log::info("selftest ok: {what}");
    } else {
        log::error("selftest FAILED: {what}");
    }
    ok
}

/// A warning the next call provokes on purpose. `scripts/e2e.sh` fails a run
/// on any warning but one named here first.
internal fn expect_warning(text: str) {
    log::info("selftest expects the warning: {text}");
}

// Every row must be a node still standing: what each mutation below leaves
// listed is the scene and nothing gone.
internal fn mirror_resolves(state: editor::State) -> bool {
    for found in state.nodes {
        if !found.is_valid() {
            return false;
        }
    }
    true
}

internal fn name_at(state: editor::State, index: int) -> str {
    if index >= 0 && index < state.nodes.len() {
        return model::node(state, index).name();
    }
    "<none>"
}

internal fn undo_all(state: &mut editor::State) {
    let guard = 0;
    while history::can_undo(state) && guard < 200 {
        shell::undo(state);
        guard += 1;
    }
}

// The first writable float on any component of the selection, so the test
// exercises `set_component_property` on whatever the scene actually has.
internal fn writable_float(state: &mut editor::State, found: Node) -> WritableFloat? {
    for component in found.component_names() {
        let schema = model::schema(state, component);
        for property in util::keys_sorted(schema) {
            let spec = schema[property];
            if spec["type"].as_str() == "float" && spec["readonly"].as_bool() != true {
                return WritableFloat { component: component, property: property, spec: spec };
            }
        }
    }
    nil
}

internal fn float_property(found: Node, component: str, property: str) -> float? {
    let value = util::map_or_empty(found.get_component(component))[property];
    if value != nil {
        value.as_float()
    } else {
        nil
    }
}

pub fn component_write(state: &mut editor::State) {
    let found = model::node(state, state.selected);
    if !found.is_valid() {
        return;
    }
    let writable = writable_float(state, found);
    if writable == nil {
        log::info("selftest: the selection has no writable float; skipped");
        return;
    }
    let component = writable.unwrap().component;
    let property = writable.unwrap().property;
    let spec = writable.unwrap().spec;
    let had = float_property(found, component, property);
    let was = if had != nil { had.unwrap() } else { spec["default"].as_float() };
    sceneedit::set_component_property(state, component, property, was + 3.0);
    let now = float_property(model::node(state, state.selected), component, property).or(-1.0);
    check(math::abs(now - (was + 3.0)) < 1e-6, "{component}.{property} took the write ({now})");
    shell::undo(state);
    let back = float_property(model::node(state, state.selected), component, property).or(-1.0);
    check(math::abs(back - was) < 1e-6, "undo restores {component}.{property} ({back} vs {was})");
}

// Renaming: the tree's context menu had no way to do it, and nothing else
// in the shell did either.
/// `--state test:picture`: the scene drawn by a second run lands as a PNG
/// where `picture.write` said it would, within a generous wait for a GPU.
pub fn picture(state: &mut editor::State) {
    let path = picture::write(state.game_root, state.scene_rel);
    if !check(path != nil, "a desktop can start the run that draws the picture") {
        return;
    }
    state.picture_check = PictureCheck { path: path.unwrap(), until: engine::unix_time() + 60.0 };
    stepping(state, "picture_check");
}

fn picture_check_step(state: &mut editor::State) {
    let waiting = state.picture_check.unwrap();
    if fs::exists(waiting.path) {
        check(true, "the picture is written ({util::last_segment(waiting.path)})");
        fs::remove(waiting.path);
        state.picture_check = nil;
    } else if engine::unix_time() > waiting.until {
        check(false, "the picture is written within a minute ({waiting.path})");
        state.picture_check = nil;
    }
}

/// Step the self-test `name` each frame from now until its own state says it
/// finished: what takes frames to settle, the layout above all, is checked
/// on the frames after. Nothing steps while no test is under way.
pub fn stepping(state: &mut editor::State, name: str) {
    if !util::contains(state.stepping, name) {
        state.stepping.push(name);
    }
}

/// A step of every self-test under way; one that finished drops out. On the
/// start screen only its own test steps, and the rest wait for a project.
pub fn step_all(state: &mut editor::State, start_screen: bool) {
    let running = state.stepping;
    state.stepping = [];
    for name in running {
        let here = name == "start_check";
        if here != start_screen || step_one(state, name) {
            state.stepping.push(name);
        }
    }
}

// One self-test's step, by name, answering whether it is still under way.
fn step_one(state: &mut editor::State, name: str) -> bool {
    if !under_way(state, name) {
        return false;
    }
    match name {
        "camera_check" => {
            viewport_checks::camera_check_step(state);
        }
        "viewport_check" => {
            viewport_checks::viewport_click_step(state);
        }
        "reselect" => {
            viewport_checks::reselect_step(state);
        }
        "start_check" => {
            viewport_checks::start_screen_step(state);
        }
        "empty_note" => {
            viewport_checks::empty_note_step(state);
        }
        "pick_check" => {
            viewport_checks::pick_check_step(state);
        }
        "picture_check" => {
            picture_check_step(state);
        }
        "gesture" => {
            viewport_checks::gesture_step(state);
        }
        "layout" => {
            shell_checks::layout_step(state);
        }
        "session" => {
            project_checks::session_step(state);
        }
        "plugin" => {
            project_checks::plugin_step(state);
        }
        "profile" => {
            project_checks::profile_step(state);
        }
        "palette" => {
            shell_checks::palette_step(state);
        }
        "settings" => {
            shell_checks::settings_step(state);
        }
        "themewin" => {
            shell_checks::theme_edit_step(state);
        }
        "window" => {
            shell_checks::sheet_close_step(state);
        }
        "events" => {
            project_checks::events_step(state);
        }
        "rows" => {
            panel_checks::rows_step(state);
        }
        "import" => {
            project_checks::import_step(state);
        }
        "pool_check" => {
            panel_checks::pool_check_step(state);
        }
        "form_check" => {
            panel_checks::form_check_step(state);
        }
        "machine" => {
            statemachine::demo_step(state);
        }
        _ => {}
    }
    under_way(state, name)
}

// Whether the self-test `name` has more to do.
fn under_way(state: editor::State, name: str) -> bool {
    match name {
        "camera_check" => state.camera_check != nil,
        "viewport_check" => state.viewport_check != nil,
        "reselect" => state.reselect != nil,
        "start_check" => state.start_check != nil,
        "empty_note" => state.empty_note != nil,
        "pick_check" => state.pick_check != nil,
        "picture_check" => state.picture_check != nil,
        "gesture" => state.gesture_demo >= 0,
        "layout" => state.layout_demo >= 0,
        "session" => state.session.demo != nil,
        "plugin" => state.plugin_demo >= 0,
        "profile" => state.profile_demo >= 0,
        "palette" => state.palette_demo >= 0,
        "settings" => state.settings.demo >= 0,
        "themewin" => state.themewin.demo >= 0,
        "window" => state.window.demo >= 0,
        "events" => state.events_demo >= 0,
        "rows" => state.rows_demo >= 0,
        "import" => state.import_demo >= 0,
        "pool_check" => state.pool_check != nil,
        "form_check" => state.form_check != nil,
        "machine" => state.machine.demo >= 0,
        _ => false,
    }
}
