// What every viewport tool needs and each one used to define for itself: the
// selection palette, the world-per-pixel scale, and the three questions a
// tool asks about the current drag.

use crate::history;
use crate::layout;
use crate::model;
use crate::shell;
use crate::util;

/// A rail tool's drag this frame: the pointer's travel in design px and the
/// selected node it moves, or `None` when the pointer stood still or a zoom
/// took the drag instead. Recording the history step is part of taking it.
pub fn rail_drag(S, dpi) {
    let (dx, dy) = input::mouse_delta();
    dx = dx / (dpi * S.ui_scale);
    dy = dy / (dpi * S.ui_scale);
    if dx == 0.0 && dy == 0.0 {
        return None;
    }
    let (_, found) = model::selected(S);
    if found.is_some() && (S.tool == "move" || S.tool == "rotate" || S.tool == "scale") {
        history::record(S, format!("{} node", S.tool), Some(format!("tool:{}:{}", S.tool, S.sel)));
    }
    match found {
        Some(found) => Some((dx, dy, found)),
        None => {
            if S.tool == "zoom" {
                shell::set_zoom(S, S.zoom - dy * 0.5);
            }
            None
        }
    }
}

/// Two fingers on the stage: pinch to dolly, drag to slide. Answered before
/// a tool sees the frame, and true while it holds the camera, so the gizmo
/// and the backend's own mouse orbit both stand off.
///
/// One finger is a mouse drag to everything below, which is the orbit a
/// cursor gets. Two is the gesture nothing else claims.
pub fn camera_gesture(S) {
    let pinch = input::pinch();
    let pan = input::pan();
    let spread = pinch.get("scale").unwrap_or(0.0);
    let dx = util::f(pan.get("x").unwrap_or(0.0));
    let dy = util::f(pan.get("y").unwrap_or(0.0));
    let scale = util::f(spread);
    let gesturing = scale > 0.0 || dx != 0.0 || dy != 0.0;
    if !gesturing {
        return false;
    }
    // Where the fingers are, not where a mouse is: a sheet under them owns
    // them, the way a pointer over a sheet is the sheet's.
    let at = if scale > 0.0 {
        (util::f(pinch.get("x").unwrap_or(0.0)), util::f(pinch.get("y").unwrap_or(0.0)))
    } else {
        input::mouse_position()
    };
    let (fx, fy) = at;
    if !owns_pointer(S, fx / S.ui_scale, fy / S.ui_scale) {
        return false;
    }
    if S.mode2d {
        pan_zoom_2d(S, scale, dx, dy);
    } else {
        orbit_3d(S, scale, dx, dy);
    }
    true
}

/// The mouse's own camera: middle-drag orbits, right-drag pans, the wheel
/// dollies. Answered before a tool sees the frame, and true while it holds
/// the camera.
///
/// The editor drives this itself rather than leaving it to the backend. The
/// shell is one window-filling widget area, so egui claims the pointer
/// everywhere in the editor and the backend's camera is never handed a mouse
/// event: its cursor memory goes stale (the next drag jumps) and the wheel
/// never reaches it at all.
pub fn mouse_camera(S) {
    let (mx, my) = input::mouse_position();
    if !owns_pointer(S, mx / S.ui_scale, my / S.ui_scale) {
        return false;
    }
    let (_, wheel) = input::scroll_delta();
    let orbiting = input::is_mouse_down(input::MOUSE_MIDDLE);
    let panning = input::is_mouse_down(input::MOUSE_RIGHT);
    if wheel == 0.0 && !orbiting && !panning {
        return false;
    }
    let (dx, dy) = input::mouse_delta();
    if S.mode2d {
        let (cx, cy, zoom) = render::camera_2d();
        let held = util::max(zoom, 0.01);
        let next = util::clamp(held * math::pow(dolly_step(), wheel), 0.02, 4000.0);
        if panning {
            render::set_camera_2d(cx - dx / held, cy + dy / held, next);
        } else {
            render::set_camera_2d(cx, cy, next);
        }
        return true;
    }
    mouse_camera_3d(S, wheel, orbiting, panning, dx, dy);
    true
}

// How far a pixel of drag turns the camera: the backend camera's own step, so
// a drag here moves the eye as far as one there.
const ORBIT_PER_PX = 0.005;

/// What one unit of wheel takes off the camera's distance. macOS reports
/// scroll by the pixel and everything else by the notch, so the per-unit step
/// differs by two orders of magnitude; these are the backend camera's own
/// numbers, so the editor dollies at the speed the engine does.
pub fn dolly_step() {
    if engine::platform().os == "macos" { 1.0001 } else { 1.01 }
}

fn mouse_camera_3d(S, wheel, orbiting, panning, dx, dy) {
    let (ex, ey, ez, tx, ty, tz, fov, _) = render::camera_pose();
    let (ax, ay, az) = (ex - tx, ey - ty, ez - tz);
    let dist = math::sqrt(ax * ax + ay * ay + az * az);
    if dist < 0.0001 {
        return;
    }
    let want = util::clamp(dist / math::pow(dolly_step(), wheel), 0.05, 10000.0);
    if orbiting {
        // The angles the backend's own camera keeps, so a drag here and a
        // drag there move the eye the same way.
        let yaw = math::atan2(az, ax) + dx * ORBIT_PER_PX;
        let pitch = util::clamp(math::acos(util::clamp(ay / dist, -1.0, 1.0)) + dy * ORBIT_PER_PX, 0.02, 3.12);
        render::set_camera(
            tx + want * math::cos(yaw) * math::sin(pitch),
            ty + want * math::cos(pitch),
            tz + want * math::sin(yaw) * math::sin(pitch),
            tx, ty, tz,
        );
        return;
    }
    let (ux, uy, uz) = (ax / dist, ay / dist, az / dist);
    let moved = if panning {
        let s = slide_axes(S, [ux, uy, uz], want, fov);
        [tx + s[0] * (0.0 - dx) + s[3] * dy,
         ty + s[1] * (0.0 - dx) + s[4] * dy,
         tz + s[2] * (0.0 - dx) + s[5] * dy]
    } else {
        [tx, ty, tz]
    };
    let (nx, ny, nz) = (moved[0], moved[1], moved[2]);
    render::set_camera(nx + ux * want, ny + uy * want, nz + uz * want, nx, ny, nz);
}

// Screen right and up in world units, scaled to the world a design pixel
// covers at the target's depth: six numbers, right then up.
fn slide_axes(S, u, dist, fov) {
    let (ux, uy, uz) = (u[0], u[1], u[2]);
    let right = [uz, 0.0, 0.0 - ux];
    let len = math::sqrt(right[0] * right[0] + right[2] * right[2]);
    let right = if len < 0.0001 { [1.0, 0.0, 0.0] } else { [right[0] / len, 0.0, right[2] / len] };
    let up = [
        uy * right[2] - uz * right[1],
        uz * right[0] - ux * right[2],
        ux * right[1] - uy * right[0],
    ];
    let tall = util::max(S.layout.stage.h, 1.0);
    let per_px = 2.0 * dist * math::tan(util::max(fov, 0.01) / 2.0) / tall;
    let step = per_px / util::max(S.ui_scale, 0.01);
    let out = [
        right[0] * step, right[1] * step, right[2] * step,
        up[0] * step, up[1] * step, up[2] * step,
    ];
    out
}

// The 2D camera is a centre and a zoom, so a pinch is the zoom and a drag is
// the centre, both in the world units the centre is kept in.
fn pan_zoom_2d(S, scale, dx, dy) {
    let (cx, cy, zoom) = render::camera_2d();
    let held = util::max(zoom, 0.01);
    let next = if scale > 0.0 { util::clamp(held * scale, 0.02, 4000.0) } else { held };
    render::set_camera_2d(cx - dx / next, cy + dy / next, next);
}

// The 3D camera is an eye and a target, so a pinch walks the eye along the
// line between them and a drag slides both across it.
fn orbit_3d(S, scale, dx, dy) {
    let (ex, ey, ez, tx, ty, tz, fov, _) = render::camera_pose();
    let (ax, ay, az) = (ex - tx, ey - ty, ez - tz);
    let dist = math::sqrt(ax * ax + ay * ay + az * az);
    if dist < 0.0001 {
        return;
    }
    // Apart is closer, the way a pinch out is on every phone.
    let want = if scale > 0.0 { util::clamp(dist / scale, 0.05, 10000.0) } else { dist };
    let (ux, uy, uz) = (ax / dist, ay / dist, az / dist);
    // Screen right and up in world units, from the view axis and world up.
    let right = [uz, 0.0, -ux];
    let len = math::sqrt(right[0] * right[0] + right[2] * right[2]);
    let right = if len < 0.0001 { [1.0, 0.0, 0.0] } else { [right[0] / len, 0.0, right[2] / len] };
    let up = [
        uy * right[2] - uz * right[1],
        uz * right[0] - ux * right[2],
        ux * right[1] - uy * right[0],
    ];
    // The world a design pixel covers at the target's depth: the same
    // distance under the finger as the ground it started on.
    let tall = util::max(S.layout.stage.h, 1.0);
    let per_px = 2.0 * want * math::tan(util::max(fov, 0.01) / 2.0) / tall;
    let step = per_px / util::max(S.ui_scale, 0.01);
    let slide = |i| (0.0 - dx) * right[i] * step + dy * up[i] * step;
    let (nx, ny, nz) = (tx + slide(0), ty + slide(1), tz + slide(2));
    render::set_camera(nx + ux * want, ny + uy * want, nz + uz * want, nx, ny, nz);
}

/// steadyum's selection orange.
pub fn orange() {
    [1.0, 0.647, 0.0]
}

/// The deep blue a hovered part tints to.
pub fn hover_color() {
    [0.118, 0.314, 0.784]
}

/// World units per design pixel (design px = logical px / ui scale).
pub fn world_per_px(S) {
    let (_, _, zoom) = render::camera_2d();
    S.ui_scale / util::max(zoom, 0.01)
}

/// Whether the Snap chip is on.
pub fn snapping(S) {
    match S.chip_state.get("scene") {
        Some(chips) => chips.get("snap").unwrap_or(false) == true,
        None => false,
    }
}

/// The gizmo part under the pointer: the dragged one wins over the hovered.
pub fn hot_part(S) {
    match S.gizmo.drag {
        Some(drag) => Some(drag.part),
        None => S.gizmo.hover,
    }
}

/// Tools that drive the gizmo rather than the camera. The 2D viewport adds
/// the two tools that exist only there.
pub fn manipulates(tool, mode2d) {
    let core = tool == "move" || tool == "rotate" || tool == "scale" || tool == "zoom";
    core || (mode2d && (tool == "bone" || tool == "polygon" || tool == "pen"))
}

/// Whether a click at this point is the viewport's to act on.
///
/// The dock rects, plus the overlays that cover the stage rather than sit
/// beside it. Not `ui::wants_pointer`: that answer is only available inside
/// the draw pass, and a tool reading it here would be reading the frame
/// before -- which swallows a press and re-anchors a drag mid-way.
pub fn owns_pointer(S, x, y) {
    if S.palette || S.newnode {
        return false;
    }
    !layout::over_sheet(S, x, y)
}
