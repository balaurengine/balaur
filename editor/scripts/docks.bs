// The shell's three docks — left, bottom, right — and the panels in them. A
// panel lives in exactly one dock; its tab menu moves it to another.

use center;
use defs;
use editor;
use icons;
use inspector;
use layout;
use left;
use lint;
use plugins;
use session;
use signals;
use util;
use words::dock_fields;
use words::fields;
use words::general;
use words::geometry_fields;
use words::inspector_fields;
use words::layout_fields;
use words::panel_keys;
use words::project_fields;
use words::roles;
use words::sides;
use words::tabs;
use words::theme_tokens;

const TREE: str = "tree";
const BOTTOM_WORD: str = "bottom";
const CARET_LEFT: str = "caret-left";
const CARET_RIGHT: str = "caret-right";
const LEFT: str = "left";
const RIGHT: str = "right";
const BONEMAP: str = "bonemap";
const COST: str = "cost";
const DEBUGGER: str = "debugger";
const DOCS: str = "docs";
const HIDE: str = "hide";
const OUTLINE: str = "outline";
const OUTPUT: str = "output";
const PROBLEMS: str = "problems";
const PROFILER: str = "profiler";
const RECORDINGS: str = "recordings";
const SIDE: str = "side";
const STATEMACHINE: str = "statemachine";
const TIMELINE: str = "timeline";

pub struct Table {
    name: str,
    icon: str,
    tall: bool,
}

pub struct Panels {
    at: int,
    workspace: str,
    table: any,
}

/// The active tab's box and the strip it scrolls in.
pub struct ActiveTabBox {
    internal tab: ui::Rect,
    internal strip: ui::Rect,
}

pub struct Handle {
    internal shown: bool,
    internal icon: str,
    internal tooltip: str,
}

pub struct Handles {
    internal left: Handle,
    internal right: Handle,
    internal bottom: Handle,
}

// The "+N" list that stands for the tabs a narrow dock has no room for.
const MORE_WIDTH: float = 48.0;

// What the fold and the head's padding leave the tabs of a dock's width.
const HEAD_END: float = 44.0;

/// A side dock's handle is the tool rail's tile: an icon button on a sheet,
/// with the rail's own inset, so the two sit in one column at one size.
fn tile(state: editor::State) -> float {
    let metrics = center::rail_metrics(state);
    metrics.diameter + 2.0 * metrics.padding
}

pub fn sides() -> [str] {
    [LEFT, BOTTOM_WORD, RIGHT]
}

pub fn state() -> any {
    defs::workspace_docks(tabs::SCENE)
}

/// Swap the open panels for the ones a workspace works with. What is open is
/// the workspace's; what may be opened is not, so a panel closed here comes
/// back from the logo menu without changing workspace.
pub fn apply_workspace(state: &mut editor::State, id: str) {
    let want = defs::workspace_docks(id);
    for side in sides() {
        // A dock the reader folded away stays folded: the workspace says which
        // panels, not whether the sheet is up.
        want[side][dock_fields::SHUT] = state.docks[side][dock_fields::SHUT];
    }
    state.docks = want;
    signals::docks(state);
    // A plugin's dock is in no workspace's set: it was adopted when the plugin
    // loaded, and a workspace must not unregister it.
    for entry in state.registry.panels {
        adopt(state, entry[fields::ID].as_str());
    }
}

/// Fold the docks away when the screen cannot hold them beside the stage, and
/// put them back when it can.
///
/// Both axes decide it. A phone on its side is 844 design pixels wide, which
/// is past the line a layout may spread out at, and 390 tall, which is less
/// than the bottom dock and a usable stage need between them.
///
/// Applied on the change, not every frame, so a reader who opens a dock on a
/// phone keeps it open until the screen itself changes.
pub fn follow_screen(state: &mut editor::State) {
    // A string: two words for two answers.
    let key = "{layout::three_fit(state)} {one_at_a_time(state)}";
    if state.screen_key == key {
        return;
    }
    state.screen_key = key;
    // Room, not a class word: a phone opens one sheet at a time, a tablet
    // folds the columns and keeps the bottom dock, a laptop keeps all three.
    let only_one = one_at_a_time(state);
    let tight = !layout::three_fit(state);
    for side in [LEFT, RIGHT, BOTTOM_WORD] {
        // Into a local first: a field assigned a branch of the loop's own
        // variables is the pitfall AGENTS.md names.
        let fold = if side == sides::BOTTOM { only_one } else { only_one || tight };
        state.docks[side][dock_fields::SHUT] = fold;
        signals::docks(state);
    }
}

/// Whether only one dock may be open at a time: a screen with less width
/// than two side docks and a stage at their floors, or less height than the
/// bar, a bottom dock and a stage at theirs, holds one sheet and the stage.
pub fn one_at_a_time(state: editor::State) -> bool {
    let floors = layout::floors(state);
    let width = floors.width;
    let height = floors.height;
    state.screen_width < width || state.screen_height < height
}

/// Open a side dock, folding the other where there is only room for one.
fn unfold(state: &mut editor::State, side: str) {
    state.docks[side][dock_fields::SHUT] = false;
    signals::docks(state);
    if !one_at_a_time(state) {
        return;
    }
    for other in sides() {
        if other != side {
            state.docks[other][dock_fields::SHUT] = true;
            signals::docks(state);
        }
    }
}

/// Every panel the menu can open, in the order it lists them.
pub fn known(state: &mut editor::State) -> [str] {
    util::keys_sorted(panels(state))
}

// Where a panel lands when it is opened from the menu rather than moved.
fn homes() -> any {
    { panel_keys::SCENE: sides::LEFT, OUTLINE: sides::LEFT, panel_keys::INSPECTOR: sides::RIGHT, panel_keys::IMPORT: sides::RIGHT }
}

pub fn home(id: str) -> str {
    let found = homes()[id];
    if found == nil { sides::BOTTOM } else { found.as_str() }
}

/// Name and icon per panel; `tall` asks the bottom dock for its taller size.
/// A plugin's dock joins the table so it moves like everything else.
///
/// Built once a frame: the tab row, the minimised rail and `bottom_tall` all
/// ask, and the outline's own name re-reads every script in the Script workspace.
pub fn panels(state: &mut editor::State) -> any {
    if state.panels != nil {
        let cache = state.panels.unwrap();
        if cache.at == state.frame && cache.workspace == state.workspace {
            return cache.table;
        }
    }
    let table: any = {
        panel_keys::SCENE: { fields::NAME: "Scene", fields::ICON: icons::panel(icons::SCENE), dock_fields::TALL: false },
        OUTLINE: { fields::NAME: left::outline_title(state), fields::ICON: icons::panel(icons::OUTLINE), dock_fields::TALL: false },
        panel_keys::INSPECTOR: { fields::NAME: "Inspector", fields::ICON: icons::panel(icons::INSPECTOR), dock_fields::TALL: false },
        panel_keys::IMPORT: { fields::NAME: "Import", fields::ICON: icons::panel(icons::IMPORT), dock_fields::TALL: false },
        OUTPUT: { fields::NAME: "Output", fields::ICON: icons::panel(icons::OUTPUT), dock_fields::TALL: false },
        PROBLEMS: { fields::NAME: "Problems", fields::ICON: icons::panel(icons::PROBLEMS), dock_fields::TALL: false },
        project_fields::ASSETS: { fields::NAME: "Assets", fields::ICON: icons::panel(icons::ASSETS), dock_fields::TALL: false },
        DOCS: { fields::NAME: "Docs", fields::ICON: icons::panel(icons::DOCS), dock_fields::TALL: true },
        TIMELINE: { fields::NAME: "Timeline", fields::ICON: icons::panel(icons::TIMELINE), dock_fields::TALL: true },
        DEBUGGER: { fields::NAME: "Debugger", fields::ICON: icons::panel(icons::DEBUGGER), dock_fields::TALL: true },
        RECORDINGS: { fields::NAME: "Recordings", fields::ICON: icons::panel(icons::RECORDINGS), dock_fields::TALL: true },
        PROFILER: { fields::NAME: "Profiler", fields::ICON: icons::panel(icons::PROFILER), dock_fields::TALL: true },
        COST: { fields::NAME: "Cost", fields::ICON: icons::panel(icons::COST), dock_fields::TALL: true },
        panel_keys::LIBRARY: { fields::NAME: "Library", fields::ICON: icons::panel(icons::LIBRARY), dock_fields::TALL: false },
        panel_keys::TILES: { fields::NAME: "Tiles", fields::ICON: icons::panel(icons::TILES), dock_fields::TALL: true },
        geometry_fields::WEIGHTS: { fields::NAME: "Weights", fields::ICON: icons::panel(icons::WEIGHTS), dock_fields::TALL: true },
        BONEMAP: { fields::NAME: "Bone map", fields::ICON: icons::panel(icons::BONEMAP), dock_fields::TALL: true },
        STATEMACHINE: { fields::NAME: "State machine", fields::ICON: icons::panel(icons::STATEMACHINE), dock_fields::TALL: true },
    };
    for entry in state.registry.panels {
        let icon = if entry[fields::ICON] == "" { icons::panel(entry[fields::ID].as_str()) } else { entry[fields::ICON].as_str() };
        table[entry[fields::ID].as_str()] = Table { name: entry[fields::TITLE].as_str(), icon: icon, tall: entry[dock_fields::TALL].as_bool() };
    }
    state.panels = Panels { at: state.frame, workspace: state.workspace, table: table };
    table
}

/// Give a panel a home. A plugin's dock joins the bottom one, which is where
/// EDITOR-SCREENS §5 promises one tab per registered plugin; its tab menu
/// moves it from there like any other.
pub fn adopt(state: &mut editor::State, id: str) {
    if side_of(state, id) != nil {
        return;
    }
    state.docks[home(id)][dock_fields::TABS].push(id);
    signals::docks(state);
}

/// Take a panel out of its dock. Nothing is destroyed: the logo menu lists
/// every panel whether it is open or not, and puts this one back.
pub fn close(state: &mut editor::State, id: str) {
    let holder = side_of(state, id);
    if holder == nil {
        return;
    }
    let side = holder.unwrap();
    let kept: [str] = [];
    for tab in state.docks[side][dock_fields::TABS] {
        if tab != id {
            kept.push(tab.as_str());
        }
    }
    state.docks[side][dock_fields::TABS] = kept;
    signals::docks(state);
    if state.docks[side][dock_fields::ACTIVE] == id {
        state.docks[side][dock_fields::ACTIVE] = if 0 >= 0 && 0 < kept.len() { kept[0] } else { nil }.or("");
        signals::docks(state);
    }
}

/// Open a closed panel, or close an open one: what the logo menu's rows do.
pub fn toggle(state: &mut editor::State, id: str) {
    if side_of(state, id) != nil {
        close(state, id);
    } else {
        show(state, id);
    }
}

fn panel(state: &mut editor::State, id: str) -> any {
    let found = panels(state)[id];
    if found == nil { { fields::NAME: id, fields::ICON: icons::panel(id), dock_fields::TALL: false } } else { found }
}

/// What a panel is called, for a menu row outside this module.
pub fn name(state: &mut editor::State, id: str) -> any {
    panel(state, id)[fields::NAME]
}

/// Which dock holds `id`, or `None` when a plugin has been unloaded.
pub fn side_of(state: editor::State, id: str) -> str? {
    // A plain loop: a closure a tab was most of what the tab rows cost.
    for side in sides() {
        for tab in state.docks[side][dock_fields::TABS] {
            if tab == id {
                return side;
            }
        }
    }
    nil
}

/// Whether `id` is the panel its dock is showing. Replaces the old
/// `state.dock == "..."`, which assumed everything lived at the bottom.
pub fn showing(state: editor::State, id: str) -> bool {
    let holder = side_of(state, id);
    if holder != nil {
        let side = holder.unwrap();
        state.docks[side][dock_fields::ACTIVE] == id && !state.docks[side][dock_fields::SHUT].as_bool()
    } else {
        false
    }
}

/// Bring `id` up wherever it lives, opening it and its dock.
///
/// A closed panel is opened first: a tool that cannot be used without its
/// dock says so, rather than leaving the tab to be hunted for.
pub fn show(state: &mut editor::State, id: str) {
    adopt(state, id);
    let found = side_of(state, id);
    if found != nil {
        let side = found.unwrap();
        state.docks[side][dock_fields::ACTIVE] = id;
        signals::docks(state);
        unfold(state, side);
    }
}

/// Move a panel to another dock, and leave its old dock showing something.
pub fn move_to(state: &mut editor::State, id: str, side: str) {
    let from = side_of(state, id);
    if from != nil {
        let old = from.unwrap();
        if old == side {
            return;
        }
        let kept: [str] = [];
        for tab in state.docks[old][dock_fields::TABS] {
            if tab != id {
                kept.push(tab.as_str());
            }
        }
        state.docks[old][dock_fields::TABS] = kept;
        signals::docks(state);
        if state.docks[old][dock_fields::ACTIVE] == id {
            state.docks[old][dock_fields::ACTIVE] = if 0 >= 0 && 0 < kept.len() { kept[0] } else { nil }.or("");
            signals::docks(state);
        }
    }
    state.docks[side][dock_fields::TABS].push(id);
    signals::docks(state);
    state.docks[side][dock_fields::ACTIVE] = id;
    signals::docks(state);
    unfold(state, side);
}

/// The taller bottom dock, asked before the layout is computed.
pub fn bottom_tall(state: &mut editor::State) -> any {
    let dock = state.docks[dock_fields::BOTTOM];
    if dock[dock_fields::SHUT].as_bool() || dock[dock_fields::ACTIVE] == "" {
        return false;
    }
    panel(state, dock[dock_fields::ACTIVE].as_str())[dock_fields::TALL]
}

fn body(state: editor::State, id: str) {
    if filled_by_itself(id) {
        // An open recording's lanes take the list's room.
        if id == tabs::RECORDINGS {
            let open = session::loaded(state);
            util::set_visible(BOTTOM + "Recordings", !open);
            util::set_visible(BOTTOM + "Lanes", open);
            return;
        }
        show_panel(own_node(id));
        return;
    }
    if id == tabs::SCENE {
        left::show_tree();
    } else if id == tabs::OUTLINE {
        left::show_outline();
    } else if id == tabs::INSPECTOR {
        inspector::show_panel(state);
    } else if id == tabs::IMPORT {
        util::set_visible("Editor/Shell/Body/Right/RightSheet/Import", true);
    } else {
        fill_plugin(state, id);
    }
}

/// Have a plugin fill its dock's subtree: the node the editor made for it,
/// not a `ui` handle, so a plugin fills its own subtree and cannot reach
/// past it. On a word its script heard, and when its dock shows it.
pub fn fill_plugin(state: editor::State, id: str) {
    if plugins::panel(state, id) == nil {
        return;
    }
    let holder = side_of(state, id);
    if holder == nil {
        return;
    }
    let side = holder.unwrap();
    let host = plugin_host(state, side, id);
    if host == "" {
        return;
    }
    plugins::draw_panel(state, id, host);
}

const BOTTOM: str = "Editor/Shell/Body/Centre/Bottom/";

// The bottom panels, each a scene of its own under the dock with its own
// script: shown and hidden here, filled by themselves. A panel's node by id.
fn own_nodes() -> any {
    { OUTPUT: "Output", PROBLEMS: "Problems", DOCS: "Docs", PROFILER: "Profiler", COST: "Cost", project_fields::ASSETS: "Assets", panel_keys::LIBRARY: "Library", panel_keys::TILES: "Tiles", STATEMACHINE: "StateMachine", RECORDINGS: "Recordings", DEBUGGER: "Debugger", TIMELINE: "Timeline", geometry_fields::WEIGHTS: "Weights", BONEMAP: "Bonemap" }
}

fn own_node(id: str) -> str {
    own_nodes()[id].as_str()
}

fn is_own_node(name: str) -> bool {
    let nodes = own_nodes();
    for id in nodes.keys() {
        let held = nodes[id];
        if held.as_str() == name {
            return true;
        }
    }
    false
}

// A panel that is a scene of its own, which `fill` shows and nothing draws.
fn filled_by_itself(id: str) -> bool {
    own_node(id) != ""
}

fn show_panel(name: str) {
    util::set_visible(BOTTOM + name, true);
}

/// Fill a panel's strip of chips at `path`: `rows` is a list of controls a
/// row, made into nodes by the pool.
pub fn toolbar(state: editor::State, path: str, rows: [[ui::Control]]) {
    let groups: [ui::Control] = [];
    for row in rows {
        groups.push(ui::Control { kind: ui::WIDGET_ROW, role: "toolbar_dock", gap: vec2(6, 6), align_items: ui::ALIGN_CENTER, controls: row });
    }
    ui::fill_strip(path, groups);
}

fn node_owners() -> any {
    {
        dock_fields::BOTTOM: [
            { HIDE: "Output", dock_fields::PANELS: [OUTPUT] },
            { HIDE: "Problems", dock_fields::PANELS: [PROBLEMS] },
            { HIDE: "Docs", dock_fields::PANELS: [DOCS] },
            { HIDE: "Profiler", dock_fields::PANELS: [PROFILER] },
            { HIDE: "Cost", dock_fields::PANELS: [COST] },
            { HIDE: "Assets", dock_fields::PANELS: [project_fields::ASSETS] },
            { HIDE: "Library", dock_fields::PANELS: [panel_keys::LIBRARY] },
            { HIDE: "Tiles", dock_fields::PANELS: [panel_keys::TILES] },
            { HIDE: "StateMachine", dock_fields::PANELS: [STATEMACHINE] },
            { HIDE: "Recordings", dock_fields::PANELS: [RECORDINGS] },
            { HIDE: "Lanes", dock_fields::PANELS: [RECORDINGS] },
            { HIDE: "Timeline", dock_fields::PANELS: [TIMELINE] },
            { HIDE: "Weights", dock_fields::PANELS: [geometry_fields::WEIGHTS] },
            { HIDE: "Bonemap", dock_fields::PANELS: [BONEMAP] },
            { HIDE: "Debugger", dock_fields::PANELS: [DEBUGGER] },
        ],
        dock_fields::LEFT: [
            { HIDE: TREE, dock_fields::PANELS: [panel_keys::SCENE] },
            { HIDE: tabs::OUTLINE, dock_fields::PANELS: [OUTLINE] },
        ],
        dock_fields::RIGHT: [
            { HIDE: tabs::INSPECTOR, dock_fields::PANELS: [panel_keys::INSPECTOR] },
            { HIDE: tabs::IMPORT, dock_fields::PANELS: [panel_keys::IMPORT] },
        ],
    }
}

fn hide_node(state: editor::State, which: str) {
    if is_own_node(which) || which == "Lanes" {
        util::hide(BOTTOM + which);
    } else if which == TREE {
        left::hide_tree(state);
    } else if which == tabs::OUTLINE {
        left::hide_outline();
    } else if which == tabs::IMPORT {
        util::hide("Editor/Shell/Body/Right/RightSheet/Import");
    } else if which == tabs::INSPECTOR {
        inspector::hide_panel();
    }
}

fn hide_unused(state: editor::State, side: str, dock: any) {
    hide_plugin_hosts(state, side, if dock[dock_fields::SHUT].as_bool() { "" } else { dock[dock_fields::ACTIVE].as_str() });
    for entry in node_owners()[side] {
        let wanted = false;
        for id in entry[dock_fields::PANELS] {
            if id.as_str() == dock[dock_fields::ACTIVE] {
                wanted = true;
            }
        }
        if dock[dock_fields::SHUT].as_bool() || !wanted {
            hide_node(state, entry[HIDE].as_str());
        }
    }
}

// A tab, which a small window gets a step less of: the row is chrome, and
// chrome is what a short window has least room for.
fn tab_height(state: editor::State) -> float {
    // A tab is a control a finger picks, so it takes the same height as the
    // rest of them where a finger is what reaches it.
    if state.touchscreen {
        33.0
    } else if state.compact {
        20.0
    } else {
        22.0
    }
}

/// Where a side keeps its plugin docks' own subtrees, which the scene states
/// so one made at run time sits where the side wants it rather than last.
fn plugins_of(side: str) -> str {
    if side == sides::BOTTOM {
        "Editor/Shell/Body/Centre/Bottom/BottomPlugins"
    } else if side == sides::LEFT {
        "Editor/Shell/Body/Left/LeftSheet/LeftPlugins"
    } else {
        "Editor/Shell/Body/Right/RightSheet/RightPlugins"
    }
}

// A plugin dock's own subtree: a head, a sidebar, a body and a foot. One per
// dock and side, so a dock moved between sides leaves nothing behind it.
fn host_fragment(name: str) -> str {
    let text = "[[nodes]]\nid = \"HOST\"\nname = \"HOST\"\nscript.source = \"scripts/panels/plugin.bs\"\n[nodes.widget]\nkind = \"column\"\nrole = \"plugin_host\"\ngrow = 1\n\n[[nodes]]\nid = \"HOST_head\"\nname = \"Head\"\nparent = \"HOST\"\n[nodes.widget]\nkind = \"flow\"\nrole = \"plugin_head\"\n[nodes.widget_layout]\nalign_items = \"center\"\n\n[[nodes]]\nid = \"HOST_split\"\nname = \"Split\"\nparent = \"HOST\"\n[nodes.widget]\nkind = \"row\"\nrole = \"plugin_split\"\ngrow = 1\n\n[[nodes]]\nid = \"HOST_side\"\nname = \"Side\"\nparent = \"HOST_split\"\nvisible = false\n[nodes.widget]\nkind = \"scroll\"\nwidth = 150\n[nodes.widget_scroll]\naxis = \"vertical\"\n\n[[nodes]]\nid = \"HOST_side_rows\"\nname = \"SideRows\"\nparent = \"HOST_side\"\n[nodes.widget]\nkind = \"column\"\nrole = \"plugin_side\"\ngrow = 1\n\n[[nodes]]\nid = \"HOST_body\"\nname = \"Body\"\nparent = \"HOST_split\"\n[nodes.widget]\nkind = \"scroll\"\ngrow = 1\n[nodes.widget_scroll]\naxis = \"vertical\"\n\n[[nodes]]\nid = \"HOST_rows\"\nname = \"Rows\"\nparent = \"HOST_body\"\n[nodes.widget]\nkind = \"column\"\nrole = \"plugin_rows\"\ngrow = 1\n\n[[nodes]]\nid = \"HOST_foot\"\nname = \"Foot\"\nparent = \"HOST\"\n[nodes.widget]\nkind = \"row\"\nrole = \"plugin_head\"\n[nodes.widget_layout]\nalign_items = \"center\"\n";
    text.replace("HOST", name)
}

fn host_name(id: str) -> str {
    "Plugin_" + id
}

/// The node a plugin dock fills, made the first time it is drawn on that side
/// and shown. Its `head`, `body` and `foot` are what the kit writes to.
pub fn plugin_host(state: editor::State, side: str, id: str) -> str {
    let parent = plugins_of(side);
    let path = parent + "/" + host_name(id);
    if util::is_nil(scene::get_node(path)) {
        let under = scene::get_node(parent);
        if util::is_nil(under) {
            return "";
        }
        scene::instantiate(host_fragment(host_name(id)), under);
    }
    util::set_visible(parent, true);
    util::set_visible(path, true);
    path
}

/// Hide every plugin dock's subtree but the one showing, on every side: a
/// node keeps drawing until it is told not to.
fn hide_plugin_hosts(state: editor::State, side: str, active: str) {
    let has_active = false;
    for entry in state.registry.panels {
        if entry[fields::ID] == active {
            has_active = true;
            continue;
        }
        util::hide(plugins_of(side) + "/" + host_name(entry[fields::ID].as_str()));
    }
    if !has_active {
        util::hide(plugins_of(side));
    }
}

fn head_stem(side: str) -> str {
    let sheet = if side == sides::BOTTOM {
        "Editor/Shell/Body/Centre/Bottom"
    } else if side == sides::LEFT {
        "Editor/Shell/Body/Left/LeftSheet"
    } else {
        "Editor/Shell/Body/Right/RightSheet"
    };
    let name = if side == sides::BOTTOM { "Bottom" } else if side == sides::LEFT { "Left" } else { "Right" };
    sheet + "/" + name + "Head/" + name
}

fn head_of(side: str) -> str {
    head_stem(side) + "Tabs/" + head_name(side) + "TabsRow"
}

fn head_name(side: str) -> str {
    if side == sides::BOTTOM { "Bottom" } else if side == sides::LEFT { "Left" } else { "Right" }
}

/// The fixed end of a dock's head: the panel's own tools and the fold. Outside
/// the tabs' scroll, so neither drags away with them.
fn tail_of(side: str) -> str {
    head_stem(side) + "Tail"
}

/// The active tab's box and the strip it scrolls in, or nil before the
/// row has drawn. A tab past the strip's end is a panel showing with no tab.
pub fn active_tab_box(state: &mut editor::State, side: str) -> ActiveTabBox? {
    let at = 0;
    let shown = shown_tabs(state, side);
    let active = state.docks[side][dock_fields::ACTIVE];
    for index in 0..shown.len() {
        if shown[index] == active {
            at = index;
        }
    }
    let tab = scene::get_node("{head_of(side)}/C{at}");
    let strip = scene::get_node(head_stem(side) + "Tabs");
    if !tab.is_valid() || !strip.is_valid() {
        return nil;
    }
    let tab_box = ui::widget_rect(tab);
    let strip_box = ui::widget_rect(strip);
    if tab_box == nil || strip_box == nil {
        return nil;
    }
    ActiveTabBox { tab: tab_box.unwrap(), strip: strip_box.unwrap() }
}

/// The box the panel's own tools were given, in design pixels, or nil
/// before the row has drawn. The self-test reads it: a hatch with no box is
/// a dock whose tools are there and invisible.
pub fn tools_box(side: str) -> ui::Rect? {
    let found = scene::get_node(tail_of(side) + "/C0");
    if !found.is_valid() {
        return nil;
    }
    ui::widget_rect(found)
}

fn tab_row(state: &mut editor::State, tokens: any, side: str, dock: any) {
    ui::fill_strip(head_of(side), tab_controls(state, tokens, side, dock));
    ui::fill_strip(tail_of(side), tail_controls(state, side));
}

/// The panel's own controls and the fold, in that order: where they have
/// always been, at the end of the head rather than the end of the tabs.
fn tail_controls(state: editor::State, side: str) -> [ui::Control] {
    let fold: ui::Control = ui::Control {
        kind: ui::WIDGET_BUTTON,
        height: tab_height(state),
        width: tab_height(state),
        padding: ui::all_sides(0),
        text: "",
        icon: icons::ui(shut_icon(side)),
        role: roles::ICON_ACTION,
        tooltip: "Minimize",
        on_click: "handle",
        data: { fields::FN: on_fold_pressed, SIDE: side },
    };
    // Every panel carries its own tools in its own scene.
    let controls = [fold];
    controls
}

fn on_fold_pressed(state: &mut editor::State, data: any, _value: any) {
    let side: str = data[SIDE].as_str();
    state.docks[side][dock_fields::SHUT] = true;
    signals::docks(state);
}

// One control a tab, the mark that closes it, and the fold at the end. The
// panel's own tools are the hatch beside this strip.
fn tab_controls(state: &mut editor::State, tokens: any, side: str, dock: any) -> [ui::Control] {
    let height = tab_height(state);
    let out: [ui::Control] = [];
    let shown: [any] = shown_tabs(state, side);
    for id in shown {
        let held = id;
        let info = panel(state, held.as_str());
        let active = dock[dock_fields::ACTIVE] == held;
        let label = tab_label(state, held.as_str());
        // One tile: the row carries the fill and the corners, and the two
        // halves inside it paint nothing, so the pair reads as one control.
        let inner: [ui::Control] = [];
        inner.push(ui::Control {
            kind: ui::WIDGET_BUTTON,
            height: height,
            text: label,
            padding: ui::sides(6, -1, 6, -1),
            corner_radius: 4,
            fill: general::NONE,
            role: "tab",
            checked: active,
            on_click: "handle",
            data: { fields::FN: on_tab_picked, SIDE: side, inspector_fields::HELD: held },
        });
        // Its own role, so the half of the tile under the pointer is the half
        // that lights up: a mark that looked the same either way was aimed at
        // and missed, and the click landed on the name beside it.
        inner.push(ui::Control {
            kind: ui::WIDGET_BUTTON,
            height: height,
            width: 22,
            text: "",
            corner_radius: 4,
            role: "icon_action_tab",
            icon: icons::ui(icons::CLOSE),
            tooltip: "Close {info["name"]}",
            on_click: "handle",
            data: { fields::FN: on_tab_close_pressed, inspector_fields::HELD: held },
        });
        inner.push(ui::Control { kind: ui::WIDGET_ROW, width: 3 });
        out.push(ui::Control {
            height: height,
            corner_radius: 4,
            controls: inner,
            align_items: ui::ALIGN_CENTER,
            fill: if active { theme_tokens::PRIMARY_BG } else { general::NONE },
        });
    }
    let hidden: [str] = [];
    for id in dock[dock_fields::TABS] {
        if !has(shown, id.as_str()) {
            hidden.push(panel(state, id.as_str())[fields::NAME].as_str());
        }
    }
    if hidden.len() > 0 {
        out.push(ui::Control {
            kind: ui::WIDGET_DROPDOWN,
            role: roles::CHOICE,
            height: height,
            width: MORE_WIDTH,
            text: "+{hidden.len()}",
            options: hidden,
            tooltip: "More tabs",
            on_change: "handle",
            data: { fields::FN: on_more_tab_picked, SIDE: side },
        });
    }
    out
}

fn on_tab_picked(state: &mut editor::State, data: any, _value: any) {
    let side: str = data[SIDE].as_str();
    let held: str = data[inspector_fields::HELD].as_str();
    state.docks[side][dock_fields::ACTIVE] = held;
    signals::docks(state);
}

fn on_tab_close_pressed(state: &mut editor::State, data: any, _value: any) {
    let held: str = data[inspector_fields::HELD].as_str();
    close(state, held);
}

fn on_more_tab_picked(state: &mut editor::State, data: any, picked: any) {
    let side: str = data[SIDE].as_str();
    show_named(state, side, picked);
}

/// The tabs a dock's row has room for, the active one always among them: the
/// leading run that fits, slid along until it reaches the active tab.
pub fn shown_tabs(state: &mut editor::State, side: str) -> [any] {
    let dock = state.docks[side];
    let room = state.layout[side][layout_fields::WIDTH].as_float() - HEAD_END;
    if tabs_width(state, side) <= room {
        return dock[dock_fields::TABS];
    }
    // The list's box and the gap before it.
    let room = room - MORE_WIDTH - 4.0;
    let widths: [float] = [];
    let end = 0;
    let used = 0.0;
    let fits = true;
    for index in 0..dock[dock_fields::TABS].len() {
        let id = dock[dock_fields::TABS][index];
        let width = tab_width(state, id.as_str());
        widths.push(width);
        used += width;
        if used <= room && fits {
            end = index;
        } else {
            fits = false;
        }
        if id == dock[dock_fields::ACTIVE] && index > end {
            end = index;
        }
    }
    let start = end;
    let used = widths[end];
    while start > 0 && used + widths[start - 1] <= room {
        start -= 1;
        used += widths[start];
    }
    let out: [any] = [];
    for index in start..end + 1 {
        out.push(dock[dock_fields::TABS][index]);
    }
    out
}

fn has(list: [any], id: str) -> bool {
    for item in list {
        if item == id {
            return true;
        }
    }
    false
}

// A pick from the "+N" list, which lists names: the panel it names comes forward.
fn show_named(state: &mut editor::State, side: str, name: any) {
    for id in state.docks[side][dock_fields::TABS] {
        if panel(state, id.as_str())[fields::NAME] == name {
            state.docks[side][dock_fields::ACTIVE] = id;
            signals::docks(state);
        }
    }
}

// What a tab reads: its name, and the count Problems carries.
fn tab_label(state: &mut editor::State, id: str) -> any {
    let label = panel(state, id)[fields::NAME];
    if id == tabs::PROBLEMS {
        let counts = lint::counts(state);
        let errors = counts.errors;
        let warnings = counts.warnings;
        if (errors + warnings) > 0 {
            label = label.as_str() + " {errors + warnings}";
        }
    }
    label
}

/// Stop drawing a dock's tab strip, for a dock that is folded or empty.
fn hide_tabs(state: &mut editor::State, side: str) {
    util::hide(head_of(side));
}

// How wide the tab row's own tiles are, from the names: a flat width per tab
// ran the hint over the row as soon as `Bone map` joined.
fn tabs_width(state: &mut editor::State, side: str) -> float {
    let total = 0.0;
    for tab in state.docks[side][dock_fields::TABS] {
        total += tab_width(state, tab.as_str());
    }
    total
}

fn tab_width(state: &mut editor::State, id: str) -> float {
    // 11 px, semibold: under 6 px a character, plus the pill's padding, the
    // close mark and the gap to the next one, measured at 52 px.
    52.0 + 6.0 * tab_label(state, id).len() as float
}

// The caret on a dock's minimise button points at the edge it folds to, and
// the one on its handle points back the way it opens.
fn shut_icon(side: str) -> str {
    if side == sides::LEFT {
        CARET_LEFT
    } else if side == sides::RIGHT {
        CARET_RIGHT
    } else {
        "caret-down"
    }
}

fn open_icon(side: str) -> str {
    if side == sides::LEFT {
        CARET_RIGHT
    } else if side == sides::RIGHT {
        CARET_LEFT
    } else {
        "caret-up"
    }
}

/// Whether a dock is down to its rail: folded away, or emptied of every tab.
/// An emptied dock is not a blank sheet — it gives its width back.
pub fn folded(state: editor::State, side: str) -> bool {
    let dock = state.docks[side];
    dock[dock_fields::SHUT].as_bool() || dock[dock_fields::TABS].len() == 0
}

/// Whether every dock is down to its rail, which is the layout focus leaves.
pub fn all_folded(state: editor::State) -> bool {
    for side in sides() {
        if !folded(state, side) {
            return false;
        }
    }
    true
}

/// A dock's tab row, which of its panels shows, and the side panels' own
/// showing: what its script asks for on `docks_changed`, rather than every pass.
pub fn fill(state: &mut editor::State, side: str) -> str {
    let tokens = state.theme;
    let dock = state.docks[side];
    hide_unused(state, side, dock);
    if dock[dock_fields::TABS].len() == 0 || dock[dock_fields::SHUT].as_bool() {
        hide_tabs(state, side);
        return "";
    }
    tab_row(state, tokens, side, dock);
    body(state, dock[dock_fields::ACTIVE].as_str());
    shown_panel(state, side, dock)
}

/// The node of the panel `fill` just showed, which the dock then tells to
/// fill itself: told after the showing, it never reads itself as hidden.
fn shown_panel(state: editor::State, side: str, dock: any) -> str {
    if side == sides::RIGHT && dock[dock_fields::ACTIVE] == tabs::IMPORT {
        return "Import";
    }
    if side != sides::BOTTOM || !filled_by_itself(dock[dock_fields::ACTIVE].as_str()) {
        return "";
    }
    if dock[dock_fields::ACTIVE] == tabs::RECORDINGS && session::loaded(state) {
        return "Lanes";
    }
    own_node(dock[dock_fields::ACTIVE].as_str())
}

/// Whether a side dock is open: the one sheet that takes the whole body where
/// there is room for one, which the bottom dock never does.
pub fn side_open(state: editor::State) -> bool {
    !folded(state, sides::LEFT) || !folded(state, sides::RIGHT)
}

/// Whether a side dock is folded with something to go back to.
fn has_handle(state: editor::State, side: str) -> bool {
    folded(state, side) && state.docks[side][dock_fields::TABS].len() > 0
}

/// The room the left dock's handle takes above the tool rail, which is where
/// it goes when there is a rail to sit over.
pub fn rail_top_height(state: editor::State) -> float {
    if state.rail_visible && has_handle(state, sides::LEFT) {
        return tile(state) + 6.0;
    }
    0.0
}

/// The room that handle takes at the head of the top strip instead, for a
/// centre with no rail to put it over.
pub fn fold_inset(state: editor::State) -> float {
    if !state.rail_visible && has_handle(state, sides::LEFT) {
        return tile(state) + 6.0;
    }
    0.0
}

/// The handles a folded dock leaves behind, at the edge it folded towards:
/// the left one above the tools or at the stage's corner, the right one
/// opposite it, the bottom one beside the zoom reading. A folded dock gives
/// its space back, so this is the way back to it. A side sheet that is the
/// whole screen offers one way out, its own fold: a handle to a second sheet
/// would open it over the first.
pub fn handles(state: editor::State) -> Handles {
    let hidden = state.chrome_off || (one_at_a_time(state) && side_open(state));
    Handles { left: handle(state, hidden, sides::LEFT), right: handle(state, hidden, sides::RIGHT), bottom: handle(state, hidden, sides::BOTTOM) }
}

fn handle(state: editor::State, hidden: bool, side: str) -> Handle {
    let info = panel(state, state.docks[side][dock_fields::ACTIVE].as_str());
    Handle {
        shown: !hidden && has_handle(state, side),
        icon: icons::ui(open_icon(side)),
        tooltip: "Open the {info["name"].as_str().to_lower()}",
    }
}

/// Open a folded dock from its handle.
pub fn open_from_handle(state: &mut editor::State, side: str) {
    if side == "bottom" {
        state.docks[dock_fields::BOTTOM][dock_fields::SHUT] = false;
        signals::docks(state);
        return;
    }
    unfold(state, side);
}
