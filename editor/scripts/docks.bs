// The shell's three docks — left, bottom, right — and the panels in them. A
// panel lives in exactly one dock; its tab menu moves it to another.

use center;
use defs;
use editor;
use icons;
use inspector;
use layout;
use left;
use lint;
use plugins;
use pool;
use session;
use signals;
use util;

pub struct Table {
    name: str,
    icon: str,
    tall: bool,
}

pub struct Panels {
    at: int,
    workspace: str,
    table: any,
}

/// The active tab's box and the strip it scrolls in.
pub struct ActiveTabBox {
    tab: ui::Rect,
    strip: ui::Rect,
}

pub struct Inner2 {
    kind: str,
    width: int,
}

pub struct Out16 {
    height: float,
    corner_radius: int,
    controls: [any],
    align_items: str,
    fill: str,
}

pub struct Handle {
    shown: bool,
    icon: str,
    tooltip: str,
}

pub struct Handles {
    left: Handle,
    right: Handle,
    bottom: Handle,
}

// The "+N" list that stands for the tabs a narrow dock has no room for.
const MORE_W: float = 48.0;

// What the fold and the head's padding leave the tabs of a dock's width.
const HEAD_END: float = 44.0;

/// A side dock's handle is the tool rail's tile: an icon button on a sheet,
/// with the rail's own inset, so the two sit in one column at one size.
fn tile(S: editor::State) -> float {
    let m = center::rail_metrics(S);
    m.d + 2.0 * m.pad
}

pub fn sides() -> [str] {
    ["left", "bottom", "right"]
}

pub fn state() -> any {
    defs::workspace_docks("scene")
}

/// Swap the open panels for the ones a workspace works with. What is open is
/// the workspace's; what may be opened is not, so a panel closed here comes
/// back from the logo menu without changing workspace.
pub fn apply_workspace(S: &mut editor::State, id: str) {
    let want = defs::workspace_docks(id);
    for side in sides() {
        // A dock the reader folded away stays folded: the workspace says which
        // panels, not whether the sheet is up.
        want.get(side).set("shut", S.docks.get(side).shut);
    }
    S.docks = want;
    signals::docks(S);
    // A plugin's dock is in no workspace's set: it was adopted when the plugin
    // loaded, and a workspace must not unregister it.
    for entry in S.registry.panels {
        adopt(S, entry.id);
    }
}

/// Fold the docks away when the screen cannot hold them beside the stage, and
/// put them back when it can.
///
/// Both axes decide it. A phone on its side is 844 design pixels wide, which
/// is past the line a layout may spread out at, and 390 tall, which is less
/// than the bottom dock and a usable stage need between them.
///
/// Applied on the change, not every frame, so a reader who opens a dock on a
/// phone keeps it open until the screen itself changes.
pub fn follow_screen(S: &mut editor::State) {
    // A string, since Rune compares no tuples: two words for two answers.
    let key = "{layout::three_fit(S)} {one_at_a_time(S)}";
    if S.screen_key == key {
        return;
    }
    S.screen_key = key;
    // Room, not a class word: a phone opens one sheet at a time, a tablet
    // folds the columns and keeps the bottom dock, a laptop keeps all three.
    let only_one = one_at_a_time(S);
    let tight = !layout::three_fit(S);
    for side in ["left", "right", "bottom"] {
        // Into a local first: a field assigned a branch of the loop's own
        // variables is the pitfall AGENTS.md names.
        let fold = if side == "bottom" { only_one } else { only_one || tight };
        S.docks.get(side).shut = fold;
        signals::docks(S);
    }
}

/// Whether only one dock may be open at a time: a screen with less width
/// than two side docks and a stage at their floors, or less height than the
/// bar, a bottom dock and a stage at theirs, holds one sheet and the stage.
pub fn one_at_a_time(S: editor::State) -> bool {
    let w_h_1 = layout::floors(S);
    let w = w_h_1._0;
    let h = w_h_1._1;
    S.screen_w < w.as_float() || S.screen_h < h.as_float()
}

/// Open a side dock, folding the other where there is only room for one.
fn unfold(S: &mut editor::State, side: str) {
    S.docks.get(side).shut = false;
    signals::docks(S);
    if !one_at_a_time(S) {
        return;
    }
    for other in sides() {
        if other != side {
            S.docks.get(other).shut = true;
            signals::docks(S);
        }
    }
}

/// Every panel the menu can open, in the order it lists them.
pub fn known(S: &mut editor::State) -> [str] {
    util::keys_sorted(panels(S))
}

// Where a panel lands when it is opened from the menu rather than moved.
fn homes() -> any {
    map().with("scene", "left").with("outline", "left").with("inspector", "right").with("import", "right")
}

pub fn home(id: str) -> str {
    let got1 = homes().get(id);
    if got1.is_nil() { "bottom" } else { got1.as_str() }
}

/// Name and icon per panel; `tall` asks the bottom dock for its taller size.
/// A plugin's dock joins the table so it moves like everything else.
///
/// Built once a frame: the tab row, the minimised rail and `bottom_tall` all
/// ask, and the outline's own name re-reads every script in the Script workspace.
pub fn panels(S: &mut editor::State) -> any {
    if S.panels.is_some() {
        let cache = S.panels.unwrap();
        if cache.at == S.frame && cache.workspace == S.workspace {
            return cache.table;
        }
    }
    let table = map()
        .with("scene", map().with("name", "Scene").with("icon", icons::panel("scene")).with("tall", false))
        .with("outline", map().with("name", left::outline_title(S)).with("icon", icons::panel("outline")).with("tall", false))
        .with("inspector", map().with("name", "Inspector").with("icon", icons::panel("inspector")).with("tall", false))
        .with("import", map().with("name", "Import").with("icon", icons::panel("import")).with("tall", false))
        .with("output", map().with("name", "Output").with("icon", icons::panel("output")).with("tall", false))
        .with("problems", map().with("name", "Problems").with("icon", icons::panel("problems")).with("tall", false))
        .with("assets", map().with("name", "Assets").with("icon", icons::panel("assets")).with("tall", false))
        .with("docs", map().with("name", "Docs").with("icon", icons::panel("docs")).with("tall", true))
        .with("timeline", map().with("name", "Timeline").with("icon", icons::panel("timeline")).with("tall", true))
        .with("debugger", map().with("name", "Debugger").with("icon", icons::panel("debugger")).with("tall", true))
        .with("recordings", map().with("name", "Recordings").with("icon", icons::panel("recordings")).with("tall", true))
        .with("profiler", map().with("name", "Profiler").with("icon", icons::panel("profiler")).with("tall", true))
        .with("cost", map().with("name", "Cost").with("icon", icons::panel("cost")).with("tall", true))
        .with("library", map().with("name", "Library").with("icon", icons::panel("library")).with("tall", false))
        .with("tiles", map().with("name", "Tiles").with("icon", icons::panel("tiles")).with("tall", true))
        .with("weights", map().with("name", "Weights").with("icon", icons::panel("weights")).with("tall", true))
        .with("bonemap", map().with("name", "Bone map").with("icon", icons::panel("bonemap")).with("tall", true))
        .with("statemachine", map().with("name", "State machine").with("icon", icons::panel("statemachine")).with("tall", true));
    for entry in S.registry.panels {
        let icon = if entry.icon == "" { icons::panel(entry.id) } else { entry.icon };
        table.set(entry.id, Table { name: entry.title, icon: icon, tall: entry.tall });
    }
    S.panels = Panels { at: S.frame, workspace: S.workspace, table: table };
    table
}

/// Give a panel a home. A plugin's dock joins the bottom one, which is where
/// EDITOR-SCREENS §5 promises one tab per registered plugin; its tab menu
/// moves it from there like any other.
pub fn adopt(S: &mut editor::State, id: str) {
    if side_of(S, id).is_some() {
        return;
    }
    S.docks.get(home(id)).tabs.push(id);
    signals::docks(S);
}

/// Take a panel out of its dock. Nothing is destroyed: the logo menu lists
/// every panel whether it is open or not, and puts this one back.
pub fn close(S: &mut editor::State, id: str) {
    let side_or = side_of(S, id);
    if side_or.is_none() {
        return;
    }
    let side = side_or.unwrap();
    let kept: [str] = [];
    for t in S.docks.get(side).tabs {
        if t != id {
            kept.push(t);
        }
    }
    S.docks.get(side).tabs = kept;
    signals::docks(S);
    if S.docks.get(side).active == id {
        S.docks.get(side).active = if 0 >= 0 && 0 < kept.len() { kept[0] } else { nil }.unwrap_or("");
        signals::docks(S);
    }
}

/// Open a closed panel, or close an open one: what the logo menu's rows do.
pub fn toggle(S: &mut editor::State, id: str) {
    if side_of(S, id).is_some() {
        close(S, id);
    } else {
        show(S, id);
    }
}

fn panel(S: &mut editor::State, id: str) -> any {
    let got1 = panels(S).get(id);
    if got1.is_nil() { map().with("name", id).with("icon", icons::panel(id)).with("tall", false) } else { got1 }
}

/// What a panel is called, for a menu row outside this module.
pub fn name(S: &mut editor::State, id: str) -> any {
    panel(S, id).get("name")
}

/// Which dock holds `id`, or `None` when a plugin has been unloaded.
pub fn side_of(S: editor::State, id: str) -> str? {
    // A plain loop: a closure a tab was most of what the tab rows cost.
    for side in sides() {
        for tab in S.docks.get(side).tabs {
            if tab == id {
                return side;
            }
        }
    }
    nil
}

/// Whether `id` is the panel its dock is showing. Replaces the old
/// `S.dock == "..."`, which assumed everything lived at the bottom.
pub fn showing(S: editor::State, id: str) -> bool {
    let matched1 = side_of(S, id);
    if matched1.is_some() {
        let side = matched1.unwrap();
        S.docks.get(side).active == id && !S.docks.get(side).shut
    } else {
        false
    }
}

/// Bring `id` up wherever it lives, opening it and its dock.
///
/// A closed panel is opened first: a tool that cannot be used without its
/// dock says so, rather than leaving the tab to be hunted for.
pub fn show(S: &mut editor::State, id: str) {
    adopt(S, id);
    let found = side_of(S, id);
    if found.is_some() {
        let side = found.unwrap();
        S.docks.get(side).active = id;
        signals::docks(S);
        unfold(S, side);
    }
}

/// Move a panel to another dock, and leave its old dock showing something.
pub fn move_to(S: &mut editor::State, id: str, side: str) {
    let from = side_of(S, id);
    if from.is_some() {
        let old = from.unwrap();
        if old == side {
            return;
        }
        let kept: [str] = [];
        for t in S.docks.get(old).tabs {
            if t != id {
                kept.push(t);
            }
        }
        S.docks.get(old).tabs = kept;
        signals::docks(S);
        if S.docks.get(old).active == id {
            S.docks.get(old).active = if 0 >= 0 && 0 < kept.len() { kept[0] } else { nil }.unwrap_or("");
            signals::docks(S);
        }
    }
    S.docks.get(side).tabs.push(id);
    signals::docks(S);
    S.docks.get(side).active = id;
    signals::docks(S);
    unfold(S, side);
}

/// The taller bottom dock, asked before the layout is computed.
pub fn bottom_tall(S: &mut editor::State) -> any {
    let d = S.docks.bottom;
    if d.shut || d.active == "" {
        return false;
    }
    panel(S, d.active).get("tall")
}

fn body(S: editor::State, id: str) {
    if filled_by_itself(id) {
        // An open recording's lanes take the list's room.
        if id == "recordings" {
            let open = session::loaded(S);
            util::fill(BOTTOM + "Recordings", map().with("visible", !open));
            util::fill(BOTTOM + "Lanes", map().with("visible", open));
            return;
        }
        show_panel(own_node(id));
        return;
    }
    if id == "scene" {
        left::show_tree();
    } else if id == "outline" {
        left::show_outline();
    } else if id == "inspector" {
        inspector::show_panel();
    } else if id == "import" {
        util::fill("Editor/Shell/Body/Right/RightSheet/Import", map().with("visible", true));
    } else {
        fill_plugin(S, id);
    }
}

/// Have a plugin fill its dock's subtree: the node the editor made for it,
/// not a `ui` handle, so a plugin fills its own subtree and cannot reach
/// past it. On a word its script heard, and when its dock shows it.
pub fn fill_plugin(S: editor::State, id: str) {
    if plugins::panel(S, id).is_none() {
        return;
    }
    let side_or = side_of(S, id);
    if side_or.is_none() {
        return;
    }
    let side = side_or.unwrap();
    let host = plugin_host(S, side, id);
    if host == "" {
        return;
    }
    plugins::draw_panel(S, id, host);
}

const BOTTOM: str = "Editor/Shell/Body/Centre/Bottom/";

// The bottom panels, each a scene of its own under the dock with its own
// script: shown and hidden here, filled by themselves. A panel's node by id.
fn own_nodes() -> any {
    map().with("output", "Output").with("problems", "Problems").with("docs", "Docs").with("profiler", "Profiler").with("cost", "Cost").with("assets", "Assets").with("library", "Library").with("tiles", "Tiles").with("statemachine", "StateMachine").with("recordings", "Recordings").with("debugger", "Debugger").with("timeline", "Timeline").with("weights", "Weights").with("bonemap", "Bonemap")
}

fn own_node(id: str) -> str {
    own_nodes().get(id).as_str()
}

fn is_own_node(name: str) -> bool {
    let items1 = own_nodes();
    for _i2 in items1.keys() {
        let held = items1.get(_i2);
        if held.as_str() == name {
            return true;
        }
    }
    false
}

// A panel that is a scene of its own, which `fill` shows and nothing draws.
fn filled_by_itself(id: str) -> bool {
    own_node(id) != ""
}

fn show_panel(name: str) {
    util::fill(BOTTOM + name, map().with("visible", true));
}

/// Fill a panel's strip of chips at `path`: `rows` is a list of controls a
/// row, made into nodes by the pool.
pub fn toolbar(S: editor::State, path: str, rows: [[any]]) {
    let groups: [any] = [];
    for row in rows {
        groups.push(map().with("kind", "row").with("role", "toolbar_dock").with("gap", [6, 6]).with("align_items", "center").with("controls", row));
    }
    pool::strip(S, path, groups);
}

fn node_owners() -> any {
    map()
        .with("bottom", [
            map().with("hide", "Output").with("panels", ["output"]),
            map().with("hide", "Problems").with("panels", ["problems"]),
            map().with("hide", "Docs").with("panels", ["docs"]),
            map().with("hide", "Profiler").with("panels", ["profiler"]),
            map().with("hide", "Cost").with("panels", ["cost"]),
            map().with("hide", "Assets").with("panels", ["assets"]),
            map().with("hide", "Library").with("panels", ["library"]),
            map().with("hide", "Tiles").with("panels", ["tiles"]),
            map().with("hide", "StateMachine").with("panels", ["statemachine"]),
            map().with("hide", "Recordings").with("panels", ["recordings"]),
            map().with("hide", "Lanes").with("panels", ["recordings"]),
            map().with("hide", "Timeline").with("panels", ["timeline"]),
            map().with("hide", "Weights").with("panels", ["weights"]),
            map().with("hide", "Bonemap").with("panels", ["bonemap"]),
            map().with("hide", "Debugger").with("panels", ["debugger"]),
        ])
        .with("left", [
            map().with("hide", "tree").with("panels", ["scene"]),
            map().with("hide", "outline").with("panels", ["outline"]),
        ])
        .with("right", [
            map().with("hide", "inspector").with("panels", ["inspector"]),
            map().with("hide", "import").with("panels", ["import"]),
        ])
}

fn hide_node(S: editor::State, which: str) {
    if is_own_node(which) || which == "Lanes" {
        util::hide(BOTTOM + which);
    } else if which == "tree" {
        left::hide_tree(S);
    } else if which == "outline" {
        left::hide_outline();
    } else if which == "import" {
        util::hide("Editor/Shell/Body/Right/RightSheet/Import");
    } else if which == "inspector" {
        inspector::hide_panel();
    }
}

fn hide_unused(S: editor::State, side: str, d: any) {
    hide_plugin_hosts(S, side, if d.shut { "" } else { d.active });
    for entry in node_owners().get(side) {
        let wanted = false;
        for id in entry.get("panels") {
            if id.as_str() == d.active {
                wanted = true;
            }
        }
        if d.shut || !wanted {
            hide_node(S, entry.get("hide").as_str());
        }
    }
}

// A tab, which a small window gets a step less of: the row is chrome, and
// chrome is what a short window has least room for.
fn tab_h(S: editor::State) -> float {
    // A tab is a control a finger picks, so it takes the same height as the
    // rest of them where a finger is what reaches it.
    if S.touchscreen {
        33.0
    } else if S.compact {
        20.0
    } else {
        22.0
    }
}

/// Where a side keeps its plugin docks' own subtrees, which the scene states
/// so one made at run time sits where the side wants it rather than last.
fn plugins_of(side: str) -> str {
    if side == "bottom" {
        "Editor/Shell/Body/Centre/Bottom/BottomPlugins"
    } else if side == "left" {
        "Editor/Shell/Body/Left/LeftSheet/LeftPlugins"
    } else {
        "Editor/Shell/Body/Right/RightSheet/RightPlugins"
    }
}

// A plugin dock's own subtree: a head, a sidebar, a body and a foot. One per
// dock and side, so a dock moved between sides leaves nothing behind it.
fn host_fragment(name: str) -> str {
    let text = "[[nodes]]\nid = \"HOST\"\nname = \"HOST\"\nscript.source = \"scripts/panels/plugin.rn\"\n[nodes.widget]\nkind = \"column\"\nrole = \"plugin_host\"\ngrow = 1\n\n[[nodes]]\nid = \"HOST_head\"\nname = \"Head\"\nparent = \"HOST\"\n[nodes.widget]\nkind = \"flow\"\nrole = \"plugin_head\"\nalign_items = \"center\"\n\n[[nodes]]\nid = \"HOST_split\"\nname = \"Split\"\nparent = \"HOST\"\n[nodes.widget]\nkind = \"row\"\nrole = \"plugin_split\"\ngrow = 1\n\n[[nodes]]\nid = \"HOST_side\"\nname = \"Side\"\nparent = \"HOST_split\"\n[nodes.widget]\nkind = \"scroll\"\naxis = \"vertical\"\nvisible = false\nwidth = 150\n\n[[nodes]]\nid = \"HOST_side_rows\"\nname = \"SideRows\"\nparent = \"HOST_side\"\n[nodes.widget]\nkind = \"column\"\nrole = \"plugin_side\"\ngrow = 1\n\n[[nodes]]\nid = \"HOST_body\"\nname = \"Body\"\nparent = \"HOST_split\"\n[nodes.widget]\nkind = \"scroll\"\naxis = \"vertical\"\ngrow = 1\n\n[[nodes]]\nid = \"HOST_rows\"\nname = \"Rows\"\nparent = \"HOST_body\"\n[nodes.widget]\nkind = \"column\"\nrole = \"plugin_rows\"\ngrow = 1\n\n[[nodes]]\nid = \"HOST_foot\"\nname = \"Foot\"\nparent = \"HOST\"\n[nodes.widget]\nkind = \"row\"\nrole = \"plugin_head\"\nalign_items = \"center\"\n";
    text.replace("HOST", name)
}

fn host_name(id: str) -> str {
    "Plugin_" + id
}

/// The node a plugin dock fills, made the first time it is drawn on that side
/// and shown. Its `head`, `body` and `foot` are what the kit writes to.
pub fn plugin_host(S: editor::State, side: str, id: str) -> str {
    let parent = plugins_of(side);
    let path = parent + "/" + host_name(id);
    if util::is_nil(scene::get_node(path)) {
        let under = scene::get_node(parent);
        if util::is_nil(under) {
            return "";
        }
        scene::instantiate(host_fragment(host_name(id)), under);
    }
    util::fill(parent, map().with("visible", true));
    util::fill(path, map().with("visible", true));
    path
}

/// Hide every plugin dock's subtree but the one showing, on every side: a
/// node keeps drawing until it is told not to.
fn hide_plugin_hosts(S: editor::State, side: str, active: str) {
    let any_ = false;
    for entry in S.registry.panels {
        if entry.id == active {
            any_ = true;
            continue;
        }
        util::hide(plugins_of(side) + "/" + host_name(entry.id));
    }
    if !any_ {
        util::hide(plugins_of(side));
    }
}

fn head_stem(side: str) -> str {
    let sheet = if side == "bottom" {
        "Editor/Shell/Body/Centre/Bottom"
    } else if side == "left" {
        "Editor/Shell/Body/Left/LeftSheet"
    } else {
        "Editor/Shell/Body/Right/RightSheet"
    };
    let name = if side == "bottom" { "Bottom" } else if side == "left" { "Left" } else { "Right" };
    sheet + "/" + name + "Head/" + name
}

fn head_of(side: str) -> str {
    head_stem(side) + "Tabs/" + head_name(side) + "TabsRow"
}

fn head_name(side: str) -> str {
    if side == "bottom" { "Bottom" } else if side == "left" { "Left" } else { "Right" }
}

/// The fixed end of a dock's head: the panel's own tools and the fold. Outside
/// the tabs' scroll, so neither drags away with them.
fn tail_of(side: str) -> str {
    head_stem(side) + "Tail"
}

/// The active tab's box and the strip it scrolls in, or nil before the
/// row has drawn. A tab past the strip's end is a panel showing with no tab.
pub fn active_tab_box(S: &mut editor::State, side: str) -> ActiveTabBox? {
    let at = 0;
    let shown = shown_tabs(S, side);
    let active = S.docks.get(side).get("active");
    for i in 0..shown.len() {
        if shown[i].equals(active) {
            at = i;
        }
    }
    let tab = scene::get_node("{head_of(side)}/C{at}");
    let strip = scene::get_node(head_stem(side) + "Tabs");
    if !tab.is_valid() || !strip.is_valid() {
        return nil;
    }
    let tab_box = ui::widget_rect(tab);
    let strip_box = ui::widget_rect(strip);
    if tab_box.is_none() || strip_box.is_none() {
        return nil;
    }
    ActiveTabBox { tab: tab_box.unwrap(), strip: strip_box.unwrap() }
}

/// The box the panel's own tools were given, in design pixels, or nil
/// before the row has drawn. The self-test reads it: a hatch with no box is
/// a dock whose tools are there and invisible.
pub fn tools_box(side: str) -> ui::Rect? {
    let found = scene::get_node(tail_of(side) + "/C0");
    if !found.is_valid() {
        return nil;
    }
    ui::widget_rect(found)
}

fn tab_row(S: &mut editor::State, k: any, side: str, d: any) {
    // What the two strips are built from: the dock, its tabs' names, the
    // Problems count its label carries, and the room the row has.
    let names: [any] = [];
    for id in d.tabs {
        names.push(panel(S, id).get("name"));
    }
    let counts = lint::counts(S);
    let key: any = [d, names, counts._0 + counts._1, tab_h(S), S.layout.get(side).w];
    if pool::strip_due(S, head_of(side), key) {
        pool::strip_keyed(S, head_of(side), key, tab_controls(S, k, side, d));
    }
    if pool::strip_due(S, tail_of(side), key) {
        pool::strip_keyed(S, tail_of(side), key, tail_controls(S, side));
    }
}

/// The panel's own controls and the fold, in that order: where they have
/// always been, at the end of the head rather than the end of the tabs.
fn tail_controls(S: editor::State, side: str) -> [any] {
    let fold = map()
        .with("kind", "button")
        .with("height", tab_h(S))
        .with("width", tab_h(S))
        .with("padding", 0)
        .with("text", "")
        .with("icon", icons::ui(shut_icon(side)))
        .with("role", "icon_action")
        .with("tooltip", "Minimize")
        .with("on", "handle")
        .with("data", map().with("fn", tail_controls_on_2).with("side", side));
    // Every panel carries its own tools in its own scene.
    let controls = [fold];
    controls
}

fn tail_controls_on_2(S: &mut editor::State, data: any, _0: any) {
    let side: str = data.side;
    S.docks.get(side).shut = true;
    signals::docks(S);
}

// One control a tab, the mark that closes it, and the fold at the end. The
// panel's own tools are the hatch beside this strip.
fn tab_controls(S: &mut editor::State, k: any, side: str, d: any) -> [any] {
    let h = tab_h(S);
    let out: [any] = [];
    let shown: [any] = shown_tabs(S, side);
    for id in shown {
        let held = id;
        let p = panel(S, held);
        let active = d.active == held;
        let label = tab_label(S, held);
        // One tile: the row carries the fill and the corners, and the two
        // halves inside it paint nothing, so the pair reads as one control.
        let inner: [any] = [];
        inner.push(map()
            .with("kind", "button")
            .with("height", h)
            .with("text", label)
            .with("padding", [6, -1, 6, -1])
            .with("corner_radius", 4)
            .with("fill", "none")
            .with("role", "tab")
            .with("checked", active)
            .with("on", "handle")
            .with("data", map().with("fn", tab_controls_on_3).with("side", side).with("held", held)));
        // Its own role, so the half of the tile under the pointer is the half
        // that lights up: a mark that looked the same either way was aimed at
        // and missed, and the click landed on the name beside it.
        inner.push(map()
            .with("kind", "button")
            .with("height", h)
            .with("width", 22)
            .with("text", "")
            .with("corner_radius", 4)
            .with("role", "icon_action_tab")
            .with("icon", icons::ui("close"))
            .with("tooltip", "Close {p.get("name")}")
            .with("on", "handle")
            .with("data", map().with("fn", tab_controls_on_4).with("held", held)));
        inner.push(Inner2 { kind: "row", width: 3 });
        out.push(Out16 {
            height: h,
            corner_radius: 4,
            controls: inner,
            align_items: "center",
            fill: if active { "primary_bg" } else { "none" },
        });
    }
    let hidden: [any] = [];
    for id in d.tabs {
        if !has(shown, id) {
            hidden.push(panel(S, id).get("name"));
        }
    }
    if hidden.len() > 0 {
        out.push(map()
            .with("kind", "dropdown")
            .with("role", "choice")
            .with("height", h)
            .with("width", MORE_W)
            .with("text", "+{hidden.len()}")
            .with("options", hidden)
            .with("tooltip", "More tabs")
            .with("on", "handle")
            .with("data", map().with("fn", tab_controls_on_5).with("side", side)));
    }
    out
}

fn tab_controls_on_3(S: &mut editor::State, data: any, _0: any) {
    let side: str = data.side;
    let held: str = data.held;
    S.docks.get(side).active = held;
    signals::docks(S);
}

fn tab_controls_on_4(S: &mut editor::State, data: any, _0: any) {
    let held: str = data.held;
    close(S, held);
}

fn tab_controls_on_5(S: &mut editor::State, data: any, picked: any) {
    let side: str = data.side;
    show_named(S, side, picked);
}

/// The tabs a dock's row has room for, the active one always among them: the
/// leading run that fits, slid along until it reaches the active tab.
pub fn shown_tabs(S: &mut editor::State, side: str) -> [any] {
    let d = S.docks.get(side);
    let room = S.layout.get(side).w - HEAD_END;
    if tabs_width(S, side) <= room {
        return d.tabs;
    }
    // The list's box and the gap before it.
    let room = room - MORE_W - 4.0;
    let widths: [float] = [];
    let end = 0;
    let used = 0.0;
    let fits = true;
    for i in 0..d.tabs.len() {
        let id = d.tabs[i];
        let w = tab_width(S, id);
        widths.push(w);
        used += w;
        if used <= room && fits {
            end = i;
        } else {
            fits = false;
        }
        if id == d.active && i > end {
            end = i;
        }
    }
    let start = end;
    let used = widths[end];
    while start > 0 && used + widths[start - 1] <= room {
        start -= 1;
        used += widths[start];
    }
    let out: [any] = [];
    for i in start..end + 1 {
        out.push(d.tabs[i]);
    }
    out
}

fn has(list: [any], id: str) -> bool {
    for x in list {
        if x == id {
            return true;
        }
    }
    false
}

// A pick from the "+N" list, which lists names: the panel it names comes forward.
fn show_named(S: &mut editor::State, side: str, name: any) {
    for id in S.docks.get(side).tabs {
        if panel(S, id).get("name") == name {
            S.docks.get(side).active = id;
            signals::docks(S);
        }
    }
}

// What a tab reads: its name, and the count Problems carries.
fn tab_label(S: &mut editor::State, id: str) -> any {
    let label = panel(S, id).get("name");
    if id == "problems" {
        let errors_warnings_1 = lint::counts(S);
        let errors = errors_warnings_1._0;
        let warnings = errors_warnings_1._1;
        if (errors + warnings).as_int() > 0 {
            label += " {errors + warnings}";
        }
    }
    label
}

/// Stop drawing a dock's tab strip, for a dock that is folded or empty.
fn hide_tabs(S: &mut editor::State, side: str) {
    pool::hide(S, head_of(side));
    S.pool_keys.remove(tail_of(side));
}

// How wide the tab row's own tiles are, from the names: a flat width per tab
// ran the hint over the row as soon as `Bone map` joined.
fn tabs_width(S: &mut editor::State, side: str) -> float {
    let total = 0.0;
    for tab in S.docks.get(side).tabs {
        total += tab_width(S, tab);
    }
    total
}

fn tab_width(S: &mut editor::State, id: str) -> float {
    // 11 px, semibold: under 6 px a character, plus the pill's padding, the
    // close mark and the gap to the next one, measured at 52 px.
    52.0 + 6.0 * util::f(tab_label(S, id).len())
}

// The caret on a dock's minimise button points at the edge it folds to, and
// the one on its handle points back the way it opens.
fn shut_icon(side: str) -> str {
    if side == "left" {
        "caret-left"
    } else if side == "right" {
        "caret-right"
    } else {
        "caret-down"
    }
}

fn open_icon(side: str) -> str {
    if side == "left" {
        "caret-right"
    } else if side == "right" {
        "caret-left"
    } else {
        "caret-up"
    }
}

/// Whether a dock is down to its rail: folded away, or emptied of every tab.
/// An emptied dock is not a blank sheet — it gives its width back.
pub fn folded(S: editor::State, side: str) -> bool {
    let d = S.docks.get(side);
    d.shut || d.tabs.len() == 0
}

/// Whether every dock is down to its rail, which is the layout focus leaves.
pub fn all_folded(S: editor::State) -> bool {
    for side in sides() {
        if !folded(S, side) {
            return false;
        }
    }
    true
}

/// A dock's tab row, which of its panels shows, and the side panels' own
/// showing: what its script asks for on `docks_changed`, rather than every pass.
pub fn fill(S: &mut editor::State, side: str) -> str {
    let k = S.theme;
    let d = S.docks.get(side);
    hide_unused(S, side, d);
    if d.tabs.len() == 0 || d.shut {
        hide_tabs(S, side);
        return "";
    }
    tab_row(S, k, side, d);
    body(S, d.active);
    shown_panel(S, side, d)
}

/// The node of the panel `fill` just showed, which the dock then tells to
/// fill itself: told after the showing, it never reads itself as hidden.
fn shown_panel(S: editor::State, side: str, d: any) -> str {
    if side == "right" && d.active == "import" {
        return "Import";
    }
    if side != "bottom" || !filled_by_itself(d.active) {
        return "";
    }
    if d.active == "recordings" && session::loaded(S) {
        return "Lanes";
    }
    own_node(d.active)
}

/// Whether a side dock is open: the one sheet that takes the whole body where
/// there is room for one, which the bottom dock never does.
pub fn side_open(S: editor::State) -> bool {
    !folded(S, "left") || !folded(S, "right")
}

/// Whether a side dock is folded with something to go back to.
fn has_handle(S: editor::State, side: str) -> bool {
    folded(S, side) && S.docks.get(side).tabs.len() > 0
}

/// The room the left dock's handle takes above the tool rail, which is where
/// it goes when there is a rail to sit over.
pub fn rail_top_h(S: editor::State) -> float {
    if S.rail_visible && has_handle(S, "left") {
        return tile(S) + 6.0;
    }
    0.0
}

/// The room that handle takes at the head of the top strip instead, for a
/// centre with no rail to put it over.
pub fn fold_inset(S: editor::State) -> float {
    if !S.rail_visible && has_handle(S, "left") {
        return tile(S) + 6.0;
    }
    0.0
}

/// The handles a folded dock leaves behind, at the edge it folded towards:
/// the left one above the tools or at the stage's corner, the right one
/// opposite it, the bottom one beside the zoom reading. A folded dock gives
/// its space back, so this is the way back to it. A side sheet that is the
/// whole screen offers one way out, its own fold: a handle to a second sheet
/// would open it over the first.
pub fn handles(S: editor::State) -> Handles {
    let hidden = S.chrome_off || (one_at_a_time(S) && side_open(S));
    Handles { left: handle(S, hidden, "left"), right: handle(S, hidden, "right"), bottom: handle(S, hidden, "bottom") }
}

fn handle(S: editor::State, hidden: bool, side: str) -> Handle {
    let p = panel(S, S.docks.get(side).active);
    Handle {
        shown: !hidden && has_handle(S, side),
        icon: icons::ui(open_icon(side)),
        tooltip: "Open the {p.get("name").to_lower()}",
    }
}

/// Open a folded dock from its handle.
pub fn open_from_handle(S: &mut editor::State, side: str) {
    if side == "bottom" {
        S.docks.bottom.shut = false;
        signals::docks(S);
        return;
    }
    unfold(S, side);
}
