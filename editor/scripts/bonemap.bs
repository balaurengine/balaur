// The Bone map dock: a canonical skeleton against this rig's bones, so a clip
// authored for one rig plays on another. Writes a `bone_map` asset for
// `animation.play(node, clip, { retarget = ... })` to read.

use editor;
use model;
use pool;
use rig;
use signals;
use util;

pub class BonemapState {
    bones: any,
    path: str,
    rig: str,
    picking: str?,
}

const NAME_W: float = 128.0;

const PICK_W: float = 190.0;

// The canonical humanoid, in the spelling `balaur_animation::retarget::HUMANOID`
// uses. One list, because a map written against another one would not load.
fn HUMANOID() -> [str] {
    [
        "Root",
        "Hips",
        "Spine",
        "Chest",
        "UpperChest",
        "Neck",
        "Head",
        "LeftShoulder",
        "LeftUpperArm",
        "LeftLowerArm",
        "LeftHand",
        "RightShoulder",
        "RightUpperArm",
        "RightLowerArm",
        "RightHand",
        "LeftUpperLeg",
        "LeftLowerLeg",
        "LeftFoot",
        "LeftToes",
        "RightUpperLeg",
        "RightLowerLeg",
        "RightFoot",
        "RightToes",
    ]
}

/// The dock's own state, hung on `state.bonemap`.
pub fn state() -> BonemapState {
    BonemapState { bones: map(), path: "", rig: "", picking: nil }
}

// The rig this map is being built against: the selection, or the rig above it
// when a bone is what is selected.
fn rig_root(state: editor::State) -> Node {
    let found = model::selected_node(state);
    if !found.is_valid() {
        return nil;
    }
    if rig::bone_count(state, state.sel) > 0 {
        return found;
    }
    // A selected bone maps the rig it hangs in, not itself: climbing to the
    // top bone is what a click in the tree usually means here.
    if !rig::is_bone(found) {
        return nil;
    }
    let top = found;
    let parent = found.parent();
    while parent.is_valid() {
        if model::index_of_node(state, parent).is_none() || !rig::is_bone(parent) {
            break;
        }
        top = parent;
        parent = parent.parent();
    }
    top
}

// The rig's bones as paths relative to its root, which is what a map stores.
fn bone_paths(state: editor::State) -> [str] {
    let root = rig_root(state);
    if !root.is_valid() {
        return [];
    }
    let base = root.path();
    let out: [str] = [];
    for bone in skeleton::bones(root) {
        let full = bone.path();
        if full != base {
            out.push(full.slice(base.len() + 1, full.len()));
        }
    }
    out
}

// A canonical name against the rig's own: the bone whose last segment matches
// once both are stripped of case, spaces, dots and underscores. `LeftUpperArm`
// finds `left_upper_arm`, `Left Upper Arm` and `mixamorig:LeftUpperArm`.
pub fn guess(canonical: str, paths: [str]) -> str? {
    let want = squash(canonical);
    for path in paths {
        if squash(util::leaf(path)) == want {
            return path;
        }
    }
    // Then the looser match: a bone whose name ends with the canonical one,
    // which is what an exporter's prefix leaves behind.
    for path in paths {
        if squash(util::leaf(path)).ends_with(want) {
            return path;
        }
    }
    nil
}

// A name with its separators taken out, so `LeftUpperArm`, `left_upper_arm`,
// `Left Upper Arm` and `mixamorig:LeftUpperArm` all compare the same.
fn squash(name: str) -> str {
    let out = name.to_lower();
    for sep in ["_", " ", ".", "-", ":"] {
        out = out.replace(sep, "");
    }
    out
}

// Fill every row the rig agrees on and leave the rest empty, which is the
// honest answer for a rig that does not have a bone.
pub fn autofill(state: &mut editor::State) {
    let paths = bone_paths(state);
    if paths.len() == 0 {
        log::warn("select a rig — a node with bones under it — before filling a bone map");
        return;
    }
    let found = 0;
    for name in HUMANOID() {
        let matched = guess(name, paths);
        if matched.is_some() {
            state.bonemap.bones.set(name, matched.unwrap());
            found += 1;
        }
    }
    log::info("{found} of {HUMANOID().len()} canonical bones matched by name");
    signals::changed(state, "bonemap");
}

pub fn clear(state: &mut editor::State) {
    state.bonemap.bones = map();
    signals::changed(state, "bonemap");
}

// Where the map is written, under the project's `animations/`, named after
// the rig so two rigs do not overwrite each other.
fn default_path(state: editor::State) -> str {
    let root = rig_root(state);
    let name = if root.is_valid() { util::leaf(root.path()) } else { "rig" };
    "animations/{name.to_lower()}.bonemap.toml"
}

pub fn save(state: &mut editor::State) {
    let mapped = map();
    let bones = state.bonemap.bones;
    for name in bones.keys() {
        let path = bones.get(name);
        if path.as_str() != "" {
            mapped.set(name, path);
        }
    }
    if mapped.len() == 0 {
        log::warn("nothing to save: fill some rows first");
        return;
    }
    let path = if state.bonemap.path == "" { default_path(state) } else { state.bonemap.path };
    let doc = map().with("type", "bone_map").with("bones", mapped);
    fs::write(state.game_root + "/" + path, toml::encode(doc));
    state.bonemap.path = path;
    log::info("{mapped.len()} bones written to {path}");
    signals::changed(state, "bonemap");
}

// The tab's own scene, under the bottom dock.
const PANEL: str = "Editor/Shell/Body/Centre/Bottom/Bonemap";

/// Fill the tab from the rig and the map: the count, a row a canonical bone,
/// and under the row being picked for, the rig's bones to pick from.
pub fn fill(state: editor::State) {
    let paths = bone_paths(state);
    if paths.len() == 0 {
        util::fill(PANEL + "/Missing", map().with("visible", true));
        util::fill(PANEL + "/Body", map().with("visible", false));
        return;
    }
    util::fill(PANEL + "/Missing", map().with("visible", false));
    util::fill(PANEL + "/Body", map().with("visible", true));
    let filled = 0;
    let bones = state.bonemap.bones;
    for name in bones.keys() {
        if bones.get(name).as_str() != "" {
            filled += 1;
        }
    }
    util::fill(PANEL + "/Body/Verbs/Count", map()
        .with("text", "{filled} of {HUMANOID().len()} mapped · {paths.len()} bones in the rig"));
    let rows: [any] = [];
    for name in HUMANOID() {
        for spec in row(state, paths, name) {
            rows.push(spec);
        }
    }
    pool::sync(state, PANEL + "/Body/Scroll/Rows", rows, 0.0, false);
}

/// A verb by the name of its button.
pub fn verb(state: &mut editor::State, name: str) {
    if name == "guess" {
        autofill(state);
    } else if name == "clear" {
        clear(state);
    } else if name == "save" {
        save(state);
    }
}

// A canonical bone's row, and the rig's bones under it while it is the one
// being picked for: a dock this narrow has nowhere to put a floating list,
// and the row it belongs to is the one thing a reader has to keep track of.
fn row(state: editor::State, paths: [str], name: str) -> [any] {
    let picked = state.bonemap.bones.get(name).as_str();
    let open = state.bonemap.picking == name;
    let controls = [
        map()
            .with("kind", "label")
            .with("role", if picked == "" { "text_code_quiet" } else { "text_code" })
            .with("font_size", 12)
            .with("width", NAME_W)
            .with("text", name),
        map()
            .with("kind", "button")
            .with("role", "chip")
            .with("width", PICK_W)
            .with("height", 22)
            .with("text", if picked == "" { "—" } else { picked })
            .with("text_align", "start")
            .with("checked", open)
            .with("tooltip", "Pick the bone this canonical name means on this rig")
            .with("on", "handle")
            .with("data", map().with("fn", toggle_picker).with("open", open).with("name", name)),
    ];
    if picked != "" {
        controls.push(map()
            .with("kind", "button")
            .with("role", "chip_quiet")
            .with("text", "×")
            .with("tooltip", "Leave this row empty")
            .with("on", "handle")
            .with("data", map().with("fn", leave_row_empty).with("name", name)));
    }
    let out = [map().with("full", true).with("height", 24).with("controls", controls)];
    if !open {
        return out;
    }
    for bone_path in paths {
        // Bound afresh: a closure made in a loop captures the binding.
        let path = bone_path;
        out.push(map()
            .with("full", true)
            .with("height", 20)
            .with("controls", [
                map().with("kind", "label").with("width", NAME_W).with("text", ""),
                map()
                    .with("kind", "button")
                    .with("role", "chip")
                    .with("width", PICK_W)
                    .with("height", 20)
                    .with("text", path)
                    .with("text_align", "start")
                    .with("checked", path == picked)
                    .with("on", "handle")
                    .with("data", map().with("fn", pick_bone_path).with("name", name).with("path", path)),
            ]));
    }
    out
}

fn toggle_picker(state: &mut editor::State, data: any, _value: any) {
    let open: bool = data.open;
    let name: str = data.name;
    state.bonemap.picking = if open { nil } else { name };
    signals::changed(state, "bonemap");
}

fn leave_row_empty(state: &mut editor::State, data: any, _value: any) {
    let name: str = data.name;
    state.bonemap.bones.set(name, "");
    signals::changed(state, "bonemap");
}

fn pick_bone_path(state: &mut editor::State, data: any, _value: any) {
    let name: str = data.name;
    let path: str = data.path;
    state.bonemap.bones.set(name, path);
    state.bonemap.picking = nil;
    signals::changed(state, "bonemap");
}
