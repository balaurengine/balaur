//! What a plugin fills its dock with. A plugin cannot `use` the editor's
//! modules, so each verb is an Editor method it calls by name: `kit_rows`,
//! `kit_field` and the rest in editor.bs.

// A verb answers a row rather than drawing one: the pool writes the rows onto
// the subtree the editor made for the dock. A plugin's control says
// `on: "relay"`, `data: { to, method }`, and gets `method(data, value)`.

use editor;
use pool;
use settings;
use signals;
use util;

/// The deepest a file browser walks below its root.
const FOLDER_DEPTH: int = 3;

/// The most of a text file shown inline, in characters.
const TEXT_SHOWN: int = 4000;

/// How far one level of a tree is indented, in spaces: a row's label is a
/// node, and the pool gives every row the same label column.
const INDENT: str = "  ";

/// The label column every kit row keeps.
const LABEL_WIDTH: float = 140.0;

/// A plugin's word that what its docks and dialogs show moved: they fill
/// again on it, as the editor's own panels do on theirs.
pub fn changed(state: &mut editor::State) {
    signals::changed(state, "plugins");
}

/// Put a plugin's dialog up, by the id it registered it under.
pub fn open_dialog(state: &mut editor::State, id: str) {
    state.registry.open[id] = true;
    changed(state);
}

/// Hand a plugin control's edit to the method its `data` names on the node
/// it names: what `on: "relay"` means.
pub fn relay(data: any, value: any) {
    let to = data["to"].as_node();
    if to.is_valid() {
        to.call(data["method"].as_str(), data, value);
    }
}

/// Point `save::` at the game's own user data directory, and let `fs` reach
/// it, so a game played here and the same game run alone keep one set of
/// saves, and the User data dock can open them.
pub fn adopt_game_data(state: editor::State) {
    if state.game_root == "" {
        project::use_data(nil);
        return;
    }
    project::use_data(game_name(state));
}

/// The user data directory the open game has when it runs on its own.
pub fn game_data(state: editor::State) -> str {
    if state.game_root == "" {
        return engine::user_data_directory();
    }
    engine::user_data_directory_of(game_name(state))
}

fn game_name(state: editor::State) -> str {
    let text = fs::read(state.game_root + "/project.toml");
    if text == nil {
        return "";
    }
    toml::parse(text.unwrap())["application"]["name"].as_str()
}

/// What a verb remembers between frames: open tabs, open branches, drafts.
fn memory(state: &mut editor::State) -> any {
    if state.kit_state == nil {
        state.kit_state = {};
    }
    state.kit_state
}

fn option(options: any, key: str, fallback: any) -> any {
    let found = options[key];
    if found == nil { fallback } else { found }
}

// Where each name a plugin uses sits under its host. A name the table does
// not know is the body, which is where rows belong.
fn host_path(host: str, name: str) -> str {
    if name == "head" {
        return host + "/Head";
    }
    if name == "foot" {
        return host + "/Foot";
    }
    if name == "side" {
        return host + "/Split/Side/SideRows";
    }
    host + "/Split/Body/Rows"
}

/// A row of controls on a named part of the host: `head`, `foot`, or the
/// `body` that everything else means.
pub fn bar(state: editor::State, host: str, name: str, controls: [ui::Control]) {
    pool::strip(state, host_path(host, name), controls);
}

/// Rows on a named part of the host. A spec is what `pool::sync` takes:
/// `{ label, controls }`, or `full` for a row across both columns.
pub fn rows(state: editor::State, host: str, name: str, specs: [ui::Row]) {
    pool::sync(state, host_path(host, name), specs, LABEL_WIDTH, false);
}

/// The node itself, for a plugin that wants to `add_child` a shape the kit
/// has no verb for, or to read a rect back.
pub fn area(host: str, name: str) -> Node {
    scene::get_node(host_path(host, name))
}

// A tab or a page button, which remembers itself picked per `id`.
fn pick_button(state: &mut editor::State, id: str, name: str, role: str, on: bool) -> ui::Control {
    let button: ui::Control = ui::Control { kind: "button", text: name, role: role, checked: on };
    pool::on(button, picked, { "key": "tab:" + id, "name": name })
}

fn picked(state: &mut editor::State, data: any, _value: any) {
    memory(state)[data["key"].as_str()] = data["name"];
    changed(state);
}

// The name remembered for `id`, while it is still one of `names`; the first
// of them otherwise.
fn current_of(state: &mut editor::State, id: str, names: [str]) -> str {
    let held = memory(state)["tab:" + id];
    if held.kind() == "str" && util::contains(names, held.as_str()) { held.as_str() } else { names[0] }
}

/// Rows of tabs across the host's head, wrapped to the width there is;
/// answers the one that is open, remembered per `id`.
pub fn tabs(state: &mut editor::State, host: str, id: str, names: any) -> str {
    let list: [str] = [];
    for name in util::list_or_empty(names) {
        list.push(name.as_str());
    }
    if list.len() == 0 {
        return "";
    }
    let current = current_of(state, id, list);
    let controls: [ui::Control] = [];
    for name in list {
        controls.push(pick_button(state, id, name, "chip", name == current));
    }
    bar(state, host, "head", controls);
    memory(state)["tab:" + id] = current;
    current
}

/// A list of pages down the host's sidebar, the way the settings screen is
/// laid out: what a panel with many views and little height wants. `groups`
/// is `[{ title, names }]`, and the answer is the page that is open, which
/// the plugin then fills the body with.
pub fn pages(state: &mut editor::State, host: str, id: str, groups: any) -> str {
    let names: [str] = [];
    for group in util::list_or_empty(groups) {
        for name in util::list_or_empty(group["names"]) {
            names.push(name.as_str());
        }
    }
    if names.len() == 0 {
        util::hide(host_path(host, "side"));
        return "";
    }
    let current = current_of(state, id, names);
    let controls: [ui::Control] = [];
    for group in util::list_or_empty(groups) {
        if group["title"].as_str() != "" {
            controls.push(ui::Control { kind: "label", role: "text_caption", text: group["title"] });
        }
        for name in util::list_or_empty(group["names"]) {
            controls.push(pick_button(state, id, name.as_str(), "item_sidebar", name.as_str() == current));
        }
    }
    bar(state, host, "side", controls);
    util::set_visible(host + "/Split/Side", true);
    memory(state)["tab:" + id] = current;
    current
}

/// A heading between groups of rows.
pub fn heading(title: str) -> ui::Row {
    ui::Row {
        full: true,
        height: 24,
        controls: [ui::Control { kind: "label", role: "action_section", text: title }],
    }
}

/// What a panel says when it has nothing.
pub fn empty(text: str) -> ui::Row {
    ui::Row {
        full: true,
        height: 0,
        controls: [
            ui::Control {
                kind: "label",
                role: "text_caption",
                grow: 1,
                wrap: true,
                text: text,
            },
        ],
    }
}

/// Write the editor's own settings file, after a plugin set an editor-scope
/// setting it wants kept.
pub fn save_preferences(state: editor::State) {
    settings::commit_preferences(state);
}

/// Write the game's `project.toml`, after a plugin set a project-scope
/// setting the person chose: the Gamend dock's server picker.
pub fn save_project(state: editor::State) {
    settings::commit_project(state);
}

/// A labelled value. `mask` hides all but its ends until `show` is pressed,
/// `copy` adds a copy mark (copying `copy_text` when given), and `role`
/// dresses the value where the theme has a role for what it says.
pub fn field(state: &mut editor::State, label: str, value: any, options: any) -> ui::Row {
    let text = shown(value);
    let masked = option(options, "mask", false).as_bool();
    let key = "shown:" + label;
    let revealed = memory(state)[key].as_bool();
    let controls: [ui::Control] = [
        ui::Control {
            kind: "label",
            grow: 1,
            truncate: true,
            role: option(options, "role", "text_caption"),
            text: if masked && !revealed { mask(text) } else { text },
        },
    ];
    if masked {
        let button: ui::Control = ui::Control { kind: "button", role: "chip", text: if revealed { "hide" } else { "show" } };
        controls.push(pool::on(button, field_toggled, { "key": key }));
    }
    if option(options, "copy", false).as_bool() {
        let whole = option(options, "copy_text", text);
        let button: ui::Control = ui::Control { kind: "button", role: "chip", text: "copy" };
        controls.push(pool::on(button, field_copied, { "whole": whole }));
    }
    ui::Row { label: label, height: 22, slot_role: "layout_actions", controls: controls }
}

fn field_toggled(state: &mut editor::State, data: any, _value: any) {
    let key = data["key"].as_str();
    let remembered = memory(state);
    remembered[key] = !remembered[key].as_bool();
    changed(state);
}

fn field_copied(state: &mut editor::State, data: any, _value: any) {
    ui::set_clipboard(data["whole"].as_str());
}

fn mask(text: str) -> str {
    let chars = text.chars();
    if chars.len() <= 12 {
        return "••••••••";
    }
    let head = "";
    let tail = "";
    for index in 0..4 {
        head = head + chars[index];
        tail = tail + chars[chars.len() - 4 + index];
    }
    head + "••••••••" + tail
}

/// The first `most` characters of a text, with a mark when it went on past
/// them.
fn head_of(text: str, most: int) -> str {
    let chars = text.chars();
    if chars.len() <= most {
        return text;
    }
    let out = "";
    for index in 0..most {
        out = out + chars[index];
    }
    out + "…"
}

/// A value as text, the way a row shows it.
fn shown(value: any) -> str {
    if value.kind() == "str" {
        return value.as_str();
    }
    if value == nil {
        return "nil";
    }
    if value.kind() == "map" || value.kind() == "list" {
        return json::encode(value);
    }
    "{value}"
}

/// A value as rows: a map or a list opens and closes, a leaf shows in mono.
/// With `edit`, a leaf is a field and Enter keeps what was typed: the value
/// is changed in place and handed whole to `write`, `{ to, method }` naming
/// the plugin's method that keeps it. Answers `{ specs, value, changed }`;
/// the caller puts the specs on its host.
pub fn tree(state: &mut editor::State, id: str, value: any, options: any) -> any {
    let none: [any] = [];
    let out: any = { "specs": none, "value": value, "changed": false, "write": option(options, "write", nil) };
    let edit = option(options, "edit", false).as_bool();
    let label = option(options, "label", "").as_str();
    branch(state, out, id, [], label, value, edit, 0);
    out
}

fn branch(state: &mut editor::State, out: any, path: str, keys: [any], label: str, value: any, edit: bool, depth: int) {
    if value.kind() == "map" || value.kind() == "list" {
        container(state, out, path, keys, label, value, edit, depth);
    } else {
        leaf(out, keys, label, value, edit, depth);
    }
}

fn container(state: &mut editor::State, out: any, path: str, keys: [any], label: str, value: any, edit: bool, depth: int) {
    let key = "open:" + path;
    let held = memory(state)[key];
    let open = if held == nil { depth == 0 } else { held.as_bool() };
    let count = if value.kind() == "map" { "{value.len()} keys" } else { "{value.len()} items" };
    let titled = label != "" || depth > 0;
    if titled {
        let button: ui::Control = ui::Control {
            kind: "button",
            role: "chip",
            text: indent(depth) + (if open { "▾ " } else { "▸ " }) + label,
        };
        out["specs"].push(ui::Row {
            full: true,
            height: 22,
            slot_role: "layout_actions",
            controls: [
                pool::on(button, folded, { "key": key, "open": open }),
                ui::Control { kind: "label", role: "text_caption", text: count },
            ],
        });
    }
    if !open {
        return;
    }
    let inner = if titled { depth + 1 } else { depth };
    if value.kind() == "map" {
        for name in util::keys_sorted(value) {
            branch(state, out, path + "/" + name, with(keys, name), name, value[name], edit, inner);
        }
    } else {
        for index in 0..value.len() {
            branch(state, out, path + "/{index}", with(keys, index), "{index}", value[index], edit, inner);
        }
    }
}

fn folded(state: &mut editor::State, data: any, _value: any) {
    memory(state)[data["key"].as_str()] = !data["open"].as_bool();
    changed(state);
}

// The keys down to a child, as a list of their own: a list shared between
// siblings would end with the last one's key.
fn with(keys: [any], key: any) -> [any] {
    let out: [any] = [];
    for earlier in keys {
        out.push(earlier);
    }
    out.push(key);
    out
}

// A row's own depth, as the spaces before its label: a pooled row's label is
// a node in a column of them, so the text is what steps right.
fn indent(depth: int) -> str {
    util::repeat(INDENT, depth)
}

fn leaf(out: any, keys: [any], label: str, value: any, edit: bool, depth: int) {
    let text = shown(value);
    let control: ui::Control = if edit {
        let field: ui::Control = ui::Control { kind: "text_field", role: "input_form", grow: 1, text: text };
        // The whole value and where it is written, not `out`: its specs hold
        // this control, and a map holding itself crosses to no engine.
        let whole: any = { "value": out["value"], "write": out["write"] };
        pool::on_submit(field, typed, { "text": text, "out": whole, "keys": keys, "value": value })
    } else {
        ui::Control { kind: "label", role: "text_caption", grow: 1, truncate: true, text: text }
    };
    out["specs"].push(ui::Row { height: 22, controls: [control], label: indent(depth) + label });
}

fn typed(state: &mut editor::State, data: any, now: any) {
    if now.as_str() != data["text"].as_str() {
        let keys: [any] = data["keys"];
        put(data["out"], keys, parsed(data["value"], now.as_str()));
    }
}

// An edited leaf, written into the whole value at its keys and the whole
// handed to whatever keeps it.
fn put(out: any, keys: [any], now: any) {
    out["changed"] = true;
    if keys.len() == 0 {
        out["value"] = now;
    } else {
        let at = out["value"];
        for index in 0..keys.len() - 1 {
            at = if keys[index].kind() == "int" { at[keys[index].as_int()] } else { at[keys[index].as_str()] };
        }
        let last = keys[keys.len() - 1];
        if last.kind() == "int" {
            at[last.as_int()] = now;
        } else {
            at[last.as_str()] = now;
        }
    }
    let write = out["write"];
    if write.has("file") {
        let path = write["file"].as_str();
        fs::write(path, if write["toml"].as_bool() { toml::encode(out["value"]) } else { json::encode(out["value"]) });
    } else if write != nil {
        let to = write["to"].as_node();
        if to.is_valid() {
            to.call(write["method"].as_str(), out["value"]);
        }
    }
}

/// What was typed, as the kind of value it replaces: text stays text, and a
/// number or a switch is read the way a TOML file would read it.
fn parsed(was: any, typed: str) -> any {
    if was.kind() == "str" {
        return typed;
    }
    let doc = toml::parse("v = " + typed);
    if doc.kind() == "map" && doc.has("v") {
        return doc["v"];
    }
    typed
}

/// Every file under a user data directory as rows, opened as a structure
/// where it is TOML or JSON, edited in place and written back. `options`:
/// `root` (default this game's user data directory), `only` (file names to
/// show), `edit`.
pub fn files(state: &mut editor::State, id: str, options: any) -> [ui::Row] {
    let root = option(options, "root", game_data(state)).as_str();
    let only: [str] = [];
    for name in util::list_or_empty(options["only"]) {
        only.push(name.as_str());
    }
    let reveal_root: ui::Control = ui::Control { kind: "button", role: "chip", text: "reveal" };
    let out: [ui::Row] = [
        ui::Row {
            full: true,
            height: 24,
            slot_role: "layout_actions",
            controls: [
                ui::Control { kind: "label", role: "text_caption", grow: 1, truncate: true, text: short_path(root) },
                pool::on(reveal_root, revealed, { "path": root }),
            ],
        },
    ];
    let drawn = folder(state, id, root, "", only, option(options, "edit", true).as_bool(), 0, out);
    if drawn == 0 {
        out.push(empty("nothing kept yet"));
    }
    out
}

fn revealed(state: &mut editor::State, data: any, _value: any) {
    engine::reveal(data["path"].as_str());
}

/// One directory's entries; answers how many files it put rows on.
fn folder(state: &mut editor::State, id: str, directory: str, rel: str, only: [str], edit: bool, depth: int, out: [ui::Row]) -> int {
    let drawn = 0;
    for entry in util::list_or_empty(fs::list(directory)) {
        let name = entry["name"].as_str();
        let path = directory + "/" + name;
        let here = if rel == "" { name } else { rel + "/" + name };
        if entry["is_dir"].as_bool() {
            if depth < FOLDER_DEPTH {
                drawn += folder(state, id, path, here, only, edit, depth + 1, out);
            }
            continue;
        }
        if only.len() > 0 && !util::contains(only, name) {
            continue;
        }
        file_rows(state, id + ":" + here, path, here, edit, out);
        drawn += 1;
    }
    drawn
}

fn file_rows(state: &mut editor::State, id: str, path: str, rel: str, edit: bool, out: [ui::Row]) {
    let key = "file:" + id;
    let open = memory(state)[key].as_bool();
    let toggle: ui::Control = ui::Control { kind: "button", role: "chip", text: (if open { "▾ " } else { "▸ " }) + rel };
    let controls = [pool::on(toggle, folded, { "key": key, "open": open })];
    let when = fs::modified_time(path);
    if when != nil {
        controls.push(ui::Control { kind: "label", role: "text_caption", text: ago(engine::unix_time() - when.unwrap()) });
    }
    let reveal: ui::Control = ui::Control { kind: "button", role: "chip", text: "reveal" };
    controls.push(pool::on(reveal, revealed, { "path": path }));
    out.push(ui::Row { full: true, height: 24, controls: controls, slot_role: "layout_actions" });
    if open {
        document(state, id, path, edit, out);
    }
}

/// A file opened: rows for TOML and JSON, its text otherwise.
fn document(state: &mut editor::State, id: str, path: str, edit: bool, out: [ui::Row]) {
    let text = fs::read(path);
    if text == nil {
        out.push(empty("cannot read this file"));
        return;
    }
    let as_toml = path.ends_with(".toml");
    if !as_toml && !path.ends_with(".json") {
        out.push(empty(head_of(text.unwrap(), TEXT_SHOWN)));
        return;
    }
    let value = if as_toml { toml::parse(text.unwrap()) } else { json::parse(text.unwrap()) };
    if value == nil {
        out.push(ui::Row {
            full: true,
            height: 22,
            controls: [
                ui::Control { kind: "label", role: "note_warning", grow: 1, wrap: true, text: "does not parse" },
            ],
        });
        return;
    }
    let keep: any = { "file": path, "toml": as_toml };
    for spec in util::list_or_empty(tree(state, id, value, { "edit": edit, "write": keep })["specs"]) {
        out.push(spec);
    }
}

/// A path as a person reads it: under the home directory it starts with `~`,
/// which also keeps a user name out of a screenshot.
pub fn short_path(path: str) -> str {
    let home = project::home();
    if home != "" && path.starts_with(home + "/") {
        return "~" + path.slice(home.len(), path.len());
    }
    path
}

/// Seconds as how long ago, in the unit a person reads it in.
fn ago(seconds: float) -> str {
    if seconds < 90.0 {
        return "just now";
    }
    if seconds < 5400.0 {
        return "{(seconds / 60.0) as int} min ago";
    }
    if seconds < 129600.0 {
        return "{(seconds / 3600.0) as int} h ago";
    }
    "{(seconds / 86400.0) as int} days ago"
}
