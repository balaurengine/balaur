// The theme window: every colour, role and kind the worn theme holds, each
// drawn as itself, with the keys of the one picked listed under it. A bundled
// theme is read-only; a copy of it in the person's themes folder edits live.

use editor;
use pool;
use settings;
use style;
use theme;
use util;
use window;

pub class ThemewinState {
    page: str,
    path: [str],
    table: str,
    own: any,
    dirty: bool,
    pairs: [any],
    said: str,
    demo: int,
    test: Test,
}

/// What `--state themeeditdemo` keeps to put back: the preferences file as it
/// was, and the theme it made.
pub struct Test {
    kept: str?,
    name: str,
}

const ID: str = "theme";

// What a role with no fill of its own is drawn on, for its contrast.
const GROUND: str = "bg_panel";

fn PAGES() -> [str] {
    ["colors", "sizes", "text", "controls", "boxes", "layout", "kinds", "problems"]
}

// The tables under a role that replace it in a state, and the class one.
fn STATES() -> [str] {
    ["hover", "active", "focus", "disabled", "checked", "touch"]
}

// Every key a role or a kind may state, in the order its rows list them.
fn KEYS() -> [str] {
    [
        "fill",
        "text_color",
        "stroke",
        "icon_color",
        "icon_fill",
        "font",
        "font_size",
        "font_weight",
        "text_align",
        "height",
        "width",
        "corner_radius",
        "padding",
        "padding_x",
        "padding_y",
        "gap",
        "stroke_width",
    ]
}

fn COLOR_KEYS() -> [str] {
    ["fill", "text_color", "stroke", "icon_color", "icon_fill"]
}

// The keys a size's name may stand in for a number on.
fn SIZE_KEYS() -> [str] {
    [
        "font_size",
        "height",
        "width",
        "corner_radius",
        "padding",
        "padding_x",
        "padding_y",
        "gap",
        "stroke_width",
    ]
}

// The colours a theme states, which every other token is worked out from.
fn SOURCES() -> [str] {
    ["background", "foreground", "primary", "secondary", "success", "warning", "danger"]
}

// Under this the pages go above the rows rather than beside them.
const STACK_BELOW: float = 520.0;

pub fn state() -> ThemewinState {
    ThemewinState {
        page: "colors",
        // The table picked: `["roles", "tab"]` or a kind's `["panel"]`, and
        // which of its state tables, "" for the role itself.
        path: [],
        table: "",
        // The person's theme as its file holds it, unmerged; nothing while a
        // bundled theme is worn, which is what makes the window read-only.
        own: nil,
        dirty: false,
        // Every role's ink on its fill, for the worn document.
        pairs: [],
        said: "",
        // Where `--state themeeditdemo` has got to; -1 when it is not running.
        demo: -1,
        test: Test { kept: nil, name: "" },
    }
}

pub fn open(state: &mut editor::State) {
    window::show(state, ID);
    load_own(state);
}

/// Open on a page with one entry picked, for a screenshot or a self-test.
pub fn open_at(state: &mut editor::State, page: str, path: [str]) {
    open(state);
    state.themewin.page = page;
    state.themewin.path = path;
    state.themewin.table = "";
}

pub fn editable(state: editor::State) -> bool {
    !state.themewin.own.is_nil()
}

fn load_own(state: &mut editor::State) {
    let name = state.theme.get("name").as_str();
    let own = if theme::is_bundled(name) { nil } else { theme::own_half(name, state.theme.get("half").as_str()) };
    state.themewin.own = own;
    state.themewin.dirty = false;
    state.themewin.pairs = ui::contrast_pairs(state.theme.doc, GROUND);
}

/// Fill the sheet: what its script asks for when Theme is up.
pub fn fill(state: &mut editor::State) {
    let tokens = state.theme;
    let stacked = ui::window_size().x < STACK_BELOW;
    let hosts = window::sheet_form(state, ID, "Theme", save_button(state));
    if hosts.is_none() {
        return;
    }
    let hosts = hosts.unwrap();
    pool::strip(state, hosts.side_rows, if stacked { [] } else { side_controls(state) });
    util::fill(hosts.side, map().with("visible", !stacked));
    let specs = form_specs(state);
    if stacked {
        specs.insert(0, page_picker(state));
    }
    pool::sync(state, hosts.form, specs, label_w(state), stacked);
}

fn label_w(state: editor::State) -> float {
    util::clamp((window::inner_w(state) - 210.0) * 0.28, 120.0, 220.0)
}

// Save, beside the close, while there is an edit to save.
fn save_button(state: editor::State) -> [any] {
    if !state.themewin.dirty {
        return [];
    }
    return [
        map()
            .with("kind", "button")
            .with("role", "action_form_primary")
            .with("text", "Save")
            .with("on", "handle")
            .with("data", map().with("fn", on_save_clicked)),
    ];
}

fn on_save_clicked(state: &mut editor::State, data: any, _value: any) {
    save(state);
}

fn page_title(state: editor::State, page: str) -> str {
    let count = if page == "colors" {
        state.theme.get("colors").len()
    } else if page == "sizes" {
        state.theme.get("sizes").len()
    } else if page == "problems" {
        problems(state).len()
    } else if page == "kinds" {
        kind_names(state.theme.get("doc")).len()
    } else {
        role_names(state.theme.get("doc"), page).len()
    };
    let word = page.slice(0, 1).to_upper() + page.slice(1, page.len());
    "{word}  {count}"
}

fn side_controls(state: editor::State) -> [any] {
    let out: [any] = [];
    for name in PAGES() {
        // Bound afresh: a closure made in a loop captures the binding.
        let page = name;
        let on = state.themewin.page == page;
        out.push(map()
            .with("kind", "button")
            .with("text", page_title(state, page))
            .with("role", "item_sidebar")
            .with("checked", on)
            .with("on", "handle")
            .with("data", map().with("fn", on_page_button_clicked).with("page", page)));
    }
    out
}

fn on_page_button_clicked(state: &mut editor::State, data: any, _value: any) {
    let page: str = data.page;
    state.themewin.page = page;
}

fn page_picker(state: editor::State) -> any {
    map()
        .with("full", true)
        .with("height", style::row_h(state))
        .with("controls", [
            map()
                .with("kind", "dropdown")
                .with("role", "choice_form")
                .with("grow", 1)
                .with("text", state.themewin.page)
                .with("options", PAGES())
                .with("on", "handle")
                .with("data", map().with("fn", on_page_picked)),
        ])
}

fn on_page_picked(state: &mut editor::State, data: any, picked: any) {
    state.themewin.page = picked.as_str();
}

/// Which page a role belongs on, by the component its name starts with.
pub fn page_of(name: str) -> str {
    let component = name.split("_")[0];
    if component == "text" {
        "text"
    } else if component == "note" || component == "sheet" || component == "header" || component == "toolbar" {
        "boxes"
    } else if component == "layout" || component == "list" {
        "layout"
    } else {
        "controls"
    }
}

fn sorted_keys(table: any) -> [str] {
    let out: [str] = [];
    for key in table.keys() {
        out.push(key);
    }
    out.sort();
    out
}

fn role_names(doc: any, page: str) -> [str] {
    let roles = util::obj(doc.roles);
    let out: [str] = [];
    for name in sorted_keys(roles) {
        if page_of(name) == page {
            out.push(name);
        }
    }
    out
}

/// The kind tables: every table a document holds beside its colours and roles.
fn kind_names(doc: any) -> [str] {
    let out: [str] = [];
    for key in sorted_keys(doc) {
        if key != "colors" && key != "sizes" && key != "roles" && doc.get(key).kind() == "map" {
            out.push(key);
        }
    }
    out
}

fn problems(state: editor::State) -> [any] {
    let out: [any] = [];
    for pair in util::vec(state.themewin.pairs) {
        if pair.ratio.as_float() < pair.need.as_float() {
            out.push(pair);
        }
    }
    out
}

fn form_specs(state: editor::State) -> [any] {
    let doc = state.theme.get("doc");
    let out = head_specs(state);
    let page = state.themewin.page;
    if page == "colors" {
        color_specs(state, doc, out);
    } else if page == "sizes" {
        size_specs(state, doc, out);
    } else if page == "problems" {
        problem_specs(state, out);
    } else if page == "kinds" {
        for name in kind_names(doc) {
            entry_specs(state, doc, [name], out);
        }
    } else {
        for name in role_names(doc, page) {
            entry_specs(state, doc, ["roles", name], out);
        }
    }
    out
}

fn head_specs(state: editor::State) -> [any] {
    let row_height = style::row_h(state);
    let name = state.theme.get("name").as_str();
    let own: any = state.themewin.own;
    let mine = editable(state);
    let controls = [
        map()
            .with("kind", "dropdown")
            .with("role", "choice_form")
            .with("width", 180)
            .with("text", name)
            .with("options", theme::names())
            .with("tooltip", "The theme the editor uses")
            .with("on", "handle")
            .with("data", map().with("fn", on_theme_picked)),
    ];
    if mine {
        controls.push(map()
            .with("kind", "dropdown")
            .with("role", "choice_form")
            .with("width", 150)
            .with("text", "based on " + theme::base_of(own))
            .with("options", theme::BUNDLED())
            .with("tooltip", "The bundled theme every key this one leaves out comes from")
            .with("on", "handle")
            .with("data", map().with("fn", on_base_picked)));
    }
    controls.push(map().with("kind", "row").with("grow", 1));
    controls.push(map()
        .with("kind", "button")
        .with("role", "action_form_primary")
        .with("text", "Duplicate")
        .with("tooltip", "Copy this theme into your themes folder and use the copy")
        .with("on", "handle")
        .with("data", map().with("fn", on_duplicate_clicked)));
    if mine && state.themewin.dirty {
        controls.push(map()
            .with("kind", "button")
            .with("role", "action_form")
            .with("text", "Revert")
            .with("tooltip", "Drop the edits since the last save")
            .with("on", "handle")
            .with("data", map().with("fn", on_revert_clicked)));
    }
    if mine {
        controls.push(map()
            .with("kind", "button")
            .with("role", "action_form_danger")
            .with("text", "Delete")
            .with("tooltip", "Remove this theme's folder and go back to its base")
            .with("on", "handle")
            .with("data", map().with("fn", on_delete_clicked)));
    }
    let out = [map().with("full", true).with("height", row_height).with("slot_role", "layout_actions").with("controls", controls)];
    if mine {
        out.push(map()
            .with("full", false)
            .with("height", row_height)
            .with("controls", [
                map()
                    .with("kind", "text_field")
                    .with("role", "input_form")
                    .with("grow", 1)
                    .with("text", name)
                    .with("tooltip", "Enter renames the folder")
                    .with("on_submit", "handle_submit")
                    .with("data", map().with("submit", on_name_submitted)),
            ])
            .with("label", "name"));
    }
    let tail = if state.themewin.dirty { "  ·  unsaved" } else { "" };
    out.push(note_spec(if mine {
        "themes/{name}/{state.theme.get("half")}.toml in the editor's data folder  ·  states only what differs from {theme::base_of(own)}{tail}"
    } else {
        "Bundled with the editor, so it is read-only. Duplicate it to change a color or a role."
    }));
    if state.themewin.said != "" {
        out.push(note_spec(state.themewin.said));
    }
    out
}

fn on_theme_picked(state: &mut editor::State, data: any, picked: any) {
    choose(state, picked.as_str());
}

fn on_base_picked(state: &mut editor::State, data: any, picked: any) {
    rebase(state, picked);
}

fn on_duplicate_clicked(state: &mut editor::State, data: any, _value: any) {
    duplicate(state);
}

fn on_revert_clicked(state: &mut editor::State, data: any, _value: any) {
    revert(state);
}

fn on_delete_clicked(state: &mut editor::State, data: any, _value: any) {
    remove(state);
}

fn on_name_submitted(state: &mut editor::State, data: any, text: any) {
    rename(state, text);
}

fn note_spec(text: str) -> any {
    map()
        .with("full", true)
        .with("height", 0)
        .with("controls", [
            map()
                .with("kind", "label")
                .with("role", "text_caption")
                .with("grow", 1)
                .with("wrap", true)
                .with("text", text),
        ])
}

fn color_specs(state: editor::State, doc: any, out: [any]) {
    let row_height = style::row_h(state);
    let mine = editable(state);
    let stated = util::obj(doc.colors);
    let colors = state.theme.colors;
    let ground = if colors.get(GROUND).is_nil() { "#000000" } else { colors.get(GROUND).as_str() };
    let names = SOURCES();
    for token in sorted_keys(colors) {
        if !util::contains(SOURCES(), token) {
            names.push(token);
        }
    }
    for name in names {
        let hex = if colors.get(name).is_nil() { "#000000" } else { colors.get(name).as_str() };
        // A stated token reads as the theme's own; a derived one is quieter.
        let own = stated.has(name);
        out.push(map()
            .with("full", false)
            .with("height", row_height)
            .with("slot_role", "layout_actions")
            .with("controls", [
                map()
                    .with("kind", "color_picker")
                    .with("width", 34)
                    .with("picked_color", rgba_of(hex))
                    .with("enabled", mine)
                    .with("on", "handle")
                    .with("data", map().with("fn", on_color_picked).with("name", name)),
                map()
                    .with("kind", "text_field")
                    .with("role", "input_form")
                    .with("width", 96)
                    .with("text", hex)
                    .with("enabled", mine)
                    .with("on_submit", "handle_submit")
                    .with("data", map().with("submit", on_hex_submitted).with("name", name)),
                map()
                    .with("kind", "label")
                    .with("role", "text_caption")
                    .with("grow", 1)
                    .with("text", if is_hex(hex) && is_hex(ground) {
                        let derived = if own { "" } else { "derived  ·  " };
                        "{derived}{util::fixed(ui::contrast(hex, ground), 2)}:1 on {GROUND}"
                    } else {
                        ""
                    }),
            ])
            .with("label", name)
            .with("label_role", if own { "text_label" } else { "text_caption" }));
    }
}

fn on_color_picked(state: &mut editor::State, data: any, rgba: any) {
    edit(state, ["colors"], data.name.as_str(), util::to_hex(rgba_list(rgba)));
}

// A picked colour, as the four numbers `to_hex` reads.
fn rgba_list(rgba: any) -> [float] {
    [rgba[0].as_float(), rgba[1].as_float(), rgba[2].as_float(), if rgba.len() > 3 { rgba[3].as_float() } else { 1.0 }]
}

fn on_hex_submitted(state: &mut editor::State, data: any, text: any) {
    edit_hex(state, data.name.as_str(), text.as_str());
}

fn size_specs(state: editor::State, doc: any, out: [any]) {
    let row_height = style::row_h(state);
    let mine = editable(state);
    let stated = util::obj(doc.sizes);
    for name in sorted_keys(state.theme.sizes) {
        out.push(map()
            .with("full", false)
            .with("height", row_height)
            .with("slot_role", "layout_actions")
            .with("controls", [
                map()
                    .with("kind", "number_field")
                    .with("role", "input_number")
                    .with("width", 96)
                    .with("value", state.theme.get("sizes").get(name).as_float())
                    .with("min", 0.0)
                    .with("max", 200.0)
                    .with("drag_speed", 1.0)
                    .with("enabled", mine)
                    .with("on", "handle")
                    .with("data", map().with("fn", on_size_changed).with("name", name)),
            ])
            .with("label", name)
            .with("label_role", if stated.has(name) { "text_label" } else { "text_caption" }));
    }
}

fn on_size_changed(state: &mut editor::State, data: any, value: any) {
    edit(state, ["sizes"], data.name.as_str(), whole(value));
}

fn rgba_of(hex: str) -> [float] {
    let color = util::hex_to_rgb(hex);
    [color.red, color.green, color.blue, 1.0]
}

fn is_hex(text: str) -> bool {
    if text.len() != 7 || !text.starts_with("#") {
        return false;
    }
    for digit in text.slice(1, text.len()).chars() {
        if !"0123456789abcdefABCDEF".contains(digit) {
            return false;
        }
    }
    true
}

fn edit_hex(state: &mut editor::State, name: str, text: str) {
    if is_hex(text) {
        edit(state, ["colors"], name, text.to_lower());
    } else {
        state.themewin.said = "'{text}' is not a #rrggbb color";
    }
}

fn table_at(doc: any, path: [str]) -> any {
    let table = util::obj(doc);
    for part in path {
        if !(table.has(part) && table.get(part).kind() == "map") {
            return map();
        }
        table = table.get(part);
    }
    table
}

fn same_path(first: [str], second: [str]) -> bool {
    if first.len() != second.len() {
        return false;
    }
    for index in 0..first.len() {
        if first[index] != second[index] {
            return false;
        }
    }
    true
}

fn pick(state: &mut editor::State, path: [str]) {
    let again = same_path(state.themewin.path, path);
    let next = if again { [] } else { path };
    state.themewin.path = next;
    state.themewin.table = "";
}

fn height_of(state: editor::State, table: any) -> float {
    let row_height = style::row_h(state);
    let own = style::px(state, table.get("height").as_float());
    util::max(row_height, own + 4.0)
}

/// What a table states in a line: a layout role's air, or a kind's frame.
fn summary(table: any) -> str {
    let out = "";
    for key in KEYS() {
        if table.has(key) && !(table.get(key).kind() == "map") {
            let part = "{key} {table.get(key)}";
            out = if out == "" { part } else { out + "  ·  " + part };
        }
    }
    if out == "" { "nothing stated" } else { out }
}

/// The entry drawn as itself: a text role as a label in it, a control or a
/// box as a button wearing it, and layout as the numbers it states.
fn sample(state: editor::State, name: str, path: [str], table: any) -> any {
    let page = if path.len() == 2 { page_of(name) } else { "kinds" };
    if page == "layout" || page == "kinds" {
        return map().with("kind", "label").with("role", "text_caption").with("grow", 1).with("text", summary(table));
    }
    if page == "text" {
        return map().with("kind", "label").with("role", name).with("grow", 1).with("text", name);
    }
    map().with("kind", "button").with("role", name).with("width", 200).with("text", name).with("on", "handle").with("data", map().with("fn", on_sample_clicked).with("path", path))
}

fn on_sample_clicked(state: &mut editor::State, data: any, _value: any) {
    let path: [str] = data.path;
    pick(state, path);
}

fn entry_specs(state: editor::State, doc: any, path: [str], out: [any]) {
    let name = path[path.len() - 1];
    let table = table_at(doc, path);
    let picked = same_path(state.themewin.path, path);
    out.push(map()
        .with("full", false)
        .with("height", height_of(state, table))
        .with("slot_role", "layout_actions")
        .with("controls", [
            sample(state, name, path, table),
            map()
                .with("kind", "button")
                .with("role", "chip")
                .with("checked", picked)
                .with("text", if picked { "editing" } else { "edit" })
                .with("on", "handle")
                .with("data", map().with("fn", on_edit_clicked).with("path", path)),
        ])
        .with("label", name));
    if picked {
        inspector_specs(state, doc, path, out);
    }
}

fn on_edit_clicked(state: &mut editor::State, data: any, _value: any) {
    let path: [str] = data.path;
    pick(state, path);
}

fn state_chips(state: editor::State, table: any) -> [any] {
    let bare = state.themewin.table == "";
    let chips = [
        map()
            .with("kind", "button")
            .with("role", "chip")
            .with("checked", bare)
            .with("text", "role")
            .with("on", "handle")
            .with("data", map().with("fn", on_role_chip_clicked)),
    ];
    for name in STATES() {
        let word = name;
        let there = table.has(word) && table.get(word).kind() == "map";
        let on = state.themewin.table == word;
        chips.push(map()
            .with("kind", "button")
            .with("role", if there || on { "chip" } else { "chip_quiet" })
            .with("checked", on)
            .with("text", if there { word } else { "+ " + word })
            .with("tooltip", if there { "Edit the table this state uses" } else { "Nothing stated for this state yet" })
            .with("on", "handle")
            .with("data", map().with("fn", on_state_chip_clicked).with("word", word)));
    }
    chips
}

fn on_role_chip_clicked(state: &mut editor::State, data: any, _value: any) {
    state.themewin.table = "";
}

fn on_state_chip_clicked(state: &mut editor::State, data: any, _value: any) {
    let word: str = data.word;
    state.themewin.table = word;
}

fn inspector_specs(state: editor::State, doc: any, path: [str], out: [any]) {
    let row_height = style::row_h(state);
    let mine = editable(state);
    let role_table = table_at(doc, path);
    out.push(map()
        .with("full", false)
        .with("height", row_height)
        .with("slot_role", "layout_actions")
        .with("controls", state_chips(state, role_table))
        .with("label", "  table"));
    let at = copy_path(path);
    if state.themewin.table != "" {
        at.push(state.themewin.table);
    }
    let table = table_at(doc, at);
    let own_table = table_at(state.themewin.own, at);
    let missing: [str] = [];
    for key in KEYS() {
        if table.has(key) && !(table.get(key).kind() == "map") {
            out.push(key_spec(state, doc, at, key, table.get(key), own_table.has(key), mine));
        } else {
            missing.push(key);
        }
    }
    if mine && missing.len() > 0 {
        out.push(map()
            .with("full", false)
            .with("height", row_height)
            .with("controls", [
                map()
                    .with("kind", "dropdown")
                    .with("role", "choice_form")
                    .with("width", 200)
                    .with("text", "add a key…")
                    .with("options", missing)
                    .with("on", "handle")
                    .with("data", map().with("fn", on_key_added).with("at", at)),
            ])
            .with("label", "  add"));
    }
    if path.len() == 2 {
        let who = if state.themewin.table == "" { path[1] } else { path[1] + "." + state.themewin.table };
        for pair in util::vec(state.themewin.pairs) {
            if pair.role.as_str() == who {
                let verdict = if pair.ratio.as_float() >= pair.need.as_float() { "reads at AA" } else { "needs {pair.need}" };
                out.push(note_spec("{pair.ink.as_str()} on {pair.fill.as_str()}: {util::fixed(pair.ratio.as_float(), 2)}:1, {verdict}"));
            }
        }
    }
}

fn copy_path(items: [str]) -> [str] {
    let out: [str] = [];
    for item in items {
        out.push(item);
    }
    out
}

fn on_key_added(state: &mut editor::State, data: any, picked: any) {
    let at: [str] = data.at;
    edit(state, at, picked.as_str(), default_of(picked));
}

fn key_spec(state: editor::State, doc: any, at: [str], key: str, value: any, stated: bool, mine: bool) -> any {
    let controls = control_for(state, doc, at, key, value, mine);
    if mine && stated {
        controls.push(map()
            .with("kind", "button")
            .with("role", "chip_quiet")
            .with("text", "×")
            .with("tooltip", "Back to the base theme's value")
            .with("on", "handle")
            .with("data", map().with("fn", on_key_cleared).with("at", at).with("key", key)));
    }
    // A key this theme states reads as its own; one it leaves to its base is
    // quieter, so what the file says stands out from what it inherits.
    map()
        .with("full", false)
        .with("height", h_of(state))
        .with("slot_role", "layout_actions")
        .with("controls", controls)
        .with("label", "  " + key)
        .with("label_role", if stated || !mine { "text_label" } else { "text_caption" })
}

fn on_key_cleared(state: &mut editor::State, data: any, _value: any) {
    let at: [str] = data.at;
    let key: str = data.key;
    clear(state, at, key);
}

fn h_of(state: editor::State) -> float {
    style::row_h(state)
}

fn words_of(state: editor::State, key: str, value: any) -> [str] {
    if key == "font" {
        sorted_keys(state.theme.get("fonts"))
    } else if key == "text_align" {
        ["start", "center", "end"]
    } else if value.kind() == "str" && key_listed(key, SIZE_KEYS()) {
        let names = sorted_keys(state.theme.get("sizes"));
        if key == "corner_radius" {
            names.push("full");
        }
        names
    } else {
        []
    }
}

fn key_listed(key: str, items: [str]) -> bool {
    for listed in items {
        if listed == key {
            return true;
        }
    }
    false
}

fn control_for(state: editor::State, doc: any, at: [str], key: str, value: any, mine: bool) -> [any] {
    if key_listed(key, COLOR_KEYS()) {
        let resolved = state.theme.get("colors").get(value);
        let hex = if resolved.is_nil() { value } else { resolved };
        let options = sorted_keys(state.theme.get("colors"));
        return [
            map()
                .with("kind", "color_picker")
                .with("width", 34)
                .with("picked_color", rgba_of((if is_hex(hex.as_str()) { hex } else { "#000000" }).as_str()))
                .with("enabled", mine)
                .with("on", "handle")
                .with("data", map().with("fn", on_key_color_picked).with("at", at).with("key", key)),
            map()
                .with("kind", "dropdown")
                .with("role", "choice_form")
                .with("grow", 1)
                .with("text", "{value}")
                .with("options", options)
                .with("enabled", mine)
                .with("on", "handle")
                .with("data", map().with("fn", on_key_color_name_picked).with("at", at).with("key", key)),
        ];
    }
    let words = words_of(state, key, value);
    if words.len() > 0 {
        return [
            map()
                .with("kind", "dropdown")
                .with("role", "choice_form")
                .with("grow", 1)
                .with("text", "{value}")
                .with("options", words)
                .with("enabled", mine)
                .with("on", "handle")
                .with("data", map().with("fn", on_key_word_picked).with("at", at).with("key", key)),
        ];
    }
    if value.kind() == "int" || value.kind() == "float" {
        return [
            map()
                .with("kind", "number_field")
                .with("role", "input_number")
                .with("grow", 1)
                .with("value", value.as_float())
                .with("min", 0.0)
                .with("max", 2000.0)
                .with("drag_speed", 1.0)
                .with("enabled", mine)
                .with("on", "handle")
                .with("data", map().with("fn", on_key_number_changed).with("at", at).with("key", key)),
        ];
    }
    let typed = [
        map()
            .with("kind", "text_field")
            .with("role", "input_form")
            .with("grow", 1)
            .with("text", "{value}")
            .with("enabled", mine)
            .with("on_submit", "handle_submit")
            .with("data", map().with("submit", on_key_text_submitted).with("at", at).with("key", key)),
    ];
    typed
}

fn on_key_color_picked(state: &mut editor::State, data: any, rgba: any) {
    let at: [str] = data.at;
    edit(state, at, data.key.as_str(), util::to_hex(rgba_list(rgba)));
}

fn on_key_color_name_picked(state: &mut editor::State, data: any, picked: any) {
    let at: [str] = data.at;
    let key: str = data.key;
    edit(state, at, key, picked);
}

fn on_key_word_picked(state: &mut editor::State, data: any, picked: any) {
    let at: [str] = data.at;
    let key: str = data.key;
    edit(state, at, key, picked);
}

fn on_key_number_changed(state: &mut editor::State, data: any, value: any) {
    let at: [str] = data.at;
    let key: str = data.key;
    edit(state, at, key, whole(value));
}

fn on_key_text_submitted(state: &mut editor::State, data: any, text: any) {
    let at: [str] = data.at;
    let key: str = data.key;
    edit(state, at, key, text);
}

/// A number as a file would spell it: whole ones without the `.0`.
fn whole(value: any) -> any {
    let number = value.as_float();
    let out: any = number;
    if ((number as int) as float) == number {
        out = number as int;
    }
    out
}

fn default_of(key: any) -> any {
    if key_value_listed(key, COLOR_KEYS()) {
        return if key.as_str() == "text_color" { "text_default" } else { "bg_panel" };
    }
    if key.as_str() == "font" {
        return "default";
    }
    if key.as_str() == "text_align" {
        return "start";
    }
    if key.as_str() == "font_weight" {
        return 700;
    }
    if key.as_str() == "font_size" { "font_size" } else { 0 }
}

fn key_value_listed(key: any, items: [str]) -> bool {
    for candidate in items {
        if candidate == key.as_str() {
            return true;
        }
    }
    false
}

fn problem_specs(state: editor::State, out: [any]) {
    let found = problems(state);
    if found.len() == 0 {
        out.push(note_spec("Every role's text reads at WCAG AA on its fill: 4.5:1, or 3:1 from 18 px or 14 px bold."));
        return;
    }
    let row_height = style::row_h(state);
    for pair in found {
        let parts = pair.role.as_str().split(".");
        let name = parts[0];
        let table = if parts.len() > 1 { parts[1] } else { "" };
        out.push(map()
            .with("full", false)
            .with("height", row_height)
            .with("slot_role", "layout_actions")
            .with("controls", [
                map()
                    .with("kind", "label")
                    .with("role", "text_caption")
                    .with("grow", 1)
                    .with("text", "{pair.ink.as_str()} on {pair.fill.as_str()}: {util::fixed(pair.ratio.as_float(), 2)}:1, needs {pair.need}"),
                map()
                    .with("kind", "button")
                    .with("role", "chip")
                    .with("text", "edit")
                    .with("on", "handle")
                    .with("data", map().with("fn", on_problem_edit_clicked).with("name", name).with("table", table)),
            ])
            .with("label", pair.get("role").as_str()));
    }
}

fn on_problem_edit_clicked(state: &mut editor::State, data: any, _value: any) {
    let name: str = data.name;
    let table: str = data.table;
    show_role(state, name, table);
}

/// Turn to the page a role is on, picked, at one of its state tables.
pub fn show_role(state: &mut editor::State, name: str, table: str) {
    state.themewin.page = page_of(name);
    state.themewin.path = ["roles", name];
    state.themewin.table = table;
}

/// Write one key of the person's theme and wear the result. A bundled theme
/// has no `own`, so nothing is written.
pub fn edit(state: &mut editor::State, path: [str], key: str, value: any) {
    let own: any = state.themewin.own;
    if util::is_nil(own) {
        return;
    }
    let table: any = own;
    for part in path {
        if !(table.has(part) && table.get(part).kind() == "map") {
            table.set(part, map());
        }
        table = table.get(part);
    }
    table.set(key, value);
    changed(state);
}

fn clear(state: &mut editor::State, path: [str], key: str) {
    let own: any = state.themewin.own;
    if util::is_nil(own) {
        return;
    }
    let table = table_at(own, path);
    if table.has(key) {
        table.remove(key);
    }
    changed(state);
}

fn changed(state: &mut editor::State) {
    state.themewin.dirty = true;
    state.themewin.said = "";
    let own: any = state.themewin.own;
    let doc = theme::merge(theme::bundled(theme::base_of(own), state.theme.get("half").as_str()), own);
    theme::wear(state, state.theme.get("name").as_str(), doc);
    let pairs = ui::contrast_pairs(doc, GROUND);
    state.themewin.pairs = pairs;
}

fn rebase(state: &mut editor::State, picked: any) {
    let own: any = state.themewin.own;
    if util::is_nil(own) {
        return;
    }
    own.set("base", picked);
    changed(state);
}

/// Wear another theme, remembered as the setting.
pub fn choose(state: &mut editor::State, name: str) {
    settings::set(theme::SETTING, name);
    settings::commit_prefs(state);
    theme::use_named(state, name);
    load_own(state);
    state.themewin.said = "";
}

/// Write the worn half of the person's theme: only what differs from the same
/// half of its base, under the base it names.
pub fn save(state: &mut editor::State) {
    let own: any = state.themewin.own;
    if util::is_nil(own) {
        return;
    }
    let half = state.theme.get("half").as_str();
    let base_name = theme::base_of(own);
    let base = theme::bundled(base_name, half);
    let out = theme::diff(base, theme::merge(base, own));
    out.set("type", "widget_theme");
    out.set("base", base_name);
    fs::create_directory(theme::folder_of(state.theme.get("name").as_str()));
    fs::write(theme::path_of(state.theme.get("name").as_str(), half), toml::encode(out));
    state.themewin.own = out;
    state.themewin.dirty = false;
    state.themewin.said = "Saved themes/{state.theme.get("name")}/{half}.toml";
}

fn revert(state: &mut editor::State) {
    theme::reload(state);
    load_own(state);
    state.themewin.said = "";
}

/// A name for a copy nobody has used: `balaur-custom`, then `balaur-custom-2`.
fn fresh_name(from: str) -> str {
    let stem = if theme::is_bundled(from) { from + "-custom" } else { from + "-copy" };
    let taken = theme::names();
    let name = stem;
    let suffix = 2;
    while name_taken(name, taken) {
        name = "{stem}-{suffix}";
        suffix += 1;
    }
    name
}

fn name_taken(name: str, items: [any]) -> bool {
    for existing in items {
        if existing.as_str() == name {
            return true;
        }
    }
    false
}

/// Copy the worn theme into the themes folder and wear the copy. A bundled one
/// becomes a folder whose worn half names it as its base and nothing else.
pub fn duplicate(state: &mut editor::State) -> str {
    let from = state.theme.get("name").as_str();
    let name = fresh_name(from);
    fs::create_directory(theme::folder_of(name));
    for half in theme::HALVES() {
        let copy = if !theme::is_bundled(from) {
            theme::read(from, half)
        } else if half == state.theme.half.as_str() {
            map().with("base", from)
        } else {
            nil
        };
        if copy.kind() == "map" {
            copy.set("type", "widget_theme");
            fs::write(theme::path_of(name, half), toml::encode(copy));
        }
    }
    choose(state, name);
    state.themewin.said = "Duplicated " + from + " as " + name;
    name
}

fn rename(state: &mut editor::State, text: any) {
    let old = state.theme.get("name").as_str();
    let name = text.trim();
    let bad = name == "" || name.contains("/") || name.contains(".");
    if bad || theme::is_bundled(name) || name_taken(name, theme::names()) {
        state.themewin.said = "'{text}' is not a name a new theme folder can take";
        return;
    }
    if state.themewin.dirty {
        save(state);
    }
    fs::rename(theme::folder_of(old), theme::folder_of(name));
    choose(state, name);
    state.themewin.said = "Renamed " + old + " to " + name;
}

/// Remove the worn theme's folder, both halves, and go back to its base.
pub fn remove(state: &mut editor::State) {
    let own: any = state.themewin.own;
    if util::is_nil(own) {
        return;
    }
    let back = theme::base_of(own);
    fs::remove(theme::folder_of(state.theme.get("name").as_str()));
    choose(state, back);
}
