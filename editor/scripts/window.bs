// A sheet over the shell: a title, a close, and a body. What the settings
// screen is, and what anything else needing a window should be.

use about;
use disk;
use editor;
use exporter;
use fonts;
use icons;
use left;
use manager;
use newnode;
use palette;
use populate;
use settings;
use shell;
use signals;
use style;
use themewin;
use util;
use words::command;
use words::fields;
use words::form_fields;
use words::layout_fields;
use words::roles;

const MANAGER_NEW: str = "manager-new";
const OPEN: str = "open";
const WIDGET_WINDOW: str = "widget_window";

pub struct Size {
    width: float,
    height: float,
}

pub class WindowState {
    open: str,
    internal demo: int,
}

pub struct Hosts {
    internal form: str,
}

// Sized as a fraction of the screen rather than in pixels, so the same sheet
// suits a laptop and a monitor. Bounded, so it never fills a huge display
// edge to edge nor shrinks below what a form needs.
const WIDTH_FRACTION: float = 0.62;

const HEIGHT_FRACTION: float = 0.74;

const MIN_WIDTH: float = 640.0;

const MAX_WIDTH: float = 1100.0;

const MIN_HEIGHT: float = 420.0;

// What a sheet leaves of the screen around itself, so it reads as a sheet
// over the shell rather than a second shell.
const MARGIN: float = 16.0;

/// A sheet's own box. The floor is what a form needs and the screen is what
/// there is: on a phone the second wins, less the margin around it.
pub fn size(state: editor::State) -> Size {
    let screen = ui::window_size();
    let room = math::max(screen.x - 2.0 * MARGIN, 240.0);
    let tall = math::max(screen.y - 2.0 * MARGIN, 200.0);
    Size {
        width: math::min(math::clamp(screen.x * WIDTH_FRACTION, MIN_WIDTH, MAX_WIDTH), room),
        height: math::min(math::clamp(screen.y * HEIGHT_FRACTION, MIN_HEIGHT, screen.y - 120.0), tall),
    }
}

/// What a sheet leaves inside itself: what a body measures its columns
/// against, since a row with no stated width reads the whole layer instead.
pub fn inner_width(state: editor::State) -> float {
    math::max(size(state).width - 2.0 * padding(state), 120.0)
}

// The air a sheet keeps inside its edge, as its role states it.
fn padding(state: editor::State) -> float {
    style::role_size_in_pixels(state, roles::SHEET_DIALOG, layout_fields::PADDING, 18.0)
}

/// Every open window, so one place decides what is on top and `esc` has
/// something to close.
pub fn state() -> WindowState {
    WindowState { open: "", demo: -1 }
}

/// Put the screen `id` up, which fills the sheet at the next word.
pub fn show(state: &mut editor::State, id: str) {
    state.window.open = id;
    changed(state);
}

pub fn hide(state: &mut editor::State) {
    state.window.open = "";
    let filled = scene::root().get_node(SHEET);
    if filled.is_valid() {
        filled.widget_window.open = false;
    }
}

pub fn showing(state: editor::State, id: str) -> bool {
    state.window.open == id
}

/// What the screen up shows moved: the word its sheet fills on.
pub fn changed(state: &mut editor::State) {
    signals::changed(state, roles::SHEET);
}

const SHEET: str = "Editor/Sheet";

/// Fill whichever screen is up: what the sheet's script asks for.
pub fn fill(state: &mut editor::State) {
    if state.window.open == command::SETTINGS {
        settings::fill(state);
    } else if state.window.open == command::THEME {
        themewin::fill(state);
    } else if state.window.open == command::EXPORT {
        exporter::fill(state);
    } else if state.window.open == command::ABOUT {
        about::fill(state);
    } else if state.window.open == command::POPULATE {
        populate::fill(state);
    } else if state.window.open == MANAGER_NEW {
        manager::new_fill(state);
    } else if state.window.open == disk::SHEET {
        disk::fill(state);
    }
}

/// The sheet shut itself, on Escape or a click on the dim: the screen that
/// was up is not any more.
pub fn closed(state: &mut editor::State) {
    if state.window.open != "" && util::property(SHEET, WIDGET_WINDOW, OPEN).as_bool() == false {
        state.window.open = "";
    }
}

/// A dialog's head, which `header_dialog` lays out: its name, the commands it
/// carries, and `close`, a button carrying the caller's handler.
pub fn head(title: str, actions: [ui::Control], close: ui::Control) -> [ui::Control] {
    let out: [ui::Control] = [
        ui::Control { kind: ui::WIDGET_LABEL, role: roles::TEXT_TITLE_DIALOG, text: title },
        ui::Control { kind: ui::WIDGET_ROW, grow: 1 },
    ];
    for one in actions {
        out.push(one);
    }
    close.kind = ui::WIDGET_BUTTON;
    close.role = roles::ICON_ACTION;
    close.text = "";
    close.icon = icons::ui(icons::CLOSE);
    close.tooltip = CLOSE;
    out.push(close);
    out
}

const CLOSE: str = "Close";


/// The hosts a screen fills: its own column down the left, and the rows
/// beside it. Opens the sheet for `id`, with `actions`, control specs, beside
/// its close; `()` when another screen is up.
pub fn sheet_form(state: &mut editor::State, id: str, title: str, actions: [ui::Control]) -> Hosts? {
    if !showing(state, id) {
        return nil;
    }
    let box = size(state);
    let filled = scene::root().get_node(SHEET);
    if filled.is_valid() {
        filled.widget_window.open = true;
        filled.widget.width = box.width;
        filled.widget.height = box.height;
    }
    scene::root().get_node(SHEET + "/SheetBar/Title").widget.text = title;
    ui::fill_strip(SHEET + "/SheetBar/Actions", actions);
    // Shut by the asking: a screen with no sidebar leaves it alone, and one
    // that fills it shows it. Hidden, the rows beside it take the whole sheet.
    util::hide(SIDE);
    Hosts { form: FORM }
}

/// Show the sheet's sidebar with `rows`, the one keyed `lit` lit, and its
/// search field holding `query` where the screen has one; nil hides it. No
/// rows hides the sidebar.
pub fn sheet_side(rows: [ui::Item], lit: str, query: str?) {
    let side = scene::root().get_node(SIDE);
    side.set_visible(rows.len() > 0);
    let pages = side.get_node(PAGES);
    pages.widget_rows.items = rows;
    pages.widget.text = lit;
    let search = side.get_node(SEARCH);
    search.set_visible(query != nil);
    if query != nil && search.widget.text != query.unwrap() {
        search.widget.text = query.unwrap();
    }
}

/// A page of the sheet's sidebar picked, for the screen that is up.
pub fn side_picked(state: &mut editor::State, key: str) {
    if state.window.open == command::SETTINGS {
        settings::side_picked(state, key);
    } else if state.window.open == command::THEME {
        themewin::side_picked(state, key);
    }
}

/// What was typed in the sidebar's search, for the screen that is up.
pub fn side_searched(state: &mut editor::State, text: str) {
    if state.window.open == command::SETTINGS {
        settings::searched(state, text);
    }
}

/// Hold the sheet to its head and `rows` rows of `role`, for a question with
/// no form to make room for. Called after `sheet_form`, which sizes it for a form.
pub fn fit(state: editor::State, rows: int, role: str) {
    let head = style::role_size_in_pixels(state, roles::HEADER_DIALOG, layout_fields::HEIGHT, 30.0);
    // The sheet's air, under its head and taken again between the rows.
    let gap = style::role_size_in_pixels(state, roles::SHEET_DIALOG, layout_fields::GAP, 10.0);
    let row = style::role_size_in_pixels(state, role, layout_fields::HEIGHT, 24.0);
    let filled = scene::root().get_node(SHEET);
    if filled.is_valid() {
        filled.widget.height = 2.0 * padding(state) + head + (rows as float + 1.0) * gap + (rows as float) * row;
    }
}

const SIDE: str = "Editor/Sheet/SheetBody/SheetSplit/SheetSide";

// The sidebar's search, and its pages under it.
const SEARCH: str = "Search";

const PAGES: str = "Pages";


const FORM: str = "Editor/Sheet/SheetBody/SheetSplit/SheetScroll/SheetForm";

// A query and what it matches, over everything: the command palette, the
// node picker, rename and the font catalogue take turns on it, since only
// one of them is ever up.
const PICKER: str = "Editor/Picker";

// The picker's parts: its head and field, the rows, what it says in their
// place, and rename's command.
const HEAD: str = "PickerHead";

const QUERY: str = "Query";

const LIST: str = "List";

const NOTE: str = "Note";

const APPLY: str = "Apply";

const ROW_HEIGHT: str = "row_height";

/// Shut the picker, for the screen that was using it.
pub fn picker_shut(state: &mut editor::State) {
    let filled = scene::root().get_node(PICKER);
    if filled.is_valid() {
        filled.widget_window.open = false;
    }
    state.picker_focused = false;
}

/// Open the picker over `rows`, the one keyed `lit` lit; `note` is said in
/// their place where there are none.
///
/// `options` names the glyph before the query, the `placeholder` behind it,
/// the `query` itself and a `width` over its role's. What is typed goes to
/// `picker_typed`, and a row picked to `picker_picked` with its key.
pub fn picker(state: &mut editor::State, options: any, rows: [ui::Item], lit: str, note: str) {
    let screen = ui::window_size();
    // One width, taken from the screen: a phone is narrower than what a
    // laptop gets, and every column inside is measured off what is left.
    let asked = options[layout_fields::WIDTH];
    let wanted = if asked == nil { style::role_size_in_pixels(state, roles::SHEET_PICKER, layout_fields::WIDTH, 520.0) } else { asked.as_float() };
    let width = math::min(wanted, math::max(screen.x - 32.0, 240.0));
    let filled = scene::root().get_node(PICKER);
    if !filled.is_valid() {
        return;
    }
    filled.widget_window.open = true;
    filled.widget.width = width;
    let head = filled.get_node(HEAD);
    head.get_node("Mark").widget.text = ui::glyph(options[fields::MARK].as_str());
    let query = head.get_node(QUERY);
    let text = options[form_fields::QUERY].as_str();
    // Written only when it moved: what was just typed is already there.
    if query.widget.text != text {
        query.widget.text = text;
    }
    query.widget_field.placeholder = options[form_fields::PLACEHOLDER].as_str();
    let list = filled.get_node(LIST);
    list.set_visible(rows.len() > 0);
    list.widget_rows.items = rows;
    list.widget.text = lit;
    list.widget.height = math::min(math::max(screen.y * 0.5, 160.0), picker_rows_height(state, rows.len()));
    let said = filled.get_node(NOTE);
    said.set_visible(note != "");
    said.widget.text = note;
    filled.get_node(APPLY).set_visible(false);
    // The field takes the caret the frame the picker opens, and keeps it: a
    // search box you have to click into is one you may as well not have.
    if !state.picker_focused {
        ui::set_focus(query);
        state.picker_focused = true;
    }
}

/// Show the picker's one command under its field, for a screen that types a
/// value rather than picking a row: rename.
pub fn picker_apply() {
    scene::root().get_node(PICKER + "/" + APPLY).set_visible(true);
}

/// The centre of the picker's row `index`, in design px, as drawn; empty
/// before the list has drawn.
pub fn picker_row_spot(state: editor::State, index: int) -> [float] {
    list_row_spot(state, PICKER + "/" + LIST, roles::LIST_PICKER, index)
}

/// The centre of the sheet sidebar's row `index`, the same way.
pub fn side_row_spot(state: editor::State, index: int) -> [float] {
    list_row_spot(state, SIDE + "/" + PAGES, roles::LIST_SIDEBAR, index)
}

// The centre of row `index` of the list at `path`, whose rows `role` sizes.
fn list_row_spot(state: editor::State, path: str, role: str, index: int) -> [float] {
    let rect = ui::widget_rect(scene::root().get_node(path));
    if rect == nil {
        return [];
    }
    let box = rect.unwrap();
    let row = style::role_size_in_pixels(state, role, ROW_HEIGHT, 30.0);
    return [box.x + box.width / 2.0, box.y + row * ((index as float) + 0.5)];
}

// How tall `count` of the picker's rows stand: the most its list is given.
fn picker_rows_height(state: editor::State, count: int) -> float {
    (count as float) * style::role_size_in_pixels(state, roles::LIST_PICKER, ROW_HEIGHT, 30.0)
}

/// What was typed in the picker, for whichever of its screens is up.
pub fn picker_typed(state: &mut editor::State, text: str) {
    if state.palette {
        palette::typed(state, text);
    } else if state.newnode {
        newnode::typed(state, text);
    } else if state.renaming {
        left::rename_typed(state, text);
    } else if fonts::finding(state) {
        fonts::typed(state, text);
    }
}

/// Enter in the picker's field.
pub fn picker_submitted(state: &mut editor::State, text: str) {
    if state.palette {
        palette::submitted(state, text);
    } else if state.newnode {
        newnode::typed(state, text);
    } else if state.renaming {
        left::rename_submitted(state, text);
    } else if fonts::finding(state) {
        fonts::typed(state, text);
    }
}

/// A row of the picker picked, by its key, for whichever of its screens is up.
pub fn picker_picked(state: &mut editor::State, key: str) {
    if state.palette {
        palette::picked(state, key);
    } else if state.newnode {
        newnode::picked(state, key);
    } else if fonts::finding(state) {
        fonts::picked(state, key);
    }
}

/// What the picker shows moved: the word its script fills on.
pub fn picker_changed(state: &mut editor::State) {
    signals::changed(state, "picker");
}

/// Fill whichever of the palette, the node picker and rename is up.
pub fn picker_fill(state: &mut editor::State) {
    if state.palette {
        palette::fill(state);
    } else if state.newnode {
        newnode::fill(state);
    } else if state.renaming {
        left::rename_fill(state);
    } else if fonts::finding(state) {
        fonts::fill(state);
    }
}

/// The picker shut itself, on Escape or a click on the dim.
pub fn picker_closed(state: &mut editor::State) {
    if util::property(PICKER, WIDGET_WINDOW, OPEN).as_bool() != false {
        return;
    }
    if state.palette {
        shell::close_palette(state);
    } else if state.newnode {
        newnode::close(state);
    } else if state.renaming {
        left::rename_close(state);
    } else if fonts::finding(state) {
        fonts::close(state);
    }
}
