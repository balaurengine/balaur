// The completion popup in the Script workspace: what may be typed at the caret,
// under the caret, from the same `script::complete` an editor outside Balaur
// reaches through `balaur lsp`.

use crate::util;

// The list's rows, in design pixels.
const ROW = 22.0;
const MAX_ROWS = 8;

pub fn state() {
    #{
        open: false, items: [], pick: 0, at_index: -1, rel: "",
        x: 0.0, y: 0.0, source: "", hover: (), signature: (),
    }
}

/// The module's own slice of `S`, at `S.complete`.
pub fn reset(S) {
    S.complete.open = false;
    S.complete.items = [];
    S.complete.pick = 0;
    S.complete.at_index = -1;
}

/// The 1-based line and column of a character index into `source`.
pub fn line_col(source, index) {
    let line = 1;
    let col = 1;
    let seen = 0;
    for c in source.chars() {
        if seen >= index {
            break;
        }
        if c == '\n' {
            line += 1;
            col = 1;
        } else {
            col += 1;
        }
        seen += 1;
    }
    (line, col)
}

// The word being typed, so an empty prefix after a space does not open a list
// of every module in the engine.
pub fn prefix_at(source, index) {
    let out = "";
    let seen = 0;
    for c in source.chars() {
        if seen >= index {
            break;
        }
        if c.is_alphanumeric() || c == '_' {
            out.push(c);
        } else {
            out = "";
        }
        seen += 1;
    }
    out
}

// Whether the caret sits right after `::` or `.`, which is where a list opens
// with no prefix typed yet.
fn after_dot(source, index) {
    if index <= 0 {
        return false;
    }
    let chars = source.chars().collect::<Vec>();
    if index > chars.len() {
        return false;
    }
    let last = chars[index - 1];
    if last == '.' {
        return true;
    }
    last == ':' && index >= 2 && chars[index - 2] == ':'
}

/// Ask the host what completes at the caret, and open the list when there is
/// something to show. Called from the code pane once the editor reports one.
pub fn update(S, rel, source, caret) {
    if !(caret is Object) {
        reset(S);
        return;
    }
    let index = caret.index;
    // Same caret, same text: the answer cannot have changed.
    if S.complete.open && S.complete.at_index == index && S.complete.source == source {
        return;
    }
    S.complete.x = caret.x;
    S.complete.y = caret.y;
    S.complete.at_index = index;
    S.complete.source = source;
    S.complete.rel = rel;
    let prefix = prefix_at(source, index);
    if prefix == "" && !after_dot(source, index) {
        S.complete.open = false;
        S.complete.items = [];
        S.complete.hover = ();
        return;
    }
    let (line, col) = line_col(source, index);
    let found = script::complete(rel, source, line, col);
    if !(found is Vec) {
        S.complete.open = false;
        return;
    }
    S.complete.items = found;
    S.complete.pick = 0;
    S.complete.open = found.len() > 0;
    S.complete.signature = script::signature(rel, source, line, col);
}

/// The list's keys while it is up: the arrows move the pick, Enter and Tab
/// accept it, and Escape closes the list.
pub fn key(S, name) {
    if !S.complete.open {
        return;
    }
    let count = S.complete.items.len();
    match name {
        "Down" => S.complete.pick = (S.complete.pick + 1) % count,
        "Up" => S.complete.pick = (S.complete.pick + count - 1) % count,
        "Accept" => accept(S),
        "Tab" => accept(S),
        _ => reset(S),
    }
    crate::signals::changed(S, "complete");
}

/// A row clicked: accept that one.
pub fn pick(S, row) {
    for (i, one) in rows(S).iter().enumerate() {
        if one == row {
            S.complete.pick = i;
            accept(S);
            crate::signals::changed(S, "complete");
            return;
        }
    }
}

// Replace the prefix under the caret with the chosen item.
fn accept(S) {
    let i = S.complete.pick;
    if i < 0 || i >= S.complete.items.len() {
        reset(S);
        return;
    }
    let item = S.complete.items[i];
    let index = S.complete.at_index;
    let prefix = prefix_at(S.complete.source, index);
    let chars = S.complete.source.chars().collect::<Vec>();
    let start = index - prefix.len();
    let head = "";
    let tail = "";
    for (n, c) in chars.iter().enumerate() {
        if n < start {
            head.push(c);
        } else if n >= index {
            tail.push(c);
        }
    }
    let text = head + item.insert + tail;
    let path = S.game_root + "/" + S.complete.rel;
    S.script_buffers[path] = text;
    S.script_dirty[path] = true;
    crate::lint::touched(S);
    crate::signals::bars(S);
    crate::center::code_written(S);
    reset(S);
}

// A row's leading glyph, by what the completion is.
fn glyph(kind) {
    match kind {
        "module" => "◆",
        "function" => "ƒ",
        "method" => "→",
        "constant" => "●",
        "field" => "▪",
        "property" => "▫",
        "keyword" => "k",
        _ => "·",
    }
}

/// The list, under the caret, with the picked entry's doc line under it. One
/// sheet, not two: a second overlay beside this one runs off the pane.
// A row each completion, its mark, its label and its detail.
fn rows(S) {
    let k = S.theme;
    let out = [];
    for one in S.complete.items {
        out.push(util::row(glyph(one.kind), one.label, one.detail, k.text_muted));
    }
    out
}

/// What the list shows: where it opens, under the caret, its rows, the one
/// picked, and the doc line of that one.
pub fn view(S) {
    if !S.complete.open || S.complete.items.len() == 0 {
        return #{ open: false, x: 0.0, y: 0.0 };
    }
    let items = rows(S);
    let pick = util::min(S.complete.pick, items.len() - 1);
    let item = S.complete.items[pick];
    let shown = util::min(S.complete.items.len(), MAX_ROWS);
    #{
        open: true, x: S.complete.x, y: S.complete.y + 4.0, items: items, picked: items[pick],
        list_h: (shown as f64) * ROW, doc: if item.doc == "" { "" } else { clip(item.doc, 78) },
    }
}

// The doc line is one sentence in a 320 px sheet; the rest is in the Docs
// dock, which has room for it.
fn clip(text, n) {
    if text.len() <= n {
        return text;
    }
    let out = "";
    for (i, c) in text.chars().enumerate() {
        if i >= n {
            break;
        }
        out.push(c);
    }
    out + "…"
}
