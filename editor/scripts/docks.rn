// The shell's three docks — left, bottom, right — and the panels in them. A
// panel lives in exactly one dock; its tab menu moves it to another.

use crate::dock;
use crate::icons;
use crate::inspector;
use crate::left;
use crate::style;
use crate::util;

// The bottom dock's handle sits beside the zoom reading, and takes the
// reading's own air, so the pair match across the foot of the stage.
const PAD_X = 6.0;
const PAD_Y = 3.0;

/// A side dock's handle is the tool rail's tile: an icon button on a sheet,
/// with the rail's own inset, so the two sit in one column at one size.
fn tile(S) {
    let m = crate::center::rail_metrics(S);
    m.d + 2.0 * m.pad
}

pub fn sides() {
    ["left", "bottom", "right"]
}

pub fn state() {
    crate::defs::persona_docks("scene")
}

/// Swap the open panels for the ones a persona works with. What is open is
/// the persona's; what may be opened is not, so a panel closed here comes
/// back from the logo menu without changing persona.
pub fn apply_persona(S, id) {
    let want = crate::defs::persona_docks(id);
    for side in sides() {
        // A dock the reader folded away stays folded: the persona says which
        // panels, not whether the sheet is up.
        want[side].shut = S.docks[side].shut;
    }
    S.docks = want;
    // A plugin's dock is in no persona's set: it was adopted when the plugin
    // loaded, and a persona must not unregister it.
    for entry in S.registry.docks {
        adopt(S, entry.id);
    }
}

/// Fold the docks away when the screen cannot hold them beside the stage, and
/// put them back when it can.
///
/// Both axes decide it. A phone on its side is 844 design pixels wide, which
/// is past the line a layout may spread out at, and 390 tall, which is less
/// than the bottom dock and a usable stage need between them.
///
/// Applied on the change, not every frame, so a reader who opens a dock on a
/// phone keeps it open until the screen itself changes.
pub fn follow_screen(S, width, height) {
    S.width_class = width;
    S.height_class = height;
    // A string, since Rune compares no tuples: two words for two answers.
    let key = format!("{} {}", crate::layout::three_fit(S), one_at_a_time(S));
    if S.screen_key == key {
        return;
    }
    S.screen_key = key;
    // Room, not a class word: a phone opens one sheet at a time, a tablet
    // folds the columns and keeps the bottom dock, a laptop keeps all three.
    let only_one = one_at_a_time(S);
    let tight = !crate::layout::three_fit(S);
    for side in ["left", "right", "bottom"] {
        // Into a local first: a field assigned a branch of the loop's own
        // variables is the pitfall AGENTS.md names.
        let fold = if side == "bottom" { only_one } else { only_one || tight };
        S.docks[side].shut = fold;
    }
}

/// Whether only one dock may be open at a time: a screen with less width
/// than two side docks and a stage at their floors, or less height than the
/// bar, a bottom dock and a stage at theirs, holds one sheet and the stage.
pub fn one_at_a_time(S) {
    let (w, h) = crate::layout::floors(S);
    S.screen_w < w || S.screen_h < h
}

/// Open a side dock, folding the other where there is only room for one.
fn unfold(S, side) {
    S.docks[side].shut = false;
    if !one_at_a_time(S) {
        return;
    }
    for other in sides() {
        if other != side {
            S.docks[other].shut = true;
        }
    }
}

/// Every panel the menu can open, in the order it lists them.
pub fn known(S) {
    util::keys_sorted(panels(S))
}

// Where a panel lands when it is opened from the menu rather than moved.
fn homes() {
    #{ scene: "left", outline: "left", inspector: "right", import: "right" }
}

pub fn home(id) {
    homes().get(id).unwrap_or("bottom")
}

/// Name and icon per panel; `tall` asks the bottom dock for its taller size.
/// A plugin's dock joins the table so it moves like everything else.
///
/// Built once a frame: the tab row, the minimised rail and `bottom_tall` all
/// ask, and the outline's own name re-reads every script in the Script persona.
pub fn panels(S) {
    let cache = S.panels;
    if cache is Object && cache.at == S.frame && cache.persona == S.persona {
        return cache.table;
    }
    let table = #{
        "scene": #{ name: "Scene", icon: icons::panel("scene"), tall: false },
        "outline": #{ name: left::outline_title(S), icon: icons::panel("outline"), tall: false },
        "inspector": #{ name: "Inspector", icon: icons::panel("inspector"), tall: false },
        "import": #{ name: "Import", icon: icons::panel("import"), tall: false },
        "output": #{ name: "Output", icon: icons::panel("output"), tall: false },
        "problems": #{ name: "Problems", icon: icons::panel("problems"), tall: false },
        "assets": #{ name: "Assets", icon: icons::panel("assets"), tall: false },
        "docs": #{ name: "Docs", icon: icons::panel("docs"), tall: true },
        "timeline": #{ name: "Timeline", icon: icons::panel("timeline"), tall: true },
        "debugger": #{ name: "Debugger", icon: icons::panel("debugger"), tall: true },
        "session": #{ name: "Session", icon: icons::panel("session"), tall: true },
        "profiler": #{ name: "Profiler", icon: icons::panel("profiler"), tall: true },
        "cost": #{ name: "Cost", icon: icons::panel("cost"), tall: true },
        "library": #{ name: "Library", icon: icons::panel("library"), tall: false },
        "tiles": #{ name: "Tiles", icon: icons::panel("tiles"), tall: true },
        "weights": #{ name: "Weights", icon: icons::panel("weights"), tall: true },
        "bonemap": #{ name: "Bone map", icon: icons::panel("bonemap"), tall: true },
        "statemachine": #{ name: "State machine", icon: icons::panel("statemachine"), tall: true },
    };
    for entry in S.registry.docks {
        table[entry.id] = #{ name: entry.name, icon: icons::panel(entry.id), tall: entry.tall };
    }
    S.panels = #{ at: S.frame, persona: S.persona, table: table };
    table
}

/// Give a panel a home. A plugin's dock joins the bottom one, which is where
/// EDITOR-SCREENS §5 promises one tab per registered plugin; its tab menu
/// moves it from there like any other.
pub fn adopt(S, id) {
    if side_of(S, id).is_some() {
        return;
    }
    S.docks[home(id)].tabs.push(id);
}

/// Take a panel out of its dock. Nothing is destroyed: the logo menu lists
/// every panel whether it is open or not, and puts this one back.
pub fn close(S, id) {
    let side = match side_of(S, id) {
        Some(side) => side,
        None => return,
    };
    let kept = [];
    for t in S.docks[side].tabs {
        if t != id {
            kept.push(t);
        }
    }
    S.docks[side].tabs = kept;
    if S.docks[side].active == id {
        S.docks[side].active = kept.get(0).unwrap_or("");
    }
}

/// Open a closed panel, or close an open one: what the logo menu's rows do.
pub fn toggle(S, id) {
    if side_of(S, id).is_some() {
        close(S, id);
    } else {
        show(S, id);
    }
}

fn panel(S, id) {
    panels(S).get(id).unwrap_or(#{ name: id, icon: icons::panel(id), tall: false })
}

/// What a panel is called, for a menu row outside this module.
pub fn name(S, id) {
    panel(S, id).name
}

/// Which dock holds `id`, or `None` when a plugin has been unloaded.
pub fn side_of(S, id) {
    for side in sides() {
        if S.docks[side].tabs.iter().any(|t| t == id) {
            return Some(side);
        }
    }
    None
}

/// Whether `id` is the panel its dock is showing. Replaces the old
/// `S.dock == "..."`, which assumed everything lived at the bottom.
pub fn showing(S, id) {
    match side_of(S, id) {
        Some(side) => S.docks[side].active == id && !S.docks[side].shut,
        None => false,
    }
}

/// Bring `id` up wherever it lives, opening it and its dock.
///
/// A closed panel is opened first: a tool that cannot be used without its
/// dock says so, rather than leaving the tab to be hunted for.
pub fn show(S, id) {
    adopt(S, id);
    let found = side_of(S, id);
    if let Some(side) = found {
        S.docks[side].active = id;
        unfold(S, side);
    }
}

/// Move a panel to another dock, and leave its old dock showing something.
pub fn move_to(S, id, side) {
    let from = side_of(S, id);
    if let Some(old) = from {
        if old == side {
            return;
        }
        let kept = [];
        for t in S.docks[old].tabs {
            if t != id {
                kept.push(t);
            }
        }
        S.docks[old].tabs = kept;
        if S.docks[old].active == id {
            S.docks[old].active = kept.get(0).unwrap_or("");
        }
    }
    S.docks[side].tabs.push(id);
    S.docks[side].active = id;
    unfold(S, side);
}

/// The taller bottom dock, asked before the layout is computed.
pub fn bottom_tall(S) {
    let d = S.docks.bottom;
    if d.shut || d.active == "" {
        return false;
    }
    panel(S, d.active).tall
}

/// What sits under the right sheet's scroll, whichever panel is up.
const RIGHT_FOOT_NODE = "Editor/Shell/Body/Right/RightSheet/RightFoot";

/// The inspector's foot: one button, filled into the row the scene lays out.
pub fn right_foot(S) {
    let d = S.docks.right;
    if d.shut || d.active != "inspector" {
        crate::pool::hide(RIGHT_FOOT_NODE);
        return;
    }
    crate::pool::strip(S, RIGHT_FOOT_NODE, inspector::foot_controls(S));
}

fn body(S, k, id) {
    match id {
        "scene" => left::tree_body(S, k),
        "outline" => left::outline_body(S, k),
        "inspector" => inspector::body(S, k),
        "import" => crate::importer::panel(S, k),
        "output" => dock::output(S, k),
        "problems" => dock::problems(S, k),
        "assets" => dock::assets(S, k),
        "docs" => crate::docs::draw(S, k),

        "debugger" => dock::debugger_view(S, k),

        "profiler" => dock::profiler(S, k),
        "cost" => dock::cost(S, k),
        "library" => crate::library::panel(S, k),
        "tiles" => crate::tiles::palette(S, k),


        _ => match crate::plugins::dock(S, id) {
            Some(entry) => {
                let draw = entry.draw;
                draw(S, k);
            }
            None => (),
        },
    }
}

// Which panels fill which node. A node keeps drawing until told not to, and
// only the dock owning one may say so: every dock draws each frame, so a
// global hide has one dock turning off another's node.
/// The bottom dock's four painting views, a `draw` node each: whichever is
/// the active panel is shown and the rest are hidden.
fn canvas_views() {
    #{
        timeline: "BottomTimeline",
        session: "BottomSession",
        weights: "BottomWeights",
        bonemap: "BottomBonemap",
        statemachine: "BottomStatemachine",
    }
}

const BOTTOM = "Editor/Shell/Body/Centre/Bottom/";

fn sync_canvas(S, d) {
    let painting = false;
    for (id, name) in canvas_views() {
        let on = !d.shut && d.active == id;
        if on {
            painting = true;
        }
        util::fill(BOTTOM + name, #{ visible: on });
    }
    // The hatch draws whatever panel has no node of its own, so it gives its
    // room up to one that has. A stated height, not just a grow of zero: a
    // `draw` measures what it was last given, not what it drew.
    let owned = painting || owns_a_node(S, "bottom", d);
    util::fill(BOTTOM + "DockBody", #{
        grow: if owned { 0.0 } else { 1.0 },
        height: if owned { 1.0 } else { 0.0 },
    });
}

/// Whether the panel showing has a node of its own, which the shared hatch
/// must then leave the room to.
fn owns_a_node(S, side, d) {
    if d.shut || d.active == "" {
        return false;
    }
    for entry in node_owners()[side] {
        for id in entry.panels {
            if id == d.active {
                return true;
            }
        }
    }
    false
}

fn node_owners() {
    #{
        bottom: [
            #{ hide: "log", panels: ["output", "problems", "docs"] },
            #{ hide: "table", panels: ["cost", "profiler", "library"] },
            #{ hide: "cards", panels: ["assets", "library", "tiles"] },
            #{ hide: "stack", panels: ["debugger"] },
        ],
        left: [
            #{ hide: "tree", panels: ["scene"] },
            #{ hide: "outline", panels: ["outline"] },
        ],
        right: [
            #{ hide: "form", panels: ["inspector", "import"] },
        ],
    }
}

fn hide_node(which) {
    if which == "log" {
        dock::hide_log();
    } else if which == "table" {
        dock::hide_table();
    } else if which == "cards" {
        dock::hide_cards();
    } else if which == "stack" {
        dock::hide_tree();
    } else if which == "tree" {
        left::hide_tree();
    } else if which == "outline" {
        left::hide_outline();
    } else if which == "form" {
        inspector::hide_form();
    }
}

fn hide_unused(S, side, d) {
    if side == "bottom" {
        sync_canvas(S, d);
    }
    for entry in node_owners()[side] {
        let wanted = false;
        for id in entry.panels {
            if id == d.active {
                wanted = true;
            }
        }
        if d.shut || !wanted {
            hide_node(entry.hide);
        }
    }
}

// The tab row, and the tiles in it. A small window gets a step less of both:
// the row is chrome, and chrome is what a short window has least room for.
pub fn row_h(S) {
    if S.compact { 24.0 } else { 28.0 }
}

fn tab_h(S) {
    // A tab is a control a finger picks, so it takes the same height as the
    // rest of them where a finger is what reaches it.
    if S.touchscreen {
        33.0
    } else if S.compact {
        20.0
    } else {
        22.0
    }
}

// Where each dock's tab strip and its tools hatch live.
fn head_stem(side) {
    let sheet = if side == "bottom" {
        "Editor/Shell/Body/Centre/Bottom"
    } else if side == "left" {
        "Editor/Shell/Body/Left/LeftSheet"
    } else {
        "Editor/Shell/Body/Right/RightSheet"
    };
    let name = if side == "bottom" { "Bottom" } else if side == "left" { "Left" } else { "Right" };
    sheet + "/" + name + "Head/" + name
}

fn head_of(side) {
    head_stem(side) + "Tabs/" + head_name(side) + "TabsRow"
}

fn head_name(side) {
    if side == "bottom" { "Bottom" } else if side == "left" { "Left" } else { "Right" }
}

/// The fixed end of a dock's head: the panel's own tools and the fold. Outside
/// the tabs' scroll, so neither drags away with them.
fn tail_of(side) {
    head_stem(side) + "Tail"
}

/// The box the panel's own tools were given, in design pixels, or `None`
/// before the row has drawn. The self-test reads it: a hatch with no box is
/// a dock whose tools are there and invisible.
pub fn tools_box(side) {
    let found = scene::get_node(tail_of(side) + "/C0");
    if crate::util::is_nil(found) {
        return None;
    }
    let box = ui::widget_rect(found);
    if crate::util::is_nil(box) {
        return None;
    }
    Some(box)
}

fn tab_row(S, k, side, d) {
    crate::pool::strip(S, head_of(side), tab_controls(S, k, side, d));
    crate::pool::strip(S, tail_of(side), tail_controls(S, side));
}

/// The panel's own controls and the fold, in that order: where they have
/// always been, at the end of the head rather than the end of the tabs.
fn tail_controls(S, side) {
    [
        #{
            // A box, not a share: this row hugs what is in it, so a hatch
            // that only grows is one pixel wide and nothing draws in it.
            kind: "draw", width: tools_room(S, side), height: tab_h(S),
            draw: format!("draw_dock_tools_{}", side),
        },
        #{
            kind: "button", height: tab_h(S), width: tab_h(S), padding_x: 0,
            text: "", icon: icons::ui(shut_icon(side)), role: "icon_button",
            tooltip: "Minimise",
            on: |_| { S.docks[side].shut = true; },
        },
    ]
}

// One control a tab, the mark that closes it, and the fold at the end. The
// panel's own tools are the hatch beside this strip.
fn tab_controls(S, k, side, d) {
    let h = tab_h(S);
    let out = [];

    for id in d.tabs {
        let held = id;
        let p = panel(S, held);
        let active = d.active == held;
        let label = p.name;
        if held == "problems" {
            let (errors, warnings) = crate::lint::counts(S);
            if errors + warnings > 0 {
                label += format!(" {}", errors + warnings);
            }
        }
        // One tile: the row carries the fill and the corners, and the two
        // halves inside it paint nothing, so the pair reads as one control.
        let inner = [];
        inner.push(#{
            kind: "button", height: h, text: label, padding_x: 6, radius: 4, fill: "none",
            role: if active { "tab_on" } else { "tab" },
            on: |_| { S.docks[side].active = held; },
        });
        // Its own role, so the half of the tile under the pointer is the half
        // that lights up: a mark that looked the same either way was aimed at
        // and missed, and the click landed on the name beside it.
        inner.push(#{
            kind: "button", height: h, width: 22, text: "", radius: 4, role: "tab_close",
            icon: icons::ui("close"),
            tooltip: format!("Close {}", p.name),
            on: |_| { close(S, held); },
        });
        inner.push(#{ kind: "row", width: 3 });
        out.push(#{
            height: h, radius: 5, controls: inner, align: "center",
            fill: if active { "accent_soft" } else { "none" },
        });
    }
    out
}

/// The panel's own controls, in the slot beside its dock's tabs.
pub fn draw_tools(S, k, side) {
    let d = S.docks[side];
    if d.shut || d.tabs.len() == 0 {
        return;
    }
    tools(S, k, d.active, tools_room(S, side));
}

/// How much of the tab row the panel's own tools may take: what its tabs and
/// the fold leave, and never more than half the dock.
///
/// Zero where the tabs already fill the row, which is what makes the tools
/// give way rather than the names. The hatch is given this and the drawing
/// reads the same number, so what a panel is told it has is the box it got.
fn tools_room(S, side) {
    let d = S.docks[side];
    if d.shut || d.tabs.len() == 0 || d.active == "" {
        return 0.0;
    }
    let width = S.layout[side].w;
    let free = width - 60.0 - tabs_width(S, d.active);
    crate::util::clamp(free, 0.0, width * 0.5)
}

/// Stop drawing a dock's tab strip, for a dock that is folded or empty.
fn hide_tabs(side) {
    util::hide(head_of(side));
}

// How wide the tab row's own tiles are, from the names: a flat width per tab
// ran the hint over the row as soon as `Bone map` joined.
fn tabs_width(S, id) {
    let total = 0.0;
    for tab in S.docks[side_for(S, id)].tabs {
        // 11 px, semibold: about 7 px a character, plus the pill's padding,
        // the close mark and the gap to the next one.
        total += 34.0 + 7.0 * util::f(panel(S, tab).name.len());
    }
    total
}

// The controls that belong to the panel showing, in the tab row's one slot.
// A narrow dock keeps its tabs: the tools are what give way, not the names.
fn tools(S, k, id, room) {
    if id == "scene" {
        left::tree_tools(S, k);
        return;
    }
    if id == "output" {
        dock::output_tools(S, k, room);
        return;
    }
    if id == "profiler" && room > 90.0 {
        dock::profiler_tools(S, k);
    }
    if S.compact || room < 150.0 {
        return;
    }
    let hint = dock::hint(S, id, room);
    if hint != "" {
        ui::add_space(6);
        ui::label(hint, style::mono_sm(k.faint));
    }
}

fn side_for(S, id) {
    match side_of(S, id) {
        Some(side) => side,
        None => "bottom",
    }
}

// The caret on a dock's minimise button points at the edge it folds to, and
// the one on its handle points back the way it opens.
fn shut_icon(side) {
    match side {
        "left" => "caret-left",
        "right" => "caret-right",
        _ => "caret-down",
    }
}

fn open_icon(side) {
    match side {
        "left" => "caret-right",
        "right" => "caret-left",
        _ => "caret-up",
    }
}

/// Whether a dock is down to its rail: folded away, or emptied of every tab.
/// An emptied dock is not a blank sheet — it gives its width back.
pub fn folded(S, side) {
    let d = S.docks[side];
    d.shut || d.tabs.len() == 0
}

/// Whether every dock is down to its rail, which is the layout focus leaves.
pub fn all_folded(S) {
    for side in sides() {
        if !folded(S, side) {
            return false;
        }
    }
    true
}

pub fn draw_bottom_body(S, k) {
    let d = S.docks.bottom;
    hide_unused(S, "bottom", d);
    if d.tabs.len() == 0 || d.shut {
        hide_tabs("bottom");
        return;
    }
    tab_row(S, k, "bottom", d);
    body_scrolled(S, k, d.active);
}

/// A dock's body, inside the scroll it needs unless it brings its own.
///
/// Two scrolls, each asking for the body's whole height, leave the outer one
/// holding contents taller than itself: a gap under the tabs, and the panel
/// clipped to a few rows with empty sheet below it.
fn body_scrolled(S, k, id) {
    if scrolls_itself(S, id) {
        body(S, k, id);
        return;
    }
    ui::scroll("dock-body", #{ max_height: S.layout.body_h - 8.0 }, || {
        body(S, k, id);
    });
}

/// The panels that open a scroll of their own, because they want something
/// the plain one does not do: a log follows what is arriving. A plugin's dock
/// says so with `scrolls: true`.
fn scrolls_itself(S, id) {
    if id == "output" || id == "docs" || id == "bonemap" || id == "statemachine" {
        return true;
    }
    match crate::plugins::dock(S, id) {
        Some(entry) => entry.scrolls,
        None => false,
    }
}

/// The strip along the foot of the bottom dock: what is playing, and the
/// control that minimises the dock when it is open.
/// A dock's contents, drawn into the rect the scene's `draw` node hands over.
///
/// The sheet around it is the node's own paint now, so this draws no frame:
/// the tab row and the panel. The status strip is a pooled row of its own.
pub fn draw_body(S, k, side) {
    let d = S.docks[side];
    hide_unused(S, side, d);
    if d.tabs.len() == 0 || d.shut {
        hide_tabs(side);
        return;
    }
    tab_row(S, k, side, d);
    if side != "bottom" {
        body(S, k, d.active);
        return;
    }
    body_scrolled(S, k, d.active);
}

/// Whether a side dock is open: the one sheet that takes the whole body where
/// there is room for one, which the bottom dock never does.
pub fn side_open(S) {
    !folded(S, "left") || !folded(S, "right")
}

/// Whether a side dock is folded with something to go back to.
fn has_handle(S, side) {
    folded(S, side) && S.docks[side].tabs.len() > 0
}

/// The room the left dock's handle takes above the tool rail, which is where
/// it goes when there is a rail to sit over.
pub fn rail_top_h(S) {
    if S.rail_visible && has_handle(S, "left") {
        return tile(S) + 6.0;
    }
    0.0
}

/// The room that handle takes at the head of the top strip instead, for a
/// centre with no rail to put it over.
pub fn fold_inset(S) {
    if !S.rail_visible && has_handle(S, "left") {
        return tile(S) + 6.0;
    }
    0.0
}

/// The handle a folded dock leaves behind, at the edge it folded towards: the
/// left one above the tools, the right one opposite it, the bottom one beside
/// the zoom reading. A folded dock gives its space back, so this is the way
/// back to it.
pub fn fold_strip(S, k, vp) {
    if S.chrome_off {
        return;
    }
    // A side sheet that is the whole screen offers one way out, its own fold:
    // a handle to a second sheet would open it over the first. An open bottom
    // dock leaves the stage, and the handles on it, where they were.
    if one_at_a_time(S) && side_open(S) {
        return;
    }
    let top = S.layout.railtop;
    if top.h > 0.0 {
        handle_tile(S, k, "left", top.x, top.y);
    } else {
        handle_tile(S, k, "left", vp.x, vp.y);
    }
    handle_tile(S, k, "right", vp.x + vp.w - tile(S), vp.y);
}

/// The bottom dock's handle, drawn into the row the zoom reading is in so it
/// lands just after it.
pub fn fold_foot(S, k) {
    if S.chrome_off || !has_handle(S, "bottom") || (one_at_a_time(S) && side_open(S)) {
        return;
    }
    let step = crate::center::hud_step(S);
    if ui::pill(icons::ui(open_icon("bottom")), #{
        height: step + 2.0 * PAD_Y, min_width: step + 2.0 * PAD_X, size: style::LG,
        padding_x: 0, radius: 8, fill: k.panel, color: k.dim,
        tooltip: "Open the dock",
    }) {
        S.docks.bottom.shut = false;
    }
}

// The rail's own geometry: one tool on one sheet, drawn the way the rail
// draws each of its marks.
fn handle_tile(S, k, side, x, y) {
    if !has_handle(S, side) {
        return;
    }
    let p = panel(S, S.docks[side].active);
    let m = crate::center::rail_metrics(S);
    let box = #{ x: x, y: y, w: tile(S), h: tile(S) };
    style::sheet(k, "fold-" + side, box, m.pad, m.pad, || {
        if ui::circle_button(icons::ui(open_icon(side)), #{
            role: "tool", d: m.d, tooltip: format!("Open the {}", p.name.to_lowercase()),
        }) {
            unfold(S, side);
        }
    });
}
