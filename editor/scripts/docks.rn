// The shell's three docks — left, bottom, right — and the panels in them. A
// panel lives in exactly one dock; its tab menu moves it to another.

use crate::icons;
use crate::inspector;
use crate::left;
use crate::util;

// The "+N" list that stands for the tabs a narrow dock has no room for.
const MORE_W = 48.0;
// What the fold and the head's padding leave the tabs of a dock's width.
const HEAD_END = 44.0;

/// A side dock's handle is the tool rail's tile: an icon button on a sheet,
/// with the rail's own inset, so the two sit in one column at one size.
fn tile(S) {
    let m = crate::center::rail_metrics(S);
    m.d + 2.0 * m.pad
}

pub fn sides() {
    ["left", "bottom", "right"]
}

pub fn state() {
    crate::defs::workspace_docks("scene")
}

/// Swap the open panels for the ones a workspace works with. What is open is
/// the workspace's; what may be opened is not, so a panel closed here comes
/// back from the logo menu without changing workspace.
pub fn apply_workspace(S, id) {
    let want = crate::defs::workspace_docks(id);
    for side in sides() {
        // A dock the reader folded away stays folded: the workspace says which
        // panels, not whether the sheet is up.
        want[side].shut = S.docks[side].shut;
    }
    S.docks = want;
    crate::signals::docks(S);
    // A plugin's dock is in no workspace's set: it was adopted when the plugin
    // loaded, and a workspace must not unregister it.
    for entry in S.registry.panels {
        adopt(S, entry.id);
    }
}

/// Fold the docks away when the screen cannot hold them beside the stage, and
/// put them back when it can.
///
/// Both axes decide it. A phone on its side is 844 design pixels wide, which
/// is past the line a layout may spread out at, and 390 tall, which is less
/// than the bottom dock and a usable stage need between them.
///
/// Applied on the change, not every frame, so a reader who opens a dock on a
/// phone keeps it open until the screen itself changes.
pub fn follow_screen(S) {
    // A string, since Rune compares no tuples: two words for two answers.
    let key = format!("{} {}", crate::layout::three_fit(S), one_at_a_time(S));
    if S.screen_key == key {
        return;
    }
    S.screen_key = key;
    // Room, not a class word: a phone opens one sheet at a time, a tablet
    // folds the columns and keeps the bottom dock, a laptop keeps all three.
    let only_one = one_at_a_time(S);
    let tight = !crate::layout::three_fit(S);
    for side in ["left", "right", "bottom"] {
        // Into a local first: a field assigned a branch of the loop's own
        // variables is the pitfall AGENTS.md names.
        let fold = if side == "bottom" { only_one } else { only_one || tight };
        S.docks[side].shut = fold;
        crate::signals::docks(S);
    }
}

/// Whether only one dock may be open at a time: a screen with less width
/// than two side docks and a stage at their floors, or less height than the
/// bar, a bottom dock and a stage at theirs, holds one sheet and the stage.
pub fn one_at_a_time(S) {
    let (w, h) = crate::layout::floors(S);
    S.screen_w < w || S.screen_h < h
}

/// Open a side dock, folding the other where there is only room for one.
fn unfold(S, side) {
    S.docks[side].shut = false;
    crate::signals::docks(S);
    if !one_at_a_time(S) {
        return;
    }
    for other in sides() {
        if other != side {
            S.docks[other].shut = true;
            crate::signals::docks(S);
        }
    }
}

/// Every panel the menu can open, in the order it lists them.
pub fn known(S) {
    util::keys_sorted(panels(S))
}

// Where a panel lands when it is opened from the menu rather than moved.
fn homes() {
    #{ scene: "left", outline: "left", inspector: "right", import: "right" }
}

pub fn home(id) {
    homes().get(id).unwrap_or("bottom")
}

/// Name and icon per panel; `tall` asks the bottom dock for its taller size.
/// A plugin's dock joins the table so it moves like everything else.
///
/// Built once a frame: the tab row, the minimised rail and `bottom_tall` all
/// ask, and the outline's own name re-reads every script in the Script workspace.
pub fn panels(S) {
    let cache = S.panels;
    if cache is Object && cache.at == S.frame && cache.workspace == S.workspace {
        return cache.table;
    }
    let table = #{
        "scene": #{ name: "Scene", icon: icons::panel("scene"), tall: false },
        "outline": #{ name: left::outline_title(S), icon: icons::panel("outline"), tall: false },
        "inspector": #{ name: "Inspector", icon: icons::panel("inspector"), tall: false },
        "import": #{ name: "Import", icon: icons::panel("import"), tall: false },
        "output": #{ name: "Output", icon: icons::panel("output"), tall: false },
        "problems": #{ name: "Problems", icon: icons::panel("problems"), tall: false },
        "assets": #{ name: "Assets", icon: icons::panel("assets"), tall: false },
        "docs": #{ name: "Docs", icon: icons::panel("docs"), tall: true },
        "timeline": #{ name: "Timeline", icon: icons::panel("timeline"), tall: true },
        "debugger": #{ name: "Debugger", icon: icons::panel("debugger"), tall: true },
        "recordings": #{ name: "Recordings", icon: icons::panel("recordings"), tall: true },
        "profiler": #{ name: "Profiler", icon: icons::panel("profiler"), tall: true },
        "cost": #{ name: "Cost", icon: icons::panel("cost"), tall: true },
        "library": #{ name: "Library", icon: icons::panel("library"), tall: false },
        "tiles": #{ name: "Tiles", icon: icons::panel("tiles"), tall: true },
        "weights": #{ name: "Weights", icon: icons::panel("weights"), tall: true },
        "bonemap": #{ name: "Bone map", icon: icons::panel("bonemap"), tall: true },
        "statemachine": #{ name: "State machine", icon: icons::panel("statemachine"), tall: true },
    };
    for entry in S.registry.panels {
        let icon = if entry.icon == "" { icons::panel(entry.id) } else { entry.icon };
        table[entry.id] = #{ name: entry.title, icon: icon, tall: entry.tall };
    }
    S.panels = #{ at: S.frame, workspace: S.workspace, table: table };
    table
}

/// Give a panel a home. A plugin's dock joins the bottom one, which is where
/// EDITOR-SCREENS §5 promises one tab per registered plugin; its tab menu
/// moves it from there like any other.
pub fn adopt(S, id) {
    if side_of(S, id).is_some() {
        return;
    }
    S.docks[home(id)].tabs.push(id);
    crate::signals::docks(S);
}

/// Take a panel out of its dock. Nothing is destroyed: the logo menu lists
/// every panel whether it is open or not, and puts this one back.
pub fn close(S, id) {
    let side = match side_of(S, id) {
        Some(side) => side,
        None => return,
    };
    let kept = [];
    for t in S.docks[side].tabs {
        if t != id {
            kept.push(t);
        }
    }
    S.docks[side].tabs = kept;
    crate::signals::docks(S);
    if S.docks[side].active == id {
        S.docks[side].active = kept.get(0).unwrap_or("");
        crate::signals::docks(S);
    }
}

/// Open a closed panel, or close an open one: what the logo menu's rows do.
pub fn toggle(S, id) {
    if side_of(S, id).is_some() {
        close(S, id);
    } else {
        show(S, id);
    }
}

fn panel(S, id) {
    panels(S).get(id).unwrap_or(#{ name: id, icon: icons::panel(id), tall: false })
}

/// What a panel is called, for a menu row outside this module.
pub fn name(S, id) {
    panel(S, id).name
}

/// Which dock holds `id`, or `None` when a plugin has been unloaded.
pub fn side_of(S, id) {
    // A plain loop: a closure a tab was most of what the tab rows cost.
    for side in sides() {
        for tab in S.docks[side].tabs {
            if tab == id {
                return Some(side);
            }
        }
    }
    None
}

/// Whether `id` is the panel its dock is showing. Replaces the old
/// `S.dock == "..."`, which assumed everything lived at the bottom.
pub fn showing(S, id) {
    match side_of(S, id) {
        Some(side) => S.docks[side].active == id && !S.docks[side].shut,
        None => false,
    }
}

/// Bring `id` up wherever it lives, opening it and its dock.
///
/// A closed panel is opened first: a tool that cannot be used without its
/// dock says so, rather than leaving the tab to be hunted for.
pub fn show(S, id) {
    adopt(S, id);
    let found = side_of(S, id);
    if let Some(side) = found {
        S.docks[side].active = id;
        crate::signals::docks(S);
        unfold(S, side);
    }
}

/// Move a panel to another dock, and leave its old dock showing something.
pub fn move_to(S, id, side) {
    let from = side_of(S, id);
    if let Some(old) = from {
        if old == side {
            return;
        }
        let kept = [];
        for t in S.docks[old].tabs {
            if t != id {
                kept.push(t);
            }
        }
        S.docks[old].tabs = kept;
        crate::signals::docks(S);
        if S.docks[old].active == id {
            S.docks[old].active = kept.get(0).unwrap_or("");
            crate::signals::docks(S);
        }
    }
    S.docks[side].tabs.push(id);
    crate::signals::docks(S);
    S.docks[side].active = id;
    crate::signals::docks(S);
    unfold(S, side);
}

/// The taller bottom dock, asked before the layout is computed.
pub fn bottom_tall(S) {
    let d = S.docks.bottom;
    if d.shut || d.active == "" {
        return false;
    }
    panel(S, d.active).tall
}

fn body(S, k, id) {
    if filled_by_itself(id) {
        // An open recording's lanes take the list's room.
        if id == "recordings" {
            let open = crate::session::loaded(S);
            util::fill(BOTTOM + "Recordings", #{ visible: !open });
            util::fill(BOTTOM + "Lanes", #{ visible: open });
            return;
        }
        show_panel(own_node(id));
        return;
    }
    match id {
        "scene" => left::show_tree(),
        "outline" => left::show_outline(),
        "inspector" => inspector::show_panel(),
        "import" => util::fill("Editor/Shell/Body/Right/RightSheet/Import", #{ visible: true }),
        _ => match crate::plugins::panel(S, id) {
            Some(entry) => {
                let draw = entry.draw;
                // The node the editor made for this dock, not a `ui` handle:
                // a plugin fills its own subtree and cannot reach past it.
                draw(S, k, plugin_host(S, side_of(S, id).unwrap_or("bottom"), id));
            }
            None => (),
        },
    }
}

const BOTTOM = "Editor/Shell/Body/Centre/Bottom/";

// The bottom panels, each a scene of its own under the dock with its own
// script: shown and hidden here, filled by themselves. A panel's node by id.
fn own_nodes() {
    #{
        output: "Output", problems: "Problems", docs: "Docs", profiler: "Profiler",
        cost: "Cost", assets: "Assets", library: "Library", tiles: "Tiles",
        statemachine: "StateMachine", recordings: "Recordings", debugger: "Debugger",
        timeline: "Timeline", weights: "Weights", bonemap: "Bonemap",
    }
}

fn own_node(id) {
    own_nodes().get(id).unwrap_or("")
}

fn is_own_node(name) {
    for (_, held) in own_nodes() {
        if held == name {
            return true;
        }
    }
    false
}

// A panel that is a scene of its own, which `fill` shows and nothing draws.
fn filled_by_itself(id) {
    own_node(id) != ""
}

fn show_panel(name) {
    util::fill(BOTTOM + name, #{ visible: true });
}

// The hatch draws whatever panel has no node of its own, so it gives its room
// up to one that has.
fn sync_hatch(S, d) {
    let owned = owns_a_node(S, "bottom", d);
    util::fill(BOTTOM + "DockBody", #{
        grow: if owned { 0.0 } else { 1.0 },
        height: if owned { 1.0 } else { 0.0 },
    });
}

/// Fill a panel's strip of chips at `path`: `rows` is a list of controls a
/// row, made into nodes by the pool.
pub fn toolbar(S, path, rows) {
    let groups = [];
    for row in rows {
        groups.push(#{ kind: "row", role: "toolbar_dock", gap: [6, 6], align_items: "center", controls: row });
    }
    crate::pool::strip(S, path, groups);
}

/// Whether the panel showing has a node of its own, which the shared hatch
/// must then leave the room to.
fn owns_a_node(S, side, d) {
    if d.shut || d.active == "" {
        return false;
    }
    // Every plugin dock has one: the editor makes it a subtree rather than
    // lending it the hatch.
    if crate::plugins::panel(S, d.active).is_some() {
        return true;
    }
    for entry in node_owners()[side] {
        for id in entry.panels {
            if id == d.active {
                return true;
            }
        }
    }
    false
}

fn node_owners() {
    #{
        bottom: [
            #{ hide: "Output", panels: ["output"] },
            #{ hide: "Problems", panels: ["problems"] },
            #{ hide: "Docs", panels: ["docs"] },
            #{ hide: "Profiler", panels: ["profiler"] },
            #{ hide: "Cost", panels: ["cost"] },
            #{ hide: "Assets", panels: ["assets"] },
            #{ hide: "Library", panels: ["library"] },
            #{ hide: "Tiles", panels: ["tiles"] },
            #{ hide: "StateMachine", panels: ["statemachine"] },
            #{ hide: "Recordings", panels: ["recordings"] },
            #{ hide: "Lanes", panels: ["recordings"] },
            #{ hide: "Timeline", panels: ["timeline"] },
            #{ hide: "Weights", panels: ["weights"] },
            #{ hide: "Bonemap", panels: ["bonemap"] },
            #{ hide: "Debugger", panels: ["debugger"] },
        ],
        left: [
            #{ hide: "tree", panels: ["scene"] },
            #{ hide: "outline", panels: ["outline"] },
        ],
        right: [
            #{ hide: "inspector", panels: ["inspector"] },
            #{ hide: "import", panels: ["import"] },
        ],
    }
}

fn hide_node(S, which) {
    if is_own_node(which) || which == "Lanes" {
        util::hide(BOTTOM + which);
    } else if which == "tree" {
        left::hide_tree(S);
    } else if which == "outline" {
        left::hide_outline();
    } else if which == "import" {
        util::hide("Editor/Shell/Body/Right/RightSheet/Import");
    } else if which == "inspector" {
        inspector::hide_panel();
    }
}

fn hide_unused(S, side, d) {
    if side == "bottom" {
        sync_hatch(S, d);
    }
    hide_plugin_hosts(S, side, if d.shut { "" } else { d.active });
    for entry in node_owners()[side] {
        let wanted = false;
        for id in entry.panels {
            if id == d.active {
                wanted = true;
            }
        }
        if d.shut || !wanted {
            hide_node(S, entry.hide);
        }
    }
}

// The tab row, and the tiles in it. A small window gets a step less of both:
// the row is chrome, and chrome is what a short window has least room for.
pub fn row_h(S) {
    if S.compact { 24.0 } else { 28.0 }
}

fn tab_h(S) {
    // A tab is a control a finger picks, so it takes the same height as the
    // rest of them where a finger is what reaches it.
    if S.touchscreen {
        33.0
    } else if S.compact {
        20.0
    } else {
        22.0
    }
}

// Where each dock's tab strip and its tools hatch live.
/// Where a side keeps its plugin docks' own subtrees, which the scene states
/// so one made at run time sits where the side wants it rather than last.
fn plugins_of(side) {
    if side == "bottom" {
        "Editor/Shell/Body/Centre/Bottom/BottomPlugins"
    } else if side == "left" {
        "Editor/Shell/Body/Left/LeftSheet/LeftPlugins"
    } else {
        "Editor/Shell/Body/Right/RightSheet/RightPlugins"
    }
}

// A plugin dock's own subtree: a head, a sidebar, a body and a foot. One per
// dock and side, so a dock moved between sides leaves nothing behind it.
fn host_fragment(name) {
    let text = "[[nodes]]
id = \"HOST\"
name = \"HOST\"
[nodes.widget]
kind = \"column\"
role = \"plugin_host\"
grow = 1

[[nodes]]
id = \"HOST_head\"
name = \"Head\"
parent = \"HOST\"
[nodes.widget]
kind = \"flow\"
role = \"plugin_head\"
align_items = \"center\"

[[nodes]]
id = \"HOST_split\"
name = \"Split\"
parent = \"HOST\"
[nodes.widget]
kind = \"row\"
role = \"plugin_split\"
grow = 1

[[nodes]]
id = \"HOST_side\"
name = \"Side\"
parent = \"HOST_split\"
[nodes.widget]
kind = \"scroll\"
axis = \"vertical\"
visible = false
width = 150

[[nodes]]
id = \"HOST_side_rows\"
name = \"SideRows\"
parent = \"HOST_side\"
[nodes.widget]
kind = \"column\"
role = \"plugin_side\"
grow = 1

[[nodes]]
id = \"HOST_body\"
name = \"Body\"
parent = \"HOST_split\"
[nodes.widget]
kind = \"scroll\"
axis = \"vertical\"
grow = 1

[[nodes]]
id = \"HOST_rows\"
name = \"Rows\"
parent = \"HOST_body\"
[nodes.widget]
kind = \"column\"
role = \"plugin_rows\"
grow = 1

[[nodes]]
id = \"HOST_foot\"
name = \"Foot\"
parent = \"HOST\"
[nodes.widget]
kind = \"row\"
role = \"plugin_head\"
align_items = \"center\"
";
    text.replace("HOST", name)
}

fn host_name(id) {
    "Plugin_" + id
}

/// The node a plugin dock fills, made the first time it is drawn on that side
/// and shown. Its `head`, `body` and `foot` are what `S.kit` writes to.
pub fn plugin_host(S, side, id) {
    let parent = plugins_of(side);
    let path = parent + "/" + host_name(id);
    if util::is_nil(scene::get_node(path)) {
        let under = scene::get_node(parent);
        if util::is_nil(under) {
            return "";
        }
        scene::instantiate(host_fragment(host_name(id)), under, #{ scripts: false });
    }
    util::fill(parent, #{ visible: true });
    util::fill(path, #{ visible: true });
    path
}

/// Hide every plugin dock's subtree but the one showing, on every side: a
/// node keeps drawing until it is told not to.
fn hide_plugin_hosts(S, side, active) {
    let any = false;
    for entry in S.registry.panels {
        if entry.id == active {
            any = true;
            continue;
        }
        util::hide(plugins_of(side) + "/" + host_name(entry.id));
    }
    if !any {
        util::hide(plugins_of(side));
    }
}

fn head_stem(side) {
    let sheet = if side == "bottom" {
        "Editor/Shell/Body/Centre/Bottom"
    } else if side == "left" {
        "Editor/Shell/Body/Left/LeftSheet"
    } else {
        "Editor/Shell/Body/Right/RightSheet"
    };
    let name = if side == "bottom" { "Bottom" } else if side == "left" { "Left" } else { "Right" };
    sheet + "/" + name + "Head/" + name
}

fn head_of(side) {
    head_stem(side) + "Tabs/" + head_name(side) + "TabsRow"
}

fn head_name(side) {
    if side == "bottom" { "Bottom" } else if side == "left" { "Left" } else { "Right" }
}

/// The fixed end of a dock's head: the panel's own tools and the fold. Outside
/// the tabs' scroll, so neither drags away with them.
fn tail_of(side) {
    head_stem(side) + "Tail"
}

/// The box the panel's own tools were given, in design pixels, or `None`
/// before the row has drawn. The self-test reads it: a hatch with no box is
/// a dock whose tools are there and invisible.
/// The active tab's box and the strip it scrolls in, or `None` before the
/// row has drawn. A tab past the strip's end is a panel showing with no tab.
pub fn active_tab_box(S, side) {
    let at = 0;
    for (i, id) in shown_tabs(S, side).iter().enumerate() {
        if id == S.docks[side].active {
            at = i;
        }
    }
    let tab = scene::get_node(format!("{}/C{}", head_of(side), at));
    let strip = scene::get_node(head_stem(side) + "Tabs");
    if crate::util::is_nil(tab) || crate::util::is_nil(strip) {
        return None;
    }
    let (tab, strip) = (ui::widget_rect(tab), ui::widget_rect(strip));
    if crate::util::is_nil(tab) || crate::util::is_nil(strip) {
        return None;
    }
    Some((tab, strip))
}

pub fn tools_box(side) {
    let found = scene::get_node(tail_of(side) + "/C0");
    if crate::util::is_nil(found) {
        return None;
    }
    let box = ui::widget_rect(found);
    if crate::util::is_nil(box) {
        return None;
    }
    Some(box)
}

fn tab_row(S, k, side, d) {
    // What the two strips are built from: the dock, its tabs' names, the
    // Problems count its label carries, and the room the row has.
    let names = [];
    for id in d.tabs {
        names.push(panel(S, id).name);
    }
    let (errors, warnings) = crate::lint::counts(S);
    let key = [format!("{:?}", d), names, errors + warnings, tab_h(S), S.layout[side].w];
    crate::pool::strip_when(S, head_of(side), key, || tab_controls(S, k, side, d));
    crate::pool::strip_when(S, tail_of(side), key, || tail_controls(S, side));
}

/// The panel's own controls and the fold, in that order: where they have
/// always been, at the end of the head rather than the end of the tabs.
fn tail_controls(S, side) {
    let fold = #{
        kind: "button", height: tab_h(S), width: tab_h(S), padding: 0,
        text: "", icon: icons::ui(shut_icon(side)), role: "icon_action",
        tooltip: "Minimize",
        on: |_| {
            S.docks[side].shut = true;
            crate::signals::docks(S);
        },
    };
    // Every panel carries its own tools in its own scene.
    let controls = [fold];
    controls
}

// One control a tab, the mark that closes it, and the fold at the end. The
// panel's own tools are the hatch beside this strip.
fn tab_controls(S, k, side, d) {
    let h = tab_h(S);
    let out = [];
    let shown = shown_tabs(S, side);

    for id in shown {
        let held = id;
        let p = panel(S, held);
        let active = d.active == held;
        let label = tab_label(S, held);
        // One tile: the row carries the fill and the corners, and the two
        // halves inside it paint nothing, so the pair reads as one control.
        let inner = [];
        inner.push(#{
            kind: "button", height: h, text: label, padding: [6, -1, 6, -1], corner_radius: 4, fill: "none",
            role: "tab", checked: active,
            on: |_| {
                S.docks[side].active = held;
                crate::signals::docks(S);
            },
        });
        // Its own role, so the half of the tile under the pointer is the half
        // that lights up: a mark that looked the same either way was aimed at
        // and missed, and the click landed on the name beside it.
        inner.push(#{
            kind: "button", height: h, width: 22, text: "", corner_radius: 4, role: "icon_action_tab",
            icon: icons::ui("close"),
            tooltip: format!("Close {}", p.name),
            on: |_| { close(S, held); },
        });
        inner.push(#{ kind: "row", width: 3 });
        out.push(#{
            height: h, corner_radius: 4, controls: inner, align_items: "center",
            fill: if active { "primary_bg" } else { "none" },
        });
    }
    let hidden = [];
    for id in d.tabs {
        if !has(shown, id) {
            hidden.push(panel(S, id).name);
        }
    }
    if hidden.len() > 0 {
        out.push(#{
            kind: "dropdown", role: "choice", height: h, width: MORE_W,
            text: format!("+{}", hidden.len()), options: hidden, tooltip: "More tabs",
            on: |picked| { show_named(S, side, picked); },
        });
    }
    out
}

/// The tabs a dock's row has room for, the active one always among them: the
/// leading run that fits, slid along until it reaches the active tab.
pub fn shown_tabs(S, side) {
    let d = S.docks[side];
    let room = S.layout[side].w - HEAD_END;
    if tabs_width(S, side) <= room {
        return d.tabs;
    }
    // The list's box and the gap before it.
    let room = room - MORE_W - 4.0;
    let widths = [];
    let end = 0;
    let used = 0.0;
    let fits = true;
    for (i, id) in d.tabs.iter().enumerate() {
        let w = tab_width(S, id);
        widths.push(w);
        used += w;
        if used <= room && fits {
            end = i;
        } else {
            fits = false;
        }
        if id == d.active && i > end {
            end = i;
        }
    }
    let start = end;
    let used = widths[end];
    while start > 0 && used + widths[start - 1] <= room {
        start -= 1;
        used += widths[start];
    }
    let out = [];
    for i in start..=end {
        out.push(d.tabs[i]);
    }
    out
}

fn has(list, id) {
    for x in list {
        if x == id {
            return true;
        }
    }
    false
}

// A pick from the "+N" list, which lists names: the panel it names comes forward.
fn show_named(S, side, name) {
    for id in S.docks[side].tabs {
        if panel(S, id).name == name {
            S.docks[side].active = id;
            crate::signals::docks(S);
        }
    }
}

// What a tab reads: its name, and the count Problems carries.
fn tab_label(S, id) {
    let label = panel(S, id).name;
    if id == "problems" {
        let (errors, warnings) = crate::lint::counts(S);
        if errors + warnings > 0 {
            label += format!(" {}", errors + warnings);
        }
    }
    label
}

/// Stop drawing a dock's tab strip, for a dock that is folded or empty.
fn hide_tabs(S, side) {
    crate::pool::hide(S, head_of(side));
    S.pool_keys.remove(tail_of(side));
}

// How wide the tab row's own tiles are, from the names: a flat width per tab
// ran the hint over the row as soon as `Bone map` joined.
fn tabs_width(S, side) {
    let total = 0.0;
    for tab in S.docks[side].tabs {
        total += tab_width(S, tab);
    }
    total
}

fn tab_width(S, id) {
    // 11 px, semibold: under 6 px a character, plus the pill's padding, the
    // close mark and the gap to the next one, measured at 52 px.
    52.0 + 6.0 * util::f(tab_label(S, id).len())
}

// The caret on a dock's minimise button points at the edge it folds to, and
// the one on its handle points back the way it opens.
fn shut_icon(side) {
    match side {
        "left" => "caret-left",
        "right" => "caret-right",
        _ => "caret-down",
    }
}

fn open_icon(side) {
    match side {
        "left" => "caret-right",
        "right" => "caret-left",
        _ => "caret-up",
    }
}

/// Whether a dock is down to its rail: folded away, or emptied of every tab.
/// An emptied dock is not a blank sheet — it gives its width back.
pub fn folded(S, side) {
    let d = S.docks[side];
    d.shut || d.tabs.len() == 0
}

/// Whether every dock is down to its rail, which is the layout focus leaves.
pub fn all_folded(S) {
    for side in sides() {
        if !folded(S, side) {
            return false;
        }
    }
    true
}

/// The bottom dock's body, drawn each pass for the panels that still draw;
/// its tab row and which panel shows are `fill`'s, on `docks_changed`.
pub fn draw_bottom_body(S, k) {
    let d = S.docks.bottom;
    if d.tabs.len() == 0 || d.shut || filled_by_itself(d.active) {
        return;
    }
    body_scrolled(S, k, d.active);
}


/// A dock's body, inside the scroll it needs unless it brings its own.
///
/// Two scrolls, each asking for the body's whole height, leave the outer one
/// holding contents taller than itself: a gap under the tabs, and the panel
/// clipped to a few rows with empty sheet below it.
fn body_scrolled(S, k, id) {
    if scrolls_itself(S, id) {
        body(S, k, id);
        return;
    }
    ui::scroll("dock-body", #{ max_height: S.layout.body_h - 8.0 }, || {
        body(S, k, id);
    });
}

/// The panels that open a scroll of their own, because they want something
/// the plain one does not do: a log follows what is arriving. A plugin's dock
/// always does: its own subtree carries the scroll.
fn scrolls_itself(S, id) {
    crate::plugins::panel(S, id).is_some()
}

/// The strip along the foot of the bottom dock: what is playing, and the
/// control that minimises the dock when it is open.
/// A dock's tab row, which of its panels shows, and the side panels' own
/// showing: what its script asks for on `docks_changed`, rather than every pass.
pub fn fill(S, side) {
    let k = S.theme;
    let d = S.docks[side];
    hide_unused(S, side, d);
    if d.tabs.len() == 0 || d.shut {
        hide_tabs(S, side);
        return "";
    }
    tab_row(S, k, side, d);
    if side != "bottom" || filled_by_itself(d.active) {
        body(S, k, d.active);
    }
    shown_panel(S, side, d)
}

/// The node of the panel `fill` just showed, which the dock then tells to
/// fill itself: told after the showing, it never reads itself as hidden.
fn shown_panel(S, side, d) {
    if side == "right" && d.active == "import" {
        return "Import";
    }
    if side != "bottom" || !filled_by_itself(d.active) {
        return "";
    }
    if d.active == "recordings" && crate::session::loaded(S) {
        return "Lanes";
    }
    own_node(d.active)
}

/// Whether a side dock is open: the one sheet that takes the whole body where
/// there is room for one, which the bottom dock never does.
pub fn side_open(S) {
    !folded(S, "left") || !folded(S, "right")
}

/// Whether a side dock is folded with something to go back to.
fn has_handle(S, side) {
    folded(S, side) && S.docks[side].tabs.len() > 0
}

/// The room the left dock's handle takes above the tool rail, which is where
/// it goes when there is a rail to sit over.
pub fn rail_top_h(S) {
    if S.rail_visible && has_handle(S, "left") {
        return tile(S) + 6.0;
    }
    0.0
}

/// The room that handle takes at the head of the top strip instead, for a
/// centre with no rail to put it over.
pub fn fold_inset(S) {
    if !S.rail_visible && has_handle(S, "left") {
        return tile(S) + 6.0;
    }
    0.0
}

/// The handles a folded dock leaves behind, at the edge it folded towards:
/// the left one above the tools or at the stage's corner, the right one
/// opposite it, the bottom one beside the zoom reading. A folded dock gives
/// its space back, so this is the way back to it. A side sheet that is the
/// whole screen offers one way out, its own fold: a handle to a second sheet
/// would open it over the first.
pub fn handles(S) {
    let hidden = S.chrome_off || (one_at_a_time(S) && side_open(S));
    let one = |side| {
        let p = panel(S, S.docks[side].active);
        #{
            shown: !hidden && has_handle(S, side),
            icon: icons::ui(open_icon(side)),
            tooltip: format!("Open the {}", p.name.to_lowercase()),
        }
    };
    #{ left: one("left"), right: one("right"), bottom: one("bottom") }
}

/// Open a folded dock from its handle.
pub fn open_from_handle(S, side) {
    if side == "bottom" {
        S.docks.bottom.shut = false;
        crate::signals::docks(S);
        return;
    }
    unfold(S, side);
}

