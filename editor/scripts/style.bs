// The sizes a theme states, as the scripts that do layout arithmetic read
// them; a node's own look is its role's.

use editor;
use words::layout_fields;
use words::project_fields;
use words::roles;

/// A role's stated size as the theme file gives it: the touch table's where
/// a finger drives the screen and the role has one, else the role's own.
pub fn role_size_in_pixels(state: editor::State, role: str, key: str, fallback: float) -> float {
    let table = state.theme[project_fields::ROLES][role];
    if table == nil {
        return fallback;
    }
    let touch = table["touch"][key];
    if state.touchscreen && touch != nil {
        return size_in_pixels(state, touch);
    }
    let own = table[key];
    if own == nil { fallback } else { size_in_pixels(state, own) }
}

/// A number a theme states, or the size it names: `"control_height"` is
/// whatever the worn theme makes of it.
pub fn size_in_pixels(state: editor::State, value: any) -> float {
    if value.kind() == types::KIND_STRING {
        state.theme[project_fields::SIZES][value.as_str()].as_float()
    } else {
        value.as_float()
    }
}

/// A form row, and the field or search box in one: the form field's height
/// as the theme states it, its touch table's where a finger picks it.
pub fn row_height(state: editor::State) -> float {
    role_size_in_pixels(state, roles::INPUT_FORM, layout_fields::HEIGHT, 24.0)
}
