// The type scale and the sizes a theme states, as the scripts that size a
// node read them.

use editor;
use shell;

/// The type scale, in design pixels. Four steps and no others: a call site
/// that wants a size names one of these, and everything else takes the size
/// its `role` carries.
///
/// `SMALL` is a caption or a dense secondary line, `MEDIUM` is body text and
/// every control's label, `LARGE` is a glyph standing on its own, and
/// `EXTRA_LARGE` is the one title a panel gets.
pub const SMALL: float = 11.0;

pub const MEDIUM: float = 12.0;

pub const LARGE: float = 14.0;

pub const EXTRA_LARGE: float = 17.0;

/// A role's stated size as the theme file gives it: the touch table's where
/// a finger drives the screen and the role has one, else the role's own.
pub fn role_size_in_pixels(state: editor::State, role: str, key: str, fallback: float) -> float {
    let table = state.theme["roles"][role];
    if table.is_nil() {
        return fallback;
    }
    let touch = table["touch"][key];
    if state.touchscreen && !touch.is_nil() {
        return size_in_pixels(state, touch);
    }
    let own = table[key];
    if own.is_nil() { fallback } else { size_in_pixels(state, own) }
}

/// A number a theme states, or the size it names: `"control_height"` is
/// whatever the worn theme makes of it.
pub fn size_in_pixels(state: editor::State, value: any) -> float {
    if value.kind() == "str" {
        state.theme["sizes"][value.as_str()].as_float()
    } else {
        value.as_float()
    }
}

/// A form row, and the field or search box in one: the theme's touch box
/// where a finger picks it, a cursor's line otherwise.
pub fn row_height(state: editor::State) -> float {
    if state.touchscreen { shell::TOUCH_CONTROL } else { 24.0 }
}
