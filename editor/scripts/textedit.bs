// Editing a `text2d` or `text3d` where it is drawn: double-click one in the
// viewport, or add one, and type over it rather than crossing to the
// inspector for a word. Enter or a click away keeps what was typed; Escape
// drops it.

use editor;
use gizmo;
use model;
use selection;
use signals;
use util;
use viewport;

pub class TexteditState {
    added: int,
    clicked_at: float,
    click_x: float,
    click_y: float,
    node: int,
    buffer: str,
    box_x: float,
    box_y: float,
    box_w: float,
    size: float,
}

/// The field: where it is in design px, the text it opens with, and the size
/// its letters are typed at, 0 for the size its role carries.
pub struct View {
    open: bool,
    x: float,
    y: float,
    width: float,
    height: float,
    text: str,
    size: float,
}

// Two clicks closer together than this many seconds, and this many design
// pixels apart, are one double-click.
const GAP: float = 0.4;

const SLOP: float = 6.0;

// The field's narrowest box, in design pixels, and its height at the size
// its role carries.
const MIN_WIDTH: float = 260.0;

const HEIGHT: float = 34.0;

// What a 2D text's letters are typed at, between these: the size they are
// drawn at, unless that is too small to read or too big to fit.
const MIN_SIZE: float = 14.0;

const MAX_SIZE: float = 96.0;

// Room the panel and the field keep around the words, in design pixels.
const PAD_W: float = 40.0;

const PAD_H: float = 16.0;

pub fn state() -> TexteditState {
    TexteditState { added: -1, clicked_at: -1.0, click_x: 0.0, click_y: 0.0, node: -1, buffer: "", box_x: 0.0, box_y: 0.0, box_w: MIN_WIDTH, size: 0.0 }
}

fn shut() -> View {
    View { open: false, x: 0.0, y: 0.0, width: 0.0, height: 0.0, text: "", size: 0.0 }
}

// The text component on a node, whichever dimension it is in; "" for none.
fn component(found: Node) -> str {
    if !found.is_valid() {
        ""
    } else if found.has_component("text2d") {
        "text2d"
    } else if found.has_component("text3d") {
        "text3d"
    } else {
        ""
    }
}

/// Whether the selection carries text, so the shell can offer the verb.
pub fn editable(state: editor::State) -> bool {
    component(model::selected_node(state)) != ""
}

/// Open the field over a text added last frame, once a frame whatever the
/// pointer did.
pub fn step(state: &mut editor::State) {
    if state.textedit.added < 0 {
        return;
    }
    let rect = gizmo::viewport_rect(state);
    open(state, state.textedit.added, rect.x + rect.width / 2.0, rect.y + rect.height / 2.0);
    state.textedit.added = -1;
}

/// Whether a text added waits for its field, which asks for the next frame.
pub fn waiting(state: editor::State) -> bool {
    state.textedit.added >= 0
}

// Watch for the second click of a pair over the selected text node.
pub fn update(state: &mut editor::State) {
    if state.textedit.node >= 0 || !input::mouse_just_pressed(input::MOUSE_BUTTON_LEFT) {
        return;
    }
    let pointer = viewport::pointer(state);
    let now = engine::unix_time();
    let quick = now - state.textedit.clicked_at < GAP;
    let near = util::abs(pointer.x - state.textedit.click_x) < SLOP && util::abs(pointer.y - state.textedit.click_y) < SLOP;
    state.textedit.clicked_at = now;
    state.textedit.click_x = pointer.x;
    state.textedit.click_y = pointer.y;
    if !quick || !near || !viewport::owns_pointer(state, pointer.x, pointer.y) || !editable(state) {
        return;
    }
    // Over the point clicked, which is over the text itself, unless the
    // text's own box on screen is known.
    open(state, state.sel, pointer.x, pointer.y);
}

/// Open the field over a text just added, which is the selection, on the
/// next frame, once its words are laid out: where a 2D one is drawn, and a
/// 3D one at the middle of the view, where an added node lands. Anything
/// else added opens nothing.
pub fn open_added(state: &mut editor::State) {
    if editable(state) {
        state.textedit.added = state.sel;
    }
}

// Open the field on row `row`, centred on (`design_x`, `design_y`) in design px or, for a 2D
// text, on the box it is drawn in, its letters at the size they are drawn.
fn open(state: &mut editor::State, row: int, design_x: float, design_y: float) {
    let found = model::node(state, row);
    let name = component(found);
    let edit = state.textedit;
    edit.node = row;
    edit.buffer = found.get_component(name, "text").as_str();
    edit.size = 0.0;
    let centre_x = design_x;
    let centre_y = design_y;
    let drawn_w = 0.0;
    // The 2D camera's zoom, which a frame with no window has not got.
    if name == "text2d" && found.has_component("transform") && render::camera_2d().z > 0.0 {
        let per_px = viewport::world_per_px(state);
        let scale = found.transform.global_scale();
        let font = found.get_component(name, "font_size").as_float();
        let per_unit = util::max(found.get_component(name, "pixels_per_unit").as_float(), 0.01);
        edit.size = util::clamp(font / per_unit * util::abs(scale.y) / per_px, MIN_SIZE, MAX_SIZE);
        let laid = render::bounds(found);
        let known = laid.is_some() && laid.unwrap().len() == 2;
        let local = if known { laid.unwrap()[0] } else { Vec3 { x: 0.0, y: 0.0, z: 0.0 } };
        if known {
            drawn_w = 2.0 * laid.unwrap()[1].x * util::abs(scale.x) / per_px;
        }
        let world = util::to_world(util::frame_of(found), local.x, local.y);
        let at = viewport::screen_of_2d(state, world.x, world.y);
        centre_x = at.x;
        centre_y = at.y;
    }
    // Wide enough for the words as drawn, or as typed at this size.
    let typed_w = (edit.buffer.len() as float) * util::max(edit.size, MIN_SIZE) * 0.6;
    edit.box_w = util::max(MIN_WIDTH, util::max(drawn_w, typed_w) + PAD_W);
    edit.box_x = centre_x - edit.box_w / 2.0;
    edit.box_y = centre_y - height(edit.size) / 2.0;
    signals::changed(state, "textedit");
}

// The field's height for letters of `size`, 0 being its role's.
fn height(size: float) -> float {
    if size > 0.0 { size * 1.3 + PAD_H } else { HEIGHT }
}

/// What the field shows: where it is, the text it opens with, and its size.
/// A node that went shuts it.
pub fn view(state: &mut editor::State) -> View {
    if state.textedit.node < 0 {
        return shut();
    }
    if component(model::node(state, state.textedit.node)) == "" {
        close(state);
        return shut();
    }
    let edit = state.textedit;
    View { open: true, x: edit.box_x, y: edit.box_y, width: edit.box_w, height: height(edit.size), text: edit.buffer, size: edit.size }
}

/// What was typed so far.
pub fn typed(state: &mut editor::State, text: str) {
    state.textedit.buffer = text;
}

/// Enter or a click away keeps the text.
pub fn submit(state: &mut editor::State, text: str) {
    state.textedit.buffer = text;
    commit(state);
}

fn commit(state: &mut editor::State) {
    let row = state.textedit.node;
    let name = component(model::node(state, row));
    if name != "" {
        // `set_component_prop` writes the selection's node, which is this one.
        let was = state.sel;
        selection::only(state, row);
        model::set_component_prop(state, name, "text", state.textedit.buffer);
        selection::only(state, was);
    }
    close(state);
}

/// Shut the field, keeping nothing it had not kept already: all Escape
/// leaves, and what a click away leaves once it kept the text.
pub fn close(state: &mut editor::State) {
    if state.textedit.node < 0 {
        return;
    }
    state.textedit.node = -1;
    state.textedit.buffer = "";
    signals::changed(state, "textedit");
}
