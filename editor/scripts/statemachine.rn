// The State machine dock: the selected node's `state_machine` as its states
// and transitions, edited in place and written back where the machine lives.

use crate::anim;
use crate::history;
use crate::model;
use crate::util;

// The component and the asset type `balaur_anim` registers, and the keys the
// component and the machine document spell.
const COMPONENT = "state_machine";
const MACHINE_TYPE = "state_machine";
const ROW_H = 24.0;
const NAME_W = 96.0;
const FIELD_W = 120.0;

/// The dock's own state, hung on `S.machine`.
pub fn state() {
    // `file` holds a file-backed machine as last read or written, so a frame
    // does not read the file again.
    #{ open: None, naming: "", file: None, demo: -1 }
}

// The machine as it is authored: an inline table, or a file's contents and
// its path. `None` when the node runs none.
fn source(S) {
    let node = crate::model::selected_row(S)?;
    let comp = node.get(COMPONENT)?;
    if !(comp is Object) {
        return None;
    }
    let machine = comp.get("machine").unwrap_or("");
    if machine is Object {
        return Some(#{ doc: machine, path: None });
    }
    if machine is String && machine != "" {
        if let Some(held) = S.machine.file {
            if held.path == machine {
                return Some(#{ doc: held.doc, path: Some(machine) });
            }
        }
        let (ok, loaded) = script::attempt(|| assets::duplicate(util::engine_path(S, machine)));
        if ok && loaded is Object {
            S.machine.file = Some(#{ path: machine, doc: loaded });
            return Some(#{ doc: loaded, path: Some(machine) });
        }
    }
    Some(#{ doc: #{ "type": MACHINE_TYPE, states: #{}, transitions: [] }, path: None })
}

// A copy to change, so the edit lands after the history step.
fn editable(S) {
    match source(S) {
        Some(found) => Some(#{ doc: util::deep(found.doc), path: found.path }),
        None => None,
    }
}

// Write `doc` back where it came from: into the scene, or over its file.
fn write(S, found, label) {
    if !crate::model::has_selection(S) {
        return;
    }
    match found.path {
        Some(path) => {
            fs::write(util::engine_path(S, path), toml::encode(found.doc));
            script::attempt(|| assets::reload(util::engine_path(S, path)));
            S.machine.file = Some(#{ path: path, doc: found.doc });
            log::info(format!("{}: {}", label, path));
        }
        None => {
            history::record(S, label, None);
            let node = S.doc[S.sel];
            let comp = node[COMPONENT];
            comp.machine = found.doc;
            model::record_override(S, node, COMPONENT);
            model::apply_component(S, COMPONENT);
            history::commit(S);
        }
    }
}

/// Give the selected node a machine of its own, driving its own player.
pub fn create(S) {
    if !crate::model::has_selection(S) {
        return;
    }
    history::record(S, "add state machine", None);
    let node = S.doc[S.sel];
    node[COMPONENT] = #{
        machine: #{ "type": MACHINE_TYPE, start: "", states: #{}, transitions: [] },
        player: "",
        active: true,
    };
    model::record_override(S, node, COMPONENT);
    model::apply_component(S, COMPONENT);
    history::commit(S);
}

fn states(doc) {
    let held = doc.get("states").unwrap_or(#{});
    if held is Object { held } else { #{} }
}

fn transitions(doc) {
    let held = doc.get("transitions").unwrap_or([]);
    if held is Vec { held } else { [] }
}

fn state_names(doc) {
    let out = [];
    for (name, _) in states(doc).iter() {
        out.push(name);
    }
    out
}

/// Add a state playing the clip of its own name.
pub fn add_state(S, name) {
    let found = match editable(S) {
        Some(found) => found,
        None => return,
    };
    if name == "" || name == animation::STATE_END || states(found.doc).contains_key(name) {
        return;
    }
    // The clip of its own name when the library has one, and otherwise the
    // library's first, so a new state plays something from the start.
    let clips = anim::clip_names(S);
    let held = states(found.doc);
    let own = clips.len() == 0 || util::contains(clips, name);
    held[name] = if own { "" } else { clips[0] };
    found.doc.states = held;
    if found.doc.get("start").unwrap_or("") == "" {
        found.doc.start = name;
    }
    write(S, found, "add state");
}

/// Remove a state, and every transition into or out of it.
pub fn remove_state(S, name) {
    let found = match editable(S) {
        Some(found) => found,
        None => return,
    };
    let held = states(found.doc);
    held.remove(name);
    found.doc.states = held;
    let kept = [];
    for t in transitions(found.doc) {
        if t.get("from").unwrap_or("") != name && t.get("to").unwrap_or("") != name {
            kept.push(t);
        }
    }
    found.doc.transitions = kept;
    if found.doc.get("start").unwrap_or("") == name {
        found.doc.start = "";
    }
    S.machine.open = None;
    write(S, found, "remove state");
}

fn set_state_clip(S, name, clip) {
    let found = match editable(S) {
        Some(found) => found,
        None => return,
    };
    let held = states(found.doc);
    held[name] = if clip == name { "" } else { clip };
    found.doc.states = held;
    write(S, found, "state clip");
}

fn set_start(S, name) {
    let found = match editable(S) {
        Some(found) => found,
        None => return,
    };
    found.doc.start = name;
    write(S, found, "start state");
}

/// Add a transition between the first two states, open for editing.
pub fn add_transition(S) {
    let found = match editable(S) {
        Some(found) => found,
        None => return,
    };
    let names = state_names(found.doc);
    if names.len() == 0 {
        return;
    }
    let to = if names.len() > 1 { names[1] } else { names[0] };
    let held = transitions(found.doc);
    held.push(#{ from: names[0], to: to, advance_mode: animation::ADVANCE_MODE_ENABLED });
    S.machine.open = Some(held.len() - 1);
    found.doc.transitions = held;
    write(S, found, "add transition");
}

pub fn remove_transition(S, at) {
    let found = match editable(S) {
        Some(found) => found,
        None => return,
    };
    let held = transitions(found.doc);
    if at >= held.len() {
        return;
    }
    held.remove(at);
    found.doc.transitions = held;
    S.machine.open = None;
    write(S, found, "remove transition");
}

/// Set one field of transition `at`; an empty text or the default removes it.
pub fn set_field(S, at, key, value) {
    let found = match editable(S) {
        Some(found) => found,
        None => return,
    };
    let held = transitions(found.doc);
    if at >= held.len() {
        return;
    }
    if value is String && value == "" {
        held[at].remove(key);
    } else {
        held[at][key] = value;
    }
    found.doc.transitions = held;
    write(S, found, "edit transition");
}

/// The dock's rows, as nodes: the pool makes them under the host the dock
/// hands over, and the header fills the dock's own chrome strip.
pub fn body(S, k) {
    let found = match source(S) {
        Some(found) => found,
        None => {
            crate::docks::chrome_rows(S, [offer(S)]);
            crate::pool::sync(S, crate::dock::rows_host(S), [], NAME_W, false);
            return;
        }
    };
    let doc = found.doc;
    crate::docks::chrome_rows(S, [header_controls(S, found)]);
    crate::pool::sync(S, crate::dock::rows_host(S), row_specs(S, doc), NAME_W, false);
}

/// What the strip says when the node runs no machine: why, and the verb that
/// gives it one.
fn offer(S) {
    // Bound, never a literal after a `}`: the block's value would be indexed
    // by the array rather than followed by it.
    let out = [#{ kind: "label", role: "text_caption", text: "select a node to give it a state machine" }];
    if crate::model::selected_row(S).is_none() {
        return out;
    }
    out = [
        #{ kind: "label", role: "text_caption", text: "no state machine on this node" },
        #{
            kind: "button", role: "action_form_secondary", text: "add state machine",
            tooltip: "Give the node an embedded `state_machine` over its own player",
            on: |_| { create(S); },
        },
    ];
    out
}

/// The strip over the rows: where the machine lives, the state it starts in,
/// and the state it is in while the game runs.
fn header_controls(S, found) {
    let doc = found.doc;
    let place = match found.path {
        Some(path) => path,
        None => "inline",
    };
    let out = [
        #{ kind: "label", role: "text_caption", text: place },
        #{ kind: "label", role: "text_caption", text: "start" },
        #{
            kind: "dropdown", role: "choice_form", width: FIELD_W,
            text: doc.get("start").unwrap_or(""), options: state_names(doc),
            on: |picked| { set_start(S, picked); },
        },
    ];
    let now = live_state(S);
    if now != "" {
        out.push(#{ kind: "label", role: "chip", checked: true, text: format!("now {}", now) });
    }
    out
}

// While the game runs, the state the machine is in; "" when it is not running
// or the live node answers nothing.
fn live_state(S) {
    if !S.playing {
        return "";
    }
    let (_, live_node) = model::selected(S);
    let found = match live_node {
        Some(node) => node,
        None => return "",
    };
    let (ok, now) = script::attempt(|| found.state_machine.current_state());
    if ok && now is String { now } else { "" }
}

/// Every row the dock shows: the states, the new-state row, the transitions,
/// and the fields of whichever transition is open.
fn row_specs(S, doc) {
    let out = [head_spec("STATES", [])];
    let clips = anim::clip_names(S);
    for (name, clip) in states(doc).iter() {
        // Bound afresh: a closure made in a loop captures the binding.
        let state = name;
        let control = if clip is String {
            #{
                kind: "dropdown", role: "choice_form", width: FIELD_W,
                text: if clip == "" { state } else { clip }, options: clips,
                on: |picked| { set_state_clip(S, state, picked); },
            }
        } else {
            #{ kind: "label", role: "text_caption", text: "nested machine" }
        };
        out.push(#{ label: state, height: ROW_H, slot_role: "layout_actions", controls: [
            control,
            #{
                kind: "button", role: "chip_quiet", text: "×",
                tooltip: "Remove the state and its transitions",
                on: |_| { remove_state(S, state); },
            },
        ] });
    }
    out.push(#{ full: true, height: ROW_H, slot_role: "layout_actions", controls: [
        #{
            kind: "text_field", role: "input_form", width: NAME_W + FIELD_W,
            text: S.machine.naming, placeholder: "new state",
            on: |text| { S.machine.naming = text; },
            on_submit: |text| { named(S, text); },
        },
        #{
            kind: "button", role: "action_form_secondary", text: "add state",
            tooltip: "A state playing the clip of its own name",
            on: |_| { named(S, S.machine.naming); },
        },
    ] });
    transition_specs(S, doc, out);
    out
}

// Add whatever the new-state field holds, and empty it.
fn named(S, text) {
    if text == "" {
        return;
    }
    add_state(S, text);
    S.machine.naming = "";
}

fn transition_specs(S, doc, out) {
    out.push(head_spec("TRANSITIONS", [#{
        kind: "button", role: "action_form_secondary", text: "add transition",
        tooltip: "A transition between two states, opened for editing",
        on: |_| { add_transition(S); },
    }]));
    let names = state_names(doc);
    // `end` is somewhere a transition goes, never somewhere one leaves.
    let targets = state_names(doc);
    targets.push(animation::STATE_END);
    for (at, t) in transitions(doc).iter().enumerate() {
        // Bound afresh: a closure made in a loop captures the binding.
        let index = at;
        let open = S.machine.open == Some(index);
        out.push(#{ full: true, height: ROW_H, slot_role: "layout_actions", controls: [
            #{
                kind: "button", min_width: NAME_W + FIELD_W,
                role: "item_list", checked: open,
                text: format!("{} → {}  {}", t.get("from").unwrap_or("?"),
                    t.get("to").unwrap_or("?"),
                    t.get("advance_mode").unwrap_or(animation::ADVANCE_MODE_ENABLED)),
                tooltip: "Open the transition's fields",
                on: |_| { S.machine.open = if open { None } else { Some(index) }; },
            },
            #{
                kind: "button", role: "chip_quiet", text: "×",
                tooltip: "Remove the transition",
                on: |_| { remove_transition(S, index); },
            },
        ] });
        if open {
            field_specs(S, index, t, names, targets, out);
        }
    }
}

/// A heading across the rows, with whatever verbs belong beside it.
fn head_spec(text, verbs) {
    let controls = [#{ kind: "label", role: "text_caption", text: text }];
    for verb in verbs {
        controls.push(verb);
    }
    #{ full: true, height: ROW_H, slot_role: "layout_actions", controls: controls }
}

// The label a transition's own field wears: indented, so the fields read as
// belonging to the row above them.
fn field_spec(label, control) {
    #{ label: "    " + label, height: ROW_H, controls: [control] }
}

fn choice(S, at, key, current, choices) {
    #{
        kind: "dropdown", role: "choice_form", width: FIELD_W,
        text: current, options: choices,
        on: |picked| { set_field(S, at, key, picked); },
    }
}

fn text_of(S, at, key, current, placeholder) {
    #{
        kind: "text_field", role: "input_form", width: FIELD_W,
        text: current, placeholder: placeholder,
        on_submit: |value| {
            if value != current {
                set_field(S, at, key, value);
            }
        },
    }
}

// `whole` is both how it steps and what it writes: a drag value shows as many
// decimals as its speed has, and `priority` parses a whole number only.
fn number(S, at, key, current, whole) {
    #{
        kind: "number_field", role: "input_number", width: FIELD_W,
        value: util::f(current), min: 0.0, max: if whole { 1000.0 } else { 100.0 },
        step: if whole { 1.0 } else { 0.01 },
        on: |v| { set_field(S, at, key, if whole { util::i(v) } else { v }); },
    }
}

fn flag(S, at, key, on) {
    #{
        kind: "switch", role: "switch_form", checked: on,
        on: |v| { set_field(S, at, key, v); },
    }
}

fn field_specs(S, at, t, names, targets, out) {
    out.push(field_spec("from", choice(S, at, "from", t.get("from").unwrap_or(""), names)));
    out.push(field_spec("to", choice(S, at, "to", t.get("to").unwrap_or(""), targets)));
    out.push(field_spec("blend time", number(S, at, "blend_time", t.get("blend_time").unwrap_or(0.0), false)));
    out.push(field_spec("ease", choice(S, at, "ease", t.get("ease").unwrap_or(animation::EASE_LINEAR),
        util::vec(animation::ease_names()))));
    out.push(field_spec("advance mode", choice(S, at, "advance_mode",
        t.get("advance_mode").unwrap_or(animation::ADVANCE_MODE_ENABLED),
        [animation::ADVANCE_MODE_DISABLED, animation::ADVANCE_MODE_ENABLED, animation::ADVANCE_MODE_AUTO])));
    out.push(field_spec("switch mode", choice(S, at, "switch_mode",
        t.get("switch_mode").unwrap_or(animation::SWITCH_MODE_IMMEDIATE),
        [animation::SWITCH_MODE_IMMEDIATE, animation::SWITCH_MODE_SYNC, animation::SWITCH_MODE_AT_END])));
    out.push(field_spec("condition", text_of(S, at, "condition", t.get("condition").unwrap_or(""), "none")));
    out.push(field_spec("check", text_of(S, at, "check", t.get("check").unwrap_or(""), "no method")));
    out.push(field_spec("priority", number(S, at, "priority", t.get("priority").unwrap_or(1), true)));
    out.push(field_spec("reset", flag(S, at, "reset", t.get("reset").unwrap_or(true))));
    out.push(field_spec("break loop at end", flag(S, at, "break_loop_at_end",
        t.get("break_loop_at_end").unwrap_or(false))));
}

fn check(ok, what) {
    if ok {
        log::info(format!("selftest ok: {}", what));
    } else {
        log::error(format!("selftest FAILED: {}", what));
    }
}

/// `--state machinedemo`: on the first node with a player, add a state and a
/// transition, edit and remove them, and undo back to the scene as it was.
pub fn selftest(S) {
    let player = None;
    for i in 0..S.doc.len() {
        if S.doc[i].contains_key("animation") {
            player = Some(i);
            break;
        }
    }
    let player = match player {
        Some(player) => player,
        None => {
            log::info("selftest state machine: no player; skipped");
            return;
        }
    };
    crate::shell::choose(S, player);
    let before = toml::encode(util::deep(S.doc[player]));
    if source(S).is_none() {
        create(S);
    }
    check(source(S).is_some(), "the node runs a state machine");

    add_state(S, "sm_probe");
    let doc = source(S).unwrap().doc;
    check(states(doc).contains_key("sm_probe"), "a state is added");

    let count = transitions(doc).len();
    add_transition(S);
    let at = count;
    set_field(S, at, "to", "sm_probe");
    set_field(S, at, "blend_time", 0.3);
    set_field(S, at, "advance_mode", animation::ADVANCE_MODE_AUTO);
    set_field(S, at, "priority", 2);
    let t = transitions(source(S).unwrap().doc)[at];
    check(t.get("blend_time") == Some(0.3) && t.get("advance_mode") == Some(animation::ADVANCE_MODE_AUTO),
        "a transition's fields are written");
    check(t.get("priority") == Some(2), "priority stays a whole number");
    set_field(S, at, "condition", "go");
    set_field(S, at, "condition", "");
    let t = transitions(source(S).unwrap().doc)[at];
    check(t.get("condition").is_none(), "an emptied field is removed");

    remove_state(S, "sm_probe");
    let doc = source(S).unwrap().doc;
    let dangling = false;
    for t in transitions(doc) {
        if t.get("to").unwrap_or("") == "sm_probe" {
            dangling = true;
        }
    }
    check(!states(doc).contains_key("sm_probe") && !dangling,
        "removing a state removes its transitions");

    let guard = 0;
    while crate::history::can_undo(S) && guard < 200 {
        crate::shell::undo(S);
        guard += 1;
    }
    check(toml::encode(util::deep(S.doc[player])) == before, "undoing everything restores the node");
    // Left on the dock with a transition open, so the shot this state takes
    // is of the fields as well as the rows.
    crate::docks::show(S, "statemachine");
    // Only where the scene authored one: the undo above took back the machine
    // this test made, so a node that came with none has none now.
    if let Some(found) = source(S) {
        if transitions(found.doc).len() > 0 {
            S.machine.open = Some(0);
            S.machine.demo = 0;
        }
    }
    log::info("selftest state machine: done");
}

// Two frames: the pool writes the rows on the first draw after this, and a
// node reports the box it was given the pass after it was laid out.
const ROWS_SETTLED = 3;

/// What the dock put on the scene, once it has drawn: the rows are nodes, and
/// an open transition is its fields under the row that opened it.
pub fn demo_step(S) {
    S.machine.demo = S.machine.demo + 1;
    if S.machine.demo < ROWS_SETTLED {
        return;
    }
    S.machine.demo = -1;
    let host = scene::get_node(crate::dock::rows_host(S));
    let labels = [];
    for row in host.children() {
        let label = row.get_node("L");
        if !util::is_nil(label) && label.get_component("widget", "visible") == true {
            labels.push(label.get_component("widget", "text"));
        }
    }
    check(util::contains(labels, "wave") || util::contains(labels, "bow"),
        format!("the states are rows on the scene ({:?})", labels));
    check(util::contains(labels, "    from") && util::contains(labels, "    priority"),
        format!("an open transition puts its fields under it ({:?})", labels));
}
