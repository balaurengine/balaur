//! A tab: its name, and the mark that closes it where it closes, as one tile.
//! The bar's open documents and a dock's panels are this and nothing else;
//! the theme's `tile_tab` and `tab_label` roles say how it looks.

use icons;
use words::roles;

/// One tab as one tile: the row's role carries the fill and the corners, and
/// the name and the close mark paint only their ink, each lighting up on its
/// own under the pointer so a click lands on the half it was aimed at.
/// `in_bar` takes the bar's height for it. `pick` and `close` are buttons
/// carrying the caller's `on_click`, `target`, `data` and `tooltip`; nil for `close`
/// is a tab that does not close.
pub fn tile(label: str, icon: str, active: bool, in_bar: bool, pick: ui::Control, close: ui::Control?) -> ui::Control {
    // Built by pushing: a `[` after an `if` block is read as indexing it.
    let inner: [ui::Control] = [];
    inner.push(ui::Control {
        kind: ui::WIDGET_BUTTON,
        text: label,
        icon: icon,
        role: if in_bar { roles::TAB_LABEL_BAR } else { roles::TAB_LABEL },
        checked: active,
        tooltip: pick.tooltip.or(""),
        on_click: pick.on_click.or(""),
        target: pick.target,
        data: pick.data,
    });
    if close != nil {
        let mark = close.unwrap();
        inner.push(ui::Control {
            kind: ui::WIDGET_BUTTON,
            text: "",
            icon: icons::ui(icons::CLOSE),
            role: roles::ICON_ACTION_TAB,
            tooltip: mark.tooltip.or("Close"),
            on_click: mark.on_click.or(""),
            target: mark.target,
            data: mark.data,
        });
    }
    ui::Control {
        role: if active { roles::TILE_TAB_PRIMARY } else { roles::TILE_TAB },
        align_items: ui::ALIGN_CENTER,
        controls: inner,
    }
}
