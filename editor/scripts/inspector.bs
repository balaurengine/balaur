// The Inspector: the selected node's components as lines, walked when what it
// shows changes, a row of the pool only while on screen. PLAN-editor-as-scene §9.4.

use anim;
use drawers;
use editor;
use events;
use icons;
use lint;
use model;
use plugins;
use search;
use selection;
use shell;
use signals;
use style;
use util;

/// Where a row writes: the component, the property, the steps into its value,
/// the row's label, and the value as it was walked, for where nothing live
/// answers.
pub struct AtTop {
    internal component: str,
    internal property: str,
    internal path: [any],
    internal label: str,
    internal whole: any,
}

/// The material a node draws with while it names none: the asset, the path
/// of the node naming it, and whether that is the node itself.
pub struct Inherited {
    internal material: str,
    internal node: str,
    internal here: bool,
}

/// What the Inspector panel's head says.
pub struct View {
    selected: bool,
    icon: str,
    icon_color: str,
    name: str,
    kind: str,
    add_icon: str,
}

/// One row of the form: what it shows and where it sits. `count` is how many
/// lines its property took, on the first of them, and 0 on the others.
pub class Line {
    internal kind: str,
    internal at: AtTop,
    internal key: str = "",
    internal count: int = 0,
    internal spec: any,
    /// The property's own spec, on the first of its lines.
    internal root: any,
    /// What a nested line holds, as the walk found it. A property of its own
    /// is read off the node when it is drawn.
    internal value: any,
    internal height: float = 0.0,
    top: float = 0.0,
    labelled: bool = true,
    /// A mark on the row's label (`MARK_WARNING`, `MARK_OVERRIDE`), and why.
    internal mark: str = "",
    internal why: str = "",
    /// What a chip on the row takes out of the list or map it sits in.
    internal holder: AtTop?,
    internal step: any,
    /// A row the walk built whole: a note, or a pointer at another view.
    internal row: ui::Row?,
    drawn: bool = false,
    shown: any,
}

/// The form: every line, the name each is found by, and which of them hold a
/// row. A slot is `index % capacity`, so a line entering the window takes the
/// one a line just left and nothing else is written.
pub class Form {
    internal lines: [Line],
    /// A line by `key`: `component.property` for the first of a property's.
    named: { str: int },
    /// What each section shows, for a whole component written.
    properties: { str: [str] },
    layouts: any,
    /// What the engine says is off about the node, and by what it names.
    warnings: any,
    warned: any,
    warned_whole: any,
    overridden: any,
    plugin_values: any,
    internal node: Node,
    /// The script the node names as the walk found it.
    script_rel: str,
    panel: Node,
    host: Node,
    scroller: Node,
    /// Where a walk puts the lines it pushes, and how many it has made.
    base: int,
    walks: int,
    removing: any,
    internal capacity: int,
    /// What each slot holds, by line and by key; `SLOT_EMPTY` and "" for a hidden one.
    slots: [int],
    slot_keys: [str],
    first: int,
    internal last: int,
    offset: float,
    view: float,
    internal total: float,
    label_width: float,
    stacked: bool,
    /// Rows written, which is what a test counts.
    internal written: int,
}

pub fn fresh() -> Form {
    Form {
        lines: [],
        named: {},
        properties: {},
        layouts: {},
        warnings: nil,
        warned: {},
        warned_whole: {},
        overridden: {},
        plugin_values: {},
        node: nil,
        script_rel: "",
        panel: nil,
        host: nil,
        scroller: nil,
        base: 0,
        walks: 0,
        removing: nil,
        capacity: 0,
        slots: [],
        slot_keys: [],
        first: 0,
        last: 0,
        offset: 0.0,
        view: 0.0,
        total: 0.0,
        label_width: 0.0,
        stacked: false,
        written: 0,
    }
}

const PANEL: str = "Editor/Shell/Body/Right/RightSheet/Inspector";
const FORM: str = "Editor/Shell/Body/Right/RightSheet/Inspector/Scroll/Form";
const SCROLLER: str = "Editor/Shell/Body/Right/RightSheet/Inspector/Scroll";

/// A line's kinds: a property or a value inside one, a section's or a group's
/// head, and a row built whole.
pub const VALUE: str = "value";
pub const HEAD: str = "head";
pub const FOLD: str = "fold";
pub const FIXED: str = "fixed";

/// The `script` component: its properties are what the file exports, beside
/// `source`, the file itself. A component name is an identifier, and the
/// engine registers none by this one: a node's script is its own key.
pub const SCRIPT: str = "script";
pub const SCRIPT_SOURCE: str = "source";

/// The property a section's head carries rather than a row.
pub const ENABLED: str = "enabled";

pub const MARK_WARNING: str = "warning";
pub const MARK_OVERRIDE: str = "override";

const LABEL_WIDTH: float = 82.0;
const LINE_GAP: float = 2.0;
// The pool's label line over a stacked row, and its air.
const STACKED_LABEL: float = 18.0;
// No line is shorter than this, which is what the window's slots are sized by.
const SHORTEST_LINE: float = 22.0;
// Lines kept built past each edge of the view, so a small scroll writes none.
const OVERSCAN: int = 6;
// What a slot holds that is no line: nothing, or what another run left on it.
const SLOT_EMPTY: int = -1;
const SLOT_LEFT: int = -2;
// The control width the rows were drawn at. Under it the label goes above the
// control and each takes the whole row, as Godot's inspector does in a narrow
// dock.
const CONTROL_MIN: float = 180.0;

/// Every component on the selection.
pub fn node_components(state: &mut editor::State) -> [str] {
    let found = model::selected_node(state);
    if found.is_valid() {
        return found.component_names();
    }
    return [];
}

/// How many of the pool's rows are showing: a row left hidden is visible to a
/// test rather than only to the eye.
pub fn drawn_rows() -> int {
    let host = scene::get_node(FORM);
    if !host.is_valid() {
        return -1;
    }
    let shown = 0;
    for row in host.children() {
        if row.visible() {
            shown += 1;
        }
    }
    shown
}

/// How many rows the pool has ever made for the form.
pub fn made_rows() -> int {
    let host = scene::get_node(FORM);
    if host.is_valid() { host.children().len() } else { 0 }
}

/// The node a labelled row's first control is on, while it is on screen.
pub fn control_of(state: editor::State, label: str) -> Node {
    let form = state.inspect;
    for index in form.first..form.last {
        if form.lines[index].at.label == label {
            let row = scene::get_node("{FORM}/R{index % form.capacity}");
            if row.is_valid() {
                return row.get_node("H/C/C0");
            }
        }
    }
    nil
}

/// The pool's row for the line named `key`, while it is on screen.
pub fn row_of_line(state: editor::State, key: str) -> Node {
    let form = state.inspect;
    let at = form.named[key];
    if at == nil || at.unwrap() < form.first || at.unwrap() >= form.last {
        return nil;
    }
    scene::get_node("{FORM}/R{at.unwrap() % form.capacity}")
}

/// The line named `key`, or nil: what a self-test asks of a row.
pub fn line_named(state: editor::State, key: str) -> Line? {
    let at = state.inspect.named[key];
    if at == nil { nil } else { state.inspect.lines[at.unwrap()] }
}

/// Scroll the form to `offset`, as a reader would.
pub fn scroll_to(state: &mut editor::State, offset: float) {
    let found = scroller_of(state);
    if found.is_valid() {
        found.widget_scroll.scroll_offset = vec2(0.0, offset);
    }
    scrolled(state, offset);
}

/// A form row and the control inside it, taller where a finger picks them.
pub fn row_height(state: editor::State) -> float {
    style::row_height(state)
}

pub fn control_height(state: editor::State) -> float {
    if state.touchscreen { 29.0 } else { 20.0 }
}

// The label column, derived from the form: at a width neither column fits,
// the label gives way first and the control keeps a usable size.
pub fn label_width(state: editor::State) -> float {
    util::clamp(form_width(state) * 0.34, 46.0, LABEL_WIDTH)
}

// The form's own width, as its rows were last drawn: a frame late, like every
// box the layout reads back, and the sheet's inside until there is a frame.
fn form_width(state: editor::State) -> float {
    let host = scene::get_node(FORM);
    if host.is_valid() {
        let rect_or = ui::widget_rect(host);
        if rect_or != nil && rect_or.unwrap().width > 0.0 {
            return rect_or.unwrap().width;
        }
    }
    state.layout["right"]["width"].as_float() - 16.0
}

/// Whether a row puts its label above its control rather than beside it.
pub fn stacked(state: editor::State) -> bool {
    form_width(state) - label_width(state) - 6.0 < CONTROL_MIN
}

fn panel_of(state: &mut editor::State) -> Node {
    let form = state.inspect;
    if !form.panel.is_valid() {
        form.panel = scene::get_node(PANEL);
    }
    form.panel
}

fn host_of(state: &mut editor::State) -> Node {
    let form = state.inspect;
    if !form.host.is_valid() {
        form.host = scene::get_node(FORM);
    }
    form.host
}

fn scroller_of(state: &mut editor::State) -> Node {
    let form = state.inspect;
    if !form.scroller.is_valid() {
        form.scroller = scene::get_node(SCROLLER);
    }
    form.scroller
}

/// Whether the Inspector is on screen. A hidden one does nothing, and is
/// filled when it is shown again.
fn showing(state: &mut editor::State) -> bool {
    let panel = panel_of(state);
    panel.is_valid() && panel.visible_in_tree()
}

pub fn show_panel(state: &mut editor::State) {
    let found = panel_of(state);
    if found.is_valid() && !found.visible() {
        found.set_visible(true);
        signals::refill_inspector(state);
    }
}

pub fn hide_panel() {
    util::hide(PANEL);
}

/// The verb under the form: a component for the selected node, from the
/// palette.
pub fn add(state: &mut editor::State) {
    if model::has_selection(state) {
        shell::open_palette(state, "add ");
    }
}

/// What the Inspector panel's head says, and whether there is a node to
/// show at all.
pub fn view(state: editor::State) -> View {
    if !model::has_selection(state) {
        return View { selected: false, icon: "", icon_color: "", name: "", kind: "", add_icon: "" };
    }
    let tokens = state.theme;
    let node = model::selected_node(state);
    let icon = model::node_icon(node);
    View {
        selected: true,
        icon: icon.glyph,
        icon_color: if tokens[icon.role] == nil { tokens["primary_text"].as_str() } else { tokens[icon.role].as_str() },
        name: node.name(),
        kind: model::node_type(node),
        add_icon: icons::ui("add"),
    }
}

/// Walk the form again for the selection, filtered by `query`, and put what
/// is on screen on the pool's rows.
pub fn fill(state: &mut editor::State, query: str) {
    state.search["inspector"] = query;
    refill(state);
}

/// `fill` with the query it has.
pub fn refill(state: &mut editor::State) {
    if !model::has_selection(state) {
        util::hide(FORM);
        return;
    }
    if !showing(state) {
        return;
    }
    walk(state);
    place(state, true);
}

/// The window again, when the view changed size: the rows that moved or came
/// on screen, and every row when the width moved how a row is laid out.
pub fn resized(state: &mut editor::State) {
    if !model::has_selection(state) || !showing(state) || state.inspect.lines.len() == 0 {
        return;
    }
    let form = state.inspect;
    let moved = label_width(state) != form.label_width || stacked(state) != form.stacked;
    if moved {
        for line in form.lines {
            line.drawn = false;
        }
    }
    place(state, moved);
}

/// The form scrolled: the lines coming on screen take the slots of those
/// leaving, and nothing else is built.
pub fn scrolled(state: &mut editor::State, offset: float) {
    let form = state.inspect;
    if form.lines.len() == 0 || !showing(state) {
        return;
    }
    form.offset = offset;
    set_window(state, false);
}

/// What the frame's change log named: the rows of component `name`'s
/// `properties`, or of all it shows for none, and no others.
pub fn rows_moved(state: &mut editor::State, name: str, properties: [str]?) {
    let form = state.inspect;
    if form.lines.len() == 0 || !showing(state) {
        return;
    }
    let named = if properties == nil { form.properties[name].or([]) } else { properties.unwrap() };
    let walked = form.walks;
    for property in named {
        let at = form.named["{name}.{property}"];
        if at != nil {
            rewrite(state, at.unwrap(), true);
            // A list that grew walked the whole form, with every row in it.
            if form.walks != walked {
                return;
            }
        }
    }
}

/// A frame of play: the rows on screen read again, those whose value moved
/// written. True while the scene plays, which is all a frame of it moves.
pub fn reread(state: &mut editor::State) -> bool {
    if !state.playing {
        return false;
    }
    let form = state.inspect;
    if form.lines.len() == 0 || !showing(state) {
        return true;
    }
    let walked = form.walks;
    for index in form.first..form.last {
        if form.lines[index].count > 0 {
            rewrite(state, index, false);
            if form.walks != walked {
                return true;
            }
        }
    }
    true
}

/// Whether the script the node names still is what the form shows: a write
/// of what it sets moves rows and nothing else.
pub fn script_stands(state: editor::State, found: Node) -> bool {
    state.inspect.lines.len() > 0 && state.inspect.node == found && as_text(model::script_rel(found)) == state.inspect.script_rel
}

// The lines of the property starting at `index`: written where it is one row,
// walked again where its value decides how many. A frame of play, not `told`
// of a write, looks first: an asset's file moves under a reference that stands.
fn rewrite(state: &mut editor::State, index: int, told: bool) {
    let form = state.inspect;
    let head = form.lines[index];
    if head.count == 1 && !unfolds(head.root) {
        if index >= form.first && index < form.last {
            draw_line(state, index);
        }
        return;
    }
    let now = read_property(state, head.at.component, head.at.property, head.root);
    if !told && now == head.at.whole {
        return;
    }
    let kept = form.lines;
    form.lines = [];
    form.base = index;
    walk_property(state, head.at.component, head.at.property, head.root);
    let fresh = form.lines;
    form.lines = kept;
    form.base = 0;
    if fresh.len() != head.count {
        refill(state);
        return;
    }
    for offset in 0..fresh.len() {
        let was = kept[index + offset];
        let line = fresh[offset];
        line.top = was.top;
        line.height = was.height;
        kept[index + offset] = line;
        if index + offset >= form.first && index + offset < form.last {
            draw_line(state, index + offset);
        }
    }
}

// A property a value decides the rows of: a list's entries, a variant's
// fields, an asset's own properties.
fn unfolds(spec: any) -> bool {
    let datatype = spec["type"].as_str();
    !spec["readonly"].as_bool() && (datatype == "list" || datatype == "map" || datatype == "record" || datatype == "variant" || datatype == "asset")
}

fn walk(state: &mut editor::State) {
    let form = state.inspect;
    form.walks += 1;
    form.lines = [];
    form.named = {};
    form.properties = {};
    form.removing = nil;
    form.plugin_values = {};
    let node = model::selected_node(state);
    form.node = node;
    form.script_rel = as_text(model::script_rel(node));
    read_marks(state, node);
    multi_note(state);
    instance_note(state, node);
    component_sections(state);
    script_section(state, node);
    plugin_sections(state, node);
}

fn blank() -> AtTop {
    AtTop { component: "", property: "", path: [], label: "", whole: nil }
}

fn push_line(state: &mut editor::State, line: Line) -> Line {
    let form = state.inspect;
    if line.key != "" {
        form.named[line.key] = form.base + form.lines.len();
    }
    form.lines.push(line);
    line
}

// A row built whole, a note or a pointer at another view; `key` is what an
// edit on one of its controls names it by.
fn fixed_line(state: &mut editor::State, key: str, row: ui::Row) {
    let labelled = row.label != nil && row.label.unwrap() != "";
    push_line(state, Line { kind: FIXED, at: blank(), key: key, row: row, height: row.height.or(row_height(state)), labelled: labelled });
}

/// A line of text spanning both columns.
fn note_line(state: &mut editor::State, height: float, role: str, text: str) {
    fixed_line(state, "", ui::Row {
        height: height,
        controls: [ui::Control { kind: "label", role: role, grow: 1, truncate: true, text: text, tooltip: text }],
    });
}

// What the engine says is off, and what the node changes of its prefab: each
// a mark on its row (`Line.mark`), a section's head where it names no row.
fn read_marks(state: &mut editor::State, node: Node) {
    let form = state.inspect;
    let by_property: any = {};
    let whole: any = {};
    form.warnings = util::list_or_empty(scene::warnings(node));
    for warning in form.warnings {
        let component = warning["component"].as_str();
        let key = if warning["property"] == nil { component } else { "{component}.{warning["property"].as_str()}" };
        let into = if warning["property"] == nil { whole } else { by_property };
        if !into.has(key) {
            let none: [any] = [];
            into[key] = none;
        }
        into[key].push(warning["message"]);
    }
    form.warned = by_property;
    form.warned_whole = whole;
    form.overridden = if model::is_instanced(node) || node.instance() != nil { node.overrides() } else { {} };
}

fn multi_note(state: &mut editor::State) {
    let count = selection::count(state);
    if count < 2 {
        return;
    }
    fixed_line(state, "", ui::Row {
        height: row_height(state) + 4.0,
        controls: [
            ui::Control {
                kind: "panel",
                role: "note_primary",
                grow: 1,
                icon: icons::ui("select-all"),
                text: if state.compact {
                    "{count} nodes selected"
                } else {
                    "{count} nodes selected · editing applies to all"
                },
            },
        ],
    });
}

// Which prefab a node came from, and a way into it. A row a node changes of
// it wears a mark, so this says no more.
fn instance_note(state: &mut editor::State, node: Node) {
    let built = model::is_instanced(node);
    if !built && node.instance() == nil {
        return;
    }
    let key = "@prefab";
    fixed_line(state, key, ui::Row {
        height: row_height(state),
        label: "Prefab",
        controls: [
            ui::Control {
                role: "sheet_prefab",
                grow: 1,
                controls: [
                    ui::Control { kind: "label", role: "text_code_secondary", grow: 1, truncate: true, text: if built { model::prefab_of(node) } else { node.instance().or("") } },
                    ui::Control {
                        kind: "button",
                        role: "action_prefab",
                        text: "open",
                        tooltip: "Open the prefab; an edit there reaches every copy of it",
                        on_click: "inspector_edit",
                        data: { "line": key, "fn": on_prefab_open },
                    },
                ],
            },
        ],
    });
}

fn on_prefab_open(state: &mut editor::State, _line: Line, _data: any, _value: any) {
    model::open_prefab(state);
}

/// The node's components with each above the ones it needs, so the transform a
/// body and a bone both expect sits under them rather than over them.
///
/// Kahn's order over `expects`: a component is drawn once nothing left still
/// needs it. A cycle keeps registration order for what is left of it rather
/// than dropping those sections.
fn ordered_components(state: &mut editor::State, names: [str]) -> [str] {
    let waiting: any = {};
    for name in names {
        waiting[name] = 0;
    }
    for name in names {
        for need in util::list_or_empty(model::expects(state, name)) {
            let key = need.as_str();
            if waiting.has(key) {
                waiting[key] = waiting[key].as_int() + 1;
            }
        }
    }
    let out: [str] = [];
    let left = names;
    for _round in 0..names.len() {
        if left.len() == 0 {
            break;
        }
        let ready: [str] = [];
        let held: [str] = [];
        for name in left {
            if waiting[name].as_int() == 0 {
                ready.push(name);
            } else {
                held.push(name);
            }
        }
        if ready.len() == 0 {
            for name in held {
                out.push(name);
            }
            return out;
        }
        for name in ready {
            out.push(name);
            for need in util::list_or_empty(model::expects(state, name)) {
                let key = need.as_str();
                if waiting.has(key) {
                    waiting[key] = waiting[key].as_int() - 1;
                }
            }
        }
        left = held;
    }
    out
}

// A section for each component on the node, then what names no component the
// node has: a write refused left it without one.
fn component_sections(state: &mut editor::State) {
    let all = node_components(state);
    for warning in state.inspect.warnings {
        if !util::contains(all, warning["component"].as_str()) {
            note_line(state, row_height(state), "note_warning", "⚠ " + lint::describe(warning));
        }
    }
    let query = search::query(state, "inspector");
    let drew = 0;
    for component in ordered_components(state, all) {
        // Its rows are a table of tables, which the Events view already draws.
        if component == "bindings" {
            drew += 1;
            bindings_section(state);
            continue;
        }
        let schema = model::schema(state, component);
        // The component's name and every property it has, so a query for a
        // property finds the section that holds it.
        if query != "" && !search::matches(query, "{component} {util::join(util::keys_sorted(schema), " ")}") {
            continue;
        }
        drew += 1;
        section(state, component, schema, layout_of(state, component, schema), true);
    }
    if drew == 0 {
        let text = if all.len() == 0 { "this node has no components" } else { "no component matches the search" };
        note_line(state, row_height(state) + 2.0, "text_note", text);
    }
}

// A pointer at the Events view, in place of the rows no drawer can show.
fn bindings_section(state: &mut editor::State) {
    head_line(state, "bindings", false);
    let key = "@bindings";
    fixed_line(state, key, ui::Row {
        height: row_height(state) + 2.0,
        controls: [
            ui::Control {
                kind: "button",
                role: "action_note",
                grow: 1,
                text: "{events::rows(state).len()} row(s) · open the Bindings view",
                icon: icons::ui("events"),
                on_click: "inspector_edit",
                data: { "line": key, "fn": on_bindings_open },
            },
        ],
    });
}

fn on_bindings_open(state: &mut editor::State, _line: Line, _data: any, _value: any) {
    shell::open_doc(state, "events");
}

/// A section's rows, worked out once for a schema: the properties with no
/// group, then each group's, all in the order the schema writes them. The
/// head carries `enabled`, so it has no row of its own.
fn layout_of(state: &mut editor::State, component: str, schema: any) -> any {
    let cached = state.inspect.layouts[component];
    if cached != nil {
        return cached;
    }
    let laid = lay_out(schema);
    state.inspect.layouts[component] = laid;
    laid
}

fn lay_out(schema: any) -> any {
    let loose: [str] = [];
    let grouped: any = {};
    // Groups in the order the schema first names them.
    let order: [str] = [];
    for property in schema.keys() {
        if property == ENABLED && schema[property]["type"].as_str() == "bool" {
            continue;
        }
        let group = schema[property]["group"].as_str();
        if group == "" {
            loose.push(property);
            continue;
        }
        if !grouped.has(group) {
            let none: [str] = [];
            grouped[group] = none;
            order.push(group);
        }
        grouped[group].push(property);
    }
    let groups: [any] = [];
    for group in order {
        groups.push({ "name": group, "properties": grouped[group] });
    }
    { "loose": loose, "groups": groups }
}

fn section(state: &mut editor::State, name: str, schema: any, laid: any, removable: bool) {
    let form = state.inspect;
    let enabled: any = if schema[ENABLED] != nil && schema[ENABLED]["type"].as_str() == "bool" { schema[ENABLED] } else { nil };
    let open = head_line(state, name, removable, enabled);
    let shown: [str] = [];
    form.properties[name] = shown;
    if enabled != nil {
        shown.push(ENABLED);
    }
    if !open {
        return;
    }
    for property in util::list_or_empty(laid["loose"]) {
        shown.push(property.as_str());
        walk_property(state, name, property.as_str(), schema[property.as_str()]);
    }
    let searching = search::query(state, "inspector") != "";
    for group in util::list_or_empty(laid["groups"]) {
        let properties = util::list_or_empty(group["properties"]);
        if !fold_line(state, name, group["name"].as_str(), properties.len(), searching) {
            continue;
        }
        for property in properties {
            shown.push(property.as_str());
            walk_property(state, name, property.as_str(), schema[property.as_str()]);
        }
    }
}

// A section's head, which folds it, and whether it is open. Its key is its
// `enabled` property's, so the log finds it like any other row; `enabled` is
// that property's spec, nil for a component with none.
fn head_line(state: &mut editor::State, name: str, removable: bool, enabled: any) -> bool {
    let store_key = "inspector/{name}";
    let open = !state.collapsed.has(store_key);
    let whole = state.inspect.warned_whole[name];
    let flagged = whole != nil || warned_in(state, name);
    let line = Line {
        kind: HEAD,
        at: at_top(name, ENABLED),
        key: "{name}.{ENABLED}",
        count: if enabled != nil { 1 } else { 0 },
        spec: { "open": open, "key": store_key, "store": "collapsed", "removable": removable, "enabled": enabled != nil },
        root: enabled,
        height: row_height(state),
        labelled: false,
        mark: if flagged { MARK_WARNING } else { "" },
        why: if whole == nil { "" } else { util::join(as_texts(whole), "\n") },
    };
    push_line(state, line);
    open
}

fn as_texts(list: any) -> [str] {
    let out: [str] = [];
    for one in list {
        out.push(one.as_str());
    }
    out
}

fn warned_in(state: editor::State, component: str) -> bool {
    let prefix = component + ".";
    for key in state.inspect.warned.keys() {
        if key.starts_with(prefix) {
            return true;
        }
    }
    false
}

/// A fold inside a section, for the properties a schema files under a `group`.
/// Shut to begin with -- a property is grouped precisely because it is not one
/// of the handful worth the room -- so the state kept is which ones were
/// opened. A search reaches into the folds.
fn fold_line(state: &mut editor::State, component: str, group: str, count: int, searching: bool) -> bool {
    let store_key = "{component}/{group}";
    let open = state.opened.has(store_key) || searching;
    push_line(state, Line {
        kind: FOLD,
        at: at_top(component, group),
        key: "{component}#{group}",
        spec: { "open": open, "key": store_key, "store": "opened", "count": count },
        height: row_height(state),
        labelled: false,
    });
    open
}

// One property's lines. The first says how many there are, which is what a
// write of it compares, and wears what the engine says of the property.
fn walk_property(state: &mut editor::State, component: str, property: str, spec: any) {
    let form = state.inspect;
    let first = form.lines.len();
    let value = if unfolds(spec) { read_property(state, component, property, spec) } else { nil };
    walk_value(state, at_top(component, property, value), spec, value);
    let head = form.lines[first];
    let key = "{component}.{property}";
    form.named[key] = form.base + first;
    head.count = form.lines.len() - first;
    head.root = spec;
    let notes = form.warned[key];
    if notes != nil {
        head.mark = MARK_WARNING;
        head.why = util::join(as_texts(notes), "\n");
    } else if overrides(form, component, property) {
        head.mark = MARK_OVERRIDE;
        head.why = "Changes what the prefab sets";
    }
}

fn overrides(form: Form, component: str, property: str) -> bool {
    let changed = form.overridden[component];
    if changed == nil {
        return false;
    }
    if component == SCRIPT {
        return property == SCRIPT_SOURCE && changed.has(SCRIPT_SOURCE) || changed["props"] != nil && changed["props"].has(property);
    }
    changed.has(property)
}

fn value_line(state: &mut editor::State, at: AtTop, spec: any, value: any) -> Line {
    let form = state.inspect;
    let line = Line {
        kind: VALUE,
        at: at,
        key: key_of(at),
        spec: spec,
        value: value,
        height: row_height(state),
    };
    if form.removing != nil {
        line.holder = form.removing["at"];
        line.step = form.removing["step"];
        form.removing = nil;
    }
    push_line(state, line)
}

fn key_of(at: AtTop) -> str {
    let key = "{at.component}.{at.property}";
    for step in at.path {
        key = "{key}/{step}";
    }
    key
}

/// One value's lines, by what its spec asks for. A composite calls back into
/// this for what it holds, so a list of colours is a row of colour drawers
/// and nothing had to know both.
fn walk_value(state: &mut editor::State, at: AtTop, spec: any, value: any) {
    let datatype = spec["type"].as_str();
    if spec["readonly"].as_bool() || state.registry.property_editors.has(datatype) {
        value_line(state, at, spec, value);
    } else if datatype == "list" {
        walk_list(state, at, spec, value);
    } else if datatype == "map" {
        walk_map(state, at, spec, value);
    } else if datatype == "record" {
        walk_record(state, at, spec, value);
    } else if datatype == "variant" {
        walk_variant(state, at, spec, value);
    } else if datatype == "asset" {
        walk_asset(state, at, spec, value);
    } else {
        value_line(state, at, spec, value);
    }
}

// Each entry takes the chip that takes it out, on the first row it draws.
fn walk_entry(state: &mut editor::State, at: AtTop, step: any, label: str, of: any, value: any) {
    let form = state.inspect;
    let was = form.removing;
    form.removing = { "at": at, "step": step };
    walk_value(state, at_step(at, step, label), of, value);
    form.removing = was;
}

fn walk_list(state: &mut editor::State, at: AtTop, spec: any, value: any) {
    let held = util::list_or_empty(value);
    let of = util::map_or_empty(spec["of"]);
    value_line(state, at, spec, value);
    for index in 0..held.len() {
        walk_entry(state, at, index, "{index}", of, held[index]);
    }
}

// A key is renamed by taking the entry out and adding it again, which is what
// keeps the row one control wide.
fn walk_map(state: &mut editor::State, at: AtTop, spec: any, value: any) {
    let held = util::map_or_empty(value);
    let of = util::map_or_empty(spec["of"]);
    value_line(state, at, spec, value);
    for key in util::keys_sorted(held) {
        walk_entry(state, at, key, key, of, held[key]);
    }
}

// The fields are the schema's, so there is nothing to add or take away.
fn walk_record(state: &mut editor::State, at: AtTop, spec: any, value: any) {
    let held = util::map_or_empty(value);
    let fields = util::map_or_empty(spec["fields"]);
    value_line(state, at, spec, value);
    for field in util::keys_sorted(fields) {
        let of = util::map_or_empty(fields[field]);
        walk_value(state, at_step(at, field, util::property_label(field)), of, if held.has(field) { held[field] } else { of["default"] });
    }
}

// Which of its records the value is, as a dropdown, then that record's fields.
// Picking another kind writes it over the fields held, and the engine keeps
// the ones the new kind reads and fills in the rest.
fn walk_variant(state: &mut editor::State, at: AtTop, spec: any, value: any) {
    let held = util::map_or_empty(value);
    let variants = util::map_or_empty(spec["variants"]);
    let kind = if held["kind"] == nil { util::map_or_empty(spec["default"])["kind"].as_str() } else { held["kind"].as_str() };
    let picker: any = { "type": "enum", "options": util::keys_sorted(variants), "description": spec["description"] };
    value_line(state, at_step(at, "kind", at.label), picker, kind);
    let fields = util::map_or_empty(util::map_or_empty(variants[kind])["fields"]);
    for field in util::keys_sorted(fields) {
        let of = util::map_or_empty(fields[field]);
        walk_value(state, at_step(at, field, util::property_label(field)), of, if held.has(field) { held[field] } else { of["default"] });
    }
}

// The row naming the asset, then the asset's own properties: a record's
// fields, or the values a material's shader takes, whichever node names it.
fn walk_asset(state: &mut editor::State, at: AtTop, spec: any, value: any) {
    let asset_type = spec["asset"].as_str();
    let own = as_text(value);
    value_line(state, at, spec, value);
    if asset_type == "material" {
        let from = if own == "" { inherited_material(state) } else { Inherited { material: "", node: "", here: false } };
        // Not when the node's own `material` component is the source: it
        // draws them.
        if !from.here {
            walk_material(state, at, if own == "" { from.material } else { own });
        }
        return;
    }
    let record = assets::schema(asset_type);
    if record == nil {
        return;
    }
    let definition: any = if own == "" { {} } else { util::map_or_empty(assets::load(own)) };
    for field in record.keys() {
        let of = util::map_or_empty(record[field]);
        walk_value(state, at_step(at, field, util::property_label(field)), of, if definition.has(field) { definition[field] } else { of["default"] });
    }
}

// The values a material's shader takes, read off the linked shader so the
// rows cannot drift from it. One that will not link has none.
fn walk_material(state: &mut editor::State, at: AtTop, reference: str) {
    if reference == "" {
        return;
    }
    let definition = assets::load(reference);
    let shader = if definition.kind() == "map" { definition["shader"].as_str() } else { "" };
    if shader != "" {
        material_line(state, at, reference, "shader", "@shader", "Shader", shader);
        let features = util::map_or_empty(definition["features"]);
        for name in util::keys_sorted(features) {
            material_line(state, at, reference, "feature", name, "@" + name, features[name]);
        }
    }
    for parameter in render::material_params(reference) {
        material_line(state, at, reference, parameter.type, parameter.name, util::property_label(parameter.name), parameter.value);
    }
}

// One row under a material. Indented, because it belongs to the row above
// rather than the node.
fn material_line(state: &mut editor::State, at: AtTop, reference: str, datatype: str, name: str, label: str, value: any) {
    let inner = at_step(at, "@" + name, "  " + label);
    value_line(state, inner, { "type": "material", "datatype": datatype, "reference": reference, "name": name }, value);
}

fn script_section(state: &mut editor::State, node: Node) {
    let query = search::query(state, "inspector");
    let schema = script_schema(state, node);
    if query != "" && !search::matches(query, "{SCRIPT} {util::join(util::keys_sorted(schema), " ")}") {
        return;
    }
    section(state, SCRIPT, schema, lay_out(schema), false);
}

/// The `script` component's properties for this node: its file, then what the
/// file exports, in the schema's own vocabulary. A value differing from the
/// default is the node's own; everything else is inherited, so a changed
/// default reaches every node that left it alone.
fn script_schema(state: &mut editor::State, node: Node) -> any {
    let schema: any = { SCRIPT_SOURCE: { "type": "script_path", "default": "" } };
    let rel = model::script_rel(node);
    if rel == nil {
        return schema;
    }
    for export in util::list_or_empty(model::exports(state, rel.as_str())) {
        let spec = util::copy(export);
        spec.remove("name");
        schema[export["name"].as_str()] = spec;
    }
    schema
}

// A plugin's section is its own component's rows: the schema it declared,
// the values it answers for this node, none where it has nothing to say.
fn plugin_sections(state: &mut editor::State, node: Node) {
    let form = state.inspect;
    for entry in plugins::sections(state) {
        let values = plugins::section_values(entry, node);
        if values == nil {
            continue;
        }
        let name = entry["component"].as_str();
        form.plugin_values[name] = values;
        section(state, name, entry["schema"], lay_out(entry["schema"]), false);
    }
}

/// What a property holds now: off the node, off what the script exports, or
/// what its plugin answered. The schema's default where it holds nothing.
pub fn read_property(state: editor::State, component: str, property: str, spec: any) -> any {
    let form = state.inspect;
    if component == SCRIPT {
        if property == SCRIPT_SOURCE {
            return form.script_rel;
        }
        let properties = model::script_props(form.node);
        return if properties.has(property) { properties[property] } else { spec["default"] };
    }
    let plugin = form.plugin_values[component];
    if plugin != nil {
        return if plugin.has(property) { plugin[property] } else { spec["default"] };
    }
    if !form.node.is_valid() {
        return spec["default"];
    }
    let now = form.node.get_component(component, property);
    if now == nil { spec["default"] } else { now }
}

// What a line draws from: the property read again, or what the walk found for
// a value inside one.
fn held_by(state: editor::State, line: Line) -> any {
    if line.count > 0 && line.at.path.len() == 0 && (line.kind == VALUE || line.kind == HEAD) {
        return read_property(state, line.at.component, line.at.property, line.root);
    }
    line.value
}

// Where each line sits, once a walk or the width decided how tall they are.
fn stack_lines(state: &mut editor::State) {
    let form = state.inspect;
    let top = 0.0;
    for line in form.lines {
        line.top = top;
        top += line.height + LINE_GAP;
        if form.stacked && line.labelled {
            top += STACKED_LABEL;
        }
    }
    form.total = top;
}

// The form's height and the rows on screen, each row written where `whole`
// says the lines changed, and otherwise only where the window moved.
fn place(state: &mut editor::State, whole: bool) {
    let form = state.inspect;
    let host = host_of(state);
    let scroller = scroller_of(state);
    if !host.is_valid() || !scroller.is_valid() {
        return;
    }
    form.label_width = label_width(state);
    form.stacked = stacked(state);
    stack_lines(state);
    let rect_or = ui::widget_rect(scroller);
    form.view = if rect_or != nil && rect_or.unwrap().height > 0.0 { rect_or.unwrap().height } else { state.screen_height };
    host.set_visible(true);
    if host.widget.height != form.total {
        host.widget.height = form.total;
    }
    let needed = (form.view / SHORTEST_LINE) as int + 2 * OVERSCAN + 2;
    // A fresh editor over rows the last one made: they show what it showed.
    let made = if form.capacity == 0 { host.children().len() } else { 0 };
    if util::int_max(needed, made) > form.capacity {
        form.capacity = util::int_max(needed, made);
        while form.slots.len() < form.capacity {
            form.slots.push(if form.slots.len() < made { SLOT_LEFT } else { SLOT_EMPTY });
            form.slot_keys.push("");
        }
    }
    set_window(state, whole);
}

// The line under the height `y`.
fn line_at(form: Form, y: float) -> int {
    let low = 0;
    let high = form.lines.len() - 1;
    while low < high {
        let middle = (low + high + 1) / 2;
        if form.lines[middle].top <= y {
            low = middle;
        } else {
            high = middle - 1;
        }
    }
    low
}

// Which lines are on screen, with a few past each edge, and each slot put to
// its line. A slot whose line stays is not touched unless `whole`.
fn set_window(state: &mut editor::State, whole: bool) {
    let form = state.inspect;
    if form.lines.len() == 0 {
        form.first = 0;
        form.last = 0;
    } else {
        form.offset = util::clamp(form.offset, 0.0, util::max(0.0, form.total - form.view));
        form.first = util::int_max(0, line_at(form, form.offset) - OVERSCAN);
        form.last = util::int_min(form.lines.len(), line_at(form, form.offset + form.view) + OVERSCAN + 1);
    }
    let typing = typing_slot(state);
    let capacity = form.capacity;
    for slot in 0..capacity {
        let held = form.slots[slot];
        let wanted = form.first + (slot - form.first % capacity + capacity) % capacity;
        if wanted >= form.last {
            wanted = SLOT_EMPTY;
        }
        if wanted == SLOT_EMPTY {
            if held != SLOT_EMPTY {
                if slot == typing {
                    ui::clear_focus();
                }
                ui::fill_row(form.host, slot);
                form.slots[slot] = SLOT_EMPTY;
                form.slot_keys[slot] = "";
            }
            continue;
        }
        if held == wanted && !whole {
            continue;
        }
        let line = form.lines[wanted];
        if slot == typing && form.slot_keys[slot] != line.key {
            ui::clear_focus();
        }
        form.slots[slot] = wanted;
        line.drawn = false;
        draw_line(state, wanted);
        form.slot_keys[slot] = line.key;
    }
}

// The slot whose row holds the keyboard, or -1. Read off the node focus is on
// rather than kept, since anything can move focus.
fn typing_slot(state: &mut editor::State) -> int {
    let focused = ui::focused_widget();
    if !focused.is_valid() {
        return -1;
    }
    let up = focused;
    for _depth in 0..4 {
        up = up.parent();
        if !up.is_valid() {
            return -1;
        }
        if up.parent() == state.inspect.host {
            return up.name().slice(1, up.name().len()).parse_int();
        }
    }
    -1
}

// Write line `index` to its slot, unless what it shows is what it showed. A
// field holding the keyboard is left alone: what is typed is not the value yet.
fn draw_line(state: &mut editor::State, index: int) {
    let form = state.inspect;
    let line = form.lines[index];
    let value = held_by(state, line);
    if line.drawn && value == line.shown {
        return;
    }
    let slot = index % form.capacity;
    // On its slot already, a value is all that moved of most rows.
    if line.drawn {
        let patches = drawers::patches_of(state, line, value);
        if patches != nil {
            line.shown = value;
            ui::patch_row(form.host, slot, patches);
            form.written += 1;
            return;
        }
    }
    line.drawn = true;
    line.shown = value;
    let row = drawers::row_of(state, line, value);
    if form.slot_keys[slot] == line.key && row.controls.len() > 0 && row.controls[0].kind == "text_field" && typing_slot(state) == slot {
        return;
    }
    row.y = line.top;
    ui::fill_row(form.host, slot, row, form.label_width, form.stacked);
    form.slot_keys[slot] = line.key;
    form.written += 1;
}

/// An edit on one of the form's rows: `data` names its line and its handler.
/// A control left saying what the write did not take says what it holds.
pub fn edited(state: &mut editor::State, data: any, value: any) {
    let form = state.inspect;
    let at = form.named[data["line"].as_str()];
    if at == nil {
        return;
    }
    let index = at.unwrap();
    let handler: fn(&mut editor::State, Line, any, any) = data["fn"];
    let line = form.lines[index];
    let walked = form.walks;
    handler(state, line, data, value);
    if form.walks == walked && index >= form.first && index < form.last {
        line.drawn = false;
        draw_line(state, index);
    }
}

/// A section's or a group's fold turned round: its key in `collapsed` where
/// it is shut, in `opened` where it is open, as `store` names.
pub fn fold(state: &mut editor::State, line: Line) {
    let key = line.spec["key"].as_str();
    let opened = line.spec["store"].as_str() == "opened";
    let held = if opened { state.opened } else { state.collapsed };
    let open = line.spec["open"].as_bool();
    // Shutting writes the key into `collapsed` and out of `opened`.
    if open != opened {
        held[key] = true;
    } else {
        held.remove(key);
    }
    refill(state);
}

pub fn as_text(value: any) -> str {
    if value.kind() == "str" {
        value.as_str()
    } else if value == nil || value.kind() == "list" || value.kind() == "map" {
        // A list has no text form, and a field is not where one is edited.
        ""
    } else {
        "{value}"
    }
}

// Where an editor writes: the component or script, the property, and the steps
// into its value. `whole` is the fallback where nothing live answers.
pub fn at_top(component: str, property: str, whole: any) -> AtTop {
    AtTop { component: component, property: property, path: [], label: util::property_label(property), whole: whole }
}

// One step further in: a path of its own, since a path shared between
// siblings would end with the last one's step.
pub fn at_step(at: AtTop, step: any, label: str) -> AtTop {
    let path: [any] = [];
    for one in at.path {
        path.push(one);
    }
    path.push(step);
    AtTop { component: at.component, property: at.property, path: path, label: label, whole: at.whole }
}

/// The property's value as it stands now, so one entry's edit keeps the
/// rest: the row was built before the edit and holds what it started from.
fn current_whole(state: editor::State, at: AtTop) -> any {
    if at.component == SCRIPT {
        let found = model::script_props(model::selected_node(state))[at.property];
        return if found == nil { at.whole } else { found };
    }
    let now = read_now(state, at.component, at.property, at.whole);
    if record_named(state, at) == "" {
        return now;
    }
    // A row naming a record asset is edited as the definition it names.
    let reference = as_text(now);
    let definition: any = if reference == "" { {} } else { util::deep(util::map_or_empty(assets::load(reference))) };
    definition.remove("type");
    definition
}

/// The record asset type a component's row names, or "" for any other row:
/// an edit inside one rebuilds the definition rather than the reference.
fn record_named(state: editor::State, at: AtTop) -> str {
    if at.component == SCRIPT || state.inspect.plugin_values.has(at.component) {
        return "";
    }
    // The cached schema where the Inspector drew it, else the engine's.
    let cached = state.schemas[at.component];
    let schema = if cached == nil { scene::component_schema(at.component) } else { cached };
    let spec = util::map_or_empty(util::map_or_empty(schema)[at.property]);
    let asset_type = spec["asset"].as_str();
    if spec["type"].as_str() != "asset" || assets::schema(asset_type) == nil {
        return "";
    }
    asset_type
}

/// A property rebuilt whole after one part of it changed. A row naming a
/// record asset kept in a file writes the file, which every node naming it
/// reads again; one written inline, or naming none, writes the row.
fn write_whole(state: &mut editor::State, at: AtTop, whole: any) {
    let record = record_named(state, at);
    let reference = if record == "" { "" } else { as_text(read_now(state, at.component, at.property, at.whole)) };
    if reference == "" || reference.starts_with("#") {
        write(state, at.component, at.property, whole);
        return;
    }
    whole["type"] = record;
    assets::save(reference, whole);
    rows_moved(state, at.component, [at.property]);
}

/// What sits at a cursor now, for an editor rebuilding a value one part at a
/// time.
pub fn held_now(state: editor::State, at: AtTop, fallback: any) -> any {
    let found = inner_at(current_whole(state, at), at.path, at.path.len());
    if found == nil { fallback } else { found }
}

/// The value `path`'s first `depth` steps lead to, or `None` where a step
/// names nothing.
fn inner_at(holder: any, path: [any], depth: int) -> any {
    let found = holder;
    for index in 0..depth {
        let step = path[index];
        if found.kind() == "list" {
            if step.kind() != "int" || step.as_int() < 0 || step.as_int() >= found.len() {
                return nil;
            }
            found = found[step.as_int()];
        } else if found.kind() == "map" && found.has(step.as_str()) {
            found = found[step.as_str()];
        } else {
            return nil;
        }
    }
    found
}

/// An edit at a cursor: the whole property is written, with this one part of
/// it replaced, because a write takes a property whole.
pub fn write_at(state: &mut editor::State, at: AtTop, value: any) {
    if at.path.len() == 0 {
        write(state, at.component, at.property, value);
        return;
    }
    let whole = util::deep(current_whole(state, at));
    let holder = inner_at(whole, at.path, at.path.len() - 1);
    let step = at.path[at.path.len() - 1];
    if holder == nil {
        return;
    }
    if step.kind() == "int" {
        holder[step.as_int()] = value;
    } else {
        holder[step.as_str()] = value;
    }
    write_whole(state, at, whole);
}

/// Take one entry out of the list or map the cursor names.
pub fn drop_entry(state: &mut editor::State, at: AtTop, step: any) {
    let whole = util::deep(current_whole(state, at));
    let holder = inner_at(whole, at.path, at.path.len());
    if holder == nil {
        return;
    }
    holder.remove(step);
    write_whole(state, at, whole);
}

/// Add one entry to the list or map the cursor names, at the spec's own
/// default: `complete_property` wrote one in for every nested spec.
pub fn add_entry(state: &mut editor::State, at: AtTop, of: any, key: str) {
    let fresh_value = util::deep(of["default"]);
    let whole = util::deep(current_whole(state, at));
    let holder = inner_at(whole, at.path, at.path.len());
    if holder == nil {
        return;
    }
    if holder.kind() == "list" {
        holder.push(fresh_value);
    } else {
        holder[key] = fresh_value;
    }
    write_whole(state, at, whole);
}

// Where an edited value goes. Every drawer writes through here, so the same
// drawers serve a component, a script's exports and a plugin's section.
fn write(state: &mut editor::State, component: str, property: str, value: any) {
    if component == SCRIPT {
        if property == SCRIPT_SOURCE {
            shell::set_script_path(state, value.as_str());
        } else {
            model::set_script_property(state, property, value);
        }
        return;
    }
    if state.inspect.plugin_values.has(component) {
        plugins::section_write(state, component, property, value);
        refill(state);
        return;
    }
    model::set_component_property(state, component, property, value);
    // The clip the Timeline holds was named by the value just written, so the
    // cache goes and the engine is handed the clip again.
    if component == "animation" {
        state.clip = nil;
        signals::inspector(state);
        anim::arm(state);
    }
}

fn read_now(state: editor::State, component: str, property: str, fallback: any) -> any {
    let found = model::selected_node(state);
    if !found.is_valid() {
        return fallback;
    }
    let value = found.get_component(component, property);
    if value == nil { fallback } else { value }
}

/// The material the selection draws with while it names none, the path of the
/// node naming it, and whether that is the selection itself. The nearest one
/// up wins, and the walk stops at the edited scene.
pub fn inherited_material(state: editor::State) -> Inherited {
    let found = model::selected_node(state);
    let at = found;
    while at.is_valid() {
        let own = at.material();
        if own != "" {
            return Inherited { material: own, node: at.path(), here: at.path() == found.path() };
        }
        if state.mirror != nil && at.path() == state.mirror.unwrap().path() {
            break;
        }
        at = at.parent();
    }
    Inherited { material: "", node: "", here: false }
}
