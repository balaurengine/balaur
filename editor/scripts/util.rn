// Small helpers the rest of the editor leans on. Rune has no nil: the engine
// returns `()` for nothing, and a document's optional field comes back as
// `None` from `get`.

pub fn join(parts, sep) {
    let out = "";
    for (i, part) in parts.iter().enumerate() {
        if i > 0 {
            out += sep;
        }
        out += format!("{}", part);
    }
    out
}

pub fn last_segment(path) {
    let parts = path.split('/').collect::<Vec>();
    parts[parts.len() - 1]
}

pub fn is_nil(v) {
    v is Tuple
}

pub fn obj(v) {
    if v is Object { v } else { #{} }
}

/// Fill a widget node from a table and answer the whole component back, so a
/// caller writes what changed and reads what the node reports.
///
/// `patch_component` rather than get-mutate-set: every property the table
/// leaves out stays where it was, and a view that only sets `options` and
/// `visible` cannot flatten the rest of the widget by forgetting one.
pub fn fill(id, params) {
    let found = scene::get_node(id);
    if is_nil(found) {
        return #{};
    }
    found.patch_component("widget", params);
    obj(found.get_component("widget"))
}

/// Stop drawing a node. Only the dock that owns one may call this: every dock
/// draws each frame, so a global hide has one turning off another's node.
pub fn hide(id) {
    let found = scene::get_node(id);
    if is_nil(found) {
        return;
    }
    found.patch_component("widget", #{ visible: false });
}

/// What a list or tree node reports it was picked, and a clear so the same
/// pick is not acted on again next frame.
pub fn taken(id, params) {
    let picked = params["text"];
    if picked != "" {
        fill(id, #{ text: "" });
    }
    picked
}

/// One row of a `list` or `tree`: the icon, the label, a trailing note and a
/// colour of its own, joined by the unit separator the kind splits on.
pub fn row(icon, label, trailing, tint) {
    icon + "\u{1f}" + label + "\u{1f}" + trailing + "\u{1f}" + tint
}

pub fn vec(v) {
    if v is Vec { v } else { [] }
}

pub fn f(v) {
    v as f64
}

pub fn i(v) {
    v as i64
}

pub fn clamp(x, lo, hi) {
    if x < lo { lo } else if x > hi { hi } else { x }
}

pub fn max(a, b) {
    if a > b { a } else { b }
}

pub fn min(a, b) {
    if a < b { a } else { b }
}

pub fn abs(x) {
    if x < 0.0 { -x } else { x }
}

/// Three floats from a document vector, or `default`.
pub fn vec3(v, fallback) {
    if v is Vec && v.len() >= 3 {
        [f(v[0]), f(v[1]), f(v[2])]
    } else {
        fallback
    }
}

pub fn vec2(v, fallback) {
    if v is Vec && v.len() >= 2 {
        [f(v[0]), f(v[1])]
    } else {
        fallback
    }
}

/// A live node's `Vec3` as the `[x, y, z]` the draw and document code uses.
pub fn xyz(v) {
    [v.x, v.y, v.z]
}

pub fn vadd(a, b) {
    [a[0] + b[0], a[1] + b[1], a[2] + b[2]]
}

pub fn vsub(a, b) {
    [a[0] - b[0], a[1] - b[1], a[2] - b[2]]
}

pub fn vscale(a, s) {
    [a[0] * s, a[1] * s, a[2] * s]
}

pub fn vdot(a, b) {
    a[0] * b[0] + a[1] * b[1] + a[2] * b[2]
}

pub fn vcross(a, b) {
    [
        a[1] * b[2] - a[2] * b[1],
        a[2] * b[0] - a[0] * b[2],
        a[0] * b[1] - a[1] * b[0],
    ]
}

/// The unit vector and the length; a zero vector normalises to zero, so a
/// caller can divide without checking first.
pub fn vnorm(a) {
    let l = math::sqrt(vdot(a, a));
    if l < 1e-6 {
        return ([0.0, 0.0, 0.0], 0.0);
    }
    // Explicit `return`: a bare tuple after a block parses as calling it.
    return (vscale(a, 1.0 / l), l);
}

pub fn dist(a, b) {
    let (_, l) = vnorm(vsub(a, b));
    l
}

/// `a` with `b`'s entries written over it. Rune has no spread syntax, so the
/// per-call overrides of a shared option object go through here.
pub fn merge(a, b) {
    let out = copy(a);
    for (k, v) in b.iter() {
        out[k] = v;
    }
    out
}

/// Where `needle` first sits in `text`, or `None`. Rune's `String` has no
/// `find`, and splitting on the needle measures the same thing.
pub fn index_of(text, needle) {
    if needle == "" {
        return None;
    }
    let parts = text.split(needle).collect::<Vec>();
    if parts.len() < 2 {
        return None;
    }
    Some(parts[0].len())
}

/// `text` cased the way `sample` is: all caps, capitalised, or left alone.
/// What keeps `Arm_L` mirroring to `Arm_R` rather than to `Arm_r`.
pub fn match_case(sample, text) {
    if sample == sample.to_lowercase() {
        return text;
    }
    if sample == sample.to_uppercase() {
        return text.to_uppercase();
    }
    let lower = text.to_lowercase();
    lower[..1].to_uppercase() + lower[1..]
}

/// The last segment of a `/`-separated path, which is what a column too
/// narrow for the whole thing shows.
pub fn leaf(path) {
    let parts = path.split('/').collect::<Vec>();
    parts[parts.len() - 1]
}

pub fn contains(items, x) {
    for it in items {
        if it == x {
            return true;
        }
    }
    false
}

pub fn position(items, x) {
    for (i, it) in items.iter().enumerate() {
        if it == x {
            return Some(i);
        }
    }
    None
}

pub fn keys_sorted(o) {
    let keys = o.keys().collect::<Vec>();
    keys.sort();
    keys
}

pub fn count_lines(text) {
    text.split('\n').collect::<Vec>().len()
}

pub fn repeat(s, n) {
    let out = "";
    for _ in 0..n {
        out += s;
    }
    out
}

/// A shallow copy of an object or vector; anything else is a value already.
pub fn copy(v) {
    if v is Object {
        let out = #{};
        for (k, x) in v.iter() {
            out[k] = x;
        }
        out
    } else if v is Vec {
        v.clone()
    } else {
        v
    }
}

/// A copy all the way down.
pub fn deep(v) {
    if v is Object {
        let out = #{};
        for (k, x) in v.iter() {
            out[k] = deep(x);
        }
        out
    } else if v is Vec {
        let out = [];
        for x in v {
            out.push(deep(x));
        }
        out
    } else {
        v
    }
}

/// `#rrggbb` to unit floats.
pub fn hex_to_rgb(hex) {
    (hex_pair(hex, 1), hex_pair(hex, 3), hex_pair(hex, 5))
}

fn hex_pair(hex, at) {
    let digits = "0123456789abcdef";
    let value = 0;
    for c in hex[at..at + 2].to_lowercase().chars() {
        for (i, d) in digits.chars().enumerate() {
            if d == c {
                value = value * 16 + i;
            }
        }
    }
    (value as f64) / 255.0
}

/// A colour as the `[r, g, b]` the draw calls take.
pub fn rgb(hex) {
    let (r, g, b) = hex_to_rgb(hex);
    [r, g, b]
}

// Rotation basis from the engine's ZYX euler (roll=x, pitch=y, yaw=z):
// R = Rz(yaw) * Ry(pitch) * Rx(roll). Returns the world-space directions of
// the node's local axes (the matrix columns).
pub fn basis_from_euler(r) {
    let cr = math::cos(r[0]);
    let sr = math::sin(r[0]);
    let cp = math::cos(r[1]);
    let sp = math::sin(r[1]);
    let cy = math::cos(r[2]);
    let sy = math::sin(r[2]);
    [
        [cy * cp, sy * cp, -sp],
        [cy * sp * sr - sy * cr, sy * sp * sr + cy * cr, cp * sr],
        [cy * sp * cr + sy * sr, sy * sp * cr - cy * sr, cp * cr],
    ]
}

pub fn euler_from_basis(b) {
    let pitch = math::asin(clamp(-b[0][2], -1.0, 1.0));
    let yaw = math::atan(b[0][1], b[0][0]);
    let roll = math::atan(b[1][2], b[2][2]);
    [roll, pitch, yaw]
}

pub fn rotate_basis_local(b, axis, angle) {
    let c = math::cos(angle);
    let s = math::sin(angle);
    let i = (axis + 1) % 3;
    let j = (axis + 2) % 3;
    // Columns i and j rotate into each other around column `axis`.
    let bi = b[i];
    let bj = b[j];
    let out = [b[0], b[1], b[2]];
    out[i] = [bi[0] * c + bj[0] * s, bi[1] * c + bj[1] * s, bi[2] * c + bj[2] * s];
    out[j] = [bj[0] * c - bi[0] * s, bj[1] * c - bi[1] * s, bj[2] * c - bi[2] * s];
    out
}

/// Rotate a ZYX euler about one of its own axes.
pub fn rotate_euler(r, axis, angle) {
    euler_from_basis(rotate_basis_local(basis_from_euler(r), axis, angle))
}

/// Rotate a world point about `center` by `angle` around world axis `axis`.
pub fn rotate_about(p, center, axis, angle) {
    let c = math::cos(angle);
    let s = math::sin(angle);
    let d = vsub(p, center);
    let i = (axis + 1) % 3;
    let j = (axis + 2) % 3;
    let out = [d[0], d[1], d[2]];
    out[i] = d[i] * c - d[j] * s;
    out[j] = d[i] * s + d[j] * c;
    vadd(center, out)
}
