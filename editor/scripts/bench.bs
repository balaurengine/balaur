//! `--state bench:<edit>`: one edit a frame to the selection, the way the
//! Inspector writes it, so a run can be measured by the instructions it
//! retires against one that edits nothing (PLAN-editor-performance §10). The
//! edits: `text` and `color` on a `text2d`, `position` on its transform, and
//! `engine_text`, the engine's own write that the Inspector's rows follow.

use editor;
use model;
use words::components;
use words::datatypes;

const ENGINE_TEXT: str = "engine_text";
const ONE: str = "one";
const TWO: str = "two";

/// One edit, every frame while a bench runs.
pub fn step(state: &mut editor::State) {
    if state.bench == "" {
        return;
    }
    let found = model::selected_node(state);
    if !found.is_valid() {
        return;
    }
    let flip = state.frame % 2 == 0;
    if state.bench == components::TEXT {
        model::set_component_property(state, components::TEXT2D, components::TEXT, if flip { ONE } else { TWO });
    } else if state.bench == datatypes::COLOR {
        model::set_component_property(state, components::TEXT2D, datatypes::COLOR, if flip { [1.0, 0.0, 0.0, 1.0] } else { [0.0, 1.0, 0.0, 1.0] });
    } else if state.bench == components::POSITION {
        model::set_component_property(state, components::TRANSFORM, components::POSITION, [if flip { 0.0 } else { 0.5 }, 0.0, 0.0]);
    } else if state.bench == ENGINE_TEXT {
        found.text2d.text = if flip { ONE } else { TWO };
    }
    ui::request_repaint();
}
