// What the bottom dock's panels are built from: each tab is a scene with its
// own script, and these are the views and commands it asks the Editor for.

use anim;
use defs;
use dropin;
use editor;
use history;
use icons;
use importer;
use model;
use search;
use session;
use shell;
use signals;
use util;
use viewport;
use words::asset_kinds;
use words::changes;
use words::command;
use words::dock_fields;
use words::fields;
use words::general;
use words::glyphs;
use words::layout_fields;
use words::log_fields;
use words::project_fields;
use words::schema_fields;
use words::statuses;
use words::tabs;
use words::theme_tokens;

const ENV: str = "env";
const INFO: str = "info";
const INTO: str = "into";
const OUT: str = "out";
const OVER: str = "over";
internal const RENAME_TO: str = "rename_to";
const SPAN: str = "span";
const WARN: str = "warn";
const NODE: str = "node";
const STAGE: str = "stage";
const WEB: str = "web";
const LOCALS: str = "locals";
const STEP_INTO: str = "step-into";
const PAUSE: str = "pause";

/// The log as the Output panel last filtered it, and the lines made of it:
/// kept so a frame that logged nothing redoes none of it.
pub class Built {
    mark: str,
    rows: [any],
    hidden: int,
    theme: any,
    items: [ui::Item],
}

pub struct OutputView {
    internal items: [ui::Item],
    internal says: str,
}

/// A card's mark and the theme token it is inked with.
pub struct AssetLook {
    icon: str,
    ink: str,
}

pub class AssetsState {
    internal directory: str,
    internal selected: str,
    renaming: bool,
    shown: Shown,
}

/// The cards the Assets panel shows, and the path and kind of each.
pub struct Shown {
    paths: [str],
    is_folder: [bool],
}

pub struct AssetsView {
    internal dir: str,
    internal where: str,
    internal renaming: bool,
    internal name: str,
    internal count: str,
    internal importing: bool,
    internal import_text: str,
    internal import_tip: str,
    internal import_icon: str,
    internal folder_icon: str,
    internal up_icon: str,
    internal chosen: bool,
    internal items: [ui::Item],
    internal picked: str,
    /// The selection is a dependency's file, which Make local copies out.
    internal local: bool,
    /// The `path` dependency Move to project moves the selection into, or "".
    internal move_to: str,
    /// What Edit dependency opens, or "" outside a dependency.
    internal source_tip: str,
    /// The browser is in a Forge dependency, which Update moves on.
    internal update: bool,
}

pub struct DebuggerView {
    internal stopped: bool,
    internal can_pause: bool,
    /// Continue's, Over's, Into's and Out's, in that order.
    internal step_icons: [str],
    internal pause_icon: str,
    internal where: str,
    internal threw: str,
    internal break_on_error: bool,
    internal frames: [ui::Item],
    internal picked: str,
}

pub struct ProblemsView {
    internal items: [ui::Item],
    internal says: str,
}

pub struct RecordingsFill {
    internal verify: bool,
    internal count: int,
}

pub struct MeterView {
    internal titles: [str],
    internal widths: [str],
    internal items: [ui::Item],
    internal says: str,
    internal headline: str,
    internal scripts: bool,
}

/// A stage or a span, and what it cost the last frame.
struct Cost {
    name: str,
    milliseconds: float,
}

// What the last frame cost, against the budget: the Profiler's headline, in
// the tab row because the panel's body is the table it fills.
fn frame_hint() -> str {
    let found = engine::timings();
    if found == nil {
        return "no timings yet";
    }
    let timings = found.unwrap();
    let stage_milliseconds = timings.frame * 1000.0;
    let wall_milliseconds = timings.wall * 1000.0;
    let frame_milliseconds = if wall_milliseconds > 0.0 { wall_milliseconds } else { stage_milliseconds };
    let steps = timings.fixed_steps;
    let plural = if steps == 1 { "" } else { "s" };
    let line = "{util::fixed(frame_milliseconds, 2)} ms of {util::fixed(BUDGET_MILLISECONDS, 1)} · {steps} step{plural}";
    if frame_milliseconds > BUDGET_MILLISECONDS {
        line += " · {util::fixed(1000.0 / frame_milliseconds, 1)} fps";
    }
    line
}

// What the frame draws, and how big the last export was where the row is wide
// enough to say both. A tab row cannot scroll, so a line too long is a line
// cut off mid-word.
fn cost_hint(state: editor::State, room: float) -> str {
    let stats = render::stats();
    let line = "{stats.draws as int} draws · {stats.triangles as int} triangles · {bytes(stats.texture_bytes)} in {stats.textures as int} textures";
    if room > 560.0 {
        line += " · export {pack_size(state)}";
    }
    line
}

// How loud an entry is, so `error` and `warn` stop looking identical.
fn severity(level: any) -> int {
    if level.as_str() == statuses::ERROR {
        3
    } else if level.as_str() == WARN {
        2
    } else if level.as_str() == INFO {
        1
    } else {
        0
    }
}

fn floor_of(level: str) -> int {
    if level == WARN {
        2
    } else if level == statuses::ERROR {
        3
    } else {
        0
    }
}

// The rows the level and the filter leave, and how many they took away.
// Filtering lowercases every message, so it is redone only when the log, the
// level or the filter has actually moved.
fn filtered(state: &mut editor::State) -> Built {
    // `since` hands back only what was logged after the cursor, so a frame
    // that logged nothing costs one call rather than the whole buffer.
    let news = log::since(state.log_cursor);
    state.log_cursor = news.cursor;
    let mark = "{state.log_level}|{state.log_query}";
    if state.log_cache != nil && state.log_cache.unwrap().mark == mark && news.entries.len() == 0 && news.missed == 0 {
        return state.log_cache.unwrap();
    }
    // Everything the buffer still holds, not only what is new.
    let entries = util::list_or_empty(log::since(0).entries);
    let floor = floor_of(state.log_level);
    let query = state.log_query.to_lower();
    let rows: [any] = [];
    let hidden = 0;
    for entry in entries {
        let matches = query == "" || entry[log_fields::MESSAGE].as_str().to_lower().contains(query) || entry[fields::TAG].as_str().to_lower().contains(query);
        if severity(entry[log_fields::LEVEL]) < floor || !matches {
            hidden += 1;
            continue;
        }
        rows.push(entry);
    }
    let built = Built { mark: mark, rows: rows, hidden: hidden, theme: nil, items: [] };
    state.log_cache = built;
    built
}

/// What the Output panel shows for a level and a search: the log's lines,
/// and what to say when there are none.
pub fn output_view(state: &mut editor::State, level: str, query: str) -> OutputView {
    state.log_level = level;
    state.log_query = query;
    let tokens = state.theme;
    let shown = filtered(state);
    // The lines are made once for the rows the filter kept, and again only for
    // new ones or a new theme.
    if shown.theme != tokens {
        shown.items = log_lines(shown.rows, tokens);
        shown.theme = tokens;
    }
    let says = if shown.rows.len() > 0 {
        ""
    } else if shown.hidden > 0 {
        "{shown.hidden} entries hidden by the filter"
    } else {
        "nothing logged yet"
    };
    OutputView { items: shown.items, says: says }
}

/// The Output panel's "clear".
pub fn output_clear(state: &mut editor::State) {
    log::clear();
    state.log_cache = nil;
}

// One `list` row a log entry: its mark, the time, tag and message, its ink.
fn log_lines(rows: [any], tokens: any) -> [ui::Item] {
    let items: [ui::Item] = [];
    for entry in rows {
        let level = entry[log_fields::LEVEL].as_str();
        let tag = entry[fields::TAG].as_str();
        let tint = tokens[theme_tokens::TEXT_MUTED].as_str();
        let marker = glyphs::DOT;
        if level == statuses::ERROR {
            tint = tokens[theme_tokens::DANGER_TEXT].as_str();
            marker = glyphs::X_CIRCLE;
        } else if level == WARN {
            tint = tokens[theme_tokens::WARNING_TEXT].as_str();
            marker = glyphs::WARNING;
        } else if tag == ENV {
            tint = tokens[theme_tokens::SECONDARY_TEXT].as_str();
        }
        let short = if tag.len() > 9 { tag.slice(0, 9) } else { tag };
        let time = util::fixed(entry[log_fields::TIME].as_float(), 1);
        let line = util::repeat(" ", util::int_max(0, 6 - time.len())) + time;
        items.push(ui::Item { icon: marker, label: "{line}s  {short}  {entry["message"].as_str()}", tint: tint });
    }
    items
}

// Icon and ink by extension, so a directory of assets reads at a glance. The
// tile is one fill for every card; only the mark is typed.
fn asset_look(name: str, is_directory: bool) -> AssetLook {
    if is_directory {
        return AssetLook { icon: icons::panel("assets"), ink: theme_tokens::TEXT_MUTED };
    }
    if name.ends_with(".bs") {
        return AssetLook { icon: icons::ui(icons::SCRIPTFILE), ink: theme_tokens::SECONDARY_TEXT };
    }
    if name.ends_with(".toml") {
        return AssetLook { icon: icons::panel(icons::SCENE), ink: theme_tokens::PRIMARY_TEXT };
    }
    if importer::kind_of(name) == asset_kinds::TEXTURE {
        return AssetLook { icon: icons::workspace(defs::WORKSPACE_UI), ink: theme_tokens::PRIMARY_TEXT };
    }
    return AssetLook { icon: glyphs::DOT, ink: theme_tokens::TEXT_SUBTLE };
}

// Opening a file means the thing the editor can actually do with it: jump to
// the node running a script, or open a scene. Anything else just selects.
fn open_asset(state: &mut editor::State, relative_path: str) {
    if relative_path.ends_with(".toml") && relative_path.starts_with("scenes/") {
        if state.scene_rel != relative_path {
            model::open_scene(state, relative_path);
        }
        return;
    }
    for index in 0..state.nodes.len() {
        if model::script_rel(state.nodes[index]).as_str() == relative_path {
            shell::choose(state, index);
            shell::set_workspace(state, defs::WORKSPACE_SCRIPT);
            return;
        }
    }
    log::info("{relative_path} is not attached to any node");
}

/// The Assets dock's own state, hung on `state.assets`. `selected` is the card acted
/// on by rename and delete; `renaming` swaps the breadcrumb for a field.
pub fn assets_state() -> AssetsState {
    AssetsState { directory: "", selected: "", renaming: false, shown: Shown { paths: [], is_folder: [] } }
}

fn asset_path(state: editor::State, relative_path: str) -> str {
    state.game_root + "/" + relative_path
}

pub fn new_folder(state: &mut editor::State) {
    let base = if state.assets.directory == "" { "new-folder" } else { "{state.assets.directory}/new-folder" };
    let name = base;
    let number = 2;
    while fs::exists(asset_path(state, name)) {
        name = "{base}-{number}";
        number += 1;
    }
    fs::create_directory(asset_path(state, name));
    model::forget(state);
    state.assets.selected = name;
    signals::changed(state, changes::ASSETS);
    log::info("made res://{name}");
}

pub fn rename_asset(state: &mut editor::State, name: str) {
    state.assets.renaming = false;
    if name == "" || name.contains("/") {
        log::warn("a name cannot be empty or contain a slash");
        return;
    }
    let from = state.assets.selected;
    let to = if state.assets.directory == "" { name } else { "{state.assets.directory}/{name}" };
    if from == to {
        return;
    }
    if fs::exists(asset_path(state, to)) {
        log::warn("res://{to} already exists");
        return;
    }
    // The engine moves the file and rewrites every `.toml` naming it.
    let rewritten = assets::rename(asset_path(state, from), asset_path(state, to));
    model::forget(state);
    state.assets.selected = to;
    signals::changed(state, changes::ASSETS);
    log::info("renamed res://{from} to res://{to}; {rewritten.len()} file(s) updated");
}

pub fn delete_asset(state: &mut editor::State) {
    let relative_path = state.assets.selected;
    if fs::remove(asset_path(state, relative_path)) {
        log::info("deleted res://{relative_path}");
    } else {
        log::warn("res://{relative_path} was not there");
    }
    model::forget(state);
    state.assets.selected = "";
    signals::changed(state, changes::ASSETS);
}

/// The installed dependency a project-relative path lies in, as
/// `dependency::list` describes it, or nil for one of the game's own.
fn dependency_at(state: editor::State, relative_path: str) -> dependency::Dependency? {
    if !relative_path.starts_with("deps/") {
        return nil;
    }
    let alias = dependency::of(asset_path(state, relative_path));
    if alias == nil {
        return nil;
    }
    for dependency_entry in dependency::list() {
        if dependency_entry.alias == alias.unwrap() && dependency_entry.game == state.game_root {
            return dependency_entry;
        }
    }
    nil
}

/// Whether a card the browser shows is a folder.
fn shown_folder(state: editor::State, relative_path: str) -> bool {
    let shown = state.assets.shown;
    for index in 0..shown.paths.len() {
        if shown.paths[index] == relative_path {
            return shown.is_folder[index];
        }
    }
    false
}

/// The game's first `path` dependency, where Move to project puts files.
fn shelf(state: editor::State) -> str {
    for dependency_entry in dependency::list() {
        if dependency_entry.kind == general::PATH && dependency_entry.game == state.game_root {
            return dependency_entry.alias;
        }
    }
    ""
}

/// What Edit dependency opens for `dependency_entry`: its folder or its page.
fn source_of(dependency_entry: dependency::Dependency) -> str {
    if dependency_entry.kind == general::PATH {
        return "Open {dependency_entry.path} in a second editor";
    }
    "Open {dependency_entry.project} on Forge"
}

/// Say why a dependency's file is not changed here, and what does change it.
fn refuse_in_dependency(state: editor::State, relative_path: str) -> bool {
    let dependency_entry = dependency_at(state, relative_path);
    if dependency_entry == nil {
        return false;
    }
    log::warn("res://{relative_path} is in the dependency {dependency_entry.unwrap().alias}, which is read-only here: make it local to change it, or edit the dependency");
    true
}

/// Copy the selected dependency file into the game at the same place under
/// the game's root, and point the game at the copy.
fn make_local(state: &mut editor::State) {
    let relative_path = state.assets.selected;
    let dependency_entry = dependency_at(state, relative_path);
    if dependency_entry == nil {
        return;
    }
    let alias = dependency_entry.unwrap().alias;
    let inside = relative_path.slice("deps/{alias}/".len(), relative_path.len());
    let target = inside;
    let copy_number = 2;
    while fs::exists(asset_path(state, target)) {
        let cut = util::index_of(inside, ".");
        let stem = if cut != nil { inside.slice(0, cut.unwrap()) } else { inside };
        let extension = inside.slice(stem.len(), inside.len());
        target = "{stem}_{copy_number}{extension}";
        copy_number += 1;
    }
    let rewritten = dependency::make_local(asset_path(state, relative_path), asset_path(state, target));
    model::forget(state);
    state.assets.selected = target;
    state.assets.directory = util::parent_directory(target);
    log::info("made res://{target} from {alias}; {rewritten.len()} file(s) now name it");
}

/// Move the selected game file into the game's `path` dependency.
fn move_to_shelf(state: &mut editor::State) {
    let alias = shelf(state);
    let relative_path = state.assets.selected;
    if alias == "" || relative_path == "" {
        return;
    }
    let rewritten = dependency::move_into([asset_path(state, relative_path)], alias);
    model::forget(state);
    state.assets.selected = "deps/{alias}/{relative_path}";
    log::info("moved res://{relative_path} into {alias}; {rewritten.len()} file(s) updated");
}

/// Open the dependency the browser is in: a `path` one's folder in a second
/// editor, a Forge one's page.
fn edit_dependency(state: editor::State) {
    let at = if state.assets.selected != "" { state.assets.selected } else { state.assets.directory };
    let found = dependency_at(state, at);
    if found == nil {
        return;
    }
    let dependency_entry = found.unwrap();
    if dependency_entry.kind == general::PATH {
        let opened = util::map_or_empty(project::open_beside(state.game_root + "/" + dependency_entry.path));
        if opened[log_fields::ERROR] != nil {
            log::warn(opened[log_fields::ERROR].as_str());
        }
        return;
    }
    engine::open_url("{forge::url()}/projects/{dependency_entry.project}");
}

/// What the Assets panel shows for a search: where the browser is, its cards
/// and the commands' state. The cards are kept, so a pick names its file.
pub fn assets_view(state: &mut editor::State, query: str) -> AssetsView {
    let tokens = state.theme;
    let directory = state.assets.directory;
    let files: [any] = [];
    for entry in model::list(state, directory) {
        if search::matches(query, entry[fields::NAME].as_str()) {
            files.push(entry);
        }
    }
    // One string a card: the mark, the name, the path it opens and its ink.
    let items: [ui::Item] = [];
    let paths: [str] = [];
    let is_folder: [bool] = [];
    let picked = "";
    for entry in files {
        let name = entry[fields::NAME].as_str();
        let is_directory = entry[project_fields::IS_DIR].as_bool();
        let relative_path = if directory == "" { name } else { "{directory}/{name}" };
        let look = asset_look(name, is_directory);
        // A dependency's files are one shade quieter, as a prefab's rows are:
        // there to use, not to change.
        let ink = if relative_path.starts_with("deps/") { theme_tokens::TEXT_SUBTLE } else { look.ink };
        if relative_path == state.assets.selected {
            picked = relative_path;
        }
        items.push(ui::Item { icon: look.icon, label: name, note: relative_path, tint: tokens[ink].as_str(), key: relative_path });
        paths.push(relative_path);
        is_folder.push(is_directory);
    }
    state.assets.shown = Shown { paths: paths, is_folder: is_folder };
    let importing = dropin::in_flight(state) > 0;
    let here = dependency_at(state, if state.assets.selected != "" { state.assets.selected } else { directory });
    let in_dependency = dependency_at(state, directory);
    let pinned = if in_dependency == nil {
        ""
    } else if in_dependency.unwrap().rev != "" {
        " · {in_dependency.unwrap().rev.slice(0, 7)}"
    } else {
        " · {in_dependency.unwrap().path}"
    };
    let selected_own = state.assets.selected != "" && !state.assets.selected.starts_with("deps/");
    AssetsView {
        dir: directory,
        // A project-relative path: the absolute one is this machine's, and
        // lands in every screenshot.
        where: if in_dependency == nil { "res://{directory}" } else { "res://{directory} · read-only{pinned}" },
        renaming: state.assets.renaming,
        name: util::last_segment(state.assets.selected),
        count: "{files.len()} items",
        importing: importing,
        import_text: if importing { "cancel" } else { "import" },
        import_tip: if importing {
            "Stop the import after the file it is writing"
        } else {
            "Bring in a model, a sprite or a level"
        },
        import_icon: icons::panel(icons::IMPORT),
        folder_icon: icons::ui(icons::ADD),
        up_icon: icons::ui("caret-up"),
        chosen: state.assets.selected != "",
        items: items,
        picked: picked,
        local: here != nil && state.assets.selected != "" && !shown_folder(state, state.assets.selected),
        move_to: if selected_own { shelf(state) } else { "" },
        source_tip: if here == nil { "" } else { source_of(here.unwrap()) },
        update: here != nil && here.unwrap().kind == tabs::FORGE,
    }
}

/// A card clicked: the first click selects it, a second opens it.
pub fn assets_pick(state: &mut editor::State, row: str) {
    let shown = state.assets.shown;
    for index in 0..shown.paths.len() {
        let relative_path = shown.paths[index];
        if relative_path != row {
            continue;
        }
        if relative_path == state.assets.selected {
            if shown.is_folder[index] {
                state.assets.directory = relative_path;
                state.assets.selected = "";
            } else {
                open_asset(state, relative_path);
            }
        } else {
            state.assets.selected = relative_path;
            state.assets.renaming = false;
        }
        signals::changed(state, changes::ASSETS);
        return;
    }
}

/// The strip's commands, by the name of the button pressed; `rename_to` is the
/// new name submitted.
pub fn assets_pressed(state: &mut editor::State, name: str, value: str) {
    let chosen = state.assets.selected != "";
    if name == "Up" {
        state.assets.directory = util::parent_directory(state.assets.directory);
    } else if name == "Import" {
        // Asks and imports: a dialog on a desktop, the page's own chooser in
        // a tab, and the same reports either way.
        if dropin::in_flight(state) > 0 {
            import::cancel();
        } else {
            import::choose();
        }
    } else if name == "Folder" {
        if !refuse_in_dependency(state, state.assets.directory) {
            new_folder(state);
        }
    } else if name == "Local" && chosen {
        make_local(state);
    } else if name == "Move" && chosen {
        move_to_shelf(state);
    } else if name == "Source" {
        edit_dependency(state);
    } else if name == "Update" {
        // `balaur fetch --update`, on a thread; the Library hears it end.
        if forge::fetch(state.game_root, true) {
            log::info("updating the dependencies");
        }
    } else if name == "Rename" && chosen {
        if !refuse_in_dependency(state, state.assets.selected) {
            state.assets.renaming = !state.assets.renaming;
        }
    } else if name == "Delete" && chosen {
        if !refuse_in_dependency(state, state.assets.selected) {
            delete_asset(state);
        }
    } else if name == RENAME_TO {
        rename_asset(state, value);
    }
    signals::changed(state, changes::ASSETS);
}

/// A card dragged out of the Assets panel and let go: over the viewport, the
/// file is placed where the pointer is; anywhere else, nothing happens.
pub fn drop_card(state: &mut editor::State, card: any) -> bool {
    let relative_path = card.as_str();
    if shown_folder(state, relative_path) {
        return false;
    }
    let at = viewport::pointer(state);
    if !viewport::owns_pointer(state, at.x, at.y) {
        return false;
    }
    dropin::place_file(state, relative_path)
}

// A local as one line; a table is its JSON, cut short.
fn value_text(value: any) -> str {
    if value.kind() == types::KIND_MAP || value.kind() == types::KIND_LIST {
        let text = json::encode(value);
        if text.len() > 96 { text.slice(0, 93) + "…" } else { text }
    } else if value.kind() == types::KIND_STRING {
        value.as_str()
    } else {
        "{value}"
    }
}

/// What the Debugger panel shows: the stop and its stack while a script is
/// stopped, and what to do while none is. A row's key starts with its frame,
/// so a pick names it.
pub fn debugger_view(state: &mut editor::State) -> DebuggerView {
    let tokens = state.theme;
    let paused = state.debug.paused;
    let on = debugger::break_on_error();
    if paused.kind() != types::KIND_MAP {
        let where = if state.playing {
            "running · click a line number in the script to set a breakpoint"
        } else {
            "set breakpoints in the script gutter, then run the scene"
        };
        return DebuggerView {
            stopped: false,
            can_pause: state.playing,
            step_icons: step_icons(),
            pause_icon: icons::ui(PAUSE),
            where: where,
            threw: "",
            break_on_error: on,
            frames: [],
            picked: "",
        };
    }
    // A frame is a row, and its locals are rows a level deeper. The caret is
    // the tree's own, so nothing here folds.
    let items: [ui::Item] = [];
    let frames = util::list_or_empty(paused["frames"]);
    for index in 0..frames.len() {
        let frame = frames[index];
        let site = "{shell::script_rel(state, frame["path"].as_str())}:{frame[layout_fields::LINE]}";
        // A recursion stacks frames that read alike; the depth keeps them apart.
        items.push(ui::Item { icon: icons::ui(STEP_INTO), label: frame["function"].as_str(), note: site, key: "{index}" });
        for name in util::keys_sorted(frame[LOCALS]) {
            items.push(ui::Item { label: name, note: value_text(frame[LOCALS][name]), tint: tokens[theme_tokens::TEXT_MUTED].as_str(), key: "{index}/{name}", depth: 1 });
        }
    }
    DebuggerView {
        stopped: true,
        can_pause: false,
        step_icons: step_icons(),
        pause_icon: icons::ui(PAUSE),
        where: "{paused["reason"].as_str()} · {state.debug.paused_rel}:{paused[layout_fields::LINE]}",
        threw: paused["message"].as_str(),
        break_on_error: on,
        frames: items,
        picked: "{state.debug.frame}",
    }
}

fn step_icons() -> [str] {
    [icons::ui(command::PLAY), icons::ui("step-over"), icons::ui(STEP_INTO), icons::ui("step-out")]
}

/// A step pressed, by the name of its button.
pub fn debugger_step(state: &mut editor::State, step: str) {
    let mode = if step == OVER {
        debugger::STEP_OVER
    } else if step == INTO {
        debugger::STEP_INTO
    } else if step == OUT {
        debugger::STEP_OUT
    } else {
        debugger::CONTINUE
    };
    shell::resume(state, mode);
}

/// A row of the stack picked: the frame it is, or is a local of.
pub fn debugger_frame(state: &mut editor::State, row: str) {
    state.debug.frame = row.split("/")[0].parse_int();
    signals::changed(state, changes::DEBUGGER);
}

// Problems: every finding the last sweep produced, worst first, each row a
// file and a line the click opens at.
// The findings in the order the list shows them: the errors first.
fn problem_rows(state: editor::State) -> [any] {
    let rows: [any] = [];
    for finding in state.lint.found {
        if finding[log_fields::SEVERITY].as_str() == statuses::ERROR {
            rows.push(finding);
        }
    }
    for finding in state.lint.found {
        if finding[log_fields::SEVERITY].as_str() != statuses::ERROR {
            rows.push(finding);
        }
    }
    rows
}

fn problem_label(finding: any) -> str {
    let file = finding[project_fields::FILE].as_str();
    let at = if finding[layout_fields::LINE].as_int() > 0 { "{file}:{finding["line"].as_int()}" } else { file };
    "{at}  {finding[log_fields::MESSAGE].as_str()}"
}

fn problem_line(finding: any, tokens: any) -> ui::Item {
    let bad = finding["severity"].as_str() == statuses::ERROR;
    let tint = if bad { tokens[theme_tokens::DANGER_TEXT] } else { tokens[theme_tokens::WARNING_TEXT] };
    ui::Item { icon: if bad { glyphs::X_CIRCLE } else { glyphs::WARNING }, label: problem_label(finding), tint: tint.as_str() }
}

/// What the Problems panel shows: a line a finding, and what to say when
/// there are none.
pub fn problems_view(state: editor::State) -> ProblemsView {
    let items: [ui::Item] = [];
    for finding in problem_rows(state) {
        items.push(problem_line(finding, state.theme));
    }
    let says = if items.len() > 0 {
        ""
    } else if state.lint.at < 0.0 {
        "not checked yet"
    } else {
        "no problems"
    };
    ProblemsView { items: items, says: says }
}

/// The Problems panel picked the line that says `picked`: open what it names.
pub fn problems_pick(state: &mut editor::State, picked: str) {
    for finding in problem_rows(state) {
        if problem_label(finding) == picked {
            open_at(state, finding);
            return;
        }
    }
}

// Select the node whose script this is and show it, so a click lands on the
// code rather than on a file name.
fn open_at(state: &mut editor::State, finding: any) {
    for index in 0..state.nodes.len() {
        if model::script_rel(state.nodes[index]).as_str() == finding[project_fields::FILE].as_str() {
            shell::choose(state, index);
            shell::set_workspace(state, defs::WORKSPACE_SCRIPT);
            return;
        }
    }
    state.doctab = tabs::SCENE;
    signals::inspector(state);
}

// The Recordings panel's rows, under its own scroll; the dock hides the panel
// while a recording is open, and the lanes take its room.
const RECORDINGS: str = "Editor/Shell/Body/Centre/Bottom/Recordings/Rows/Column";

const RECORDING_SCENE: str = "scenes/items/recording.toml";

// A recording's buttons, each named for what it does.
const REPLAY: str = "replay";

const DELETE: str = "delete";

const COPY: str = "copy";

const KEEP: str = "keep";

/// Every recording this game has made, newest first, as a row each. "Keep"
/// renames one out of the ring that prunes the oldest, so a session worth
/// returning to survives the next ten runs.
pub fn recordings_fill(state: &mut editor::State) -> RecordingsFill {
    let rows = session::listing(state);
    let items: [scene::RepeatItem] = [];
    for recording in rows {
        items.push(scene::RepeatItem { key: recording.name, scene: RECORDING_SCENE });
    }
    let nodes = scene::repeat(scene::root().get_node(RECORDINGS), items);
    for at in 0..rows.len() {
        let recording = rows[at];
        let row = nodes[at];
        row.get_node("Name").widget.text = if recording.started == "" { recording.name } else { recording.started };
        row.get_node("Length").widget.text = "{recording.ticks} ticks · {util::fixed(recording.seconds, 1)}s";
        // How it ended, and whether its code has moved on since.
        let ending = row.get_node("Ending");
        ending.set_visible(recording.reason != statuses::STOP);
        ending.widget.text = recording.reason;
        row.get_node("Stale").set_visible(recording.stale);
        row.get_node(KEEP).set_visible(!recording.name.starts_with("kept-"));
    }
    RecordingsFill { verify: state.session.verify, count: rows.len() }
}

/// One of a recording's buttons, by its name: replay, delete, copy or keep.
pub fn recording_pressed(state: &mut editor::State, name: str, button: str) {
    if button == REPLAY {
        session::open(state, name);
    } else if button == DELETE {
        session::remove(state, name);
    } else if button == COPY {
        session::export(state, name);
    } else if button == KEEP {
        session::keep(state, name);
    }
}

/// The Recordings panel's verify switch.
pub fn recordings_verify(state: &mut editor::State) {
    state.session.verify = !state.session.verify;
    signals::changed(state, changes::RECORDINGS);
}

// What one 60 Hz frame costs, as a bar per stage against that budget. The
// editor's own frame is what is measured while it is idle; press Play and it
// becomes the game's, which is the number anyone actually wants.
const BUDGET_MILLISECONDS: float = 16.667;

/// What a live meter shows, `what` being `profiler` or `cost`: its table,
/// its headline, and what to say when there is nothing to measure.
pub fn meter_view(state: editor::State, what: str) -> MeterView {
    let tokens = state.theme;
    if what == command::COST {
        return cost_view(state, tokens);
    }
    let scripts = state.script_profiling;
    let titles = ["what", "cost>", "share of a frame"];
    let widths = ["2", "1", "2"];
    let found = engine::timings();
    if found == nil {
        return MeterView { titles: titles, widths: widths, items: [], says: "no timings yet", headline: frame_hint(), scripts: scripts };
    }
    let timings = found.unwrap();
    let items: [ui::Item] = [];
    let stages: any = timings.stages;
    cost_rows(items, tokens, stages, STAGE);
    if timings.spans.len() > 0 {
        let spans: any = {};
        for span in timings.spans {
            spans[span.name] = span.seconds;
        }
        cost_rows(items, tokens, spans, SPAN);
    }
    if scripts {
        script_rows(items, tokens);
    }
    MeterView { titles: titles, widths: widths, items: items, says: "", headline: frame_hint(), scripts: scripts }
}

/// The Profiler's "scripts": count what each script costs, or stop. Either
/// way every script is rebuilt between frames, with counters or without.
pub fn profiler_scripts(state: &mut editor::State) {
    let on = !state.script_profiling;
    state.script_profiling = on;
    engine::set_script_profiling(on);
}

/// What each script and each of the dearest functions cost the last frame,
/// dearest first, against the dearest of them rather than against the budget:
/// the unit is statements run.
///
/// Statements rather than milliseconds: the same frame runs the same
/// statements on every machine, so a number that moved is a change in what
/// a script does. Re-armed after reading, so a row is one frame's work.
fn script_rows(items: [ui::Item], tokens: any) {
    let costs = engine::script_costs();
    let worst = if costs.len() == 0 { 0.0 } else { costs[0].instructions as float };
    for row in costs {
        let count = row.instructions as float;
        let share = if worst > 0.0 { math::clamp(count / worst, 0.0, 1.0) } else { 0.0 };
        items.push(ui::Item { cells: [row.path, "{row.instructions} st", bar(share)], tint: tokens[theme_tokens::SECONDARY_TEXT].as_str() });
    }
    // Each function's own statements under its file's rows, a handler the
    // form calls by name among them.
    let functions = engine::function_costs();
    let top = if functions.len() == 0 { 0.0 } else { functions[0].instructions as float };
    for index in 0..util::int_min(functions.len(), FUNCTION_ROWS) {
        let row = functions[index];
        let share = if top > 0.0 { math::clamp((row.instructions as float) / top, 0.0, 1.0) } else { 0.0 };
        items.push(ui::Item {
            cells: [row.function, "{row.instructions} st · {row.calls} calls", bar(share)],
            tint: tokens[theme_tokens::TEXT_MUTED].as_str(),
        });
    }
    engine::set_script_profiling(true);
}

/// How many of the dearest functions the Profiler lists under the scripts.
const FUNCTION_ROWS: int = 12;

/// A share as blocks, which reads at a glance where a number has to be read.
/// Twelve cells, so one is about eight percent: twenty overran the Cost
/// dock's column, which is a fifth of the dock.
///
/// Filled blocks and nothing else: a track drawn in the light block reads as
/// noise down a column of them.
fn bar(share: float) -> str {
    util::repeat("█", (math::clamp(share, 0.0, 1.0) * 12.0) as int)
}

// Worst first, by a selection pass: the list is eight rows long.
fn by_cost(table: any) -> [Cost] {
    let left: [Cost] = [];
    for name in table.keys() {
        left.push(Cost { name: name, milliseconds: table[name].as_float() * 1000.0 });
    }
    let out: [Cost] = [];
    while left.len() > 0 {
        let worst = 0;
        let index = 1;
        while index < left.len() {
            if left[index].milliseconds > left[worst].milliseconds {
                worst = index;
            }
            index += 1;
        }
        out.push(left.remove(worst));
    }
    out
}

// One row per entry, worst first, with a bar as its share of the budget: a
// number needs reading, a bar does not.
fn cost_rows(items: [ui::Item], tokens: any, table: any, kind: str) {
    for row in by_cost(table) {
        let tint = (if row.milliseconds > BUDGET_MILLISECONDS * 0.5 {
            tokens[theme_tokens::PRIMARY_TEXT]
        } else if kind == SPAN {
            tokens[theme_tokens::SECONDARY_TEXT]
        } else {
            tokens[theme_tokens::TEXT_MUTED]
        }).as_str();
        items.push(ui::Item {
            cells: [row.name, util::fixed(row.milliseconds, 3) + " ms", bar(row.milliseconds / BUDGET_MILLISECONDS)],
            tint: tint,
        });
    }
}

/// Bytes as the unit a person reads them in.
fn bytes(size: float) -> str {
    if size < 1024.0 {
        return "{size as int} B";
    }
    if size < 1048576.0 {
        return util::fixed(size / 1024.0, 1) + " KB";
    }
    util::fixed(size / 1048576.0, 1) + " MB"
}

/// Nodes by triangles, worst first: the same selection pass `by_cost` uses,
/// on a frame's node list, which is short.
fn by_triangles(rows: [render::NodeCost]) -> [render::NodeCost] {
    let left: [render::NodeCost] = [];
    for row in rows {
        left.push(row);
    }
    let out: [render::NodeCost] = [];
    while left.len() > 0 {
        let worst = 0;
        for index in 1..left.len() {
            if left[index].triangles > left[worst].triangles {
                worst = index;
            }
        }
        out.push(left.remove(worst));
    }
    out
}

/// What the frame draws, per node: the other half of the Profiler, beside the
/// milliseconds. `render.stats` counts it from the scene, so a headless run
/// reports the same triangles a windowed one does.
fn cost_view(state: editor::State, tokens: any) -> MeterView {
    let titles = [NODE, "triangles>", "textures>", "copies>", "share of the worst"];
    let widths = ["2", "1", "1", "0.7", "1.6"];
    let nodes = by_triangles(render::stats().nodes);
    let headline = cost_hint(state, 1000.0);
    if nodes.len() == 0 {
        return MeterView { titles: titles, widths: widths, items: [], says: "nothing is drawing", headline: headline, scripts: false };
    }
    let worst = math::max(nodes[0].triangles, 1.0);
    let items: [ui::Item] = [];
    for row in nodes {
        let copies = row.copies as int;
        items.push(ui::Item {
            cells: [
                util::leaf(row.node),
                "{row.triangles as int} tri",
                bytes(row.texture_bytes),
                if copies > 1 { "x{copies}" } else { "" },
                bar(math::clamp(row.triangles / worst, 0.0, 1.0)),
            ],
            tint: tokens[theme_tokens::TEXT_MUTED].as_str(),
        });
    }
    MeterView { titles: titles, widths: widths, items: items, says: "", headline: headline, scripts: false }
}

/// How big the last export was, or a line saying none has been made. The
/// pack is what a player downloads, so it belongs beside the frame's cost.
fn pack_size(state: editor::State) -> str {
    let out = export::output(WEB);
    if !fs::exists(out) {
        return "not exported yet";
    }
    let total = 0;
    for entry in util::list_or_empty(fs::list(out)) {
        if !entry[project_fields::IS_DIR].as_bool() {
            total += 1;
        }
    }
    "{total} file(s) at {util::leaf(out)}"
}
