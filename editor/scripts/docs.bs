// The Docs dock: the script reference, from the live engine rather than a
// file. A go-to-definition on `physics2d::raycast` lands here, because engine
// API has no source file to open.

use docks;
use editor;
use search;
use signals;
use util;

pub class DocsState {
    modules: any,
    pick: str,
    fn_pick: str,
}

/// What the Docs panel shows: the module names, the one picked, its rows, and
/// what to say when there is nothing to list.
pub struct View {
    modules: [str],
    pick: str,
    items: [str],
    says: str,
}

pub fn state() -> DocsState {
    DocsState { modules: nil, pick: "", fn_pick: "" }
}

// Every module, asked once per session: `script::api` builds the whole
// reference on each call, which is not a per-frame cost worth paying.
fn modules(S: &mut editor::State) -> any {
    if S.docs.modules.is_nil() {
        S.docs.pick = if S.docs.pick == "" { "engine" } else { S.docs.pick };
        S.docs.modules = script::api();
    }
    S.docs.modules
}

/// Show a module's page, and one of its functions when named.
/// `shell::goto_definition` calls this when the definition is engine API.
pub fn show(S: &mut editor::State, module: str, name: str) {
    S.docs.pick = module;
    S.docs.fn_pick = name;
    docks::show(S, "docs");
    signals::changed(S, "docs");
}

/// The Docs panel picked a module.
pub fn pick(S: &mut editor::State, module: str) {
    S.docs.pick = module;
    S.docs.fn_pick = "";
}

// The module the dock is showing; nil when none is.
fn current(S: editor::State, list: any) -> any {
    for m in list {
        if m.name.as_str() == S.docs.pick {
            return m;
        }
    }
    nil
}

/// What the Docs panel shows for `query`.
pub fn view(S: &mut editor::State, query: str) -> View {
    let k = S.theme;
    let list = util::vec(modules(S));
    let names: [str] = [];
    for m in list {
        names.push(m.name.as_str());
    }
    let m = current(S, list);
    if m.is_nil() {
        let says = if list.len() == 0 { "the engine reported no modules" } else { "pick a module" };
        return View { modules: names, pick: S.docs.pick, items: [], says: says };
    }
    let items: [str] = [];
    if m.doc.as_str() != "" {
        items.push(util::row("", m.doc.as_str(), "", k.text_muted.as_str()));
    }
    let shown = 0;
    for f in util::vec(m.functions) {
        let name = f.as_str();
        if !search::matches(query, name) {
            continue;
        }
        shown += 1;
        let tint = if name == S.docs.fn_pick { k.primary_text } else { k.text_default };
        items.push(util::row("", name + m.signatures.get(name).as_str(), "", tint.as_str()));
        let doc = m.docs.get(name).as_str();
        if doc != "" {
            items.push(util::row("", "\t  " + doc, "", k.text_subtle.as_str()));
        }
    }
    if query == "" {
        for c in util::vec(m.constants) {
            items.push(util::row("", "{c.name.as_str()}  {c.value.as_str()}", "", k.text_subtle.as_str()));
        }
    }
    let says = if shown == 0 && query != "" { search::nothing_says(query) } else { "" };
    View { modules: names, pick: S.docs.pick, items: items, says: says }
}
