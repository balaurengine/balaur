// The Docs dock: the script reference, from the live engine rather than a
// file. A go-to-definition on `physics2d::raycast` lands here, because engine
// API has no source file to open.

use docks;
use editor;
use search;
use signals;
use util;

pub class DocsState {
    modules: any,
    pick: str,
    fn_pick: str,
}

/// What the Docs panel shows: the module names, the one picked, its rows, and
/// what to say when there is nothing to list.
pub struct View {
    modules: [str],
    pick: str,
    items: [str],
    says: str,
}

pub fn state() -> DocsState {
    DocsState { modules: nil, pick: "", fn_pick: "" }
}

// Every module, asked once per session: `script::api` builds the whole
// reference on each call, which is not a per-frame cost worth paying.
fn modules(state: &mut editor::State) -> any {
    if state.docs.modules.is_nil() {
        state.docs.pick = if state.docs.pick == "" { "engine" } else { state.docs.pick };
        state.docs.modules = script::api();
    }
    state.docs.modules
}

/// Show a module's page, and one of its functions when named.
/// `shell::goto_definition` calls this when the definition is engine API.
pub fn show(state: &mut editor::State, module: str, name: str) {
    state.docs.pick = module;
    state.docs.fn_pick = name;
    docks::show(state, "docs");
    signals::changed(state, "docs");
}

/// The Docs panel picked a module.
pub fn pick(state: &mut editor::State, module: str) {
    state.docs.pick = module;
    state.docs.fn_pick = "";
}

// The module the dock is showing; nil when none is.
fn current(state: editor::State, list: any) -> any {
    for module in list {
        if module.name.as_str() == state.docs.pick {
            return module;
        }
    }
    nil
}

/// What the Docs panel shows for `query`.
pub fn view(state: &mut editor::State, query: str) -> View {
    let tokens = state.theme;
    let list = util::vec(modules(state));
    let names: [str] = [];
    for module in list {
        names.push(module.name.as_str());
    }
    let module = current(state, list);
    if module.is_nil() {
        let says = if list.len() == 0 { "the engine reported no modules" } else { "pick a module" };
        return View { modules: names, pick: state.docs.pick, items: [], says: says };
    }
    let items: [str] = [];
    if module.doc.as_str() != "" {
        items.push(util::row("", module.doc.as_str(), "", tokens.text_muted.as_str()));
    }
    let shown = 0;
    for function in util::vec(module.functions) {
        let name = function.as_str();
        if !search::matches(query, name) {
            continue;
        }
        shown += 1;
        let tint = if name == state.docs.fn_pick { tokens.primary_text } else { tokens.text_default };
        items.push(util::row("", name + module.signatures.get(name).as_str(), "", tint.as_str()));
        let doc = module.docs.get(name).as_str();
        if doc != "" {
            items.push(util::row("", "\t  " + doc, "", tokens.text_subtle.as_str()));
        }
    }
    if query == "" {
        for constant in util::vec(module.constants) {
            items.push(util::row("", "{constant.name.as_str()}  {constant.value.as_str()}", "", tokens.text_subtle.as_str()));
        }
    }
    let says = if shown == 0 && query != "" { search::nothing_says(query) } else { "" };
    View { modules: names, pick: state.docs.pick, items: items, says: says }
}
