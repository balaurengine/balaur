// The Pen tool: a `path2d` asset edited in the viewport. Its points are cubic
// control points, so anchor `k` is at `3k` and its handles at `3k ± 1`.

use editor;
use history;
use model;
use selection;
use signals;
use util;
use viewport;

pub class PenState {
    hover: int,
    drag: Drag?,
    path: Loaded?,
    reference: str,
    dirty: bool,
}

/// The path being edited: shared with `S.pen`, so an edit to one is an edit
/// to the cached copy.
pub class Loaded {
    points: [[float]],
    closed: bool,
}

/// The handle being pulled: the anchor it belongs to, and whether the pair
/// is broken.
pub struct Drag {
    at: int,
    broken: bool,
}

pub fn state() -> PenState {
    // `hover` is the point under the pointer, -1 for none.
    PenState { hover: -1, drag: nil, path: nil, reference: "", dirty: false }
}

const PICK_PX: float = 9.0;

const MARK_PX: float = 4.5;

const W: float = 1.6;

/// The `path2d` reference the selected node strokes, or "" when it strokes
/// none. A polyline names it where a mesh-backed one names a mesh.
pub fn reference(S: editor::State) -> str {
    let node = model::selected_row(S);
    if node.is_nil() {
        return "";
    }
    let shape = node.shape2d;
    if shape.kind() == "map" && shape.kind.as_str() == render::SHAPE_POLYLINE {
        return shape.mesh.as_str();
    }
    ""
}

/// Whether the Pen has something to edit.
pub fn editable(S: editor::State) -> bool {
    let found = reference(S);
    found != "" && is_path(S, found)
}

/// Where the asset actually is. A node names it game-relative, and the
/// editor's own asset resolver reads against the editor's project, so every
/// read and write here goes through the game's root.
fn asset_path(S: editor::State, found: str) -> str {
    if found.starts_with("#") || found.starts_with("/") {
        found
    } else {
        S.game_root + "/" + found
    }
}

fn is_path(S: editor::State, found: str) -> bool {
    let definition = assets::load(asset_path(S, found));
    definition.kind() == "map" && definition.type.as_str() == "path2d"
}

/// The path the selection strokes, cached on `S` for the frames between
/// edits: reading it asks the asset cache every time.
pub fn current(S: &mut editor::State) -> Loaded? {
    let found = reference(S);
    if found == "" {
        S.pen.path = nil;
        S.pen.reference = "";
        return nil;
    }
    if S.pen.reference == found && S.pen.path.is_some() {
        return S.pen.path;
    }
    let definition = assets::load(asset_path(S, found));
    if definition.kind() != "map" {
        return nil;
    }
    let points: [[float]] = [];
    for p in util::vec(definition.points) {
        points.push(util::vec2(p, [0.0, 0.0]));
    }
    let loaded = Loaded { points: points, closed: definition.closed.as_bool() };
    S.pen.reference = found;
    S.pen.path = loaded;
    loaded
}

/// Write the edited path back to its asset. An inline one lands in the scene's
/// `[[assets]]`; a file one is rewritten where it lies.
fn save(S: &mut editor::State) {
    let found = S.pen.reference;
    if found == "" || S.pen.path.is_none() {
        return;
    }
    let path = S.pen.path.unwrap();
    let definition = map().with("type", "path2d").with("points", path.points).with("closed", path.closed);
    assets::save(asset_path(S, found), definition);
    model::forget(S, nil);
    // The stroke is drawn from the asset, so the node has to be told the file
    // under it moved; re-applying the component is what re-reads it.
    let node = model::selected_row(S);
    if !node.is_nil() && node.has("shape2d") {
        model::apply_component(S, "shape2d");
    }
}

/// Where the pen's points live in the world. A path is authored in the node's
/// own space, so the node's pose places it, the way a polygon's is.
fn frame(S: editor::State) -> util::Frame? {
    let found = model::live(S, S.sel);
    if found.is_valid() {
        util::frame_of(found)
    } else {
        nil
    }
}

/// Append an anchor at the end, with handles level with the segment it makes,
/// so a click-click-click draws a smooth chain rather than a set of corners.
pub fn add_anchor(S: &mut editor::State, lx: float, ly: float) {
    let path_or = current(S);
    if path_or.is_none() {
        return;
    }
    let path = path_or.unwrap();
    if path.closed {
        log::info("this path is closed; open it to add a point");
        return;
    }
    history::record(S, "add path point", nil);
    let points = path.points;
    if points.len() == 0 {
        points.push([lx, ly]);
    } else if points.len() == 1 {
        // Two points on their own are a straight line, which the asset reads
        // without control points.
        points.push([lx, ly]);
    } else {
        // Promote the straight pair to cubics, then append the segment.
        if points.len() == 2 {
            let a = points[0];
            let b = points[1];
            points = [a, lerp(a, b, 1.0 / 3.0), lerp(a, b, 2.0 / 3.0), b];
            path.points = points;
        }
        let last = points[points.len() - 1];
        let next = [lx, ly];
        points.push(lerp(last, next, 1.0 / 3.0));
        points.push(lerp(last, next, 2.0 / 3.0));
        points.push(next);
    }
    S.pen.dirty = true;
    save(S);
}

fn lerp(a: [float], b: [float], t: float) -> [float] {
    [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t]
}

/// Move one control point. An anchor takes its handles with it; a handle
/// mirrors its partner unless the drag broke the pair.
pub fn move_point(S: &mut editor::State, at: int, lx: float, ly: float, broken: bool) {
    let path_or = current(S);
    if path_or.is_none() {
        return;
    }
    let path = path_or.unwrap();
    let points = path.points;
    if at >= points.len() {
        return;
    }
    history::record(S, "move path point", "pen:{at}");
    let was = points[at];
    let delta = [lx - was[0], ly - was[1]];
    points[at] = [lx, ly];
    let count = points.len();
    if points.len() > 2 && at % 3 == 0 {
        // An anchor: both handles follow, so the curve does not kink.
        for side in [at - 1, at + 1] {
            if side >= 0 && side < count {
                let h = points[side];
                points[side] = [h[0] + delta[0], h[1] + delta[1]];
            }
        }
    } else if points.len() > 2 && !broken {
        // A handle: its partner across the anchor mirrors it.
        let anchor = if at % 3 == 1 { at - 1 } else { at + 1 };
        let partner = if at % 3 == 1 { at - 2 } else { at + 2 };
        if partner >= 0 && anchor < count && partner < count {
            let a = points[anchor];
            points[partner] = [a[0] - (lx - a[0]), a[1] - (ly - a[1])];
        }
    }
    S.pen.dirty = true;
    save(S);
}

/// Take one anchor out, with the handles that belonged to it.
pub fn remove_anchor(S: &mut editor::State, at: int) {
    let path_or = current(S);
    if path_or.is_none() {
        return;
    }
    let path = path_or.unwrap();
    let points = path.points;
    if at % 3 != 0 || points.len() <= 2 {
        return;
    }
    history::record(S, "remove path point", nil);
    // The anchor and the handle on each side of it, clamped at the ends.
    let from = if at == 0 { 0 } else { at - 1 };
    let take = if at == 0 || at == points.len() - 1 { 2 } else { 3 };
    let kept: [[float]] = [];
    for i in 0..points.len() {
        let p = points[i];
        if i < from || i >= from + take {
            kept.push(p);
        }
    }
    path.points = kept;
    S.pen.dirty = true;
    save(S);
}

/// Join the last anchor back to the first, or open a closed path.
pub fn toggle_closed(S: &mut editor::State) {
    let path_or = current(S);
    if path_or.is_none() {
        return;
    }
    let path = path_or.unwrap();
    if !path.closed && path.points.len() < 4 {
        log::info("a path needs three points before it can close");
        return;
    }
    history::record(S, if path.closed { "open path" } else { "close path" }, nil);
    if path.closed {
        path.closed = false;
        // The closing segment's two handles have no anchor to end on.
        let kept: [[float]] = [];
        for i in 0..path.points.len() {
            let p = path.points[i];
            if i + 2 < path.points.len() || path.points.len() % 3 != 0 {
                kept.push(p);
            }
        }
        path.points = kept;
    } else {
        let last = path.points[path.points.len() - 1];
        let first = path.points[0];
        path.points.push(lerp(last, first, 1.0 / 3.0));
        path.points.push(lerp(last, first, 2.0 / 3.0));
        path.closed = true;
    }
    S.pen.dirty = true;
    save(S);
}

/// Make a node that strokes a fresh, empty `path2d`, so the Pen has something
/// to draw into from a scene that has none.
pub fn new_path(S: &mut editor::State) {
    let name = model::unique_name(S.doc, "Path");
    let rel = "paths/{name.to_lower()}.toml";
    assets::save(S.game_root + "/" + rel, map().with("type", "path2d").with("points", []).with("closed", false));
    history::record(S, "add path", nil);
    S.doc.push(map()
        .with("id", model::fresh_id(S.doc, name))
        .with("name", name)
        .with("parent", model::root_id(S.doc))
        .with("transform", map().with("position", [0.0, 0.0, 0.0]))
        .with("shape2d", map().with("kind", render::SHAPE_POLYLINE).with("mesh", rel).with("width", 0.06)));
    model::forget(S, nil);
    model::build_mirror(S);
    selection::only(S, S.doc.len() - 1);
    S.tool = "pen";
    signals::inspector(S);
    log::info("added " + rel);
}

/// The control point under the pointer, or -1.
fn pick(S: editor::State, path: Loaded, f: util::Frame, mx: float, my: float) -> int {
    let reach = PICK_PX * viewport::world_per_px(S);
    let best = -1;
    let best_d = reach;
    for i in 0..path.points.len() {
        let p = path.points[i];
        let w = util::to_world(f, p[0], p[1]);
        let d = math::sqrt((w.x - mx) * (w.x - mx) + (w.y - my) * (w.y - my));
        // Anchors win ties: a handle sits on top of one when it is not pulled.
        let holds_handle = best >= 0 && best % 3 != 0;
        if d < best_d || (d <= reach && i % 3 == 0 && holds_handle) {
            best = i;
            best_d = d;
        }
    }
    best
}

/// Runs every frame while the Pen is the active tool, from the 2D gizmo's
/// dispatch. `mx`/`my` are the pointer in world units.
pub fn update(S: &mut editor::State, over_viewport: bool, mx: float, my: float) {
    let path_or = current(S);
    if path_or.is_none() {
        S.pen.hover = -1;
        return;
    }
    let path = path_or.unwrap();
    let f_or = frame(S);
    if f_or.is_none() {
        return;
    }
    let f = f_or.unwrap();
    S.pen.hover = if over_viewport { pick(S, path, f, mx, my) } else { -1 };
    let broken = input::key_down(input::KEY_ALT);
    if over_viewport && input::mouse_just_pressed(input::MOUSE_BUTTON_LEFT) {
        let hit = S.pen.hover;
        if hit >= 0 {
            // Clicking the first anchor with a chain behind it closes the
            // path, the way every pen tool closes one.
            if hit == 0 && path.points.len() >= 4 && !path.closed {
                toggle_closed(S);
            } else {
                S.pen.drag = Drag { at: hit, broken: broken };
            }
        } else {
            let l = util::to_local(f, mx, my);
            add_anchor(S, l.x, l.y);
            // The new anchor is the one a drag now pulls a handle from.
            if S.pen.path.is_some() {
                S.pen.drag = Drag { at: S.pen.path.unwrap().points.len() - 1, broken: broken };
            }
        }
    }
    if over_viewport && input::mouse_just_pressed(input::MOUSE_BUTTON_RIGHT) {
        let hit = S.pen.hover;
        if hit >= 0 && hit % 3 == 0 {
            remove_anchor(S, hit);
        }
    }
    if !input::mouse_down(input::MOUSE_BUTTON_LEFT) {
        if S.pen.drag.is_some() {
            history::commit(S);
        }
        S.pen.drag = nil;
        return;
    }
    if S.pen.drag.is_some() {
        let pull = S.pen.drag.unwrap();
        let l = util::to_local(f, mx, my);
        move_point(S, pull.at, l.x, l.y, pull.broken);
    }
}

pub fn cancel(S: &mut editor::State) {
    S.pen.drag = nil;
    S.pen.hover = -1;
}

/// Anchors as squares, handles as dots on their tethers, and the sampled
/// curve as a line. Drawn over the stroke the renderer already draws.
pub fn draw(S: &mut editor::State) {
    if S.tool != "pen" {
        return;
    }
    let path_or = current(S);
    if path_or.is_none() {
        return;
    }
    let path = path_or.unwrap();
    let f_or = frame(S);
    if f_or.is_none() {
        return;
    }
    let f = f_or.unwrap();
    let k = S.theme;
    let accent = util::rgb(k.primary_text.as_str());
    let dim = util::rgb(k.text_muted.as_str());
    let mark = MARK_PX * viewport::world_per_px(S);
    for i in 0..path.points.len() {
        let p = path.points[i];
        let w = util::to_world(f, p[0], p[1]);
        let wx = w.x;
        let wy = w.y;
        let is_anchor = path.points.len() < 3 || i % 3 == 0;
        let c = if S.pen.hover == i || is_anchor { accent } else { dim };
        if is_anchor {
            let r = mark;
            render::draw_line_2d(wx - r, wy - r, wx + r, wy - r, c[0], c[1], c[2], W);
            render::draw_line_2d(wx + r, wy - r, wx + r, wy + r, c[0], c[1], c[2], W);
            render::draw_line_2d(wx + r, wy + r, wx - r, wy + r, c[0], c[1], c[2], W);
            render::draw_line_2d(wx - r, wy + r, wx - r, wy - r, c[0], c[1], c[2], W);
        } else {
            // The tether to the anchor this handle belongs to.
            let anchor = if i % 3 == 1 { i - 1 } else { i + 1 };
            if anchor < path.points.len() {
                let a = path.points[anchor];
                let aw = util::to_world(f, a[0], a[1]);
                render::draw_line_2d(aw.x, aw.y, wx, wy, dim[0], dim[1], dim[2], 1.0);
            }
            let r = mark * 0.7;
            render::draw_line_2d(wx - r, wy, wx + r, wy, c[0], c[1], c[2], W);
            render::draw_line_2d(wx, wy - r, wx, wy + r, c[0], c[1], c[2], W);
        }
    }
}
