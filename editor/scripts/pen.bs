// The Pen tool: a `path2d` asset edited in the viewport. Its points are cubic
// control points, so anchor `k` is at `3k` and its handles at `3k ± 1`.

use editor;
use history;
use model;
use selection;
use signals;
use util;
use viewport;

pub class PenState {
    hover: int,
    drag: Drag?,
    path: Loaded?,
    reference: str,
    dirty: bool,
}

/// The path being edited: shared with `state.pen`, so an edit to one is an edit
/// to the cached copy.
pub class Loaded {
    points: [[float]],
    closed: bool,
}

/// The handle being pulled: the anchor it belongs to, and whether the pair
/// is broken.
pub struct Drag {
    at: int,
    broken: bool,
}

pub fn state() -> PenState {
    // `hover` is the point under the pointer, -1 for none.
    PenState { hover: -1, drag: nil, path: nil, reference: "", dirty: false }
}

const PICK_PX: float = 9.0;

const MARK_PX: float = 4.5;

const LINE_WIDTH: float = 1.6;

/// The `path2d` reference the selected node strokes, or "" when it strokes
/// none. A polyline names it where a mesh-backed one names a mesh.
pub fn reference(state: editor::State) -> str {
    let found = model::selected_node(state);
    if !found.is_valid() || !found.has_component("shape2d") {
        return "";
    }
    let shape = found.authored("shape2d");
    if shape.kind.as_str() == render::SHAPE_POLYLINE {
        return shape.mesh.as_str();
    }
    ""
}

/// Whether the Pen has something to edit.
pub fn editable(state: editor::State) -> bool {
    let found = reference(state);
    found != "" && is_path(state, found)
}

/// Where the asset actually is. A node names it game-relative, and the
/// editor's own asset resolver reads against the editor's project, so every
/// read and write here goes through the game's root.
fn asset_path(state: editor::State, found: str) -> str {
    if found.starts_with("#") || found.starts_with("/") {
        found
    } else {
        state.game_root + "/" + found
    }
}

fn is_path(state: editor::State, found: str) -> bool {
    let definition = assets::load(asset_path(state, found));
    definition.kind() == "map" && definition.type.as_str() == "path2d"
}

/// The path the selection strokes, cached on `state` for the frames between
/// edits: reading it asks the asset cache every time.
pub fn current(state: &mut editor::State) -> Loaded? {
    let found = reference(state);
    if found == "" {
        state.pen.path = nil;
        state.pen.reference = "";
        return nil;
    }
    if state.pen.reference == found && state.pen.path.is_some() {
        return state.pen.path;
    }
    let definition = assets::load(asset_path(state, found));
    if definition.kind() != "map" {
        return nil;
    }
    let points: [[float]] = [];
    for point in util::vec(definition.points) {
        points.push(util::vec2(point, [0.0, 0.0]));
    }
    let loaded = Loaded { points: points, closed: definition.closed.as_bool() };
    state.pen.reference = found;
    state.pen.path = loaded;
    loaded
}

/// Write the edited path back to its asset. An inline one lands in the scene's
/// `[[assets]]`; a file one is rewritten where it lies.
fn save(state: &mut editor::State) {
    let found = state.pen.reference;
    if found == "" || state.pen.path.is_none() {
        return;
    }
    let path = state.pen.path.unwrap();
    let definition = map().with("type", "path2d").with("points", path.points).with("closed", path.closed);
    assets::save(asset_path(state, found), definition);
    model::forget(state, nil);
    // The stroke is drawn from the asset, so the node has to be told the file
    // under it moved; re-applying the component is what re-reads it.
    let stroked = model::selected_node(state);
    if stroked.is_valid() && stroked.has_component("shape2d") {
        stroked.set_component("shape2d", stroked.authored("shape2d"));
    }
}

/// Where the pen's points live in the world. A path is authored in the node's
/// own space, so the node's pose places it, the way a polygon's is.
fn frame(state: editor::State) -> util::Frame? {
    let found = model::selected_node(state);
    if found.is_valid() {
        util::frame_of(found)
    } else {
        nil
    }
}

/// Append an anchor at the end, with handles level with the segment it makes,
/// so a click-click-click draws a smooth chain rather than a set of corners.
pub fn add_anchor(state: &mut editor::State, lx: float, ly: float) {
    let path_or = current(state);
    if path_or.is_none() {
        return;
    }
    let path = path_or.unwrap();
    if path.closed {
        log::info("this path is closed; open it to add a point");
        return;
    }
    history::record(state, "add path point", nil);
    let points = path.points;
    if points.len() == 0 {
        points.push([lx, ly]);
    } else if points.len() == 1 {
        // Two points on their own are a straight line, which the asset reads
        // without control points.
        points.push([lx, ly]);
    } else {
        // Promote the straight pair to cubics, then append the segment.
        if points.len() == 2 {
            let first = points[0];
            let second = points[1];
            points = [first, lerp(first, second, 1.0 / 3.0), lerp(first, second, 2.0 / 3.0), second];
            path.points = points;
        }
        let last = points[points.len() - 1];
        let next = [lx, ly];
        points.push(lerp(last, next, 1.0 / 3.0));
        points.push(lerp(last, next, 2.0 / 3.0));
        points.push(next);
    }
    state.pen.dirty = true;
    save(state);
}

fn lerp(from: [float], to: [float], amount: float) -> [float] {
    [from[0] + (to[0] - from[0]) * amount, from[1] + (to[1] - from[1]) * amount]
}

/// Move one control point. An anchor takes its handles with it; a handle
/// mirrors its partner unless the drag broke the pair.
pub fn move_point(state: &mut editor::State, at: int, lx: float, ly: float, broken: bool) {
    let path_or = current(state);
    if path_or.is_none() {
        return;
    }
    let path = path_or.unwrap();
    let points = path.points;
    if at >= points.len() {
        return;
    }
    history::record(state, "move path point", "pen:{at}");
    let was = points[at];
    let delta = [lx - was[0], ly - was[1]];
    points[at] = [lx, ly];
    let count = points.len();
    if points.len() > 2 && at % 3 == 0 {
        // An anchor: both handles follow, so the curve does not kink.
        for side in [at - 1, at + 1] {
            if side >= 0 && side < count {
                let handle = points[side];
                points[side] = [handle[0] + delta[0], handle[1] + delta[1]];
            }
        }
    } else if points.len() > 2 && !broken {
        // A handle: its partner across the anchor mirrors it.
        let anchor = if at % 3 == 1 { at - 1 } else { at + 1 };
        let partner = if at % 3 == 1 { at - 2 } else { at + 2 };
        if partner >= 0 && anchor < count && partner < count {
            let anchor_point = points[anchor];
            points[partner] = [anchor_point[0] - (lx - anchor_point[0]), anchor_point[1] - (ly - anchor_point[1])];
        }
    }
    state.pen.dirty = true;
    save(state);
}

/// Take one anchor out, with the handles that belonged to it.
pub fn remove_anchor(state: &mut editor::State, at: int) {
    let path_or = current(state);
    if path_or.is_none() {
        return;
    }
    let path = path_or.unwrap();
    let points = path.points;
    if at % 3 != 0 || points.len() <= 2 {
        return;
    }
    history::record(state, "remove path point", nil);
    // The anchor and the handle on each side of it, clamped at the ends.
    let from = if at == 0 { 0 } else { at - 1 };
    let take = if at == 0 || at == points.len() - 1 { 2 } else { 3 };
    let kept: [[float]] = [];
    for index in 0..points.len() {
        let point = points[index];
        if index < from || index >= from + take {
            kept.push(point);
        }
    }
    path.points = kept;
    state.pen.dirty = true;
    save(state);
}

/// Join the last anchor back to the first, or open a closed path.
pub fn toggle_closed(state: &mut editor::State) {
    let path_or = current(state);
    if path_or.is_none() {
        return;
    }
    let path = path_or.unwrap();
    if !path.closed && path.points.len() < 4 {
        log::info("a path needs three points before it can close");
        return;
    }
    history::record(state, if path.closed { "open path" } else { "close path" }, nil);
    if path.closed {
        path.closed = false;
        // The closing segment's two handles have no anchor to end on.
        let kept: [[float]] = [];
        for index in 0..path.points.len() {
            let point = path.points[index];
            if index + 2 < path.points.len() || path.points.len() % 3 != 0 {
                kept.push(point);
            }
        }
        path.points = kept;
    } else {
        let last = path.points[path.points.len() - 1];
        let first = path.points[0];
        path.points.push(lerp(last, first, 1.0 / 3.0));
        path.points.push(lerp(last, first, 2.0 / 3.0));
        path.closed = true;
    }
    state.pen.dirty = true;
    save(state);
}

/// Make a node that strokes a fresh, empty `path2d`, so the Pen has something
/// to draw into from a scene that has none.
pub fn new_path(state: &mut editor::State) {
    let name = model::unique_name(state, "Path");
    let rel = "paths/{name.to_lower()}.toml";
    assets::save(state.game_root + "/" + rel, map().with("type", "path2d").with("points", []).with("closed", false));
    model::forget(state, nil);
    history::record(state, "add path", nil);
    let made = model::spawn(state, state.scene_root.unwrap(), name, map()
        .with("transform", map().with("position", [0.0, 0.0, 0.0]))
        .with("shape2d", map().with("kind", render::SHAPE_POLYLINE).with("mesh", rel).with("width", 0.06)));
    model::reindex(state);
    selection::only(state, model::index_of_node(state, made).unwrap_or(0));
    state.tool = "pen";
    signals::inspector(state);
    log::info("added " + rel);
}

/// The control point under the pointer, or -1.
fn pick(state: editor::State, path: Loaded, node_frame: util::Frame, mx: float, my: float) -> int {
    let reach = PICK_PX * viewport::world_per_px(state);
    let best = -1;
    let best_distance = reach;
    for index in 0..path.points.len() {
        let point = path.points[index];
        let world = util::to_world(node_frame, point[0], point[1]);
        let distance = math::sqrt((world.x - mx) * (world.x - mx) + (world.y - my) * (world.y - my));
        // Anchors win ties: a handle sits on top of one when it is not pulled.
        let holds_handle = best >= 0 && best % 3 != 0;
        if distance < best_distance || (distance <= reach && index % 3 == 0 && holds_handle) {
            best = index;
            best_distance = distance;
        }
    }
    best
}

/// Runs every frame while the Pen is the active tool, from the 2D gizmo's
/// dispatch. `mx`/`my` are the pointer in world units.
pub fn update(state: &mut editor::State, over_viewport: bool, mx: float, my: float) {
    let path_or = current(state);
    if path_or.is_none() {
        state.pen.hover = -1;
        return;
    }
    let path = path_or.unwrap();
    let frame_or = frame(state);
    if frame_or.is_none() {
        return;
    }
    let node_frame = frame_or.unwrap();
    state.pen.hover = if over_viewport { pick(state, path, node_frame, mx, my) } else { -1 };
    let broken = input::key_down(input::KEY_ALT);
    if over_viewport && input::mouse_just_pressed(input::MOUSE_BUTTON_LEFT) {
        let hit = state.pen.hover;
        if hit >= 0 {
            // Clicking the first anchor with a chain behind it closes the
            // path, the way every pen tool closes one.
            if hit == 0 && path.points.len() >= 4 && !path.closed {
                toggle_closed(state);
            } else {
                state.pen.drag = Drag { at: hit, broken: broken };
            }
        } else {
            let local = util::to_local(node_frame, mx, my);
            add_anchor(state, local.x, local.y);
            // The new anchor is the one a drag now pulls a handle from.
            if state.pen.path.is_some() {
                state.pen.drag = Drag { at: state.pen.path.unwrap().points.len() - 1, broken: broken };
            }
        }
    }
    if over_viewport && input::mouse_just_pressed(input::MOUSE_BUTTON_RIGHT) {
        let hit = state.pen.hover;
        if hit >= 0 && hit % 3 == 0 {
            remove_anchor(state, hit);
        }
    }
    if !input::mouse_down(input::MOUSE_BUTTON_LEFT) {
        if state.pen.drag.is_some() {
            history::commit(state);
        }
        state.pen.drag = nil;
        return;
    }
    if state.pen.drag.is_some() {
        let pull = state.pen.drag.unwrap();
        let local = util::to_local(node_frame, mx, my);
        move_point(state, pull.at, local.x, local.y, pull.broken);
    }
}

pub fn cancel(state: &mut editor::State) {
    state.pen.drag = nil;
    state.pen.hover = -1;
}

/// Anchors as squares, handles as dots on their tethers, and the sampled
/// curve as a line. Drawn over the stroke the renderer already draws.
pub fn draw(state: &mut editor::State) {
    if state.tool != "pen" {
        return;
    }
    let path_or = current(state);
    if path_or.is_none() {
        return;
    }
    let path = path_or.unwrap();
    let frame_or = frame(state);
    if frame_or.is_none() {
        return;
    }
    let node_frame = frame_or.unwrap();
    let tokens = state.theme;
    let accent = util::rgb(tokens.primary_text.as_str());
    let dim = util::rgb(tokens.text_muted.as_str());
    let mark = MARK_PX * viewport::world_per_px(state);
    for index in 0..path.points.len() {
        let point = path.points[index];
        let world = util::to_world(node_frame, point[0], point[1]);
        let wx = world.x;
        let wy = world.y;
        let is_anchor = path.points.len() < 3 || index % 3 == 0;
        let color = if state.pen.hover == index || is_anchor { accent } else { dim };
        if is_anchor {
            let half = mark;
            render::draw_line_2d(wx - half, wy - half, wx + half, wy - half, color[0], color[1], color[2], LINE_WIDTH);
            render::draw_line_2d(wx + half, wy - half, wx + half, wy + half, color[0], color[1], color[2], LINE_WIDTH);
            render::draw_line_2d(wx + half, wy + half, wx - half, wy + half, color[0], color[1], color[2], LINE_WIDTH);
            render::draw_line_2d(wx - half, wy + half, wx - half, wy - half, color[0], color[1], color[2], LINE_WIDTH);
        } else {
            // The tether to the anchor this handle belongs to.
            let anchor = if index % 3 == 1 { index - 1 } else { index + 1 };
            if anchor < path.points.len() {
                let anchor_point = path.points[anchor];
                let anchor_world = util::to_world(node_frame, anchor_point[0], anchor_point[1]);
                render::draw_line_2d(anchor_world.x, anchor_world.y, wx, wy, dim[0], dim[1], dim[2], 1.0);
            }
            let half = mark * 0.7;
            render::draw_line_2d(wx - half, wy, wx + half, wy, color[0], color[1], color[2], LINE_WIDTH);
            render::draw_line_2d(wx, wy - half, wx, wy + half, color[0], color[1], color[2], LINE_WIDTH);
        }
    }
}
