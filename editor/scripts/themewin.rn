// The theme window: every colour, role and kind the worn theme holds, each
// drawn as itself, with the keys of the one picked listed under it. A bundled
// theme is read-only; a copy of it in the person's themes folder edits live.

use crate::style;
use crate::theme;
use crate::util;

const ID = "theme";

// What a role with no fill of its own is drawn on, for its contrast.
const GROUND = "bg_panel";

const PAGES = ["colors", "sizes", "text", "controls", "boxes", "layout", "kinds", "problems"];

// The tables under a role that replace it in a state, and the class one.
const STATES = ["hover", "active", "focus", "disabled", "checked", "touch"];

// Every key a role or a kind may state, in the order its rows list them.
const KEYS = [
    "fill", "text_color", "stroke", "icon_color", "icon_fill",
    "font_family", "font_size", "font_weight", "text_align",
    "height", "width", "corner_radius",
    "padding", "padding_x", "padding_y", "gap", "stroke_width",
];
const COLOR_KEYS = ["fill", "text_color", "stroke", "icon_color", "icon_fill"];
// The keys a size's name may stand in for a number on.
const SIZE_KEYS = [
    "font_size", "height", "width", "corner_radius",
    "padding", "padding_x", "padding_y", "gap", "stroke_width",
];
// The colours a theme states, which every other token is worked out from.
const SOURCES = ["background", "foreground", "primary", "secondary", "success", "warning", "danger"];

// Under this the pages go above the rows rather than beside them.
const STACK_BELOW = 520.0;

pub fn state() {
    #{
        page: "colors",
        // The table picked: `["roles", "tab"]` or a kind's `["panel"]`, and
        // which of its state tables, "" for the role itself.
        path: [],
        table: "",
        // The person's theme as its file holds it, unmerged; nothing while a
        // bundled theme is worn, which is what makes the window read-only.
        own: (),
        dirty: false,
        // Every role's ink on its fill, for the worn document.
        pairs: [],
        said: "",
        // Where `--state themeeditdemo` has got to; -1 when it is not running.
        demo: -1,
    }
}

pub fn open(S) {
    crate::window::show(S, ID);
    load_own(S);
}

/// Open on a page with one entry picked, for a screenshot or a self-test.
pub fn open_at(S, page, path) {
    open(S);
    S.themewin.page = page;
    S.themewin.path = path;
    S.themewin.table = "";
}

pub fn editable(S) {
    !util::is_nil(S.themewin.own)
}

fn load_own(S) {
    let name = S.theme.name;
    let own = if theme::is_bundled(name) { () } else { theme::read(name) };
    S.themewin.own = own;
    S.themewin.dirty = false;
    let pairs = ui::contrast_pairs(S.theme.doc, GROUND);
    S.themewin.pairs = pairs;
}

pub fn draw(S) {
    let k = S.theme;
    let stacked = ui::window_size()[0] < STACK_BELOW;
    let hosts = crate::window::sheet_form(S, ID, "Theme", || { save_button(S, k); });
    if util::is_nil(hosts) {
        return;
    }
    crate::pool::strip(S, hosts.side + "/SheetSideRows", if stacked { [] } else { side_controls(S) });
    util::fill(hosts.side, #{ visible: !stacked });
    let specs = form_specs(S);
    if stacked {
        specs.insert(0, page_picker(S));
    }
    crate::pool::sync(S, hosts.form, specs, label_w(S), stacked);
}

fn label_w(S) {
    util::clamp((crate::window::inner_w(S) - 210.0) * 0.28, 120.0, 220.0)
}

fn save_button(S, k) {
    if !S.themewin.dirty {
        return;
    }
    let pressed = ui::button("Save", #{ height: 24, font_size: style::MD, corner_radius: 8, fill: k.primary_fill, text_color: k.text_on_primary });
    // Where it drew, for a showcase pointing at it: an immediate control has
    // no node to ask.
    S.themewin.save_at = ui::button_rect();
    if pressed {
        save(S);
    }
}


fn page_title(S, page) {
    let n = if page == "colors" {
        S.theme.colors.len()
    } else if page == "sizes" {
        S.theme.sizes.len()
    } else if page == "problems" {
        problems(S).len()
    } else if page == "kinds" {
        kind_names(S.theme.doc).len()
    } else {
        role_names(S.theme.doc, page).len()
    };
    let word = page[0..1].to_uppercase() + page[1..];
    format!("{}  {}", word, n)
}

fn side_controls(S) {
    let out = [];
    for name in PAGES {
        // Bound afresh: a closure made in a loop captures the binding.
        let page = name;
        let on = S.themewin.page == page;
        out.push(#{
            kind: "button", text: page_title(S, page),
            role: "item_sidebar", checked: on,
            on: |_| { S.themewin.page = page; },
        });
    }
    out
}

fn page_picker(S) {
    #{ full: true, height: style::row_h(S), controls: [#{
        kind: "dropdown", role: "choice_form", grow: 1,
        text: S.themewin.page, options: PAGES,
        on: |picked| { S.themewin.page = picked; },
    }] }
}

/// Which page a role belongs on, by the component its name starts with.
pub fn page_of(name) {
    let component = name.split('_').next().unwrap_or("");
    if component == "text" {
        "text"
    } else if component == "note" || component == "sheet" || component == "header" || component == "toolbar" {
        "boxes"
    } else if component == "layout" || component == "list" {
        "layout"
    } else {
        "controls"
    }
}

fn sorted_keys(table) {
    let out = [];
    for (key, _) in table {
        out.push(key);
    }
    out.sort();
    out
}

fn role_names(doc, page) {
    let roles = util::obj(doc.get("roles").unwrap_or(#{}));
    let out = [];
    for name in sorted_keys(roles) {
        if page_of(name) == page {
            out.push(name);
        }
    }
    out
}

/// The kind tables: every table a document holds beside its colours and roles.
fn kind_names(doc) {
    let out = [];
    for key in sorted_keys(doc) {
        if key != "colors" && key != "sizes" && key != "roles" && doc[key] is Object {
            out.push(key);
        }
    }
    out
}

fn problems(S) {
    let out = [];
    for pair in util::vec(S.themewin.pairs) {
        if pair.ratio < pair.need {
            out.push(pair);
        }
    }
    out
}

fn form_specs(S) {
    let doc = S.theme.doc;
    let out = head_specs(S);
    let page = S.themewin.page;
    if page == "colors" {
        color_specs(S, doc, out);
    } else if page == "sizes" {
        size_specs(S, doc, out);
    } else if page == "problems" {
        problem_specs(S, out);
    } else if page == "kinds" {
        for name in kind_names(doc) {
            entry_specs(S, doc, [name], out);
        }
    } else {
        for name in role_names(doc, page) {
            entry_specs(S, doc, ["roles", name], out);
        }
    }
    out
}


fn head_specs(S) {
    let h = style::row_h(S);
    let name = S.theme.name;
    let own = S.themewin.own;
    let mine = editable(S);
    let controls = [
        #{
            kind: "dropdown", role: "choice_form", width: 180,
            text: name, options: theme::names(),
            tooltip: "The theme the editor wears",
            on: |picked| { choose(S, picked); },
        },
    ];
    if mine {
        controls.push(#{
            kind: "dropdown", role: "choice_form", width: 150,
            text: "based on " + theme::base_of(own), options: theme::BUNDLED,
            tooltip: "The bundled theme every key this one leaves out comes from",
            on: |picked| { rebase(S, picked); },
        });
    }
    controls.push(#{ kind: "row", grow: 1 });
    controls.push(#{
        kind: "button", role: "action_form_primary", text: "Duplicate",
        tooltip: "Copy this theme into your themes folder and wear the copy",
        on: |_| { duplicate(S); },
    });
    if mine && S.themewin.dirty {
        controls.push(#{
            kind: "button", role: "action_form", text: "Revert",
            tooltip: "Drop the edits since the last save",
            on: |_| { revert(S); },
        });
    }
    if mine {
        controls.push(#{
            kind: "button", role: "action_form_danger", text: "Delete",
            tooltip: "Remove this theme's file and go back to its base",
            on: |_| { remove(S); },
        });
    }
    let out = [#{ full: true, height: h, slot_role: "layout_actions", controls: controls }];
    if mine {
        out.push(#{ label: "name", height: h, controls: [#{
            kind: "text_field", role: "input_form", grow: 1, text: name,
            tooltip: "Enter renames the file",
            on_submit: |text| { rename(S, text); },
        }] });
    }
    let tail = if S.themewin.dirty { "  ·  unsaved" } else { "" };
    out.push(note_spec(if mine {
        format!("themes/{}.toml in the editor's data folder  ·  states only what differs from {}{}", name, theme::base_of(own), tail)
    } else {
        "Bundled with the editor, so it is read-only. Duplicate it to change a color or a role."
    }));
    if S.themewin.said != "" {
        out.push(note_spec(S.themewin.said));
    }
    out
}

fn note_spec(text) {
    #{ full: true, height: 0, controls: [#{
        kind: "label", role: "text_caption", grow: 1, wrap: true, text: text,
    }] }
}

fn color_specs(S, doc, out) {
    let h = style::row_h(S);
    let mine = editable(S);
    let stated = util::obj(doc.get("colors").unwrap_or(#{}));
    let colors = S.theme.colors;
    let ground = colors.get(GROUND).unwrap_or("#000000");
    let names = SOURCES.iter().collect::<Vec>();
    for token in sorted_keys(colors) {
        if !SOURCES.iter().any(|s| s == token) {
            names.push(token);
        }
    }
    for token in names {
        // Bound afresh: a closure made in a loop captures the binding.
        let name = token;
        let hex = colors.get(name).unwrap_or("#000000");
        // A stated token reads as the theme's own; a derived one is quieter.
        let own = stated.contains_key(name);
        out.push(#{
            label: name, label_role: if own { "text_label" } else { "text_caption" },
            height: h, slot_role: "layout_actions", controls: [
                #{
                    kind: "color_picker", width: 34, picked_color: rgba_of(hex), disabled: !mine,
                    on: |rgba| { edit(S, ["colors"], name, util::to_hex(rgba)); },
                },
                #{
                    kind: "text_field", role: "input_form", width: 96, text: hex, disabled: !mine,
                    on_submit: |text| { edit_hex(S, name, text); },
                },
                #{
                    kind: "label", role: "text_caption", grow: 1,
                    text: if is_hex(hex) && is_hex(ground) {
                        format!("{}{:.2}:1 on {}", if own { "" } else { "derived  ·  " }, ui::contrast(hex, ground), GROUND)
                    } else {
                        ""
                    },
                },
            ],
        });
    }
}

fn size_specs(S, doc, out) {
    let h = style::row_h(S);
    let mine = editable(S);
    let stated = util::obj(doc.get("sizes").unwrap_or(#{}));
    for token in sorted_keys(S.theme.sizes) {
        let name = token;
        out.push(#{
            label: name, label_role: if stated.contains_key(name) { "text_label" } else { "text_caption" },
            height: h, slot_role: "layout_actions", controls: [#{
                kind: "number_field", role: "input_number", width: 96,
                value: util::f(S.theme.sizes[name]), min: 0.0, max: 200.0, step: 1.0, disabled: !mine,
                on: |v| { edit(S, ["sizes"], name, whole(v)); },
            }],
        });
    }
}

fn rgba_of(hex) {
    let (r, g, b) = util::hex_to_rgb(hex);
    [r, g, b, 1.0]
}

fn is_hex(text) {
    if !(text is String) || text.len() != 7 || !text.starts_with("#") {
        return false;
    }
    let digits = "0123456789abcdefABCDEF";
    for c in text[1..].chars() {
        if !digits.contains(format!("{}", c)) {
            return false;
        }
    }
    true
}

fn edit_hex(S, name, text) {
    if is_hex(text) {
        edit(S, ["colors"], name, text.to_lowercase());
    } else {
        S.themewin.said = format!("'{}' is not a #rrggbb color", text);
    }
}


fn table_at(doc, path) {
    let t = util::obj(doc);
    for part in path {
        if !(t.contains_key(part) && t[part] is Object) {
            return #{};
        }
        t = t[part];
    }
    t
}

fn same_path(a, b) {
    if a.len() != b.len() {
        return false;
    }
    for i in 0..a.len() {
        if a[i] != b[i] {
            return false;
        }
    }
    true
}

fn pick(S, path) {
    let again = same_path(S.themewin.path, path);
    let next = if again { [] } else { path };
    S.themewin.path = next;
    S.themewin.table = "";
}

fn height_of(S, t) {
    let h = style::row_h(S);
    let own = style::px(S, t.get("height").unwrap_or(0.0));
    util::max(h, own + 4.0)
}

/// What a table states in a line: a layout role's air, or a kind's frame.
fn summary(t) {
    let out = "";
    for key in KEYS {
        if t.contains_key(key) && !(t[key] is Object) {
            let part = format!("{} {}", key, t[key]);
            out = if out == "" { part } else { out + "  ·  " + part };
        }
    }
    if out == "" { "nothing stated" } else { out }
}

/// The entry drawn as itself: a text role as a label in it, a control or a
/// box as a button wearing it, and layout as the numbers it states.
fn sample(S, name, path, t) {
    let page = if path.len() == 2 { page_of(name) } else { "kinds" };
    if page == "layout" || page == "kinds" {
        return #{ kind: "label", role: "text_caption", grow: 1, text: summary(t) };
    }
    if page == "text" {
        return #{ kind: "label", role: name, grow: 1, text: name };
    }
    #{ kind: "button", role: name, width: 200, text: name, on: |_| { pick(S, path); } }
}

fn entry_specs(S, doc, path, out) {
    let name = path[path.len() - 1];
    let t = table_at(doc, path);
    let picked = same_path(S.themewin.path, path);
    out.push(#{ label: name, height: height_of(S, t), slot_role: "layout_actions", controls: [
        sample(S, name, path, t),
        #{
            kind: "button", role: "chip", checked: picked,
            text: if picked { "editing" } else { "edit" },
            on: |_| { pick(S, path); },
        },
    ] });
    if picked {
        inspector_specs(S, doc, path, out);
    }
}

fn state_chips(S, t) {
    let bare = S.themewin.table == "";
    let chips = [#{
        kind: "button", role: "chip", checked: bare, text: "role",
        on: |_| { S.themewin.table = ""; },
    }];
    for name in STATES {
        let word = name;
        let there = t.contains_key(word) && t[word] is Object;
        let on = S.themewin.table == word;
        chips.push(#{
            kind: "button",
            role: if there || on { "chip" } else { "chip_quiet" }, checked: on,
            text: if there { word } else { "+ " + word },
            tooltip: if there { "Edit the table this state wears" } else { "Nothing stated for this state yet" },
            on: |_| { S.themewin.table = word; },
        });
    }
    chips
}

fn inspector_specs(S, doc, path, out) {
    let h = style::row_h(S);
    let mine = editable(S);
    let role_t = table_at(doc, path);
    out.push(#{ label: "  table", height: h, slot_role: "layout_actions", controls: state_chips(S, role_t) });
    let at = path.iter().collect::<Vec>();
    if S.themewin.table != "" {
        at.push(S.themewin.table);
    }
    let t = table_at(doc, at);
    let own_t = table_at(S.themewin.own, at);
    let missing = [];
    for key in KEYS {
        if t.contains_key(key) && !(t[key] is Object) {
            out.push(key_spec(S, doc, at, key, t[key], own_t.contains_key(key), mine));
        } else {
            missing.push(key);
        }
    }
    if mine && missing.len() > 0 {
        out.push(#{ label: "  add", height: h, controls: [#{
            kind: "dropdown", role: "choice_form", width: 200,
            text: "add a key…", options: missing,
            on: |picked| { edit(S, at, picked, default_of(picked)); },
        }] });
    }
    if path.len() == 2 {
        let who = if S.themewin.table == "" { path[1] } else { path[1] + "." + S.themewin.table };
        for pair in util::vec(S.themewin.pairs) {
            if pair.role == who {
                let verdict = if pair.ratio >= pair.need { "reads at AA" } else { format!("needs {}", pair.need) };
                out.push(note_spec(format!("{} on {}: {:.2}:1, {}", pair.ink, pair.fill, pair.ratio, verdict)));
            }
        }
    }
}

fn key_spec(S, doc, at, key, value, stated, mine) {
    let controls = control_for(S, doc, at, key, value, mine);
    if mine && stated {
        controls.push(#{
            kind: "button", role: "chip_quiet", text: "×",
            tooltip: "Back to the base theme's value",
            on: |_| { clear(S, at, key); },
        });
    }
    // A key this theme states reads as its own; one it leaves to its base is
    // quieter, so what the file says stands out from what it inherits.
    #{
        label: "  " + key, label_role: if stated || !mine { "text_label" } else { "text_caption" },
        height: h_of(S), slot_role: "layout_actions", controls: controls,
    }
}

fn h_of(S) {
    style::row_h(S)
}

fn words_of(S, key, value) {
    if key == "font_family" {
        ["ui", "heading", "mono", "icon"]
    } else if key == "text_align" {
        ["start", "center", "end"]
    } else if value is String && SIZE_KEYS.iter().any(|k| k == key) {
        let names = sorted_keys(S.theme.sizes);
        if key == "corner_radius" {
            names.push("full");
        }
        names
    } else {
        []
    }
}

fn control_for(S, doc, at, key, value, mine) {
    if COLOR_KEYS.iter().any(|c| c == key) {
        let hex = S.theme.colors.get(value).unwrap_or(value);
        let options = sorted_keys(S.theme.colors);
        return [
            #{
                kind: "color_picker", width: 34, picked_color: rgba_of(if is_hex(hex) { hex } else { "#000000" }),
                disabled: !mine,
                on: |rgba| { edit(S, at, key, util::to_hex(rgba)); },
            },
            #{
                kind: "dropdown", role: "choice_form", grow: 1,
                text: format!("{}", value), options: options, disabled: !mine,
                on: |picked| { edit(S, at, key, picked); },
            },
        ];
    }
    let words = words_of(S, key, value);
    if words.len() > 0 {
        return [#{
            kind: "dropdown", role: "choice_form", grow: 1,
            text: format!("{}", value), options: words, disabled: !mine,
            on: |picked| { edit(S, at, key, picked); },
        }];
    }
    if value is i64 || value is f64 {
        return [#{
            kind: "number_field", role: "input_number", grow: 1,
            value: util::f(value), min: 0.0, max: 2000.0, step: 1.0, disabled: !mine,
            on: |v| { edit(S, at, key, whole(v)); },
        }];
    }
    let typed = [#{
        kind: "text_field", role: "input_form", grow: 1, text: format!("{}", value), disabled: !mine,
        on_submit: |text| { edit(S, at, key, text); },
    }];
    typed
}

/// A number as a file would spell it: whole ones without the `.0`.
fn whole(v) {
    let n = util::f(v);
    let i = n as i64;
    if (i as f64) == n { i } else { n }
}

fn default_of(key) {
    if COLOR_KEYS.iter().any(|c| c == key) {
        return if key == "text_color" { "text_default" } else { "bg_panel" };
    }
    if key == "font_family" {
        return "ui";
    }
    if key == "text_align" {
        return "start";
    }
    if key == "font_weight" {
        return 700;
    }
    if key == "font_size" { "font_size" } else { 0 }
}


fn problem_specs(S, out) {
    let found = problems(S);
    if found.is_empty() {
        out.push(note_spec("Every role's text reads at WCAG AA on its fill: 4.5:1, or 3:1 from 18 px or 14 px bold."));
        return;
    }
    let h = style::row_h(S);
    for p in found {
        let pair = p;
        let parts = pair.role.split('.').collect::<Vec>();
        let name = parts[0];
        let table = if parts.len() > 1 { parts[1] } else { "" };
        out.push(#{ label: pair.role, height: h, slot_role: "layout_actions", controls: [
            #{
                kind: "label", role: "text_caption", grow: 1,
                text: format!("{} on {}: {:.2}:1, needs {}", pair.ink, pair.fill, pair.ratio, pair.need),
            },
            #{
                kind: "button", role: "chip", text: "edit",
                on: |_| { show_role(S, name, table); },
            },
        ] });
    }
}

/// Turn to the page a role is on, picked, at one of its state tables.
pub fn show_role(S, name, table) {
    S.themewin.page = page_of(name);
    S.themewin.path = ["roles", name];
    S.themewin.table = table;
}


/// Write one key of the person's theme and wear the result. A bundled theme
/// has no `own`, so nothing is written.
pub fn edit(S, path, key, value) {
    let own = S.themewin.own;
    if util::is_nil(own) {
        return;
    }
    let t = own;
    for part in path {
        if !(t.contains_key(part) && t[part] is Object) {
            t[part] = #{};
        }
        t = t[part];
    }
    t[key] = value;
    changed(S);
}

fn clear(S, path, key) {
    let own = S.themewin.own;
    if util::is_nil(own) {
        return;
    }
    let t = table_at(own, path);
    if t.contains_key(key) {
        t.remove(key);
    }
    changed(S);
}

fn changed(S) {
    S.themewin.dirty = true;
    S.themewin.said = "";
    let own = S.themewin.own;
    let doc = theme::merge(theme::bundled(theme::base_of(own)), own);
    theme::wear(S, S.theme.name, doc);
    let pairs = ui::contrast_pairs(doc, GROUND);
    S.themewin.pairs = pairs;
}

fn rebase(S, picked) {
    let own = S.themewin.own;
    if util::is_nil(own) {
        return;
    }
    own["base"] = picked;
    changed(S);
}

/// Wear another theme, remembered as the setting.
pub fn choose(S, name) {
    settings::set(theme::SETTING, name);
    crate::settings::commit_prefs(S);
    theme::use_named(S, name);
    load_own(S);
    S.themewin.said = "";
}

/// Write the person's theme: only what differs from its base, under the base
/// it names.
pub fn save(S) {
    let own = S.themewin.own;
    if util::is_nil(own) {
        return;
    }
    let base_name = theme::base_of(own);
    let base = theme::bundled(base_name);
    let out = theme::diff(base, theme::merge(base, own));
    out["type"] = "widget_theme";
    out["base"] = base_name;
    let path = theme::path_of(S.theme.name);
    fs::mkdir(theme::user_dir());
    fs::write(path, toml::encode(out));
    S.themewin.own = out;
    S.themewin.dirty = false;
    S.themewin.said = "Saved themes/" + S.theme.name + ".toml";
}

fn revert(S) {
    theme::reload(S);
    load_own(S);
    S.themewin.said = "";
}

/// A name for a copy nobody has used: `dark-custom`, then `dark-custom-2`.
fn fresh_name(from) {
    let stem = if theme::is_bundled(from) { from + "-custom" } else { from + "-copy" };
    let taken = theme::names();
    let name = stem;
    let n = 2;
    while taken.iter().any(|x| x == name) {
        name = format!("{}-{}", stem, n);
        n += 1;
    }
    name
}

/// Copy the worn theme into the themes folder and wear the copy. A bundled one
/// becomes a file naming it as its base and nothing else.
pub fn duplicate(S) {
    let from = S.theme.name;
    let name = fresh_name(from);
    let copy = if theme::is_bundled(from) { #{ base: from } } else { util::obj(theme::read(from)) };
    copy["type"] = "widget_theme";
    fs::mkdir(theme::user_dir());
    fs::write(theme::path_of(name), toml::encode(copy));
    choose(S, name);
    S.themewin.said = "Duplicated " + from + " as " + name;
    name
}

fn rename(S, text) {
    let old = S.theme.name;
    let name = text.trim();
    let bad = name == "" || name.contains("/") || name.contains(".");
    if bad || theme::is_bundled(name) || theme::names().iter().any(|x| x == name) {
        S.themewin.said = format!("'{}' is not a name a new theme file can take", text);
        return;
    }
    if S.themewin.dirty {
        save(S);
    }
    fs::rename(theme::path_of(old), theme::path_of(name));
    choose(S, name);
    S.themewin.said = "Renamed " + old + " to " + name;
}

/// Remove the worn theme's file and go back to its base.
pub fn remove(S) {
    let own = S.themewin.own;
    if util::is_nil(own) {
        return;
    }
    let back = theme::base_of(own);
    fs::remove(theme::path_of(S.theme.name));
    choose(S, back);
}
