// The completion popup in the Script workspace: what may be typed at the caret,
// under the caret, from the same `script::complete` an editor outside Balaur
// reaches through `balaur lsp`.

use center;
use disk;
use editor;
use lint;
use signals;
use util;

pub class CompleteState {
    internal open: bool,
    items: [script::Completion],
    pick: int,
    internal at_index: int,
    rel: str,
    x: float,
    y: float,
    source: str,
    signature: script::Signature?,
}

/// Where the code pane's caret is: its character index into the source, and
/// its place in design pixels.
pub struct Caret {
    internal index: int,
    internal x: float,
    internal y: float,
}

/// A 1-based line and column.
pub struct LineColumn {
    internal line: int,
    internal column: int,
}

/// What the list shows: where it opens, under the caret, its rows, the one
/// picked, and the doc line of that one.
pub struct View {
    internal open: bool,
    internal x: float,
    internal y: float,
    internal items: [ui::Item],
    internal picked: str,
    internal list_h: float,
    internal doc: str,
}

// The list's rows, in design pixels.
const ROW: float = 22.0;

const MAX_ROWS: int = 8;

pub fn state() -> CompleteState {
    CompleteState { open: false, items: [], pick: 0, at_index: -1, rel: "", x: 0.0, y: 0.0, source: "", signature: nil }
}

/// The module's own slice of `state`, at `state.complete`.
pub fn reset(state: &mut editor::State) {
    state.complete.open = false;
    state.complete.items = [];
    state.complete.pick = 0;
    state.complete.at_index = -1;
}

/// The 1-based line and column of a character index into `source`.
pub fn line_column(source: str, index: int) -> LineColumn {
    let line = 1;
    let column = 1;
    let chars = source.chars();
    for at in 0..util::int_min(index, chars.len()) {
        if chars[at] == "\n" {
            line += 1;
            column = 1;
        } else {
            column += 1;
        }
    }
    LineColumn { line: line, column: column }
}

// Whether a one-character string is part of a name.
fn word_char(character: str) -> bool {
    character != "" && "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_".contains(character)
}

// The word being typed, so an empty prefix after a space does not open a list
// of every module in the engine.
pub fn prefix_at(source: str, index: int) -> str {
    let out = "";
    let chars = source.chars();
    for at in 0..util::int_min(index, chars.len()) {
        if word_char(chars[at]) {
            out = out + chars[at];
        } else {
            out = "";
        }
    }
    out
}

// Whether the caret sits right after `::` or `.`, which is where a list opens
// with no prefix typed yet.
fn after_dot(source: str, index: int) -> bool {
    let chars = source.chars();
    if index <= 0 || index > chars.len() {
        return false;
    }
    let last = chars[index - 1];
    last == "." || (last == ":" && index >= 2 && chars[index - 2] == ":")
}

/// Ask the host what completes at the caret, and open the list when there is
/// something to show. Called from the code pane once the editor reports one.
pub fn update(state: &mut editor::State, rel: str, source: str, caret: Caret) {
    let index = caret.index;
    // Same caret, same text: the answer cannot have changed.
    if state.complete.open && state.complete.at_index == index && state.complete.source == source {
        return;
    }
    state.complete.x = caret.x;
    state.complete.y = caret.y;
    state.complete.at_index = index;
    state.complete.source = source;
    state.complete.rel = rel;
    if prefix_at(source, index) == "" && !after_dot(source, index) {
        state.complete.open = false;
        state.complete.items = [];
        return;
    }
    let at = line_column(source, index);
    let found = script::complete(rel, source, at.line, at.column);
    state.complete.items = found;
    state.complete.pick = 0;
    state.complete.open = found.len() > 0;
    state.complete.signature = script::signature(rel, source, at.line, at.column);
}

/// The list's keys while it is up: the arrows move the pick, Enter and Tab
/// accept it, and Escape closes the list.
pub fn key(state: &mut editor::State, name: str) {
    if !state.complete.open {
        return;
    }
    let count = state.complete.items.len();
    if name == "Down" {
        state.complete.pick = (state.complete.pick + 1) % count;
    } else if name == "Up" {
        state.complete.pick = (state.complete.pick + count - 1) % count;
    } else if name == "Accept" || name == "Tab" {
        accept(state);
    } else {
        reset(state);
    }
    signals::changed(state, "complete");
}

/// A row clicked: accept that one.
pub fn pick(state: &mut editor::State, row: str) {
    state.complete.pick = row.parse_int();
    accept(state);
    signals::changed(state, "complete");
}

// Replace the prefix under the caret with the chosen item.
fn accept(state: &mut editor::State) {
    let picked = state.complete.pick;
    if picked < 0 || picked >= state.complete.items.len() {
        reset(state);
        return;
    }
    let index = state.complete.at_index;
    let chars = state.complete.source.chars();
    let start = index - prefix_at(state.complete.source, index).chars().len();
    let head = "";
    let tail = "";
    for position in 0..chars.len() {
        if position < start {
            head = head + chars[position];
        } else if position >= index {
            tail = tail + chars[position];
        }
    }
    let path = state.game_root + "/" + state.complete.rel;
    disk::edit(state, path, head + state.complete.items[picked].insert + tail);
    lint::touched(state);
    signals::bars(state);
    center::code_written(state);
    reset(state);
}

// A row's leading glyph, by what the completion is.
fn glyph(kind: str) -> str {
    if kind == "module" {
        "◆"
    } else if kind == "function" {
        "ƒ"
    } else if kind == "method" {
        "→"
    } else if kind == "constant" {
        "●"
    } else if kind == "field" {
        "▪"
    } else if kind == "property" {
        "▫"
    } else if kind == "keyword" {
        "k"
    } else {
        "·"
    }
}

/// The list, under the caret, with the picked entry's doc line under it. One
/// sheet, not two: a second overlay beside this one runs off the pane.
// A row each completion, its mark, its label and its detail.
fn rows(state: editor::State) -> [ui::Item] {
    let tint = state.theme["text_muted"].as_str();
    let out: [ui::Item] = [];
    let shown = state.complete.items;
    for index in 0..shown.len() {
        let one = shown[index];
        out.push(ui::Item { icon: glyph(one.kind), label: one.label, note: one.detail, tint: tint, key: "{index}" });
    }
    out
}

/// What the list shows: where it opens, under the caret, its rows, the one
/// picked, and the doc line of that one.
pub fn view(state: editor::State) -> View {
    if !state.complete.open || state.complete.items.len() == 0 {
        return View { open: false, x: 0.0, y: 0.0, items: [], picked: "", list_h: 0.0, doc: "" };
    }
    let items = rows(state);
    let pick = util::int_min(state.complete.pick, items.len() - 1);
    let doc = state.complete.items[pick].doc;
    View {
        open: true,
        x: state.complete.x,
        y: state.complete.y + 4.0,
        items: items,
        picked: "{pick}",
        list_h: (util::int_min(items.len(), MAX_ROWS) as float) * ROW,
        doc: clip(doc, 78),
    }
}

// The doc line is one sentence in a 320 px sheet; the rest is in the Docs
// dock, which has room for it.
fn clip(text: str, limit: int) -> str {
    let chars = text.chars();
    if chars.len() <= limit {
        return text;
    }
    let out = "";
    for index in 0..limit {
        out = out + chars[index];
    }
    out + "…"
}
