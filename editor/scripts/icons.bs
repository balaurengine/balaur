// Every glyph the shell draws, named for what it means. Phosphor Fill, in the
// icons chain each font family falls back to; every weight of the set shares
// its codepoints, so a solid shell is the font file and nothing else.

use words::asset_kinds;
use words::components;
use words::general;
use words::statuses;
use words::tabs;
use words::theme_modes;
use words::theme_tokens;
use words::tools;
use words::verbs;
use words::window_marks;

