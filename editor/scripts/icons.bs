/// A component's glyph and the theme token it is drawn in.
pub struct Component {
    internal glyph: str,
    internal token: str,
}

/// A viewport tool, by `defs::tools` id.
pub fn tool(id: str) -> str {
    match id {
        tools::SELECT => glyphs::CURSOR,
        tools::MOVE => glyphs::ARROWS_OUT_CARDINAL,
        tools::ROTATE => glyphs::ARROW_CLOCKWISE,
        tools::SCALE => glyphs::ARROWS_OUT,
        tools::ZOOM => glyphs::MAGNIFYING_GLASS,
        tools::KEY => glyphs::DIAMOND,
        tools::BONE => glyphs::BONE,
        tools::POLYGON => glyphs::POLYGON,
        tools::PEN => glyphs::PEN_NIB_STRAIGHT,
        tools::TILES => glyphs::SQUARES_FOUR,
        _ => glyphs::CURSOR,
    }
}

/// A workspace, by `defs::workspaces` id.
pub fn workspace(id: str) -> str {
    match id {
        tabs::SCENE => glyphs::CUBE,
        tabs::SCRIPT => glyphs::CODE,
        tabs::ANIMATION => glyphs::CLOCK,
        tabs::PHYSICS => glyphs::BOUNDING_BOX,
        tabs::UI => glyphs::LAYOUT,
        _ => glyphs::CUBE,
    }
}

/// The mark an inspector section wears, by component. A component with none
/// of its own takes the plain node mark, so every heading is marked.
/// A component's glyph, and the theme token it is drawn in -- the same pair
/// `model::node_icon` gives the tree, so a `body2d` section and a node holding
/// one read as the same thing in both panels.
pub fn component(name: str) -> Component {
    if name == TRANSFORM {
        return Component { glyph: tool(tools::MOVE), token: theme_tokens::NODE_DEFAULT };
    }
    if name == WIDGET {
        return Component { glyph: workspace(tabs::UI), token: "node_ui" };
    }
    if name == tabs::SCRIPT {
        return Component { glyph: ui(SCRIPTFILE), token: theme_tokens::NODE_DEFAULT };
    }
    if name == BONE2D || name == BONE3D || name == SKELETON {
        return Component { glyph: tool(tools::BONE), token: theme_tokens::NODE_BONE };
    }
    if name == tools::POLYGON || name == SHAPE2D || name == SPRITE || name == components::TEXT2D || name == MULTIMESH2D {
        return Component { glyph: tool(tools::POLYGON), token: theme_tokens::NODE_2D };
    }
    if name == SHAPE3D || name == MESH || name == TEXT3D || name == MULTIMESH3D {
        return Component { glyph: workspace(tabs::SCENE), token: "node_3d" };
    }
    if name.starts_with(BODY) || name.starts_with("collider") || name.starts_with("character") || name.starts_with("joint") || name.starts_with("softbody") || name.starts_with("wheel") || name.starts_with("vehicle") || name == TILE_COLLISION || name == verbs::RAGDOLL {
        return Component { glyph: workspace(tabs::PHYSICS), token: theme_tokens::NODE_PHYSICS };
    }
    if name.starts_with(CAMERA) || name == theme_modes::LIGHT || name == ENVIRONMENT {
        return Component { glyph: ui(VIEWMODE), token: theme_tokens::NODE_DEFAULT };
    }
    if name == tabs::ANIMATION || name == ANIMATION_PLAYER {
        return Component { glyph: panel(verbs::TIMELINE), token: theme_tokens::NODE_DEFAULT };
    }
    if name == TILEMAP || name == TILESET {
        return Component { glyph: panel(tools::TILES), token: theme_tokens::NODE_2D };
    }
    if name == asset_kinds::AUDIO || name == AUDIO_PLAYER {
        return Component { glyph: panel(tabs::RECORDINGS), token: theme_tokens::NODE_DEFAULT };
    }
    if name == verbs::BINDINGS || name == tabs::EVENTS {
        return Component { glyph: ui(tabs::EVENTS), token: theme_tokens::NODE_DEFAULT };
    }
    Component { glyph: node(WORLD), token: theme_tokens::NODE_DEFAULT }
}

/// A dock panel, by its tab id.
pub fn panel(id: str) -> str {
    match id {
        tabs::SCENE => glyphs::TREE_STRUCTURE,
        tabs::OUTLINE => glyphs::LIST,
        tabs::INSPECTOR => glyphs::SLIDERS,
        tabs::IMPORT => glyphs::HOUSE_SIMPLE,
        OUTPUT => glyphs::TERMINAL_WINDOW,
        tabs::PROBLEMS => glyphs::WARNING,
        ASSETS => glyphs::FOLDER,
        DOCS => glyphs::BOOK_OPEN_TEXT,
        verbs::TIMELINE => glyphs::FILM_STRIP,
        DEBUGGER => glyphs::BUG,
        tabs::RECORDINGS => glyphs::RECORD,
        tabs::PROFILER => glyphs::CHART_BAR,
        tools::TILES => glyphs::SQUARES_FOUR,
        tabs::WEIGHTS => glyphs::RECEIPT,
        BONEMAP => glyphs::BAG,
        verbs::STATEMACHINE => glyphs::POLYGON,
        verbs::LIBRARY => glyphs::STACK_SIMPLE,
        asset_kinds::MATERIAL => glyphs::PALETTE,
        verbs::COST => glyphs::SQUARE_HALF,
        tabs::EVENTS => glyphs::LINK,
        _ => glyphs::COLUMNS,
    }
}

/// The shell's own controls.
pub fn ui(name: str) -> str {
    match name {
        ADD => glyphs::PLUS_BOLD,
        verbs::UNDO => glyphs::ARROW_COUNTER_CLOCKWISE,
        verbs::REDO => glyphs::ARROW_CLOCKWISE,
        verbs::SAVE => glyphs::FLOPPY_DISK,
        RELOAD => glyphs::ARROWS_CLOCKWISE,
        EMBED => glyphs::ARROW_SQUARE_IN,
        PICK_FILE => glyphs::FOLDER_OPEN,
        PICK_FONT => glyphs::TEXT_AA,
        PICK_NODE => glyphs::CROSSHAIR,
        OPEN_PREFAB => glyphs::ARROW_SQUARE_OUT,
        PICTURE => glyphs::IMAGE,
        KEYBOARD => glyphs::KEYBOARD,
        CHANNEL => glyphs::CIRCLE_HALF,
        DIALOG => glyphs::APP_WINDOW,
        CLIP => glyphs::FILM_STRIP,
        CLOSE => glyphs::X_BOLD,
        CHECK => glyphs::CHECK_BOLD,
        MINIMIZE => glyphs::MINUS_BOLD,
        window_marks::RESTORE => glyphs::CARET_UP,
        window_marks::COLLAPSE => glyphs::CARET_DOWN,
        verbs::SPLIT => glyphs::COLUMNS,
        verbs::FOCUS => glyphs::CORNERS_OUT,
        UNFOCUS => glyphs::CORNERS_IN,
        verbs::RESET => glyphs::ARROW_COUNTER_CLOCKWISE,
        verbs::SETTINGS => glyphs::GEAR,
        verbs::ABOUT => glyphs::INFO,
        verbs::EXPORT => glyphs::EXPORT,
        verbs::SEARCH => glyphs::MAGNIFYING_GLASS,
        theme_modes::DARK => glyphs::MOON,
        theme_modes::LIGHT => glyphs::SUN,
        INSTANCE => glyphs::COPY,
        tabs::EVENTS => glyphs::LINK,
        SCRIPTFILE => glyphs::FILE_CODE,
        BOOKMARK => glyphs::BOOKMARK,
        verbs::COPY => glyphs::COPY_SIMPLE,
        OPEN => glyphs::CARET_UP,
        SHUT => glyphs::CARET_DOWN,
        ENTRY_LIST => glyphs::LIST_BULLETS,
        CARET_OPEN => glyphs::CARET_DOWN,
        CARET_SHUT => glyphs::CARET_RIGHT,
        CARET_LEFT => glyphs::CARET_LEFT,
        CARET_RIGHT => glyphs::CARET_RIGHT,
        CARET_UP => glyphs::CARET_UP,
        CARET_DOWN => glyphs::CARET_DOWN,
        ARROW_LINE_LEFT => glyphs::ARROW_LINE_LEFT,
        ARROW_LINE_RIGHT => glyphs::ARROW_LINE_RIGHT,
        ARROW_LINE_DOWN => glyphs::ARROW_LINE_DOWN,
        verbs::PLAY => glyphs::PLAY,
        PAUSE => glyphs::PAUSE,
        statuses::STOP => glyphs::STOP,
        STEP_OVER => glyphs::ARROW_U_UP_RIGHT,
        STEP_INTO => glyphs::ARROW_LINE_DOWN,
        STEP_OUT => glyphs::ARROW_LINE_UP,
        ALIGN_LEFT => glyphs::ALIGN_LEFT,
        ALIGN_RIGHT => glyphs::ALIGN_RIGHT,
        ALIGN_CENTER_H => glyphs::ALIGN_CENTER_VERTICAL,
        ALIGN_TOP => glyphs::ALIGN_TOP,
        ALIGN_BOTTOM => glyphs::ALIGN_BOTTOM,
        ALIGN_CENTER_V => glyphs::ALIGN_CENTER_HORIZONTAL,
        DISTRIBUTE_H => glyphs::ARROWS_OUT_LINE_HORIZONTAL,
        DISTRIBUTE_V => glyphs::ARROWS_OUT_LINE_VERTICAL,
        verbs::GROUP => glyphs::BOUNDING_BOX,
        verbs::UNGROUP => glyphs::SELECTION,
        SELECT_ALL => glyphs::SELECTION_PLUS,
        verbs::ISOLATE => glyphs::CORNERS_OUT,
        FILTER => glyphs::FUNNEL_SIMPLE,
        verbs::LOCK => glyphs::LOCK,
        UNLOCK => glyphs::LOCK_OPEN,
        components::VISIBLE => glyphs::EYE,
        HIDDEN => glyphs::EYE_SLASH,
        EYE_CLOSED => glyphs::EYE_CLOSED,
        asset_kinds::SKY => glyphs::GLOBE,
        CAMERA => glyphs::VIDEO_CAMERA,
        tools::PEN => glyphs::PEN_NIB_STRAIGHT,
        general::PATH => glyphs::LINE_SEGMENT,
        asset_kinds::MATERIAL => glyphs::PALETTE,
        verbs::LIBRARY => glyphs::STACK_SIMPLE,
        VIEWMODE => glyphs::SELECTION_INVERSE,
        _ => glyphs::DOT,
    }
}

/// A node's kind in the tree, by the role `model::node_icon` reports.
pub fn node(role: str) -> str {
    if role == WORLD {
        glyphs::CIRCLE
    } else {
        glyphs::CIRCLE
    }
}

/// An asset's mark by its kind, as a reference's field leads with it.
pub fn asset(kind: str) -> str {
    match kind {
        asset_kinds::TEXTURE => glyphs::IMAGE,
        asset_kinds::IMAGE => glyphs::IMAGE,
        asset_kinds::MATERIAL => glyphs::PALETTE,
        asset_kinds::MODEL => glyphs::CUBE,
        asset_kinds::AUDIO => glyphs::SPEAKER_HIGH,
        asset_kinds::SKY => glyphs::CLOUD_SUN,
        components::FONT => glyphs::TEXT_AA,
        _ => glyphs::FILE,
    }
}
