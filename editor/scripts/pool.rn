//! A pool of widget nodes under one host: a form whose fields change with the
//! selection cannot be authored, so a script says which rows it needs.
//!
//! The pool itself is `ui::fill_strip` and `ui::fill_rows`: making, reusing
//! and hiding the nodes, writing only what changed, and calling a control's
//! `on` with the reader's edit. Spare rows are hidden rather than freed, so
//! scrolling a long component list does not churn the scene tree.

use crate::util;

/// Fill a row of controls, one node each, making and hiding as needed.
///
/// The strip the chrome is made of: how many workspaces, documents and tools
/// there are changes with the workspace and with what is open, so the bar can
/// no more be authored than the inspector's form can.
pub fn strip(S, host_path, controls) {
    ui::fill_strip(host_path, controls);
}

/// Put `specs` on the host's children, making what is missing and hiding what
/// is spare. A spec is `#{ label, controls }`, and a control is a widget
/// property table plus an `on` the pool calls with the reader's edit.
///
/// `slot_role` dresses the row's control column, so the air between a caret
/// and the heading beside it is a theme entry rather than a number here.
///
/// The rows are as wide as the host: `stacked` puts each label above its
/// control column instead of beside it, for a host too narrow for both.
pub fn sync(S, host_path, specs, label_w, stacked) {
    ui::fill_rows(host_path, specs, label_w, stacked);
}

/// `strip`, when `key` moved since the host was last filled. The key holds
/// whatever the controls are built from, so a frame that changed none of it
/// builds nothing: the pool keeps the callbacks and hears the controls itself.
///
/// A self-test run builds and fills anyway, and warns when the controls
/// changed under a key that did not: an input the key left out.
pub fn strip_when(S, host_path, key, build) {
    if S.pool_keys.get(host_path) == Some(key) {
        if S.start_states != "" && ui::fill_strip(host_path, build()) {
            log::warn(`the strip at ${host_path} changed while its key did not`);
        }
        return;
    }
    S.pool_keys[host_path] = key;
    ui::fill_strip(host_path, build());
}

/// `sync`, when `key` moved; the same contract as `strip_when`.
pub fn sync_when(S, host_path, key, label_w, stacked, build) {
    let full = [key, label_w, stacked];
    if S.pool_keys.get(host_path) == Some(full) {
        if S.start_states != "" && ui::fill_rows(host_path, build(), label_w, stacked) {
            log::warn(`the rows at ${host_path} changed while their key did not`);
        }
        return;
    }
    S.pool_keys[host_path] = full;
    ui::fill_rows(host_path, build(), label_w, stacked);
}

/// Stop drawing the whole pool, for a panel that has nothing to show. What it
/// was filled with goes back on when it shows again.
pub fn hide(S, host_path) {
    util::hide(host_path);
    S.pool_keys.remove(host_path);
}
