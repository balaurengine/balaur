// Left column (262 px): node tree + per-persona secondary panel.

use crate::anim;
use crate::icons;
use crate::model;
use crate::shell;
use crate::style;
use crate::util;


// One tree row: connector rails, collapse arrow, coloured type icon, name,
// One row: depth guides, collapse arrow, typed mark, name, trailing badge;
// right-click opens the node's context menu.
const ROW_H = 23.0;
const INDENT = 14.0;
// Where the first guide sits, measured from the sheet's inner edge.
const GUIDE_X = 9.0;

// Real lines, drawn from the row's own y: glyph rails never lined up with the
// row height, and a tree without them cannot show depth.
fn guides(S, k, depth, is_last) {
    if depth == 0 {
        return;
    }
    let y = ui::cursor_y();
    for level in 0..depth {
        let x = GUIDE_X + (level as f64) * INDENT;
        let last_level = level == depth - 1;
        let h = if last_level && is_last { ROW_H / 2.0 } else { ROW_H };
        ui::rect_stroke(x, y, 0.4, h, #{ color: k.line, width: 1.0 });
        if last_level {
            // The stub into the row: what makes a parent's last child read as
            // the end of that branch rather than the start of another.
            ui::rect_stroke(x, y + ROW_H / 2.0, INDENT + 10.0, 0.4, #{ color: k.line, width: 1.0 });
        }
    }
}

fn tree_row(S, k, row) {
    let i = row.index;
    let depth = row.depth;
    let node = S.doc[i];
    let selected = i == S.sel;
    guides(S, k, depth, row.is_last);
    ui::horizontal(#{ height: ROW_H }, || {
        ui::add_space(2.0 + (depth as f64) * INDENT);
        if row.has_kids {
            // Keyed by id, which is what the walk buckets on and what survives
            // a rename: collapsing a node should not reopen it when it is
            // renamed.
            let id = node.get("id").unwrap_or("");
            let open = !S.collapsed.contains_key(id);
            if ui::pill(if open { icons::ui("caret-open") } else { icons::ui("caret-shut") }, #{
                height: 15, size: 8, radius: 3, min_width: 13,
                color: k.faint, tooltip: "Collapse",
            }) {
                if open {
                    S.collapsed[id] = true;
                } else {
                    S.collapsed.remove(id);
                }
            }
        } else {
            ui::add_space(13);
        }
        let (icon, token) = model::node_icon(node);
        let icon_color = k.get(token).unwrap_or(k.faint);
        // Row spans the rest of the panel, content left-aligned.
        if ui::pill(node.name, #{
            role: if selected { "row_on" } else { "row" },
            strong: depth == 0,
            min_width: ui::available_width(),
            icon: icon, icon_size: 12,
            icon_color: if selected { k.on_accent } else { icon_color },
            // A row from a prefab reads as one level quieter: it is real, and
            // it is not this file's to restructure.
            color: if selected {
                k.on_accent
            } else if model::is_instanced(node) {
                k.dim
            } else {
                k.text
            },
            // An instance's own children come from another file and are not
            // in this document, so the row says so rather than looking empty.
            trailing: if node.contains_key("instance") {
                icons::ui("instance")
            } else if node.contains_key("script") {
                icons::ui("scriptfile")
            } else {
                ()
            },
            trailing_color: if selected { k.on_accent } else { k.sage },
            menu: || {
                if ui::menu_item("＋  Add child", #{ color: k.text }) {
                    shell::choose(S, i);
                    model::add_child(S, None);
                }
                if ui::menu_item("‹›  Attach script", #{ color: k.text }) {
                    shell::choose(S, i);
                    shell::attach_script(S);
                }
                if ui::menu_item("⧉  Duplicate", #{ color: k.text }) {
                    shell::choose(S, i);
                    model::duplicate_selected(S);
                }
                if ui::menu_item("✕  Delete", #{ color: k.accent }) {
                    shell::choose(S, i);
                    model::delete_selected(S);
                }
            },
        }) {
            shell::choose(S, i);
        }
    });
}

// `kids` is bucketed by the parent's **id**, so the recursion carries an id
// too. Descending by name path is what used to make every nested node
// invisible: no bucket is ever keyed by a path.
fn walk(S, k, kids, parent_id, depth, rails) {
    let children = kids.get(parent_id).unwrap_or([]);
    for (j, i) in children.iter().enumerate() {
        let node = S.doc[i];
        let id = node.get("id").unwrap_or("");
        let is_last = j == children.len() - 1;
        let has_kids = kids.contains_key(id);
        tree_row(S, k, #{ index: i, depth: depth, rails: rails, is_last: is_last, has_kids: has_kids });
        if has_kids && !S.collapsed.contains_key(id) {
            let extend = if depth == 0 {
                ""
            } else if is_last {
                rails + "  "
            } else {
                rails + "│ "
            };
            walk(S, k, kids, id, depth + 1, extend);
        }
    }
}


// A row: `#{ icon, name, meta, run }`.

fn row(icon, name, meta, run) {
    #{ icon: icon, name: name, meta: meta, run: run }
}

// Per-persona secondary contents, from real project data where it exists.
// Returns the section title and its rows; drawing is the caller's, so the
// tree above can size itself to what this actually holds.
fn secondary_content(S) {
    if S.persona == "script" {
        let rows = [];
        for f in model::list(S, "scripts") {
            if !f.is_dir && f.name.ends_with(".rn") {
                let rel = "scripts/" + f.name;
                let n = util::count_lines(model::source(S, rel).unwrap_or(""));
                rows.push(row("‹›", f.name, format!("{} L", n), || {
                    // Jump to the node using this script.
                    for (i, node) in S.doc.iter().enumerate() {
                        if model::script_rel(node) == Some(rel) {
                            shell::choose(S, i);
                            break;
                        }
                    }
                }));
            }
        }
        // `return`: a bare tuple after an `if` block parses as a call on the block's value.
        return ("Rune modules", rows);
    } else if S.persona == "phys" {
        // A 2D scene carries `body2d`/`collider2d`; reading `body` alone left
        // this panel empty for every 2D project.
        let rows = [];
        for (i, node) in S.doc.iter().enumerate() {
            let kind = match model::body_kind(node) {
                Some(kind) => Some(kind),
                None => model::body2d_kind(node),
            };
            let collider = node.contains_key("collider3d") || node.contains_key("collider2d");
            if kind.is_some() || collider {
                let dim = if node.contains_key("body2d") || node.contains_key("collider2d") { "2D" } else { "3D" };
                rows.push(row("▣", node.name, format!("{} · {}", kind.unwrap_or("collider3d"), dim), || {
                    shell::choose(S, i);
                }));
            }
        }
        if rows.len() == 0 {
            rows.push(row("▣", "no bodies or colliders", "", || {}));
        }
        return ("Collision", rows);
    } else if S.persona == "anim" {
        let rows = [];
        for (i, node) in S.doc.iter().enumerate() {
            if anim::component(node).is_some() {
                let name = anim::clip_name(node);
                rows.push(row(
                    "◷",
                    if name == "" { node.name } else { name },
                    anim::library_path(node).unwrap_or("inline"),
                    || { shell::choose(S, i); },
                ));
            }
        }
        if rows.len() == 0 {
            rows.push(row("◷", "no clips — ＋ Key in Timeline", "", || {}));
        }
        return ("Clips", rows);
    } else if S.persona == "ui" {
        // Two ways a node puts something on screen: a `widget` component in the
        // scene, or a script with a `draw_ui` hook. Listing only the second
        // said "no UI scripts" over a viewport full of widgets.
        let rows = [];
        for (i, node) in S.doc.iter().enumerate() {
            let widget_some = node.get("widget");
            if let Some(widget) = widget_some {
                let kind = if widget is Object { widget.get("kind").unwrap_or("widget") } else { widget };
                rows.push(row("▤", node.name, format!("{}", kind), || { shell::choose(S, i); }));
            } else if node.contains_key("script") && model::draws_ui(S, node) {
                rows.push(row("‹›", node.name, "draw_ui", || { shell::choose(S, i); }));
            }
        }
        if rows.len() == 0 {
            rows.push(row("▤", "no widgets or draw_ui scripts", "", || {}));
        }
        return ("Interface", rows);
    } else {
        let rows = [];
        for f in model::list(S, "scenes") {
            if !f.is_dir {
                let rel = "scenes/" + f.name;
                rows.push(row("◇", f.name, if S.scene_rel == rel { "open" } else { "" }, || {
                    if S.scene_rel != rel {
                        model::open_scene(S, rel);
                    }
                }));
            }
        }
        return ("Scenes", rows);
    }
}

/// The tab name the persona's secondary list gets.
pub fn outline_title(S) {
    let (title, _) = secondary_content(S);
    title
}

/// The Scene tab's one control, drawn in the dock's tab row.
pub fn tree_tools(S, k) {
    ui::add_space(6);
    if ui::pill(icons::ui("add"), #{
        role: "icon_button", min_width: 24,
        fill: k.accent_soft, color: k.accent,
        tooltip: "Add child node",
    }) {
        model::add_child(S, None);
    }
}

pub fn tree_body(S, k) {
    ui::add_space(4);
    let kids = #{};
    for (i, node) in S.doc.iter().enumerate() {
        let parent = node.get("parent").unwrap_or("");
        if !kids.contains_key(parent) {
            kids[parent] = [];
        }
        kids[parent].push(i);
    }
    ui::scroll("tree", #{ max_height: S.layout.left.h - 44.0 }, || {
        ui::spacing(4, 1);
        walk(S, k, kids, "", 0, "");
    });
}

pub fn outline_body(S, k) {
    let (_, rows) = secondary_content(S);
    ui::add_space(4);
    ui::scroll("outline", #{ max_height: S.layout.left.h - 44.0 }, || {
        ui::spacing(4, 4);
        for row in rows {
            ui::horizontal(#{ height: 27 }, || {
                ui::add_space(2);
                if ui::pill(row.name, #{
                    role: "list_item", min_width: ui::available_width(),
                    icon: row.icon, icon_size: 12, icon_color: k.dim,
                    trailing: row.meta, trailing_color: k.faint,
                }) {
                    (row.run)();
                }
            });
        }
    });
}
