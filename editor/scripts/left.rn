// Left column (262 px): node tree + per-persona secondary panel.

use crate::anim;
use crate::icons;
use crate::model;
use crate::shell;
use crate::style;
use crate::util;


// The `tree` node this file fills; the hatch still draws the search above it.
const TREE_NODE = "Editor/Shell/Body/Left/LeftSheet/LeftTree";
const OUTLINE_NODE = "Editor/Shell/Body/Left/LeftSheet/LeftOutline";
const ROW_H = 23.0;
// The pitch the `tree` node draws at. Stated rather than measured: the node
// takes it as `row_height`, so `row_spot` and the rows cannot drift apart.
const TREE_ROW = 23.0;
const INDENT = 14.0;
// Where the first guide sits, measured from the sheet's inner edge.
const GUIDE_X = 9.0;

// Real lines, drawn from the row's own y: glyph rails never lined up with the
// row height, and a tree without them cannot show depth.
fn guides(S, k, depth, is_last) {
    if depth == 0 {
        return;
    }
    let y = ui::cursor_y();
    for level in 0..depth {
        let x = GUIDE_X + (level as f64) * INDENT;
        let last_level = level == depth - 1;
        let h = if last_level && is_last { ROW_H / 2.0 } else { ROW_H };
        ui::rect_stroke(x, y, 0.4, h, #{ color: k.line, width: 1.0 });
        if last_level {
            // The stub into the row: what makes a parent's last child read as
            // the end of that branch rather than the start of another.
            ui::rect_stroke(x, y + ROW_H / 2.0, INDENT + 10.0, 0.4, #{ color: k.line, width: 1.0 });
        }
    }
}

// One row: depth guides, collapse arrow, typed mark, name, trailing badge;
// right-click opens the node's context menu.
fn tree_row(S, k, row) {
    let i = row.index;
    let depth = row.depth;
    let node = S.doc[i];
    let selected = crate::selection::contains(S, i);
    let active = i == S.sel;
    guides(S, k, depth, row.is_last);
    ui::horizontal(#{ height: ROW_H }, || {
        ui::add_space(2.0 + (depth as f64) * INDENT);
        if row.has_kids {
            // Keyed by id, which is what the walk buckets on and what survives
            // a rename: collapsing a node should not reopen it when it is
            // renamed.
            let id = node.get("id").unwrap_or("");
            let open = !S.collapsed.contains_key(id);
            if ui::pill(if open { icons::ui("caret-open") } else { icons::ui("caret-shut") }, #{
                height: 20, size: style::SM, radius: 3, min_width: 13,
                color: k.faint, tooltip: "Collapse",
            }) {
                if open {
                    S.collapsed[id] = true;
                } else {
                    S.collapsed.remove(id);
                }
            }
        } else {
            ui::add_space(13);
        }
        let (icon, token) = model::node_icon(node);
        let icon_color = k.get(token).unwrap_or(k.faint);
        if ui::pill(node.name, #{
            role: if selected { "row_on" } else { "row" },
            strong: depth == 0 || (selected && !active),
            min_width: ui::available_width(),
            icon: icon, icon_size: style::MD,
            icon_color: if selected { k.on_accent } else { icon_color },
            // A row from a prefab reads as one level quieter: it is real, and
            // it is not this file's to restructure.
            color: if selected {
                k.on_accent
            } else if model::is_instanced(node) {
                k.dim
            } else {
                k.text
            },
            // An instance's own children come from another file and are not
            // in this document, so the row says so rather than looking empty.
            trailing: if crate::selection::is_locked(S, i) {
                icons::ui("lock")
            } else if node.get("visible") == Some(false) {
                icons::ui("hidden")
            } else if node.contains_key("instance") {
                icons::ui("instance")
            } else if node.contains_key("script") {
                icons::ui("scriptfile")
            } else {
                ()
            },
            trailing_color: if selected { k.on_accent } else { k.sage },
            menu: || {
                if ui::menu_item(icons::ui("add") + "  Add child", #{ color: k.text }) {
                    shell::choose(S, i);
                    model::add_child(S, None);
                }
                if ui::menu_item(icons::ui("caret-open") + "  Move up", #{ color: k.text }) {
                    shell::choose(S, i);
                    model::move_sibling(S, -1);
                }
                if ui::menu_item(icons::ui("caret-shut") + "  Move down", #{ color: k.text }) {
                    shell::choose(S, i);
                    model::move_sibling(S, 1);
                }
                if ui::menu_item("‹›  Attach script", #{ color: k.text }) {
                    shell::choose(S, i);
                    shell::attach_script(S);
                }
                if ui::menu_item(icons::ui("instance") + "  Duplicate", #{ color: k.text }) {
                    shell::choose(S, i);
                    model::duplicate_selected(S);
                }
                if ui::menu_item(icons::ui("hidden") + "  Hide or show", #{ color: k.text }) {
                    shell::choose(S, i);
                    crate::arrange::toggle_hidden(S);
                }
                if ui::menu_item(icons::ui("lock") + "  Lock or unlock", #{ color: k.text }) {
                    shell::choose(S, i);
                    crate::arrange::toggle_locked(S);
                }
                if ui::menu_item("✕  Delete", #{ color: k.accent }) {
                    shell::choose(S, i);
                    model::delete_selected(S);
                }
            },
        }) {
            shell::choose_click(S, i);
        }
    });
}

// Rebuilt only when the document or a fold changed; both loops below are
// linear in the document, which the drawing no longer is.
fn open_rows(S) {
    let key = format!("{}:{}:{}", S.doc_rev, S.doc.len(), S.collapsed.len());
    if S.tree_cache.get("key") == Some(key) {
        return S.tree_cache["rows"];
    }
    let kids = #{};
    for (i, node) in S.doc.iter().enumerate() {
        let parent = node.get("parent").unwrap_or("");
        if !kids.contains_key(parent) {
            kids[parent] = [];
        }
        kids[parent].push(i);
    }
    let rows = flatten(S, kids, "", 0);
    S.tree_cache = #{ key: key, rows: rows };
    rows
}

// `kids` is bucketed by the parent's **id**, so the recursion carries an id
// too: no bucket is ever keyed by a path.
fn flatten(S, kids, parent_id, depth) {
    let out = [];
    let children = kids.get(parent_id).unwrap_or([]);
    for (j, i) in children.iter().enumerate() {
        let node = S.doc[i];
        let id = node.get("id").unwrap_or("");
        let is_last = j == children.len() - 1;
        let has_kids = kids.contains_key(id);
        out.push(#{ index: i, depth: depth, is_last: is_last, has_kids: has_kids });
        if has_kids && !S.collapsed.contains_key(id) {
            for row in flatten(S, kids, id, depth + 1) {
                out.push(row);
            }
        }
    }
    out
}


fn row(icon, name, meta, run) {
    #{ icon: icon, name: name, meta: meta, run: run }
}

// Per-persona secondary contents, from real project data where it exists.
// Returns the section title and its rows; drawing is the caller's, so the
// tree above can size itself to what this actually holds.
fn secondary_content(S) {
    if S.persona == "script" {
        let rows = [];
        for f in model::list(S, "scripts") {
            if !f.is_dir && f.name.ends_with(".rn") {
                let rel = "scripts/" + f.name;
                rows.push(row("‹›", f.name, format!("{} L", model::line_count(S, rel)), || {
                    for (i, node) in S.doc.iter().enumerate() {
                        if model::script_rel(node) == Some(rel) {
                            shell::choose(S, i);
                            break;
                        }
                    }
                }));
            }
        }
        // `return`: a bare tuple after an `if` block parses as a call on the block's value.
        return ("Rune modules", rows);
    } else if S.persona == "phys" {
        // A 2D scene carries `body2d`/`collider2d`; reading `body` alone left
        // this panel empty for every 2D project.
        let rows = [];
        for (i, node) in S.doc.iter().enumerate() {
            let kind = match model::body_kind(node) {
                Some(kind) => Some(kind),
                None => model::body2d_kind(node),
            };
            let collider = node.contains_key("collider3d") || node.contains_key("collider2d");
            if kind.is_some() || collider {
                let dim = if node.contains_key("body2d") || node.contains_key("collider2d") { "2D" } else { "3D" };
                rows.push(row("▣", node.name, format!("{} · {}", kind.unwrap_or("collider3d"), dim), || {
                    shell::choose(S, i);
                }));
            }
        }
        if rows.len() == 0 {
            rows.push(row("▣", "no bodies or colliders", "", || {}));
        }
        return ("Collision", rows);
    } else if S.persona == "anim" {
        let rows = [];
        for (i, node) in S.doc.iter().enumerate() {
            if anim::component(node).is_some() {
                let name = anim::clip_name(node);
                rows.push(row(
                    "◷",
                    if name == "" { node.name } else { name },
                    anim::library_path(node).unwrap_or("inline"),
                    || { shell::choose(S, i); },
                ));
            }
        }
        if rows.len() == 0 {
            rows.push(row("◷", format!("no clips — {} Key in Timeline", icons::ui("add")), "", || {}));
        }
        return ("Clips", rows);
    } else if S.persona == "ui" {
        // Two ways a node puts something on screen: a `widget` component in the
        // scene, or a script with a `draw_ui` hook. Listing only the second
        // said "no UI scripts" over a viewport full of widgets.
        let rows = [];
        for (i, node) in S.doc.iter().enumerate() {
            let widget_some = node.get("widget");
            if let Some(widget) = widget_some {
                let kind = if widget is Object { widget.get("kind").unwrap_or("widget") } else { widget };
                rows.push(row("▤", node.name, format!("{}", kind), || { shell::choose(S, i); }));
            } else if node.contains_key("script") && model::draws_ui(S, node) {
                rows.push(row("‹›", node.name, "draw_ui", || { shell::choose(S, i); }));
            }
        }
        if rows.len() == 0 {
            rows.push(row("▤", "no widgets or draw_ui scripts", "", || {}));
        }
        return ("Interface", rows);
    } else {
        let rows = [];
        for f in model::list(S, "scenes") {
            if !f.is_dir {
                let rel = "scenes/" + f.name;
                rows.push(row("◇", f.name, if S.scene_rel == rel { "open" } else { "" }, || {
                    if S.scene_rel != rel {
                        model::open_scene(S, rel);
                    }
                }));
            }
        }
        return ("Scenes", rows);
    }
}

/// The tab name the persona's secondary list gets.
pub fn outline_title(S) {
    let (title, _) = secondary_content(S);
    title
}

/// The Scene tab's one control, drawn in the dock's tab row.
pub fn tree_tools(S, k) {
    ui::add_space(6);
    if ui::pill(icons::ui("add"), #{
        role: "icon_button", min_width: 24,
        fill: k.accent_soft, color: k.accent,
        tooltip: "Add child node",
    }) {
        model::add_child(S, None);
    }
}

// Facets the tree filters by, each a component tag the engine already
// carries, so a plugin's component joins the chips it declared tags for.
fn facets() {
    [["3d", "3D"], ["2d", "2D"], ["physics", "Physics"], ["render", "Draws"], ["ui", "Interface"]]
}

/// Whether a node has any component carrying `tag`, which is what a facet
/// chip filters on.
fn tagged(S, i, tag) {
    if tag == "script" {
        return S.doc[i].contains_key("script");
    }
    let found = match model::live(S, i) {
        Some(found) => found,
        None => return false,
    };
    for name in found.component_names() {
        if crate::util::contains(crate::util::vec(scene::component_tags(name)), tag) {
            return true;
        }
    }
    false
}

// Six chips need about 300 px and the column is 236 at its widest, so this is
// one picker at every size: the row of them was clipped in the resting layout,
// not only in a small window.
fn facet_row(S, k) {
    let chips = facets();
    chips.push(["script", "Script"]);
    facet_picker(S, k, chips);
}

fn facet_picker(S, k, chips) {
    let names = ["All nodes"];
    let current = names[0];
    for chip in chips {
        names.push(chip[1]);
        if chip[0] == S.tree_facet {
            current = chip[1];
        }
    }
    ui::horizontal(#{ height: 24 }, || {
        ui::add_space(2);
        let (pick, changed) = ui::dropdown("tree-facet", current, names,
            #{ width: S.layout.left.w - 40.0, size: style::SM, color: k.dim });
        if changed {
            S.tree_facet = "";
            for chip in chips {
                if chip[1] == pick {
                    S.tree_facet = chip[0];
                }
            }
        }
    });
}

pub fn tree_body(S, k) {
    ui::add_space(4);
    let query = crate::search::field(S, k, "tree", "Search", S.layout.left.w - 24.0);
    ui::add_space(4);
    facet_row(S, k);
    ui::add_space(4);
    if query != "" || S.tree_facet != "" {
        filtered_tree(S, k, query);
        return;
    }
    show_tree(S, k, open_rows(S));
}

// The outliner's rows on the `tree` node beside this hatch. One string a row:
// a tab a level, then the icon and the name either side of a unit separator.
fn show_tree(S, k, rows) {
    let found = scene::get_node(TREE_NODE);
    if util::is_nil(found) {
        return;
    }
    let items = [];
    for row in rows {
        let node = S.doc[row.index];
        let line = "";
        let at = 0;
        while at < row.depth {
            line += "\t";
            at += 1;
        }
        let (mark, token) = model::node_icon(node);
        // The type's own colour on the row, which is what a mark alone
        // cannot say: 2D, 3D, UI and physics each read at a glance.
        line += util::row(mark, node.name, "", k.get(token).unwrap_or(k.text));
        items.push(line);
    }
    let params = util::obj(found.get_component("widget"));
    params["options"] = items;
    params["row_height"] = TREE_ROW;
    params["visible"] = true;
    params["text"] = if S.sel < rows.len() { items[selected_row(rows, S.sel)] } else { "" };
    found.set_component("widget", params);
}

/// Where the tree drew the row for document index `i`, in design px; `None`
/// before it has drawn. The node's own rect, so no caller counts the chrome
/// above it, and the walk's row, so a folded branch cannot shift it.
pub fn row_spot(S, i) {
    let found = scene::get_node(TREE_NODE);
    if util::is_nil(found) {
        return None;
    }
    let box = ui::widget_rect(found);
    if util::is_nil(box) {
        return None;
    }
    let n = selected_row(open_rows(S), i) as f64;
    Some((box.x + box.w * 0.4, box.y + (n + 0.5) * TREE_ROW))
}

// Which drawn row is the selection, so the node can mark it.
fn selected_row(rows, sel) {
    for (n, row) in rows.iter().enumerate() {
        if row.index == sel {
            return n;
        }
    }
    0
}

// Hidden while another panel is up, so its rows do not outlive the tree.
pub fn hide_tree() {
    let found = scene::get_node(TREE_NODE);
    if util::is_nil(found) {
        return;
    }
    let params = util::obj(found.get_component("widget"));
    params["visible"] = false;
    found.set_component("widget", params);
}

// Every node the query and the facet chip both allow, as a flat list.
fn filtered_tree(S, k, query) {
    let any = false;
    let facet = S.tree_facet;
    ui::scroll("tree", #{ max_height: S.layout.left.h - 98.0 }, || {
        ui::spacing(4, 1);
        for (i, node) in S.doc.iter().enumerate() {
            let text = format!("{} {}", node.name, model::node_type(node));
            if !crate::search::matches(query, text) {
                continue;
            }
            if facet != "" && !tagged(S, i, facet) {
                continue;
            }
            any = true;
            tree_row(S, k, #{ index: i, depth: 0, is_last: true, has_kids: false });
        }
        if !any {
            ui::add_space(8);
            crate::search::nothing(k, if query != "" { query } else { facet });
        }
    });
}

pub fn outline_body(S, k) {
    let (_, rows) = secondary_content(S);
    let found = scene::get_node(OUTLINE_NODE);
    if util::is_nil(found) {
        return;
    }
    let items = [];
    for row in rows {
        items.push(row.icon + "\u{1f}" + row.name + "\u{1f}" + row.meta);
    }
    let params = util::obj(found.get_component("widget"));
    params["options"] = items;
    params["visible"] = true;
    found.set_component("widget", params);
    // The pick is the row's own action, looked up by the string the node
    // reports rather than held as a closure on the node.
    let picked = params["text"];
    for (n, item) in items.iter().enumerate() {
        if item == picked {
            (rows[n].run)();
            params["text"] = "";
            found.set_component("widget", params);
        }
    }
}

// Hidden while another panel is up, the way the tree is.
pub fn hide_outline() {
    let found = scene::get_node(OUTLINE_NODE);
    if util::is_nil(found) {
        return;
    }
    let params = util::obj(found.get_component("widget"));
    params["visible"] = false;
    found.set_component("widget", params);
}
