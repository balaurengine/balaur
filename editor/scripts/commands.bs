// The shell's commands by name: what a key in scenes/panels/keys.toml runs.
// One table, so a chord and the palette row for the same thing cannot drift.

use anim;
use arrange;
use defs;
use editor;
use exporter;
use manager;
use model;
use pen;
use polygon;
use refactor;
use sceneedit;
use selection;
use settings;
use shell;
use theme;
use tiles;
use window;
use words::tools;
use words::verbs;

const BREAK: str = "break";
const CANCEL: str = "cancel";
const CONTINUE: str = "continue";
const DEFINITION: str = "definition";
const FORMAT: str = "format";
const REDO_Y: str = "redo_y";
const RELOAD: str = "reload";
const RENAME_SYMBOL: str = "rename_symbol";
const REPLACE: str = "replace";

pub struct KeysView {
    internal stopped: bool,
    internal playing: bool,
}

/// What the keys need to know to say which of them are live.
pub fn keys_view(state: editor::State) -> KeysView {
    KeysView { stopped: state.debug.paused.kind() == types::KIND_MAP, playing: state.playing }
}

/// Run the command `name`. A command with nothing to act on does nothing.
pub fn run(state: &mut editor::State, name: str) {
    if name.starts_with("workspace_") {
        workspace(state, name);
        return;
    }
    match name {
        verbs::PALETTE => {
            if state.palette {
                shell::close_palette(state);
            } else {
                shell::open_palette(state, "");
            }
        }
        verbs::SAVE => { shell::save_active(state); }
        FORMAT => { shell::format_active(state); }
        DEFINITION => { shell::goto_definition(state); }
        RENAME_SYMBOL => { refactor::open(state, "rename"); }
        REPLACE => { refactor::open(state, REPLACE); }
        verbs::FOCUS => { shell::toggle_focus(state); }
        verbs::SPLIT => { shell::toggle_split(state); }
        verbs::ZOOM_IN => { shell::step_ui_scale(state, shell::UI_SCALE_STEP); }
        verbs::ZOOM_OUT => { shell::step_ui_scale(state, -shell::UI_SCALE_STEP); }
        verbs::SETTINGS => { settings::open(state); }
        verbs::EXPORT => { exporter::open(state); }
        CONTINUE => { shell::resume(state, debugger::CONTINUE); }
        verbs::STEP_OVER => { shell::resume(state, debugger::STEP_OVER); }
        verbs::STEP_INTO => { shell::resume(state, debugger::STEP_INTO); }
        verbs::STEP_OUT => { shell::resume(state, debugger::STEP_OUT); }
        verbs::PLAY => { shell::toggle_play(state); }
        BREAK => { debugger::request_break(); }
        verbs::ADD_CHILD => { sceneedit::add_child(state); }
        verbs::ATTACH_SCRIPT => { shell::attach_script(state); }
        RELOAD => { shell::reload_scripts(state); }
        verbs::COPY => { copy(state); }
        verbs::REDO | REDO_Y => { shell::redo(state); }
        verbs::UNDO => { shell::undo(state); }
        verbs::THEME => { theme::toggle(state); }
        verbs::SELECT_ALL => { selection::select_all(state); }
        verbs::UNGROUP => { arrange::ungroup(state); }
        verbs::GROUP => { arrange::group(state); }
        verbs::UNLOCK_ALL => { arrange::unlock_all(state); }
        verbs::LOCK => { arrange::toggle_locked(state); }
        verbs::SHOW_ALL => { arrange::show_all(state); }
        verbs::HIDE => { arrange::toggle_hidden(state); }
        verbs::ISOLATE => { arrange::toggle_isolate(state); }
        tools::KEY => { key(state); }
        CANCEL => { cancel(state); }
        _ => { log::warn("no command named {name}"); }
    }
}

// `workspace_<n>`, one a workspace in the order the bar shows them.
fn workspace(state: &mut editor::State, name: str) {
    let number = name.slice("workspace_".len(), name.len()).parse_int();
    let workspaces = defs::workspaces();
    for index in 0..workspaces.len() {
        let space = workspaces[index];
        if index + 1 == number {
            shell::set_workspace(state, space.id);
        }
    }
}

// ⌘V is the paste event the Editor hears; only the copy half is a chord.
fn copy(state: editor::State) {
    if model::has_selection(state) {
        ui::set_clipboard(sceneedit::copy_selected(state));
    }
}

// A key on the timeline where the playhead is, in the Animation workspace.
fn key(state: &mut editor::State) {
    if state.workspace == defs::WORKSPACE_ANIMATION {
        anim::add_key(state, state.anim.time);
    }
}

// Escape stops whichever drawing tool is mid-shape. The completion popup takes
// it first while it is open, as it takes the arrows and Enter.
fn cancel(state: &mut editor::State) {
    // Over the start screen it closes the screen, once the New project sheet
    // over that has gone.
    if manager::showing(state) {
        if !window::showing(state, "manager-new") {
            manager::close(state);
        }
        return;
    }
    if state.complete.open {
        return;
    }
    polygon::cancel(state);
    pen::cancel(state);
    tiles::cancel(state);
}
