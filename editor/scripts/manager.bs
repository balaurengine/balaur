// The screen the editor starts on when it was given no project: what this
// machine has opened, the examples that ship with it, and which engine build
// is installed. Drawn with the shell's own widgets and its own theme.

use editor;
use form;
use icons;
use settings;
use shipped;
use signals;
use style;
use util;
use versions;
use window;
use words::command;
use words::fields;
use words::layout_fields;
use words::log_fields;
use words::panel_keys;
use words::project_fields;
use words::roles;
use words::statuses;
use words::tabs;

const COPIED: str = "copied";
const ENGINE: str = "engine";
const EXAMPLES: str = "examples";
const NEW: str = "new";
const COVER: str = "cover";
const EMPTY: str = "empty";
const FORGE: str = "forge";
const MY_GAME: str = "my-game";
const PROJECTS: str = "projects";
const MANAGER: str = "manager";
const BACK: str = "Back";
const EXISTS: str = "exists";
const LINE: str = "Line";
const PROJECT_SCENE: str = "scenes/items/project_row.toml";
const CARD_SCENE: str = "scenes/items/card.toml";

pub class ManagerState {
    internal on: bool,
    covering: bool,
    internal tab: str,
    recent: [project::Recent],
    read: bool,
    filter: str,
    name: str,
    template: str,
    parent: str,
    internal note: str,
    internal failed: str,
    spots: any,
    internal releases: [any],
    internal asked: bool,
    internal reading: bool,
    internal follow: str,
    internal tag: str,
    internal installing: Installing,
    back: bool,
    /// Public projects on Forge, as the last search answered.
    forge: [any],
    forge_asked: bool,
    /// The project a copy is being made of, or "".
    copying: str,
}

/// An install in flight: the tag, bytes so far and of how many, and whether
/// it is unpacking. No `tag` when none is.
pub struct Installing {
    internal tag: str,
    internal done: int,
    internal total: int,
    internal unpacking: bool,
}

/// A control's centre in design px.
pub struct Spot {
    internal x: float,
    internal y: float,
}

/// The state the screen keeps: what it read, what is being typed, and what it
/// was told last.
pub fn state() -> ManagerState {
    ManagerState {
        on: false,
        // Whether the shell under the screen is hidden; see `cover`.
        covering: false,
        tab: command::PROJECTS,
        recent: [],
        read: false,
        filter: "",
        // The New project sheet's fields, which only exist while it is up.
        name: MY_GAME,
        template: EMPTY,
        parent: "",
        note: "",
        failed: "",
        // Where each control this screen draws last landed, keyed by the name
        // the showcase points at: an immediate pill has no node to ask.
        spots: {},
        // The release feed, asked for once when the Engine tab or About opens,
        // and whether a read is out.
        releases: [],
        asked: false,
        reading: false,
        follow: "",
        tag: "",
        // An install in flight: the tag, bytes so far and of how many, and
        // whether it is unpacking. Empty when none is.
        installing: versions::no_install(),
        // Opened over a project, with the way back to it.
        back: false,
        forge: [],
        forge_asked: false,
        copying: "",
    }
}

// The widest the screen draws, whatever the window is: a list stretched
// across a monitor is a list nobody can read across.
const COLUMN: float = 900.0;

// What a cover is: the shape `scripts/showcase.sh` writes them in, so a card
// reserves the room the picture will actually take.
const COVER_ASPECT: float = 1.7647;

// The sheet a new project is named in, which the shell already has a shape for.
const NEW_SHEET: str = "manager-new";

// The editor's own mark, which the top bar draws too. A project of its own
// is not open yet, so every row wears this one.
pub const LOGO: str = "assets/balaur-logo.png";

// Light ink, for a mark set straight on a dark theme's ground.
const LOGO_DARK: str = "assets/balaur-logo-dark.png";

// The mark is dark ink on nothing, drawn for a light ground: the top bar sets
// it on a light badge, and so does every other place that shows it.
internal const MB: int = 1048576;

/// Whether the editor is running in a browser tab, where a project is opened
/// by the page rather than by starting a second editor.
pub fn in_tab() -> bool {
    project::in_tab()
}

/// The `manager` start state: show the screen instead of the docks.
pub fn open(state: &mut editor::State) {
    state.manager.on = true;
    state.manager.read = false;
    state.manager.back = false;
    told(state);
    // The other two pages are not offered in a tab, so neither is a state
    // that left the screen on one of them.
    if in_tab() {
        state.manager.tab = command::PROJECTS;
    }
}

/// The screen, on its examples half.
pub fn open_examples(state: &mut editor::State) {
    open(state);
    state.manager.tab = EXAMPLES;
    told(state);
}

/// The screen with the New project sheet up, for a shot and for the palette.
pub fn open_new(state: &mut editor::State) {
    open(state);
    window::show(state, NEW_SHEET);
}

/// The screen, on its engine half: what `--state versions` opens.
pub fn open_versions(state: &mut editor::State) {
    open(state);
    state.manager.tab = ENGINE;
    told(state);
}

/// Ask for a folder and open what is in it, without the screen in between.
pub fn pick(state: &mut editor::State) {
    let picked = project::pick_directory();
    if picked != nil {
        go(state, picked.unwrap());
        return;
    }
    open_over(state);
}

/// The screen over the open project, with the way back to it: what the
/// palette opens. A start state opens the screen a bare launch shows.
pub fn open_over(state: &mut editor::State) {
    open(state);
    state.manager.back = state.game_root != "";
    told(state);
}

/// Back to the project the screen was opened over. Opening another quits
/// this process, so without this the only way out was a restart.
pub fn close(state: &mut editor::State) {
    if state.manager.back {
        state.manager.on = false;
        state.manager.back = false;
        told(state);
    }
}

/// Where a control the showcase points at sits, in design px, by the name it
/// knows it as: a tab by its id, or one of the Projects tab's commands; `None`
/// before it has drawn.
pub fn spot(state: editor::State, name: str) -> Spot? {
    let node = if name == NEW {
        scene::root().get_node(TOOLS() + "/New")
    } else {
        tab_node(name)
    };
    let rect = if node.is_valid() { ui::widget_rect(node) } else { nil };
    if rect == nil {
        return nil;
    }
    let box = rect.unwrap();
    Spot { x: box.x + box.width / 2.0, y: box.y + box.height / 2.0 }
}

// The tab strip's pill for the page `id`.
fn tab_node(id: str) -> Node {
    scene::root().get_node(TABS_NODE() + "/" + id)
}

/// Whether the screen has the window. A run with no project is the screen
/// whether or not anybody asked for it: there is nothing else to hold.
pub fn showing(state: editor::State) -> bool {
    state.manager.on || state.game_root == ""
}

fn tabs() -> [[str]] {
    // A tab installs no engine and fetches its examples from the page it runs
    // in, so the screen there is the list of what this browser keeps.
    if in_tab() {
        return [[PROJECTS, "Projects"]];
    }
    // `return`, because a block followed by `[` is an index.
    return [[PROJECTS, "Projects"], [EXAMPLES, "Examples"], [FORGE, "On Forge"], [ENGINE, "Engine"]];
}

// One column under this, two above it.
internal fn narrow(column_width: float) -> bool {
    column_width < 600.0
}

fn refresh(state: &mut editor::State) {
    if state.manager.read {
        return;
    }
    state.manager.read = true;
    state.manager.recent = project::recent();
    if state.manager.parent == "" {
        state.manager.parent = project::home();
    }
    if state.manager.follow == "" {
        let mine = util::map_or_empty(release::installed())[log_fields::CHANNEL].as_str();
        state.manager.follow = if mine == "" { "nightly" } else { mine };
    }
}

const GROUND: str = "Editor/Manager";

const SHELL: str = "Editor/Shell";

fn HEAD_NODE() -> str {
    GROUND + "/ManagerHead"
}

fn TABS_NODE() -> str {
    GROUND + "/ManagerTabs"
}

fn BODY() -> str {
    GROUND + "/ManagerBody"
}

fn NOTE() -> str {
    GROUND + "/ManagerBody/Note"
}

fn PROGRESS() -> str {
    GROUND + "/ManagerBody/Progress"
}

fn TOOLS() -> str {
    GROUND + "/ManagerBody/Tools"
}

fn PAGE() -> str {
    GROUND + "/ManagerBody/Scroll/Page"
}

fn ROWS() -> str {
    PAGE() + "/Rows"
}

/// Fill the start screen: its head, its tabs and the page under them, from
/// what this machine has opened, the examples and the release feed. What
/// its script asks for on `manager_changed` and when it was resized.
pub fn fill(state: &mut editor::State) {
    if !state.manager.on {
        util::hide(GROUND);
        cover(state, false);
        return;
    }
    refresh(state);
    let tokens = state.theme;
    // The screen is the window: a project's own widgets are not behind this.
    if state.mirror != nil && state.mirror.unwrap().is_valid() {
        state.mirror.unwrap().widget.width = 0.0;
        state.mirror.unwrap().widget.height = 0.0;
    }
    util::set_visible(GROUND, true);
    cover(state, true);
    head(state, tokens);
    tab_row(state);
    let column_width = page_width();
    head_note(state);
    tools(state);
    let tab = state.manager.tab;
    let projects = if tab == PROJECTS { shown(state) } else { [] };
    project_rows(state, column_width, projects);
    let cards: [Card] = if tab == EXAMPLES { example_cards(state) } else if tab == tabs::FORGE { forge_cards(state) } else { [] };
    card_grid(state, cards, if tab == EXAMPLES { example_columns(column_width) } else { 1 });
    let specs = if tab == ENGINE {
        versions::engine_specs(state, column_width)
    } else if tab == EXAMPLES {
        examples_notes()
    } else if tab == tabs::FORGE {
        forge_notes(state)
    } else {
        projects_notes(state, projects)
    };
    form::fill(PAGE() + "/Says", forge_lead(state));
    form::fill(ROWS(), specs);
}

// The page's width, as it was laid out: the widest the screen draws, whatever
// the window is, since a list across a monitor is a list nobody can read.
fn page_width() -> float {
    let rect = ui::widget_rect(scene::root().get_node(BODY()));
    if rect == nil || rect.unwrap().width <= 0.0 {
        COLUMN
    } else {
        math::min(rect.unwrap().width, COLUMN)
    }
}

/// The Projects tab's filter, as it is typed.
pub fn set_filter(state: &mut editor::State, text: str) {
    state.manager.filter = text;
    told(state);
}

/// The Projects tab's commands, by the name of the button pressed.
pub fn pressed(state: &mut editor::State, name: str) {
    if name == BACK {
        close(state);
        return;
    }
    if name == "New" {
        window::show(state, NEW_SHEET);
        return;
    }
    let picked = project::pick_directory();
    if picked == nil {
        return;
    }
    go(state, picked.unwrap());
    told(state);
}

// What the head says under itself: a note or a failure, and a job's bar.
fn head_note(state: editor::State) {
    let said = if state.manager.failed != "" { state.manager.failed } else { state.manager.note };
    let filled = scene::root().get_node(NOTE());
    if filled.is_valid() {
        filled.set_visible(said != "");
        filled.widget.text = said;
        filled.widget.role = if state.manager.failed != "" { roles::NOTE_WARNING } else { roles::TEXT_CODE_CAPTION };
    }
    let controls = if versions::installing(state) {
        versions::progress_controls(state)
    } else {
        []
    };
    util::set_visible(PROGRESS(), controls.len() > 0);
    form::strip(PROGRESS(), controls);
}

// The filter and the three commands, up on the Projects tab. A tab has no folder
// picker and nowhere to write a template: the page it runs in is what starts
// a project there, and this screen reopens one.
fn tools(state: editor::State) {
    let up = state.manager.tab == command::PROJECTS;
    let acting = !in_tab();
    util::set_visible(TOOLS(), up);
    util::set_text(TOOLS() + "/Filter", state.manager.filter);
    let filled = scene::root().get_node(TOOLS() + "/Open");
    if filled.is_valid() {
        filled.set_visible(acting && !state.touchscreen);
        filled.widget_button.icon = icons::panel(icons::ASSETS);
    }
    let filled = scene::root().get_node(TOOLS() + "/New");
    if filled.is_valid() {
        filled.set_visible(acting);
        filled.widget_button.icon = icons::ui(icons::ADD);
    }
}

/// A line the start screen and the About sheet say under what they show: the
/// mono face, small and quiet.
internal fn say(text: str) -> form::Row {
    form::Row { controls: [ui::Control { kind: ui::WIDGET_LABEL, role: roles::TEXT_CODE_CAPTION, grow: 1, wrap: true, text: text }] }
}

/// What the screen was told last: a failure in the warning's ink.
internal fn said(state: editor::State) -> form::Row? {
    if state.manager.failed != "" {
        return form::warning(state.manager.failed);
    }
    if state.manager.note != "" {
        return say(state.manager.note);
    }
    nil
}

// A line across the page: a separator lies across a column, and stands up in a row.
internal fn rule() -> form::Row {
    form::Row { controls: [ui::Control { kind: ui::WIDGET_COLUMN, grow: 1, controls: [ui::Control { kind: ui::WIDGET_SEPARATOR }] }] }
}

// What the Projects tab says where it lists nothing.
fn projects_notes(state: editor::State, rows: [any]) -> [form::Row] {
    if state.manager.tab != PROJECTS || rows.len() > 0 {
        return [];
    }
    let empty = if in_tab() {
        "This browser keeps no projects yet. The page opens one, and it is listed here after that."
    } else {
        "Nothing opened on this machine yet. Start from an example, or make one."
    };
    let why = if state.manager.recent.len() == 0 { empty } else { "No project matches that filter." };
    let none = [say(why)];
    none
}

// A row a project: the name a click opens and the folder under it, and what
// it says about itself at the right edge; a phone shows when it was opened
// and nothing else.
fn project_rows(state: editor::State, column_width: float, rows: [any]) {
    let items: [scene::RepeatItem] = [];
    for at in 0..rows.len() {
        items.push(scene::RepeatItem { key: "{at}", scene: PROJECT_SCENE });
    }
    let nodes = scene::repeat(scene::root().get_node(PAGE() + "/Projects"), items);
    for at in 0..rows.len() {
        let row = util::map_or_empty(rows[at]);
        let here = row[project_fields::PATH].as_str();
        let exists = row[EXISTS];
        let gone = exists != nil && !exists.as_bool();
        let built = row[fields::VERSION].as_str();
        let line = nodes[at].get_node(LINE);
        let open = line.get_node("Text/Open");
        open.widget.text = row[fields::NAME].as_str();
        open.widget_button.icon = if gone { icons::panel(icons::PROBLEMS) } else { "" };
        open.widget.tooltip = here;
        line.get_node("Text/Path").widget.text = if gone { here + "  ·  disk not mounted" } else { here };
        line.get_node("Opened").widget.text = util::said_ago_since(row[fields::OPENED]);
        let shows = built != "" && !narrow(column_width);
        line.get_node("Built").set_visible(shows);
        line.get_node("Built").widget.text = built;
    }
}

// The project a row stands for, by the row's name: its place in the list.
fn project_at(state: editor::State, key: str) -> any {
    let rows = shown(state);
    for at in 0..rows.len() {
        if "{at}" == key {
            return util::map_or_empty(rows[at]);
        }
    }
    nil
}

/// A project's name pressed: it opens, unless its disk is gone.
pub fn project_pressed(state: &mut editor::State, key: str) {
    let row = project_at(state, key);
    if row == nil {
        return;
    }
    let exists = row[EXISTS];
    if exists == nil || exists.as_bool() {
        go(state, row[project_fields::PATH].as_str());
    }
}

/// A project's forget mark pressed: it comes off the list.
pub fn project_forgotten(state: &mut editor::State, key: str) {
    let row = project_at(state, key);
    if row == nil {
        return;
    }
    project::forget(row[project_fields::PATH].as_str());
    state.manager.read = false;
    told(state);
}

// One card's face: a picture or the engine's mark, its name and the line
// under it, and what a press on it does.
struct Card {
    image: str,
    name: str,
    note: str,
    tooltip: str,
}

// How many examples go across a page `column_width` wide.
fn example_columns(column_width: float) -> int {
    if narrow(column_width) { 1 } else if column_width < 760.0 { 2 } else { 3 }
}

fn example_cards(state: editor::State) -> [Card] {
    let out: [Card] = [];
    for entry in util::list_or_empty(shipped::examples()) {
        let row = util::map_or_empty(entry);
        out.push(Card { image: row[COVER].as_str(), name: row[fields::NAME].as_str(), note: row[log_fields::NOTE].as_str(), tooltip: "Copy into " + state.manager.parent });
    }
    out
}

// Public projects on Forge, a card each, a click opening a copy in the
// projects folder as an example does. The first look asks Forge.
fn forge_cards(state: &mut editor::State) -> [Card] {
    if !state.manager.forge_asked {
        state.manager.forge_asked = forge::search("", "");
    }
    let out: [Card] = [];
    for row in state.manager.forge {
        let tags = "";
        for tag in util::list_or_empty(row[fields::TAGS]) {
            tags = if tags == "" { tag.as_str() } else { tags + ", " + tag.as_str() };
        }
        let note = row[fields::DESCRIPTION].as_str();
        out.push(Card { image: "", name: row[project_fields::PROJECT].as_str(), note: if tags == "" { note } else { note + " · " + tags }, tooltip: "Copy into " + state.manager.parent });
    }
    out
}

// The cards, `across` to a line. A picture keeps the card's width less its
// padding and the cover's aspect.
fn card_grid(state: editor::State, cards: [Card], across: int) {
    let grid = scene::root().get_node(PAGE() + "/Cards");
    let columns = "1fr";
    for _ in 1..across {
        columns = columns + " 1fr";
    }
    grid.widget_grid.grid_columns = columns;
    let items: [scene::RepeatItem] = [];
    for at in 0..cards.len() {
        items.push(scene::RepeatItem { key: "{at}", scene: CARD_SCENE });
    }
    let nodes = scene::repeat(grid, items);
    let seam = style::role_size_in_pixels(state, roles::LAYOUT_SPLIT, layout_fields::GAP, 12.0);
    // Floored: the cards and the seams have to add up to the column, and a
    // third of a pixel each puts the last one past its edge.
    let card_width = math::floor((page_width() - (across - 1) as float * seam) / across as float);
    let inner = card_width - 2.0 * style::role_size_in_pixels(state, roles::SHEET_CARD, layout_fields::PADDING, 12.0);
    for at in 0..cards.len() {
        let card = cards[at];
        let sheet = nodes[at].get_node("Sheet");
        let cover = sheet.get_node("Cover");
        let pictured = card.image != "";
        cover.set_visible(pictured);
        if pictured {
            cover.widget_image.image = card.image;
            cover.widget.width = inner;
            cover.widget.height = math::floor(inner / COVER_ASPECT);
        }
        let blank = sheet.get_node("Blank");
        // No picture shipped, on an example: the engine's own mark, so the
        // card still reads as a project rather than a blank.
        blank.set_visible(!pictured && state.manager.tab == EXAMPLES);
        blank.widget.width = inner;
        blank.widget.height = math::floor(inner / COVER_ASPECT);
        sheet.get_node("Name").widget.text = card.name;
        sheet.get_node("Note").widget.text = card.note;
        nodes[at].get_node("Press").widget.tooltip = card.tooltip;
    }
}

/// A card pressed, by its place: an example or a Forge project copied in.
pub fn card_pressed(state: &mut editor::State, key: str) {
    if state.manager.tab == EXAMPLES {
        let rows = util::list_or_empty(shipped::examples());
        for at in 0..rows.len() {
            if "{at}" == key {
                open_example(state, util::map_or_empty(rows[at])[fields::ID].as_str());
                return;
            }
        }
    } else if state.manager.tab == tabs::FORGE {
        for at in 0..state.manager.forge.len() {
            if "{at}" == key {
                let project = state.manager.forge[at][project_fields::PROJECT].as_str();
                if state.manager.copying == "" && forge::copy(project, state.manager.parent) {
                    state.manager.copying = project;
                    told(state);
                }
                return;
            }
        }
    }
}

fn examples_notes() -> [form::Row] {
    if util::list_or_empty(shipped::examples()).len() == 0 {
        let none = [say("No examples ship beside this build.")];
        return none;
    }
    let some = [say("Opens a copy in your projects folder, so the example stays as it shipped.")];
    some
}

// What the On Forge tab says above its cards: a copy under way, and Forge
// being asked or having nothing.
fn forge_lead(state: editor::State) -> [form::Row] {
    let out: [form::Row] = [];
    if state.manager.tab != tabs::FORGE {
        return out;
    }
    if state.manager.copying != "" {
        out.push(say("Copying {state.manager.copying} into {state.manager.parent}"));
    }
    if state.manager.forge.len() == 0 {
        out.push(say(if state.manager.forge_asked { "Asking " + forge::url() } else { "No public projects yet." }));
    }
    out
}

fn forge_notes(state: editor::State) -> [form::Row] {
    if state.manager.forge.len() == 0 {
        return [];
    }
    let below = [say("Opens a copy in your projects folder; the project on Forge stays as it is.")];
    below
}

/// A Forge job reported: the projects a search found, or a copy made.
pub fn forge_heard(state: &mut editor::State, event: any) {
    let kind = event[fields::KIND].as_str();
    if kind == statuses::LISTED {
        state.manager.forge = util::list_or_empty(event[fields::ROWS]);
    } else if kind == COPIED {
        state.manager.copying = "";
        go(state, event[project_fields::PATH].as_str());
        return;
    } else if kind == statuses::FAILED && (event[log_fields::JOB].as_str() == command::COPY || event[log_fields::JOB].as_str() == command::SEARCH) {
        state.manager.copying = "";
        state.manager.failed = event[log_fields::MESSAGE].as_str();
    } else {
        return;
    }
    told(state);
}

/// Copy an example into the projects folder and open the copy.
fn open_example(state: &mut editor::State, id: str) {
    let made = util::map_or_empty(shipped::copy_example(id, state.manager.parent));
    let failed = made[log_fields::ERROR];
    if failed != nil {
        let why = failed;
        state.manager.failed = why.as_str();
        told(state);
        return;
    }
    go(state, made[project_fields::PATH].as_str());
}

/// Hide the shell while the screen is up and show it again after: under the
/// screen its docks would still draw a project that is not open.
pub fn cover(state: &mut editor::State, up: bool) {
    if state.manager.covering != up {
        state.manager.covering = up;
        util::set_visible(SHELL, !up);
    }
}

/// The head strip: the mark, the name, the version, and the way back.
fn head(state: editor::State, tokens: any) {
    let strip = scene::root().get_node(HEAD_NODE());
    strip.get_node("Mark").widget_image.image = if tokens[panel_keys::DARK].as_bool() { LOGO_DARK } else { LOGO };
    strip.get_node("Version").widget.text = project::version();
    let back = strip.get_node(BACK);
    back.set_visible(state.manager.back);
    back.widget.text = "Back to " + state.game_name;
}

// The shell's own tab shape: a pill per page, the open one filled.
fn tab_row(state: editor::State) {
    let strip = scene::root().get_node(TABS_NODE());
    let offered: any = {};
    for row in tabs() {
        offered[row[0]] = true;
    }
    for tab in strip.children() {
        tab.set_visible(offered.has(tab.name()));
        tab.widget_check.checked = state.manager.tab == tab.name();
    }
}

/// A page's pill pressed.
pub fn tab_picked(state: &mut editor::State, id: str) {
    state.manager.tab = id;
}

fn shown(state: editor::State) -> [any] {
    let query = state.manager.filter.to_lower();
    if query == "" {
        return state.manager.recent;
    }
    let out: [any] = [];
    for entry in state.manager.recent {
        let row = util::map_or_empty(entry);
        let haystack = (row[fields::NAME].as_str() + " " + row[project_fields::PATH].as_str()).to_lower();
        if haystack.contains(query) {
            out.push(entry);
        }
    }
    out
}

// The start screen and the About sheet both show what a check and an install
// keep, so each moving says so to both.
internal fn told(state: &mut editor::State) {
    window::changed(state);
    signals::changed(state, MANAGER);
}

// A new project is named in the shell's own sheet, which is what Settings is
// and what a phone needs: one screen at a time.
pub fn new_fill(state: &mut editor::State) {
    let hosts: any = window::sheet_form(state, NEW_SHEET, "New project", []);
    if util::is_nil(hosts) {
        return;
    }
    // The sheet can be up before the screen under it has read where a new
    // project goes.
    if state.manager.parent == "" {
        state.manager.parent = project::home();
    }
    let ids: [str] = [];
    for row in util::list_or_empty(shipped::templates()) {
        ids.push(util::map_or_empty(row)[fields::ID].as_str());
    }
    if ids.len() == 0 {
        ids.push(EMPTY);
    }
    let specs: [form::Row] = [
        form::Row {
            controls: [
                ui::Control {
                    kind: ui::WIDGET_TEXT_FIELD,
                    role: roles::INPUT_FORM,
                    grow: 1,
                    text: state.manager.name,
                    placeholder: "my-game",
                    on_change: "handle", target: form::editor(),
                    data: { fields::FN: on_name_typed },
                },
            ],
            label: "name",
        },
        form::Row {
            controls: [
                ui::Control {
                    kind: ui::WIDGET_DROPDOWN,
                    role: roles::CHOICE_FORM,
                    grow: 1,
                    text: state.manager.template,
                    options: ids,
                    on_change: "handle", target: form::editor(),
                    data: { fields::FN: on_template_picked },
                },
            ],
            label: "from",
        },
        form::Row {
            controls: [ui::Control { kind: ui::WIDGET_LABEL, role: roles::TEXT_CODE_CAPTION, grow: 1, truncate: true, text: state.manager.parent }],
            label: "in",
        },
    ];
    if state.manager.failed != "" {
        specs.push(form::warning(state.manager.failed));
    }
    specs.push(form::Row {
        slot_role: roles::LAYOUT_ACTIONS,
        controls: [
            ui::Control { kind: ui::WIDGET_ROW, grow: 1 },
            ui::Control {
                kind: ui::WIDGET_BUTTON,
                role: roles::ACTION_FORM_PRIMARY,
                text: "Create",
                on_click: "handle", target: form::editor(),
                data: { fields::FN: on_create_pressed },
            },
        ],
    });
    form::fill(hosts["form"].as_str(), specs, 72.0, false);
}

fn on_name_typed(state: &mut editor::State, data: any, text: any) {
    state.manager.name = text.as_str();
}

fn on_template_picked(state: &mut editor::State, data: any, picked: any) {
    state.manager.template = picked.as_str();
}

fn on_create_pressed(state: &mut editor::State, data: any, _value: any) {
    create(state);
}

fn create(state: &mut editor::State) {
    let name = if state.manager.name == "" { MY_GAME } else { state.manager.name };
    let path = state.manager.parent + "/" + name;
    let made = util::map_or_empty(project::create(path, state.manager.template));
    let failed = made[log_fields::ERROR];
    if failed != nil {
        let why = failed;
        state.manager.failed = why.as_str();
        window::changed(state);
        return;
    }
    state.manager.failed = "";
    go(state, path);
}

/// Open a project: the module remembers it, starts the editor on it and asks
/// this process to quit.
pub fn go(state: &mut editor::State, path: str) {
    // Opening quits this process, which would leave an install half swapped in.
    if versions::installing(state) {
        state.manager.failed = "wait for the install to finish";
        told(state);
        return;
    }
    // Before the next editor starts, so it opens at this one's size.
    settings::keep_window_size(state);
    let answer = util::map_or_empty(project::open(path));
    let failed = answer[log_fields::ERROR];
    if failed != nil {
        let why = failed;
        state.manager.failed = why.as_str();
        told(state);
        return;
    }
    state.manager.failed = "";
}
