// The screen the editor starts on when it was given no project: what this
// machine has opened, the examples that ship with it, and which engine build
// is installed. Drawn with the shell's own widgets and its own theme.

use editor;
use icons;
use pool;
use signals;
use style;
use util;
use window;

pub class ManagerState {
    on: bool,
    covering: bool,
    tab: str,
    recent: [project::Recent],
    read: bool,
    filter: str,
    name: str,
    template: str,
    parent: str,
    note: str,
    failed: str,
    spots: any,
    releases: [any],
    asked: bool,
    reading: bool,
    follow: str,
    tag: str,
    installing: Installing,
    back: bool,
    /// Public projects on Forge, as the last search answered.
    forge: [any],
    forge_asked: bool,
    /// The project a copy is being made of, or "".
    copying: str,
}

/// An install in flight: the tag, bytes so far and of how many, and whether
/// it is unpacking. No `tag` when none is.
pub struct Installing {
    tag: str,
    done: int,
    total: int,
    unpacking: bool,
}

/// A control's centre in design px.
pub struct Spot {
    x: float,
    y: float,
}

/// The state the screen keeps: what it read, what is being typed, and what it
/// was told last.
pub fn state() -> ManagerState {
    ManagerState {
        on: false,
        // Whether the shell under the screen is hidden; see `cover`.
        covering: false,
        tab: "projects",
        recent: [],
        read: false,
        filter: "",
        // The New project sheet's fields, which only exist while it is up.
        name: "my-game",
        template: "empty",
        parent: "",
        note: "",
        failed: "",
        // Where each control this screen draws last landed, keyed by the name
        // the showcase points at: an immediate pill has no node to ask.
        spots: map(),
        // The release feed, asked for once when the Engine tab or About opens,
        // and whether a read is out.
        releases: [],
        asked: false,
        reading: false,
        follow: "",
        tag: "",
        // An install in flight: the tag, bytes so far and of how many, and
        // whether it is unpacking. Empty when none is.
        installing: no_install(),
        // Opened over a project, with the way back to it.
        back: false,
        forge: [],
        forge_asked: false,
        copying: "",
    }
}

// The widest the screen draws, whatever the window is: a list stretched
// across a monitor is a list nobody can read across.
const COLUMN: float = 900.0;

// What a cover is: the shape `scripts/showcase.sh` writes them in, so a card
// reserves the room the picture will actually take.
const COVER_ASPECT: float = 1.7647;

const SEAM: float = 14.0;

// The sheet a new project is named in, which the shell already has a shape for.
const NEW_SHEET: str = "manager-new";

// The editor's own mark, which the top bar draws too. A project of its own
// is not open yet, so every row wears this one.
pub const LOGO: str = "assets/balaur-logo.png";

// Light ink, for a mark set straight on a dark theme's ground.
const LOGO_DARK: str = "assets/balaur-logo-dark.png";

// The mark is dark ink on nothing, drawn for a light ground: the top bar sets
// it on a light badge, and so does every other place that shows it.
const MB: int = 1048576;

/// Whether the editor is running in a browser tab, where a project is opened
/// by the page rather than by starting a second editor.
pub fn in_tab() -> bool {
    project::in_tab()
}

/// The `manager` start state: show the screen instead of the docks.
pub fn open(state: &mut editor::State) {
    state.manager.on = true;
    state.manager.read = false;
    state.manager.back = false;
    told(state);
    // The other two pages are not offered in a tab, so neither is a state
    // that left the screen on one of them.
    if in_tab() {
        state.manager.tab = "projects";
    }
}

/// The screen, on its examples half.
pub fn open_examples(state: &mut editor::State) {
    open(state);
    state.manager.tab = "examples";
    told(state);
}

/// The screen with the New project sheet up, for a shot and for the palette.
pub fn open_new(state: &mut editor::State) {
    open(state);
    window::show(state, NEW_SHEET);
}

/// The screen, on its engine half: what `--state versions` opens.
pub fn open_versions(state: &mut editor::State) {
    open(state);
    state.manager.tab = "engine";
    told(state);
}

/// Ask for a folder and open what is in it, without the screen in between.
pub fn pick(state: &mut editor::State) {
    let picked = project::pick_directory();
    if picked.is_some() {
        go(state, picked.unwrap());
        return;
    }
    open_over(state);
}

/// The screen over the open project, with the way back to it: what the
/// palette opens. A start state opens the screen a bare launch shows.
pub fn open_over(state: &mut editor::State) {
    open(state);
    state.manager.back = state.game_root != "";
    told(state);
}

/// Back to the project the screen was opened over. Opening another quits
/// this process, so without this the only way out was a restart.
pub fn close(state: &mut editor::State) {
    if state.manager.back {
        state.manager.on = false;
        state.manager.back = false;
        told(state);
    }
}

/// Where a control the showcase points at sits, in design px, by the name it
/// knows it as: a tab by its id, or one of the Projects tab's verbs; `None`
/// before it has drawn.
pub fn spot(state: editor::State, name: str) -> Spot? {
    let node = if name == "new" {
        scene::get_node(TOOLS() + "/New")
    } else {
        tab_node(name)
    };
    let rect = if node.is_valid() { ui::widget_rect(node) } else { nil };
    if rect.is_none() {
        return nil;
    }
    let box = rect.unwrap();
    Spot { x: box.x + box.width / 2.0, y: box.y + box.height / 2.0 }
}

// The tab strip's node for the page `id`, in the order `tabs` lists them.
fn tab_node(id: str) -> Node {
    let host = scene::get_node(TABS_NODE());
    if !host.is_valid() {
        return nil;
    }
    let ids = tabs();
    let kids = host.children();
    for index in 0..ids.len() {
        if ids[index][0] == id && index < kids.len() {
            return kids[index];
        }
    }
    nil
}

/// Whether the screen has the window. A run with no project is the screen
/// whether or not anybody asked for it: there is nothing else to hold.
pub fn showing(state: editor::State) -> bool {
    state.manager.on || state.game_root == ""
}

fn tabs() -> [[str]] {
    // A tab installs no engine and fetches its examples from the page it runs
    // in, so the screen there is the list of what this browser keeps.
    if in_tab() {
        return [["projects", "Projects"]];
    }
    // `return`, because a block followed by `[` is an index in Rune.
    return [["projects", "Projects"], ["examples", "Examples"], ["forge", "On Forge"], ["engine", "Engine"]];
}

// One column under this, two above it.
fn narrow(col: float) -> bool {
    col < 600.0
}

fn refresh(state: &mut editor::State) {
    if state.manager.read {
        return;
    }
    state.manager.read = true;
    state.manager.recent = project::recent();
    if state.manager.parent == "" {
        state.manager.parent = project::home();
    }
    if state.manager.follow == "" {
        let mine = util::obj(release::installed()).get("channel").as_str();
        state.manager.follow = if mine == "" { "nightly" } else { mine };
    }
}

const GROUND: str = "Editor/Manager";

const SHELL: str = "Editor/Shell";

fn HEAD_NODE() -> str {
    GROUND + "/ManagerHead"
}

fn TABS_NODE() -> str {
    GROUND + "/ManagerTabs"
}

fn BODY() -> str {
    GROUND + "/ManagerBody"
}

fn NOTE() -> str {
    GROUND + "/ManagerBody/Note"
}

fn PROGRESS() -> str {
    GROUND + "/ManagerBody/Progress"
}

fn TOOLS() -> str {
    GROUND + "/ManagerBody/Tools"
}

fn PAGE() -> str {
    GROUND + "/ManagerBody/Scroll/Page"
}

/// Fill the start screen: its head, its tabs and the page under them, from
/// what this machine has opened, the examples and the release feed. What
/// its script asks for on `manager_changed` and when it was resized.
pub fn fill(state: &mut editor::State) {
    if !state.manager.on {
        util::hide(GROUND);
        cover(state, false);
        return;
    }
    refresh(state);
    let tokens = state.theme;
    // The screen is the window: a project's own widgets are not behind this.
    ui::set_widget_layer(false, 0.0, 0.0, 0.0, 0.0);
    util::fill(GROUND, map().with("visible", true));
    cover(state, true);
    pool::strip(state, HEAD_NODE(), head_controls(state, tokens));
    pool::strip(state, TABS_NODE(), tab_controls(state));
    let col = page_w();
    head_note(state, tokens);
    tools(state);
    let specs = if state.manager.tab == "engine" {
        engine_specs(state, tokens, col)
    } else if state.manager.tab == "examples" {
        examples_specs(state, tokens, col)
    } else if state.manager.tab == "forge" {
        forge_specs(state, tokens, col)
    } else {
        projects_specs(state, tokens, col)
    };
    pool::sync(state, PAGE(), specs, 0.0, false);
}

// The page's width, as it was laid out: the widest the screen draws, whatever
// the window is, since a list across a monitor is a list nobody can read.
fn page_w() -> float {
    let rect = ui::widget_rect(scene::get_node(BODY()));
    if rect.is_none() || rect.unwrap().width <= 0.0 {
        COLUMN
    } else {
        util::min(rect.unwrap().width, COLUMN)
    }
}

/// The Projects tab's filter, as it is typed.
pub fn set_filter(state: &mut editor::State, text: str) {
    state.manager.filter = text;
    told(state);
}

/// The Projects tab's verbs, by the name of the button pressed.
pub fn verb(state: &mut editor::State, name: str) {
    if name == "New" {
        window::show(state, NEW_SHEET);
        return;
    }
    let picked = project::pick_directory();
    if picked.is_none() {
        return;
    }
    go(state, picked.unwrap());
    told(state);
}

// What the head says under itself: a note or a failure, and a job's bar.
fn head_note(state: editor::State, tokens: any) {
    let said = if state.manager.failed != "" { state.manager.failed } else { state.manager.note };
    util::fill(NOTE(), map()
        .with("visible", said != "")
        .with("text", said)
        .with("text_color", if state.manager.failed != "" { tokens.get("warning_text") } else { tokens.get("text_subtle") }));
    let controls = if installing(state) {
        progress_controls(state)
    } else {
        []
    };
    util::fill(PROGRESS(), map().with("visible", controls.len() > 0));
    pool::strip(state, PROGRESS(), controls);
}

// The filter and the three verbs, up on the Projects tab. A tab has no folder
// picker and nowhere to write a template: the page it runs in is what starts
// a project there, and this screen reopens one.
fn tools(state: editor::State) {
    let up = state.manager.tab == "projects";
    let acting = !in_tab();
    util::fill(TOOLS(), map().with("visible", up));
    util::fill(TOOLS() + "/Filter", map().with("text", state.manager.filter));
    util::fill(TOOLS() + "/Open", map()
        .with("visible", acting && !state.touchscreen)
        .with("icon", icons::panel("assets")));
    util::fill(TOOLS() + "/New", map().with("visible", acting).with("icon", icons::ui("add")));
}

fn say(text: str, ink: str) -> any {
    map()
        .with("full", true)
        .with("height", 0)
        .with("controls", [
            map()
                .with("kind", "label")
                .with("role", "text_code_quiet")
                .with("font_size", 11)
                .with("grow", 1)
                .with("wrap", true)
                .with("text", text)
                .with("text_color", ink),
        ])
}

fn rule() -> any {
    map()
        .with("full", true)
        .with("height", 1)
        .with("controls", [map().with("kind", "separator").with("grow", 1)])
}

fn projects_specs(state: editor::State, tokens: any, col: float) -> [any] {
    let rows: [any] = shown(state);
    if rows.len() == 0 {
        let empty = if in_tab() {
            "This browser keeps no projects yet. The page opens one, and it is listed here after that."
        } else {
            "Nothing opened on this machine yet. Start from an example, or make one."
        };
        let why = if state.manager.recent.len() == 0 { empty } else { "No project matches that filter." };
        let none = [say(why, tokens.get("text_subtle").as_str())];
        return none;
    }
    let out: [any] = [];
    for row in rows {
        out.push(project_spec(state, tokens, col, util::obj(row)));
        out.push(rule());
    }
    out
}

// Two lines: the name a click opens, and the folder under it. What a row says
// about itself, when and with which engine, sits at the right edge, and a
// phone shows when it was opened and nothing else.
fn project_spec(state: editor::State, tokens: any, col: float, row: any) -> any {
    let here = row.get("path");
    let exists = row.get("exists");
    let gone = if exists.is_nil() { true } else { exists.as_bool() } != true;
    let built = row.get("version").as_str();
    let line = util::max(style::row_h(state), 28.0);
    let controls: [any] = [
        // The engine's mark: a project keeps its own icon, and none of them
        // is open, so the row wears the editor's.
        map()
            .with("kind", "panel")
            .with("role", "sheet_logo")
            .with("padding", 2)
            .with("controls", [map().with("kind", "image").with("image", LOGO).with("width", 20)]),
        map()
            .with("kind", "column")
            .with("padding", 0)
            .with("controls", [
                map()
                    .with("kind", "button")
                    .with("role", "item_list")
                    .with("text", row.get("name"))
                    .with("height", line)
                    .with("text_align", "start")
                    .with("icon", if gone { icons::panel("problems") } else { "" })
                    .with("tooltip", here)
                    .with("text_color", if gone { tokens.get("text_subtle") } else { tokens.get("text_default") })
                    .with("on", "handle")
                    .with("data", map().with("fn", on_project_pressed).with("gone", gone).with("here", here)),
                map()
                    .with("kind", "label")
                    .with("role", "text_code_quiet")
                    .with("font_size", 11)
                    .with("truncate", true)
                    .with("text", if gone { here.as_str() + "  ·  disk not mounted" } else { here }),
            ])
            .with("grow", 1),
        map()
            .with("kind", "label")
            .with("role", "text_code_quiet")
            .with("padding", 0)
            .with("font_size", 11)
            .with("text", row.get("when").as_str()),
    ];
    if built != "" && !narrow(col) {
        controls.push(map().with("kind", "label").with("role", "text_code_quiet").with("font_size", 11).with("text", built));
    }
    controls.push(map()
        .with("kind", "button")
        .with("role", "icon_action")
        .with("text", "")
        .with("icon", icons::ui("close"))
        .with("tooltip", "Forget this project")
        .with("on", "handle")
        .with("data", map().with("fn", on_forget_pressed).with("here", here)));
    map()
        .with("full", true)
        .with("height", util::max(line + 22.0, 56.0))
        .with("slot_role", "layout_actions")
        .with("controls", controls)
}

fn on_project_pressed(state: &mut editor::State, data: any, _value: any) {
    let gone: bool = data.gone;
    let here: any = data.here;
    if !gone {
        go(state, here.as_str());
    }
}

fn on_forget_pressed(state: &mut editor::State, data: any, _value: any) {
    let here: any = data.here;
    project::forget(here.as_str());
    state.manager.read = false;
    told(state);
}

fn examples_specs(state: editor::State, tokens: any, col: float) -> [any] {
    let rows = util::vec(project::examples());
    if rows.len() == 0 {
        let none = [say("No examples ship beside this build.", tokens.get("text_subtle").as_str())];
        return none;
    }
    let across = if narrow(col) { 1 } else if col < 760.0 { 2 } else { 3 };
    // Floored: three cards and two seams have to add up to the column, and a
    // third of a pixel each puts the last one past its edge.
    let card_w = math::floor((col - (across - 1).as_float() * SEAM) / across.as_float());
    let cover_h = math::floor(card_w / COVER_ASPECT);
    let out: [any] = [];
    let start = 0;
    while start < rows.len() {
        let cards: [any] = [];
        let column = 0;
        while column < across && start + column < rows.len() {
            cards.push(example_card(state, tokens, card_w, cover_h, util::obj(rows.at(start + column))));
            column += 1;
        }
        out.push(map()
            .with("full", true)
            .with("height", cover_h + 54.0)
            .with("controls", [
                map().with("kind", "row").with("gap", [SEAM, SEAM]).with("controls", cards),
            ]));
        start += across;
    }
    out.push(say("Opens a copy in your projects folder, so the example stays as it shipped.", tokens.get("text_subtle").as_str()));
    out
}

// The picture, the name and the line under it, on a panel the whole of which
// a click opens a copy of: a button with nothing in it laid over the card.
fn example_card(state: editor::State, tokens: any, width: float, cover_h: float, row: any) -> any {
    let id = row.get("id");
    let cover = row.get("cover").as_str();
    let picture = if cover != "" {
        map()
            .with("kind", "image")
            .with("image", cover)
            .with("width", width)
            .with("height", cover_h)
            .with("fit", "cover")
            .with("corner_radius", 12)
            .with("truncate", false)
    } else {
        // No picture shipped: the engine's own mark, so the card still reads
        // as a project rather than a blank.
        map()
            .with("kind", "row")
            .with("width", width)
            .with("height", cover_h)
            .with("corner_radius", 0)
            .with("justify", "center")
            .with("align_items", "center")
            .with("controls", [
                map().with("kind", "panel").with("role", "sheet_logo").with("controls", [map().with("kind", "image").with("image", LOGO).with("width", 36)]),
            ])
            .with("truncate", false)
    };
    map()
        .with("kind", "panel")
        .with("fill", tokens.get("bg_panel"))
        .with("corner_radius", 12)
        .with("padding", 0)
        .with("width", width)
        .with("gap", [0, 2])
        .with("controls", [
            picture,
            map()
                .with("kind", "label")
                .with("corner_radius", 0)
                .with("role", "text_title")
                .with("font_size", 13)
                .with("text", row.get("name").as_str())
                .with("padding", [12, 4, 12, 0])
                .with("truncate", false),
            map()
                .with("kind", "label")
                .with("corner_radius", 0)
                .with("role", "text_code_quiet")
                .with("font_size", 11)
                .with("text", row.get("note").as_str())
                .with("padding", [12, 0, 12, 8])
                .with("truncate", true),
            map()
                .with("kind", "button")
                .with("role", "chip_quiet")
                .with("text", "")
                .with("absolute", true)
                .with("inset", [0.0, 0.0, 0.0, 0.0])
                .with("tooltip", "Copy into " + state.manager.parent)
                .with("on", "handle")
                .with("data", map().with("fn", on_example_pressed).with("id", id)),
        ])
}

fn on_example_pressed(state: &mut editor::State, data: any, _value: any) {
    let id: any = data.id;
    open_example(state, id.as_str());
}

// Public projects on Forge, one row each, a click opening a copy in the
// projects folder as an example does. The first look asks Forge.
fn forge_specs(state: &mut editor::State, tokens: any, col: float) -> [any] {
    if !state.manager.forge_asked {
        state.manager.forge_asked = forge::search("", "");
    }
    let out: [any] = [];
    if state.manager.copying != "" {
        out.push(say("Copying {state.manager.copying} into {state.manager.parent}", tokens.get("text_subtle").as_str()));
    }
    if state.manager.forge.len() == 0 {
        out.push(say(if state.manager.forge_asked { "Asking " + forge::url() } else { "No public projects yet." }, tokens.get("text_subtle").as_str()));
        return out;
    }
    for row in state.manager.forge {
        let project = row.get("project").as_str();
        let tags = "";
        for tag in util::vec(row.get("tags")) {
            tags = if tags == "" { tag.as_str() } else { tags + ", " + tag.as_str() };
        }
        let note = row.get("description").as_str();
        out.push(map()
            .with("full", true)
            .with("height", 52.0)
            .with("controls", [
                map()
                    .with("kind", "panel")
                    .with("fill", tokens.get("bg_panel"))
                    .with("corner_radius", 10)
                    .with("padding", [12, 6, 12, 6])
                    .with("width", col)
                    .with("gap", [0, 2])
                    .with("controls", [
                        map().with("kind", "label").with("role", "text_title").with("font_size", 13).with("text", project),
                        map().with("kind", "label").with("role", "text_code_quiet").with("font_size", 11).with("truncate", true)
                            .with("text", if tags == "" { note } else { note + " · " + tags }),
                        map()
                            .with("kind", "button")
                            .with("role", "chip_quiet")
                            .with("text", "")
                            .with("absolute", true)
                            .with("inset", [0.0, 0.0, 0.0, 0.0])
                            .with("tooltip", "Copy into " + state.manager.parent)
                            .with("on", "handle")
                            .with("data", map().with("fn", copy_forge_project).with("project", project)),
                    ]),
            ]));
    }
    out.push(say("Opens a copy in your projects folder; the project on Forge stays as it is.", tokens.get("text_subtle").as_str()));
    out
}

fn copy_forge_project(state: &mut editor::State, data: any, _value: any) {
    let project = data.get("project").as_str();
    if state.manager.copying == "" && forge::copy(project, state.manager.parent) {
        state.manager.copying = project;
        told(state);
    }
}

/// A Forge job reported: the projects a search found, or a copy made.
pub fn forge_heard(state: &mut editor::State, event: any) {
    let kind = event.get("kind").as_str();
    if kind == "listed" {
        state.manager.forge = util::vec(event.get("rows"));
    } else if kind == "copied" {
        state.manager.copying = "";
        go(state, event.get("path").as_str());
        return;
    } else if kind == "failed" && (event.get("job").as_str() == "copy" || event.get("job").as_str() == "search") {
        state.manager.copying = "";
        state.manager.failed = event.get("message").as_str();
    } else {
        return;
    }
    told(state);
}

/// Copy an example into the projects folder and open the copy.
fn open_example(state: &mut editor::State, id: str) {
    let made = util::obj(project::copy_example(id, state.manager.parent));
    let failed = made.get("error");
    if !failed.is_nil() {
        let why = failed;
        state.manager.failed = why.as_str();
        told(state);
        return;
    }
    go(state, made.get("path").as_str());
}

// What this build is, which line it follows, and every release the project
// has published. The same code `balaur update` runs, so the screen and the
// command cannot disagree.
fn engine_specs(state: &mut editor::State, tokens: any, col: float) -> [any] {
    if !state.manager.asked {
        check(state);
    }
    let mine = util::obj(release::installed());
    let row_height = util::max(style::row_h(state), 30.0);
    let newest = newest_on(state, state.manager.follow);
    let head: [any] = [
        map()
            .with("kind", "column")
            .with("grow", 1)
            .with("controls", [
                map().with("kind", "label").with("role", "text_title").with("text", "Balaur " + mine.get("version").as_str()),
                map().with("kind", "label").with("role", "text_code_quiet").with("text", build_line(mine)).with("font_size", 11),
            ]),
    ];
    if !narrow(col) {
        let fresh = newest.get("order").as_str() == "newer";
        head.push(map()
            .with("kind", "label")
            .with("role", "text_code_quiet")
            .with("font_size", 11)
            .with("text", standing(state, state.manager.follow))
            .with("text_color", (if fresh { tokens.get("success_text") } else { tokens.get("text_subtle") }).as_str()));
    }
    head.push(map()
        .with("kind", "button")
        .with("role", "action_form")
        .with("icon", icons::ui("reset"))
        .with("text", if state.manager.reading { "Checking" } else { "Check" })
        .with("on", "handle")
        .with("data", map().with("fn", on_check_pressed)));
    let out = [map().with("full", true).with("height", 44).with("slot_role", "layout_actions").with("controls", head)];
    if mine.get("held").as_str() != "" {
        out.push(say(mine.get("held").as_str(), tokens.get("text_subtle").as_str()));
    }
    let lines: [any] = [map().with("kind", "label").with("role", "text_caption").with("text", "Follow").with("width", 60)];
    for name in util::vec(release::channels()) {
        // Bound afresh: a closure made in a loop captures the binding.
        let line = name;
        lines.push(map()
            .with("kind", "button")
            .with("role", "chip")
            .with("text", line)
            .with("checked", state.manager.follow == line.as_str())
            .with("on", "handle")
            .with("data", map().with("fn", on_line_pressed).with("line", line)));
    }
    out.push(map().with("full", true).with("height", row_height + 6.0).with("slot_role", "layout_actions").with("controls", lines));
    release_specs(state, tokens, row_height, mine, out);
    out
}

fn on_check_pressed(state: &mut editor::State, data: any, _value: any) {
    check(state);
}

fn on_line_pressed(state: &mut editor::State, data: any, _value: any) {
    let line: any = data.line;
    state.manager.follow = line.as_str();
    told(state);
}

fn release_specs(state: editor::State, tokens: any, row_height: float, mine: any, out: [any]) {
    let rows: [any] = [];
    for entry in state.manager.releases {
        let row = util::obj(entry);
        if row.get("channel").as_str() == state.manager.follow {
            rows.push(row);
        }
    }
    if rows.len() == 0 {
        let empty = if state.manager.reading { "Reading the release feed." } else { "Nothing published on this line yet." };
        out.push(say(empty, tokens.get("text_subtle").as_str()));
    }
    for row in rows {
        let current = row.get("current").as_bool() == true;
        let controls: [any] = [
            map()
                .with("kind", "column")
                .with("grow", 1)
                .with("controls", [
                    map()
                        .with("kind", "label")
                        .with("role", "text_title")
                        .with("font_size", 13)
                        .with("text", row.get("id").as_str())
                        .with("text_color", (if current { tokens.get("primary_text") } else { tokens.get("text_default") }).as_str()),
                    map().with("kind", "label").with("role", "text_code_quiet").with("font_size", 11).with("text", row.get("when").as_str()),
                ]),
        ];
        let press = press_spec(state, row, mine);
        if press.kind() == "map" {
            controls.push(press);
        }
        out.push(map().with("full", true).with("height", row_height + 14.0).with("slot_role", "layout_actions").with("controls", controls));
        out.push(rule());
    }
    // An install that cannot replace itself has nothing to name a release for.
    if mine.get("held").as_str() != "" || installing(state) {
        return;
    }
    out.push(map()
        .with("full", false)
        .with("height", row_height)
        .with("controls", [
            map()
                .with("kind", "text_field")
                .with("role", "input_form")
                .with("grow", 1)
                .with("text", state.manager.tag)
                .with("placeholder", "v0.2.0")
                .with("on", "handle")
                .with("data", map().with("fn", on_tag_typed)),
            map()
                .with("kind", "button")
                .with("role", "action_form")
                .with("text", "Install")
                .with("min_width", 88)
                .with("on", "handle")
                .with("data", map().with("fn", on_install_typed_pressed)),
        ])
        .with("label", "Or a release by name"));
}

fn on_tag_typed(state: &mut editor::State, data: any, text: any) {
    state.manager.tag = text.as_str();
}

fn on_install_typed_pressed(state: &mut editor::State, data: any, _value: any) {
    if state.manager.tag == "" {
        state.manager.failed = "type a release tag first, like v0.2.0";
        told(state);
        return;
    }
    put(state, "", state.manager.tag);
}

/// Hide the shell while the screen is up and show it again after: under the
/// screen its docks would still draw a project that is not open.
pub fn cover(state: &mut editor::State, up: bool) {
    if state.manager.covering != up {
        state.manager.covering = up;
        util::fill(SHELL, map().with("visible", !up));
    }
}

/// The head strip: the mark, the name, the version, and the way back.
fn head_controls(state: editor::State, tokens: any) -> [any] {
    let ink = if tokens.get("dark").as_bool() { LOGO_DARK } else { LOGO };
    let out: [any] = [
        map().with("kind", "image").with("role", "layout_mark").with("image", ink),
        map().with("kind", "label").with("role", "text_title").with("text", "Balaur"),
        map().with("kind", "label").with("role", "text_caption").with("text", project::version()),
        map().with("kind", "row").with("grow", 1),
    ];
    if state.manager.back {
        out.push(map()
            .with("kind", "button")
            .with("role", "action_manager")
            .with("tooltip", "Esc")
            .with("text", "Back to " + state.game_name)
            .with("on", "handle")
            .with("data", map().with("fn", on_back_pressed)));
    }
    out
}

fn on_back_pressed(state: &mut editor::State, data: any, _value: any) {
    close(state);
}

// The shell's own tab shape: a pill per page, the open one filled.
fn tab_controls(state: editor::State) -> [any] {
    let out: [any] = [];
    for row in tabs() {
        // Bound afresh: a closure made in a loop captures the binding.
        let id = row[0];
        out.push(map()
            .with("kind", "button")
            .with("text", row[1])
            .with("role", "tab_manager")
            .with("checked", state.manager.tab == id)
            .with("on", "handle")
            .with("data", map().with("fn", on_page_picked).with("id", id)));
    }
    out
}

fn on_page_picked(state: &mut editor::State, data: any, _value: any) {
    let id: str = data.id;
    state.manager.tab = id;
}

fn shown(state: editor::State) -> [any] {
    let query = state.manager.filter.to_lower();
    if query == "" {
        return state.manager.recent;
    }
    let out: [any] = [];
    for entry in state.manager.recent {
        let row = util::obj(entry);
        let hay = (row.get("name").as_str() + " " + row.get("path").as_str()).to_lower();
        if hay.contains(query) {
            out.push(entry);
        }
    }
    out
}

/// The build in one line: its id and the line it follows, or where it came
/// from when it came from no release.
pub fn build_line(mine: any) -> str {
    if mine.get("source").as_bool() == true {
        return "built from a checkout";
    }
    mine.get("id").as_str() + "  ·  following " + mine.get("channel").as_str()
}

/// Ask the feed what every line holds, unless a read is already out. The
/// answer arrives in `heard`.
pub fn check(state: &mut editor::State) {
    if state.manager.reading {
        return;
    }
    state.manager.asked = true;
    state.manager.reading = release::check();
    told(state);
}

// The start screen and the About sheet both show what a check and an install
// keep, so each moving says so to both.
fn told(state: &mut editor::State) {
    window::changed(state);
    signals::changed(state, "manager");
}

/// Whether an install is in flight.
pub fn installing(state: editor::State) -> bool {
    state.manager.installing.tag != ""
}

fn no_install() -> Installing {
    Installing { tag: "", done: 0, total: 0, unpacking: false }
}

/// A report on a check or an install. The start screen and the About sheet
/// both read what this keeps.
pub fn heard(state: &mut editor::State, report: any) {
    let ev = util::obj(report);
    let kind = ev.kind.as_str();
    if kind == "listed" {
        let rows: [any] = [];
        for row in util::vec(ev.rows) {
            rows.push(row);
        }
        state.manager.releases = rows;
        state.manager.reading = false;
    } else if kind == "downloading" {
        state.manager.installing = Installing {
            tag: ev.get("tag").as_str(),
            done: ev.get("done").as_int(),
            total: ev.get("total").as_int(),
            unpacking: false,
        };
    } else if kind == "unpacking" {
        state.manager.installing.unpacking = true;
    } else if kind == "installed" {
        state.manager.installing = no_install();
        state.manager.failed = "";
        state.manager.note = ev.get("note").as_str();
        log::info(state.manager.note);
    } else if kind == "failed" {
        if ev.get("job").as_str() == "install" {
            state.manager.installing = no_install();
        } else {
            state.manager.reading = false;
        }
        state.manager.failed = ev.get("message").as_str();
    }
    told(state);
}

/// The newest release on a line, or an empty table when it holds none.
pub fn newest_on(state: editor::State, channel: str) -> any {
    for entry in state.manager.releases {
        let row = util::obj(entry);
        if row.get("channel").as_str() == channel {
            return row;
        }
    }
    map()
}

/// What the newest release on a line means for this build, in a few words.
pub fn standing(state: editor::State, channel: str) -> str {
    let newest = newest_on(state, channel);
    let id = newest.get("id").as_str();
    if id == "" {
        return if state.manager.reading { "checking" } else { "no release on this line" };
    }
    let order = newest.get("order").as_str();
    if order == "same" {
        return "up to date";
    }
    if order == "newer" {
        return id + " is newer";
    }
    if order == "older" {
        return id + " is older than this build";
    }
    id + " is published"
}

/// The verb a release row carries, as a control: what `row_press` draws.
/// `()` where there is none: an install already running, or a held build.
pub fn press_spec(state: editor::State, row: any, mine: any) -> any {
    if row.get("current").as_bool() == true {
        return map().with("kind", "label").with("role", "text_code_quiet").with("font_size", 11).with("text", "installed");
    }
    if installing(state) {
        return nil;
    }
    let download = row.get("download").as_str();
    if download != "" {
        return map()
            .with("kind", "button")
            .with("role", "action_form")
            .with("text", "Download")
            .with("min_width", 88)
            .with("on", "handle")
            .with("data", map().with("fn", on_download_pressed).with("download", download));
    }
    if mine.get("held").as_str() != "" {
        return nil;
    }
    let tag = row.get("tag").as_str();
    map()
        .with("kind", "button")
        .with("role", "action_form")
        .with("min_width", 88)
        .with("text", if row.get("order").as_str() == "older" { "Downgrade" } else { "Install" })
        .with("on", "handle")
        .with("data", map().with("fn", on_install_row_pressed).with("tag", tag))
}

fn on_download_pressed(state: &mut editor::State, data: any, _value: any) {
    let download: str = data.download;
    engine::open_url(download);
}

fn on_install_row_pressed(state: &mut editor::State, data: any, _value: any) {
    let tag: str = data.tag;
    put(state, "", tag);
}

/// How far an install has got, as a row of controls: the megabytes as they
/// arrive, then the unpack, and a bar for it.
pub fn progress_controls(state: editor::State) -> [any] {
    let job = state.manager.installing;
    let said = if job.unpacking {
        "unpacking " + job.tag
    } else if job.total > 0 {
        "downloading {job.tag}  ·  {job.done / MB} of {job.total / MB} MB"
    } else {
        "downloading {job.tag}  ·  {job.done / MB} MB"
    };
    let part = if job.unpacking {
        1.0
    } else if job.total > 0 {
        job.done.as_float() / job.total.as_float()
    } else {
        0.0
    };
    [
        map().with("kind", "label").with("role", "text_code_quiet").with("font_size", 11).with("text", said).with("value", 0.0),
        map().with("kind", "progress_bar").with("width", 200).with("height", 4).with("value", part),
    ]
}

// A new project is named in the shell's own sheet, which is what Settings is
// and what a phone needs: one screen at a time.
pub fn new_fill(state: &mut editor::State) {
    let hosts: any = window::sheet_form(state, NEW_SHEET, "New project", []);
    if util::is_nil(hosts) {
        return;
    }
    // The sheet can be up before the screen under it has read where a new
    // project goes.
    if state.manager.parent == "" {
        state.manager.parent = project::home();
    }
    let ids: [any] = [];
    for row in util::vec(project::templates()) {
        ids.push(util::obj(row).get("id"));
    }
    if ids.len() == 0 {
        ids.push("empty");
    }
    let row_height = util::max(style::row_h(state), 30.0);
    let specs = [
        map()
            .with("full", false)
            .with("height", row_height)
            .with("controls", [
                map()
                    .with("kind", "text_field")
                    .with("role", "input_form")
                    .with("grow", 1)
                    .with("text", state.manager.name)
                    .with("placeholder", "my-game")
                    .with("on", "handle")
                    .with("data", map().with("fn", on_name_typed)),
            ])
            .with("label", "name"),
        map()
            .with("full", false)
            .with("height", row_height)
            .with("controls", [
                map()
                    .with("kind", "dropdown")
                    .with("role", "choice_form")
                    .with("grow", 1)
                    .with("text", state.manager.template)
                    .with("options", ids)
                    .with("on", "handle")
                    .with("data", map().with("fn", on_template_picked)),
            ])
            .with("label", "from"),
        map()
            .with("full", false)
            .with("height", row_height)
            .with("controls", [
                map()
                    .with("kind", "label")
                    .with("role", "text_code_quiet")
                    .with("font_size", 11)
                    .with("grow", 1)
                    .with("truncate", true)
                    .with("text", state.manager.parent),
            ])
            .with("label", "in"),
    ];
    if state.manager.failed != "" {
        specs.push(map()
            .with("full", true)
            .with("height", 0)
            .with("controls", [
                map()
                    .with("kind", "label")
                    .with("role", "note_warning")
                    .with("grow", 1)
                    .with("wrap", true)
                    .with("text", state.manager.failed),
            ]));
    }
    specs.push(map()
        .with("full", true)
        .with("height", row_height)
        .with("slot_role", "layout_actions")
        .with("controls", [
            map().with("kind", "row").with("grow", 1),
            map()
                .with("kind", "button")
                .with("role", "action_form_primary")
                .with("text", "Create")
                .with("min_width", 140)
                .with("on", "handle")
                .with("data", map().with("fn", on_create_pressed)),
        ]));
    pool::sync(state, hosts.get("form"), specs, 72.0, false);
}

fn on_name_typed(state: &mut editor::State, data: any, text: any) {
    state.manager.name = text.as_str();
}

fn on_template_picked(state: &mut editor::State, data: any, picked: any) {
    state.manager.template = picked.as_str();
}

fn on_create_pressed(state: &mut editor::State, data: any, _value: any) {
    create(state);
}

fn create(state: &mut editor::State) {
    let name = if state.manager.name == "" { "my-game" } else { state.manager.name };
    let path = state.manager.parent + "/" + name;
    let made = util::obj(project::create(path, state.manager.template));
    let failed = made.get("error");
    if !failed.is_nil() {
        let why = failed;
        state.manager.failed = why.as_str();
        window::changed(state);
        return;
    }
    state.manager.failed = "";
    go(state, path);
}

// Replace this install, on a thread; `heard` follows it. The reader pressed
// it, so a downgrade is allowed: the press said Downgrade where it is one.
pub fn put(state: &mut editor::State, channel: str, tag: str) {
    if installing(state) {
        return;
    }
    if !release::install(channel, tag, map().with("allow_downgrade", true)) {
        state.manager.failed = "nothing installs while a recording plays";
        return;
    }
    let named = if tag == "" { channel } else { tag };
    state.manager.failed = "";
    state.manager.note = "installing " + named;
    state.manager.installing = Installing { tag: named, done: 0, total: 0, unpacking: false };
    told(state);
}

/// Open a project: the module remembers it, starts the editor on it and asks
/// this process to quit.
pub fn go(state: &mut editor::State, path: str) {
    // Opening quits this process, which would leave an install half swapped in.
    if installing(state) {
        state.manager.failed = "wait for the install to finish";
        told(state);
        return;
    }
    let answer = util::obj(project::open(path));
    let failed = answer.get("error");
    if !failed.is_nil() {
        let why = failed;
        state.manager.failed = why.as_str();
        told(state);
        return;
    }
    state.manager.failed = "";
}
