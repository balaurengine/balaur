// The Import panel: how the selected file is read, written to the sidecar
// beside it. Godot's Import dock, over `balaur_core::import`'s two sources —
// `[import.<kind>]` in project.toml, then `<file>.toml`.

use crate::style;
use crate::util;

// The keys each kind offers, in the order they are drawn. `fallback` is what
// the engine assumes when neither the project nor the sidecar says.

// The per-axis keys (`mag_filter`, `repeat_u`, `mipmap_filter` and the rest)
// are written by hand: a row apiece would double the panel.
const ROWS = #{
    texture: [
        #{ key: "filter", kind: "enum", options: ["linear", "nearest"], fallback: "linear",
           help: "nearest keeps pixel art crisp when it is magnified" },
        #{ key: "repeat", kind: "enum", options: ["clamp", "repeat", "mirror"], fallback: "clamp",
           help: "what a coordinate past the edge reads; repeat tiles, mirror tiles without a seam" },
        #{ key: "mipmaps", kind: "bool", fallback: false,
           help: "smaller copies for a texture drawn small, which stops it shimmering" },
        #{ key: "anisotropy", kind: "count", options: ["1", "2", "4", "8", "16"], fallback: 1,
           help: "samples per fetch on a surface seen edge-on; needs a linear filter" },
        #{ key: "premultiply", kind: "bool", fallback: false,
           help: "colour scaled by alpha at upload, so a soft edge blends without a dark fringe" },
        #{ key: "srgb", kind: "bool", fallback: true,
           help: "off for a normal map or a mask, which carry data rather than colour" },
    ],
};

// What each `count` option writes: the sidecar holds a number, and a dropdown
// hands back the text beside it.
const COUNTS = #{ "1": 1, "2": 2, "4": 4, "8": 8, "16": 16 };

// Extensions the panel claims, matching `balaur_core::import::kind_of`. A
// picture in another format is not a texture the engine reads, so offering
// its settings would write a file nothing opens.
const KINDS = #{ png: "texture", webp: "texture" };

pub fn kind_of(rel) {
    let lower = rel.to_lowercase();
    let found = "";
    for (extension, kind) in KINDS.iter() {
        if lower.ends_with("." + extension) {
            found = kind;
        }
    }
    found
}

pub fn sidecar_of(rel) {
    rel + ".toml"
}

fn full(S, rel) {
    S.game_root + "/" + rel
}

// The sidecar's own table, empty when there is none. A file that does not
// parse is reported once and treated as empty, so a typo cannot wedge the
// panel.
pub fn sidecar(S, rel) {
    table_at(full(S, sidecar_of(rel)))
}

// The settings held in one sidecar file, by absolute path.
fn table_at(path) {
    if !fs::exists(path) {
        return #{};
    }
    let text = fs::read(path);
    if !(text is String) {
        return #{};
    }
    let (ok, value) = script::attempt(|| toml::parse(text));
    if !ok {
        log::warn(format!("{} is not a settings file", path));
        return #{};
    }
    util::obj(value)
}

// What `project.toml` says for this kind, which the sidecar overrides.
fn project_default(S, kind, key) {
    let manifest = toml::parse(fs::read(S.game_root + "/project.toml"));
    let table = util::obj(util::obj(manifest).get("import").unwrap_or(#{}));
    util::obj(table.get(kind).unwrap_or(#{})).get(key)
}

// Write one key, or drop it when `value` is nil. An empty sidecar is removed
// rather than left behind: a file of no settings is noise in a project.
pub fn write(S, rel, key, value) {
    // `insert` takes the key and the value, so everything read from them is
    // read before the write, and the log goes out first.
    let cleared = value is Tuple;
    let what = if cleared { "cleared" } else { "set" };
    let path = full(S, sidecar_of(rel));
    log::info(format!("import: {} {} for {}", key, what, rel));
    let table = table_at(path);
    if cleared {
        table.remove(key);
    } else {
        table.insert(key, value);
    }
    if table.len() == 0 {
        if fs::exists(path) {
            fs::remove(path);
        }
    } else {
        fs::write(path, toml::encode(table));
    }
    // The renderer uploads a texture under a name built from its settings, so
    // the change shows without a restart.
    assets::invalidate();
}

// One row: the label, the control, and where the value came from.
fn row(S, k, rel, kind, spec) {
    let key = spec.key;
    let own = sidecar(S, rel).get(key);
    let inherited = project_default(S, kind, key);
    // Read before either Option is unwrapped: unwrapping takes the value.
    let has_own = own.is_some();
    let source = if inherited.is_some() { "project" } else { "default" };
    let effective = spec.fallback;
    if let Some(value) = inherited {
        effective = value;
    }
    if let Some(value) = own {
        effective = value;
    }
    let control = if spec.kind == "bool" {
        #{
            kind: "check", text: "", tooltip: spec.help,
            checked: effective == true,
            on: |on| { write(S, rel, key, on); },
        }
    } else if spec.kind == "count" {
        #{
            kind: "dropdown", grow: 1, tooltip: spec.help,
            text: format!("{}", if effective is i64 { effective } else { spec.fallback }),
            options: spec.options,
            on: |picked| { write(S, rel, key, COUNTS.get(picked).unwrap_or(spec.fallback)); },
        }
    } else {
        #{
            kind: "dropdown", grow: 1, tooltip: spec.help,
            text: if effective is String { effective } else { spec.fallback },
            options: spec.options,
            on: |picked| { write(S, rel, key, picked); },
        }
    };
    // What the value is following, or the way back to following it.
    let note = if has_own {
        #{
            kind: "button", text: "clear", role: "chip", width: 52,
            tooltip: "Drop this key and follow the project again",
            on: |_| { write(S, rel, key, ()); },
        }
    } else {
        #{ kind: "label", text: source, role: "meta", width: 52 }
    };
    crate::inspector::form_row(S, key, [control, note]);
}

// The rows the selected file offers, empty when nothing is selected or the
// file is one no importer claims.
fn specs_for(S) {
    let rel = S.assets.sel;
    if rel == "" {
        return [];
    }
    let kind = kind_of(rel);
    if kind == "" {
        return [];
    }
    ROWS.get(kind).unwrap_or([])
}

// The Import tab, for whatever the Assets dock has selected. Empty until a
// file is picked, the way the Inspector is empty without a node.
pub fn panel(S, k) {
    let rel = S.assets.sel;
    let specs = specs_for(S);
    if specs.len() == 0 {
        let why = if rel == "" { "select a file in Assets" } else { "nothing to import for this file" };
        crate::inspector::hide_form();
        style::empty(k, why);
        return;
    }
    let kind = kind_of(rel);
    ui::add_space(6);
    ui::horizontal(#{ height: 24 }, || {
        ui::add_space(10);
        ui::label(util::last_segment(rel), #{ size: style::MD, strong: true, color: k.text });
    });
    ui::horizontal(#{ height: 20 }, || {
        ui::add_space(10);
        let from = if fs::exists(full(S, sidecar_of(rel))) { sidecar_of(util::last_segment(rel)) } else { "no settings file yet" };
        ui::label(format!("{}  ·  {}", kind, from), style::mono_sm(k.faint));
    });
    // The same pool the inspector fills: one form under the right sheet, and
    // whichever panel is up describes its rows.
    crate::inspector::open_pool(S);
    for spec in specs {
        row(S, k, rel, kind, spec);
    }
    crate::inspector::close_pool(S);
}
