const ASSETS: str = "assets";
const CHROME: str = "chrome";
const ENGINE: str = "engine";
const EXPORT: str = "export";
const INPUT: str = "input";
const LIGHT: str = "light";
const MANAGER: str = "manager";
const ROLES: str = "roles";
const SET: str = "set";

/// A start-up state written `<prefix><argument>`, and what it runs with the
/// argument.
pub struct Prefixed {
    prefix: str,
    run: fn(&mut editor::State, str),
}

fn select_named(state: &mut editor::State, name: str) {
    for row in 0..state.nodes.len() {
        if state.nodes[row].name() == name {
            selection::only(state, row);
        }
    }
}

// One handler per start-up state, looked up rather than branched on, so a
// self-test or a plugin registers its own.
fn states() -> any {
    {
        "palette": state_palette,
        "newnode": newnode::open,
        "test:picker": scene_checks::node_picker,
        "test:every_node": scene_checks::every_node,
        "test:rename": scene_checks::rename,
        "test:autosave": scene_checks::autosaving,
        "test:disk_changed": scene_checks::disk_changed,
        disk::SHEET: scene_checks::disk_sheet,
        LIGHT: state_light,
        panel_keys::DARK: state_dark,
        "play": state_play,
        INPUT: state_input,
        "pose": state_animdemo,
        "test:layout": shell_checks::layout,
        MANAGER: manager::open,
        "examples": manager::open_examples,
        "about": about::open,
        "populate": populate::open,
        project_fields::THEME: themewin::open,
        ENGINE: manager::open_versions,
        "newproject": manager::open_new,
        "versions": manager::open_versions,
        "test:manager": project_checks::manager_screen,
