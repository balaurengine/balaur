//! What a plugin fills its dock with, handed to it as `S.kit`. A plugin's
//! script is its own unit and cannot `use` the editor's modules, so each verb
//! is wrapped once here and bound to a local to call.
//!
//! A verb answers a row rather than drawing one: the editor makes every
//! registered dock a subtree and the pool writes the rows onto it.

use crate::util;

/// The deepest a file browser walks below its root.
const FOLDER_DEPTH = 3;

/// The most of a text file shown inline.
const TEXT_SHOWN = 4000;

/// How far one level of a tree is indented, in spaces: a row's label is a
/// node, and the pool gives every row the same label column.
const INDENT = "  ";

/// The kit, each verb wrapped for another unit to call. Made once: every
/// `script::shared` keeps its function for the life of the run.
pub fn make() {
    #{
        put_bar: script::shared(host_strip),
        put_rows: script::shared(host_rows),
        area_node: script::shared(host_node),
        tabs: script::shared(tabs),
        pages: script::shared(pages),
        tree_rows: script::shared(tree),
        field_row: script::shared(field),
        heading_row: script::shared(section),
        empty_row: script::shared(empty),
        file_rows: script::shared(files),
        save_editor_settings: script::shared(save_prefs),
        short_path: script::shared(short_path),
        user_data_directory: script::shared(game_data),
    }
}

/// Point `save::` at the game's own user data directory, and let `fs` reach
/// it, so a game played here and the same game run alone keep one set of
/// saves, and the User data dock can open them.
pub fn adopt_game_data(S) {
    if S.game_root == "" {
        project::use_data(());
        return;
    }
    project::use_data(game_name(S));
}

/// The user data directory the open game has when it runs on its own.
pub fn game_data(S) {
    if S.game_root == "" {
        return engine::user_data_directory();
    }
    engine::user_data_directory_of(game_name(S))
}

fn game_name(S) {
    let (ok, manifest) = script::attempt(|| toml::parse(fs::read(S.game_root + "/project.toml")));
    let name = if ok && manifest is Object {
        util::obj(manifest.get("application").unwrap_or(#{})).get("name").unwrap_or("")
    } else {
        ""
    };
    if name is String { name } else { "" }
}

/// What a verb remembers between frames: open tabs, open branches, drafts.
fn memory(S) {
    if !S.contains_key("kit_state") {
        S.kit_state = #{};
    }
    S.kit_state
}

fn option(opts, key, fallback) {
    if opts is Object {
        return opts.get(key).unwrap_or(fallback);
    }
    fallback
}

// Where each name a plugin uses sits under its host. A name the table does
// not know is the body, which is where rows belong.
fn host_path(host, name) {
    if name == "head" {
        return host + "/Head";
    }
    if name == "foot" {
        return host + "/Foot";
    }
    if name == "side" {
        return host + "/Split/Side/SideRows";
    }
    host + "/Split/Body/Rows"
}

/// A row of controls on a named part of the host: `head`, `foot`, or the
/// `body` that everything else means.
fn host_strip(S, host, name, controls) {
    crate::pool::strip(S, host_path(host, name), controls);
}

/// Rows on a named part of the host. A spec is what `pool::sync` takes:
/// `#{ label, controls }`, or `full` for a row across both columns.
fn host_rows(S, host, name, specs) {
    crate::pool::sync(S, host_path(host, name), specs, LABEL_W, false);
}

/// The node itself, for a plugin that wants to `add_child` a shape the kit
/// has no verb for, or to read a rect back.
fn host_node(host, name) {
    scene::get_node(host_path(host, name))
}

/// The label column every kit row keeps.
const LABEL_W = 140.0;

/// Rows of tabs across the host's head, wrapped to the width there is;
/// answers the one that is open, remembered per `id`.
fn tabs(S, host, id, names) {
    if names.len() == 0 {
        return "";
    }
    let m = memory(S);
    let held = m.get("tab:" + id).unwrap_or(());
    let current = if held is String && util::contains(names, held) { held } else { names[0] };
    let picked = #{ name: current };
    let controls = [];
    for entry in names {
        // Bound afresh: a closure made in a loop captures the binding.
        let name = entry;
        controls.push(#{
            kind: "button", text: name,
            role: "chip", checked: name == picked.name,
            on: |_| { picked.name = name; },
        });
    }
    host_strip(S, host, "head", controls);
    m["tab:" + id] = picked.name;
    picked.name
}

/// A list of pages down the host's sidebar, the way the settings screen is
/// laid out: what a panel with many views and little height wants. `groups`
/// is `[#{ title, names }]`, and the answer is the page that is open, which
/// the plugin then fills the body with.
fn pages(S, host, id, groups) {
    let names = [];
    for group in groups {
        for name in group.names {
            names.push(name);
        }
    }
    if names.len() == 0 {
        util::hide(host_path(host, "side"));
        return "";
    }
    let m = memory(S);
    let held = m.get("tab:" + id).unwrap_or(());
    let current = if held is String && util::contains(names, held) { held } else { names[0] };
    let picked = #{ name: current };
    let controls = [];
    for group in groups {
        if group.title != "" {
            controls.push(#{ kind: "label", role: "text_caption", text: group.title });
        }
        for entry in group.names {
            // Bound afresh: a closure made in a loop captures the binding.
            let name = entry;
            controls.push(#{
                kind: "button", text: name,
                role: "item_sidebar", checked: name == picked.name,
                on: |_| { picked.name = name; },
            });
        }
    }
    host_strip(S, host, "side", controls);
    util::fill(host + "/Split/Side", #{ visible: true });
    m["tab:" + id] = picked.name;
    picked.name
}

/// A heading between groups of rows.
fn section(title) {
    #{ full: true, height: 24, controls: [#{
        kind: "label", role: "action_section", text: title,
    }] }
}

/// What a panel says when it has nothing.
fn empty(text) {
    #{ full: true, height: 0, controls: [#{
        kind: "label", role: "text_caption", grow: 1, wrap: true, text: text,
    }] }
}

/// Write the editor's own settings file, after a plugin set an editor-scope
/// setting it wants kept.
fn save_prefs(S) {
    crate::settings::commit_prefs(S);
}

/// A labelled value. `mask` hides all but its ends until `show` is pressed,
/// `copy` adds a copy mark (copying `copy_text` when given), and `role`
/// dresses the value where the theme has a role for what it says.
fn field(S, label, value, opts) {
    let text = shown(value);
    let masked = option(opts, "mask", false);
    let m = memory(S);
    let key = "shown:" + label;
    let revealed = m.get(key).unwrap_or(false);
    let controls = [#{
        kind: "label", grow: 1, truncate: true,
        role: option(opts, "role", "text_caption"),
        text: if masked && !revealed { mask(text) } else { text },
    }];
    if masked {
        controls.push(#{
            kind: "button", role: "chip",
            text: if revealed { "hide" } else { "show" },
            on: |_| { m[key] = !revealed; },
        });
    }
    if option(opts, "copy", false) {
        let whole = option(opts, "copy_text", text);
        controls.push(#{
            kind: "button", role: "chip", text: "copy",
            on: |_| { ui::set_clipboard(whole); },
        });
    }
    #{ label: label, height: 22, slot_role: "layout_actions", controls: controls }
}

fn mask(text) {
    let chars = text.chars().collect::<Vec>();
    if chars.len() <= 12 {
        return "••••••••";
    }
    let head = "";
    let tail = "";
    let n = 0;
    while n < 4 {
        head.push(chars[n]);
        tail.push(chars[chars.len() - 4 + n]);
        n += 1;
    }
    head + "••••••••" + tail
}

/// The first `most` characters of a text, and whether it went on past them.
fn head_of(text, most) {
    let out = "";
    let n = 0;
    for c in text.chars() {
        if n == most {
            return (out, true);
        }
        out.push(c);
        n += 1;
    }
    let whole = (out, false);
    whole
}

/// A value as text, the way a row shows it.
fn shown(value) {
    if value is String {
        return value;
    }
    if value is Tuple {
        return "nil";
    }
    if value is Object || value is Vec {
        let (ok, text) = script::attempt(|| json::encode(value));
        return if ok { text } else { "…" };
    }
    format!("{}", value)
}

/// A value as rows: a map or a list opens and closes, a leaf shows in mono.
/// With `edit`, a leaf is a field and Enter keeps what was typed. Answers
/// `(specs, value, changed)`; the caller puts the specs on its host.
fn tree(S, id, value, opts) {
    let out = #{ value: value, changed: false, specs: [] };
    let edit = option(opts, "edit", false);
    let label = option(opts, "label", "");
    out.value = branch(S, out, id, label, value, edit, 0);
    let answer = (out.specs, out.value, out.changed);
    answer
}

fn branch(S, out, path, label, value, edit, depth) {
    if value is Object || value is Vec {
        return container(S, out, path, label, value, edit, depth);
    }
    leaf(S, out, path, label, value, edit, depth)
}

fn container(S, out, path, label, value, edit, depth) {
    let m = memory(S);
    let key = "open:" + path;
    let open = m.get(key).unwrap_or(depth == 0);
    let count = if value is Object { format!("{} keys", value.len()) } else { format!("{} items", value.len()) };
    if label != "" || depth > 0 {
        out.specs.push(#{ full: true, height: 22, slot_role: "layout_actions", controls: [
            #{
                kind: "button", role: "chip",
                text: indent(depth) + (if open { "▾ " } else { "▸ " }) + label,
                on: |_| { m[key] = !open; },
            },
            #{ kind: "label", role: "text_caption", text: count },
        ] });
    }
    if !open {
        return value;
    }
    let inner = if label != "" || depth > 0 { depth + 1 } else { depth };
    if value is Object {
        let names = util::keys_sorted(value);
        for name in names {
            let child = value[name];
            value[name] = branch(S, out, path + "/" + name, name, child, edit, inner);
        }
    } else {
        let n = 0;
        while n < value.len() {
            let child = value[n];
            value[n] = branch(S, out, path + "/" + format!("{}", n), format!("{}", n), child, edit, inner);
            n += 1;
        }
    }
    value
}

// A row's own depth, as the spaces before its label: a pooled row's label is
// a node in a column of them, so the text is what steps right.
fn indent(depth) {
    let out = "";
    let n = 0;
    while n < depth {
        out += INDENT;
        n += 1;
    }
    out
}

fn leaf(S, out, path, label, value, edit, depth) {
    let held = #{ value: value };
    let text = shown(value);
    let control = if edit {
        #{
            kind: "text_field", role: "input_form", grow: 1, text: text,
            on_submit: |typed| {
                if typed != text {
                    held.value = parsed(value, typed);
                    out.changed = true;
                }
            },
        }
    } else {
        #{ kind: "label", role: "text_caption", grow: 1, truncate: true, text: text }
    };
    out.specs.push(#{
        label: indent(depth) + label, height: 22, controls: [control],
    });
    held.value
}

/// What was typed, as the kind of value it replaces: text stays text, and a
/// number or a switch is read the way a TOML file would read it.
fn parsed(was, typed) {
    if was is String {
        return typed;
    }
    let (ok, doc) = script::attempt(|| toml::parse("v = " + typed));
    if ok && doc is Object {
        return doc["v"];
    }
    typed
}

/// Every file under a user data directory as rows, opened as a structure
/// where it is TOML or JSON, edited in place and written back. `opts`:
/// `root` (default this game's user data directory), `only` (file names to
/// show), `edit`.
fn files(S, id, opts) {
    let root = option(opts, "root", game_data(S));
    let only = option(opts, "only", []);
    let out = [#{ full: true, height: 24, slot_role: "layout_actions", controls: [
        #{ kind: "label", role: "text_caption", grow: 1, truncate: true, text: short_path(root) },
        #{ kind: "button", role: "chip", text: "reveal", on: |_| { reveal(root); } },
    ] }];
    let drawn = folder(S, id, root, "", only, option(opts, "edit", true), 0, out);
    if drawn == 0 {
        out.push(empty("nothing kept yet"));
    }
    out
}

/// One directory's entries; answers how many files it put rows on.
fn folder(S, id, dir, rel, only, edit, depth, out) {
    let drawn = 0;
    for entry in util::vec(fs::list(dir)) {
        let path = dir + "/" + entry.name;
        let here = if rel == "" { entry.name } else { rel + "/" + entry.name };
        if entry.is_dir {
            if depth < FOLDER_DEPTH {
                drawn += folder(S, id, path, here, only, edit, depth + 1, out);
            }
            continue;
        }
        if only.len() > 0 && !util::contains(only, entry.name) {
            continue;
        }
        file_rows(S, id + ":" + here, path, here, edit, out);
        drawn += 1;
    }
    drawn
}

fn file_rows(S, id, path, rel, edit, out) {
    let m = memory(S);
    let key = "file:" + id;
    let open = m.get(key).unwrap_or(false);
    let controls = [#{
        kind: "button", role: "chip",
        text: (if open { "▾ " } else { "▸ " }) + rel,
        on: |_| { m[key] = !open; },
    }];
    let when = fs::modified_time(path);
    if when is f64 || when is i64 {
        let age = (engine::unix_time() as f64) - (when as f64);
        controls.push(#{ kind: "label", role: "text_caption", text: ago(age) });
    }
    controls.push(#{ kind: "button", role: "chip", text: "reveal", on: |_| { reveal(path); } });
    out.push(#{ full: true, height: 24, slot_role: "layout_actions", controls: controls });
    if open {
        document(S, id, path, edit, out);
    }
}

/// A file opened: rows for TOML and JSON, its text otherwise.
fn document(S, id, path, edit, out) {
    let text = fs::read(path);
    if !(text is String) {
        out.push(empty("cannot read this file"));
        return;
    }
    let as_toml = path.ends_with(".toml");
    let as_json = path.ends_with(".json");
    if !as_toml && !as_json {
        let (head, more) = head_of(text, TEXT_SHOWN);
        out.push(empty(head + (if more { "…" } else { "" })));
        return;
    }
    let (ok, value) = if as_toml {
        script::attempt(|| toml::parse(text))
    } else {
        script::attempt(|| json::parse(text))
    };
    if !ok {
        out.push(#{ full: true, height: 22, controls: [#{
            kind: "label", role: "note_warning", grow: 1, wrap: true,
            text: format!("does not parse: {}", value),
        }] });
        return;
    }
    let (specs, after, changed) = tree(S, id, value, #{ edit: edit });
    for spec in specs {
        out.push(spec);
    }
    if changed {
        let body = if as_toml { toml::encode(after) } else { json::encode(after) };
        fs::write(path, body);
    }
}

/// A path as a person reads it: under the home directory it starts with `~`,
/// which also keeps a user name out of a screenshot.
fn short_path(path) {
    let home = project::home();
    if home is String && home != "" && path.starts_with(home + "/") {
        return "~" + path[home.len()..];
    }
    path
}

/// Show a path in the file manager; a folder not made yet is not an error.
fn reveal(path) {
    let (ok, why) = script::attempt(|| engine::reveal(path));
    if !ok {
        log::warn(format!("cannot reveal {}: {}", path, why));
    }
}

/// Seconds as how long ago, in the unit a person reads it in.
fn ago(seconds) {
    if seconds < 90.0 {
        return "just now";
    }
    if seconds < 5400.0 {
        return format!("{} min ago", (seconds / 60.0) as i64);
    }
    if seconds < 129600.0 {
        return format!("{} h ago", (seconds / 3600.0) as i64);
    }
    format!("{} days ago", (seconds / 86400.0) as i64)
}
