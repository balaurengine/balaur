// The one menu the shell has, under the mark at the head of the bar: the
// screens that are not panels, and a tick beside every panel there is, open
// or not. A tab's close mark takes one away; this is where it comes back.

use commands;
use docks;
use editor;
use icons;
use words::command;
use words::roles;

const PANEL_SCENE: str = "scenes/items/menu_panel.toml";

const PANELS: str = "Panels";

/// Write the menu's rows under `brand`, each the command it is named for as
/// the palette shows it, then one row a panel, ticked where it is open.
pub fn fill(state: &mut editor::State, brand: Node) {
    for id in [command::PALETTE, command::SETTINGS, command::THEME, command::EXPORT, command::ABOUT, command::RESET] {
        let found = commands::find(state, id).unwrap();
        let row = brand.get_node(id);
        row.widget.text = found.label;
        row.widget_button.icon = found.icon;
        row.widget_button.trailing = commands::chord(state, id);
    }
    let ids = docks::known(state);
    let items: [scene::RepeatItem] = [];
    for id in ids {
        items.push(scene::RepeatItem { key: id, scene: PANEL_SCENE });
    }
    let nodes = scene::repeat(brand.get_node(PANELS), items);
    for index in 0..ids.len() {
        let open = docks::side_of(state, ids[index]) != nil;
        let row = nodes[index];
        row.widget.text = docks::name(state, ids[index]).as_str();
        row.widget.role = if open { roles::ITEM_MENU } else { roles::ITEM_MENU_QUIET };
        row.widget_button.icon = if open { icons::ui(icons::CHECK) } else { "" };
    }
}
