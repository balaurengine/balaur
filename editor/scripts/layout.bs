// The only place a rect is decided; everything else reads `state.layout`. Shape
// and resting size are the `widget` tree under `Editor/Shell` in
// `scenes/main.toml`; this states the sizes that move and reads back the rest.

use center;
use docks;
use editor;
use signals;
use style;
use util;

pub struct Chrome {
    width: float,
    height: float,
}

pub struct ShellBoxes {
    head: any,
    left: any,
    right: any,
    bottom: any,
    rail: any,
    railtop: any,
    railslot: any,
    centre: any,
    canvas: any,
    stage: any,
    hooks: any,
    upperrow: any,
    chips: any,
    hud: any,
}

pub struct Box {
    width: float,
    x: float,
    y: float,
    height: float,
}

pub struct Floors {
    width: float,
    height: float,
}

pub struct ShellRoom {
    width: float,
    height: float,
}

pub struct Room {
    width: float,
    height: float,
}

// What a timeline, a debugger or a session list needs over the bottom dock's
// resting height, which the scene states.
const TALL_EXTRA: float = 62.0;

// What a small window takes off the shell's own gutter and the seams between
// its sheets. The scene states the resting pair; this is the tighter one.
const TIGHT_GUTTER: float = 8.0;

const TIGHT_GAP: float = 6.0;

// The floor a seam stops a dock at, and what the scene keeps whatever the
// seams either side of it are dragged to.
const LEFT_MIN: float = 180.0;

const RIGHT_MIN: float = 220.0;

const BOTTOM_MIN: float = 84.0;

const STAGE_MIN: float = 260.0;

// What the stage keeps of itself beside a dock that took half a tablet.
const MEDIUM_PEEK: float = 220.0;

// Every box the shell tree names, by the path `scene::get_node` takes.
const SHELL: str = "Editor/Shell";

const EASE_SECONDS: float = 0.16;

fn rect(origin_x: float, origin_y: float, width: float, height: float) -> any {
    { "x": origin_x, "y": origin_y, "width": width, "height": height }
}

pub fn state() -> any {
    {
        "bar": rect(0.0, 0.0, 0.0, 0.0),
        "left": rect(0.0, 0.0, 0.0, 0.0),
        "rail": rect(0.0, 0.0, 0.0, 0.0),
        "railtop": rect(0.0, 0.0, 0.0, 0.0),
        "right": rect(0.0, 0.0, 0.0, 0.0),
        "bottom": rect(0.0, 0.0, 0.0, 0.0),
        "stage": rect(0.0, 0.0, 0.0, 0.0),
        "doc": rect(0.0, 0.0, 0.0, 0.0),
        "chips": rect(0.0, 0.0, 0.0, 0.0),
        "hud": rect(0.0, 0.0, 0.0, 0.0),
        "upper": rect(0.0, 0.0, 0.0, 0.0),
        "stage_box": rect(0.0, 0.0, 0.0, 0.0),
        "hooks": rect(0.0, 0.0, 0.0, 0.0),
        "split_width": 560.0,
        "rail_room": 400.0,
        "quiet": 0,
        "asked": false,
        "gutter": 0.0,
        "gap": 0.0,
        "padding": 0.0,
        "tree_width": 0.0,
        "inspector_width": 0.0,
        "dock_height": 0.0,
        "hooks_width": 0.0,
        "status_height": 0.0,
        "nodes": {},
        "sent": {},
        "tweens": {},
    }
}

/// The shell's boxes, by the name `state.layout` publishes them under.
fn node(state: editor::State, id: any) -> any {
    let layout_state: any = state.layout;
    let found = layout_state["nodes"][id.as_str()];
    if found != nil {
        return found;
    }
    let path = if id.as_str() == "shell" {
        SHELL
    } else if id.as_str() == "head" {
        SHELL + "/Head"
    } else if id.as_str() == "body" {
        SHELL + "/Body"
    } else if id.as_str() == "left" {
        SHELL + "/Body/Left"
    } else if id.as_str() == "leftsheet" {
        SHELL + "/Body/Left/LeftSheet"
    } else if id.as_str() == "right" {
        SHELL + "/Body/Right"
    } else if id.as_str() == "rightsheet" {
        SHELL + "/Body/Right/RightSheet"
    } else if id.as_str() == "centre" {
        SHELL + "/Body/Centre"
    } else if id.as_str() == "upperrow" {
        SHELL + "/Body/Centre/UpperRow"
    } else if id.as_str() == "stack" {
        SHELL + "/Body/Centre/UpperRow/Stack"
    } else if id.as_str() == "upper" {
        SHELL + "/Body/Centre/UpperRow/Stack/Upper"
    } else if id.as_str() == "bottom" {
        SHELL + "/Body/Centre/Bottom"
    } else if id.as_str() == "status" {
        SHELL + "/Body/Centre/Bottom/Status"
    } else if id.as_str() == "railslot" {
        SHELL + "/Body/Centre/UpperRow/RailSlot"
    } else if id.as_str() == "rail" {
        SHELL + "/Body/Centre/UpperRow/RailSlot/Rail"
    } else if id.as_str() == "railtop" {
        SHELL + "/Body/Centre/UpperRow/RailSlot/RailTop"
    } else if id.as_str() == "work" {
        SHELL + "/Body/Centre/UpperRow/Stack/Upper/Work"
    } else if id.as_str() == "canvas" {
        SHELL + "/Body/Centre/UpperRow/Stack/Upper/Work/Canvas"
    } else if id.as_str() == "stage" {
        SHELL + "/Body/Centre/UpperRow/Stack/Upper/Work/Canvas/Stage"
    } else if id.as_str() == "hooks" {
        SHELL + "/Body/Centre/UpperRow/Stack/Upper/Work/Canvas/Hooks"
    } else if id.as_str() == "chips" {
        SHELL + "/Body/Centre/UpperRow/Stack/Upper/Work/Canvas/Stage/Chrome/Chips"
    } else if id.as_str() == "hud" {
        SHELL + "/Body/Centre/UpperRow/Hud"
    } else {
        ""
    };
    let found: any = scene::get_node(path);
    // A miss is not remembered: one transient failure would leave the box
    // inert for the rest of the session.
    if !util::is_nil(found) {
        layout_state["nodes"][id.as_str()] = found;
    }
    found
}

/// A box's `widget` component; empty when the tree has no such node.
fn widget_of(state: editor::State, id: str) -> any {
    let found = node(state, id);
    if util::is_nil(found) {
        return {};
    }
    util::map_or_empty(found.as_node().get_component("widget"))
}

/// The shell's own gutter: the scene's number, a step tighter in a small
/// window. Read by whoever needs the body's edge, so no two callers disagree.
pub fn gutter(state: editor::State) -> any {
    if state.compact { TIGHT_GUTTER } else { state.layout["gutter"] }
}

/// The seam between two sheets, the gutter's own step.
pub fn seam(state: editor::State) -> any {
    if state.compact { TIGHT_GAP } else { state.layout["gap"] }
}

/// What the shell spends on itself before a sheet gets anything: the gutter
/// either side, the two seams across and down, and the status strip inside
/// the bottom dock. Every floor subtracts it, so none of them promises room
/// the layout has already spent.
pub fn chrome(state: editor::State) -> Chrome {
    let edges = 2.0 * gutter(state).as_float() + 2.0 * seam(state).as_float();
    Chrome { width: edges, height: edges + state.layout["status_height"].as_float() }
}

/// What the scene states for one of a box's sizes. A `padding` is four sides
/// in the component whatever the scene spelled, so take the first.
fn stated(state: editor::State, id: str, key: str) -> float {
    let value = widget_of(state, id)[key];
    if value.kind() == "list" { value[0].as_float() } else { value.as_float() }
}

/// One number off a theme role, or `fallback` where the role says nothing.
fn role_number(state: editor::State, role: str, key: str, fallback: float) -> float {
    let roles = state.theme["roles"];
    let found = roles[role];
    if found != nil {
        let entry = found;
        let value = entry[key];
        if value != nil {
            let number = value;
            let pixels = style::size_in_pixels(state, number);
            return pixels;
        }
    }
    fallback
}

/// The scene's own numbers, read back once before anything writes over them.
/// Nothing outside `scenes/main.toml` may spell a resting shell size.
fn adopt(state: editor::State) {
    let layout_state: any = state.layout;
    if layout_state["asked"].as_bool() {
        return;
    }
    let shell = widget_of(state, "shell");
    if shell.len() == 0 {
        return;
    }
    // The shell's gutter and seam are the theme's, so one file holds them and
    // a role a node takes cannot drift from the number this arithmetic uses.
    layout_state["gutter"] = role_number(state, "layout_shell", "padding", 14.0);
    layout_state["gap"] = role_number(state, "layout_shell", "gap", 12.0);
    layout_state["padding"] = stated(state, "leftsheet", "padding");
    layout_state["tree_width"] = stated(state, "left", "width");
    layout_state["inspector_width"] = stated(state, "right", "width");
    layout_state["status_height"] = stated(state, "status", "height");
    layout_state["dock_height"] = stated(state, "bottom", "height") - layout_state["status_height"].as_float();
    layout_state["hooks_width"] = stated(state, "hooks", "width");
    layout_state["asked"] = true;
}

/// State a box's size, when it has moved. A component write rebuilds the
/// widget, so the same number twice is a write worth skipping.
// The boxes that travel when they change rather than jumping: a dock opening,
// the tool rail folding away, the hooks list arriving beside the code.
fn eased(mark: str) -> bool {
    is_among(mark, ["left:width", "right:width", "bottom:height", "railslot:width", "hooks:width"])
}

fn is_among(mark: str, items: [str]) -> bool {
    for listed in items {
        if listed == mark {
            return true;
        }
    }
    false
}

/// Whether the last layout wrote no box and nothing is moving. A box that
/// moved after it says so with `resized`, which lays the shell out again, so
/// one quiet layout is the shell at rest.
pub fn settled(state: editor::State) -> bool {
    let layout_state: any = state.layout;
    if !layout_state["asked"].as_bool() || layout_state["quiet"].as_int() < 1 {
        return false;
    }
    !animating(state)
}

/// Every box whose `resized` lays the shell out again: the sheets a seam
/// drags, the columns a dock or the rail takes room from, and the strips
/// over the stage.
pub fn watched() -> [str] {
    let out: [str] = [];
    for id in [
        "shell",
        "head",
        "leftsheet",
        "rightsheet",
        "bottom",
        "rail",
        "railtop",
        "railslot",
        "centre",
        "canvas",
        "stage",
        "hooks",
        "upperrow",
        "chips",
        "hud",
    ] {
        out.push(id);
    }
    out
}

/// The node of one of those boxes, or nil before the shell has loaded.
pub fn box_node(state: editor::State, id: str) -> any {
    node(state, id)
}

/// Whether an eased box is still travelling. A tween moves the widget from
/// the animation stage, which no UI pass follows: the shell asks for one.
pub fn animating(state: editor::State) -> bool {
    let tweens = state.layout["tweens"];
    for mark in tweens.keys() {
        let handle = tweens[mark];
        if animation::is_tween_running(handle) {
            return true;
        }
    }
    false
}

/// Take back a size the pointer changed, so the next write agrees with it.
fn dragged(state: editor::State, id: str, key: str, into: str) {
    let layout_state: any = state.layout;
    let mark = id + ":" + key;
    let running = layout_state["tweens"][mark];
    if running != nil {
        let handle = running;
        if animation::is_tween_running(handle) {
            return;
        }
    }
    let now = stated(state, id, key);
    if now > 0.0 && layout_state["sent"][mark] != now {
        layout_state[into] = now;
        layout_state["sent"][mark] = now;
    }
}

// A dragged size, held between its floor and what the scene can spare. Kept
// on `state.layout` rather than clamped on the way out, so the next drag carries
// on from where this one stopped instead of from where the pointer went.
fn held(state: editor::State, key: str, floor: float, ceiling: float) -> any {
    let layout_state: any = state.layout;
    layout_state[key] = util::clamp(layout_state[key].as_float(), floor, util::max(floor, ceiling));
    layout_state[key]
}

fn size(state: editor::State, id: str, key: str, value: any) {
    let layout_state: any = state.layout;
    let mark = id + ":" + key;
    if layout_state["sent"][mark] == value {
        return;
    }
    let found = node(state, id);
    if util::is_nil(found) {
        return;
    }
    // The first write places the box; a later one moves it. Easing the first
    // would mean watching the shell assemble itself on every start, and so
    // would easing the corrections it takes before the shell is formed.
    let settled = layout_state["sent"].has(mark) && state.formed;
    layout_state["sent"][mark] = value;
    layout_state["quiet"] = 0;
    if settled && eased(mark) {
        let running = layout_state["tweens"][mark];
        if running != nil {
            let handle = running;
            animation::stop(handle);
        }
        layout_state["tweens"][mark] = animation::tween(found.as_node(), animation::Tween { steps: [animation::Step { property: "widget/" + key, to: value, duration: EASE_SECONDS, ease: animation::EASE_OUT_CUBIC }] });
        return;
    }
    let parameters = util::map_or_empty(found.as_node().get_component("widget"));
    parameters[key] = value;
    found.as_node().set_component("widget", parameters);
}

/// Draw a box, or stop drawing it. Memoised like `size`, because a component
/// written every frame is a widget tree rebuilt every frame.
fn show(state: editor::State, id: str, on: bool) {
    let layout_state: any = state.layout;
    let mark = id + ":visible";
    let want = if on { 1.0 } else { 0.0 };
    if layout_state["sent"][mark] == want {
        return;
    }
    let found = node(state, id);
    if util::is_nil(found) {
        return;
    }
    layout_state["sent"][mark] = want;
    layout_state["quiet"] = 0;
    found.as_node().patch_component("widget", { "visible": on });
}

/// Where a box was laid out, in design pixels; a zero rect until it has
/// drawn once, which is the frame before the editor's first.
fn box_of(state: editor::State, id: str) -> any {
    let found = node(state, id);
    if util::is_nil(found) {
        return rect(0.0, 0.0, 0.0, 0.0);
    }
    let drawn = ui::widget_rect(found.as_node());
    if drawn == nil {
        return rect(0.0, 0.0, 0.0, 0.0);
    }
    let placed = drawn.unwrap();
    rect(placed.x, placed.y, placed.width, placed.height)
}

/// The sheets that can sit under the pointer, in draw order.
pub fn sheets(state: editor::State) -> [any] {
    let layout_state: any = state.layout;
    // The status strip is inside the bottom dock, not a sheet of its own: the
    // dock already owns that rect and the pointer with it.
    let all = [layout_state["bar"], layout_state["left"], layout_state["right"], layout_state["bottom"]];
    if state.rail_visible {
        all.push(layout_state["rail"]);
    }
    // Over the stage rather than beside it, and each zero on a frame it did
    // not draw.
    all.push(layout_state["chips"]);
    all.push(layout_state["hud"]);
    if state.doc_open {
        all.push(layout_state["doc"]);
    }
    if state.hooks_open {
        all.push(layout_state["hooks"]);
    }
    all
}

/// Rects for the current window, published as `state.layout`. Sizes are exact:
/// nothing hugs, because the stage is what is left over and a measured sheet
/// could not be subtracted from it.
pub fn compute(state: &mut editor::State) {
    let screen_width = state.screen_width;
    let layout_state: any = state.layout;
    adopt(state);
    // Before the shell tree resolves there is no size to state and no rect to
    // read; every surface guards on a zero rect and draws nothing.
    if !layout_state["asked"].as_bool() {
        return;
    }
    // Counted before the writes below, each of which puts it back to zero.
    layout_state["quiet"] = layout_state["quiet"].as_float() + 1;
    // A seam the pointer moved wrote straight to the node, so the value it
    // left there is the new one to keep. A tween is this module's own doing
    // and is not mistaken for a drag.
    dragged(state, "left", "width", "tree_width");
    dragged(state, "right", "width", "inspector_width");
    dragged(state, "bottom", "height", "dock_height");
    // A seam resizes and only resizes: a dock is put away by the mark in its
    // own tab row, so a drag that reaches the floor stops there. The ceiling is
    // what the other dock and the stage leave.
    let tree_width = side_width(state, "left", screen_width, held(state, "tree_width", LEFT_MIN, screen_width - STAGE_MIN - RIGHT_MIN).as_float());
    let inspector_width = side_width(state, "right", screen_width, held(state, "inspector_width", RIGHT_MIN, screen_width - STAGE_MIN - tree_width).as_float());
    let tall = if docks::bottom_tall(state).as_bool() { TALL_EXTRA } else { 0.0 };
    let body_height = held(state, "dock_height", BOTTOM_MIN, state.screen_height - layout_state["bar"]["height"].as_float() - STAGE_MIN - tall - layout_state["status_height"].as_float());
    // Minimised, the dock is gone: its handle sits beside the zoom reading,
    // the way each side dock's sits at the edge it folded towards.
    let dock_height = if docks::folded(state, "bottom") {
        0.0
    } else {
        body_height.as_float() + tall + layout_state["status_height"].as_float()
    };
    let grid = center::rail_grid(state, layout_state["rail_room"].as_float());
    let rail_width = if state.rail_visible { center::rail_span(grid, grid.columns) } else { 0.0 };
    let hooks_width = if state.hooks_open { layout_state["hooks_width"].as_float() } else { 0.0 };
    // The gutter round the shell and the seams between its sheets: a step
    // tighter in a small window, where they are most of what is on screen.
    let tight = state.compact;
    size(state, "shell", "padding", gutter(state));
    let gap = if tight { TIGHT_GAP } else { layout_state["gap"].as_float() };
    for id in ["body", "centre", "upperrow", "stack", "upper", "shell"] {
        size(state, id, "gap", [gap, gap]);
    }
    size(state, "left", "width", tree_width);
    size(state, "right", "width", inspector_width);
    // Folded, a side dock's whole column goes. Not the sheet inside it: a
    // box left at zero width still takes the row's gap either side of it,
    // which is what stopped the centre reaching the window's own edge.
    for side in ["left", "right", "bottom"] {
        show(state, side, !docks::folded(state, side));
    }
    // One sheet at a time: a side sheet takes the whole body and the centre
    // goes, since a box left at zero width still takes the row's gap beside it.
    show(state, "centre", !(docks::one_at_a_time(state) && docks::side_open(state)));
    size(state, "bottom", "height", dock_height);
    size(state, "railslot", "width", rail_width);
    size(state, "rail", "height", center::rail_span(grid, grid.rows));
    // The folded left dock's handle sits above the tools, so the rail starts
    // below it rather than beside it.
    size(state, "railtop", "height", docks::rail_top_height(state));
    size(state, "hooks", "width", hooks_width);
    // The side docks' rule again: a zero-width box still takes its row's gap,
    // so the rail slot and the hooks list go rather than shrink.
    show(state, "railslot", rail_width > 0.0);
    show(state, "hooks", hooks_width.as_float() > 0.0);
    // Laid out after the frame's scripts, so a frame behind: a size that just
    // changed shows on the next one, the way `bar_fit` has always worked.
    let boxes = ShellBoxes {
        head: box_of(state, "head"),
        left: box_of(state, "leftsheet"),
        right: box_of(state, "rightsheet"),
        bottom: box_of(state, "bottom"),
        rail: box_of(state, "rail"),
        railtop: box_of(state, "railtop"),
        railslot: box_of(state, "railslot"),
        centre: box_of(state, "centre"),
        canvas: box_of(state, "canvas"),
        stage: box_of(state, "stage"),
        hooks: box_of(state, "hooks"),
        upperrow: box_of(state, "upperrow"),
        chips: box_of(state, "chips"),
        hud: box_of(state, "hud"),
    };
    // The sheet is its own box now, so a folded dock's rect is the square the
    // widget layer placed rather than one this module has to work out.
    layout_state["left"] = boxes.left;
    layout_state["right"] = boxes.right;
    layout_state["bottom"] = boxes.bottom;
    layout_state["hooks"] = boxes.hooks;
    layout_state["upper"] = boxes.upperrow;
    // The two strips over the stage, as their nodes were laid out: a box the
    // pointer is over is chrome, not scene.
    let strips = state.viewport_live && state.stage_chrome;
    let foot = strips && !state.chrome_off;
    layout_state["chips"] = if strips { boxes.chips } else { rect(0.0, 0.0, 0.0, 0.0) };
    layout_state["hud"] = if foot { boxes.hud } else { rect(0.0, 0.0, 0.0, 0.0) };
    layout_state["rail"] = boxes.rail;
    layout_state["railtop"] = boxes.railtop;
    // The column the rail is in, not the whole centre: the dock below takes
    // its share of the centre, and a rail measured against that overran it.
    let column: float = if boxes.railslot["height"].as_float() > 0.0 { boxes.railslot["height"].as_float() } else { boxes.centre["height"].as_float() };
    // Less the folded dock's handle above it and the HUD strip under its foot.
    let hud = if state.stage_chrome && !state.chrome_off { center::hud_height(state) } else { 0.0 };
    layout_state["rail_room"] = util::max(120.0, column - docks::rail_top_height(state) - hud);
    layout_state["bar"] = boxes.head;
    // A document is not full-bleed: text under a sheet is unreadable. Sharing
    // with the scene puts the code on the right and the scene on the left.
    let box: Box = boxes.stage;
    layout_state["stage_box"] = box;
    if state.doc_open && state.viewport_live {
        let code_width = util::clamp(layout_state["split_width"].as_float(), 260.0, util::max(260.0, box.width - 260.0));
        layout_state["doc"] = rect(box.x + box.width - code_width, box.y, code_width, box.height);
        layout_state["stage"] = rect(box.x, box.y, box.width - code_width - layout_state["gap"].as_float(), box.height);
    } else if state.doc_open {
        layout_state["doc"] = box;
        layout_state["stage"] = box;
    } else {
        // Nothing to read, so the scene takes the hooks list's width too.
        layout_state["stage"] = boxes.canvas;
        layout_state["doc"] = layout_state["stage"];
    }
    // The scene's rect under its old name; `at` is the frame it was set on, so
    // a self-test can tell a headless run from a drawn one. An unplaced stage
    // is not published: a played game's HUD would blink out for that frame.
    if layout_state["stage"]["width"].as_float() > 0.0 && layout_state["stage"]["height"].as_float() > 0.0 {
        state.viewport = editor::Viewport {
            x: layout_state["stage"]["x"].as_float(),
            y: layout_state["stage"]["y"].as_float(),
            width: layout_state["stage"]["width"].as_float(),
            height: layout_state["stage"]["height"].as_float(),
            at: state.frame,
        };
    }
    // A dock's width decides how many of its tabs fit.
    signals::docks(state);
}

// A side dock's width: nothing when it holds no panel, its rail when it is
// folded, and what the seam was dragged to otherwise.
/// The least screen that holds one side dock beside a stage worth having,
/// as a width; and down, the bar, the bottom dock and the stage. Below
/// either, the shell is one sheet at a time.
pub fn floors(state: editor::State) -> Floors {
    // The stage's own floor down the screen, not the seam's: a dock shrinks
    // to `BOTTOM_MIN` before the stage is asked to give anything up, so a
    // laptop window keeps all three docks rather than folding to one.
    let spent = chrome(state);
    Floors { width: util::max(LEFT_MIN, RIGHT_MIN) + STAGE_MIN + spent.width, height: BAR_HEIGHT_GUESS + BOTTOM_MIN + center::stage_floor().height + spent.height }
}

/// The box the engine gave the shell, in design px, or zeros before it has
/// drawn. `fill` and `safe_area` decide it, so nothing here restates it.
pub fn shell_room(state: editor::State) -> ShellRoom {
    let node = scene::get_node(SHELL);
    let drawn = if node.is_valid() { ui::widget_rect(node) } else { nil };
    if drawn == nil {
        return ShellRoom { width: 0.0, height: 0.0 };
    }
    ShellRoom { width: drawn.unwrap().width, height: drawn.unwrap().height }
}

/// Whether three columns fit across: both side docks and the stage at their
/// floors. Below this the side docks start folded and an open one takes half.
pub fn three_fit(state: editor::State) -> bool {
    state.screen_width >= LEFT_MIN + STAGE_MIN + RIGHT_MIN + chrome(state).width
}

// The bar's height before its node has been measured, for the floor above:
// the head sheet as the scene states it.
const BAR_HEIGHT_GUESS: float = 43.0;

/// The room the docks leave the stage, as `#{ width, height }` in design pixels,
/// from the same widths the layout is about to use. Asked before the layout
/// runs, by everything that shows only where there is room for it.
pub fn stage_room(state: editor::State) -> Room {
    let layout_state: any = state.layout;
    let screen_width = state.screen_width;
    let tree_width = side_width(state, "left", screen_width, util::max(layout_state["tree_width"].as_float(), LEFT_MIN).as_float());
    let inspector_width = side_width(state, "right", screen_width, util::max(layout_state["inspector_width"].as_float(), RIGHT_MIN).as_float());
    let dock_height = if docks::folded(state, "bottom") {
        0.0
    } else {
        util::max(layout_state["dock_height"].as_float(), BOTTOM_MIN) + layout_state["status_height"].as_float()
    };
    // Less what the shell spends on itself: the room a rail or a chip strip
    // is offered is the room it will actually be drawn in.
    let spent = chrome(state);
    Room { width: screen_width - tree_width - inspector_width - spent.width, height: state.screen_height - layout_state["bar"]["height"].as_float() - dock_height.as_float() - spent.height }
}

/// How wide an open side dock is: what the seam was dragged to on a screen
/// with room for three columns, and most of the screen on one without.
///
/// A dock a reader had to unfold on purpose is one they want to read, and a
/// 220 px column of it on a phone is a list of truncated words. The stage
/// keeps a strip, so it is still there to go back to.
fn side_width(state: editor::State, side: str, room: float, open_width: float) -> float {
    if state.docks[side]["tabs"].len() == 0 || state.docks[side]["shut"].as_bool() {
        return 0.0;
    }
    // One sheet at a time takes the whole body: its own fold is the way back,
    // and a strip of stage beside it is dead space once nothing sits on it.
    // Less the shell's gutter each side, which is the body's, not the sheet's.
    if docks::one_at_a_time(state) {
        return room - 2.0 * gutter(state).as_float();
    }
    // Where a dock and the stage fit but not two docks, the open one takes
    // half: the seam's own width was set beside two columns, not one. Both
    // open, they keep their stated widths, or half each would leave no stage.
    if !three_fit(state) && !both_sides_open(state) {
        return util::clamp(room * 0.5, open_width, room - MEDIUM_PEEK);
    }
    open_width
}

/// Whether the left and right docks are both showing a panel.
fn both_sides_open(state: editor::State) -> bool {
    !docks::folded(state, "left") && !docks::folded(state, "right")
}

/// What one workspace pill is estimated at, for the showcase's pointer.
pub fn workspace_width(state: editor::State) -> float {
    if state.compact { 40.0 } else { 76.0 }
}

/// Whether `point_x`, `point_y` in design px is over a sheet. Under Stage the scene is the
/// whole window, so a viewport tool asks this instead of testing itself
/// against a hole in the chrome.
pub fn over_sheet(state: editor::State, point_x: float, point_y: float) -> bool {
    for sheet in sheets(state) {
        if sheet["width"].as_float() > 0.0 && sheet["height"].as_float() > 0.0 && point_x >= sheet["x"].as_float() && point_x <= (sheet["x"].as_float() + sheet["width"].as_float()).as_float() && point_y >= sheet["y"].as_float() && point_y <= (sheet["y"].as_float() + sheet["height"].as_float()).as_float() {
            return true;
        }
    }
    false
}
