// The only place a rect is decided; everything else reads `S.layout`. Shape
// and resting size are the `widget` tree under `Editor/Shell` in
// `scenes/main.toml`; this states the sizes that move and reads back the rest.

use center;
use docks;
use editor;
use signals;
use style;
use util;

pub struct Chrome {
    w: float,
    h: float,
}

pub struct Step3 {
    property: str,
    to: any,
    duration: float,
    ease: any,
}

pub struct R {
    head: any,
    left: any,
    right: any,
    bottom: any,
    rail: any,
    railtop: any,
    railslot: any,
    centre: any,
    canvas: any,
    stage: any,
    hooks: any,
    upperrow: any,
    chips: any,
    hud: any,
}

pub struct Box {
    w: float,
    x: float,
    y: float,
    h: float,
}

pub struct Floors {
    _0: float,
    _1: float,
}

pub struct ShellRoom {
    _0: float,
    _1: float,
}

pub struct Room {
    w: float,
    h: float,
}

// What a timeline, a debugger or a session list needs over the bottom dock's
// resting height, which the scene states.
const TALL_EXTRA: float = 62.0;

// What a small window takes off the shell's own gutter and the seams between
// its sheets. The scene states the resting pair; this is the tighter one.
const TIGHT_GUTTER: float = 8.0;

const TIGHT_GAP: float = 6.0;

// The floor a seam stops a dock at, and what the scene keeps whatever the
// seams either side of it are dragged to.
const LEFT_MIN: float = 180.0;

const RIGHT_MIN: float = 220.0;

const BOTTOM_MIN: float = 84.0;

const STAGE_MIN: float = 260.0;

// What the stage keeps of itself beside a dock that took half a tablet.
const MEDIUM_PEEK: float = 220.0;

// Every box the shell tree names, by the path `scene::get_node` takes.
const SHELL: str = "Editor/Shell";

const EASE_S: float = 0.16;

fn rect(x: float, y: float, w: float, h: float) -> any {
    map().with("x", x).with("y", y).with("w", w).with("h", h)
}

pub fn state() -> any {
    map()
        .with("bar", rect(0.0, 0.0, 0.0, 0.0))
        .with("left", rect(0.0, 0.0, 0.0, 0.0))
        .with("rail", rect(0.0, 0.0, 0.0, 0.0))
        .with("railtop", rect(0.0, 0.0, 0.0, 0.0))
        .with("right", rect(0.0, 0.0, 0.0, 0.0))
        .with("bottom", rect(0.0, 0.0, 0.0, 0.0))
        .with("stage", rect(0.0, 0.0, 0.0, 0.0))
        .with("doc", rect(0.0, 0.0, 0.0, 0.0))
        // The two strips over the stage, and the row the HUD runs along.
        .with("chips", rect(0.0, 0.0, 0.0, 0.0))
        .with("hud", rect(0.0, 0.0, 0.0, 0.0))
        .with("upper", rect(0.0, 0.0, 0.0, 0.0))
        // The stage's own box, which a split shares between the scene and
        // the code: what the code sheet's inset is measured against.
        .with("stage_box", rect(0.0, 0.0, 0.0, 0.0))
        .with("hooks", rect(0.0, 0.0, 0.0, 0.0))
        .with("split_w", 560.0)
        // How tall the tool rail's column is, read back a frame late; the
        // rail flows into a second column rather than overrun it.
        .with("rail_room", 400.0)
        // Passes in a row that wrote no box. Every rect is read back a pass
        // late, so the shell settles over several: this is what says it has.
        .with("quiet", 0)
        // The scene's own numbers, adopted before anything writes over them.
        // Zero until `adopt` has run, which is what `asked` says.
        .with("asked", false)
        .with("gutter", 0.0)
        .with("gap", 0.0)
        .with("pad", 0.0)
        .with("tree_w", 0.0)
        .with("insp_w", 0.0)
        .with("dock_h", 0.0)
        .with("hooks_w", 0.0)
        .with("status_h", 0.0)
        // The shell's nodes, resolved once: the tree is the editor's own and
        // does not change under a running editor.
        .with("nodes", map())
        // What was last written to a node, so a size that has not moved is
        // not a component write every frame.
        .with("sent", map())
        // The tween each eased box is riding, so a second change replaces it
        // rather than fighting it.
        .with("tweens", map())
}

/// The shell's boxes, by the name `S.layout` publishes them under.
fn node(S: editor::State, id: any) -> any {
    let m: any = S.layout;
    let found = m.get("nodes").get(id);
    if !found.is_nil() {
        return found;
    }
    let path = if id.as_str() == "shell" {
        SHELL
    } else if id.as_str() == "head" {
        SHELL + "/Head"
    } else if id.as_str() == "body" {
        SHELL + "/Body"
    } else if id.as_str() == "left" {
        SHELL + "/Body/Left"
    } else if id.as_str() == "leftsheet" {
        SHELL + "/Body/Left/LeftSheet"
    } else if id.as_str() == "right" {
        SHELL + "/Body/Right"
    } else if id.as_str() == "rightsheet" {
        SHELL + "/Body/Right/RightSheet"
    } else if id.as_str() == "centre" {
        SHELL + "/Body/Centre"
    } else if id.as_str() == "upperrow" {
        SHELL + "/Body/Centre/UpperRow"
    } else if id.as_str() == "stack" {
        SHELL + "/Body/Centre/UpperRow/Stack"
    } else if id.as_str() == "upper" {
        SHELL + "/Body/Centre/UpperRow/Stack/Upper"
    } else if id.as_str() == "bottom" {
        SHELL + "/Body/Centre/Bottom"
    } else if id.as_str() == "status" {
        SHELL + "/Body/Centre/Bottom/Status"
    } else if id.as_str() == "railslot" {
        SHELL + "/Body/Centre/UpperRow/RailSlot"
    } else if id.as_str() == "rail" {
        SHELL + "/Body/Centre/UpperRow/RailSlot/Rail"
    } else if id.as_str() == "railtop" {
        SHELL + "/Body/Centre/UpperRow/RailSlot/RailTop"
    } else if id.as_str() == "work" {
        SHELL + "/Body/Centre/UpperRow/Stack/Upper/Work"
    } else if id.as_str() == "canvas" {
        SHELL + "/Body/Centre/UpperRow/Stack/Upper/Work/Canvas"
    } else if id.as_str() == "stage" {
        SHELL + "/Body/Centre/UpperRow/Stack/Upper/Work/Canvas/Stage"
    } else if id.as_str() == "hooks" {
        SHELL + "/Body/Centre/UpperRow/Stack/Upper/Work/Canvas/Hooks"
    } else if id.as_str() == "chips" {
        SHELL + "/Body/Centre/UpperRow/Stack/Upper/Work/Canvas/Stage/Chrome/Chips"
    } else if id.as_str() == "hud" {
        SHELL + "/Body/Centre/UpperRow/Hud"
    } else {
        ""
    };
    let found: any = scene::get_node(path);
    // A miss is not remembered: one transient failure would leave the box
    // inert for the rest of the session.
    if !util::is_nil(found) {
        m.get("nodes").set(id, found);
    }
    found
}

/// A box's `widget` component; empty when the tree has no such node.
fn widget_of(S: editor::State, id: str) -> any {
    let found = node(S, id);
    if util::is_nil(found) {
        return map();
    }
    util::obj(found.get_component("widget"))
}

/// The shell's own gutter: the scene's number, a step tighter in a small
/// window. Read by whoever needs the body's edge, so no two callers disagree.
pub fn gutter(S: editor::State) -> any {
    if S.compact { TIGHT_GUTTER } else { S.layout.gutter }
}

/// The seam between two sheets, the gutter's own step.
pub fn seam(S: editor::State) -> any {
    if S.compact { TIGHT_GAP } else { S.layout.gap }
}

/// What the shell spends on itself before a sheet gets anything: the gutter
/// either side, the two seams across and down, and the status strip inside
/// the bottom dock. Every floor subtracts it, so none of them promises room
/// the layout has already spent.
pub fn chrome(S: editor::State) -> Chrome {
    let edges = 2.0 * gutter(S).as_float() + 2.0 * seam(S).as_float();
    Chrome { w: edges, h: edges + S.layout.status_h }
}

/// What the scene states for one of a box's sizes. A `padding` is four sides
/// in the component whatever the scene spelled, so take the first.
fn stated(S: editor::State, id: str, key: str) -> float {
    let value = widget_of(S, id).get(key);
    if value.kind() == "list" { value.at(0).as_float() } else { value.as_float() }
}

/// One number off a theme role, or `fallback` where the role says nothing.
fn role_num(S: editor::State, role: str, key: str, fallback: float) -> float {
    let roles = S.theme.get("roles");
    let found = roles.get(role);
    if !found.is_nil() {
        let entry = found;
        let value = entry.get(key);
        if !value.is_nil() {
            let number = value;
            let px = style::px(S, number);
            return px;
        }
    }
    fallback
}

/// The scene's own numbers, read back once before anything writes over them.
/// Nothing outside `scenes/main.toml` may spell a resting shell size.
fn adopt(S: editor::State) {
    let m: any = S.layout;
    if m.get("asked").as_bool() {
        return;
    }
    let shell = widget_of(S, "shell");
    if shell.len() == 0 {
        return;
    }
    // The shell's gutter and seam are the theme's, so one file holds them and
    // a role a node takes cannot drift from the number this arithmetic uses.
    m.set("gutter", role_num(S, "layout_shell", "padding", 14.0));
    m.set("gap", role_num(S, "layout_shell", "gap", 12.0));
    m.set("pad", stated(S, "leftsheet", "padding"));
    m.set("tree_w", stated(S, "left", "width"));
    m.set("insp_w", stated(S, "right", "width"));
    m.set("status_h", stated(S, "status", "height"));
    m.set("dock_h", stated(S, "bottom", "height") - m.get("status_h").as_float());
    m.set("hooks_w", stated(S, "hooks", "width"));
    m.set("asked", true);
}

/// State a box's size, when it has moved. A component write rebuilds the
/// widget, so the same number twice is a write worth skipping.
// The boxes that travel when they change rather than jumping: a dock opening,
// the tool rail folding away, the hooks list arriving beside the code.
fn eased(mark: str) -> bool {
    eased_any_0(mark, ["left:width", "right:width", "bottom:height", "railslot:width", "hooks:width"])
}

fn eased_any_0(mark: str, items: [str]) -> bool {
    for m in items {
        if m == mark {
            return true;
        }
    }
    false
}

/// Whether the last layout wrote no box and nothing is moving. A box that
/// moved after it says so with `resized`, which lays the shell out again, so
/// one quiet layout is the shell at rest.
pub fn settled(S: editor::State) -> bool {
    let m: any = S.layout;
    if !m.get("asked").as_bool() || m.get("quiet").as_int() < 1 {
        return false;
    }
    !animating(S)
}

/// Every box whose `resized` lays the shell out again: the sheets a seam
/// drags, the columns a dock or the rail takes room from, and the strips
/// over the stage.
pub fn watched() -> [str] {
    let out: [str] = [];
    for id in [
        "shell",
        "head",
        "leftsheet",
        "rightsheet",
        "bottom",
        "rail",
        "railtop",
        "railslot",
        "centre",
        "canvas",
        "stage",
        "hooks",
        "upperrow",
        "chips",
        "hud",
    ] {
        out.push(id);
    }
    out
}

/// The node of one of those boxes, or nil before the shell has loaded.
pub fn box_node(S: editor::State, id: str) -> any {
    node(S, id)
}

/// Whether an eased box is still travelling. A tween moves the widget from
/// the animation stage, which no UI pass follows: the shell asks for one.
pub fn animating(S: editor::State) -> bool {
    let items1 = S.layout.tweens;
    for _i2 in items1.keys() {
        let handle = items1.get(_i2);
        if animation::is_tween_running(handle) {
            return true;
        }
    }
    false
}

/// Take back a size the pointer changed, so the next write agrees with it.
fn dragged(S: editor::State, id: str, key: str, into: str) {
    let m: any = S.layout;
    let mark = id + ":" + key;
    let running = m.get("tweens").get(mark);
    if !running.is_nil() {
        let handle = running;
        if animation::is_tween_running(handle) {
            return;
        }
    }
    let now = stated(S, id, key);
    if now > 0.0 && m.get("sent").get(mark) != now {
        m.set(into, now);
        m.get("sent").set(mark, now);
    }
}

// A dragged size, held between its floor and what the scene can spare. Kept
// on `S.layout` rather than clamped on the way out, so the next drag carries
// on from where this one stopped instead of from where the pointer went.
fn held(S: editor::State, key: str, floor: float, ceiling: float) -> any {
    let m: any = S.layout;
    m.set(key, util::clamp(m.get(key).as_float(), floor, util::max(floor, ceiling)));
    m.get(key)
}

fn size(S: editor::State, id: str, key: str, value: any) {
    let m: any = S.layout;
    let mark = id + ":" + key;
    if m.get("sent").get(mark) == value {
        return;
    }
    let found = node(S, id);
    if util::is_nil(found) {
        return;
    }
    // The first write places the box; a later one moves it. Easing the first
    // would mean watching the shell assemble itself on every start, and so
    // would easing the corrections it takes before the shell is formed.
    let settled = m.get("sent").has(mark) && S.formed;
    m.get("sent").set(mark, value);
    m.set("quiet", 0);
    if settled && eased(mark) {
        let running = m.get("tweens").get(mark);
        if !running.is_nil() {
            let handle = running;
            animation::stop(handle);
        }
        m.get("tweens").set(mark, animation::tween(found.as_node(), map().with("steps", [Step3 { property: "widget/" + key, to: value, duration: EASE_S, ease: animation::EASE_OUT_CUBIC }])));
        return;
    }
    let params = util::obj(found.get_component("widget"));
    params.set(key, value);
    found.set_component("widget", params);
}

/// Draw a box, or stop drawing it. Memoised like `size`, because a component
/// written every frame is a widget tree rebuilt every frame.
fn show(S: editor::State, id: str, on: bool) {
    let m: any = S.layout;
    let mark = id + ":visible";
    let want = if on { 1.0 } else { 0.0 };
    if m.get("sent").get(mark) == want {
        return;
    }
    let found = node(S, id);
    if util::is_nil(found) {
        return;
    }
    m.get("sent").set(mark, want);
    m.set("quiet", 0);
    found.patch_component("widget", map().with("visible", on));
}

/// Where a box was laid out, in design pixels; a zero rect until it has
/// drawn once, which is the frame before the editor's first.
fn box_of(S: editor::State, id: str) -> any {
    let found = node(S, id);
    if util::is_nil(found) {
        return rect(0.0, 0.0, 0.0, 0.0);
    }
    let drawn = ui::widget_rect(found.as_node());
    if drawn.is_none() {
        return rect(0.0, 0.0, 0.0, 0.0);
    }
    let r = drawn.unwrap();
    rect(r.x, r.y, r.width, r.height)
}

/// The sheets that can sit under the pointer, in draw order.
pub fn sheets(S: editor::State) -> [any] {
    let m: any = S.layout;
    // The status strip is inside the bottom dock, not a sheet of its own: the
    // dock already owns that rect and the pointer with it.
    let all = [m.get("bar"), m.get("left"), m.get("right"), m.get("bottom")];
    if S.rail_visible {
        all.push(m.get("rail"));
    }
    // Over the stage rather than beside it, and each zero on a frame it did
    // not draw.
    all.push(m.get("chips"));
    all.push(m.get("hud"));
    if S.doc_open {
        all.push(m.get("doc"));
    }
    if S.hooks_open {
        all.push(m.get("hooks"));
    }
    all
}

/// Rects for the current window, published as `S.layout`. Sizes are exact:
/// nothing hugs, because the stage is what is left over and a measured sheet
/// could not be subtracted from it.
pub fn compute(S: &mut editor::State) {
    let w = S.screen_w;
    let m: any = S.layout;
    adopt(S);
    // Before the shell tree resolves there is no size to state and no rect to
    // read; every surface guards on a zero rect and draws nothing.
    if !m.get("asked").as_bool() {
        return;
    }
    // Counted before the writes below, each of which puts it back to zero.
    m.set("quiet", m.get("quiet").as_float() + 1);
    // A seam the pointer moved wrote straight to the node, so the value it
    // left there is the new one to keep. A tween is this module's own doing
    // and is not mistaken for a drag.
    dragged(S, "left", "width", "tree_w");
    dragged(S, "right", "width", "insp_w");
    dragged(S, "bottom", "height", "dock_h");
    // A seam resizes and only resizes: a dock is put away by the mark in its
    // own tab row, so a drag that reaches the floor stops there. The ceiling is
    // what the other dock and the stage leave.
    let tree_w = side_w(S, "left", w, held(S, "tree_w", LEFT_MIN, w - STAGE_MIN - RIGHT_MIN).as_float());
    let insp_w = side_w(S, "right", w, held(S, "insp_w", RIGHT_MIN, w - STAGE_MIN - tree_w).as_float());
    let tall = if docks::bottom_tall(S).as_bool() { TALL_EXTRA } else { 0.0 };
    let body_h = held(S, "dock_h", BOTTOM_MIN, S.screen_h - m.get("bar").get("h").as_float() - STAGE_MIN - tall - m.get("status_h").as_float());
    // Minimised, the dock is gone: its handle sits beside the zoom reading,
    // the way each side dock's sits at the edge it folded towards.
    let dock_h = if docks::folded(S, "bottom") {
        0.0
    } else {
        body_h.as_float() + tall + m.get("status_h").as_float()
    };
    let grid = center::rail_grid(S, m.get("rail_room").as_float());
    let rail_w = if S.rail_visible { center::rail_span(grid, grid.cols) } else { 0.0 };
    let hooks_w = if S.hooks_open { m.get("hooks_w") } else { 0.0 };
    // The gutter round the shell and the seams between its sheets: a step
    // tighter in a small window, where they are most of what is on screen.
    let tight = S.compact;
    size(S, "shell", "padding", gutter(S));
    let gap = if tight { TIGHT_GAP } else { m.get("gap") };
    for id in ["body", "centre", "upperrow", "stack", "upper", "shell"] {
        size(S, id, "gap", [gap, gap]);
    }
    size(S, "left", "width", tree_w);
    size(S, "right", "width", insp_w);
    // Folded, a side dock's whole column goes. Not the sheet inside it: a
    // box left at zero width still takes the row's gap either side of it,
    // which is what stopped the centre reaching the window's own edge.
    for side in ["left", "right", "bottom"] {
        show(S, side, !docks::folded(S, side));
    }
    // One sheet at a time: a side sheet takes the whole body and the centre
    // goes, since a box left at zero width still takes the row's gap beside it.
    show(S, "centre", !(docks::one_at_a_time(S) && docks::side_open(S)));
    size(S, "bottom", "height", dock_h);
    size(S, "railslot", "width", rail_w);
    size(S, "rail", "height", center::rail_span(grid, grid.rows));
    // The folded left dock's handle sits above the tools, so the rail starts
    // below it rather than beside it.
    size(S, "railtop", "height", docks::rail_top_h(S));
    size(S, "hooks", "width", hooks_w);
    // The side docks' rule again: a zero-width box still takes its row's gap,
    // so the rail slot and the hooks list go rather than shrink.
    show(S, "railslot", rail_w > 0.0);
    show(S, "hooks", hooks_w.as_float() > 0.0);
    // Laid out after the frame's scripts, so a frame behind: a size that just
    // changed shows on the next one, the way `bar_fit` has always worked.
    let r = R {
        head: box_of(S, "head"),
        left: box_of(S, "leftsheet"),
        right: box_of(S, "rightsheet"),
        bottom: box_of(S, "bottom"),
        rail: box_of(S, "rail"),
        railtop: box_of(S, "railtop"),
        railslot: box_of(S, "railslot"),
        centre: box_of(S, "centre"),
        canvas: box_of(S, "canvas"),
        stage: box_of(S, "stage"),
        hooks: box_of(S, "hooks"),
        upperrow: box_of(S, "upperrow"),
        chips: box_of(S, "chips"),
        hud: box_of(S, "hud"),
    };
    // The sheet is its own box now, so a folded dock's rect is the square the
    // widget layer placed rather than one this module has to work out.
    m.set("left", r.left);
    m.set("right", r.right);
    m.set("bottom", r.bottom);
    m.set("hooks", r.hooks);
    m.set("upper", r.upperrow);
    // The two strips over the stage, as their nodes were laid out: a box the
    // pointer is over is chrome, not scene.
    let strips = S.viewport_live && S.stage_chrome;
    let foot = strips && !S.chrome_off;
    m.set("chips", if strips { r.chips } else { rect(0.0, 0.0, 0.0, 0.0) });
    m.set("hud", if foot { r.hud } else { rect(0.0, 0.0, 0.0, 0.0) });
    m.set("rail", r.rail);
    m.set("railtop", r.railtop);
    // The column the rail is in, not the whole centre: the dock below takes
    // its share of the centre, and a rail measured against that overran it.
    let column: float = if r.railslot.h > 0.0 { r.railslot.h } else { r.centre.h };
    // Less the folded dock's handle above it and the HUD strip under its foot.
    let hud = if S.stage_chrome && !S.chrome_off { center::hud_h(S) } else { 0.0 };
    m.set("rail_room", util::max(120.0, column - docks::rail_top_h(S) - hud));
    m.set("bar", r.head);
    // A document is not full-bleed: text under a sheet is unreadable. Sharing
    // with the scene puts the code on the right and the scene on the left.
    let box: Box = r.stage;
    m.set("stage_box", box);
    if S.doc_open && S.viewport_live {
        let code_w = util::clamp(m.get("split_w").as_float(), 260.0, util::max(260.0, box.w - 260.0));
        m.set("doc", rect(box.x + box.w - code_w, box.y, code_w, box.h));
        m.set("stage", rect(box.x, box.y, box.w - code_w - m.get("gap").as_float(), box.h));
    } else if S.doc_open {
        m.set("doc", box);
        m.set("stage", box);
    } else {
        // Nothing to read, so the scene takes the hooks list's width too.
        m.set("stage", r.canvas);
        m.set("doc", m.get("stage"));
    }
    // The scene's rect under its old name; `at` is the frame it was set on, so
    // a self-test can tell a headless run from a drawn one. An unplaced stage
    // is not published: a played game's HUD would blink out for that frame.
    if m.get("stage").get("w").as_float() > 0.0 && m.get("stage").get("h").as_float() > 0.0 {
        S.viewport = editor::Viewport {
            x: m.get("stage").get("x").as_float(),
            y: m.get("stage").get("y").as_float(),
            w: m.get("stage").get("w").as_float(),
            h: m.get("stage").get("h").as_float(),
            at: S.frame,
        };
    }
    // A dock's width decides how many of its tabs fit.
    signals::docks(S);
}

// A side dock's width: nothing when it holds no panel, its rail when it is
// folded, and what the seam was dragged to otherwise.
/// The least screen that holds one side dock beside a stage worth having,
/// as a width; and down, the bar, the bottom dock and the stage. Below
/// either, the shell is one sheet at a time.
pub fn floors(S: editor::State) -> Floors {
    // The stage's own floor down the screen, not the seam's: a dock shrinks
    // to `BOTTOM_MIN` before the stage is asked to give anything up, so a
    // laptop window keeps all three docks rather than folding to one.
    let spent = chrome(S);
    Floors { _0: util::max(LEFT_MIN, RIGHT_MIN) + STAGE_MIN + spent.w, _1: BAR_H_GUESS + BOTTOM_MIN + center::stage_floor().h + spent.h }
}

/// The box the engine gave the shell, in design px, or zeros before it has
/// drawn. `fill` and `safe_area` decide it, so nothing here restates it.
pub fn shell_room(S: editor::State) -> ShellRoom {
    let node = scene::get_node(SHELL);
    let drawn = if node.is_valid() { ui::widget_rect(node) } else { nil };
    if drawn.is_none() {
        return ShellRoom { _0: 0.0, _1: 0.0 };
    }
    ShellRoom { _0: drawn.unwrap().width, _1: drawn.unwrap().height }
}

/// Whether three columns fit across: both side docks and the stage at their
/// floors. Below this the side docks start folded and an open one takes half.
pub fn three_fit(S: editor::State) -> bool {
    S.screen_w >= LEFT_MIN + STAGE_MIN + RIGHT_MIN + chrome(S).w
}

// The bar's height before its node has been measured, for the floor above:
// the head sheet as the scene states it.
const BAR_H_GUESS: float = 43.0;

/// The room the docks leave the stage, as `#{ w, h }` in design pixels,
/// from the same widths the layout is about to use. Asked before the layout
/// runs, by everything that shows only where there is room for it.
pub fn stage_room(S: editor::State) -> Room {
    let m: any = S.layout;
    let w = S.screen_w;
    let tree_w = side_w(S, "left", w, util::max(m.get("tree_w"), LEFT_MIN).as_float());
    let insp_w = side_w(S, "right", w, util::max(m.get("insp_w"), RIGHT_MIN).as_float());
    let dock_h = if docks::folded(S, "bottom") {
        0.0
    } else {
        util::max(m.get("dock_h"), BOTTOM_MIN) + m.get("status_h")
    };
    // Less what the shell spends on itself: the room a rail or a chip strip
    // is offered is the room it will actually be drawn in.
    let spent = chrome(S);
    Room { w: w - tree_w - insp_w - spent.w, h: S.screen_h - m.get("bar").get("h").as_float() - dock_h.as_float() - spent.h }
}

/// How wide an open side dock is: what the seam was dragged to on a screen
/// with room for three columns, and most of the screen on one without.
///
/// A dock a reader had to unfold on purpose is one they want to read, and a
/// 220 px column of it on a phone is a list of truncated words. The stage
/// keeps a strip, so it is still there to go back to.
fn side_w(S: editor::State, side: str, room: float, open_w: float) -> float {
    if S.docks.get(side).tabs.len() == 0 || S.docks.get(side).shut {
        return 0.0;
    }
    // One sheet at a time takes the whole body: its own fold is the way back,
    // and a strip of stage beside it is dead space once nothing sits on it.
    // Less the shell's gutter each side, which is the body's, not the sheet's.
    if docks::one_at_a_time(S) {
        return room - 2.0 * gutter(S).as_float();
    }
    // Where a dock and the stage fit but not two docks, the open one takes
    // half: the seam's own width was set beside two columns, not one. Both
    // open, they keep their stated widths, or half each would leave no stage.
    if !three_fit(S) && !both_sides_open(S) {
        return util::clamp(room * 0.5, open_w, room - MEDIUM_PEEK);
    }
    open_w
}

/// Whether the left and right docks are both showing a panel.
fn both_sides_open(S: editor::State) -> bool {
    !docks::folded(S, "left") && !docks::folded(S, "right")
}

/// What one workspace pill is estimated at, for the showcase's pointer.
pub fn workspace_w(S: editor::State) -> float {
    if S.compact { 40.0 } else { 76.0 }
}

/// Whether `x`,`y` in design px is over a sheet. Under Stage the scene is the
/// whole window, so a viewport tool asks this instead of testing itself
/// against a hole in the chrome.
pub fn over_sheet(S: editor::State, x: float, y: float) -> bool {
    for r in sheets(S) {
        if r.get("w").as_float() > 0.0 && r.get("h").as_float() > 0.0 && x >= r.get("x").as_float() && x <= (r.get("x") + r.get("w")).as_float() && y >= r.get("y").as_float() && y <= (r.get("y") + r.get("h")).as_float() {
            return true;
        }
    }
    false
}
