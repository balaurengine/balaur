// The Events view, which authors rather than lists: one row per
// `[[nodes.bindings.rows]]` entry, and the script each row is equivalent to.

use editor;
use history;
use icons;
use inspector;
use model;
use shell;
use signals;
use util;
use words::components;
use words::fields;
use words::hooks;
use words::inspector_fields;
use words::layout_fields;
use words::project_fields;
use words::roles;
use words::tabs;
use words::verbs;

const ADD_VARIABLE: str = "add_variable";
const CALL: str = "call";
const EMIT: str = "emit";
const FALSE: str = "false";
const FREE: str = "free";
const INSTANTIATE: str = "instantiate";
const ON_ACTION: str = "on_action";
const ON_COLLISION_ENTER: str = "on_collision_enter";
const ON_COLLISION_EXIT: str = "on_collision_exit";
const ON_KEY_DOWN: str = "on_key_down";
const ON_KEY_UP: str = "on_key_up";
const ON_POINTER_CLICK: str = "on_pointer_click";
const ON_POINTER_DOWN: str = "on_pointer_down";
const ON_POINTER_DRAG: str = "on_pointer_drag";
const ON_POINTER_DROP: str = "on_pointer_drop";
const ON_POINTER_UP: str = "on_pointer_up";
const ON_RESIZE: str = "on_resize";
const ON_SCROLL: str = "on_scroll";
const ON_STATE_CHANGED: str = "on_state_changed";
const ON_VARIABLE_CHANGED: str = "on_variable_changed";
const OPEN_URL: str = "open_url";
const PLAY_SOUND: str = "play_sound";
const SET_STATE: str = "set_state";
const SET_VARIABLE: str = "set_variable";
const SWITCH: str = "switch";
const TRUE: str = "true";
const ACTION: str = "action";
const EVENT: str = "event";
const TARGET: str = "target";
const VALUE: str = "value";
const WHEN: str = "when";

pub class EventsState {
    picking: int?,
}

pub fn state() -> EventsState {
    // The row waiting for a node to be clicked in the tree, nil when nothing
    // is picking.
    EventsState { picking: nil }
}

/// The rows on the selected node. A hand-written file spells them
/// `[[nodes.bindings.rows]]`, and one the editor has saved spells them under
/// `rows`; both are the same list.
pub fn rows(state: editor::State) -> any {
    let found = model::selected_node(state);
    let held = if found.is_valid() { found.authored(COMPONENT) } else { nil };
    if held.kind() == types::KIND_MAP { util::list_or_empty(held[fields::ROWS]) } else { util::list_or_empty(held) }
}

/// The component a node's bindings are.
const COMPONENT: str = "bindings";

fn write(state: &mut editor::State, rows: any, label: str) {
    let found = model::selected_node(state);
    if !found.is_valid() {
        return;
    }
    history::record(state, label);
    if rows.len() == 0 {
        if found.has_component(COMPONENT) {
            found.remove_component(COMPONENT);
        }
    } else {
        found.set_component(COMPONENT, { fields::ROWS: rows });
    }
    history::commit(state);
}

/// The rows to change: `rows` reads them afresh from the node, so a change
/// to this list is the edit's own until `write` hands it over.
fn editable(state: editor::State) -> any {
    rows(state)
}

// The event a new row answers to, and the prefix a hook's name carries.
const DEFAULT_EVENT: str = "pointer_click";

const HOOK_PREFIX: str = "on_";

pub fn add_row(state: &mut editor::State) {
    let rows = editable(state);
    rows.push({ EVENT: DEFAULT_EVENT, ACTION: SET_STATE, inspector_fields::TARGET: "", fields::VALUE: "" });
    write(state, rows, "add binding");
}

pub fn remove_row(state: &mut editor::State, at: int) {
    let rows = editable(state);
    if at >= rows.len() {
        return;
    }
    rows.remove(at);
    write(state, rows, "remove binding");
}

fn set_field(state: &mut editor::State, at: int, key: str, value: str) {
    let rows = editable(state);
    if at >= rows.len() {
        return;
    }
    if value == "" && key != inspector::VALUE {
        rows[at].remove(key);
    } else {
        rows[at][key] = value;
    }
    write(state, rows, "edit binding");
}

/// The node paths a target picker offers: every node in the scene, spelled
/// from the bound node, plus the empty path that means the node itself.
fn target_paths(state: editor::State) -> [str] {
    let out = ["(this node)"];
    for found in state.nodes {
        let path = model::path_in_scene(state, found);
        if path != "" {
            out.push(path);
        }
    }
    out
}

/// The variables a `set_variable` row targets.
fn variable_names(state: editor::State) -> [str] {
    let out: [str] = [];
    for entry in scene::variables() {
        out.push(entry.name);
    }
    out
}

const ROW_HEIGHT: float = 26.0;

fn as_text(value: any) -> str {
    if value == nil {
        ""
    } else if value.kind() == types::KIND_STRING {
        value.as_str()
    } else {
        "{value}"
    }
}

/// Whether an action's `target` names a variable rather than a node.
fn targets_a_variable(action: str) -> bool {
    action == SET_VARIABLE || action == ADD_VARIABLE
}

// A dropdown over one of a row's fields.
fn pick(state: editor::State, at: int, key: str, current: str, choices: [str], width: float) -> ui::Control {
    ui::Control {
        kind: ui::WIDGET_DROPDOWN,
        role: roles::CHOICE_FORM,
        width: width,
        text: current,
        options: choices,
        on_change: "handle",
        data: { fields::FN: on_field_picked, layout_fields::AT: at, fields::KEY: key },
    }
}

fn on_field_picked(state: &mut editor::State, data: any, picked: any) {
    set_field(state, data[layout_fields::AT].as_int(), data[fields::KEY].as_str(), picked.as_str());
}

// A field over one of a row's fields, written on Enter rather than per key.
fn typed(state: editor::State, at: int, key: str, current: str, placeholder: str, width: float) -> ui::Control {
    ui::Control {
        kind: ui::WIDGET_TEXT_FIELD,
        role: roles::INPUT_FORM,
        width: width,
        text: current,
        placeholder: placeholder,
        on_submit: "handle_submit",
        data: { project_fields::SUBMIT: on_field_typed, inspector_fields::CURRENT: current, layout_fields::AT: at, fields::KEY: key },
    }
}

fn on_field_typed(state: &mut editor::State, data: any, text: any) {
    if text.as_str() != data[inspector_fields::CURRENT].as_str() {
        set_field(state, data[layout_fields::AT].as_int(), data[fields::KEY].as_str(), text.as_str());
    }
}

// What a row on the selected node may answer: the core hooks, and the
// `emitted:` events the node and its components announce.
fn offered(state: editor::State) -> [str] {
    scene::bindable_events(model::selected_node(state))
}

/// One binding: what happens, when, and what it does.
fn row_spec(state: editor::State, at: int, row: any) -> ui::Row {
    let event = event_of(row);
    let action = action_of(row);
    let target = row[inspector_fields::TARGET].as_str();
    let controls: [ui::Control] = [
        ui::Control { kind: ui::WIDGET_LABEL, role: roles::TEXT_CAPTION, width: 18, text: "{at + 1}" },
        pick(state, at, EVENT, event, offered(state), 150.0),
        typed(state, at, WHEN, row[fields::WHEN].as_str(), "always", 130.0),
        ui::Control { kind: ui::WIDGET_LABEL, role: roles::TEXT_CAPTION, text: "→" },
        pick(state, at, ACTION, action, scene::binding_actions(), 130.0),
    ];
    if targets_a_variable(action) {
        controls.push(pick(state, at, TARGET, if target == "" { "—" } else { target }, variable_names(state), 120.0));
    } else {
        controls.push(ui::Control {
            kind: ui::WIDGET_DROPDOWN,
            role: roles::CHOICE_FORM,
            width: 140,
            text: if target == "" { "(this node)" } else { target },
            options: target_paths(state),
            on_change: "handle",
            data: { fields::FN: on_target_picked, layout_fields::AT: at },
        });
    }
    controls.push(typed(state, at, VALUE, as_text(row[fields::VALUE]), VALUE, 110.0));
    controls.push(ui::Control {
        kind: ui::WIDGET_BUTTON,
        role: roles::CHIP_QUIET,
        text: icons::ui(icons::CLOSE),
        tooltip: "Remove this binding",
        on_click: "handle",
        data: { fields::FN: on_remove_clicked, layout_fields::AT: at },
    });
    ui::Row { height: ROW_HEIGHT, slot_role: roles::LAYOUT_ACTIONS, controls: controls }
}

fn on_target_picked(state: &mut editor::State, data: any, picked: any) {
    let path = picked.as_str();
    set_field(state, data[layout_fields::AT].as_int(), TARGET, if path == "(this node)" { "" } else { path });
}

fn on_remove_clicked(state: &mut editor::State, data: any, _value: any) {
    remove_row(state, data[layout_fields::AT].as_int());
}

fn event_of(row: any) -> str {
    if row[EVENT] == nil { DEFAULT_EVENT } else { row[EVENT].as_str() }
}

fn action_of(row: any) -> str {
    if row[ACTION] == nil { SET_STATE } else { row[ACTION].as_str() }
}

// The prefix an event row carries for what its own node emits by name.
pub const EMITTED: str = "emitted:";

/// The script a node's rows are equivalent to, which is what "Convert to
/// script" writes: one method a hook, one line a row, spelling the call the
/// interpreter makes, so a scene that outgrows the table graduates without a
/// rewrite.
pub fn as_script(state: editor::State) -> str {
    script_of(util::class_of(script_path(state)), rows(state))
}

// The file "Convert to script" writes for the selected node.
fn script_path(state: editor::State) -> str {
    "scripts/{model::selected_node(state).name().to_lower()}_events.bs"
}

/// The same, for any list of rows, as the class `class_name`.
pub fn script_of(class_name: str, rows: any) -> str {
    let byhook: any = {};
    // An `emitted:<name>` row hears the node's own event, which a script only
    // hears once it subscribes to it.
    let heard: [str] = [];
    for row in rows {
        let event = event_of(row);
        let own = event.starts_with(EMITTED);
        let name = if own { event.slice(EMITTED.len(), event.len()) } else { event };
        if own && !util::contains(heard, name) {
            heard.push(name);
        }
        let hook = HOOK_PREFIX + name;
        if !byhook.has(hook) {
            let none: [any] = [];
            byhook[hook] = none;
        }
        byhook[hook].push(row);
    }
    let out = "// Written from this node's event bindings.\n\npub class {class_name} {{\n    node: Node,\n}}\n\nimpl {class_name} {{\n";
    if heard.len() > 0 {
        out += "    fn init() {{\n";
        for name in heard {
            out += "        events::listen(self.node, \"{name}\", self.node);\n";
        }
        out += "    }}\n";
    }
    let first = heard.len() == 0;
    for hook in util::keys_sorted(byhook) {
        let own = util::contains(heard, hook.slice(HOOK_PREFIX.len(), hook.len()));
        let arguments = if own { "payload: any" } else { hook_arguments(hook) };
        out += (if first { "" } else { "\n" }) + "    pub fn {hook}({arguments}) {{\n";
        first = false;
        for row in byhook[hook] {
            out += "        " + guarded(row) + "\n";
        }
        out += "    }}\n";
    }
    out + "}}\n"
}

/// The arguments each hook is handed, so the written method's signature is
/// the one the engine calls.
fn hook_arguments(hook: str) -> str {
    if hook == ON_POINTER_DOWN || hook == ON_POINTER_UP || hook == ON_POINTER_CLICK {
        "button: any"
    } else if hook == ON_POINTER_DRAG || hook == ON_SCROLL {
        "dx: float, dy: float"
    } else if hook == ON_POINTER_DROP {
        "dropped: any"
    } else if hook == ON_KEY_DOWN || hook == ON_KEY_UP {
        "key: str"
    } else if hook == ON_ACTION {
        "action: str"
    } else if hook == ON_RESIZE {
        "width: float, height: float"
    } else if hook == ON_VARIABLE_CHANGED {
        "name: str, value: any"
    } else if hook == ON_STATE_CHANGED {
        "from: str, to: str"
    } else if hook == ON_COLLISION_ENTER || hook == ON_COLLISION_EXIT {
        "collision: any"
    } else {
        ""
    }
}

fn guarded(row: any) -> str {
    let call = as_call(row);
    let when = row[fields::WHEN].as_str();
    if when == "" {
        return call;
    }
    "if {condition(when)} {{ {call} }}"
}

/// A condition rewritten as a script's: every bare name becomes the read that
/// fetches it, as the kind it is compared with.
fn condition(when: str) -> str {
    let clauses: [str] = [];
    for clause in when.split("&&") {
        clauses.push(clause_of(clause));
    }
    util::join(clauses, " && ")
}

fn clause_of(clause: str) -> str {
    let text = clause.trim();
    for operator in [">=", "<=", "==", "!=", ">", "<"] {
        let found = util::index_of(text, operator);
        if found != nil {
            let at = found.unwrap();
            let name = text.slice(0, at).trim();
            let rest = text.slice(at + operator.len(), text.len()).trim();
            return "scene::variable(\"{name}\").{read_as(rest)} {operator} {rest}";
        }
    }
    "scene::variable(\"{text}\").as_bool()"
}

// How a variable is read to compare with `rest`, as the script writes it.
fn read_as(rest: str) -> str {
    if rest == TRUE || rest == FALSE {
        "as_bool()"
    } else if numeric(rest) {
        "as_float()"
    } else {
        "as_str()"
    }
}

fn as_call(row: any) -> str {
    let action = action_of(row);
    let target = row[inspector_fields::TARGET].as_str();
    let value = as_text(row[fields::VALUE]);
    let node = if target == "" { "self.node" } else { "self.node.get_node(\"{target}\")" };
    if action == SET_STATE {
        "{node}.states.set_state(\"{value}\");"
    } else if action == SET_VARIABLE {
        "scene::set_variable(\"{target}\", {literal(value)});"
    } else if action == ADD_VARIABLE {
        "scene::set_variable(\"{target}\", scene::variable(\"{target}\").as_float() + {literal(value)});"
    } else if action == verbs::PLAY {
        "{node}.animation.play(\"{value}\");"
    } else if action == PLAY_SOUND {
        "{node}.sound.play();"
    } else if action == INSTANTIATE {
        "scene::instantiate(fs::read(\"{value}\").or(\"\"), {node});"
    } else if action == FREE {
        "{node}.queue_free();"
    } else if action == SWITCH {
        "scene::switch(\"{value}\", nil);"
    } else if action == OPEN_URL {
        "engine::open_url(\"{value}\");"
    } else if action == EMIT {
        "{node}.emit(\"{value}\", nil);"
    } else if action == CALL {
        "{node}.call(\"{value}\");"
    } else if action == components::VISIBLE {
        "{node}.set_visible({literal(value)});"
    } else {
        "// no call for `{action}`"
    }
}

// Whether a written value is a number.
fn numeric(value: str) -> bool {
    if value == "" {
        return false;
    }
    for character in value.chars() {
        if !"0123456789.-".contains(character) {
            return false;
        }
    }
    true
}

/// A written value as script source: a number and a bool stay as they are,
/// and everything else is a string.
fn literal(value: str) -> str {
    if value == TRUE || value == FALSE || numeric(value) {
        return value;
    }
    "\"{value}\""
}

/// Write the script this node's bindings are equivalent to, attach it, and
/// open it. The rows stay: deleting them is the author's call, once they have
/// read what was written.
pub fn convert_to_script(state: &mut editor::State) {
    if !model::has_selection(state) {
        return;
    }
    if rows(state).len() == 0 {
        log::info("this node has no bindings to convert");
        return;
    }
    let found = model::selected_node(state);
    let rel = script_path(state);
    fs::write(state.game_root + "/" + rel, as_script(state));
    model::forget(state);
    history::record(state, "convert bindings to a script");
    found.set_script(rel, {});
    history::commit(state);
    state.shader_rel = "";
    signals::inspector(state);
    shell::open_doc(state, tabs::SCRIPT);
    log::info("wrote " + rel);
}

/// The node the document area hands a tab whose rows are nodes.
const PANEL: str = "Editor/Shell/Body/Centre/UpperRow/Stack/Upper/Work/Canvas/Stage/DocPanel";

/// Where the rows go, which the self-test reads back.
pub fn rows_host() -> str {
    PANEL + "/DocScroll/DocRows"
}

/// The document tab: the selected node's rows, and the variables they read,
/// up while the Events tab is; what its script asks for when the node or
/// the tab moved.
pub fn fill(state: &mut editor::State) {
    let up = state.doc_open && state.doctab == tabs::EVENTS;
    util::set_visible(PANEL, up);
    if !up {
        return;
    }
    let node = model::selected_node(state);
    ui::fill_strip(PANEL + "/DocHead", [
        ui::Control { kind: ui::WIDGET_LABEL, role: roles::TEXT_HEADING, grow: 1, text: "EVENT BINDINGS · {node.name()}" },
        ui::Control {
            kind: ui::WIDGET_BUTTON,
            role: roles::ACTION_FORM_SECONDARY,
            text: "‹›  Convert to script",
            on_click: "handle",
            data: { fields::FN: on_convert_clicked },
        },
        ui::Control {
            kind: ui::WIDGET_BUTTON,
            role: roles::ACTION_FORM_PRIMARY,
            text: icons::ui(icons::ADD) + "  Add row",
            on_click: "handle",
            data: { fields::FN: on_add_row_clicked },
        },
    ]);
    let specs: [ui::Row] = [];
    let held = rows(state);
    if held.len() == 0 {
        specs.push(note("no bindings on this node yet"));
    }
    for at in 0..held.len() {
        specs.push(row_spec(state, at, util::map_or_empty(held[at])));
    }
    variable_specs(state, specs);
    hook_specs(state, specs);
    ui::fill_rows(rows_host(), specs);
}

fn on_convert_clicked(state: &mut editor::State, data: any, _value: any) {
    convert_to_script(state);
}

fn on_add_row_clicked(state: &mut editor::State, data: any, _value: any) {
    add_row(state);
}

fn note(text: str) -> ui::Row {
    ui::Row {
        height: 0,
        controls: [
            ui::Control {
                kind: ui::WIDGET_LABEL,
                role: roles::TEXT_CAPTION,
                grow: 1,
                wrap: true,
                text: text,
            },
        ],
    }
}

fn head(text: str) -> ui::Row {
    ui::Row {
        height: 26,
        controls: [
            ui::Control {
                kind: ui::WIDGET_LABEL,
                role: roles::TEXT_HEADING,
                grow: 1,
                text: text.to_upper(),
            },
        ],
    }
}

/// What the scene declares, so a `when` has something to name. Read-only: a
/// variable is declared in the scene file's `[variables]`.
fn variable_specs(state: editor::State, out: [ui::Row]) {
    out.push(head("scene variables"));
    let declared = scene::variables();
    if declared.len() == 0 {
        out.push(note("none; declare them under [variables] in the scene file"));
        return;
    }
    for entry in declared {
        out.push(ui::Row {
            height: 24,
            slot_role: roles::LAYOUT_ACTIONS,
            controls: [
                ui::Control { kind: ui::WIDGET_LABEL, role: roles::TEXT_CODE, text: entry.name },
                ui::Control { kind: ui::WIDGET_LABEL, role: roles::TEXT_CAPTION, text: entry.type },
                ui::Control { kind: ui::WIDGET_ROW, grow: 1 },
                ui::Control { kind: ui::WIDGET_LABEL, role: "text_code_success", text: "{entry.value}" },
            ],
        });
    }
}

/// The hooks the node's own script declares, which is what this view used to
/// be and is still worth showing beside the rows.
fn hook_specs(state: &mut editor::State, out: [ui::Row]) {
    let node = model::selected_node(state);
    let script_or = model::script_rel(node);
    if script_or == nil {
        return;
    }
    let script = script_or.as_str();
    out.push(head("script hooks"));
    for hook in model::hooks(state, script) {
        let name = hook[fields::NAME].as_str();
        let lifecycle = name == hooks::INIT || name == hooks::UPDATE;
        out.push(ui::Row {
            height: 28,
            controls: [
                ui::Control {
                    kind: ui::WIDGET_ROW,
                    role: "sheet_hook",
                    controls: [
                        ui::Control {
                            kind: ui::WIDGET_LABEL,
                            text: "•",
                            role: if lifecycle { "text_mark_primary" } else { "text_mark_secondary" },
                        },
                        ui::Control { kind: ui::WIDGET_LABEL, text: "{node.name()}.{name}()", role: roles::TEXT_CODE },
                        ui::Control { kind: ui::WIDGET_ROW, grow: 1 },
                        ui::Control { kind: ui::WIDGET_LABEL, text: "{script}:{hook["line"]}", role: "text_caption" },
                    ],
                },
            ],
        });
    }
}
