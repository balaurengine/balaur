// The Events view, which authors rather than lists: one row per
// `[[nodes.bindings.rows]]` entry, and the script each row is equivalent to.

use editor;
use history;
use icons;
use model;
use pool;
use shell;
use signals;
use util;

pub class EventsState {
    picking: int?,
}

pub fn state() -> EventsState {
    // The row waiting for a node to be clicked in the tree, nil when nothing
    // is picking.
    EventsState { picking: nil }
}

/// The rows on the selected node. A hand-written file spells them
/// `[[nodes.bindings.rows]]`, and one the editor has saved spells them under
/// `rows`; both are the same list.
pub fn rows(S: editor::State) -> any {
    let node = model::selected_row(S);
    let held = if node.is_nil() { nil } else { node.bindings };
    if held.kind() == "map" { util::vec(held.rows) } else { util::vec(held) }
}

fn write(S: &mut editor::State, rows: any, label: str) {
    if !model::has_selection(S) {
        return;
    }
    history::record(S, label, nil);
    let node = S.doc[S.sel];
    if rows.len() == 0 {
        node.remove("bindings");
    } else {
        node.set("bindings", map().with("rows", rows));
    }
    model::record_override(S, node, "bindings");
    model::apply_component(S, "bindings");
    history::commit(S);
}

/// A copy of the rows, so a mutation lands after the history step rather than
/// before it: `rows` hands back the document's own list.
fn editable(S: editor::State) -> any {
    util::deep(rows(S))
}

// The event a new row answers to, and the prefix a hook's name carries.
const DEFAULT_EVENT: str = "pointer_click";

const HOOK_PREFIX: str = "on_";

pub fn add_row(S: &mut editor::State) {
    let rows = editable(S);
    rows.push(map().with("event", DEFAULT_EVENT).with("action", "set_state").with("target", "").with("value", ""));
    write(S, rows, "add binding");
}

pub fn remove_row(S: &mut editor::State, at: int) {
    let rows = editable(S);
    if at >= rows.len() {
        return;
    }
    rows.remove(at);
    write(S, rows, "remove binding");
}

fn set_field(S: &mut editor::State, at: int, key: str, value: str) {
    let rows = editable(S);
    if at >= rows.len() {
        return;
    }
    if value == "" && key != "value" {
        rows.at(at).remove(key);
    } else {
        rows.at(at).set(key, value);
    }
    write(S, rows, "edit binding");
}

/// The node paths a target picker offers: every node in the scene, spelled
/// from the bound node, plus the empty path that means the node itself.
fn target_paths(S: editor::State) -> [str] {
    let out = ["(this node)"];
    for node in S.doc {
        let path = model::node_path(S.doc, node);
        if path != "" {
            out.push(path);
        }
    }
    out
}

/// The variables a `set_variable` row targets.
fn variable_names(S: editor::State) -> [str] {
    let out: [str] = [];
    for entry in scene::variables() {
        out.push(entry.name);
    }
    out
}

const ROW_H: float = 26.0;

fn as_text(value: any) -> str {
    if value.is_nil() {
        ""
    } else if value.kind() == "str" {
        value.as_str()
    } else {
        "{value}"
    }
}

/// Whether an action's `target` names a variable rather than a node.
fn targets_a_variable(action: str) -> bool {
    action == "set_variable" || action == "add_variable"
}

// A dropdown over one of a row's fields.
fn pick(S: editor::State, at: int, key: str, current: str, choices: [str], width: float) -> any {
    map()
        .with("kind", "dropdown")
        .with("role", "choice_form")
        .with("width", width)
        .with("text", current)
        .with("options", choices)
        .with("on", "handle")
        .with("data", map().with("fn", pick_on_0).with("at", at).with("key", key))
}

fn pick_on_0(S: &mut editor::State, data: any, picked: any) {
    set_field(S, data.at.as_int(), data.key.as_str(), picked.as_str());
}

// A field over one of a row's fields, written on Enter rather than per key.
fn typed(S: editor::State, at: int, key: str, current: str, placeholder: str, width: float) -> any {
    map()
        .with("kind", "text_field")
        .with("role", "input_form")
        .with("width", width)
        .with("text", current)
        .with("placeholder", placeholder)
        .with("on_submit", "handle_submit")
        .with("data", map().with("submit", typed_on_1).with("current", current).with("at", at).with("key", key))
}

fn typed_on_1(S: &mut editor::State, data: any, text: any) {
    if text.as_str() != data.current.as_str() {
        set_field(S, data.at.as_int(), data.key.as_str(), text.as_str());
    }
}

// What a row on the selected node may answer: the core hooks, and the
// `emitted:` events the node and its components announce.
fn offered(S: editor::State) -> [str] {
    scene::bindable_events(model::live(S, S.sel))
}

/// One binding: what happens, when, and what it does.
fn row_spec(S: editor::State, at: int, row: any) -> any {
    let event = event_of(row);
    let action = action_of(row);
    let target = row.target.as_str();
    let controls = [
        map().with("kind", "label").with("role", "text_caption").with("width", 18).with("text", "{at + 1}"),
        pick(S, at, "event", event, offered(S), 150.0),
        typed(S, at, "when", row.when.as_str(), "always", 130.0),
        map().with("kind", "label").with("role", "text_caption").with("text", "→"),
        pick(S, at, "action", action, scene::binding_actions(), 130.0),
    ];
    if targets_a_variable(action) {
        controls.push(pick(S, at, "target", if target == "" { "—" } else { target }, variable_names(S), 120.0));
    } else {
        controls.push(map()
            .with("kind", "dropdown")
            .with("role", "choice_form")
            .with("width", 140)
            .with("text", if target == "" { "(this node)" } else { target })
            .with("options", target_paths(S))
            .with("on", "handle")
            .with("data", map().with("fn", row_spec_on_2).with("at", at)));
    }
    controls.push(typed(S, at, "value", as_text(row.value), "value", 110.0));
    controls.push(map()
        .with("kind", "button")
        .with("role", "chip_quiet")
        .with("text", icons::ui("close"))
        .with("tooltip", "Remove this binding")
        .with("on", "handle")
        .with("data", map().with("fn", row_spec_on_3).with("at", at)));
    map().with("full", true).with("height", ROW_H).with("slot_role", "layout_actions").with("controls", controls)
}

fn row_spec_on_2(S: &mut editor::State, data: any, picked: any) {
    let path = picked.as_str();
    set_field(S, data.at.as_int(), "target", if path == "(this node)" { "" } else { path });
}

fn row_spec_on_3(S: &mut editor::State, data: any, _0: any) {
    remove_row(S, data.at.as_int());
}

fn event_of(row: any) -> str {
    if row.event.is_nil() { DEFAULT_EVENT } else { row.event.as_str() }
}

fn action_of(row: any) -> str {
    if row.action.is_nil() { "set_state" } else { row.action.as_str() }
}

// The prefix an event row carries for what its own node emits by name.
pub const EMITTED: str = "emitted:";

/// The script a node's rows are equivalent to, which is what "Convert to
/// script" writes: one method a hook, one line a row, spelling the call the
/// interpreter makes, so a scene that outgrows the table graduates without a
/// rewrite.
pub fn as_script(S: editor::State) -> str {
    script_of(rows(S))
}

/// The same, for any list of rows.
pub fn script_of(rows: any) -> str {
    let byhook = map();
    // An `emitted:<name>` row hears the node's own event, which a script only
    // hears once it subscribes to it.
    let heard: [str] = [];
    for row in rows {
        let event = event_of(row);
        let own = event.starts_with(EMITTED);
        let name = if own { event.slice(EMITTED.len(), event.len()) } else { event };
        if own && !util::contains(heard, name) {
            heard.push(name);
        }
        let hook = HOOK_PREFIX + name;
        if !byhook.has(hook) {
            let none: [any] = [];
            byhook.set(hook, none);
        }
        byhook.get(hook).push(row);
    }
    let out = "// Written from this node's event bindings.\n\npub struct Events {{\n    node: Node,\n}}\n\nimpl Events {{\n";
    if heard.len() > 0 {
        out += "    fn init() {{\n";
        for name in heard {
            out += "        events::listen(self.node, \"{name}\", self.node);\n";
        }
        out += "    }}\n";
    }
    let first = heard.len() == 0;
    for hook in util::keys_sorted(byhook) {
        let own = util::contains(heard, hook.slice(HOOK_PREFIX.len(), hook.len()));
        let args = if own { "payload: any" } else { hook_args(hook) };
        out += (if first { "" } else { "\n" }) + "    pub fn {hook}({args}) {{\n";
        first = false;
        for row in byhook.get(hook) {
            out += "        " + guarded(row) + "\n";
        }
        out += "    }}\n";
    }
    out + "}}\n"
}

/// The arguments each hook is handed, so the written method's signature is
/// the one the engine calls.
fn hook_args(hook: str) -> str {
    if hook == "on_pointer_down" || hook == "on_pointer_up" || hook == "on_pointer_click" {
        "button: any"
    } else if hook == "on_pointer_drag" || hook == "on_scroll" {
        "dx: float, dy: float"
    } else if hook == "on_pointer_drop" {
        "dropped: any"
    } else if hook == "on_key_down" || hook == "on_key_up" {
        "key: str"
    } else if hook == "on_action" {
        "action: str"
    } else if hook == "on_resize" {
        "width: float, height: float"
    } else if hook == "on_variable_changed" {
        "name: str, value: any"
    } else if hook == "on_state_changed" {
        "from: str, to: str"
    } else if hook == "on_collision_enter" || hook == "on_collision_exit" {
        "collision: any"
    } else {
        ""
    }
}

fn guarded(row: any) -> str {
    let call = as_call(row);
    let when = row.when.as_str();
    if when == "" {
        return call;
    }
    "if {condition(when)} {{ {call} }}"
}

/// A condition rewritten as a script's: every bare name becomes the read that
/// fetches it, as the kind it is compared with.
fn condition(when: str) -> str {
    let clauses: [str] = [];
    for clause in when.split("&&") {
        clauses.push(clause_of(clause));
    }
    util::join(clauses, " && ")
}

fn clause_of(clause: str) -> str {
    let text = clause.trim();
    for op in [">=", "<=", "==", "!=", ">", "<"] {
        let found = util::index_of(text, op);
        if found.is_some() {
            let at = found.unwrap();
            let name = text.slice(0, at).trim();
            let rest = text.slice(at + op.len(), text.len()).trim();
            return "scene::variable(\"{name}\").{read_as(rest)} {op} {rest}";
        }
    }
    "scene::variable(\"{text}\").as_bool()"
}

// How a variable is read to compare with `rest`, as the script writes it.
fn read_as(rest: str) -> str {
    if rest == "true" || rest == "false" {
        "as_bool()"
    } else if numeric(rest) {
        "as_float()"
    } else {
        "as_str()"
    }
}

fn as_call(row: any) -> str {
    let action = action_of(row);
    let target = row.target.as_str();
    let value = as_text(row.value);
    let node = if target == "" { "self.node" } else { "self.node.get_node(\"{target}\")" };
    if action == "set_state" {
        "{node}.states.set_state(\"{value}\");"
    } else if action == "set_variable" {
        "scene::set_variable(\"{target}\", {literal(value)});"
    } else if action == "add_variable" {
        "scene::set_variable(\"{target}\", scene::variable(\"{target}\").as_float() + {literal(value)});"
    } else if action == "play" {
        "{node}.animation.play(\"{value}\");"
    } else if action == "play_sound" {
        "{node}.sound.play();"
    } else if action == "instantiate" {
        "scene::instantiate(fs::read(\"{value}\").or(\"\"), {node});"
    } else if action == "free" {
        "{node}.queue_free();"
    } else if action == "switch" {
        "scene::switch(\"{value}\", map());"
    } else if action == "open_url" {
        "engine::open_url(\"{value}\");"
    } else if action == "emit" {
        "{node}.emit(\"{value}\", nil);"
    } else if action == "call" {
        "{node}.call(\"{value}\");"
    } else if action == "visible" {
        "{node}.set_visible({literal(value)});"
    } else {
        "// no call for `{action}`"
    }
}

// Whether a written value is a number.
fn numeric(value: str) -> bool {
    if value == "" {
        return false;
    }
    for c in value.chars() {
        if !"0123456789.-".contains(c) {
            return false;
        }
    }
    true
}

/// A written value as script source: a number and a bool stay as they are,
/// and everything else is a string.
fn literal(value: str) -> str {
    if value == "true" || value == "false" || numeric(value) {
        return value;
    }
    "\"{value}\""
}

/// Write the script this node's bindings are equivalent to, attach it, and
/// open it. The rows stay: deleting them is the author's call, once they have
/// read what was written.
pub fn convert_to_script(S: &mut editor::State) {
    if !model::has_selection(S) {
        return;
    }
    if rows(S).len() == 0 {
        log::info("this node has no bindings to convert");
        return;
    }
    let node = S.doc[S.sel];
    let rel = "scripts/{node.name.as_str().to_lower()}_events.bs";
    fs::write(S.game_root + "/" + rel, as_script(S));
    model::forget(S, nil);
    history::record(S, "convert bindings to a script", nil);
    node.set("script", map().with("source", rel));
    model::record_override(S, node, "script");
    history::commit(S);
    S.shader_rel = "";
    signals::inspector(S);
    shell::open_doc(S, "script");
    log::info("wrote " + rel);
}

/// The node the document area hands a tab whose rows are nodes.
const PANEL: str = "Editor/Shell/Body/Centre/UpperRow/Stack/Upper/Work/Canvas/Stage/DocPanel";

/// Where the rows go, which the self-test reads back.
pub fn rows_host() -> str {
    PANEL + "/DocScroll/DocRows"
}

/// The document tab: the selected node's rows, and the variables they read,
/// up while the Events tab is; what its script asks for when the node or
/// the tab moved.
pub fn fill(S: &mut editor::State) {
    let up = S.doc_open && S.doctab == "events";
    util::fill(PANEL, map().with("visible", up));
    if !up {
        return;
    }
    let node = model::selected_node(S);
    pool::strip(S, PANEL + "/DocHead", [
        map().with("kind", "label").with("role", "text_heading").with("grow", 1).with("text", "EVENT BINDINGS · {node.name.as_str()}"),
        map()
            .with("kind", "button")
            .with("role", "action_form_secondary")
            .with("text", "‹›  Convert to script")
            .with("on", "handle")
            .with("data", map().with("fn", fill_on_6)),
        map()
            .with("kind", "button")
            .with("role", "action_form_primary")
            .with("text", icons::ui("add") + "  Add row")
            .with("on", "handle")
            .with("data", map().with("fn", fill_on_7)),
    ]);
    let specs: [any] = [];
    let held = rows(S);
    if held.len() == 0 {
        specs.push(note("no bindings on this node yet"));
    }
    for at in 0..held.len() {
        specs.push(row_spec(S, at, util::obj(held[at])));
    }
    variable_specs(S, specs);
    hook_specs(S, specs);
    pool::sync(S, rows_host(), specs, 0.0, false);
}

fn fill_on_6(S: &mut editor::State, data: any, _0: any) {
    convert_to_script(S);
}

fn fill_on_7(S: &mut editor::State, data: any, _0: any) {
    add_row(S);
}

fn note(text: str) -> any {
    map()
        .with("full", true)
        .with("height", 0)
        .with("controls", [
            map()
                .with("kind", "label")
                .with("role", "text_caption")
                .with("grow", 1)
                .with("wrap", true)
                .with("text", text),
        ])
}

fn head(text: str) -> any {
    map()
        .with("full", true)
        .with("height", 26)
        .with("controls", [
            map()
                .with("kind", "label")
                .with("role", "text_heading")
                .with("grow", 1)
                .with("text", text.to_upper()),
        ])
}

/// What the scene declares, so a `when` has something to name. Read-only: a
/// variable is declared in the scene file's `[variables]`.
fn variable_specs(S: editor::State, out: [any]) {
    out.push(head("scene variables"));
    let declared = scene::variables();
    if declared.len() == 0 {
        out.push(note("none; declare them under [variables] in the scene file"));
        return;
    }
    for entry in declared {
        out.push(map()
            .with("full", true)
            .with("height", 24)
            .with("slot_role", "layout_actions")
            .with("controls", [
                map().with("kind", "label").with("role", "text_code").with("text", entry.name),
                map().with("kind", "label").with("role", "text_caption").with("text", entry.type),
                map().with("kind", "row").with("grow", 1),
                map().with("kind", "label").with("role", "text_code_success").with("text", "{entry.value}"),
            ]));
    }
}

/// The hooks the node's own script declares, which is what this view used to
/// be and is still worth showing beside the rows.
fn hook_specs(S: &mut editor::State, out: [any]) {
    let node = model::selected_node(S);
    let script_or = model::script_rel(node);
    if script_or.is_nil() {
        return;
    }
    let script = script_or.as_str();
    out.push(head("script hooks"));
    for hook in model::hooks(S, script) {
        let name = hook.name.as_str();
        let lifecycle = name == "init" || name == "update";
        out.push(map()
            .with("full", true)
            .with("height", 28)
            .with("controls", [
                map()
                    .with("kind", "row")
                    .with("role", "sheet_hook")
                    .with("controls", [
                        map()
                            .with("kind", "label")
                            .with("text", "•")
                            .with("role", if lifecycle { "text_mark_primary" } else { "text_mark_secondary" }),
                        map().with("kind", "label").with("text", "{node.name.as_str()}.{name}()").with("role", "text_code"),
                        map().with("kind", "row").with("grow", 1),
                        map().with("kind", "label").with("text", "{script}:{hook.line}").with("role", "text_caption"),
                    ]),
            ]));
    }
}
