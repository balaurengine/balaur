// Command palette: the single modal overlay. ⌘K opens; Esc, scrim click, or
// running a command closes. Substring filter, first result pre-highlighted.

use commands;
use defs;
use disk;
use editor;
use icons;
use model;
use newnode;
use physics;
use plugins;
use presets;
use sceneedit;
use shell;
use util;
use window;
use words::fields;
use words::form_fields;
use words::inspector_fields;

const BESIDE: str = "beside";

/// A preset or a component type, and the tags it is found by.
pub struct Entry {
    name: str,
    tags: str,
}

/// The recipes and the engine's registries, as the palette offers them.
pub struct Found {
    presets: [Entry],
    components: [Entry],
    channels: [str],
}

/// One line of the palette: what it says, and `run` called with `data`.
pub struct Line {
    internal label: str,
    icon: str,
    key: str,
    tags: str,
    run: fn(&mut editor::State, any),
    data: any,
}

// A command of the shell's, with the chord its key answers to.
fn of_command(state: &mut editor::State, found: commands::Command) -> Line {
    Line { label: found.label, icon: found.icon, key: commands::chord(state, found.id), tags: found.tags, run: run_command, data: found.id }
}

fn line(label: str, icon: str, run: fn(&mut editor::State, any), data: any) -> Line {
    Line { label: label, icon: icon, key: "", tags: "", run: run, data: data }
}

// The recipes and the engine's registries, asked once per opening rather than
// once per frame: every preset and every component type carries a tag list,
// and walking them all is a list rebuild on every keystroke.
fn catalogue(state: &mut editor::State) -> Found {
    if state.palette_cache != nil {
        return state.palette_cache.unwrap();
    }
    let offered: [Entry] = [];
    for preset in presets::all(state) {
        offered.push(Entry { name: preset.name, tags: util::join(preset.tags, " ") });
    }
    let components: [Entry] = [];
    for name in scene::component_types() {
        let tags = scene::component_tags(name);
        components.push(Entry { name: name, tags: if tags != nil { util::join(tags.unwrap(), " ") } else { "" } });
    }
    let found = Found { presets: offered, components: components, channels: render::debug_views() };
    state.palette_cache = found;
    found
}

fn lines(state: &mut editor::State) -> [Line] {
    let list = node_lines(state);
    for found in commands::offered(state, commands::shell(state)) {
        list.push(of_command(state, found));
    }
    // One line per scene file, the way the channel views are one per
    // channel: a prefab is placed by name rather than through a picker.
    for rel in disk::scene_files(state) {
        if rel != state.scene_rel {
            list.push(line("Instantiate " + rel, icons::ui(icons::INSTANCE), run_instance, rel));
        }
    }
    catalogue_lines(state, list);
    list
}

// What the registries offer: a view per channel, each plugin's commands and
// dialogs, each preset, and each component the selection could add or drop.
fn catalogue_lines(state: &mut editor::State, list: [Line]) {
    let known = catalogue(state);
    // Channel views: draw normals, UVs or depth instead of the picture.
    list.push(line("View: color", icons::ui(icons::CHANNEL), run_view, ""));
    for channel in known.channels {
        list.push(line("View: " + channel, icons::ui(icons::CHANNEL), run_view, channel));
    }
    for entry in state.registry.commands {
        let plugin_command = line(entry[fields::TITLE].as_str(), entry[fields::ICON].as_str(), run_plugin, entry);
        plugin_command.key = entry[form_fields::SHORTCUT].as_str();
        list.push(plugin_command);
    }
    for entry in state.registry.dialogs {
        list.push(line("Open {entry["title"]}", icons::ui(icons::DIALOG), run_dialog, entry["id"]));
    }
    // Presets first: they are the shortcut most edits actually want, and
    // each is just the components it names.
    for preset in known.presets {
        let entry = line("Add {preset.name} node", icons::ui(icons::ADD), run_preset, preset.name);
        entry.tags = preset.tags;
        list.push(entry);
    }
    // Component commands come from the engine's registry, so third-party
    // plugin components are addable without touching the editor.
    let found = model::selected_node(state);
    if found.is_valid() {
        let present = found.component_names();
        for known_component in known.components {
            let name = known_component.name;
            if util::contains(present, name) {
                list.push(line("Remove {name} component", icons::ui(icons::CLOSE), run_remove_component, name));
            } else {
                let entry = line("Add {name} component", icons::ui(icons::ADD), run_add_component, name);
                // Facets, so typing "physics" or "2d" narrows the list.
                entry.tags = known_component.tags;
                list.push(entry);
            }
        }
    }
}

/// What the selected node can do: the shell's commands for what it carries,
/// then the colliders and soft bodies its mesh can become.
pub fn node_lines(state: &mut editor::State) -> [Line] {
    let list: [Line] = [];
    for found in commands::offered(state, commands::node(state)) {
        list.push(of_command(state, found));
    }
    for shape in node_shapes(state) {
        list.push(shape);
    }
    list
}

fn node_shapes(state: &mut editor::State) -> [Line] {
    let list: [Line] = [];
    let found = model::selected_node(state);
    if !found.is_valid() {
        return list;
    }
    let two_d = model::is_2d(state);
    if physics::drawn_mesh(found, two_d) != nil {
        for shape in physics::collider_shapes(two_d) {
            let entry = line("Collide as {shape.id}", icons::workspace(defs::WORKSPACE_PHYSICS), run_collide, { inspector_fields::TWO_D: two_d, inspector_fields::PROPS: shape.properties, BESIDE: shape.beside });
            entry.tags = shape.tip;
            list.push(entry);
        }
        for shape in physics::soft_shapes(two_d) {
            let entry = line("Deform as {shape.id}", icons::workspace(defs::WORKSPACE_PHYSICS), run_deform, { inspector_fields::TWO_D: two_d, inspector_fields::PROPS: shape.properties, BESIDE: shape.beside });
            entry.tags = shape.tip;
            list.push(entry);
        }
    }
    list
}

fn run_collide(state: &mut editor::State, data: any) {
    physics::make_collider(state, data[inspector_fields::TWO_D].as_bool(), data[inspector_fields::PROPS], data[BESIDE]);
}

fn run_deform(state: &mut editor::State, data: any) {
    physics::make_soft_body(state, data[inspector_fields::TWO_D].as_bool(), data[inspector_fields::PROPS], data[BESIDE]);
}

fn run_command(state: &mut editor::State, data: any) {
    commands::run(state, data.as_str());
}

fn run_instance(state: &mut editor::State, data: any) {
    sceneedit::instance_scene(state, data.as_str());
}

fn run_view(state: &mut editor::State, data: any) {
    render::set_debug_view(data.as_str());
}

fn run_plugin(state: &mut editor::State, data: any) {
    plugins::run(state, data);
    plugins::changed(state);
}

fn run_dialog(state: &mut editor::State, data: any) {
    state.registry.open[data.as_str()] = true;
    plugins::changed(state);
}

fn run_preset(state: &mut editor::State, data: any) {
    newnode::add(state, data.as_str());
}

fn run_remove_component(state: &mut editor::State, data: any) {
    sceneedit::remove_component(state, data.as_str());
}

fn run_add_component(state: &mut editor::State, data: any) {
    sceneedit::add_component(state, data.as_str());
}

/// Fill the picker: what its script asks for while the palette is up. Enter
/// runs the first match, which is why it is lit.
pub fn fill(state: &mut editor::State) {
    let matched = matches(state);
    if state.palette_submit {
        state.palette_submit = false;
        if matched.len() > 0 {
            let first = matched[0];
            let run = first.run;
            run(state, first.data);
            shell::close_palette(state);
            return;
        }
    }
    let rows: [ui::Item] = [];
    for at in 0..matched.len() {
        let line = matched[at];
        rows.push(ui::Item { label: line.label, icon: line.icon, note: line.key, key: "{at}" });
    }
    let field: any = {
        fields::MARK: icons::ui(icons::SEARCH),
        form_fields::PLACEHOLDER: "Nodes, commands, workspaces…",
        form_fields::QUERY: state.palette_query,
    };
    window::picker(state, field, rows, if rows.len() > 0 { "0" } else { "" }, if rows.len() > 0 { "" } else { "no matches" });
}

/// A row picked, by its place among the matches: it runs, and the palette shuts.
pub fn picked(state: &mut editor::State, key: str) {
    let matched = matches(state);
    for at in 0..matched.len() {
        if "{at}" == key {
            let line = matched[at];
            let run = line.run;
            run(state, line.data);
            shell::close_palette(state);
            return;
        }
    }
}

/// What is typed in the picker while the palette is up.
pub fn typed(state: &mut editor::State, text: str) {
    state.palette_query = text;
}

/// Enter: the first match runs.
pub fn submitted(state: &mut editor::State, text: str) {
    state.palette_query = text;
    state.palette_submit = true;
}

// What the query names, in the order the catalogue offers them. The facets
// are matched too, so "physics" or "2d" narrows the list even though neither
// word is in the label.
fn matches(state: &mut editor::State) -> [Line] {
    let query = state.palette_query.to_lower();
    let out: [Line] = [];
    for command_entry in lines(state) {
        if query == "" || (command_entry.label + " " + command_entry.tags).to_lower().contains(query) {
            out.push(command_entry);
        }
    }
    out
}
