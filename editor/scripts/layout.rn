// The only place a rect is decided; everything else reads `S.layout`. Shape
// and resting size are the `widget` tree under `Editor/Shell` in
// `scenes/main.toml`; this states the sizes that move and reads back the rest.

use crate::util;

// What a timeline, a debugger or a session list needs over the bottom dock's
// resting height, which the scene states.
const TALL_EXTRA = 62.0;
// What a small window takes off the shell's own gutter and the seams between
// its sheets. The scene states the resting pair; this is the tighter one.
const TIGHT_GUTTER = 8.0;
const TIGHT_GAP = 6.0;
// The floor a seam stops a dock at, and what the scene keeps whatever the
// seams either side of it are dragged to.
const LEFT_MIN = 180.0;
const RIGHT_MIN = 220.0;
const BOTTOM_MIN = 84.0;
const STAGE_MIN = 260.0;
// Every box the shell tree names, by the path `scene::get_node` takes.
const SHELL = "Editor/Shell";
const EASE_S = 0.16;

fn rect(x, y, w, h) {
    #{ x: x, y: y, w: w, h: h }
}

pub fn state() {
    #{
        bar: rect(0.0, 0.0, 0.0, 0.0),
        left: rect(0.0, 0.0, 0.0, 0.0), rail: rect(0.0, 0.0, 0.0, 0.0),
        railtop: rect(0.0, 0.0, 0.0, 0.0),
        right: rect(0.0, 0.0, 0.0, 0.0), bottom: rect(0.0, 0.0, 0.0, 0.0),
        stage: rect(0.0, 0.0, 0.0, 0.0), doc: rect(0.0, 0.0, 0.0, 0.0),
        hooks: rect(0.0, 0.0, 0.0, 0.0), split_w: 560.0, body_h: 96.0,
        // How tall the tool rail's column is, read back a frame late; the
        // rail flows into a second column rather than overrun it.
        rail_room: 400.0,
        // The scene's own numbers, adopted before anything writes over them.
        // Zero until `adopt` has run, which is what `asked` says.
        asked: false,
        gutter: 0.0, gap: 0.0, pad: 0.0,
        tree_w: 0.0, insp_w: 0.0, dock_h: 0.0, hooks_w: 0.0,
        status_h: 0.0,
        // The shell's nodes, resolved once: the tree is the editor's own and
        // does not change under a running editor.
        nodes: #{},
        // What was last written to a node, so a size that has not moved is
        // not a component write every frame.
        sent: #{},
        // The tween each eased box is riding, so a second change replaces it
        // rather than fighting it.
        tweens: #{},
    }
}

/// The shell's boxes, by the name `S.layout` publishes them under.
fn node(S, id) {
    let m = S.layout;
    if let Some(found) = m.nodes.get(id) {
        return found;
    }
    let path = match id {
        "shell" => SHELL,
        "head" => SHELL + "/Head",
        "body" => SHELL + "/Body",
        "left" => SHELL + "/Body/Left",
        "leftsheet" => SHELL + "/Body/Left/LeftSheet",
        "right" => SHELL + "/Body/Right",
        "rightsheet" => SHELL + "/Body/Right/RightSheet",
        "centre" => SHELL + "/Body/Centre",
        "upperrow" => SHELL + "/Body/Centre/UpperRow",
        "stack" => SHELL + "/Body/Centre/UpperRow/Stack",
        "upper" => SHELL + "/Body/Centre/UpperRow/Stack/Upper",
        "bottom" => SHELL + "/Body/Centre/Bottom",
        "dockbody" => SHELL + "/Body/Centre/Bottom/DockBody",
        "status" => SHELL + "/Body/Centre/Bottom/Status",
        "rightbody" => SHELL + "/Body/Right/RightSheet/RightBody",
        "railslot" => SHELL + "/Body/Centre/UpperRow/RailSlot",
        "rail" => SHELL + "/Body/Centre/UpperRow/RailSlot/Rail",
        "railtop" => SHELL + "/Body/Centre/UpperRow/RailSlot/RailTop",
        "work" => SHELL + "/Body/Centre/UpperRow/Stack/Upper/Work",
        "canvas" => SHELL + "/Body/Centre/UpperRow/Stack/Upper/Work/Canvas",
        "stage" => SHELL + "/Body/Centre/UpperRow/Stack/Upper/Work/Canvas/Stage",
        "hooks" => SHELL + "/Body/Centre/UpperRow/Stack/Upper/Work/Canvas/Hooks",
        _ => "",
    };
    let found = scene::get_node(path);
    // A miss is not remembered: one transient failure would leave the box
    // inert for the rest of the session.
    if !util::is_nil(found) {
        m.nodes[id] = found;
    }
    found
}

/// A box's `widget` component; empty when the tree has no such node.
fn widget_of(S, id) {
    let found = node(S, id);
    if util::is_nil(found) {
        return #{};
    }
    util::obj(found.get_component("widget"))
}

/// What the scene states for one of a box's sizes.
fn stated(S, id, key) {
    util::f(widget_of(S, id).get(key).unwrap_or(0.0))
}

/// The scene's own numbers, read back once before anything writes over them.
/// Nothing outside `scenes/main.toml` may spell a resting shell size.
fn adopt(S) {
    let m = S.layout;
    if m.asked {
        return;
    }
    let shell = widget_of(S, "shell");
    if shell.is_empty() {
        return;
    }
    m.gutter = util::f(shell.get("padding").unwrap_or(0.0));
    m.gap = util::f(widget_of(S, "body").get("gap").unwrap_or(0.0));
    m.pad = stated(S, "leftsheet", "padding");
    m.tree_w = stated(S, "left", "width");
    m.insp_w = stated(S, "right", "width");
    m.status_h = stated(S, "status", "height");
    m.dock_h = stated(S, "bottom", "height") - m.status_h;
    m.hooks_w = stated(S, "hooks", "width");
    m.asked = true;
}

/// State a box's size, when it has moved. A component write rebuilds the
/// widget, so the same number twice is a write worth skipping.
// The boxes that travel when they change rather than jumping: a dock opening,
// the tool rail folding away, the hooks list arriving beside the code.
fn eased(mark) {
    ["left:width", "right:width", "bottom:height", "railslot:width", "hooks:width"]
        .iter()
        .any(|m| m == mark)
}

/// Whether an eased box is still travelling. A tween moves the widget from
/// the animation stage, which no UI pass follows: the shell asks for one.
pub fn animating(S) {
    for (_, handle) in S.layout.tweens.iter() {
        if animation::is_tween_running(handle) {
            return true;
        }
    }
    false
}

/// Take back a size the pointer changed, so the next write agrees with it.
fn dragged(S, id, key, into) {
    let m = S.layout;
    let mark = id + ":" + key;
    let running = m.tweens.get(mark);
    if let Some(handle) = running {
        if animation::is_tween_running(handle) {
            return;
        }
    }
    let now = stated(S, id, key);
    if now > 0.0 && m.sent.get(mark) != Some(now) {
        m[into] = now;
        m.sent[mark] = now;
    }
}

// A dragged size, held between its floor and what the scene can spare. Kept
// on `S.layout` rather than clamped on the way out, so the next drag carries
// on from where this one stopped instead of from where the pointer went.
fn held(S, key, floor, ceiling) {
    let m = S.layout;
    m[key] = util::clamp(m[key], floor, util::max(floor, ceiling));
    m[key]
}

fn size(S, id, key, value) {
    let m = S.layout;
    let mark = id + ":" + key;
    if m.sent.get(mark) == Some(value) {
        return;
    }
    let found = node(S, id);
    if util::is_nil(found) {
        return;
    }
    // The first write places the box; a later one moves it. Easing the first
    // would mean watching the shell assemble itself on every start.
    let settled = m.sent.contains_key(mark);
    m.sent[mark] = value;
    if settled && eased(mark) {
        let running = m.tweens.get(mark);
        if let Some(handle) = running {
            animation::stop(handle);
        }
        m.tweens[mark] = animation::tween_to(found, "widget/" + key, value, EASE_S, "out_cubic");
        return;
    }
    let params = util::obj(found.get_component("widget"));
    params[key] = value;
    found.set_component("widget", params);
}

/// Draw a box, or stop drawing it. Memoised like `size`, because a component
/// written every frame is a widget tree rebuilt every frame.
fn show(S, id, on) {
    let m = S.layout;
    let mark = id + ":visible";
    let want = if on { 1.0 } else { 0.0 };
    if m.sent.get(mark) == Some(want) {
        return;
    }
    let found = node(S, id);
    if util::is_nil(found) {
        return;
    }
    m.sent[mark] = want;
    found.patch_component("widget", #{ visible: on });
}

/// Where a box was laid out, in design pixels; a zero rect until it has
/// drawn once, which is the frame before the editor's first.
fn box_of(S, id) {
    let found = node(S, id);
    if util::is_nil(found) {
        return rect(0.0, 0.0, 0.0, 0.0);
    }
    let r = ui::widget_rect(found);
    if r is Object {
        return rect(r.x, r.y, r.w, r.h);
    }
    rect(0.0, 0.0, 0.0, 0.0)
}

/// The sheets that can sit under the pointer, in draw order.
pub fn sheets(S) {
    let m = S.layout;
    // The status strip is inside the bottom dock, not a sheet of its own: the
    // dock already owns that rect and the pointer with it.
    let all = [m.bar, m.left, m.right, m.bottom];
    if S.rail_visible {
        all.push(m.rail);
    }
    if S.doc_open {
        all.push(m.doc);
    }
    if S.hooks_open {
        all.push(m.hooks);
    }
    all
}

/// Rects for the current window, published as `S.layout`. Sizes are exact:
/// nothing hugs, because the stage is what is left over and a measured sheet
/// could not be subtracted from it.
pub fn compute(S) {
    let w = S.screen_w;
    let m = S.layout;
    adopt(S);
    // Before the shell tree resolves there is no size to state and no rect to
    // read; every surface guards on a zero rect and draws nothing.
    if !m.asked {
        return;
    }
    // A seam the pointer moved wrote straight to the node, so the value it
    // left there is the new one to keep. A tween is this module's own doing
    // and is not mistaken for a drag.
    dragged(S, "left", "width", "tree_w");
    dragged(S, "right", "width", "insp_w");
    dragged(S, "bottom", "height", "dock_h");

    // A seam resizes and only resizes: a dock is put away by the mark in its
    // own tab row, so a drag that reaches the floor stops there. The ceiling is
    // what the other dock and the stage leave.
    let tree_w = side_w(S, "left", held(S, "tree_w", LEFT_MIN, w - STAGE_MIN - RIGHT_MIN));
    let insp_w = side_w(S, "right", held(S, "insp_w", RIGHT_MIN, w - STAGE_MIN - tree_w));
    let tall = if crate::docks::bottom_tall(S) { TALL_EXTRA } else { 0.0 };
    let body_h = held(S, "dock_h", BOTTOM_MIN, S.screen_h - m.bar.h - STAGE_MIN - tall - m.status_h);
    // Minimised, the dock is gone: its handle sits beside the zoom reading,
    // the way each side dock's sits at the edge it folded towards.
    let dock_h = if crate::docks::folded(S, "bottom") {
        0.0
    } else {
        body_h + tall + m.status_h
    };
    let grid = crate::center::rail_grid(S, m.rail_room);
    let rail_w = if S.rail_visible { crate::center::rail_span(grid, grid.cols) } else { 0.0 };
    let hooks_w = if S.hooks_open { m.hooks_w } else { 0.0 };

    // The gutter round the shell and the seams between its sheets: a step
    // tighter in a small window, where they are most of what is on screen.
    let tight = S.compact;
    size(S, "shell", "padding", if tight { TIGHT_GUTTER } else { m.gutter });
    for id in ["body", "centre", "upperrow", "stack", "upper", "shell"] {
        size(S, id, "gap", if tight { TIGHT_GAP } else { m.gap });
    }
    size(S, "shell", "width", w);
    size(S, "shell", "height", S.screen_h);
    size(S, "left", "width", tree_w);
    size(S, "right", "width", insp_w);
    // Folded, a side dock's whole column goes. Not the sheet inside it: a
    // box left at zero width still takes the row's gap either side of it,
    // which is what stopped the centre reaching the window's own edge.
    for side in ["left", "right", "bottom"] {
        show(S, side, !crate::docks::folded(S, side));
    }
    size(S, "bottom", "height", dock_h);
    // The right sheet's header, above the rows the pool makes: a `draw` node
    // with no size takes whatever is left, which would be the whole sheet.
    size(S, "rightbody", "height", right_head_h(S));
    size(S, "railslot", "width", rail_w);
    size(S, "rail", "height", crate::center::rail_span(grid, grid.rows));
    // The folded left dock's handle sits above the tools, so the rail starts
    // below it rather than beside it.
    size(S, "railtop", "height", crate::docks::rail_top_h(S));
    size(S, "hooks", "width", hooks_w);
    // The side docks' rule again: a zero-width box still takes its row's gap,
    // so the rail slot and the hooks list go rather than shrink.
    show(S, "railslot", rail_w > 0.0);
    show(S, "hooks", hooks_w > 0.0);

    // The widget layer draws after `draw_ui`, so these are a frame behind.
    // A size that just changed shows on the next one, the way `bar_fit` has
    // always worked.
    let r = #{
        head: box_of(S, "head"),
        left: box_of(S, "leftsheet"),
        right: box_of(S, "rightsheet"),
        bottom: box_of(S, "bottom"),
        dockbody: box_of(S, "dockbody"),
        rail: box_of(S, "rail"),
        railtop: box_of(S, "railtop"),
        centre: box_of(S, "centre"),
        canvas: box_of(S, "canvas"),
        stage: box_of(S, "stage"),
        hooks: box_of(S, "hooks"),
    };

    // The sheet is its own box now, so a folded dock's rect is the square the
    // widget layer placed rather than one this module has to work out.
    m.left = r.left;
    m.right = r.right;
    m.bottom = r.bottom;
    m.hooks = r.hooks;
    m.rail = r.rail;
    m.railtop = r.railtop;
    m.rail_room = util::max(120.0, r.centre.h);
    // What a dock panel may scroll: its share of the sheet, less the tab row
    // and the status strip at the foot.
    m.body_h = util::max(0.0, r.dockbody.h - crate::docks::row_h(S));
    m.bar = r.head;

    // A document is not full-bleed: text under a sheet is unreadable. Sharing
    // with the scene puts the code on the right and the scene on the left.
    let box = r.stage;
    if S.doc_open && S.viewport_live {
        let code_w = util::clamp(m.split_w, 260.0, util::max(260.0, box.w - 260.0));
        m.doc = rect(box.x + box.w - code_w, box.y, code_w, box.h);
        m.stage = rect(box.x, box.y, box.w - code_w - m.gap, box.h);
    } else if S.doc_open {
        m.doc = box;
        m.stage = box;
    } else {
        // Nothing to read, so the scene takes the hooks list's width too.
        m.stage = r.canvas;
        m.doc = m.stage;
    }
    // The scene's rect under its old name; `at` is the frame it was set on, so
    // a self-test can tell a headless run from a drawn one. An unplaced stage
    // is not published: a played game's HUD would blink out for that frame.
    if m.stage.w > 0.0 && m.stage.h > 0.0 {
        S.viewport = #{ x: m.stage.x, y: m.stage.y, w: m.stage.w, h: m.stage.h, at: S.frame };
    }
}

// What the right sheet draws above its form: the tab row every panel has, and
// then whatever the panel puts before its rows.
fn right_head_h(S) {
    let d = S.docks.right;
    if d.shut {
        return 0.0;
    }
    let rows = crate::docks::row_h(S) + 8.0;
    if d.active == "inspector" {
        return rows + 44.0;
    }
    if d.active == "import" {
        return rows + 52.0;
    }
    rows
}

// A side dock's width: nothing when it holds no panel, its rail when it is
// folded, and what the seam was dragged to otherwise.
fn side_w(S, side, open_w) {
    if S.docks[side].tabs.len() == 0 || S.docks[side].shut {
        return 0.0;
    }
    open_w
}

/// A plugin window: stacked down the left of the stage, so it never lands on
/// the top bar the way a free-floating one did.
pub fn window_rect(S, n) {
    let m = S.layout;
    rect(m.stage.x + 12.0, m.stage.y + 12.0 + (n as f64) * 176.0, 260.0, 164.0)
}

/// What one persona pill is estimated at, for the showcase's pointer.
pub fn persona_w(S) {
    if S.compact { 40.0 } else { 76.0 }
}

/// Whether `x`,`y` in design px is over a sheet. Under Stage the scene is the
/// whole window, so a viewport tool asks this instead of testing itself
/// against a hole in the chrome.
pub fn over_sheet(S, x, y) {
    for r in sheets(S) {
        if r.w > 0.0 && r.h > 0.0
            && x >= r.x && x <= r.x + r.w && y >= r.y && y <= r.y + r.h {
            return true;
        }
    }
    false
}
