// The only place a rect is decided; everything else reads `S.layout`. The
// shape is the `widget` tree under `Editor/Shell` in `scenes/main.toml`: this
// states the sizes that move and reads back what the engine laid out.

use crate::defs;
use crate::util;

const GUTTER = 14.0;
// Between any two sheets, in every direction. One value, so no seam
// reads as deliberate when the next one does not.
const GAP = 12.0;
const RAIL_W = 44.0;
// The dock carries the status row inside its own sheet.
const STATUS_H = 24.0;
const CMD_W = 168.0;
// A minimised side dock is this wide; the bottom one keeps its tab row.
const SHUT_W = 36.0;
const SHUT_H = 34.0;
const HOOKS_W = 172.0;
// Every box the shell tree names, by the path `scene::get_node` takes.
const SHELL = "Editor/Shell";

fn rect(x, y, w, h) {
    #{ x: x, y: y, w: w, h: h }
}

pub fn state() {
    #{
        tree_w: 236.0, insp_w: 288.0, dock_h: 150.0,
        tree_open: true, insp_open: true,
        bar: rect(0.0, 0.0, 0.0, 0.0), cmd: rect(0.0, 0.0, 0.0, 0.0),
        left: rect(0.0, 0.0, 0.0, 0.0), rail: rect(0.0, 0.0, 0.0, 0.0),
        tabs: rect(0.0, 0.0, 0.0, 0.0), right: rect(0.0, 0.0, 0.0, 0.0),
        bottom: rect(0.0, 0.0, 0.0, 0.0), status: rect(0.0, 0.0, 0.0, 0.0),
        stage: rect(0.0, 0.0, 0.0, 0.0), doc: rect(0.0, 0.0, 0.0, 0.0),
        hooks: rect(0.0, 0.0, 0.0, 0.0), split_w: 560.0, body_h: 96.0,
        // What the persona bar measured last frame; 0 until it has drawn.
        bar_fit: 0.0,
        // The shell's nodes, resolved once: the tree is the editor's own and
        // does not change under a running editor.
        nodes: #{},
        // What was last written to a node, so a size that has not moved is
        // not a component write every frame.
        sent: #{},
    }
}

/// The shell's boxes, by the name `S.layout` publishes them under.
fn node(S, id) {
    let m = S.layout;
    if let Some(found) = m.nodes.get(id) {
        return found;
    }
    let path = match id {
        "shell" => SHELL,
        "head" => SHELL + "/Head",
        "left" => SHELL + "/Body/Left",
        "right" => SHELL + "/Body/Right",
        "bottom" => SHELL + "/Body/Centre/Bottom",
        "railslot" => SHELL + "/Body/Centre/Upper/RailSlot",
        "work" => SHELL + "/Body/Centre/Upper/Work",
        "tabs" => SHELL + "/Body/Centre/Upper/Work/Tabs",
        "canvas" => SHELL + "/Body/Centre/Upper/Work/Canvas",
        "stage" => SHELL + "/Body/Centre/Upper/Work/Canvas/Stage",
        "hooks" => SHELL + "/Body/Centre/Upper/Work/Canvas/Hooks",
        _ => "",
    };
    let found = scene::get_node(path);
    m.nodes[id] = found;
    found
}

/// State a box's size, when it has moved. A component write rebuilds the
/// widget, so the same number twice is a write worth skipping.
fn size(S, id, key, value) {
    let m = S.layout;
    let mark = id + ":" + key;
    if m.sent.get(mark) == Some(value) {
        return;
    }
    let found = node(S, id);
    if util::is_nil(found) {
        return;
    }
    let params = util::obj(found.get_component("widget"));
    params[key] = value;
    found.set_component("widget", params);
    m.sent[mark] = value;
}

/// Where a box was laid out, in design pixels; a zero rect until it has
/// drawn once, which is the frame before the editor's first.
fn box_of(S, id) {
    let found = node(S, id);
    if util::is_nil(found) {
        return rect(0.0, 0.0, 0.0, 0.0);
    }
    let r = ui::widget_rect(found);
    if r is Object {
        return rect(r.x, r.y, r.w, r.h);
    }
    rect(0.0, 0.0, 0.0, 0.0)
}

/// The sheets that can sit under the pointer, in draw order.
pub fn sheets(S) {
    let m = S.layout;
    // `status` is a strip inside the bottom dock, not a sheet of its own: the
    // dock already owns that rect and the pointer with it.
    let all = [m.bar, m.cmd, m.left, m.right, m.bottom, m.tabs];
    if S.rail_visible {
        all.push(m.rail);
    }
    if S.doc_open {
        all.push(m.doc);
    }
    if S.hooks_open {
        all.push(m.hooks);
    }
    all
}

/// Rects for the current window, published as `S.layout`. Sizes are exact:
/// nothing hugs, because the stage is what is left over and a measured sheet
/// could not be subtracted from it.
pub fn compute(S) {
    let w = S.screen_w;
    let h = S.screen_h;
    let m = S.layout;
    // A narrow window would leave no scene at all, so the sheets give way
    // before the stage does.
    let tree_w = if S.docks.left.shut { SHUT_W } else { util::clamp(m.tree_w, 180.0, w * 0.28) };
    let insp_w = if S.docks.right.shut { SHUT_W } else { util::clamp(m.insp_w, 220.0, w * 0.32) };
    let dock_h = (if S.docks.bottom.shut { SHUT_H } else { m.dock_h }) + STATUS_H;
    let rail_w = if S.rail_visible { (if S.rail_shut { 34.0 } else { RAIL_W }) } else { 0.0 };
    let hooks_w = if S.hooks_open { HOOKS_W } else { 0.0 };

    size(S, "shell", "width", w);
    size(S, "shell", "height", h);
    size(S, "left", "width", tree_w);
    size(S, "right", "width", insp_w);
    size(S, "bottom", "height", dock_h);
    size(S, "railslot", "width", rail_w);
    size(S, "hooks", "width", hooks_w);

    // The widget layer draws after `draw_ui`, so these are a frame behind.
    // A size that just changed shows on the next one, the way `bar_fit` has
    // always worked.
    let r = #{
        head: box_of(S, "head"),
        left: box_of(S, "left"),
        right: box_of(S, "right"),
        bottom: box_of(S, "bottom"),
        railslot: box_of(S, "railslot"),
        work: box_of(S, "work"),
        tabs: box_of(S, "tabs"),
        canvas: box_of(S, "canvas"),
        stage: box_of(S, "stage"),
        hooks: box_of(S, "hooks"),
    };

    m.left = r.left;
    m.right = r.right;
    m.tabs = r.tabs;
    m.bottom = r.bottom;
    m.hooks = r.hooks;
    // The rail is only as tall as its tools, so it takes the top of its
    // column rather than the whole of it.
    m.rail = rect(r.railslot.x, r.railslot.y, r.railslot.w, rail_h(S));
    // Centred on the document column, not the window: the tool rail shifts
    // it, and the bar has to sit over what it commands.
    let bar_mid = r.work.x + r.work.w / 2.0;
    m.bar = rect(bar_mid - bar_w(S) / 2.0, r.head.y, bar_w(S), r.head.h);
    m.cmd = rect(w - GUTTER - CMD_W, r.head.y + 7.0, CMD_W, 30.0);
    // What a dock panel may scroll: the sheet less its tab row and the status
    // strip sharing its foot.
    m.body_h = r.bottom.h - 30.0 - STATUS_H;
    // Inside the dock's sheet, drawn separately so a tall panel cannot push
    // it off the bottom.
    m.status = rect(r.bottom.x, r.bottom.y + r.bottom.h - STATUS_H, r.bottom.w, STATUS_H);

    // A document is not full-bleed: text under a sheet is unreadable. Sharing
    // with the scene puts the code on the right and the scene on the left.
    let box = r.stage;
    if S.doc_open && S.viewport_live {
        let code_w = util::clamp(m.split_w, 260.0, util::max(260.0, box.w - 260.0));
        m.doc = rect(box.x + box.w - code_w, box.y, code_w, box.h);
        m.stage = rect(box.x, box.y, box.w - code_w - GAP, box.h);
    } else if S.doc_open {
        m.doc = box;
        m.stage = box;
    } else {
        // Nothing to read, so the scene takes the hooks list's width too.
        m.stage = r.canvas;
        m.doc = m.stage;
    }
    // The scene's rect under its old name: the gizmos, the input overlay and
    // the widget layer all read it. `at` is the frame it was set on, so a
    // self-test can tell a headless run from a drawn one.
    S.viewport = #{ x: m.stage.x, y: m.stage.y, w: m.stage.w, h: m.stage.h, at: S.frame };
}

/// A plugin window: stacked down the left of the stage, so it never lands on
/// the persona bar the way a free-floating one did.
pub fn window_rect(S, n) {
    let m = S.layout;
    rect(m.stage.x + 12.0, m.stage.y + 12.0 + (n as f64) * 176.0, 260.0, 164.0)
}

// A row of text cannot be counted before it is laid out, so the bar reports
// what it used and the next frame is exact.
fn bar_w(S) {
    let m = S.layout;
    if m.bar_fit > 0.0 {
        return util::min(S.screen_w - 2.0 * GUTTER, m.bar_fit);
    }
    let personas = defs::personas().len() as f64;
    let per = if S.compact { 40.0 } else { 76.0 };
    util::min(S.screen_w - 2.0 * GUTTER, 228.0 + personas * per)
}

fn rail_h(S) {
    if S.rail_shut {
        return 42.0;
    }
    let tools = defs::tools(S.persona).len() as f64;
    // The tools, then the button that hides them.
    14.0 + tools * 33.0 + 26.0
}

/// Whether `x`,`y` in design px is over a sheet. Under Stage the scene is the
/// whole window, so a viewport tool asks this instead of testing itself
/// against a hole in the chrome.
pub fn over_sheet(S, x, y) {
    for r in sheets(S) {
        if r.w > 0.0 && r.h > 0.0
            && x >= r.x && x <= r.x + r.w && y >= r.y && y <= r.y + r.h {
            return true;
        }
    }
    false
}
