// The input overlay: the keys, buttons, actions and pointer the game is fed,
// heard as they move by its panel (scripts/panels/inputview.rn), so a replay
// shows its recording's input, and a fed frame shows what fed it.

use crate::style;
use crate::util;

// The keys worth a chip; the rest of the key list is media and numpad keys.
// The punctuation is here because a shortcut is built on it: `⇧⌘\` showed
// its two modifiers and nothing to press with them.
const KEYS = [
    "KeyA", "KeyB", "KeyC", "KeyD", "KeyE", "KeyF", "KeyG", "KeyH", "KeyI", "KeyJ", "KeyK", "KeyL", "KeyM",
    "KeyN", "KeyO", "KeyP", "KeyQ", "KeyR", "KeyS", "KeyT", "KeyU", "KeyV", "KeyW", "KeyX", "KeyY", "KeyZ",
    "Digit0", "Digit1", "Digit2", "Digit3", "Digit4", "Digit5", "Digit6", "Digit7", "Digit8", "Digit9",
    "F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9", "F10", "F11", "F12",
    "Space", "Enter", "Escape", "Tab", "Backspace", "Delete", "Home", "End",
    "PageUp", "PageDown", "Insert", "ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown",
    "Backslash", "Slash", "Comma", "Period", "Semicolon", "Quote",
    "BracketLeft", "BracketRight", "Minus", "Equal", "Backquote",
    "ShiftLeft", "ShiftRight", "ControlLeft", "ControlRight", "AltLeft", "AltRight", "MetaLeft", "MetaRight",
];

pub fn state() {
    #{}
}

fn key_label(key) {
    match key {
        "ShiftLeft" => "Shift",
        "ShiftRight" => "Shift",
        "ControlLeft" => "Ctrl",
        "ControlRight" => "Ctrl",
        "AltLeft" => "Alt",
        "AltRight" => "Alt",
        "MetaLeft" => "Cmd",
        "MetaRight" => "Cmd",
        "Backslash" => "\\",
        "Slash" => "/",
        "Comma" => ",",
        "Period" => ".",
        "Semicolon" => ";",
        "Quote" => "'",
        "BracketLeft" => "[",
        "BracketRight" => "]",
        "Minus" => "-",
        "Equal" => "=",
        "Backquote" => "`",
        "PageUp" => "Page up",
        "PageDown" => "Page down",
        _ => {
            let skip = if key.starts_with("Key") { 3 } else if key.starts_with("Digit") || key.starts_with("Arrow") { 5 } else { 0 };
            key[skip..]
        }
    }
}

/// What the overlay needs to place itself: whether it is up, how many window
/// pixels a design pixel is, and where its chips sit, under the viewport
/// where there is one. The start screen lays out none and focus mode gives
/// the code the window, so in both they go by the window instead.
pub fn view(S) {
    let v = S.viewport;
    let (_, sh) = ui::window_size();
    let staged = !crate::manager::showing(S) && !S.focus && util::f(v.w) > 0.0;
    let vx = if staged { util::f(v.x) } else { 0.0 };
    let vy = if staged { util::f(v.y) } else { 0.0 };
    let vh = if staged { util::f(v.h) } else { sh };
    let (_, _, _, _, _, _, _, dpi) = render::camera_pose();
    #{ shown: S.show_input, factor: dpi * S.ui_scale, chips_x: vx + 130.0, chips_y: vy + vh - 46.0 }
}

/// A key's chip, or "" for a key worth none: the rest of the key list is
/// media and numpad keys.
pub fn chip_of(key) {
    if KEYS.iter().any(|known| known == key) { key_label(key) } else { "" }
}

/// Put a chip a name on the overlay's row: a key or a button held, an action
/// pressed, each in the look it had.
pub fn fill_chips(S, names) {
    let k = S.theme;
    let out = [];
    for name in names {
        let action = name.starts_with("⟐ ");
        out.push(#{
            kind: "button", text: if action { name[4..] } else { name }, height: 30,
            font_size: style::MD, font_weight: 700, interactive: false,
            fill: if action { k.bg_control } else { k.primary_fill },
            stroke: if action { k.primary_text } else { "" },
            text_color: if action { k.primary_text } else { k.text_on_primary },
        });
    }
    crate::pool::strip(S, "Editor/InputView/Chips", out);
}
