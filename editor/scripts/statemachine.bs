// The State machine dock: the selected node's `state_machine` as its states
// and transitions, edited in place and written back where the machine lives.

use anim;
use docks;
use editor;
use history;
use inspector;
use model;
use pool;
use selftest;
use shell;
use signals;
use util;

pub class StatemachineState {
    open: int?,
    naming: str,
    file: File?,
    demo: int,
}

/// The machine as it is authored: an inline table, or a file's contents and
/// its path.
pub struct Source {
    doc: any,
    path: str?,
}

pub struct File {
    path: str,
    doc: any,
}

// The component and the asset type `balaur_animation` registers, and the keys the
// component and the machine document spell.
const COMPONENT: str = "state_machine";

const MACHINE_TYPE: str = "state_machine";

const ROW_H: float = 24.0;

const NAME_W: float = 96.0;

const FIELD_W: float = 120.0;

/// The dock's own state, hung on `S.machine`.
pub fn state() -> StatemachineState {
    // `file` holds a file-backed machine as last read or written, so a frame
    // does not read the file again.
    StatemachineState { open: nil, naming: "", file: nil, demo: -1 }
}

// The machine the selected node runs; `nil` when it runs none.
fn source(S: &mut editor::State) -> Source? {
    let node = model::selected_row(S);
    if node.is_nil() {
        return nil;
    }
    let comp = node.get(COMPONENT);
    if comp.kind() != "map" {
        return nil;
    }
    let machine = comp.machine;
    if machine.kind() == "map" {
        return Source { doc: machine, path: nil };
    }
    if machine.kind() == "str" && machine.as_str() != "" {
        let path = machine.as_str();
        if S.machine.file.is_some() {
            let held = S.machine.file.unwrap();
            if held.path == path {
                return Source { doc: held.doc, path: path };
            }
        }
        let loaded = assets::duplicate(util::engine_path(S.game_root, path));
        if loaded.kind() == "map" {
            S.machine.file = File { path: path, doc: loaded };
            return Source { doc: loaded, path: path };
        }
    }
    Source { doc: map().with("type", MACHINE_TYPE).with("states", map()).with("transitions", []), path: nil }
}

// A copy to change, so the edit lands after the history step.
fn editable(S: &mut editor::State) -> Source? {
    let found = source(S);
    if found.is_none() {
        return nil;
    }
    Source { doc: util::deep(found.unwrap().doc), path: found.unwrap().path }
}

// Write `doc` back where it came from: into the scene, or over its file.
fn write(S: &mut editor::State, found: Source, label: str) {
    if !model::has_selection(S) {
        return;
    }
    if found.path.is_some() {
        let path = found.path.unwrap();
        let abs = util::engine_path(S.game_root, path);
        fs::write(abs, toml::encode(found.doc));
        assets::reload(abs);
        S.machine.file = File { path: path, doc: found.doc };
        log::info("{label}: {path}");
    } else {
        history::record(S, label, nil);
        let node = S.doc[S.sel];
        node.get(COMPONENT).set("machine", found.doc);
        model::record_override(S, node, COMPONENT);
        model::apply_component(S, COMPONENT);
        history::commit(S);
    }
    signals::changed(S, "machine");
}

/// Give the selected node a machine of its own, driving its own player.
pub fn create(S: &mut editor::State) {
    if !model::has_selection(S) {
        return;
    }
    history::record(S, "add state machine", nil);
    let node = S.doc[S.sel];
    let machine = map().with("type", MACHINE_TYPE).with("start", "").with("states", map()).with("transitions", []);
    node.set(COMPONENT, map().with("machine", machine).with("player", "").with("active", true));
    model::record_override(S, node, COMPONENT);
    model::apply_component(S, COMPONENT);
    history::commit(S);
}

fn states(doc: any) -> any {
    let held = doc.states;
    if held.kind() == "map" { held } else { map() }
}

fn transitions(doc: any) -> [any] {
    let out: [any] = [];
    for t in util::vec(doc.transitions) {
        out.push(t);
    }
    out
}

fn state_names(doc: any) -> [str] {
    let out: [str] = [];
    let items1 = states(doc);
    for name in items1.keys() {
        out.push(name);
    }
    out
}

/// Add a state playing the clip of its own name.
pub fn add_state(S: &mut editor::State, name: str) {
    let found_or = editable(S);
    if found_or.is_none() {
        return;
    }
    let found = found_or.unwrap();
    if name == "" || name == animation::STATE_END.as_str() || states(found.doc).has(name) {
        return;
    }
    // The clip of its own name when the library has one, and otherwise the
    // library's first, so a new state plays something from the start.
    let clips = anim::clip_names(S);
    let held = states(found.doc);
    let own = clips.len() == 0 || util::contains(clips, name);
    held.set(name, if own { "" } else { clips[0] });
    found.doc.set("states", held);
    if found.doc.start.as_str() == "" {
        found.doc.set("start", name);
    }
    write(S, found, "add state");
}

/// Remove a state, and every transition into or out of it.
pub fn remove_state(S: &mut editor::State, name: str) {
    let found_or = editable(S);
    if found_or.is_none() {
        return;
    }
    let found = found_or.unwrap();
    let held = states(found.doc);
    held.remove(name);
    found.doc.set("states", held);
    let kept: [any] = [];
    for t in transitions(found.doc) {
        if t.from.as_str() != name && t.to.as_str() != name {
            kept.push(t);
        }
    }
    found.doc.set("transitions", kept);
    if found.doc.start.as_str() == name {
        found.doc.set("start", "");
    }
    S.machine.open = nil;
    write(S, found, "remove state");
}

fn set_state_clip(S: &mut editor::State, name: str, clip: any) {
    let found_or = editable(S);
    if found_or.is_none() {
        return;
    }
    let found = found_or.unwrap();
    let held = states(found.doc);
    held.set(name, if clip.as_str() == name { "" } else { clip.as_str() });
    found.doc.set("states", held);
    write(S, found, "state clip");
}

fn set_start(S: &mut editor::State, name: str) {
    let found_or = editable(S);
    if found_or.is_none() {
        return;
    }
    let found = found_or.unwrap();
    found.doc.set("start", name);
    write(S, found, "start state");
}

/// Add a transition between the first two states, open for editing.
pub fn add_transition(S: &mut editor::State) {
    let found_or = editable(S);
    if found_or.is_none() {
        return;
    }
    let found = found_or.unwrap();
    let names = state_names(found.doc);
    if names.len() == 0 {
        return;
    }
    let to = if names.len() > 1 { names[1] } else { names[0] };
    let held = transitions(found.doc);
    held.push(map().with("from", names[0]).with("to", to).with("advance_mode", animation::ADVANCE_MODE_ENABLED));
    S.machine.open = held.len() - 1;
    found.doc.set("transitions", held);
    write(S, found, "add transition");
}

pub fn remove_transition(S: &mut editor::State, at: int) {
    let found_or = editable(S);
    if found_or.is_none() {
        return;
    }
    let found = found_or.unwrap();
    let held = transitions(found.doc);
    if at >= held.len() {
        return;
    }
    held.remove(at);
    found.doc.set("transitions", held);
    S.machine.open = nil;
    write(S, found, "remove transition");
}

/// Set one field of transition `at`; an empty text or the default removes it.
pub fn set_field(S: &mut editor::State, at: int, key: str, value: any) {
    let found_or = editable(S);
    if found_or.is_none() {
        return;
    }
    let found = found_or.unwrap();
    let held = transitions(found.doc);
    if at >= held.len() {
        return;
    }
    if value.kind() == "str" && value.as_str() == "" {
        held[at].remove(key);
    } else {
        held[at].set(key, value);
    }
    found.doc.set("transitions", held);
    write(S, found, "edit transition");
}

// The State machine panel's header strip and the column its rows go in.
const PANEL: str = "Editor/Shell/Body/Centre/Bottom/StateMachine/";

const ROWS: str = "Editor/Shell/Body/Centre/Bottom/StateMachine/Rows/Column";

/// The panel's rows, as nodes: the pool makes them under the panel's column,
/// and the header fills the panel's own strip.
pub fn body(S: &mut editor::State) {
    let found_or = source(S);
    if found_or.is_none() {
        docks::toolbar(S, PANEL + "Chrome", [offer(S)]);
        pool::sync(S, ROWS, [], NAME_W, false);
        return;
    }
    let found = found_or.unwrap();
    let doc = found.doc;
    docks::toolbar(S, PANEL + "Chrome", [header_controls(S, found)]);
    pool::sync(S, ROWS, row_specs(S, doc), NAME_W, false);
}

/// What the strip says when the node runs no machine: why, and the verb that
/// gives it one.
fn offer(S: editor::State) -> [any] {
    // Bound, never a literal after a `}`: the block's value would be indexed
    // by the array rather than followed by it.
    if model::selected_row(S).is_nil() {
        return [caption("select a node to give it a state machine")];
    }
    return [
        caption("no state machine on this node"),
        map()
            .with("kind", "button")
            .with("role", "action_form_secondary")
            .with("text", "add state machine")
            .with("tooltip", "Give the node an embedded `state_machine` over its own player")
            .with("on", "handle")
            .with("data", map().with("fn", offer_on_1)),
    ];
}

fn caption(text: str) -> any {
    map().with("kind", "label").with("role", "text_caption").with("text", text)
}

fn offer_on_1(S: &mut editor::State, data: any, _0: any) {
    create(S);
}

/// The strip over the rows: where the machine lives, the state it starts in,
/// and the state it is in while the game runs.
fn header_controls(S: editor::State, found: Source) -> [any] {
    let doc = found.doc;
    let place = if found.path.is_some() { found.path.unwrap() } else { "inline" };
    let out = [
        caption(place),
        caption("start"),
        map()
            .with("kind", "dropdown")
            .with("role", "choice_form")
            .with("width", FIELD_W)
            .with("text", doc.start.as_str())
            .with("options", state_names(doc))
            .with("on", "handle")
            .with("data", map().with("fn", header_controls_on_2)),
    ];
    let now = live_state(S);
    if now != "" {
        out.push(map().with("kind", "label").with("role", "chip").with("checked", true).with("text", "now {now}"));
    }
    out
}

fn header_controls_on_2(S: &mut editor::State, data: any, picked: any) {
    set_start(S, picked.as_str());
}

// While the game runs, the state the machine is in; "" when it is not running
// or the live node answers nothing.
fn live_state(S: editor::State) -> str {
    if !S.playing {
        return "";
    }
    let found = model::selected(S)._1;
    if !found.is_valid() {
        return "";
    }
    let now = found.state_machine.current_state();
    if now.kind() == "str" { now.as_str() } else { "" }
}

/// Every row the dock shows: the states, the new-state row, the transitions,
/// and the fields of whichever transition is open.
fn row_specs(S: &mut editor::State, doc: any) -> [any] {
    let out = [head_spec("STATES", [])];
    let clips = anim::clip_names(S);
    let items1 = states(doc);
    for name in items1.keys() {
        let clip = items1.get(name);
        // Bound afresh: a closure made in a loop captures the binding.
        let state = name;
        let control = if clip.kind() == "str" {
            map()
                .with("kind", "dropdown")
                .with("role", "choice_form")
                .with("width", FIELD_W)
                .with("text", if clip.as_str() == "" { state } else { clip.as_str() })
                .with("options", clips)
                .with("on", "handle")
                .with("data", map().with("fn", row_specs_on_3).with("state", state))
        } else {
            caption("nested machine")
        };
        out.push(map()
            .with("full", false)
            .with("height", ROW_H)
            .with("slot_role", "layout_actions")
            .with("controls", [
                control,
                map()
                    .with("kind", "button")
                    .with("role", "chip_quiet")
                    .with("text", "×")
                    .with("tooltip", "Remove the state and its transitions")
                    .with("on", "handle")
                    .with("data", map().with("fn", row_specs_on_4).with("state", state)),
            ])
            .with("label", state));
    }
    out.push(map()
        .with("full", true)
        .with("height", ROW_H)
        .with("slot_role", "layout_actions")
        .with("controls", [
            map()
                .with("kind", "text_field")
                .with("role", "input_form")
                .with("width", NAME_W + FIELD_W)
                .with("text", S.machine.naming)
                .with("placeholder", "new state")
                .with("on", "handle")
                .with("on_submit", "handle_submit")
                .with("data", map().with("fn", row_specs_on_5).with("submit", row_specs_on_6)),
            map()
                .with("kind", "button")
                .with("role", "action_form_secondary")
                .with("text", "add state")
                .with("tooltip", "A state playing the clip of its own name")
                .with("on", "handle")
                .with("data", map().with("fn", row_specs_on_7)),
        ]));
    transition_specs(S, doc, out);
    out
}

fn row_specs_on_3(S: &mut editor::State, data: any, picked: any) {
    let state: str = data.state;
    set_state_clip(S, state, picked);
}

fn row_specs_on_4(S: &mut editor::State, data: any, _0: any) {
    let state: str = data.state;
    remove_state(S, state);
}

fn row_specs_on_5(S: &mut editor::State, data: any, text: any) {
    S.machine.naming = text.as_str();
}

fn row_specs_on_6(S: &mut editor::State, data: any, text: any) {
    named(S, text.as_str());
}

fn row_specs_on_7(S: &mut editor::State, data: any, _0: any) {
    named(S, S.machine.naming);
}

// Add whatever the new-state field holds, and empty it.
fn named(S: &mut editor::State, text: str) {
    if text == "" {
        return;
    }
    add_state(S, text);
    S.machine.naming = "";
}

fn transition_specs(S: editor::State, doc: any, out: [any]) {
    out.push(head_spec("TRANSITIONS", [
        map()
            .with("kind", "button")
            .with("role", "action_form_secondary")
            .with("text", "add transition")
            .with("tooltip", "A transition between two states, opened for editing")
            .with("on", "handle")
            .with("data", map().with("fn", transition_specs_on_8)),
    ]));
    let names = state_names(doc);
    // `end` is somewhere a transition goes, never somewhere one leaves.
    let targets = state_names(doc);
    targets.push(animation::STATE_END);
    let items1 = transitions(doc);
    for at in 0..items1.len() {
        let t = items1[at];
        // Bound afresh: a closure made in a loop captures the binding.
        let index = at;
        let open = S.machine.open.is_some() && S.machine.open.unwrap() == index;
        let from = if t.from.is_nil() { "?" } else { t.from.as_str() };
        let to = if t.to.is_nil() { "?" } else { t.to.as_str() };
        let mode = if t.advance_mode.is_nil() { animation::ADVANCE_MODE_ENABLED } else { t.advance_mode.as_str() };
        out.push(map()
            .with("full", true)
            .with("height", ROW_H)
            .with("slot_role", "layout_actions")
            .with("controls", [
                map()
                    .with("kind", "button")
                    .with("min_width", NAME_W + FIELD_W)
                    .with("role", "item_list")
                    .with("checked", open)
                    .with("text", "{from} → {to}  {mode}")
                    .with("tooltip", "Open the transition's fields")
                    .with("on", "handle")
                    .with("data", map().with("fn", transition_specs_on_9).with("open", open).with("index", index)),
                map()
                    .with("kind", "button")
                    .with("role", "chip_quiet")
                    .with("text", "×")
                    .with("tooltip", "Remove the transition")
                    .with("on", "handle")
                    .with("data", map().with("fn", transition_specs_on_10).with("index", index)),
            ]));
        if open {
            field_specs(S, index, t, names, targets, out);
        }
    }
}

fn transition_specs_on_8(S: &mut editor::State, data: any, _0: any) {
    add_transition(S);
}

fn transition_specs_on_9(S: &mut editor::State, data: any, _0: any) {
    let open: bool = data.open;
    let index: int = data.index;
    S.machine.open = if open { nil } else { index };
}

fn transition_specs_on_10(S: &mut editor::State, data: any, _0: any) {
    let index: int = data.index;
    remove_transition(S, index);
}

/// A heading across the rows, with whatever verbs belong beside it.
fn head_spec(text: str, verbs: [any]) -> any {
    let controls = [caption(text)];
    for verb in verbs {
        controls.push(verb);
    }
    map().with("full", true).with("height", ROW_H).with("slot_role", "layout_actions").with("controls", controls)
}

// The label a transition's own field wears: indented, so the fields read as
// belonging to the row above them.
fn field_spec(label: str, control: any) -> any {
    map().with("full", false).with("height", ROW_H).with("controls", [control]).with("label", "    " + label)
}

fn choice(S: editor::State, at: int, key: str, current: str, choices: [str]) -> any {
    map()
        .with("kind", "dropdown")
        .with("role", "choice_form")
        .with("width", FIELD_W)
        .with("text", current)
        .with("options", choices)
        .with("on", "handle")
        .with("data", map().with("fn", choice_on_11).with("at", at).with("key", key))
}

fn choice_on_11(S: &mut editor::State, data: any, picked: any) {
    let at: int = data.at;
    let key: str = data.key;
    set_field(S, at, key, picked);
}

fn text_of(S: editor::State, at: int, key: str, current: str, placeholder: str) -> any {
    map()
        .with("kind", "text_field")
        .with("role", "input_form")
        .with("width", FIELD_W)
        .with("text", current)
        .with("placeholder", placeholder)
        .with("on_submit", "handle_submit")
        .with("data", map().with("submit", text_of_on_12).with("current", current).with("at", at).with("key", key))
}

fn text_of_on_12(S: &mut editor::State, data: any, value: any) {
    let current: str = data.current;
    let at: int = data.at;
    let key: str = data.key;
    if value.as_str() != current {
        set_field(S, at, key, value);
    }
}

// `whole` is both how it steps and what it writes: a drag value shows as many
// decimals as its speed has, and `priority` parses a whole number only.
fn number(S: editor::State, at: int, key: str, current: float, whole: bool) -> any {
    map()
        .with("kind", "number_field")
        .with("role", "input_number")
        .with("width", FIELD_W)
        .with("value", util::f(current))
        .with("min", 0.0)
        .with("max", if whole { 1000.0 } else { 100.0 })
        .with("drag_speed", if whole { 1.0 } else { 0.01 })
        .with("on", "handle")
        .with("data", map().with("fn", number_on_13).with("at", at).with("key", key).with("whole", whole))
}

fn number_on_13(S: &mut editor::State, data: any, v: any) {
    let at: int = data.at;
    let key: str = data.key;
    let whole: bool = data.whole;
    if whole {
        set_field(S, at, key, util::i(v.as_float()));
    } else {
        set_field(S, at, key, v.as_float());
    }
}

fn flag(S: editor::State, at: int, key: str, on: bool) -> any {
    map()
        .with("kind", "switch")
        .with("role", "switch_form")
        .with("checked", on)
        .with("on", "handle")
        .with("data", map().with("fn", flag_on_14).with("at", at).with("key", key))
}

fn flag_on_14(S: &mut editor::State, data: any, v: any) {
    let at: int = data.at;
    let key: str = data.key;
    set_field(S, at, key, v);
}

fn field_specs(S: editor::State, at: int, t: any, names: [str], targets: [str], out: [any]) {
    let ease = if t.ease.is_nil() { animation::EASE_LINEAR } else { t.ease.as_str() };
    let advance = if t.advance_mode.is_nil() { animation::ADVANCE_MODE_ENABLED } else { t.advance_mode.as_str() };
    let switch = if t.switch_mode.is_nil() { animation::SWITCH_MODE_IMMEDIATE } else { t.switch_mode.as_str() };
    let priority = if t.priority.is_nil() { 1 } else { t.priority.as_int() };
    out.push(field_spec("from", choice(S, at, "from", t.from.as_str(), names)));
    out.push(field_spec("to", choice(S, at, "to", t.to.as_str(), targets)));
    out.push(field_spec("blend time", number(S, at, "blend_time", t.blend_time.as_float(), false)));
    out.push(field_spec("ease", choice(S, at, "ease", ease, animation::ease_names())));
    out.push(field_spec("advance mode", choice(S, at, "advance_mode", advance, [animation::ADVANCE_MODE_DISABLED, animation::ADVANCE_MODE_ENABLED, animation::ADVANCE_MODE_AUTO])));
    out.push(field_spec("switch mode", choice(S, at, "switch_mode", switch, [animation::SWITCH_MODE_IMMEDIATE, animation::SWITCH_MODE_SYNC, animation::SWITCH_MODE_AT_END])));
    out.push(field_spec("condition", text_of(S, at, "condition", t.condition.as_str(), "none")));
    out.push(field_spec("check", text_of(S, at, "check", t.check.as_str(), "no method")));
    out.push(field_spec("priority", number(S, at, "priority", priority as float, true)));
    out.push(field_spec("reset", flag(S, at, "reset", t.reset.is_nil() || t.reset.as_bool())));
    out.push(field_spec("break loop at end", flag(S, at, "break_loop_at_end", t.break_loop_at_end.as_bool())));
}

fn check(ok: bool, what: str) {
    if ok {
        log::info("selftest ok: {what}");
    } else {
        log::error("selftest FAILED: {what}");
    }
}

/// `--state machinedemo`: on the first node with a player, add a state and a
/// transition, edit and remove them, and undo back to the scene as it was.
pub fn selftest(S: &mut editor::State) {
    let player: int? = nil;
    for i in 0..S.doc.len() {
        if S.doc[i].has("animation") {
            player = i;
            break;
        }
    }
    if player.is_none() {
        log::info("selftest state machine: no player; skipped");
        return;
    }
    let p = player.unwrap();
    shell::choose(S, p);
    let before = toml::encode(util::deep(S.doc[p]));
    if source(S).is_none() {
        create(S);
    }
    check(source(S).is_some(), "the node runs a state machine");
    add_state(S, "sm_probe");
    let doc = source(S).unwrap().doc;
    check(states(doc).has("sm_probe"), "a state is added");
    let count = transitions(doc).len();
    add_transition(S);
    let at = count;
    set_field(S, at, "to", "sm_probe");
    set_field(S, at, "blend_time", 0.3);
    set_field(S, at, "advance_mode", animation::ADVANCE_MODE_AUTO);
    set_field(S, at, "priority", 2);
    let t = transitions(source(S).unwrap().doc)[at];
    check(t.blend_time.as_float() == 0.3 && t.advance_mode.as_str() == animation::ADVANCE_MODE_AUTO, "a transition's fields are written");
    check(t.priority.kind() == "int" && t.priority.as_int() == 2, "priority stays a whole number");
    set_field(S, at, "condition", "go");
    set_field(S, at, "condition", "");
    let t = transitions(source(S).unwrap().doc)[at];
    check(!t.has("condition"), "an emptied field is removed");
    remove_state(S, "sm_probe");
    let doc = source(S).unwrap().doc;
    let dangling = false;
    for t in transitions(doc) {
        if t.to.as_str() == "sm_probe" {
            dangling = true;
        }
    }
    check(!states(doc).has("sm_probe") && !dangling, "removing a state removes its transitions");
    let guard = 0;
    while history::can_undo(S) && guard < 200 {
        shell::undo(S);
        guard += 1;
    }
    check(toml::encode(util::deep(S.doc[p])) == before, "undoing everything restores the node");
    // Left on the dock with a transition open, so the shot this state takes
    // is of the fields as well as the rows.
    docks::show(S, "statemachine");
    // Only where the scene authored one: the undo above took back the machine
    // this test made, so a node that came with none has none now.
    let found = source(S);
    if found.is_some() {
        if transitions(found.unwrap().doc).len() > 0 {
            S.machine.open = 0;
            S.machine.demo = 0;
            selftest::stepping(S, "machine");
            signals::changed(S, "machine");
        }
    }
    log::info("selftest state machine: done");
}

// Two frames: the pool writes the rows on the first draw after this, and a
// node reports the box it was given the pass after it was laid out.
const ROWS_SETTLED: int = 3;

/// What the dock put on the scene, once it has drawn: the rows are nodes, and
/// an open transition is its fields under the row that opened it.
pub fn demo_step(S: &mut editor::State) {
    S.machine.demo = S.machine.demo + 1;
    if S.machine.demo < ROWS_SETTLED {
        return;
    }
    S.machine.demo = -1;
    let host = scene::get_node(ROWS);
    let labels: [str] = [];
    for row in host.children() {
        let label = row.get_node("L");
        if label.is_valid() && label.get_component("widget", "visible").as_bool() {
            labels.push(label.get_component("widget", "text").as_str());
        }
    }
    let seen = util::join(labels, ", ");
    check(util::contains(labels, "wave") || util::contains(labels, "bow"), "the states are rows on the scene ({seen})");
    check(util::contains(labels, "    from") && util::contains(labels, "    priority"), "an open transition puts its fields under it ({seen})");
}
