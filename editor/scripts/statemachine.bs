// The State machine dock: the selected node's `state_machine` as its states
// and transitions, edited in place and written back where the machine lives.

use anim;
use docks;
use editor;
use history;
use model;
use pool;
use selftest;
use shell;
use signals;
use util;

pub class StatemachineState {
    open: int?,
    naming: str,
    file: File?,
    demo: int,
}

/// The machine as it is authored: an inline table, or a file's contents and
/// its path.
pub struct Source {
    doc: any,
    path: str?,
}

pub struct File {
    path: str,
    doc: any,
}

// The component and the asset type `balaur_animation` registers, and the keys the
// component and the machine document spell.
const COMPONENT: str = "state_machine";

const MACHINE_TYPE: str = "state_machine";

const ROW_H: float = 24.0;

const NAME_W: float = 96.0;

const FIELD_W: float = 120.0;

/// The dock's own state, hung on `state.machine`.
pub fn state() -> StatemachineState {
    // `file` holds a file-backed machine as last read or written, so a frame
    // does not read the file again.
    StatemachineState { open: nil, naming: "", file: nil, demo: -1 }
}

// The machine the selected node runs; `nil` when it runs none.
fn source(state: &mut editor::State) -> Source? {
    let found = model::selected_node(state);
    if !found.is_valid() || !found.has_component(COMPONENT) {
        return nil;
    }
    let comp = found.authored(COMPONENT);
    let machine = comp.machine;
    if machine.kind() == "map" {
        return Source { doc: machine, path: nil };
    }
    if machine.kind() == "str" && machine.as_str() != "" {
        let path = machine.as_str();
        if state.machine.file.is_some() {
            let held = state.machine.file.unwrap();
            if held.path == path {
                return Source { doc: held.doc, path: path };
            }
        }
        let loaded = assets::duplicate(util::engine_path(state.game_root, path));
        if loaded.kind() == "map" {
            state.machine.file = File { path: path, doc: loaded };
            return Source { doc: loaded, path: path };
        }
    }
    Source { doc: map().with("type", MACHINE_TYPE).with("states", map()).with("transitions", []), path: nil }
}

// A copy to change, so the edit lands after the history step: a machine in
// the scene is read afresh from the node, one in a file is the held copy.
fn editable(state: &mut editor::State) -> Source? {
    let found = source(state);
    if found.is_none() {
        return nil;
    }
    Source { doc: util::deep(found.unwrap().doc), path: found.unwrap().path }
}

// Write `doc` back where it came from: into the scene, or over its file.
fn write(state: &mut editor::State, found: Source, label: str) {
    if !model::has_selection(state) {
        return;
    }
    if found.path.is_some() {
        let path = found.path.unwrap();
        let abs = util::engine_path(state.game_root, path);
        fs::write(abs, toml::encode(found.doc));
        assets::reload(abs);
        state.machine.file = File { path: path, doc: found.doc };
        log::info("{label}: {path}");
    } else {
        history::record(state, label, nil);
        model::selected_node(state).patch_component(COMPONENT, map().with("machine", found.doc));
        history::commit(state);
    }
    signals::changed(state, "machine");
}

/// Give the selected node a machine of its own, driving its own player.
pub fn create(state: &mut editor::State) {
    if !model::has_selection(state) {
        return;
    }
    history::record(state, "add state machine", nil);
    let machine = map().with("type", MACHINE_TYPE).with("start", "").with("states", map()).with("transitions", []);
    model::selected_node(state).set_component(COMPONENT, map().with("machine", machine).with("player", "").with("active", true));
    history::commit(state);
}

fn states(doc: any) -> any {
    let held = doc.states;
    if held.kind() == "map" { held } else { map() }
}

fn transitions(doc: any) -> [any] {
    let out: [any] = [];
    for transition in util::vec(doc.transitions) {
        out.push(transition);
    }
    out
}

fn state_names(doc: any) -> [str] {
    let out: [str] = [];
    let machine_states = states(doc);
    for name in machine_states.keys() {
        out.push(name);
    }
    out
}

/// Add a state playing the clip of its own name.
pub fn add_state(state: &mut editor::State, name: str) {
    let copy = editable(state);
    if copy.is_none() {
        return;
    }
    let found = copy.unwrap();
    if name == "" || name == animation::STATE_END.as_str() || states(found.doc).has(name) {
        return;
    }
    // The clip of its own name when the library has one, and otherwise the
    // library's first, so a new state plays something from the start.
    let clips = anim::clip_names(state);
    let held = states(found.doc);
    let own = clips.len() == 0 || util::contains(clips, name);
    held.set(name, if own { "" } else { clips[0] });
    found.doc.set("states", held);
    if found.doc.start.as_str() == "" {
        found.doc.set("start", name);
    }
    write(state, found, "add state");
}

/// Remove a state, and every transition into or out of it.
pub fn remove_state(state: &mut editor::State, name: str) {
    let copy = editable(state);
    if copy.is_none() {
        return;
    }
    let found = copy.unwrap();
    let held = states(found.doc);
    held.remove(name);
    found.doc.set("states", held);
    let kept: [any] = [];
    for transition in transitions(found.doc) {
        if transition.from.as_str() != name && transition.to.as_str() != name {
            kept.push(transition);
        }
    }
    found.doc.set("transitions", kept);
    if found.doc.start.as_str() == name {
        found.doc.set("start", "");
    }
    state.machine.open = nil;
    write(state, found, "remove state");
}

fn set_state_clip(state: &mut editor::State, name: str, clip: any) {
    let copy = editable(state);
    if copy.is_none() {
        return;
    }
    let found = copy.unwrap();
    let held = states(found.doc);
    held.set(name, if clip.as_str() == name { "" } else { clip.as_str() });
    found.doc.set("states", held);
    write(state, found, "state clip");
}

fn set_start(state: &mut editor::State, name: str) {
    let copy = editable(state);
    if copy.is_none() {
        return;
    }
    let found = copy.unwrap();
    found.doc.set("start", name);
    write(state, found, "start state");
}

/// Add a transition between the first two states, open for editing.
pub fn add_transition(state: &mut editor::State) {
    let copy = editable(state);
    if copy.is_none() {
        return;
    }
    let found = copy.unwrap();
    let names = state_names(found.doc);
    if names.len() == 0 {
        return;
    }
    let to = if names.len() > 1 { names[1] } else { names[0] };
    let held = transitions(found.doc);
    held.push(map().with("from", names[0]).with("to", to).with("advance_mode", animation::ADVANCE_MODE_ENABLED));
    state.machine.open = held.len() - 1;
    found.doc.set("transitions", held);
    write(state, found, "add transition");
}

pub fn remove_transition(state: &mut editor::State, at: int) {
    let copy = editable(state);
    if copy.is_none() {
        return;
    }
    let found = copy.unwrap();
    let held = transitions(found.doc);
    if at >= held.len() {
        return;
    }
    held.remove(at);
    found.doc.set("transitions", held);
    state.machine.open = nil;
    write(state, found, "remove transition");
}

/// Set one field of transition `at`; an empty text or the default removes it.
pub fn set_field(state: &mut editor::State, at: int, key: str, value: any) {
    let copy = editable(state);
    if copy.is_none() {
        return;
    }
    let found = copy.unwrap();
    let held = transitions(found.doc);
    if at >= held.len() {
        return;
    }
    if value.kind() == "str" && value.as_str() == "" {
        held[at].remove(key);
    } else {
        held[at].set(key, value);
    }
    found.doc.set("transitions", held);
    write(state, found, "edit transition");
}

// The State machine panel's header strip and the column its rows go in.
const PANEL: str = "Editor/Shell/Body/Centre/Bottom/StateMachine/";

const ROWS: str = "Editor/Shell/Body/Centre/Bottom/StateMachine/Rows/Column";

/// The panel's rows, as nodes: the pool makes them under the panel's column,
/// and the header fills the panel's own strip.
pub fn body(state: &mut editor::State) {
    let authored = source(state);
    if authored.is_none() {
        docks::toolbar(state, PANEL + "Chrome", [offer(state)]);
        pool::sync(state, ROWS, [], NAME_W, false);
        return;
    }
    let found = authored.unwrap();
    let doc = found.doc;
    docks::toolbar(state, PANEL + "Chrome", [header_controls(state, found)]);
    pool::sync(state, ROWS, row_specs(state, doc), NAME_W, false);
}

/// What the strip says when the node runs no machine: why, and the verb that
/// gives it one.
fn offer(state: editor::State) -> [any] {
    // Bound, never a literal after a `}`: the block's value would be indexed
    // by the array rather than followed by it.
    if !model::selected_node(state).is_valid() {
        return [caption("select a node to give it a state machine")];
    }
    return [
        caption("no state machine on this node"),
        map()
            .with("kind", "button")
            .with("role", "action_form_secondary")
            .with("text", "add state machine")
            .with("tooltip", "Give the node an embedded `state_machine` over its own player")
            .with("on", "handle")
            .with("data", map().with("fn", on_add_machine_pressed)),
    ];
}

fn caption(text: str) -> any {
    map().with("kind", "label").with("role", "text_caption").with("text", text)
}

fn on_add_machine_pressed(state: &mut editor::State, data: any, _value: any) {
    create(state);
}

/// The strip over the rows: where the machine lives, the state it starts in,
/// and the state it is in while the game runs.
fn header_controls(state: editor::State, found: Source) -> [any] {
    let doc = found.doc;
    let place = if found.path.is_some() { found.path.unwrap() } else { "inline" };
    let out = [
        caption(place),
        caption("start"),
        map()
            .with("kind", "dropdown")
            .with("role", "choice_form")
            .with("width", FIELD_W)
            .with("text", doc.start.as_str())
            .with("options", state_names(doc))
            .with("on", "handle")
            .with("data", map().with("fn", on_start_picked)),
    ];
    let now = live_state(state);
    if now != "" {
        out.push(map().with("kind", "label").with("role", "chip").with("checked", true).with("text", "now {now}"));
    }
    out
}

fn on_start_picked(state: &mut editor::State, data: any, picked: any) {
    set_start(state, picked.as_str());
}

// While the game runs, the state the machine is in; "" when it is not running
// or the live node answers nothing.
fn live_state(state: editor::State) -> str {
    if !state.playing {
        return "";
    }
    let found = model::selected_node(state);
    if !found.is_valid() {
        return "";
    }
    let now = found.state_machine.current_state();
    if now.kind() == "str" { now.as_str() } else { "" }
}

/// Every row the dock shows: the states, the new-state row, the transitions,
/// and the fields of whichever transition is open.
fn row_specs(state: &mut editor::State, doc: any) -> [any] {
    let out = [head_spec("STATES", [])];
    let clips = anim::clip_names(state);
    let machine_states = states(doc);
    for name in machine_states.keys() {
        let clip = machine_states.get(name);
        // Bound afresh: a closure made in a loop captures the binding.
        let state_name = name;
        let control = if clip.kind() == "str" {
            map()
                .with("kind", "dropdown")
                .with("role", "choice_form")
                .with("width", FIELD_W)
                .with("text", if clip.as_str() == "" { state_name } else { clip.as_str() })
                .with("options", clips)
                .with("on", "handle")
                .with("data", map().with("fn", on_state_clip_picked).with("state", state_name))
        } else {
            caption("nested machine")
        };
        out.push(map()
            .with("full", false)
            .with("height", ROW_H)
            .with("slot_role", "layout_actions")
            .with("controls", [
                control,
                map()
                    .with("kind", "button")
                    .with("role", "chip_quiet")
                    .with("text", "×")
                    .with("tooltip", "Remove the state and its transitions")
                    .with("on", "handle")
                    .with("data", map().with("fn", on_state_remove_pressed).with("state", state_name)),
            ])
            .with("label", state_name));
    }
    out.push(map()
        .with("full", true)
        .with("height", ROW_H)
        .with("slot_role", "layout_actions")
        .with("controls", [
            map()
                .with("kind", "text_field")
                .with("role", "input_form")
                .with("width", NAME_W + FIELD_W)
                .with("text", state.machine.naming)
                .with("placeholder", "new state")
                .with("on", "handle")
                .with("on_submit", "handle_submit")
                .with("data", map().with("fn", on_new_state_typed).with("submit", on_new_state_submitted)),
            map()
                .with("kind", "button")
                .with("role", "action_form_secondary")
                .with("text", "add state")
                .with("tooltip", "A state playing the clip of its own name")
                .with("on", "handle")
                .with("data", map().with("fn", on_add_state_pressed)),
        ]));
    transition_specs(state, doc, out);
    out
}

fn on_state_clip_picked(state: &mut editor::State, data: any, picked: any) {
    let state_name: str = data.state;
    set_state_clip(state, state_name, picked);
}

fn on_state_remove_pressed(state: &mut editor::State, data: any, _value: any) {
    let state_name: str = data.state;
    remove_state(state, state_name);
}

fn on_new_state_typed(state: &mut editor::State, data: any, text: any) {
    state.machine.naming = text.as_str();
}

fn on_new_state_submitted(state: &mut editor::State, data: any, text: any) {
    named(state, text.as_str());
}

fn on_add_state_pressed(state: &mut editor::State, data: any, _value: any) {
    named(state, state.machine.naming);
}

// Add whatever the new-state field holds, and empty it.
fn named(state: &mut editor::State, text: str) {
    if text == "" {
        return;
    }
    add_state(state, text);
    state.machine.naming = "";
}

fn transition_specs(state: editor::State, doc: any, out: [any]) {
    out.push(head_spec("TRANSITIONS", [
        map()
            .with("kind", "button")
            .with("role", "action_form_secondary")
            .with("text", "add transition")
            .with("tooltip", "A transition between two states, opened for editing")
            .with("on", "handle")
            .with("data", map().with("fn", on_add_transition_pressed)),
    ]));
    let names = state_names(doc);
    // `end` is somewhere a transition goes, never somewhere one leaves.
    let targets = state_names(doc);
    targets.push(animation::STATE_END);
    let all_transitions = transitions(doc);
    for at in 0..all_transitions.len() {
        let transition = all_transitions[at];
        // Bound afresh: a closure made in a loop captures the binding.
        let index = at;
        let open = state.machine.open.is_some() && state.machine.open.unwrap() == index;
        let from = if transition.from.is_nil() { "?" } else { transition.from.as_str() };
        let to = if transition.to.is_nil() { "?" } else { transition.to.as_str() };
        let mode = if transition.advance_mode.is_nil() { animation::ADVANCE_MODE_ENABLED } else { transition.advance_mode.as_str() };
        out.push(map()
            .with("full", true)
            .with("height", ROW_H)
            .with("slot_role", "layout_actions")
            .with("controls", [
                map()
                    .with("kind", "button")
                    .with("min_width", NAME_W + FIELD_W)
                    .with("role", "item_list")
                    .with("checked", open)
                    .with("text", "{from} → {to}  {mode}")
                    .with("tooltip", "Open the transition's fields")
                    .with("on", "handle")
                    .with("data", map().with("fn", on_transition_picked).with("open", open).with("index", index)),
                map()
                    .with("kind", "button")
                    .with("role", "chip_quiet")
                    .with("text", "×")
                    .with("tooltip", "Remove the transition")
                    .with("on", "handle")
                    .with("data", map().with("fn", on_transition_remove_pressed).with("index", index)),
            ]));
        if open {
            field_specs(state, index, transition, names, targets, out);
        }
    }
}

fn on_add_transition_pressed(state: &mut editor::State, data: any, _value: any) {
    add_transition(state);
}

fn on_transition_picked(state: &mut editor::State, data: any, _value: any) {
    let open: bool = data.open;
    let index: int = data.index;
    state.machine.open = if open { nil } else { index };
}

fn on_transition_remove_pressed(state: &mut editor::State, data: any, _value: any) {
    let index: int = data.index;
    remove_transition(state, index);
}

/// A heading across the rows, with whatever verbs belong beside it.
fn head_spec(text: str, verbs: [any]) -> any {
    let controls = [caption(text)];
    for verb in verbs {
        controls.push(verb);
    }
    map().with("full", true).with("height", ROW_H).with("slot_role", "layout_actions").with("controls", controls)
}

// The label a transition's own field wears: indented, so the fields read as
// belonging to the row above them.
fn field_spec(label: str, control: any) -> any {
    map().with("full", false).with("height", ROW_H).with("controls", [control]).with("label", "    " + label)
}

fn choice(state: editor::State, at: int, key: str, current: str, choices: [str]) -> any {
    map()
        .with("kind", "dropdown")
        .with("role", "choice_form")
        .with("width", FIELD_W)
        .with("text", current)
        .with("options", choices)
        .with("on", "handle")
        .with("data", map().with("fn", on_choice_picked).with("at", at).with("key", key))
}

fn on_choice_picked(state: &mut editor::State, data: any, picked: any) {
    let at: int = data.at;
    let key: str = data.key;
    set_field(state, at, key, picked);
}

fn text_of(state: editor::State, at: int, key: str, current: str, placeholder: str) -> any {
    map()
        .with("kind", "text_field")
        .with("role", "input_form")
        .with("width", FIELD_W)
        .with("text", current)
        .with("placeholder", placeholder)
        .with("on_submit", "handle_submit")
        .with("data", map().with("submit", on_text_submitted).with("current", current).with("at", at).with("key", key))
}

fn on_text_submitted(state: &mut editor::State, data: any, value: any) {
    let current: str = data.current;
    let at: int = data.at;
    let key: str = data.key;
    if value.as_str() != current {
        set_field(state, at, key, value);
    }
}

// `whole` is both how it steps and what it writes: a drag value shows as many
// decimals as its speed has, and `priority` parses a whole number only.
fn number(state: editor::State, at: int, key: str, current: float, whole: bool) -> any {
    map()
        .with("kind", "number_field")
        .with("role", "input_number")
        .with("width", FIELD_W)
        .with("value", current.as_float())
        .with("min", 0.0)
        .with("max", if whole { 1000.0 } else { 100.0 })
        .with("drag_speed", if whole { 1.0 } else { 0.01 })
        .with("on", "handle")
        .with("data", map().with("fn", on_number_changed).with("at", at).with("key", key).with("whole", whole))
}

fn on_number_changed(state: &mut editor::State, data: any, value: any) {
    let at: int = data.at;
    let key: str = data.key;
    let whole: bool = data.whole;
    if whole {
        set_field(state, at, key, (value.as_float() as int));
    } else {
        set_field(state, at, key, value.as_float());
    }
}

fn flag(state: editor::State, at: int, key: str, on: bool) -> any {
    map()
        .with("kind", "switch")
        .with("role", "switch_form")
        .with("checked", on)
        .with("on", "handle")
        .with("data", map().with("fn", on_flag_changed).with("at", at).with("key", key))
}

fn on_flag_changed(state: &mut editor::State, data: any, value: any) {
    let at: int = data.at;
    let key: str = data.key;
    set_field(state, at, key, value);
}

fn field_specs(state: editor::State, at: int, transition: any, names: [str], targets: [str], out: [any]) {
    let ease = if transition.ease.is_nil() { animation::EASE_LINEAR } else { transition.ease.as_str() };
    let advance = if transition.advance_mode.is_nil() { animation::ADVANCE_MODE_ENABLED } else { transition.advance_mode.as_str() };
    let switch = if transition.switch_mode.is_nil() { animation::SWITCH_MODE_IMMEDIATE } else { transition.switch_mode.as_str() };
    let priority = if transition.priority.is_nil() { 1 } else { transition.priority.as_int() };
    out.push(field_spec("from", choice(state, at, "from", transition.from.as_str(), names)));
    out.push(field_spec("to", choice(state, at, "to", transition.to.as_str(), targets)));
    out.push(field_spec("blend time", number(state, at, "blend_time", transition.blend_time.as_float(), false)));
    out.push(field_spec("ease", choice(state, at, "ease", ease, animation::ease_names())));
    out.push(field_spec("advance mode", choice(state, at, "advance_mode", advance, [animation::ADVANCE_MODE_DISABLED, animation::ADVANCE_MODE_ENABLED, animation::ADVANCE_MODE_AUTO])));
    out.push(field_spec("switch mode", choice(state, at, "switch_mode", switch, [animation::SWITCH_MODE_IMMEDIATE, animation::SWITCH_MODE_SYNC, animation::SWITCH_MODE_AT_END])));
    out.push(field_spec("condition", text_of(state, at, "condition", transition.condition.as_str(), "none")));
    out.push(field_spec("check", text_of(state, at, "check", transition.check.as_str(), "no method")));
    out.push(field_spec("priority", number(state, at, "priority", priority as float, true)));
    out.push(field_spec("reset", flag(state, at, "reset", transition.reset.is_nil() || transition.reset.as_bool())));
    out.push(field_spec("break loop at end", flag(state, at, "break_loop_at_end", transition.break_loop_at_end.as_bool())));
}

fn check(ok: bool, what: str) {
    if ok {
        log::info("selftest ok: {what}");
    } else {
        log::error("selftest FAILED: {what}");
    }
}

/// `--state machinedemo`: on the first node with a player, add a state and a
/// transition, edit and remove them, and undo back to the scene as it was.
pub fn selftest(state: &mut editor::State) {
    let player: int? = nil;
    for index in 0..state.nodes.len() {
        if state.nodes[index].has_component("animation") {
            player = index;
            break;
        }
    }
    if player.is_none() {
        log::info("selftest state machine: no player; skipped");
        return;
    }
    let node_index = player.unwrap();
    shell::choose(state, node_index);
    let before = model::node_text(state, state.nodes[node_index]);
    if source(state).is_none() {
        create(state);
    }
    check(source(state).is_some(), "the node runs a state machine");
    add_state(state, "sm_probe");
    let doc = source(state).unwrap().doc;
    check(states(doc).has("sm_probe"), "a state is added");
    let count = transitions(doc).len();
    add_transition(state);
    let at = count;
    set_field(state, at, "to", "sm_probe");
    set_field(state, at, "blend_time", 0.3);
    set_field(state, at, "advance_mode", animation::ADVANCE_MODE_AUTO);
    set_field(state, at, "priority", 2);
    let transition = transitions(source(state).unwrap().doc)[at];
    check(transition.blend_time.as_float() == 0.3 && transition.advance_mode.as_str() == animation::ADVANCE_MODE_AUTO, "a transition's fields are written");
    check(transition.priority.kind() == "int" && transition.priority.as_int() == 2, "priority stays a whole number");
    set_field(state, at, "condition", "go");
    set_field(state, at, "condition", "");
    let transition = transitions(source(state).unwrap().doc)[at];
    check(!transition.has("condition"), "an emptied field is removed");
    remove_state(state, "sm_probe");
    let doc = source(state).unwrap().doc;
    let dangling = false;
    for transition in transitions(doc) {
        if transition.to.as_str() == "sm_probe" {
            dangling = true;
        }
    }
    check(!states(doc).has("sm_probe") && !dangling, "removing a state removes its transitions");
    let guard = 0;
    while history::can_undo(state) && guard < 200 {
        shell::undo(state);
        guard += 1;
    }
    check(model::node_text(state, state.nodes[node_index]) == before, "undoing everything restores the node");
    // Left on the dock with a transition open, so the shot this state takes
    // is of the fields as well as the rows.
    docks::show(state, "statemachine");
    // Only where the scene authored one: the undo above took back the machine
    // this test made, so a node that came with none has none now.
    let found = source(state);
    if found.is_some() {
        if transitions(found.unwrap().doc).len() > 0 {
            state.machine.open = 0;
            state.machine.demo = 0;
            selftest::stepping(state, "machine");
            signals::changed(state, "machine");
        }
    }
    log::info("selftest state machine: done");
}

// Two frames: the pool writes the rows on the first draw after this, and a
// node reports the box it was given the pass after it was laid out.
const ROWS_SETTLED: int = 3;

/// What the dock put on the scene, once it has drawn: the rows are nodes, and
/// an open transition is its fields under the row that opened it.
pub fn demo_step(state: &mut editor::State) {
    state.machine.demo = state.machine.demo + 1;
    if state.machine.demo < ROWS_SETTLED {
        return;
    }
    state.machine.demo = -1;
    let host = scene::get_node(ROWS);
    let labels: [str] = [];
    for row in host.children() {
        let label = row.get_node("L");
        if label.is_valid() && label.get_component("widget", "visible").as_bool() {
            labels.push(label.get_component("widget", "text").as_str());
        }
    }
    let seen = util::join(labels, ", ");
    check(util::contains(labels, "wave") || util::contains(labels, "bow"), "the states are rows on the scene ({seen})");
    check(util::contains(labels, "    from") && util::contains(labels, "    priority"), "an open transition puts its fields under it ({seen})");
}
