// One search box for every list in the editor, and one rule for what a query
// matches. A dock that grows a filter uses these rather than its own, so
// "find in the tree" and "find in settings" feel like the same gesture.

use editor;

/// A search control a pooled strip holds, rather than one drawn: the same
/// state under the same `id`, so `query` answers for either. Its edit comes
/// back to the Editor's `search_typed` with the `id` it carries.
pub fn control(state: editor::State, id: str, placeholder: str, width: float) -> any {
    {
        "kind": "text_field",
        "role": "input_dock",
        "width": width,
        "text": query(state, id),
        "placeholder": placeholder,
        "on": "search_typed",
        "data": id,
    }
}

/// What a search control's edit writes: the query under its `id`.
pub fn typed(state: &mut editor::State, id: str, text: str) {
    state.search[id] = text;
}

/// The query a dock is filtering by, "" when it is not.
pub fn query(state: editor::State, id: str) -> str {
    let held = state.search[id];
    if held == nil { "" } else { held.as_str() }
}

/// Whether `text` satisfies `query`. Case-insensitive, and every word of the
/// query has to appear somewhere, so "ball body" finds a node named Ball with
/// a body component when both texts are joined before the test.
pub fn matches(query: str, text: str) -> bool {
    if query == "" {
        return true;
    }
    let haystack = text.to_lower();
    for word in query.to_lower().split(" ") {
        if word != "" && !haystack.contains(word) {
            return false;
        }
    }
    true
}

/// What a dock says when a filter left nothing, so an empty list reads as
/// "nothing matched" rather than "nothing exists".
pub fn nothing_says(query: str) -> str {
    "nothing matches \"{query}\""
}
