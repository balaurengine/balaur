// The screen the editor starts on when it was given no project: what this
// machine has opened, the examples that ship with it, and which engine build
// is installed. Drawn with the shell's own widgets and its own theme.

use crate::icons;
use crate::style;
use crate::util;

/// The state the screen keeps: what it read, what is being typed, and what it
/// was told last.
pub fn state() {
    #{
        on: false,
        tab: "projects",
        recent: [],
        read: false,
        filter: "",
        // The New project sheet's fields, which only exist while it is up.
        name: "my-game",
        template: "empty",
        parent: "",
        note: "",
        failed: "",
        // A project being converted: the manifest it reads, where it lands,
        // how far along, and what to do once it is done. Empty when none is.
        importing: #{},
        // Where each control this screen draws last landed, keyed by the name
        // the showcase points at: an immediate pill has no node to ask.
        spots: #{},
        // A folder a showcase will convert once its pointer reaches the
        // button, and where it landed; empty for every other run.
        convert_from: "",
        converted: "",
        // The release feed, asked for once when the Engine tab or About opens,
        // and whether a read is out.
        releases: [],
        asked: false,
        reading: false,
        follow: "",
        tag: "",
        // An install in flight: the tag, bytes so far and of how many, and
        // whether it is unpacking. Empty when none is.
        installing: #{},
        // Opened over a project, with the way back to it.
        back: false,
    }
}

// The widest the screen draws, whatever the window is: a list stretched
// across a monitor is a list nobody can read across.
const COLUMN = 900.0;
// What a cover is: the shape `scripts/showcase.sh` writes them in, so a card
// reserves the room the picture will actually take.
const COVER_ASPECT = 1.7647;
const SEAM = 14.0;
// The sheet a new project is named in, which the shell already has a shape for.
const NEW_SHEET = "manager-new";
// The editor's own mark, which the top bar draws too. A project of its own
// is not open yet, so every row wears this one.
pub const LOGO = "assets/balaur-logo.png";
// The mark is dark ink on nothing, drawn for a light ground: the top bar sets
// it on a light badge, and so does every other place that shows it.
const MB = 1048576;

/// Whether the editor is running in a browser tab, where a project is opened
/// by the page rather than by starting a second editor.
pub fn in_tab() {
    project::in_tab()
}

/// The `manager` start state: show the screen instead of the docks.
pub fn open(S) {
    S.manager.on = true;
    S.manager.read = false;
    S.manager.back = false;
    // The other two pages are not offered in a tab, so neither is a state
    // that left the screen on one of them.
    if in_tab() {
        S.manager.tab = "projects";
    }
}

/// The screen, on its examples half.
pub fn open_examples(S) {
    open(S);
    S.manager.tab = "examples";
}

/// The screen with the New project sheet up, for a shot and for the palette.
pub fn open_new(S) {
    open(S);
    crate::window::show(S, NEW_SHEET);
}

/// The screen, on its engine half: what `--state versions` opens.
pub fn open_versions(S) {
    open(S);
    S.manager.tab = "engine";
}

/// Ask for a folder and open what is in it, without the screen in between.
pub fn pick(S) {
    let picked = project::pick_folder();
    if picked is String {
        go(S, picked);
        return;
    }
    open_over(S);
}

/// The engine's mark on its plate, `width` across the ink. The box is its
/// own: a frame fills the height of the row it sits in.
pub fn mark(k, width) {
    let pad = util::max(width / 11.0, 2.0);
    let side = width + 2.0 * pad;
    ui::row(#{ width: side, height: side }, || {
        ui::frame(#{ fill: k.brand_plate, corner_radius: side / 2.0, padding_x: pad, padding_y: pad }, || {
            ui::image(LOGO, #{ width: width });
        });
    });
}

/// The screen over the open project, with the way back to it: what the
/// palette opens. A start state opens the screen a bare launch shows.
pub fn open_over(S) {
    open(S);
    S.manager.back = S.game_root != "";
}

/// Back to the project the screen was opened over. Opening another quits
/// this process, so without this the only way out was a restart.
pub fn close(S) {
    if S.manager.back {
        S.manager.on = false;
        S.manager.back = false;
    }
}

/// Whether the screen has the window. A run with no project is the screen
/// whether or not anybody asked for it: there is nothing else to hold.
/// Where a control this screen drew last landed, in design px, by the name
/// the showcase knows it as; `None` before it has drawn.
pub fn spot(S, name) {
    let found = S.manager.spots.get(name);
    match found {
        Some(box) => if box is Object {
            Some((box.x + box.width / 2.0, box.y + box.height / 2.0))
        } else {
            None
        },
        None => None,
    }
}

pub fn showing(S) {
    S.manager.on || S.game_root == ""
}

fn tabs() {
    // A tab installs no engine and fetches its examples from the page it runs
    // in, so the screen there is the list of what this browser keeps.
    if in_tab() {
        return [["projects", "Projects"]];
    }
    // `return`, because a block followed by `[` is an index in Rune.
    return [["projects", "Projects"], ["examples", "Examples"], ["engine", "Engine"]];
}

// One column under this, two above it.
fn narrow(col) {
    col < 600.0
}

fn refresh(S) {
    if S.manager.read {
        return;
    }
    S.manager.read = true;
    S.manager.recent = util::vec(project::recent());
    if S.manager.parent == "" {
        S.manager.parent = project::home();
    }
    if S.manager.follow == "" {
        let mine = util::obj(release::installed()).get("channel").unwrap_or("");
        S.manager.follow = if mine == "" { "nightly" } else { mine };
    }
}

const GROUND = "Editor/Manager";
const HEAD_NODE = GROUND + "/ManagerHead";
const TABS_NODE = GROUND + "/ManagerTabs";

pub fn draw(S, k) {
    if !S.manager.on {
        util::hide(GROUND);
        return;
    }
    refresh(S);
    // The screen is the window: a project's own widgets are not behind this.
    ui::set_widget_layer(false, 0.0, 0.0, 0.0, 0.0);
    util::fill(GROUND, #{ visible: true });
    crate::pool::strip(S, HEAD_NODE, head_controls(S, k));
    crate::pool::strip(S, TABS_NODE, tab_controls(S));
    tab_spots(S);
    // Escape closes the New project sheet first, and only then the screen.
    let sheet_up = crate::window::showing(S, NEW_SHEET);
    new_sheet(S, k);
    if !sheet_up && ui::shortcut("escape") {
        close(S);
    }
}

/// The page under the tabs, in the hatch the scene keeps for it.
pub fn draw_body(S, k) {
    if !S.manager.on {
        return;
    }
    let box = ui::widget_rect(scene::get_node(GROUND + "/ManagerBody"));
    let col = if util::is_nil(box) { COLUMN } else { util::f(box.width) };
    let tall = if util::is_nil(box) { 400.0 } else { util::f(box.height) };
    head_note(S, k, col);
    if S.manager.tab == "engine" {
        engine_page(S, k, col, tall);
    } else if S.manager.tab == "examples" {
        examples_page(S, k, col, tall);
    } else {
        projects_page(S, k, col, tall);
    }
}

/// The head strip: the mark, the name, the version, and the way back.
fn head_controls(S, k) {
    let out = [
        #{ kind: "image", role: "layout_mark", source: LOGO },
        #{ kind: "label", role: "text_title", text: "Balaur" },
        #{ kind: "label", role: "text_caption", text: project::version() },
        #{ kind: "row", grow: 1 },
    ];
    if S.manager.back {
        out.push(#{
            kind: "button", role: "action_manager", tooltip: "Esc",
            text: "Back to " + S.game_name,
            on: |_| { close(S); },
        });
    }
    out
}

/// What the head says under itself: a note, a failure, or a job's bar.
fn head_note(S, k, w) {
    let said = if S.manager.failed != "" { S.manager.failed } else { S.manager.note };
    if said != "" {
        let tone = if S.manager.failed != "" { k.warning_text } else { k.text_subtle };
        ui::label(said, util::merge(style::mono_sm(tone), #{ wrap: true, width: w }));
        ui::add_space(4);
    }
    if converting(S) {
        progress(S, k, w);
    }
    if installing(S) {
        install_progress(S, k, w);
    }
}

// How far a conversion has got: the count, a bar, and the press that stops it.
fn progress(S, k, w) {
    let job = S.manager.importing;
    let counted = if job.files > 0 { format!("{} of {} files", job.done, job.files) } else { "reading" };
    ui::add_space(6);
    ui::row(#{ height: 22, width: w }, || {
        ui::label(counted, style::mono_sm(k.text_muted));
        ui::add_space(10);
        ui::column(|| {
            ui::add_space(9);
            let part = if job.files > 0 { util::f(job.done) / util::f(job.files) } else { 0.0 };
            ui::progress_bar(part, #{ width: util::min(w - 220.0, 360.0), height: 4, track: k.bg_control, fill: k.primary_text });
        });
        ui::align_right(|| {
            if ui::button("stop", #{
                height: 22, font_size: style::SM, corner_radius: 8, padding_x: 12,
                fill: k.bg_panel, text_color: k.text_muted,
                tooltip: "Stop after the file it is on; what it wrote stays",
            }) {
                import::cancel();
            }
        });
    });
}

// The shell's own tab shape: a pill per page, the open one filled.
fn tab_controls(S) {
    let out = [];
    for row in tabs() {
        // Bound afresh: a closure made in a loop captures the binding.
        let id = row[0];
        out.push(#{
            kind: "button", text: row[1],
            role: "tab_manager", checked: S.manager.tab == id,
            on: |_| { S.manager.tab = id; },
        });
    }
    out
}

/// Where each tab sits, for the showcase's pointer. Read off the nodes the
/// strip made, a pass late like every other rect here.
fn tab_spots(S) {
    let host = scene::get_node(TABS_NODE);
    if util::is_nil(host) {
        return;
    }
    for (i, row) in tabs().iter().enumerate() {
        let found = host.children().get(i);
        if let Some(kid) = found {
            S.manager.spots[row[0]] = ui::widget_rect(kid);
        }
    }
}

// The filter, then the three verbs. Under a phone's width the verbs drop to
// the row below, since a filter and three buttons do not share 280 pixels.
fn toolbar(S, k, w) {
    let h = util::max(style::row_h(S), 30.0);
    let tight = narrow(w);
    // A tab has no folder picker and nowhere to write a template: the page it
    // runs in is what starts a project there, and this screen reopens one.
    let acting = !in_tab();
    // Written back to front: `ui::right` puts the first one at the right
    // edge, so New project reads leftmost of the three.
    let verbs = |room| {
        if !S.touchscreen {
            if ui::button(icons::panel("import") + " Import project", #{
                height: h, font_size: style::MD, corner_radius: 8, padding_x: 14, min_width: room,
                fill: k.bg_panel, text_color: k.text_default,
                tooltip: "Pick a project folder to convert; Godot is the one read today",
            }) {
                let picked = project::pick_folder();
                if picked is String {
                    import_project(S, picked);
                }
            }
            S.manager.spots["import"] = ui::button_rect();
            ui::add_space(6);
            if ui::button(icons::panel("assets") + " Open folder", #{
                height: h, font_size: style::MD, corner_radius: 8, padding_x: 14, min_width: room,
                fill: k.bg_panel, text_color: k.text_default,
            }) {
                let picked = project::pick_folder();
                if picked is String {
                    go(S, picked);
                }
            }
            ui::add_space(6);
        }
        if ui::button(icons::ui("add") + " New project", #{
            height: h, font_size: style::MD, corner_radius: 8, padding_x: 14, min_width: room,
            fill: k.primary_bg, text_color: k.primary_text,
        }) {
            crate::window::show(S, NEW_SHEET);
        }
        S.manager.spots["new"] = ui::button_rect();
    };
    ui::row(#{ height: h, width: w }, || {
        let field_w = if tight || !acting { w } else { w - 420.0 };
        S.manager.filter = crate::search::field(S, k, "manager", "Filter projects", field_w);
        if !tight && acting {
            ui::align_right(|| { verbs(0.0); });
        }
    });
    if tight && acting {
        ui::add_space(8);
        ui::row(#{ height: h, width: w }, || { verbs((w - 12.0) / 3.0); });
    }
}

fn projects_page(S, k, col, tall) {
    toolbar(S, k, col);
    ui::add_space(SEAM);
    let rows = shown(S);
    if rows.len() == 0 {
        let empty = if in_tab() {
            "This browser keeps no projects yet. The page opens one, and it is listed here after that."
        } else {
            "Nothing opened on this machine yet. Start from an example, or make one."
        };
        let why = if S.manager.recent.len() == 0 {
            empty
        } else {
            "No project matches that filter."
        };
        ui::label(why, util::merge(style::mono_sm(k.text_subtle), #{ wrap: true, width: col }));
        return;
    }
    // Two lines a row, and the rule between them: the list kind draws only
    // what is on screen, which is what a long history needs.
    let h = util::max(style::row_h(S) + 22.0, 56.0);
    ui::list("manager-recent", #{ row_height: h, max_height: tall }, rows.len(), |i| {
        project_row(S, k, col, util::obj(rows[i]), h);
    });
}

fn shown(S) {
    let query = S.manager.filter.to_lowercase();
    if query == "" {
        return S.manager.recent;
    }
    let out = [];
    for entry in S.manager.recent {
        let row = util::obj(entry);
        let hay = (row.name + " " + row.path).to_lowercase();
        if hay.contains(query) {
            out.push(entry);
        }
    }
    out
}

// Two lines: the name a click opens, and the folder under it. What a row
// says about itself, when and with which engine, sits at the right edge.
fn project_row(S, k, w, row, h) {
    let here = row.path;
    let gone = row.get("exists").unwrap_or(true) != true;
    let when = row.get("when").unwrap_or("");
    let built = row.get("version").unwrap_or("");
    let line = util::max(style::row_h(S), 28.0);
    // What the marks at the right edge take. A phone shows when it was
    // opened and nothing else, so the path keeps the width instead.
    let tight = narrow(w);
    let marks = if tight { 120.0 } else { 200.0 };
    ui::row(#{ height: h, width: w }, || {
        ui::column(|| {
            ui::row(#{ height: line, width: w - marks }, || {
                ui::add_space(2);
                // The engine's mark: a project keeps its own icon, and none
                // of them is open, so the row wears the editor's.
                mark(k, 20.0);
                ui::add_space(8);
                if ui::button(row.name, #{
                    height: line, font_size: style::MD, text_align: ui::ALIGN_START, corner_radius: 8,
                    min_width: w - marks - 36.0, padding_x: 8,
                    icon: if gone { icons::panel("problems") } else { "" },
                    icon_size: style::MD, icon_color: k.text_subtle,
                    fill: "#00000000", hover: #{ fill: k.bg_panel },
                    text_color: if gone { k.text_subtle } else { k.text_default },
                    tooltip: here,
                }) {
                    if !gone {
                        go(S, here);
                    }
                }
            });
            ui::row(#{ height: 16, width: w - marks }, || {
                ui::add_space(32);
                ui::label(if gone { here + "  ·  disk not mounted" } else { here },
                    util::merge(style::mono_sm(k.text_subtle), #{ truncate: true }));
            });
        });
        // Back to front again: the mark that forgets it is the rightmost.
        ui::align_right(|| {
            if ui::button(icons::ui("close"), #{
                role: "icon_action", tooltip: "Forget this project",
            }) {
                project::forget(here);
                S.manager.read = false;
            }
            ui::add_space(8);
            if built != "" && !tight {
                ui::label(built, style::mono_sm(k.text_subtle));
                ui::add_space(10);
            }
            ui::label(when, style::mono_sm(k.text_subtle));
        });
    });
    ui::separator(k.border_default);
}

fn examples_page(S, k, col, tall) {
    let rows = util::vec(project::examples());
    if rows.len() == 0 {
        ui::label("No examples ship beside this build.",
            util::merge(style::mono_sm(k.text_subtle), #{ wrap: true, width: col }));
        return;
    }
    let across = if narrow(col) { 1 } else if col < 760.0 { 2 } else { 3 };
    // Floored: three cards and two seams have to add up to the column, and
    // a third of a pixel each puts the last one past its edge.
    let card_w = math::floor((col - util::f(across - 1) * SEAM) / util::f(across));
    // The picture, then the name, the line under it and the card's own air.
    let card_h = math::floor(card_w / COVER_ASPECT) + 54.0;
    ui::scroll("manager-examples", #{ axis: "vertical", max_height: tall }, || {
        let n = 0;
        while n < rows.len() {
            ui::row(#{ height: card_h, width: col }, || {
                // The row's own gap, so the cards add up to the column: a
                // space between them plus egui's own is one gap too many.
                ui::spacing(SEAM, 0);
                let c = 0;
                while c < across && n + c < rows.len() {
                    example_card(S, k, card_w, card_h, util::obj(rows[n + c]));
                    c += 1;
                }
            });
            ui::add_space(SEAM);
            n += across;
        }
    });
    ui::label("Opens a copy in your projects folder, so the example stays as it shipped.",
        util::merge(style::mono_sm(k.text_subtle), #{ wrap: true, width: col }));
}

fn example_card(S, k, w, h, row) {
    let id = row.id;
    let cover = row.get("cover").unwrap_or("");
    ui::column(|| {
        ui::frame(#{
            fill: k.bg_panel, corner_radius: 12, padding_x: 0, padding_y: 0,
            hover: #{ fill: k.bg_control_hover }, tooltip: "Copy into " + S.manager.parent,
        }, || {
            ui::column(|| {
                if cover != "" {
                    ui::image(cover, #{ width: w });
                } else {
                    // No picture shipped: the engine's own mark, so the card
                    // still reads as a project rather than a blank.
                    ui::row(#{ height: h - 54.0, width: w }, || {
                        ui::add_space(w / 2.0 - 22.0);
                        mark(k, 36.0);
                    });
                }
                ui::row(#{ height: 20, width: w }, || {
                    ui::add_space(12);
                    ui::label(row.name, #{ font_size: style::MD, font_weight: 700, text_color: k.text_default });
                });
                ui::row(#{ height: 18, width: w }, || {
                    ui::add_space(12);
                    ui::label(row.get("note").unwrap_or(""),
                        util::merge(style::mono_sm(k.text_subtle), #{ truncate: true }));
                });
                ui::add_space(8);
            });
        });
        ui::row(#{ height: 0, width: w }, || {});
    });
}

// What this build is, which line it follows, and every release the project
// has published. The same code `balaur update` runs, so the screen and the
// command cannot disagree.
fn engine_page(S, k, col, tall) {
    if !S.manager.asked {
        check(S);
    }
    let mine = util::obj(release::installed());
    let h = util::max(style::row_h(S), 30.0);
    let tight = narrow(col);
    let newest = newest_on(S, S.manager.follow);
    ui::row(#{ height: 40, width: col }, || {
        ui::column(|| {
            ui::label("Balaur " + mine.version, #{
                font_size: style::LG, font_family: ui::FONT_HEADING, font_weight: 700, text_color: k.text_default,
            });
            ui::label(build_line(mine), style::mono_sm(k.text_subtle));
        });
        ui::align_right(|| {
            let word = if S.manager.reading { " Checking" } else { " Check" };
            if ui::button(icons::ui("reset") + word, #{
                height: h, font_size: style::SM, corner_radius: 8, padding_x: 12,
                fill: k.bg_panel, text_color: k.text_muted,
            }) {
                check(S);
            }
            ui::add_space(10);
            if !tight {
                let fresh = newest.get("order").unwrap_or("") == "newer";
                ui::label(standing(S, S.manager.follow), style::mono_sm(
                    if fresh { k.success_text } else { k.text_subtle }));
            }
        });
    });
    if mine.held != "" {
        ui::add_space(4);
        ui::label(mine.held, util::merge(style::mono_sm(k.text_subtle), #{ wrap: true, width: col }));
    }
    ui::add_space(SEAM);
    ui::row(#{ height: h + 6.0, width: col }, || {
        ui::row(#{ height: h, width: 60 }, || {
            ui::label("Follow", #{ font_size: style::MD, text_color: k.text_muted });
        });
        ui::scroll("manager-follow", #{
            axis: "horizontal", max_width: col - 66.0, max_height: h + 6.0,
        }, || {
            ui::row(#{ height: h }, || {
                ui::spacing(4, 0);
                for name in util::vec(release::channels()) {
                    let on = S.manager.follow == name;
                    if ui::button(name, #{
                        height: h, font_size: style::SM, corner_radius: 8, padding_x: 12,
                        fill: if on { k.primary_bg } else { k.bg_panel },
                        text_color: if on { k.primary_text } else { k.text_muted },
                    }) {
                        S.manager.follow = name;
                    }
                }
            });
        });
    });
    ui::add_space(SEAM);
    release_list(S, k, col, tall, mine);
}

/// The build in one line: its id and the line it follows, or where it came
/// from when it came from no release.
pub fn build_line(mine) {
    if mine.source == true {
        return "built from a checkout";
    }
    mine.id + "  ·  following " + mine.channel
}

/// Ask the feed what every line holds, unless a read is already out. The
/// answer arrives in `heard`.
pub fn check(S) {
    if S.manager.reading {
        return;
    }
    S.manager.asked = true;
    S.manager.reading = release::check();
}

/// Whether an install is in flight.
pub fn installing(S) {
    S.manager.installing.contains_key("tag")
}

/// A report on a check or an install. The start screen and the About sheet
/// both read what this keeps.
pub fn heard(S, e) {
    let ev = util::obj(e);
    let kind = ev.get("kind").unwrap_or("");
    if kind == "listed" {
        S.manager.releases = util::vec(ev.get("rows").unwrap_or([]));
        S.manager.reading = false;
    } else if kind == "downloading" {
        S.manager.installing = #{
            tag: ev.get("tag").unwrap_or(""),
            done: ev.get("done").unwrap_or(0),
            total: ev.get("total").unwrap_or(0),
            unpacking: false,
        };
    } else if kind == "unpacking" {
        let job = S.manager.installing;
        job.unpacking = true;
        S.manager.installing = job;
    } else if kind == "installed" {
        S.manager.installing = #{};
        S.manager.failed = "";
        S.manager.note = ev.get("note").unwrap_or("");
        log::info(S.manager.note);
    } else if kind == "failed" {
        if ev.get("job").unwrap_or("") == "install" {
            S.manager.installing = #{};
        } else {
            S.manager.reading = false;
        }
        S.manager.failed = ev.get("message").unwrap_or("");
    }
}

/// The newest release on a line, or an empty table when it holds none.
pub fn newest_on(S, channel) {
    for entry in S.manager.releases {
        let row = util::obj(entry);
        if row.get("channel").unwrap_or("") == channel {
            return row;
        }
    }
    #{}
}

/// What the newest release on a line means for this build, in a few words.
pub fn standing(S, channel) {
    let newest = newest_on(S, channel);
    let id = newest.get("id").unwrap_or("");
    if id == "" {
        return if S.manager.reading { "checking" } else { "no release on this line" };
    }
    let order = newest.get("order").unwrap_or("");
    if order == "same" {
        return "up to date";
    }
    if order == "newer" {
        return id + " is newer";
    }
    if order == "older" {
        return id + " is older than this build";
    }
    id + " is published"
}

fn release_list(S, k, col, tall, mine) {
    let h = util::max(style::row_h(S), 30.0);
    let rows = [];
    for entry in S.manager.releases {
        let row = util::obj(entry);
        if row.get("channel").unwrap_or("") == S.manager.follow {
            rows.push(row);
        }
    }
    if rows.len() == 0 {
        let empty = if S.manager.reading { "Reading the release feed." } else { "Nothing published on this line yet." };
        ui::label(empty, style::mono_sm(k.text_subtle));
    }
    // As tall as the releases it holds, capped by what is left of the screen:
    // a scroll of one row should not reserve the page.
    let room = util::min(tall - 120.0, util::f(rows.len()) * (h + 15.0) + 4.0);
    ui::scroll("manager-releases", #{ axis: "vertical", max_height: util::max(room, h) }, || {
        for row in rows {
            let current = row.get("current").unwrap_or(false) == true;
            ui::row(#{ height: h + 14.0, width: col }, || {
                ui::column(|| {
                    ui::label(row.get("id").unwrap_or(""), #{
                        font_size: style::MD, font_weight: 700,
                        text_color: if current { k.primary_text } else { k.text_default },
                    });
                    ui::label(row.get("when").unwrap_or(""), style::mono_sm(k.text_subtle));
                });
                ui::align_right(|| { row_press(S, k, h, row, mine); });
            });
            ui::separator(k.border_default);
        }
    });
    // An install that cannot replace itself has nothing to name a release for.
    if mine.held != "" {
        return;
    }
    ui::add_space(10);
    let tight = narrow(col);
    let label_w = if tight { 0.0 } else { 160.0 };
    ui::row(#{ height: h, width: col }, || {
        if !tight {
            ui::label("Or a release by name", #{ font_size: style::MD, text_color: k.text_muted, width: label_w });
        }
        let field_w = if tight { col } else { col - label_w - 110.0 };
        let (tag, _, _) = ui::text_field("manager-tag", "v0.2.0",
            util::merge(style::field(k, field_w), #{ value: S.manager.tag }));
        S.manager.tag = tag;
        if !tight {
            ui::align_right(|| { install_named(S, k, h); });
        }
    });
    if tight {
        ui::add_space(8);
        ui::row(#{ height: h, width: col }, || {
            ui::align_right(|| { install_named(S, k, h); });
        });
    }
}

/// What a release row offers: nothing on the one installed or while another
/// installs, the .dmg where this install cannot replace itself, and otherwise
/// the install, named for which way it goes.
pub fn row_press(S, k, h, row, mine) {
    if row.get("current").unwrap_or(false) == true {
        ui::label("installed", style::mono_sm(k.text_subtle));
        return;
    }
    if installing(S) {
        return;
    }
    let look = #{
        height: h, font_size: style::SM, corner_radius: 8, padding_x: 14, min_width: 88,
        fill: k.bg_control, text_color: k.text_default,
    };
    let download = row.get("download").unwrap_or("");
    if download != "" {
        if ui::button("Download", look) {
            engine::open_url(download);
        }
        return;
    }
    if mine.held != "" {
        return;
    }
    let word = if row.get("order").unwrap_or("") == "older" { "Downgrade" } else { "Install" };
    if ui::button(word, look) {
        put(S, "", row.get("tag").unwrap_or(""));
    }
}

fn install_named(S, k, h) {
    if installing(S) {
        return;
    }
    if ui::button("Install", #{
        height: h, font_size: style::SM, corner_radius: 8, padding_x: 14, min_width: 88,
        fill: k.bg_panel, text_color: k.text_muted,
    }) {
        if S.manager.tag == "" {
            S.manager.failed = "type a release tag first, like v0.2.0";
            return;
        }
        put(S, "", S.manager.tag);
    }
}

/// How far an install has got: the megabytes as they arrive, then the unpack.
pub fn install_progress(S, k, w) {
    let job = S.manager.installing;
    let said = if job.unpacking {
        "unpacking " + job.tag
    } else if job.total > 0 {
        format!("downloading {}  ·  {} of {} MB", job.tag, job.done / MB, job.total / MB)
    } else {
        format!("downloading {}  ·  {} MB", job.tag, job.done / MB)
    };
    let part = if job.unpacking {
        1.0
    } else if job.total > 0 {
        util::f(job.done) / util::f(job.total)
    } else {
        0.0
    };
    ui::add_space(6);
    ui::row(#{ height: 22, width: w }, || {
        ui::label(said, style::mono_sm(k.text_muted));
        ui::add_space(10);
        ui::column(|| {
            ui::add_space(9);
            ui::progress_bar(part, #{
                width: util::max(util::min(w - 280.0, 360.0), 40.0), height: 4,
                track: k.bg_control, fill: k.primary_text,
            });
        });
    });
}

// A new project is named in the shell's own sheet, which is what Settings is
// and what a phone needs: one screen at a time.
fn new_sheet(S, k) {
    crate::window::sheet(S, NEW_SHEET, "New project", || {}, || {
        let w = crate::window::inner_w(S);
        let h = util::max(style::row_h(S), 30.0);
        let label_w = 72.0;
        ui::row(#{ height: h, width: w }, || {
            ui::label("name", #{ font_size: style::MD, text_color: k.text_muted, width: label_w });
            let (name, _, _) = ui::text_field("manager-name", "my-game",
                util::merge(style::field(k, w - label_w), #{ value: S.manager.name }));
            S.manager.name = name;
        });
        ui::add_space(10);
        ui::row(#{ height: h, width: w }, || {
            ui::label("from", #{ font_size: style::MD, text_color: k.text_muted, width: label_w });
            let ids = [];
            for row in util::vec(project::templates()) {
                ids.push(util::obj(row).id);
            }
            if ids.len() == 0 {
                ids.push("empty");
            }
            let (picked, changed) = ui::dropdown("manager-template", S.manager.template, ids, #{
                width: w - label_w, font_size: style::MD, height: h, text_color: k.text_default,
            });
            if changed {
                S.manager.template = picked;
            }
        });
        ui::add_space(10);
        ui::row(#{ height: h, width: w }, || {
            ui::label("in", #{ font_size: style::MD, text_color: k.text_muted, width: label_w });
            ui::row(#{ height: h, width: w - label_w }, || {
                ui::label(S.manager.parent, util::merge(style::mono_sm(k.text_subtle), #{ truncate: true }));
            });
        });
        ui::add_space(16);
        ui::row(#{ height: h, width: w }, || {
            ui::align_right(|| {
                if ui::button("Create", #{
                    height: h, font_size: style::MD, font_weight: 700, corner_radius: 8,
                    min_width: 140, padding_x: 16, fill: k.primary_bg, text_color: k.primary_text,
                }) {
                    create(S);
                }
            });
        });
    });
}

fn create(S) {
    let name = if S.manager.name == "" { "my-game" } else { S.manager.name };
    let path = S.manager.parent + "/" + name;
    let made = util::obj(project::create(path, S.manager.template));
    let failed = made.get("error");
    if let Some(why) = failed {
        S.manager.failed = why;
        return;
    }
    S.manager.failed = "";
    go(S, path);
}

// The manifests this screen reads, in the order it looks. A second engine is
// a line here and a route in `balaur_import`.
const MANIFESTS = ["project.godot"];

// Another engine's project becomes a balaur one beside it, opened once the
// import says it is done: opening quits this process.
fn import_project(S, folder) {
    convert(S, folder, |S, path| go(S, path));
}

/// Start converting `folder` into a balaur project beside it, a few files a
/// frame. Answers where it will land, or "" with the reason in
/// `S.manager.failed`; `after(S, path)` runs once every file is written.
pub fn convert(S, folder, after) {
    if converting(S) {
        S.manager.failed = "a project is already being imported";
        return "";
    }
    let manifest = "";
    for name in MANIFESTS {
        if manifest == "" && fs::exists(folder + "/" + name) {
            manifest = folder + "/" + name;
        }
    }
    if manifest == "" {
        S.manager.failed = "no project to import in " + folder + ": looked for project.godot";
        return "";
    }
    let name = util::last_segment(folder);
    let path = S.manager.parent + "/" + name + "-balaur";
    let made = util::obj(project::create(path, "empty"));
    if let Some(why) = made.get("error") {
        S.manager.failed = why;
        return "";
    }
    if !import::start(manifest, path) {
        S.manager.failed = "importing " + manifest + " did not start";
        return "";
    }
    S.manager.failed = "";
    S.manager.note = "importing " + name;
    S.manager.importing = #{ source: manifest, path: path, done: 0, files: 0, after: after };
    path
}

/// Whether a project is being converted.
pub fn converting(S) {
    S.manager.importing.contains_key("source")
}

/// Whether an import report is about the conversion this screen started.
pub fn owns(S, e) {
    converting(S) && util::obj(e).get("source").unwrap_or("") == S.manager.importing.source
}

/// A report on the conversion: the count as it climbs, then how it ended.
pub fn report(S, e) {
    let ev = util::obj(e);
    let kind = ev.get("kind").unwrap_or("");
    let job = S.manager.importing;
    if kind == "started" || kind == "wrote" {
        job.done = ev.get("done").unwrap_or(0);
        job.files = ev.get("files").unwrap_or(0);
        S.manager.importing = job;
        return;
    }
    S.manager.importing = #{};
    if kind == "done" {
        S.manager.note = ev.get("note").unwrap_or("");
        log::info(format!("imported {} into {}: {}", job.source, job.path, S.manager.note));
        // The list was read before the project existed, so it is read again.
        S.manager.read = false;
        let after = job.after;
        after(S, job.path);
    } else if kind == "failed" {
        S.manager.failed = "importing " + job.source + ": " + ev.get("message").unwrap_or("");
    } else if kind == "cancelled" {
        S.manager.failed = format!("stopped importing after {} files; {} holds what was written",
            ev.get("done").unwrap_or(0), job.path);
    }
}


// Replace this install, on a thread; `heard` follows it. The reader pressed
// it, so a downgrade is allowed: the press said Downgrade where it is one.
pub fn put(S, channel, tag) {
    if installing(S) {
        return;
    }
    if !release::install(channel, tag, true) {
        S.manager.failed = "nothing installs while a recording plays";
        return;
    }
    let named = if tag == "" { channel } else { tag };
    S.manager.failed = "";
    S.manager.note = "installing " + named;
    S.manager.installing = #{ tag: named, done: 0, total: 0, unpacking: false };
}

/// Open a project: the module remembers it, starts the editor on it and asks
/// this process to quit.
pub fn go(S, path) {
    // Opening quits this process, which would leave a conversion half written.
    if converting(S) {
        S.manager.failed = "wait for the import to finish, or stop it";
        return;
    }
    // Or an install half swapped in.
    if installing(S) {
        S.manager.failed = "wait for the install to finish";
        return;
    }
    let answer = util::obj(project::open(path));
    let failed = answer.get("error");
    if let Some(why) = failed {
        S.manager.failed = why;
        return;
    }
    S.manager.failed = "";
}
