// The screen the editor starts on when it was given no project: what this
// machine has opened, the examples that ship with it, and which engine build
// is installed. Drawn with the shell's own widgets and its own theme.

use crate::icons;
use crate::style;
use crate::util;

/// The state the screen keeps: what it read, what is being typed, and what it
/// was told last.
pub fn state() {
    #{
        on: false,
        // Whether the shell under the screen is hidden; see `cover`.
        covering: false,
        tab: "projects",
        recent: [],
        read: false,
        filter: "",
        // The New project sheet's fields, which only exist while it is up.
        name: "my-game",
        template: "empty",
        parent: "",
        note: "",
        failed: "",
        // A project being converted: the manifest it reads, where it lands,
        // how far along, and what to do once it is done. Empty when none is.
        importing: #{},
        // Where each control this screen draws last landed, keyed by the name
        // the showcase points at: an immediate pill has no node to ask.
        spots: #{},
        // A folder a showcase will convert once its pointer reaches the
        // button, and where it landed; empty for every other run.
        convert_from: "",
        converted: "",
        // The release feed, asked for once when the Engine tab or About opens,
        // and whether a read is out.
        releases: [],
        asked: false,
        reading: false,
        follow: "",
        tag: "",
        // An install in flight: the tag, bytes so far and of how many, and
        // whether it is unpacking. Empty when none is.
        installing: #{},
        // Opened over a project, with the way back to it.
        back: false,
    }
}

// The widest the screen draws, whatever the window is: a list stretched
// across a monitor is a list nobody can read across.
const COLUMN = 900.0;
// What a cover is: the shape `scripts/showcase.sh` writes them in, so a card
// reserves the room the picture will actually take.
const COVER_ASPECT = 1.7647;
const SEAM = 14.0;
// The sheet a new project is named in, which the shell already has a shape for.
const NEW_SHEET = "manager-new";
// The editor's own mark, which the top bar draws too. A project of its own
// is not open yet, so every row wears this one.
pub const LOGO = "assets/balaur-logo.png";
// Light ink, for a mark set straight on a dark theme's ground.
const LOGO_DARK = "assets/balaur-logo-dark.png";
// The mark is dark ink on nothing, drawn for a light ground: the top bar sets
// it on a light badge, and so does every other place that shows it.
const MB = 1048576;

/// Whether the editor is running in a browser tab, where a project is opened
/// by the page rather than by starting a second editor.
pub fn in_tab() {
    project::in_tab()
}

/// The `manager` start state: show the screen instead of the docks.
pub fn open(S) {
    S.manager.on = true;
    S.manager.read = false;
    S.manager.back = false;
    told(S);
    // The other two pages are not offered in a tab, so neither is a state
    // that left the screen on one of them.
    if in_tab() {
        S.manager.tab = "projects";
    }
}

/// The screen, on its examples half.
pub fn open_examples(S) {
    open(S);
    S.manager.tab = "examples";
    told(S);
}

/// The screen with the New project sheet up, for a shot and for the palette.
pub fn open_new(S) {
    open(S);
    crate::window::show(S, NEW_SHEET);
}

/// The screen, on its engine half: what `--state versions` opens.
pub fn open_versions(S) {
    open(S);
    S.manager.tab = "engine";
    told(S);
}

/// Ask for a folder and open what is in it, without the screen in between.
pub fn pick(S) {
    let picked = project::pick_directory();
    if picked is String {
        go(S, picked);
        return;
    }
    open_over(S);
}


/// The screen over the open project, with the way back to it: what the
/// palette opens. A start state opens the screen a bare launch shows.
pub fn open_over(S) {
    open(S);
    S.manager.back = S.game_root != "";
    told(S);
}

/// Back to the project the screen was opened over. Opening another quits
/// this process, so without this the only way out was a restart.
pub fn close(S) {
    if S.manager.back {
        S.manager.on = false;
        S.manager.back = false;
        told(S);
    }
}

/// Where a control the showcase points at sits, in design px, by the name it
/// knows it as: a tab by its id, or one of the Projects tab's verbs; `None`
/// before it has drawn.
pub fn spot(S, name) {
    let node = match name {
        "import" => scene::get_node(TOOLS + "/Import"),
        "new" => scene::get_node(TOOLS + "/New"),
        _ => tab_node(name),
    };
    let box = if util::is_nil(node) { () } else { ui::widget_rect(node) };
    if box is Object {
        Some((box.x + box.width / 2.0, box.y + box.height / 2.0))
    } else {
        None
    }
}

// The tab strip's node for the page `id`, in the order `tabs` lists them.
fn tab_node(id) {
    let host = scene::get_node(TABS_NODE);
    if util::is_nil(host) {
        return ();
    }
    for (i, row) in tabs().iter().enumerate() {
        if row[0] == id {
            if let Some(kid) = host.children().get(i) {
                return kid;
            }
        }
    }
    ()
}

/// Whether the screen has the window. A run with no project is the screen
/// whether or not anybody asked for it: there is nothing else to hold.
pub fn showing(S) {
    S.manager.on || S.game_root == ""
}

fn tabs() {
    // A tab installs no engine and fetches its examples from the page it runs
    // in, so the screen there is the list of what this browser keeps.
    if in_tab() {
        return [["projects", "Projects"]];
    }
    // `return`, because a block followed by `[` is an index in Rune.
    return [["projects", "Projects"], ["examples", "Examples"], ["engine", "Engine"]];
}

// One column under this, two above it.
fn narrow(col) {
    col < 600.0
}

fn refresh(S) {
    if S.manager.read {
        return;
    }
    S.manager.read = true;
    S.manager.recent = util::vec(project::recent());
    if S.manager.parent == "" {
        S.manager.parent = project::home();
    }
    if S.manager.follow == "" {
        let mine = util::obj(release::installed()).get("channel").unwrap_or("");
        S.manager.follow = if mine == "" { "nightly" } else { mine };
    }
}

const GROUND = "Editor/Manager";
const SHELL = "Editor/Shell";
const HEAD_NODE = GROUND + "/ManagerHead";
const TABS_NODE = GROUND + "/ManagerTabs";
const BODY = GROUND + "/ManagerBody";
const NOTE = GROUND + "/ManagerBody/Note";
const PROGRESS = GROUND + "/ManagerBody/Progress";
const TOOLS = GROUND + "/ManagerBody/Tools";
const PAGE = GROUND + "/ManagerBody/Scroll/Page";

/// Fill the start screen: its head, its tabs and the page under them, from
/// what this machine has opened, the examples and the release feed. What
/// its script asks for on `manager_changed` and when it was resized.
pub fn fill(S) {
    if !S.manager.on {
        util::hide(GROUND);
        cover(S, false);
        return;
    }
    refresh(S);
    let k = S.theme;
    // The screen is the window: a project's own widgets are not behind this.
    ui::set_widget_layer(false, 0.0, 0.0, 0.0, 0.0);
    util::fill(GROUND, #{ visible: true });
    cover(S, true);
    crate::pool::strip(S, HEAD_NODE, head_controls(S, k));
    crate::pool::strip(S, TABS_NODE, tab_controls(S));
    let col = page_w();
    head_note(S, k);
    tools(S);
    let specs = if S.manager.tab == "engine" {
        engine_specs(S, k, col)
    } else if S.manager.tab == "examples" {
        examples_specs(S, k, col)
    } else {
        projects_specs(S, k, col)
    };
    crate::pool::sync(S, PAGE, specs, 0.0, false);
}

// The page's width, as it was laid out: the widest the screen draws, whatever
// the window is, since a list across a monitor is a list nobody can read.
fn page_w() {
    let box = ui::widget_rect(scene::get_node(BODY));
    if util::is_nil(box) || util::f(box.width) <= 0.0 { COLUMN } else { util::min(util::f(box.width), COLUMN) }
}

/// The Projects tab's filter, as it is typed.
pub fn set_filter(S, text) {
    S.manager.filter = text;
    told(S);
}

/// The Projects tab's verbs, by the name of the button pressed.
pub fn verb(S, name) {
    if name == "New" {
        crate::window::show(S, NEW_SHEET);
        return;
    }
    let picked = project::pick_directory();
    if !(picked is String) {
        return;
    }
    if name == "Import" {
        import_project(S, picked);
    } else {
        go(S, picked);
    }
    told(S);
}

// What the head says under itself: a note or a failure, and a job's bar.
fn head_note(S, k) {
    let said = if S.manager.failed != "" { S.manager.failed } else { S.manager.note };
    util::fill(NOTE, #{
        visible: said != "", text: said,
        text_color: if S.manager.failed != "" { k.warning_text } else { k.text_subtle },
    });
    let controls = if converting(S) {
        let job = S.manager.importing;
        let counted = if job.files > 0 { format!("{} of {} files", job.done, job.files) } else { "reading" };
        let part = if job.files > 0 { util::f(job.done) / util::f(job.files) } else { 0.0 };
        [
            #{ kind: "label", role: "text_code_quiet", font_size: 11, text: counted },
            #{ kind: "progress_bar", width: 360, height: 4, value: part },
            #{ kind: "row", grow: 1 },
            #{
                kind: "button", role: "action_form", text: "stop",
                tooltip: "Stop after the file it is on; what it wrote stays",
                on: |_| { import::cancel(); },
            },
        ]
    } else if installing(S) {
        progress_controls(S)
    } else {
        []
    };
    util::fill(PROGRESS, #{ visible: controls.len() > 0 });
    crate::pool::strip(S, PROGRESS, controls);
}

// The filter and the three verbs, up on the Projects tab. A tab has no folder
// picker and nowhere to write a template: the page it runs in is what starts
// a project there, and this screen reopens one.
fn tools(S) {
    let up = S.manager.tab == "projects";
    let acting = !in_tab();
    util::fill(TOOLS, #{ visible: up });
    util::fill(TOOLS + "/Filter", #{ text: S.manager.filter });
    for name in ["Import", "Open"] {
        util::fill(TOOLS + "/" + name, #{ visible: acting && !S.touchscreen });
    }
    util::fill(TOOLS + "/Import", #{ icon: icons::panel("import") });
    util::fill(TOOLS + "/Open", #{ icon: icons::panel("assets") });
    util::fill(TOOLS + "/New", #{ visible: acting, icon: icons::ui("add") });
}

fn say(text, ink) {
    #{ full: true, height: 0, controls: [#{
        kind: "label", role: "text_code_quiet", font_size: 11, grow: 1, wrap: true,
        text: text, text_color: ink,
    }] }
}

fn rule() {
    #{ full: true, height: 1, controls: [#{ kind: "separator", grow: 1 }] }
}

fn projects_specs(S, k, col) {
    let rows = shown(S);
    if rows.len() == 0 {
        let empty = if in_tab() {
            "This browser keeps no projects yet. The page opens one, and it is listed here after that."
        } else {
            "Nothing opened on this machine yet. Start from an example, or make one."
        };
        let why = if S.manager.recent.len() == 0 { empty } else { "No project matches that filter." };
        let none = [say(why, k.text_subtle)];
        return none;
    }
    let out = [];
    for row in rows {
        out.push(project_spec(S, k, col, util::obj(row)));
        out.push(rule());
    }
    out
}

// Two lines: the name a click opens, and the folder under it. What a row says
// about itself, when and with which engine, sits at the right edge, and a
// phone shows when it was opened and nothing else.
fn project_spec(S, k, col, row) {
    let here = row.path;
    let gone = row.get("exists").unwrap_or(true) != true;
    let built = row.get("version").unwrap_or("");
    let line = util::max(style::row_h(S), 28.0);
    let controls = [
        // The engine's mark: a project keeps its own icon, and none of them
        // is open, so the row wears the editor's.
        #{ kind: "panel", role: "sheet_logo", padding: 2, controls: [#{ kind: "image", image: LOGO, width: 20 }] },
        #{ kind: "column", grow: 1, controls: [
            #{
                kind: "button", role: "item_list", text: row.name, height: line, text_align: "start",
                icon: if gone { icons::panel("problems") } else { "" }, tooltip: here,
                text_color: if gone { k.text_subtle } else { k.text_default },
                on: |_| {
                    if !gone {
                        go(S, here);
                    }
                },
            },
            #{
                kind: "label", role: "text_code_quiet", font_size: 11, truncate: true,
                text: if gone { here + "  ·  disk not mounted" } else { here },
            },
        ] },
        #{ kind: "label", role: "text_code_quiet", font_size: 11, text: row.get("when").unwrap_or("") },
    ];
    if built != "" && !narrow(col) {
        controls.push(#{ kind: "label", role: "text_code_quiet", font_size: 11, text: built });
    }
    controls.push(#{
        kind: "button", role: "icon_action", text: "", icon: icons::ui("close"), tooltip: "Forget this project",
        on: |_| {
            project::forget(here);
            S.manager.read = false;
            told(S);
        },
    });
    #{ full: true, height: util::max(line + 22.0, 56.0), slot_role: "layout_actions", controls: controls }
}

fn examples_specs(S, k, col) {
    let rows = util::vec(project::examples());
    if rows.len() == 0 {
        let none = [say("No examples ship beside this build.", k.text_subtle)];
        return none;
    }
    let across = if narrow(col) { 1 } else if col < 760.0 { 2 } else { 3 };
    // Floored: three cards and two seams have to add up to the column, and a
    // third of a pixel each puts the last one past its edge.
    let card_w = math::floor((col - util::f(across - 1) * SEAM) / util::f(across));
    let cover_h = math::floor(card_w / COVER_ASPECT);
    let out = [];
    let n = 0;
    while n < rows.len() {
        let cards = [];
        let c = 0;
        while c < across && n + c < rows.len() {
            cards.push(example_card(S, k, card_w, cover_h, util::obj(rows[n + c])));
            c += 1;
        }
        out.push(#{ full: true, height: cover_h + 54.0, controls: [
            #{ kind: "row", gap: [SEAM, SEAM], controls: cards },
        ] });
        n += across;
    }
    out.push(say("Opens a copy in your projects folder, so the example stays as it shipped.", k.text_subtle));
    out
}

// The picture, the name and the line under it, on a panel the whole of which
// a click opens a copy of: a button with nothing in it laid over the card.
fn example_card(S, k, w, cover_h, row) {
    let id = row.id;
    let cover = row.get("cover").unwrap_or("");
    let picture = if cover != "" {
        #{ kind: "image", image: cover, width: w, height: cover_h, fit: "cover", corner_radius: 12 }
    } else {
        // No picture shipped: the engine's own mark, so the card still reads
        // as a project rather than a blank.
        #{ kind: "row", width: w, height: cover_h, justify: "center", align_items: "center", controls: [
            #{ kind: "panel", role: "sheet_logo", controls: [#{ kind: "image", image: LOGO, width: 36 }] },
        ] }
    };
    #{ kind: "panel", fill: k.bg_panel, corner_radius: 12, padding: 0, width: w, gap: [0, 2], controls: [
        picture,
        #{ kind: "label", role: "text_title", font_size: 13, text: row.name, padding: [12, 4, 12, 0] },
        #{
            kind: "label", role: "text_code_quiet", font_size: 11, truncate: true,
            text: row.get("note").unwrap_or(""), padding: [12, 0, 12, 8],
        },
        #{
            kind: "button", role: "chip_quiet", text: "", absolute: true, inset: [0.0, 0.0, 0.0, 0.0],
            tooltip: "Copy into " + S.manager.parent,
            on: |_| { open_example(S, id); },
        },
    ] }
}

/// Copy an example into the projects folder and open the copy.
fn open_example(S, id) {
    let made = util::obj(project::copy_example(id, S.manager.parent));
    let failed = made.get("error");
    if let Some(why) = failed {
        S.manager.failed = why;
        told(S);
        return;
    }
    go(S, made.path);
}

// What this build is, which line it follows, and every release the project
// has published. The same code `balaur update` runs, so the screen and the
// command cannot disagree.
fn engine_specs(S, k, col) {
    if !S.manager.asked {
        check(S);
    }
    let mine = util::obj(release::installed());
    let h = util::max(style::row_h(S), 30.0);
    let newest = newest_on(S, S.manager.follow);
    let head = [
        #{ kind: "column", grow: 1, controls: [
            #{ kind: "label", role: "text_title", text: "Balaur " + mine.version },
            #{ kind: "label", role: "text_code_quiet", font_size: 11, text: build_line(mine) },
        ] },
    ];
    if !narrow(col) {
        let fresh = newest.get("order").unwrap_or("") == "newer";
        head.push(#{
            kind: "label", role: "text_code_quiet", font_size: 11, text: standing(S, S.manager.follow),
            text_color: if fresh { k.success_text } else { k.text_subtle },
        });
    }
    head.push(#{
        kind: "button", role: "action_form", icon: icons::ui("reset"),
        text: if S.manager.reading { "Checking" } else { "Check" },
        on: |_| { check(S); },
    });
    let out = [#{ full: true, height: 44, slot_role: "layout_actions", controls: head }];
    if mine.held != "" {
        out.push(say(mine.held, k.text_subtle));
    }
    let lines = [#{ kind: "label", role: "text_caption", text: "Follow", width: 60 }];
    for name in util::vec(release::channels()) {
        // Bound afresh: a closure made in a loop captures the binding.
        let line = name;
        lines.push(#{
            kind: "button", role: "chip", text: line, checked: S.manager.follow == line,
            on: |_| {
                S.manager.follow = line;
                told(S);
            },
        });
    }
    out.push(#{ full: true, height: h + 6.0, slot_role: "layout_actions", controls: lines });
    release_specs(S, k, h, mine, out);
    out
}

fn release_specs(S, k, h, mine, out) {
    let rows = [];
    for entry in S.manager.releases {
        let row = util::obj(entry);
        if row.get("channel").unwrap_or("") == S.manager.follow {
            rows.push(row);
        }
    }
    if rows.len() == 0 {
        let empty = if S.manager.reading { "Reading the release feed." } else { "Nothing published on this line yet." };
        out.push(say(empty, k.text_subtle));
    }
    for row in rows {
        let current = row.get("current").unwrap_or(false) == true;
        let controls = [#{ kind: "column", grow: 1, controls: [
            #{
                kind: "label", role: "text_title", font_size: 13, text: row.get("id").unwrap_or(""),
                text_color: if current { k.primary_text } else { k.text_default },
            },
            #{ kind: "label", role: "text_code_quiet", font_size: 11, text: row.get("when").unwrap_or("") },
        ] }];
        let press = press_spec(S, row, mine);
        if press is Object {
            controls.push(press);
        }
        out.push(#{ full: true, height: h + 14.0, slot_role: "layout_actions", controls: controls });
        out.push(rule());
    }
    // An install that cannot replace itself has nothing to name a release for.
    if mine.held != "" || installing(S) {
        return;
    }
    out.push(#{ label: "Or a release by name", height: h, controls: [
        #{
            kind: "text_field", role: "input_form", grow: 1, text: S.manager.tag, placeholder: "v0.2.0",
            on: |text| { S.manager.tag = text; },
        },
        #{
            kind: "button", role: "action_form", text: "Install", min_width: 88,
            on: |_| {
                if S.manager.tag == "" {
                    S.manager.failed = "type a release tag first, like v0.2.0";
                    told(S);
                    return;
                }
                put(S, "", S.manager.tag);
            },
        },
    ] });
}


/// Hide the shell while the screen is up and show it again after: under the
/// screen its docks would still draw a project that is not open.
pub fn cover(S, up) {
    if S.manager.covering != up {
        S.manager.covering = up;
        util::fill(SHELL, #{ visible: !up });
    }
}


/// The head strip: the mark, the name, the version, and the way back.
fn head_controls(S, k) {
    let ink = if k.dark { LOGO_DARK } else { LOGO };
    let out = [
        #{ kind: "image", role: "layout_mark", image: ink },
        #{ kind: "label", role: "text_title", text: "Balaur" },
        #{ kind: "label", role: "text_caption", text: project::version() },
        #{ kind: "row", grow: 1 },
    ];
    if S.manager.back {
        out.push(#{
            kind: "button", role: "action_manager", tooltip: "Esc",
            text: "Back to " + S.game_name,
            on: |_| { close(S); },
        });
    }
    out
}



// The shell's own tab shape: a pill per page, the open one filled.
fn tab_controls(S) {
    let out = [];
    for row in tabs() {
        // Bound afresh: a closure made in a loop captures the binding.
        let id = row[0];
        out.push(#{
            kind: "button", text: row[1],
            role: "tab_manager", checked: S.manager.tab == id,
            on: |_| { S.manager.tab = id; },
        });
    }
    out
}




fn shown(S) {
    let query = S.manager.filter.to_lowercase();
    if query == "" {
        return S.manager.recent;
    }
    let out = [];
    for entry in S.manager.recent {
        let row = util::obj(entry);
        let hay = (row.name + " " + row.path).to_lowercase();
        if hay.contains(query) {
            out.push(entry);
        }
    }
    out
}





/// The build in one line: its id and the line it follows, or where it came
/// from when it came from no release.
pub fn build_line(mine) {
    if mine.source == true {
        return "built from a checkout";
    }
    mine.id + "  ·  following " + mine.channel
}

/// Ask the feed what every line holds, unless a read is already out. The
/// answer arrives in `heard`.
pub fn check(S) {
    if S.manager.reading {
        return;
    }
    S.manager.asked = true;
    S.manager.reading = release::check();
    told(S);
}

// The start screen and the About sheet both show what a check and an install
// keep, so each moving says so to both.
fn told(S) {
    crate::window::changed(S);
    crate::signals::changed(S, "manager");
}

/// Whether an install is in flight.
pub fn installing(S) {
    S.manager.installing.contains_key("tag")
}

/// A report on a check or an install. The start screen and the About sheet
/// both read what this keeps.
pub fn heard(S, e) {
    let ev = util::obj(e);
    let kind = ev.get("kind").unwrap_or("");
    if kind == "listed" {
        S.manager.releases = util::vec(ev.get("rows").unwrap_or([]));
        S.manager.reading = false;
    } else if kind == "downloading" {
        S.manager.installing = #{
            tag: ev.get("tag").unwrap_or(""),
            done: ev.get("done").unwrap_or(0),
            total: ev.get("total").unwrap_or(0),
            unpacking: false,
        };
    } else if kind == "unpacking" {
        let job = S.manager.installing;
        job.unpacking = true;
        S.manager.installing = job;
    } else if kind == "installed" {
        S.manager.installing = #{};
        S.manager.failed = "";
        S.manager.note = ev.get("note").unwrap_or("");
        log::info(S.manager.note);
    } else if kind == "failed" {
        if ev.get("job").unwrap_or("") == "install" {
            S.manager.installing = #{};
        } else {
            S.manager.reading = false;
        }
        S.manager.failed = ev.get("message").unwrap_or("");
    }
    told(S);
}

/// The newest release on a line, or an empty table when it holds none.
pub fn newest_on(S, channel) {
    for entry in S.manager.releases {
        let row = util::obj(entry);
        if row.get("channel").unwrap_or("") == channel {
            return row;
        }
    }
    #{}
}

/// What the newest release on a line means for this build, in a few words.
pub fn standing(S, channel) {
    let newest = newest_on(S, channel);
    let id = newest.get("id").unwrap_or("");
    if id == "" {
        return if S.manager.reading { "checking" } else { "no release on this line" };
    }
    let order = newest.get("order").unwrap_or("");
    if order == "same" {
        return "up to date";
    }
    if order == "newer" {
        return id + " is newer";
    }
    if order == "older" {
        return id + " is older than this build";
    }
    id + " is published"
}



/// The verb a release row carries, as a control: what `row_press` draws.
/// `()` where there is none: an install already running, or a held build.
pub fn press_spec(S, row, mine) {
    if row.get("current").unwrap_or(false) == true {
        return #{ kind: "label", role: "text_code_quiet", font_size: 11, text: "installed" };
    }
    if installing(S) {
        return ();
    }
    let download = row.get("download").unwrap_or("");
    if download != "" {
        return #{
            kind: "button", role: "action_form", text: "Download", min_width: 88,
            on: |_| { engine::open_url(download); },
        };
    }
    if mine.held != "" {
        return ();
    }
    let tag = row.get("tag").unwrap_or("");
    #{
        kind: "button", role: "action_form", min_width: 88,
        text: if row.get("order").unwrap_or("") == "older" { "Downgrade" } else { "Install" },
        on: |_| { put(S, "", tag); },
    }
}

/// How far an install has got, as a row of controls: the megabytes as they
/// arrive, then the unpack, and a bar for it.
pub fn progress_controls(S) {
    let job = S.manager.installing;
    let said = if job.unpacking {
        "unpacking " + job.tag
    } else if job.total > 0 {
        format!("downloading {}  ·  {} of {} MB", job.tag, job.done / MB, job.total / MB)
    } else {
        format!("downloading {}  ·  {} MB", job.tag, job.done / MB)
    };
    let part = if job.unpacking {
        1.0
    } else if job.total > 0 {
        util::f(job.done) / util::f(job.total)
    } else {
        0.0
    };
    [
        #{ kind: "label", role: "text_code_quiet", font_size: 11, text: said },
        #{ kind: "progress_bar", width: 200, height: 4, value: part },
    ]
}



// A new project is named in the shell's own sheet, which is what Settings is
// and what a phone needs: one screen at a time.
pub fn new_fill(S) {
    let hosts = crate::window::sheet_form(S, NEW_SHEET, "New project", []);
    if util::is_nil(hosts) {
        return;
    }
    // The sheet can be up before the screen under it has read where a new
    // project goes.
    if S.manager.parent == "" {
        S.manager.parent = project::home();
    }
    let ids = [];
    for row in util::vec(project::templates()) {
        ids.push(util::obj(row).id);
    }
    if ids.len() == 0 {
        ids.push("empty");
    }
    let h = util::max(style::row_h(S), 30.0);
    let specs = [
        #{ label: "name", height: h, controls: [#{
            kind: "text_field", role: "input_form", grow: 1, text: S.manager.name,
            placeholder: "my-game",
            on: |text| { S.manager.name = text; },
        }] },
        #{ label: "from", height: h, controls: [#{
            kind: "dropdown", role: "choice_form", grow: 1, text: S.manager.template, options: ids,
            on: |picked| { S.manager.template = picked; },
        }] },
        #{ label: "in", height: h, controls: [#{
            kind: "label", role: "text_code_quiet", font_size: 11, grow: 1, truncate: true,
            text: S.manager.parent,
        }] },
    ];
    if S.manager.failed != "" {
        specs.push(#{ full: true, height: 0, controls: [#{
            kind: "label", role: "note_warning", grow: 1, wrap: true, text: S.manager.failed,
        }] });
    }
    specs.push(#{ full: true, height: h, slot_role: "layout_actions", controls: [
        #{ kind: "row", grow: 1 },
        #{
            kind: "button", role: "action_form_primary", text: "Create", min_width: 140,
            on: |_| { create(S); },
        },
    ] });
    crate::pool::sync(S, hosts.form, specs, 72.0, false);
}

fn create(S) {
    let name = if S.manager.name == "" { "my-game" } else { S.manager.name };
    let path = S.manager.parent + "/" + name;
    let made = util::obj(project::create(path, S.manager.template));
    let failed = made.get("error");
    if let Some(why) = failed {
        S.manager.failed = why;
        crate::window::changed(S);
        return;
    }
    S.manager.failed = "";
    go(S, path);
}

// The manifests this screen reads, in the order it looks. A second engine is
// a line here and a route in `balaur_import`.
const MANIFESTS = ["project.godot"];

// Another engine's project becomes a balaur one beside it, opened once the
// import says it is done: opening quits this process.
fn import_project(S, folder) {
    convert(S, folder, |S, path| go(S, path));
}

/// Start converting `folder` into a balaur project beside it, a few files a
/// frame. Answers where it will land, or "" with the reason in
/// `S.manager.failed`; `after(S, path)` runs once every file is written.
pub fn convert(S, folder, after) {
    if converting(S) {
        S.manager.failed = "a project is already being imported";
        return "";
    }
    let manifest = "";
    for name in MANIFESTS {
        if manifest == "" && fs::exists(folder + "/" + name) {
            manifest = folder + "/" + name;
        }
    }
    if manifest == "" {
        S.manager.failed = "no project to import in " + folder + ": looked for project.godot";
        return "";
    }
    let name = util::last_segment(folder);
    let path = S.manager.parent + "/" + name + "-balaur";
    let made = util::obj(project::create(path, "empty"));
    if let Some(why) = made.get("error") {
        S.manager.failed = why;
        return "";
    }
    if !import::start(manifest, path) {
        S.manager.failed = "importing " + manifest + " did not start";
        return "";
    }
    S.manager.failed = "";
    S.manager.note = "importing " + name;
    S.manager.importing = #{ source: manifest, path: path, done: 0, files: 0, after: after };
    path
}

/// Whether a project is being converted.
pub fn converting(S) {
    S.manager.importing.contains_key("source")
}

/// Whether an import report is about the conversion this screen started.
pub fn owns(S, e) {
    converting(S) && util::obj(e).get("source").unwrap_or("") == S.manager.importing.source
}

/// A report on the conversion: the count as it climbs, then how it ended.
pub fn report(S, e) {
    let ev = util::obj(e);
    let kind = ev.get("kind").unwrap_or("");
    let job = S.manager.importing;
    if kind == "started" || kind == "wrote" {
        job.done = ev.get("done").unwrap_or(0);
        job.files = ev.get("files").unwrap_or(0);
        S.manager.importing = job;
        told(S);
        return;
    }
    S.manager.importing = #{};
    if kind == "done" {
        S.manager.note = ev.get("note").unwrap_or("");
        log::info(format!("imported {} into {}: {}", job.source, job.path, S.manager.note));
        // The list was read before the project existed, so it is read again.
        S.manager.read = false;
        let after = job.after;
        after(S, job.path);
    } else if kind == "failed" {
        S.manager.failed = "importing " + job.source + ": " + ev.get("message").unwrap_or("");
    } else if kind == "cancelled" {
        S.manager.failed = format!("stopped importing after {} files; {} holds what was written",
            ev.get("done").unwrap_or(0), job.path);
    }
    told(S);
}


// Replace this install, on a thread; `heard` follows it. The reader pressed
// it, so a downgrade is allowed: the press said Downgrade where it is one.
pub fn put(S, channel, tag) {
    if installing(S) {
        return;
    }
    if !release::install(channel, tag, #{ allow_downgrade: true }) {
        S.manager.failed = "nothing installs while a recording plays";
        return;
    }
    let named = if tag == "" { channel } else { tag };
    S.manager.failed = "";
    S.manager.note = "installing " + named;
    S.manager.installing = #{ tag: named, done: 0, total: 0, unpacking: false };
    told(S);
}

/// Open a project: the module remembers it, starts the editor on it and asks
/// this process to quit.
pub fn go(S, path) {
    // Opening quits this process, which would leave a conversion half written.
    if converting(S) {
        S.manager.failed = "wait for the import to finish, or stop it";
        told(S);
        return;
    }
    // Or an install half swapped in.
    if installing(S) {
        S.manager.failed = "wait for the install to finish";
        told(S);
        return;
    }
    let answer = util::obj(project::open(path));
    let failed = answer.get("error");
    if let Some(why) = failed {
        S.manager.failed = why;
        told(S);
        return;
    }
    S.manager.failed = "";
}
