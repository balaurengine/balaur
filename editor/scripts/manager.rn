// The screen the editor starts on when it was given no project: what this
// machine has opened, the examples that ship with it, and which engine build
// is installed. Drawn with the shell's own widgets and its own theme.

use crate::icons;
use crate::style;
use crate::util;

/// The state the screen keeps: what it read, what is being typed, and what it
/// was told last.
pub fn state() {
    #{
        on: false,
        tab: "projects",
        recent: [],
        read: false,
        filter: "",
        // The New project sheet's fields, which only exist while it is up.
        name: "my-game",
        template: "empty",
        parent: "",
        note: "",
        failed: "",
        // The release feed, read once when the Engine tab opens.
        releases: [],
        asked: false,
        follow: "",
        tag: "",
    }
}

// The widest the screen draws, whatever the window is: a list stretched
// across a monitor is a list nobody can read across.
const COLUMN = 900.0;
// What a cover is: the shape `scripts/showcase.sh` writes them in, so a card
// reserves the room the picture will actually take.
const COVER_ASPECT = 1.7647;
const SEAM = 14.0;
// The sheet a new project is named in, which the shell already has a shape for.
const NEW_SHEET = "manager-new";
// The editor's own mark, which the top bar draws too. A project of its own
// is not open yet, so every row wears this one.
const LOGO = "assets/balaur-logo.png";

/// The `manager` start state: show the screen instead of the docks.
pub fn open(S) {
    S.manager.on = true;
    S.manager.read = false;
}

/// The screen, on its examples half.
pub fn open_examples(S) {
    open(S);
    S.manager.tab = "examples";
}

/// The screen with the New project sheet up, for a shot and for the palette.
pub fn open_new(S) {
    open(S);
    crate::window::show(S, NEW_SHEET);
}

/// The screen, on its engine half: what `--state versions` opens.
pub fn open_versions(S) {
    open(S);
    S.manager.tab = "engine";
}

/// Ask for a folder and open what is in it, without the screen in between.
pub fn pick(S) {
    let picked = project::pick_folder();
    if picked is String {
        go(S, picked);
        return;
    }
    open(S);
}

/// Whether the screen has the window. A run with no project is the screen
/// whether or not anybody asked for it: there is nothing else to hold.
pub fn showing(S) {
    S.manager.on || S.game_root == ""
}

fn tabs() {
    [["projects", "Projects"], ["examples", "Examples"], ["engine", "Engine"]]
}

// One column under this, two above it.
fn narrow(col) {
    col < 600.0
}

fn refresh(S) {
    if S.manager.read {
        return;
    }
    S.manager.read = true;
    S.manager.recent = util::vec(project::recent());
    if S.manager.parent == "" {
        S.manager.parent = project::home();
    }
    if S.manager.follow == "" {
        let mine = util::obj(release::installed()).get("channel").unwrap_or("");
        S.manager.follow = if mine == "" { "nightly" } else { mine };
    }
}

pub fn draw(S, k) {
    if !S.manager.on {
        return;
    }
    refresh(S);
    let (sw, sh) = ui::screen_size();
    let gutter = crate::layout::gutter(S);
    let col = util::min(COLUMN, util::max(sw - 2.0 * gutter, 240.0));
    // The screen is the window: a project's own widgets are not behind this.
    ui::set_widget_layer(false, 0.0, 0.0, 0.0, 0.0);
    ui::overlay("manager-ground", #{ x: 0.0, y: 0.0, w: sw, h: sh, fill: k.bg }, || {});
    let left = (sw - col) / 2.0;
    ui::overlay("manager", #{ x: left, y: gutter, w: col, h: sh - 2.0 * gutter }, || {
        head(S, k, col);
        ui::add_space(10);
        tab_row(S, k, col);
        ui::add_space(10);
        ui::separator(k.line);
        ui::add_space(SEAM);
        let tall = sh - 2.0 * gutter - 120.0;
        if S.manager.tab == "engine" {
            engine_page(S, k, col, tall);
        } else if S.manager.tab == "examples" {
            examples_page(S, k, col, tall);
        } else {
            projects_page(S, k, col, tall);
        }
    });
    new_sheet(S, k);
}

fn head(S, k, w) {
    ui::horizontal(#{ height: 34, width: w }, || {
        ui::image(LOGO, #{ width: 26 });
        ui::add_space(10);
        ui::label("Balaur", #{ size: style::XL, font: ui::FONT_HEADING, strong: true, color: k.text });
        ui::add_space(10);
        ui::label(project::version(), style::mono_sm(k.faint));
    });
    let said = if S.manager.failed != "" { S.manager.failed } else { S.manager.note };
    if said != "" {
        ui::add_space(4);
        let tone = if S.manager.failed != "" { k.get("warn").unwrap_or(k.accent) } else { k.faint };
        ui::label(said, util::merge(style::mono_sm(tone), #{ wrap: true, width: w }));
    }
}

// The shell's own tab shape: a pill per page, the open one filled.
fn tab_row(S, k, w) {
    let h = util::max(style::row_h(S), 30.0);
    ui::horizontal(#{ height: h, width: w }, || {
        for row in tabs() {
            let id = row[0];
            let on = S.manager.tab == id;
            if ui::pill(row[1], #{
                height: h, size: style::MD, radius: 8, padding_x: 16,
                fill: if on { k.accent_soft } else { "#00000000" },
                color: if on { k.accent } else { k.dim },
                hover_fill: k.panel,
            }) {
                S.manager.tab = id;
            }
            ui::add_space(6);
        }
    });
}

// The filter, then the three verbs. Under a phone's width the verbs drop to
// the row below, since a filter and three buttons do not share 280 pixels.
fn toolbar(S, k, w) {
    let h = util::max(style::row_h(S), 30.0);
    let tight = narrow(w);
    // Written back to front: `ui::right` puts the first one at the right
    // edge, so New project reads leftmost of the three.
    let verbs = |room| {
        if !S.touchscreen {
            if ui::pill(icons::panel("import") + " Import Godot", #{
                height: h, size: style::MD, radius: 8, padding_x: 14, min_width: room,
                fill: k.panel, color: k.text,
                tooltip: "Pick a folder holding project.godot",
            }) {
                let picked = project::pick_folder();
                if picked is String {
                    import_godot(S, picked);
                }
            }
            ui::add_space(6);
            if ui::pill(icons::panel("assets") + " Open folder", #{
                height: h, size: style::MD, radius: 8, padding_x: 14, min_width: room,
                fill: k.panel, color: k.text,
            }) {
                let picked = project::pick_folder();
                if picked is String {
                    go(S, picked);
                }
            }
            ui::add_space(6);
        }
        if ui::pill(icons::ui("add") + " New project", #{
            height: h, size: style::MD, radius: 8, padding_x: 14, min_width: room,
            fill: k.accent_soft, color: k.accent,
        }) {
            crate::window::show(S, NEW_SHEET);
        }
    };
    ui::horizontal(#{ height: h, width: w }, || {
        let field_w = if tight { w } else { w - 420.0 };
        S.manager.filter = crate::search::field(S, k, "manager", "Filter projects", field_w);
        if !tight {
            ui::right(|| { verbs(0.0); });
        }
    });
    if tight {
        ui::add_space(8);
        ui::horizontal(#{ height: h, width: w }, || { verbs((w - 12.0) / 3.0); });
    }
}

fn projects_page(S, k, col, tall) {
    toolbar(S, k, col);
    ui::add_space(SEAM);
    let rows = shown(S);
    if rows.len() == 0 {
        let why = if S.manager.recent.len() == 0 {
            "Nothing opened on this machine yet. Start from an example, or make one."
        } else {
            "No project matches that filter."
        };
        ui::label(why, util::merge(style::mono_sm(k.faint), #{ wrap: true, width: col }));
        return;
    }
    // Two lines a row, and the rule between them: the list kind draws only
    // what is on screen, which is what a long history needs.
    let h = util::max(style::row_h(S) + 22.0, 56.0);
    ui::list("manager-recent", #{ row_height: h, max_height: tall }, rows.len(), |i| {
        project_row(S, k, col, util::obj(rows[i]), h);
    });
}

fn shown(S) {
    let query = S.manager.filter.to_lowercase();
    if query == "" {
        return S.manager.recent;
    }
    let out = [];
    for entry in S.manager.recent {
        let row = util::obj(entry);
        let hay = (row.name + " " + row.path).to_lowercase();
        if hay.contains(query) {
            out.push(entry);
        }
    }
    out
}

// Two lines: the name a click opens, and the folder under it. What a row
// says about itself, when and with which engine, sits at the right edge.
fn project_row(S, k, w, row, h) {
    let here = row.path;
    let gone = row.get("exists").unwrap_or(true) != true;
    let when = row.get("when").unwrap_or("");
    let built = row.get("version").unwrap_or("");
    let line = util::max(style::row_h(S), 28.0);
    // What the marks at the right edge take. A phone shows when it was
    // opened and nothing else, so the path keeps the width instead.
    let tight = narrow(w);
    let marks = if tight { 120.0 } else { 200.0 };
    ui::horizontal(#{ height: h, width: w }, || {
        ui::vertical(|| {
            ui::horizontal(#{ height: line, width: w - marks }, || {
                ui::add_space(2);
                // The engine's mark: a project keeps its own icon, and none
                // of them is open, so the row wears the editor's.
                ui::image(LOGO, #{ width: 20 });
                ui::add_space(8);
                if ui::pill(row.name, #{
                    height: line, size: style::MD, align: ui::ALIGN_LEFT, radius: 8,
                    min_width: w - marks - 32.0, padding_x: 8,
                    icon: if gone { icons::panel("problems") } else { "" },
                    icon_size: style::MD, icon_color: k.faint,
                    fill: "#00000000", hover_fill: k.panel,
                    color: if gone { k.faint } else { k.text },
                    tooltip: here,
                }) {
                    if !gone {
                        go(S, here);
                    }
                }
            });
            ui::horizontal(#{ height: 16, width: w - marks }, || {
                ui::add_space(32);
                ui::label(if gone { here + "  ·  disk not mounted" } else { here },
                    util::merge(style::mono_sm(k.faint), #{ truncate: true }));
            });
        });
        // Back to front again: the mark that forgets it is the rightmost.
        ui::right(|| {
            if ui::pill(icons::ui("close"), #{
                role: "icon_button", tooltip: "Forget this project",
            }) {
                project::forget(here);
                S.manager.read = false;
            }
            ui::add_space(8);
            if built != "" && !tight {
                ui::label(built, style::mono_sm(k.faint));
                ui::add_space(10);
            }
            ui::label(when, style::mono_sm(k.faint));
        });
    });
    ui::separator(k.line);
}

fn examples_page(S, k, col, tall) {
    let rows = util::vec(project::examples());
    if rows.len() == 0 {
        ui::label("No examples ship beside this build.",
            util::merge(style::mono_sm(k.faint), #{ wrap: true, width: col }));
        return;
    }
    let across = if narrow(col) { 1 } else if col < 760.0 { 2 } else { 3 };
    // Floored: three cards and two seams have to add up to the column, and
    // a third of a pixel each puts the last one past its edge.
    let card_w = math::floor((col - util::f(across - 1) * SEAM) / util::f(across));
    // The picture, then the name, the line under it and the card's own air.
    let card_h = math::floor(card_w / COVER_ASPECT) + 54.0;
    ui::scroll("manager-examples", #{ axis: "vertical", max_height: tall }, || {
        let n = 0;
        while n < rows.len() {
            ui::horizontal(#{ height: card_h, width: col }, || {
                // The row's own gap, so the cards add up to the column: a
                // space between them plus egui's own is one gap too many.
                ui::spacing(SEAM, 0);
                let c = 0;
                while c < across && n + c < rows.len() {
                    example_card(S, k, card_w, card_h, util::obj(rows[n + c]));
                    c += 1;
                }
            });
            ui::add_space(SEAM);
            n += across;
        }
    });
    ui::label("Opens a copy in your projects folder, so the example stays as it shipped.",
        util::merge(style::mono_sm(k.faint), #{ wrap: true, width: col }));
}

fn example_card(S, k, w, h, row) {
    let id = row.id;
    let cover = row.get("cover").unwrap_or("");
    ui::vertical(|| {
        ui::frame(#{
            fill: k.panel, radius: 12, padding_x: 0, padding_y: 0,
            hover_fill: k.raised, tooltip: "Copy into " + S.manager.parent,
        }, || {
            ui::vertical(|| {
                if cover != "" {
                    ui::image(cover, #{ width: w });
                } else {
                    // No picture shipped: the engine's own mark, so the card
                    // still reads as a project rather than a blank.
                    ui::horizontal(#{ height: h - 54.0, width: w }, || {
                        ui::add_space(w / 2.0 - 18.0);
                        ui::image(LOGO, #{ width: 36 });
                    });
                }
                ui::horizontal(#{ height: 20, width: w }, || {
                    ui::add_space(12);
                    ui::label(row.name, #{ size: style::MD, strong: true, color: k.text });
                });
                ui::horizontal(#{ height: 18, width: w }, || {
                    ui::add_space(12);
                    ui::label(row.get("note").unwrap_or(""),
                        util::merge(style::mono_sm(k.faint), #{ truncate: true }));
                });
                ui::add_space(8);
            });
        });
        ui::horizontal(#{ height: 0, width: w }, || {});
    });
}

// What this build is, which line it follows, and every release the project
// has published. The same code `balaur update` runs, so the screen and the
// command cannot disagree.
fn engine_page(S, k, col, tall) {
    if !S.manager.asked {
        S.manager.asked = true;
        S.manager.releases = util::vec(release::releases());
    }
    let mine = util::obj(release::installed());
    let h = util::max(style::row_h(S), 30.0);
    let tight = narrow(col);
    let newest = newest_on(S, S.manager.follow);
    ui::horizontal(#{ height: 40, width: col }, || {
        ui::vertical(|| {
            ui::label("Balaur " + mine.version, #{
                size: style::LG, font: ui::FONT_HEADING, strong: true, color: k.text,
            });
            let line = if mine.source == true {
                "built from a checkout"
            } else {
                mine.id + "  ·  following " + mine.channel
            };
            ui::label(line, style::mono_sm(k.faint));
        });
        ui::right(|| {
            if ui::pill(icons::ui("reset") + " Check", #{
                height: h, size: style::SM, radius: 8, padding_x: 12,
                fill: k.panel, color: k.dim,
            }) {
                S.manager.releases = util::vec(release::releases());
            }
            ui::add_space(10);
            if !tight {
                ui::label(standing(mine, newest), style::mono_sm(
                    if newest == "" { k.faint } else { k.get("ok").unwrap_or(k.sage) }));
            }
        });
    });
    ui::add_space(SEAM);
    ui::horizontal(#{ height: h + 6.0, width: col }, || {
        ui::label("Follow", #{ size: style::MD, color: k.dim, width: 60 });
        ui::scroll("manager-follow", #{
            axis: "horizontal", max_width: col - 66.0, max_height: h + 6.0, deadzone: 6,
        }, || {
            ui::horizontal(#{ height: h }, || {
                ui::spacing(4, 0);
                for name in util::vec(release::channels()) {
                    let on = S.manager.follow == name;
                    if ui::pill(name, #{
                        height: h, size: style::SM, radius: 8, padding_x: 12,
                        fill: if on { k.accent_soft } else { k.panel },
                        color: if on { k.accent } else { k.dim },
                    }) {
                        S.manager.follow = name;
                    }
                }
            });
        });
    });
    ui::add_space(SEAM);
    release_list(S, k, col, tall);
}

// The newest release on a line, or "" when it holds none.
fn newest_on(S, channel) {
    for entry in S.manager.releases {
        let row = util::obj(entry);
        if row.get("channel").unwrap_or("") == channel {
            return row.get("id").unwrap_or("");
        }
    }
    ""
}

fn standing(mine, newest) {
    if newest == "" {
        return "no release on this line";
    }
    if mine.get("id").unwrap_or("") == newest {
        return "up to date";
    }
    if mine.get("source").unwrap_or(false) == true {
        return newest + " is published";
    }
    newest + " is newer"
}

fn release_list(S, k, col, tall) {
    let h = util::max(style::row_h(S), 30.0);
    let rows = [];
    for entry in S.manager.releases {
        let row = util::obj(entry);
        let broke = row.get("error");
        if let Some(why) = broke {
            ui::label(why, util::merge(style::mono_sm(k.faint), #{ wrap: true, width: col }));
            return;
        }
        if row.get("channel").unwrap_or("") == S.manager.follow {
            rows.push(row);
        }
    }
    if rows.len() == 0 {
        ui::label("Nothing published on this line yet.", style::mono_sm(k.faint));
    }
    // As tall as the releases it holds, capped by what is left of the screen:
    // a scroll of one row should not reserve the page.
    let room = util::min(tall - 120.0, util::f(rows.len()) * (h + 15.0) + 4.0);
    ui::scroll("manager-releases", #{ axis: "vertical", max_height: util::max(room, h) }, || {
        for row in rows {
            let here = row.get("tag").unwrap_or("");
            let current = row.get("current").unwrap_or(false) == true;
            ui::horizontal(#{ height: h + 14.0, width: col }, || {
                ui::vertical(|| {
                    ui::label(row.get("id").unwrap_or(""), #{
                        size: style::MD, strong: true,
                        color: if current { k.accent } else { k.text },
                    });
                    ui::label(row.get("when").unwrap_or(""), style::mono_sm(k.faint));
                });
                ui::right(|| {
                    if current {
                        ui::label("installed", style::mono_sm(k.faint));
                        return;
                    }
                    if ui::pill("Install", #{
                        height: h, size: style::SM, radius: 8, padding_x: 14, min_width: 88,
                        fill: k.sunken, color: k.text,
                    }) {
                        put(S, "", here);
                    }
                });
            });
            ui::separator(k.line);
        }
    });
    ui::add_space(10);
    let tight = narrow(col);
    let label_w = if tight { 0.0 } else { 160.0 };
    ui::horizontal(#{ height: h, width: col }, || {
        if !tight {
            ui::label("Or a release by name", #{ size: style::MD, color: k.dim, width: label_w });
        }
        let field_w = if tight { col } else { col - label_w - 110.0 };
        let (tag, _, _) = ui::text_field("manager-tag", "v0.2.0",
            util::merge(style::field(k, field_w), #{ value: S.manager.tag }));
        S.manager.tag = tag;
        if !tight {
            ui::right(|| { install_named(S, k, h); });
        }
    });
    if tight {
        ui::add_space(8);
        ui::horizontal(#{ height: h, width: col }, || {
            ui::right(|| { install_named(S, k, h); });
        });
    }
}

fn install_named(S, k, h) {
    if ui::pill("Install", #{
        height: h, size: style::SM, radius: 8, padding_x: 14, min_width: 88,
        fill: k.panel, color: k.dim,
    }) {
        put(S, "", S.manager.tag);
    }
}

// A new project is named in the shell's own sheet, which is what Settings is
// and what a phone needs: one screen at a time.
fn new_sheet(S, k) {
    crate::window::sheet(S, NEW_SHEET, "New project", || {}, || {
        let w = crate::window::inner_w(S);
        let h = util::max(style::row_h(S), 30.0);
        let label_w = 72.0;
        ui::horizontal(#{ height: h, width: w }, || {
            ui::label("name", #{ size: style::MD, color: k.dim, width: label_w });
            let (name, _, _) = ui::text_field("manager-name", "my-game",
                util::merge(style::field(k, w - label_w), #{ value: S.manager.name }));
            S.manager.name = name;
        });
        ui::add_space(10);
        ui::horizontal(#{ height: h, width: w }, || {
            ui::label("from", #{ size: style::MD, color: k.dim, width: label_w });
            let ids = [];
            for row in util::vec(project::templates()) {
                ids.push(util::obj(row).id);
            }
            if ids.len() == 0 {
                ids.push("empty");
            }
            let (picked, changed) = ui::dropdown("manager-template", S.manager.template, ids, #{
                width: w - label_w, size: style::MD, height: h, color: k.text,
            });
            if changed {
                S.manager.template = picked;
            }
        });
        ui::add_space(10);
        ui::horizontal(#{ height: h, width: w }, || {
            ui::label("in", #{ size: style::MD, color: k.dim, width: label_w });
            ui::horizontal(#{ height: h, width: w - label_w }, || {
                ui::label(S.manager.parent, util::merge(style::mono_sm(k.faint), #{ truncate: true }));
            });
        });
        ui::add_space(16);
        ui::horizontal(#{ height: h, width: w }, || {
            ui::right(|| {
                if ui::pill("Create", #{
                    height: h, size: style::MD, strong: true, radius: 8,
                    min_width: 140, padding_x: 16, fill: k.accent_soft, color: k.accent,
                }) {
                    create(S);
                }
            });
        });
    });
}

fn create(S) {
    let name = if S.manager.name == "" { "my-game" } else { S.manager.name };
    let path = S.manager.parent + "/" + name;
    let made = util::obj(project::create(path, S.manager.template));
    let failed = made.get("error");
    if let Some(why) = failed {
        S.manager.failed = why;
        return;
    }
    S.manager.failed = "";
    go(S, path);
}

// A Godot project becomes a balaur one beside it: the import writes into an
// empty project rather than over the folder it read.
fn import_godot(S, folder) {
    let manifest = folder + "/project.godot";
    if !fs::exists(manifest) {
        S.manager.failed = "no project.godot in " + folder;
        return;
    }
    let name = util::last_segment(folder);
    let path = S.manager.parent + "/" + name + "-balaur";
    let made = util::obj(project::create(path, "empty"));
    let failed = made.get("error");
    if let Some(why) = failed {
        S.manager.failed = why;
        return;
    }
    S.manager.failed = "";
    S.manager.note = "importing " + manifest + " into " + path;
    log::info(S.manager.note);
    go(S, path);
}

// Replace this install. The reader pressed it, so a downgrade is allowed:
// naming an older release is the only reason to name one.
fn put(S, channel, tag) {
    let answer = util::obj(release::install(channel, tag, true));
    let failed = answer.get("error");
    if let Some(why) = failed {
        S.manager.failed = why;
        return;
    }
    S.manager.failed = "";
    S.manager.note = answer.get("note").unwrap_or("");
    log::info(S.manager.note);
}

/// Open a project: the module remembers it, starts the editor on it and asks
/// this process to quit.
pub fn go(S, path) {
    let answer = util::obj(project::open(path));
    let failed = answer.get("error");
    if let Some(why) = failed {
        S.manager.failed = why;
        return;
    }
    S.manager.failed = "";
}
