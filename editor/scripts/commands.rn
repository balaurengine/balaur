// The shell's commands by name: what a key in scenes/panels/keys.toml runs.
// One table, so a chord and the palette row for the same thing cannot drift.

use crate::anim;
use crate::arrange;
use crate::defs;
use crate::exporter;
use crate::model;
use crate::refactor;
use crate::selection;
use crate::settings;
use crate::shell;
use crate::theme;

/// What the keys need to know to say which of them are live.
pub fn keys_view(S) {
    #{ stopped: S.debug.paused is Object, playing: S.playing }
}

/// Run the command `name`. A command with nothing to act on does nothing.
pub fn run(S, name) {
    if name.starts_with("workspace_") {
        workspace(S, name);
        return;
    }
    match name {
        "palette" => {
            if S.palette {
                shell::close_palette(S);
            } else {
                shell::open_palette(S, "");
            }
        }
        "save" => shell::save_active(S),
        "format" => shell::format_active(S),
        "definition" => shell::goto_definition(S),
        "rename_symbol" => refactor::open(S, "rename"),
        "replace" => refactor::open(S, "replace"),
        "focus" => shell::toggle_focus(S),
        "split" => shell::toggle_split(S),
        "zoom_in" => shell::ask_ui_scale(S, S.ui_scale + 0.125),
        "zoom_out" => shell::ask_ui_scale(S, S.ui_scale - 0.125),
        "settings" => settings::open(S),
        "export" => exporter::open(S),
        "continue" => shell::resume(S, debugger::CONTINUE),
        "step_over" => shell::resume(S, debugger::STEP_OVER),
        "step_into" => shell::resume(S, debugger::STEP_INTO),
        "step_out" => shell::resume(S, debugger::STEP_OUT),
        "play" => shell::toggle_play(S),
        "break" => debugger::request_break(),
        "add_child" => model::add_child(S, None),
        "attach_script" => shell::attach_script(S),
        "reload" => shell::reload_scripts(S),
        "copy" => copy(S),
        "redo" => shell::redo(S),
        "redo_y" => shell::redo(S),
        "undo" => shell::undo(S),
        "theme" => theme::toggle(S),
        "select_all" => selection::select_all(S),
        "ungroup" => arrange::ungroup(S),
        "group" => arrange::group(S),
        "unlock_all" => arrange::unlock_all(S),
        "lock" => arrange::toggle_locked(S),
        "show_all" => arrange::show_all(S),
        "hide" => arrange::toggle_hidden(S),
        "isolate" => arrange::toggle_isolate(S),
        "key" => key(S),
        "cancel" => cancel(S),
        _ => log::warn(format!("no command named {}", name)),
    }
}

// `workspace_<n>`, one a workspace in the order the bar shows them.
fn workspace(S, name) {
    let n = name["workspace_".len()..].parse::<i64>().unwrap_or(0);
    for (i, p) in defs::workspaces().iter().enumerate() {
        if i + 1 == n {
            shell::set_workspace(S, p.id);
        }
    }
}

// ⌘V is the paste event the Editor hears; only the copy half is a chord.
fn copy(S) {
    if model::has_selection(S) {
        ui::set_clipboard(model::copy_selected(S));
    }
}

// A key on the timeline where the playhead is, in the Animation workspace.
fn key(S) {
    if S.workspace == defs::WORKSPACE_ANIMATION {
        anim::add_key(S, S.anim.time);
    }
}

// Escape stops whichever drawing tool is mid-shape. The completion popup takes
// it first while it is open, as it takes the arrows and Enter.
fn cancel(S) {
    if S.complete.open {
        return;
    }
    crate::polygon::cancel(S);
    crate::pen::cancel(S);
    crate::tiles::cancel(S);
}
