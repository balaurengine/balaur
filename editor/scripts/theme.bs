// Finds a theme, a folder of a dark and a light half, fills the worn half in
// from its base, and hands it to both readers. The look lives in the files.

use editor;
use settings;
use signals;
use util;
use words::components;
use words::fields;
use words::layout_fields;
use words::panel_keys;
use words::project_fields;
use words::theme_modes;
use words::theme_tokens;

const DARK: str = "dark";
const LIGHT: str = "light";
const COLORS: str = "colors";

pub struct Resolve {
    name: str,
    doc: any,
}

/// The pairs the editor ships, which every other one is based on, and the
/// options `editor/appearance/theme` offers.
pub fn BUNDLED() -> [str] {
    [
        "balaur",
        "atom-one",
        "catppuccin",
        "dracula",
        "everforest",
        "github",
        "gruvbox",
        "kanagawa",
        "rose-pine",
        "solarized",
        "tokyo-night",
    ]
}

pub const DEFAULT: str = "balaur";

pub fn HALVES() -> [str] {
    [DARK, LIGHT]
}

/// The roles, kinds and sizes every bundled half wears under its colours.
const ROLES: str = "themes/roles.toml";

pub const SETTING: str = "editor/appearance/theme";

/// `system`, `dark` or `light`: which half of the pair is worn.
pub const MODE_SETTING: str = "editor/appearance/mode";

/// The root nodes that dress their subtree with the theme: the shell, the
/// start screen, the palette and the one sheet.
fn ROOTS() -> [str] {
    ["Editor/Shell", "Editor/Manager", "Editor/Picker", "Editor/Sheet"]
}

/// Where the person's own themes live.
pub fn user_directory() -> str {
    util::editor_data() + "/themes"
}

pub fn is_bundled(name: str) -> bool {
    is_among(name, BUNDLED())
}

fn is_among(name: str, items: [str]) -> bool {
    for bundled in items {
        if bundled == name {
            return true;
        }
    }
    false
}

/// A pair's folder: bundled ones beside the editor, the rest in `user_directory()`.
pub fn folder_of(name: str) -> str {
    if is_bundled(name) {
        "themes/" + name
    } else {
        user_directory() + "/" + name
    }
}

/// One half's file.
pub fn path_of(name: str, half: str) -> str {
    folder_of(name) + "/" + half + ".toml"
}

/// Every pair there is to pick: the bundled ones, then the person's, by name.
pub fn names() -> [str] {
    let out: [any] = copy_names(BUNDLED());
    for entry in util::list_or_empty(fs::list(user_directory())) {
        if entry[project_fields::IS_DIR].as_bool() && !is_bundled(entry[fields::NAME].as_str()) {
            out.push(entry[fields::NAME]);
        }
    }
    out
}

fn copy_names(items: [str]) -> [str] {
    let out: [str] = [];
    for item in items {
        out.push(item);
    }
    out
}

/// The document one half holds, unmerged, or nothing when it is missing or
/// does not parse.
pub fn read(name: str, half: str) -> any {
    read_at(path_of(name, half))
}

fn read_at(path: str) -> any {
    let text = fs::read(path);
    if text == nil {
        return nil;
    }
    let text = text.unwrap();
    let doc = toml::parse(text);
    let ok = true;
    if ok && doc.kind() == types::KIND_MAP { doc } else { nil }
}

/// A bundled half as the editor wears it before anyone's edits: the shared
/// roles under its colours.
pub fn bundled(name: str, half: str) -> any {
    let roles = util::map_or_empty(read_at(ROLES));
    merge(roles, util::map_or_empty(read(name, half)))
}

/// `over` written onto `base`, table by table: a key `over` names wins, and a
/// table both hold is merged rather than replaced.
pub fn merge(base: any, over: any) -> any {
    let out: any = {};
    for key in base.keys() {
        let value = base[key];
        out[key] = value;
    }
    for key in over.keys() {
        let value = over[key];
        let nested = value.kind() == types::KIND_MAP && out.has(key) && out[key].kind() == types::KIND_MAP;
        if nested {
            let below = out[key];
            out[key] = merge(below, value);
        } else {
            out[key] = value;
        }
    }
    out
}

/// What `doc` says that `base` does not: the keys whose values differ, and
/// the tables holding at least one.
pub fn diff(base: any, doc: any) -> any {
    let out: any = {};
    for key in doc.keys() {
        let value = doc[key];
        let had = base.has(key);
        if value.kind() == types::KIND_MAP {
            let below: any = if had && base[key].kind() == types::KIND_MAP { base[key] } else { {} };
            let inner = diff(below, value);
            if inner.len() > 0 {
                out[key] = inner;
            }
        } else if !had || !same(base[key], value) {
            out[key] = value;
        }
    }
    out
}

/// Equal as a file would spell them: `12` and `12.0` differ, and two values
/// of different types compare without an error.
pub fn same(first: any, second: any) -> bool {
    first.kind() == second.kind() && first == second
}

/// The bundled pair a document is filled in from: what it names, or balaur.
pub fn base_of(doc: any) -> str {
    let named = util::map_or_empty(doc)[fields::BASE];
    if named.kind() == types::KIND_STRING && is_bundled(named.as_str()) { named.as_str() } else { DEFAULT }
}

/// What a person's half states, or, for a half the folder lacks, only the
/// base the other half names: the missing half is the base's.
pub fn own_half(name: str, half: str) -> any {
    let own = read(name, half);
    if own.kind() == types::KIND_MAP {
        return own;
    }
    let other = read(name, if half == theme_modes::DARK { theme_modes::LIGHT } else { theme_modes::DARK });
    { fields::BASE: base_of(other) }
}

/// One half of a pair, filled in from its base. A pair that no longer
/// resolves answers balaur's, said once.
pub fn resolve(name: str, half: str) -> Resolve {
    if is_bundled(name) {
        return Resolve { name: name, doc: bundled(name, half) };
    }
    if !fs::exists(folder_of(name)) {
        log::warn("theme '{name}' is not at {folder_of(name)}; using {DEFAULT}");
        return Resolve { name: DEFAULT, doc: bundled(DEFAULT, half) };
    }
    let own = own_half(name, half);
    Resolve { name: name, doc: merge(bundled(base_of(own), half), own) }
}

/// A document with every token worked out, flattened for a script's
/// `k.<token>` lookup, keeping the document, its sizes and fonts, its pair
/// and its half beside.
pub fn flat(name: str, half: str, doc: any) -> any {
    let done = ui::complete_theme(doc);
    let fonts = doc[project_fields::FONTS];
    let flattened: any = {
        panel_keys::DARK: done[panel_keys::DARK],
        project_fields::ROLES: doc[project_fields::ROLES],
        COLORS: done[COLORS],
        project_fields::SIZES: done[project_fields::SIZES],
        project_fields::FONTS: if fonts == nil { {} } else { fonts },
        fields::NAME: name,
        layout_fields::HALF: half,
        fields::DOC: doc,
    };
    let colors = done[COLORS];
    for key in colors.keys() {
        let value = colors[key];
        flattened[key] = value;
    }
    // A node with no kind of its own wears the quietest text tier.
    if flattened[theme_tokens::NODE_DEFAULT] == nil {
        flattened[theme_tokens::NODE_DEFAULT] = colors[theme_tokens::TEXT_SUBTLE];
    }
    flattened
}

pub fn load(name: str, half: str) -> any {
    let found = resolve(name, half);
    flat(found.name, half, found.doc)
}

pub fn dark() -> any {
    load(DEFAULT, theme_modes::DARK)
}

/// The half to wear: a start-up state's, else the mode's, else the system's.
pub fn half_for(state: editor::State, system_dark: bool) -> any {
    if state.theme_half != "" {
        return state.theme_half;
    }
    let mode = settings::get(MODE_SETTING);
    if mode.as_str() == theme_modes::DARK || mode.as_str() == theme_modes::LIGHT {
        return mode;
    }
    if system_dark { theme_modes::DARK } else { theme_modes::LIGHT }
}

// What a `code` node draws its gutter in, and the token it takes it from where
// the theme names none: the colours the code pane always drew them in.
fn CODE_COLORS() -> [[str]] {
    [
        ["breakpoint_color", theme_tokens::PRIMARY_TEXT],
        ["problem_color", theme_tokens::DANGER_TEXT],
        ["warning_color", theme_tokens::WARNING_TEXT],
        ["current_fill", theme_tokens::PRIMARY_BG],
    ]
}

// The document the engine wears: the theme's own, with the code colours
// filled in from its tokens. A copy, so the Theme dialog lists what the file
// says and nothing it does not.
fn worn(tokens: any) -> any {
    let doc: any = {};
    let own = tokens[fields::DOC];
    for key in own.keys() {
        let value = own[key];
        doc[key] = value;
    }
    let colors: any = {};
    let own_colors = tokens[fields::DOC][COLORS];
    let own_color_table = util::map_or_empty(if own_colors == nil { {} } else { own_colors });
    for key in own_color_table.keys() {
        let value = own_color_table[key];
        colors[key] = value;
    }
    for pair in CODE_COLORS() {
        if !colors.has(pair[0]) {
            let token = tokens[COLORS][pair[1]];
            if token != nil {
                colors[pair[0]] = token;
            }
        }
    }
    doc[COLORS] = colors;
    doc
}

// Push the active theme into egui, the widget nodes and the 3D viewport.
pub fn apply(state: editor::State) {
    let tokens = state.theme;
    let doc = worn(tokens);
    ui::set_theme(doc);
    // The document itself, inline, on each root: one table both readers take,
    // so a role a script names and a role a node names cannot drift.
    for path in ROOTS() {
        let root = scene::get_node(path);
        if root.is_valid() {
            // A table, so no `str` the property's type could write.
            let inline: any = { project_fields::THEME: doc };
            root.patch_component(components::WIDGET, inline);
        }
    }
    let background = util::hex_to_rgb(tokens["bg_app"].as_str());
    render::set_background(background.red, background.green, background.blue);
}

/// Wear the named pair, in the half the mode and the system pick. The same
/// pair and half again is a no-op, so an unrelated setting written while a
/// theme is being edited does not throw the edit away.
pub fn use_named(state: &mut editor::State, name: str) {
    wear_half(state, name, half_for(state, engine::dark_mode()).as_str());
}

fn wear_half(state: &mut editor::State, name: str, half: str) {
    if state.theme[fields::NAME].as_str() == name && state.theme[layout_fields::HALF].as_str() == half {
        return;
    }
    state.theme = load(name, half);
    state.theme_revision += 1;
    signals::outline(state);
    apply(state);
}

/// The system turned dark or light: the worn pair follows under `system`.
pub fn follow(state: &mut editor::State, system_dark: bool) {
    wear_half(state, state.theme[fields::NAME].as_str(), half_for(state, system_dark).as_str());
}

/// Read the worn half from disk again, dropping an edit nobody saved.
pub fn reload(state: &mut editor::State) {
    state.theme = load(state.theme[fields::NAME].as_str(), state.theme[layout_fields::HALF].as_str());
    state.theme_revision += 1;
    signals::outline(state);
    apply(state);
}

/// Wear a document that is not on disk yet: the theme window's live edit.
pub fn wear(state: &mut editor::State, name: str, doc: any) {
    state.theme = flat(name, state.theme[layout_fields::HALF].as_str(), doc);
    state.theme_revision += 1;
    signals::outline(state);
    apply(state);
}

// `on`, not `dark`: that name would shadow `dark()`. Pins the half for the run and leaves the person's setting alone.
pub fn set_dark(state: &mut editor::State, on: bool) {
    state.theme_half = if on { theme_modes::DARK } else { theme_modes::LIGHT };
    wear_half(state, state.theme[fields::NAME].as_str(), state.theme_half);
}

/// The person flipping to the other half: remembered as the mode, so the
/// settings screen shows it and the next start opens in it.
pub fn toggle(state: &mut editor::State) {
    let half = if state.theme[layout_fields::HALF].as_str() == theme_modes::DARK { theme_modes::LIGHT } else { theme_modes::DARK };
    settings::set(MODE_SETTING, half);
    settings::commit_preferences(state);
    state.theme_half = "";
    wear_half(state, state.theme[fields::NAME].as_str(), half);
}
