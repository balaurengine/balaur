// The type scale and the sizes a theme states, as the scripts that size a
// node read them.

use crate::util;

/// The type scale, in design pixels. Four steps and no others: a call site
/// that wants a size names one of these, and everything else takes the size
/// its `role` carries.
///
/// `SM` is a caption or a dense secondary line, `MD` is body text and every
/// control's label, `LG` is a glyph standing on its own, and `XL` is the one
/// title a panel gets.
pub const SM = 11.0;
pub const MD = 12.0;
pub const LG = 14.0;
pub const XL = 17.0;

/// A role's stated size as the theme file gives it: the touch table's where
/// a finger drives the screen and the role has one, else the role's own.
pub fn role_px(S, role, key, fallback) {
    let table = match S.theme.roles.get(role) {
        Some(table) => table,
        None => return fallback,
    };
    if S.touchscreen {
        if let Some(touch) = table.get("touch") {
            if let Some(v) = touch.get(key) {
                return px(S, v);
            }
        }
    }
    match table.get(key) {
        Some(v) => px(S, v),
        None => fallback,
    }
}

/// A number a theme states, or the size it names: `"control_height"` is
/// whatever the worn theme makes of it.
pub fn px(S, value) {
    if value is String {
        util::f(S.theme.sizes.get(value).unwrap_or(0.0))
    } else {
        util::f(value)
    }
}

/// A form row, and the field or search box in one: the theme's touch box
/// where a finger picks it, a cursor's line otherwise.
pub fn row_h(S) {
    if S.touchscreen { crate::shell::TOUCH_CONTROL } else { 24.0 }
}
