// The recurring widget option objects, as one definition each. A theme change
// is then one edit, and `util::merge` covers the per-call overrides Rune has
// no spread syntax for.

/// A mono label at the editor's default size, in `color`.
pub fn mono(color) {
    #{ size: 11.5, font: "mono", color: color }
}

/// One step down, for dense rows.
pub fn mono_sm(color) {
    #{ size: 11, font: "mono", color: color }
}

/// One step up, for a value that carries the row.
pub fn mono_lg(color) {
    #{ size: 12, font: "mono", color: color }
}

/// A panel section heading: small, strong, and drawn upper case by the caller.
pub fn heading(k) {
    #{ size: 10, font: "heading", strong: true, color: k.dim }
}

/// A mono text field of `width`: the inspector's editable value row.
pub fn field(k, width) {
    #{
        size: 11.5, font: "mono", width: width, height: 28,
        fill: k.sunken, stroke: k.line_soft, color: k.text,
    }
}
