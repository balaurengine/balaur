// The recurring widget option objects, as one definition each. A theme change
// is then one edit, and `util::merge` covers the per-call overrides Rune has
// no spread syntax for.

/// A mono label, in `color`. Size and family come from the theme.
pub fn mono(color) {
    #{ role: "mono", color: color }
}

/// One step down, for dense rows.
pub fn mono_sm(color) {
    #{ role: "meta", color: color }
}

/// One step up, for a value that carries the row.
pub fn mono_lg(color) {
    #{ role: "code", color: color }
}

/// A panel section heading; the caller draws it upper case.
pub fn heading(k) {
    #{ role: "heading" }
}

/// A mono text field of `width`: the inspector's editable value row.
pub fn field(k, width) {
    #{ role: "field", width: width }
}

/// Whether a rect is one a surface may draw at. A zero rect is the frame
/// before the widget layer has placed its box, and `ui::overlay` reads an
/// unsized area as unconstrained — which piles every sheet into the corner.
pub fn placed(r) {
    r.w > 0.0 && r.h > 0.0
}

/// A floating panel: Stage's one surface. `r` is a rect from `layout`, and
/// the body draws inside it.
pub fn sheet(k, id, r, pad_x, pad_y, cb) {
    if !placed(r) {
        return;
    }
    ui::overlay(id, #{
        role: "sheet", x: r.x, y: r.y, w: r.w, h: r.h,
        padding_x: pad_x, padding_y: pad_y,
    }, cb);
}

/// A bar is a sheet that hugs its row. Same corner as every other surface:
/// one radius across the shell, not a capsule here and a tile there.
pub fn bar(k, id, r, pad_x, cb) {
    if !placed(r) {
        return;
    }
    ui::overlay(id, #{
        role: "sheet", x: r.x, y: r.y, w: r.w, h: r.h, padding_x: pad_x,
    }, cb);
}

/// A section label: the shell's one way of naming a group of rows.
pub fn section_label(k, title) {
    ui::add_space(11);
    ui::horizontal(#{ height: 15 }, || {
        ui::add_space(2);
        ui::label(title.to_uppercase(), #{ role: "heading" });
    });
    ui::add_space(5);
}

/// A full-width row tile: the shape a list uses everywhere in the shell.
pub fn list_row(k, height) {
    #{ role: "list_item", height: height, min_width: ui::available_width() }
}

/// What a panel says when it has nothing: one line, centred, quiet.
pub fn empty(k, text) {
    ui::add_space(14);
    ui::horizontal(#{ height: 20 }, || {
        ui::add_space(10);
        ui::label(text, mono_sm(k.faint));
    });
}

/// A hook the engine calls, as the shell's one pill: a dot coloured by
/// `hook`, the `label` the surface wants, and what it answers to. `trailing`
/// is "" where nothing does.
pub fn hook_pill(k, hook, label, trailing) {
    let lifecycle = hook == "init" || hook == "update";
    ui::horizontal(#{ height: 30 }, || {
        ui::add_space(8);
        ui::frame(#{ fill: k.sunken, radius: 15, padding_x: 11 }, || {
            ui::horizontal(#{ height: 30 }, || {
                ui::dot(if lifecycle { k.accent } else { k.sage }, 6);
                ui::add_space(4);
                ui::label(label, mono(k.text));
                if trailing != "" {
                    ui::right(|| {
                        ui::label(trailing, mono_sm(k.faint));
                    });
                }
            });
        });
    });
}
