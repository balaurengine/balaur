// What is wrong with the project: every script a scene attaches, compiled
// through the host, plus the scene itself. A finding is `{ file, line,
// column, severity, message }`, `file` game-relative and line 0 the file.

use editor;
use model;
use shell;
use signals;
use util;

pub class LintState {
    internal found: [any],
    internal at: float,
    due: float,
    roots: str,
    warned: any,
    /// The scene changed since its warnings were asked of the engine.
    internal stale: bool,
}

pub struct Finding {
    file: str,
    line: int,
    column: int,
    severity: str,
    message: str,
}

pub struct Counts {
    internal errors: int,
    internal warnings: int,
}

/// The module's own slice of `state`, at `state.lint`.
///
/// `at` is when the last sweep ran and `typed` when the buffer last changed,
/// which is what `due` compares to hold a check off until typing stops.
pub fn state() -> LintState {
    LintState { found: [], at: -1.0, due: 0.0, roots: "", warned: {}, stale: true }
}

const IDLE: float = 0.4;

/// Every distinct script the document attaches, game-relative.
///
/// The unit a check compiles is the root, not the file: a `mod` submodule
/// compiled on its own fails on its own imports, and its diagnostics reach us
/// through the root that reaches it.
fn roots(state: editor::State) -> [any] {
    let seen: any = {};
    let out: [any] = [];
    for found in state.nodes {
        let rel = model::script_rel(found);
        if rel != nil {
            if !seen.has(rel.as_str()) {
                seen[rel.as_str()] = true;
                out.push(rel);
            }
        } else {
            nil
        }
    }
    out
}

// The text to check: the unsaved buffer when there is one, so a finding is
// about what is on screen rather than what is on disk.
fn source_of(state: &mut editor::State, rel: str) -> any {
    let buffer = state.script_buffers[state.game_root + "/" + rel];
    if buffer != nil {
        buffer
    } else {
        model::source(state, rel)
    }
}

// A reference is a path, a path with `#entry`, or `#inline`; only the first
// two name a file, and an inline definition is a table, not a string.
fn asset_missing(state: editor::State, value: str) -> bool {
    if value == "" || value.starts_with("#") {
        return false;
    }
    let parts = value.split_once("#");
    let path = if parts.len() == 2 { parts[0] } else { value };
    // The mirror hands back the absolute path the engine resolved to and a
    // scene writes a relative one; Windows spells absolute differently.
    !fs::exists(path) && !fs::exists(state.game_root + "/" + path)
}

fn at(file: str, line: int, severity: str, message: str) -> Finding {
    Finding { file: file, line: line, column: 0, severity: severity, message: message }
}

// The scene: files its nodes name, asset references that do not resolve, and
// the expectations the engine already computes per node.
fn scene_findings(state: &mut editor::State) -> [Finding] {
    let found: [Finding] = [];
    let scene = state.scene_rel;
    for found_node in state.nodes {
        if !found_node.is_valid() {
            continue;
        }
        let name = found_node.name();
        let rel = model::script_rel(found_node);
        if rel != nil && !fs::exists(state.game_root + "/" + rel.as_str()) {
            found.push(at(scene, 0, "error", "{name}: script {rel} does not exist"));
        }
        let prefab = found_node.instance();
        if prefab != nil && !fs::exists(state.game_root + "/" + prefab.unwrap()) {
            found.push(at(scene, 0, "error", "{name}: prefab {prefab.unwrap()} does not exist"));
        }
        for warning in util::list_or_empty(scene::warnings(found_node)) {
            found.push(at(scene, 0, "warning", "{name}: {describe(warning)}"));
        }
        for component in found_node.component_names() {
            let schema = model::schema(state, component);
            let data = util::map_or_empty(found_node.get_component(component));
            for property in util::keys_sorted(schema) {
                let spec = schema[property];
                if spec["type"].as_str() == "variant" {
                    // A variant's assets are its kind's: a collider's mesh.
                    let held = util::map_or_empty(data[property]);
                    let fields = util::map_or_empty(util::map_or_empty(spec["variants"][held["kind"].as_str()])["fields"]);
                    for field in util::keys_sorted(fields) {
                        check_asset(state, scene, "{name}: {component}.{property}.{field}", fields[field], held[field], found);
                    }
                } else {
                    check_asset(state, scene, "{name}: {component}.{property}", spec, data[property], found);
                }
            }
        }
    }
    found
}

// One asset row: a file it names that is not there, and a material that does
// not link.
fn check_asset(state: editor::State, scene: str, label: str, spec: any, held: any, found: [Finding]) {
    if spec["type"].as_str() != "asset" {
        return;
    }
    let value = held.as_str();
    if held.kind() != "str" || value == "" {
        return;
    }
    if asset_missing(state, value) {
        found.push(at(scene, 0, "warning", "{label} → {value} does not exist"));
        return;
    }
    // A material parses headless and links only when something draws it, so
    // a broken shader has to be asked about.
    if spec["asset"].as_str() == "material" && !value.starts_with("#") {
        for finding in util::list_or_empty(render::check_material(value)) {
            found.push(at(finding["file"].as_str(), finding["line"].as_int(), finding["severity"].as_str(), "{label}: {finding["message"]}"));
        }
    }
}

/// One engine warning as a line: the component, the property when it names
/// one, and what is off.
pub fn describe(warning: any) -> str {
    if util::is_nil(warning["property"]) {
        "{warning["component"]}: {warning["message"]}"
    } else {
        "{warning["component"]}.{warning["property"]}: {warning["message"]}"
    }
}

/// Every node's warnings by id, for the tree's mark and the counts. Asked of
/// the engine on the outline's word, which is heard the frame after an edit,
/// once the solver has built what the edit made; and when a file reloaded or
/// play started or stopped.
pub fn node_warnings(state: &mut editor::State) {
    state.lint.stale = false;
    let out: any = {};
    for live in state.nodes {
        if live.is_valid() {
            let found = util::list_or_empty(scene::warnings(live));
            if found.len() > 0 {
                out[live.stable_id()] = found;
            }
        }
    }
    // Asked again every few frames: only a different answer is news.
    if out != state.lint.warned {
        state.lint.warned = out;
        signals::outline(state);
    }
}

/// The warnings the last ask found on the node with `id`.
pub fn warned(state: editor::State, id: any) -> any {
    let held = state.lint.warned[id.as_str()];
    util::list_or_empty(if held == nil { [] } else { held })
}

/// Check every root and the scene, and replace the finding list.
pub fn run(state: &mut editor::State) {
    let found: [any] = [];
    for rel in roots(state) {
        let source_text = source_of(state, rel.as_str());
        if source_text == nil {
            found.push(at(state.scene_rel, 0, "error", "missing file: {rel}"));
            continue;
        }
        for finding in util::list_or_empty(script::check(state.game_root + "/" + rel.as_str(), source_text.as_str())) {
            // The host answers in the key it was given, which is absolute.
            found.push(at(shell::script_rel(state, finding["file"].as_str()), finding["line"].as_int(), finding["severity"].as_str(), finding["message"].as_str()));
        }
    }
    for finding in scene_findings(state) {
        found.push(finding);
    }
    state.lint.found = found;
    signals::docks(state);
    signals::changed(state, "problems");
    state.lint.at = engine::unix_time();
}

// What the next sweep would look at, so an unchanged project is not swept.
/// The project's scripts moved: a buffer typed into, a file reloaded, a
/// script attached or taken off. The sweep runs once that has been still for
/// `IDLE`: a check is a compile on the frame thread, tens of milliseconds for
/// a large file, so it waits out a burst of keystrokes rather than running
/// inside one.
pub fn touched(state: &mut editor::State) {
    state.lint.due = engine::unix_time() + IDLE;
    // The frame the sweep runs in: under `low_processor` nothing else draws one.
    ui::request_repaint(ui::RepaintOptions { after: IDLE + 0.02 });
}

/// The document moved: when the scripts it attaches did, the sweep runs on
/// the new set.
pub fn follow(state: &mut editor::State) {
    let key = util::join(roots(state), "|");
    if key != state.lint.roots {
        state.lint.roots = key;
        touched(state);
    }
}

/// Run the sweep the last touch asked for, once its time has come.
pub fn idle(state: &mut editor::State) {
    if state.lint.due <= 0.0 || engine::unix_time() < state.lint.due {
        return;
    }
    state.lint.due = 0.0;
    run(state);
}

/// The lines of one file carrying a finding of `severity`, for the gutter.
pub fn lines(state: editor::State, rel: str, severity: str) -> [any] {
    let out: [any] = [];
    for finding in state.lint.found {
        if finding["file"].as_str() == rel && finding["severity"].as_str() == severity && finding["line"].as_int() > 0 {
            out.push(finding["line"]);
        }
    }
    out
}

/// `(errors, warnings)` over the whole project.
pub fn counts(state: editor::State) -> Counts {
    let errors = 0;
    let warnings = 0;
    for finding in state.lint.found {
        if finding["severity"].as_str() == "error" {
            errors += 1;
        } else {
            warnings += 1;
        }
    }
    Counts { errors: errors, warnings: warnings }
}
