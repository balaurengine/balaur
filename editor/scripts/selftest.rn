// Start-up states that exercise the editor and assert the result. `log::error`
// is the failure channel: `scripts/e2e.sh` fails any run that logs one.

use crate::anim;
use crate::dock;
use crate::history;
use crate::lint;
use crate::model;
use crate::polygon;
use crate::rig;
use crate::shell;
use crate::style;
use crate::theme;
use crate::util;

fn check(ok, what) {
    if ok {
        log::info(format!("selftest ok: {}", what));
    } else {
        log::error(format!("selftest FAILED: {}", what));
    }
    ok
}

// Every document node must resolve to a live node — the invariant e2e already
// checks at start-up, asserted here after each mutation instead.
fn mirror_resolves(S) {
    for i in 0..S.doc.len() {
        if model::live(S, i).is_none() {
            return false;
        }
    }
    true
}

fn name_at(S, i) {
    match S.doc.get(i) {
        Some(node) => node.name,
        None => "<none>",
    }
}

fn undo_all(S) {
    let guard = 0;
    while history::can_undo(S) && guard < 200 {
        shell::undo(S);
        guard += 1;
    }
}

// The first writable float on any component of the selection, so the test
// exercises `set_component_prop` on whatever the scene actually has.
fn writable_float(S, found) {
    for comp in found.component_names() {
        let schema = model::schema(S, comp);
        for prop in util::keys_sorted(schema) {
            let spec = schema[prop];
            if spec["type"] == "float" && spec.get("readonly").unwrap_or(false) != true {
                return Some((comp, prop, spec));
            }
        }
    }
    None
}

fn float_prop(found, comp, prop) {
    match util::obj(found.get_component(comp)).get(prop) {
        Some(v) => Some(util::f(v)),
        None => None,
    }
}

pub fn component_write(S) {
    let found = match model::live(S, S.sel) {
        Some(found) => found,
        None => return,
    };
    let (comp, prop, spec) = match writable_float(S, found) {
        Some(hit) => hit,
        None => {
            log::info("selftest: the selection has no writable float; skipped");
            return;
        }
    };
    let was = match float_prop(found, comp, prop) {
        Some(v) => v,
        None => util::f(spec.get("default").unwrap_or(0.0)),
    };
    model::set_component_prop(S, comp, prop, was + 3.0);
    let now = float_prop(model::live(S, S.sel).unwrap(), comp, prop).unwrap_or(-1.0);
    check(util::abs(now - (was + 3.0)) < 1e-6, format!("{}.{} took the write ({})", comp, prop, now));
    shell::undo(S);
    let back = float_prop(model::live(S, S.sel).unwrap(), comp, prop).unwrap_or(-1.0);
    check(util::abs(back - was) < 1e-6, format!("undo restores {}.{} ({} vs {})", comp, prop, back, was));
}

// Mutate, undo, redo; assert the document, the mirror and the selection all
// come back. Runs headless, so it is CI's only view of the editor's Rune.
pub fn undo(S) {
    let start = S.doc.len();
    check(history::dirty(S) == false, "a freshly loaded scene is clean");
    check(history::can_undo(S) == false, "nothing to undo on load");

    // Duplicate: the case that used to leave a node with no live node at all.
    for (i, node) in S.doc.iter().enumerate() {
        if node.name == "Bird" {
            shell::choose(S, i);
        }
    }
    let picked = name_at(S, S.sel);
    model::duplicate_selected(S);
    check(S.doc.len() == start + 1, format!("duplicate adds a node ({})", S.doc.len()));
    check(mirror_resolves(S), "duplicate resolves every node in the mirror");
    check(history::dirty(S), "duplicating marks the scene dirty");
    let copy = name_at(S, S.sel);

    shell::undo(S);
    check(S.doc.len() == start, format!("undo removes it again ({})", S.doc.len()));
    check(mirror_resolves(S), "undo resolves every node in the mirror");
    check(name_at(S, S.sel) == picked, format!("undo restores the selection ({})", name_at(S, S.sel)));
    check(history::dirty(S) == false, "undo back to the load point is clean");

    shell::redo(S);
    check(S.doc.len() == start + 1, format!("redo adds it back ({})", S.doc.len()));
    check(name_at(S, S.sel) == copy, format!("redo restores the selection ({})", name_at(S, S.sel)));
    check(mirror_resolves(S), "redo resolves every node in the mirror");

    // Delete: the destructive one, and the one that moves the selection.
    let before_delete = S.doc.len();
    model::delete_selected(S);
    check(S.doc.len() == before_delete - 1, format!("delete removes a node ({})", S.doc.len()));
    shell::undo(S);
    check(S.doc.len() == before_delete, format!("undo restores the deleted node ({})", S.doc.len()));
    check(mirror_resolves(S), "the restored node resolves in the mirror");

    // A transform write, the way the inspector's vector rows make one.
    let (_, found) = model::selected(S);
    let found_some = found;
    if let Some(found) = found_some {
        let p = found.position();
        history::record(S, "move node", Some("selftest:move"));
        history::commit(S);
        model::set_transform(S, S.sel, #{ position: [p.x + 5.0, p.y, p.z] });
        shell::undo(S);
        let restored = util::vec3(model::selected_node(S).get("position").unwrap_or(()), [0.0, 0.0, 0.0]);
        check(util::abs(restored[0] - p.x) < 1e-6, format!("undo restores the position ({} vs {})", restored[0], p.x));
    }

    // A component property, discovered rather than named: every scene has
    // different components, and a 3D one has no `shape2d` to write to.
    component_write(S);

    // The stack is finite and ordered: undo everything, then nothing is left.
    undo_all(S);
    check(S.doc.len() == start, format!("undoing everything returns the original scene ({})", S.doc.len()));
    check(history::dirty(S) == false, "the fully-undone scene is clean again");
    check(mirror_resolves(S), "the fully-undone scene resolves in the mirror");
    log::info("selftest undo: done");
}

// Grow a bone, round-trip the rest pose, key the bone on its player's clip
// by path, then undo it all. Skips scenes with no rig.
pub fn rigging(S) {
    let first = None;
    for (i, node) in S.doc.iter().enumerate() {
        if rig::is_bone(node) {
            first = Some(i);
            break;
        }
    }
    let first = match first {
        Some(first) => first,
        None => {
            log::info("selftest rig: no bones; skipped");
            return;
        }
    };
    let start = S.doc.len();
    shell::choose(S, first);
    let bone_name = name_at(S, first);

    let added = rig::add_bone(S, first, 1.0, 2.0);
    check(added.is_some() && S.doc.len() == start + 1, format!("rig bone adds a node ({})", S.doc.len()));
    check(mirror_resolves(S), "the new bone resolves in the mirror");
    check(rig::is_bone(S.doc[S.doc.len() - 1]), "the new node carries a bone component");
    check(S.doc[S.doc.len() - 1].parent == S.doc[first].id, format!("the new bone hangs under {}", bone_name));

    // Rest round trip: record the pose, move, reset, and it is back.
    shell::choose(S, first);
    let found = model::live(S, first).unwrap();
    let p = found.position();
    rig::overwrite_rest(S);
    found.set_position(p.x + 1.0, p.y, p.z);
    rig::apply_rest(S);
    let bx = model::live(S, first).unwrap().position().x;
    check(util::abs(bx - p.x) < 1e-5, format!("reset to rest pose puts {} back ({} vs {})", bone_name, bx, p.x));
    let doc_pos = util::vec3(S.doc[first].get("position").unwrap_or(()), [0.0, 0.0, 0.0]);
    check(util::abs(doc_pos[0] - p.x) < 1e-5, "the document follows the reset");

    // Keying a bone lands on the player above it, addressed by path.
    let player_i = anim::player_index(S);
    let target = anim::target_path(S, player_i);
    anim::add_key(S, 0.0);
    let found_rotation = false;
    let positioned = false;
    if let Some(def) = anim::definition(S) {
        for track in anim::tracks(def) {
            if track.get("target").unwrap_or("") == target {
                found_rotation = found_rotation || track.get("property") == Some("rotation_euler");
                positioned = positioned || track.get("property") == Some("position");
            }
        }
    }
    check(found_rotation, format!("keying {} writes a rotation track at '{}'", bone_name, target));
    check(!positioned, "a bone keys no position track");

    undo_all(S);
    check(S.doc.len() == start, format!("undoing everything returns the original scene ({})", S.doc.len()));
    check(mirror_resolves(S), "the fully-undone scene resolves in the mirror");
    log::info("selftest rig: done");
}

// Trace a vertex onto a polygon, sync its bones from the rig, paint one,
// draw a polygon, remove a vertex, then undo it all. Skips scenes with no
// inline polygon.
pub fn polygons(S) {
    let picked = None;
    for (i, node) in S.doc.iter().enumerate() {
        if let Some(comp) = polygon::component(node) {
            if comp.get("mesh").unwrap_or(()) is Object {
                picked = Some(i);
                break;
            }
        }
    }
    let picked = match picked {
        Some(picked) => picked,
        None => {
            log::info("selftest polygon: no inline polygon; skipped");
            return;
        }
    };
    shell::choose(S, picked);
    let name = name_at(S, picked);
    let mesh = polygon::mesh(S).unwrap();
    let vertices = mesh.positions.len();
    let internal = polygon::internal_count(mesh);

    let at = polygon::add_vertex(S, 3.0, 3.0, false).unwrap_or(-1);
    check(at == vertices - internal, format!("an outline vertex goes after the last outline one ({})", at));
    check(polygon::mesh(S).unwrap().positions.len() == vertices + 1, "add vertex grows the mesh");
    let live = model::live(S, picked).unwrap().get_component("polygon");
    let inline = live is Object && live.get("mesh").unwrap_or("") is String && live.mesh.starts_with("#!");
    check(inline, "the live polygon re-read its inline mesh");

    polygon::sync_bones(S);
    let bones = polygon::bones(S);
    check(bones.len() > 0, format!("sync bones lists the rig's bones ({})", bones.len()));
    check(bones.len() == 0 || util::vec(bones[0].get("weights").unwrap_or([])).len() == vertices + 1, "every bone has one weight per vertex");
    if bones.len() > 0 {
        S.polygon.bone = Some(0);
        polygon::paint(S, at, 1.0);
        check(util::f(bones[0].weights[at]) == 1.0, "painting sets the vertex's weight");
    }

    let internal_at = polygon::add_vertex(S, 0.1, 0.1, true).unwrap_or(-1);
    check(polygon::internal_count(polygon::mesh(S).unwrap()) == internal + 1, "an alt-click adds an internal vertex");
    S.polygon.chain = Some([0, 1, internal_at]);
    polygon::close_loop(S);
    let polygons = util::vec(polygon::mesh(S).unwrap().get("polygons").unwrap_or([]));
    check(polygons.len() >= 1, format!("closing a loop draws a polygon ({})", polygons.len()));

    polygon::remove_vertex(S, at);
    check(polygon::mesh(S).unwrap().positions.len() == vertices + 1, "removing the traced vertex shrinks the mesh");
    check(mirror_resolves(S), "the polygon node still resolves");

    undo_all(S);
    let back = polygon::mesh(S).unwrap();
    check(back.positions.len() == vertices, format!("undoing everything restores {}'s vertices ({})", name, back.positions.len()));
    check(polygon::internal_count(back) == internal, "and its internal count");
    log::info("selftest polygon: done");
}

/// Copy and paste, which the shell drives from a clipboard event no headless
/// run can raise: the two document verbs behind it, asserted directly.
pub fn clipboard(S) {
    let before = S.doc.len();
    let name = model::selected_node(S).name;
    let text = model::copy_selected(S);
    check(text.starts_with("[[nodes]]"), "a copied node encodes as a scene document");
    check(!text.contains("id = "), "the copy carries no id for the paste to collide with");

    check(model::paste_nodes(S, text), "pasting a copied node is accepted");
    check(S.doc.len() == before + 1, format!("the paste added one node ({})", S.doc.len()));
    check(model::selected_node(S).name != name, "the pasted node was renamed");
    check(mirror_resolves(S), "the pasted node resolves in the mirror");

    check(!model::paste_nodes(S, "not a scene at all"), "text that is not a scene is left alone");
    check(S.doc.len() == before + 1, "and adds nothing");

    undo_all(S);
    check(S.doc.len() == before, format!("undo takes the paste back ({})", S.doc.len()));
    check(mirror_resolves(S), "the undone scene resolves in the mirror");
    log::info("selftest clipboard: done");
}

/// The Assets dock's three verbs. Everything it makes it also removes, so a
/// run leaves the example project exactly as it found it.
pub fn assets(S) {
    let root = S.game_root + "/";
    S.assets.dir = "";
    S.assets.sel = "";

    dock::new_folder(S);
    let made = S.assets.sel;
    check(made == "new-folder", format!("a new folder is named for what it is ({})", made));
    check(fs::exists(root + made), "the new folder is on disk");

    // A second one cannot take the same name.
    dock::new_folder(S);
    let second = S.assets.sel;
    check(second != made, format!("a second folder gets its own name ({})", second));

    S.assets.sel = made;
    dock::rename_asset(S, "renamed-folder");
    check(!fs::exists(root + made), "the old name is gone");
    check(fs::exists(root + "renamed-folder"), "the new name is there");
    check(S.assets.sel == "renamed-folder", "the selection followed the rename");

    dock::rename_asset(S, "with/slash");
    check(fs::exists(root + "renamed-folder"), "a name with a slash is refused");

    dock::delete_asset(S);
    check(!fs::exists(root + "renamed-folder"), "delete removes it");
    check(S.assets.sel == "", "and clears the selection");

    S.assets.sel = second;
    dock::delete_asset(S);
    check(!fs::exists(root + second), "the second folder is cleaned up too");
    log::info("selftest assets: done");
}

/// Picking, aimed by hand. The viewport snapshot a real click reads is empty
/// without a window, which is why `render::pick_ray` takes the ray: a
/// headless run can still aim one and say what it met.
pub fn picking(S) {
    let target = None;
    for i in 0..S.doc.len() {
        if let Some(found) = model::live(S, i) {
            let (kind, _, _, _) = render::shape3d(found);
            if kind != "" && kind != "mesh" {
                target = Some(i);
                break;
            }
        }
    }
    let target_some = target;
    let i = match target_some {
        Some(i) => i,
        None => {
            log::info("selftest picking: no node with a 3D shape, skipped");
            return;
        }
    };
    let found = model::live(S, i).unwrap();
    let p = found.global_position();
    let name = S.doc[i].name;

    // Straight down -z at it from well outside anything.
    let hit = render::pick_ray(p.x, p.y, p.z + 200.0, 0.0, 0.0, -1.0);
    if check(hit is balaur::Node, format!("a ray aimed at '{}' meets a node", name)) {
        check(model::index_of_live(S, hit).is_some(), "and it is one of the document's");
    }

    // The same ray pointing away meets nothing.
    let behind = render::pick_ray(p.x, p.y, p.z + 200.0, 0.0, 0.0, 1.0);
    check(util::is_nil(behind), "a ray pointing away from the scene picks nothing");

    // Far to the side, past anything the scene contains.
    let aside = render::pick_ray(p.x + 10000.0, p.y, p.z + 200.0, 0.0, 0.0, -1.0);
    check(util::is_nil(aside), "a ray beside the scene picks nothing");
    log::info("selftest picking: done");
}

// The first numeric export in the scene, with the node carrying it. A number
// is what the drag editors write; a string or a bool would be asserting a
// different widget, which is its own test.
fn first_number_export(S) {
    for (i, node) in S.doc.iter().enumerate() {
        if let Some(rel) = model::script_rel(node) {
            for export in model::exports(S, rel) {
                if export["type"] == "float" || export["type"] == "int" {
                    return Some((i, export));
                }
            }
        }
    }
    None
}

// Exported script properties: what the script declares, what the node
// overrides, and the sparseness that keeps a default reaching every node that
// left it alone.
pub fn script_props(S) {
    let found = first_number_export(S);
    let (i, export) = match found {
        Some(hit) => hit,
        None => {
            log::info("selftest props: no script in this scene exports a number, skipped");
            return;
        }
    };
    shell::choose(S, i);
    let rel = model::script_rel(S.doc[i]).unwrap();
    let name = export.name;
    check(export.contains_key("type"), format!("{} declares a type for {}", rel, name));
    let was = util::f(export["default"]);
    model::set_script_prop(S, name, was + 5.0);
    let props = model::script_props(S.doc[i]);
    check(props.contains_key(name), format!("{} became an override on the node", name));
    check(util::abs(util::f(props[name]) - (was + 5.0)) < 1e-6,
        format!("{} holds the written value ({})", name, props.get(name).unwrap_or(())));

    // Back to the default: the override is dropped rather than written out,
    // so a later change to the script's default reaches this node again.
    model::set_script_prop(S, name, was);
    check(!model::script_props(S.doc[i]).contains_key(name),
        format!("{} back at its default stops being an override", name));

    shell::undo(S);
    check(model::script_props(S.doc[i]).contains_key(name),
        "undo brings the override back");
    check(mirror_resolves(S), "the mirror still resolves after editing properties");
    log::info("selftest props: done");
}

// The first script the scene attaches, which is what a lint sweep starts from.
fn first_script(S) {
    for node in S.doc {
        match model::script_rel(node) {
            Some(rel) => return Some(rel),
            None => (),
        }
    }
    None
}

fn found_in(S, rel, severity) {
    let out = [];
    for f in S.lint.found {
        if f.file == rel && f.severity == severity {
            out.push(f);
        }
    }
    out
}

/// `--state lintdemo`: a broken buffer is found at the line it broke on, and
/// a good one leaves nothing behind. The buffer, not the file — a check is
/// about what is on screen, and the test must not write a broken script out.
pub fn linting(S) {
    let script = first_script(S);
    if !check(script.is_some(), "the scene attaches a script to lint") {
        return;
    }
    let rel = script.unwrap();
    let abs = S.game_root + "/" + rel;
    let original = model::source(S, rel).unwrap_or("");

    S.script_buffers[abs] = "pub fn init(this) {\n    input::just_pressd(\"jump\");\n}\n";
    lint::run(S);
    let errors = found_in(S, rel, "error");
    if check(errors.len() > 0, "a misspelled engine call is an error") {
        check(errors[0].line == 2, format!("the error's line is 2 (got {})", errors[0].line));
        check(errors[0].message.contains("just_pressd"),
            format!("the message names the call: {}", errors[0].message));
        let marked = false;
        for line in lint::lines(S, rel, "error") {
            if line == 2 {
                marked = true;
            }
        }
        check(marked, "the gutter is given line 2");
    }

    // Rune's own warnings ride along with the same call.
    S.script_buffers[abs] = "pub fn init(this) {\n    let unused = 1;\n}\n";
    lint::run(S);
    check(found_in(S, rel, "error").len() == 0, "a script that compiles has no errors");

    S.script_buffers[abs] = original;
    lint::run(S);
    check(found_in(S, rel, "error").len() == 0, "restoring the buffer clears the findings");
    S.script_buffers.remove(abs);
    crate::docks::show(S, "problems");
    log::info("selftest lint: done");
}

// Prefabs in the editor: an instance's nodes are in the tree, an edit inside
// one becomes an override and an edit back to the prefab's value stops being
// one. Which component it edits is discovered — headless registers no `color`.
pub fn instances(S) {
    let hit = first_instanced_float(S);
    let (i, comp, prop, spec) = match hit {
        Some(hit) => hit,
        None => {
            log::info("selftest instances: no instanced node with a writable float, skipped");
            return;
        }
    };
    let authored_before = model::authored(S.doc).len();
    check(authored_before < S.doc.len(), "the document holds rows the file does not");

    shell::choose(S, i);
    let node = S.doc[i];
    let owner = model::by_id(S.doc, node.owner).unwrap();
    let was = float_prop(model::live(S, i).unwrap(), comp, prop)
        .unwrap_or(util::f(spec.get("default").unwrap_or(0.0)));
    let entry_of = |owner, at| util::obj(util::obj(owner.get("overrides").unwrap_or(#{})).get(at).unwrap_or(#{}));
    check(!entry_of(owner, node.at).contains_key(comp),
        format!("{} starts with no override of {}", node.at, comp));

    model::set_component_prop(S, comp, prop, was + 3.0);
    let entry = entry_of(owner, node.at);
    check(entry.contains_key(comp),
        format!("editing {}.{} wrote an override on {}", node.at, prop, owner.name));
    // Sparse: the override holds the property that changed, not the whole
    // component, because the engine patches it over the prefab's.
    check(util::obj(entry[comp]).len() == 1,
        format!("and holds only {} ({} keys)", prop, util::obj(entry[comp]).len()));
    check(model::authored(S.doc).len() == authored_before,
        "and added no row to the file");

    // Back to the prefab's own value: the override has nothing left to say.
    model::set_component_prop(S, comp, prop, was);
    check(!entry_of(owner, node.at).contains_key(comp),
        format!("a {} back at the prefab's stops being an override", prop));

    // Structure is the prefab's.
    let before = S.doc.len();
    model::add_child(S, None);
    check(S.doc.len() == before, "adding a node inside an instance is refused");
    model::delete_selected(S);
    check(S.doc.len() == before, "deleting a node inside an instance is refused");

    check(mirror_resolves(S), "every row still resolves, instanced ones included");
    log::info("selftest instances: done");
}

// The first row that came from a prefab and has a float the editor can write.
fn first_instanced_float(S) {
    for (i, node) in S.doc.iter().enumerate() {
        if !model::is_instanced(node) {
            continue;
        }
        if let Some(found) = model::live(S, i) {
            if let Some((comp, prop, spec)) = writable_float(S, found) {
                return Some((i, comp, prop, spec));
            }
        }
    }
    None
}

// Recording a play session, replaying it, and getting back to the edited
// scene. Spread over frames because a recording is made of frames, and inside
// the `--frames 90` an e2e run allows.
const REC_UNTIL = 9;
const OPEN_AT = 10;
const CHECK_AT = 28;

// The centre must be showing the viewport when no document is open: a stray
// split used to leave a collapsed code pane over it in every persona.
pub fn layout(S) {
    S.layout_demo = 0;
}

pub fn layout_step(S) {
    S.layout_demo = S.layout_demo + 1;
    // The shell is laid out by the engine and read back a frame later, so
    // this waits for a rect rather than for a frame number. The count is the
    // fallback: a headless run never gets one, and still has to report.
    if S.layout.stage.w <= 0.0 && S.layout_demo < 10 {
        return;
    }
    S.layout_demo = -1;
    let m = S.layout;
    let stage = m.stage;
    // A headless run never draws, so the rect is still the one `init` set.
    if S.viewport.at == 0 {
        log::info("layoutdemo: skipped, nothing drew this run");
        return;
    }
    check(!S.split, "the split is off unless asked for");
    check(S.viewport_live, "the scene is showing");
    check(S.rail_visible, "and the tool rail with it");
    // Stage's invariants: the sheets tile the window without touching, and
    // what is left is the scene's.
    check(stage.x >= 0.0 && stage.y >= 0.0
        && stage.x + stage.w <= S.screen_w && stage.y + stage.h <= S.screen_h,
        "the stage is inside the window");
    check(stage.w > S.screen_w * 0.35 && stage.h > S.screen_h * 0.4,
        format!("the stage is most of the window ({} × {})", stage.w as i64, stage.h as i64));
    check(!overlapping(crate::layout::sheets(S)), "no two sheets overlap");
    check(!crate::layout::over_sheet(S, stage.x + stage.w / 2.0, stage.y + stage.h / 2.0),
        "the middle of the stage belongs to the scene");
    check(covered(S, crate::layout::sheets(S)), "and the middle of every sheet does not");
    check(S.viewport.w == stage.w && S.viewport.h == stage.h,
        "the widget layer gets the stage rect");
    // Every sheet is placed, or it is not drawn: a zero rect turns egui's own
    // area constraint back on and piles the shell into the corner.
    for (name, r) in [("persona bar", m.bar), ("command pill", m.cmd),
                      ("tree", m.left), ("inspector", m.right),
                      ("dock", m.bottom), ("status strip", m.status),
                      ("document tabs", m.tabs), ("tool rail", m.rail),
                      ("stage", stage)] {
        check(r.w > 0.0 && r.h > 0.0,
            format!("the {} is placed ({} × {})", name, r.w as i64, r.h as i64));
    }
    check(util::abs(m.left.w - m.tree_w) < 0.51,
        format!("the tree column is the width the scene asked for ({} vs {})", m.left.w, m.tree_w));
}

// Sheets may abut, never overlap: an overlap is a rect two owners believe in.
fn overlapping(rects) {
    for (i, a) in rects.iter().enumerate() {
        for j in (i + 1)..rects.len() {
            let b = rects[j];
            if a.w > 0.0 && a.h > 0.0 && b.w > 0.0 && b.h > 0.0
                && a.x < b.x + b.w && b.x < a.x + a.w
                && a.y < b.y + b.h && b.y < a.y + a.h {
                log::warn(format!("sheets overlap: {},{} {}x{} and {},{} {}x{}",
                    a.x as i64, a.y as i64, a.w as i64, a.h as i64,
                    b.x as i64, b.y as i64, b.w as i64, b.h as i64));
                return true;
            }
        }
    }
    false
}

fn covered(S, rects) {
    for r in rects {
        if r.w > 0.0 && r.h > 0.0
            && !crate::layout::over_sheet(S, r.x + r.w / 2.0, r.y + r.h / 2.0) {
            return false;
        }
    }
    true
}

// Tofu is the failure this catches: a row of boxes in the screenshot means
// the chain lost a script, and a missing icon means the font did not load.
pub fn font_sheet(S) {
    let k = S.theme;
    let r = S.layout.stage;
    ui::overlay("fontsheet", #{
        x: r.x, y: r.y, w: r.w, h: r.h,
        fill: k.panel, stroke: k.line, radius: 11, padding_x: 16, padding_y: 12,
    }, || {
        ui::label("FONT COVERAGE  ·  --state fontdemo", style::heading(k));
        ui::add_space(10);
        ui::label("SCRIPTS", style::heading(k));
        ui::add_space(6);
        for (name, sample) in scripts() {
            ui::horizontal(#{ height: 24 }, || {
                ui::horizontal(#{ height: 24, width: 92 }, || {
                    ui::label(name, style::mono_sm(k.faint));
                });
                ui::label(sample, #{ size: 15, color: k.text });
            });
        }
        ui::add_space(10);
        ui::label("FACES", style::heading(k));
        ui::add_space(6);
        ui::label("heading  Source Sans 3 Semibold", #{ size: 15, font: "heading", color: k.text });
        ui::label("ui  Source Sans 3 Regular", #{ size: 14, color: k.text });
        ui::label("mono  JetBrains Mono  0O1lI  ⌘⌥⇧⌃", style::mono(k.text));
        ui::add_space(10);
        ui::label("ICONS", style::heading(k));
        ui::add_space(6);
        ui::horizontal(#{ height: 26 }, || {
            ui::spacing(8, 0);
            for id in ["select", "move", "rotate", "scale", "zoom", "key", "bone", "polygon"] {
                ui::label(crate::icons::tool(id), #{ size: 16, color: k.text });
            }
            for id in ["scene", "script", "anim", "phys", "ui"] {
                ui::label(crate::icons::persona(id), #{ size: 16, color: k.accent });
            }
        });
        ui::horizontal(#{ height: 26 }, || {
            ui::spacing(8, 0);
            for id in ["output", "problems", "assets", "timeline", "debugger", "session", "profiler"] {
                ui::label(crate::icons::panel(id), #{ size: 16, color: k.text });
            }
            for id in ["add", "close", "minimise", "search", "dark", "play", "pause", "stop", "instance", "split"] {
                ui::label(crate::icons::ui(id), #{ size: 16, color: k.sage });
            }
        });
    });
}

fn scripts() {
    [
        ("latin", "Plataforma Ångström"),
        ("greek", "Διάστημα"),
        ("cyrillic", "Вращатель"),
        ("japanese", "ボール 平台"),
        ("korean", "플랫폼"),
        ("chinese", "平台 旋转"),
        ("arabic", "لوحة"),
        ("hebrew", "פלטפורמה"),
        ("devanagari", "मंच"),
        ("thai", "แพลตฟอร์ม"),
    ]
}

pub fn sessions(S) {
    S.session.demo = #{ n: 0, file: "", was: 0 };
    // With digests, so the replay is actually checked against the recording
    // rather than merely running.
    S.session.verify = true;
    shell::toggle_play(S);
    check(S.session.recording != "", "play starts recording the session");
    check(S.playing, "and the scene is running");
}

pub fn session_step(S) {
    let d = S.session.demo;
    d.n = d.n + 1;
    if d.n == REC_UNTIL {
        stop_and_check(S, d);
    } else if d.n == OPEN_AT {
        open_and_check(S, d);
    } else if d.n == CHECK_AT {
        replayed_and_check(S, d);
    }
}

// Stopping closes the file. What it wrote is the session the dock lists.
fn stop_and_check(S, d) {
    shell::stop_play(S);
    check(S.session.recording == "", "stop closes the recording");
    check(util::is_nil(replay::recording()), "and the engine has none open");
    let rows = crate::session::listing(S);
    if !check(rows.len() > 0, "the session it wrote is on disk") {
        S.session.demo = ();
        return;
    }
    let row = rows[0];
    d.file = row.name;
    check(row.started != "", "the list says when it ran");
    check(row.ticks > 0, format!("and how long: {} ticks", row.ticks));
    check(row.reason == "stop", format!("and how it ended: {}", row.reason));
    check(!row.stale, "its scripts are the ones on disk");
}

// Replaying rebuilds the scene, feeds the recording into it, and hands the
// dock its lanes.
fn open_and_check(S, d) {
    if d.file == "" {
        S.session.demo = ();
        return;
    }
    crate::session::open(S, d.file);
    if !check(crate::session::loaded(S), format!("{} loads", d.file)) {
        S.session.demo = ();
        return;
    }
    check(replay::state() == replay::STATE_PLAYING, "and starts playing");
    check(S.playing, "the scene runs while it plays");
    let span = util::obj(replay::length());
    check(span.get("frames").unwrap_or(0) > 0, "the session has frames");
    check(S.session.lanes.len() > 0, "the dock has lanes to draw");
    d.was = replay::position();
}

// Playing walks the recording and parks at its end; closing puts the edited
// scene back and lets the engine run again.
fn replayed_and_check(S, d) {
    check(replay::position() > d.was, "playing walks the recording forward");
    check(replay::state() == replay::STATE_PAUSED, "a spent session parks");
    check(util::is_nil(replay::diverged()), "and reproduced what was recorded");
    crate::session::close(S);
    exported_and_check(S, d);
    check(!crate::session::loaded(S), "closing unloads the session");
    check(!S.playing, "and puts the edited scene back");
    // A self-test that leaves files behind fills the ring it is testing.
    fs::remove(crate::session::dir(S) + "/" + d.file);
    S.session.demo = ();
    log::info("selftest session: done");
}

// Export puts a copy where a bug report or `balaur replay` can reach it.
fn exported_and_check(S, d) {
    crate::session::export(S, d.file);
    let out = S.game_root + "/" + d.file;
    check(fs::exists(out), "export copies the session into the project");
    fs::remove(out);
}

// The profiler's data path: that `engine::timings()` answers with the shape
// the dock reads. Every duration is legitimately zero inside `init`; that the
// numbers are real is `crates/balaur_core/tests/timings.rs`' job.
pub fn timings(S) {
    let t = engine::timings();
    if !check(t is Object, "engine::timings() answers with a table") {
        return;
    }
    check(t.contains_key("frame") && t.contains_key("fixed_steps"),
        "it carries the frame and its fixed steps");
    check(t.contains_key("spans"), "and a place for named spans");
    let stages = util::obj(t.get("stages").unwrap_or(()));
    for name in ["first", "pre_update", "update", "fixed_update", "post_update",
                 "scene_sync", "render", "last"] {
        if !check(stages.contains_key(name), format!("stage '{}' is in the table", name)) {
            return;
        }
    }
    let total = 0.0;
    for (_, seconds) in stages.iter() {
        total += util::f(seconds);
    }
    // The frame contains its stages and the gaps between them, so it is never
    // the smaller number. A profiler that said otherwise would be measuring
    // something else.
    check(util::f(t.frame) >= total - 1e-9,
        format!("the frame ({}) covers its stages ({})", util::f(t.frame), total));
    log::info("selftest timings: done");
}

// Placing a prefab from the editor: the palette's verb adds an instance node,
// the engine builds the prefab under it, and undo takes the whole thing back.
pub fn placing(S) {
    let scenes = model::scene_files(S);
    let candidates = [];
    for rel in scenes {
        if rel != S.scene_rel {
            candidates.push(rel);
        }
    }
    if candidates.is_empty() {
        log::info("selftest placing: this project has no second scene to instance, skipped");
        return;
    }
    let rel = candidates[0];
    let before = S.doc.len();
    let authored_before = model::authored(S.doc).len();
    shell::choose(S, 0);

    model::instance_scene(S, rel);
    let node = S.doc[S.sel];
    check(node.get("instance") == Some(rel), format!("the new node instances {}", rel));
    check(model::authored(S.doc).len() == authored_before + 1,
        "exactly one row was added to the file");
    check(S.doc.len() > authored_before + 1,
        format!("and the prefab's own rows came with it ({} in all)", S.doc.len()));
    check(mirror_resolves(S), "every row resolves, the new prefab's included");

    // A scene that instanced itself would recurse; the verb refuses.
    let held = S.doc.len();
    model::instance_scene(S, S.scene_rel);
    check(S.doc.len() == held, "a scene refuses to instance itself");

    shell::undo(S);
    check(S.doc.len() == before, format!("undo takes the instance back ({} rows)", S.doc.len()));
    check(mirror_resolves(S), "and the mirror is whole again");
    log::info("selftest placing: done");
}

// The theme switch, both ways. One way was all it ever managed: a `dark`
// parameter shadowed `theme::dark()`, so asking for the dark theme back
// called a bool and the editor stayed light for the rest of the session.
/// `--state counterdemo`: the editor's half of the plugin seam. Registering a
/// dock has to put a tab somewhere, or nothing can ever bring the panel up.
pub fn plugin_docks(S) {
    if !check(S.registry.docks.len() > 0, "a plugin registered a dock") {
        return;
    }
    for entry in S.registry.docks {
        let side = crate::docks::side_of(S, entry.id);
        if !check(side.is_some(), format!("the {} dock has a tab", entry.id)) {
            continue;
        }
        check(side == Some("bottom"), format!("and it is in the bottom dock ({})", side.unwrap()));
        check(crate::docks::panels(S).contains_key(entry.id),
            format!("the panel table names {}", entry.id));
        crate::docks::show(S, entry.id);
        check(crate::docks::showing(S, entry.id), format!("showing {} brings it up", entry.id));
    }
    log::info("selftest plugin docks: done");
}

/// `--state settingsdemo`: the settings screen's search field and the query it
/// filters by are one thing, which they stopped being for a frame; then a
/// value written on the screen is round-tripped through the file.
pub fn settings_screen(S) {
    crate::settings::open_search(S, "theme");
    S.settings.demo = 0;
}

// Three frames: the sidebar's field has to have drawn and written back before
// the query being intact means anything.
const SETTINGS_SETTLED = 3;

pub fn settings_step(S) {
    S.settings.demo = S.settings.demo + 1;
    if S.settings.demo < SETTINGS_SETTLED {
        return;
    }
    S.settings.demo = -1;
    check(S.settings.query == "theme",
        format!("a settings query survives the frames after it is set ('{}')", S.settings.query));
    check(crate::search::query(S, "settings") == "theme",
        "and the field's own buffer holds the same text");
    settings_round_trip(S);
}

// A value written on the screen reaches the editor's preferences file and
// comes back out of it. The file is put back as it was found.
fn settings_round_trip(S) {
    let path = "editor/sessions/keep";
    let kept = fs::read(crate::settings::prefs_path());
    let was = settings::get(path);
    let before = if was is Tuple { 10 } else { util::i(was) };
    let want = before + 3;

    crate::settings::write(S, path, want);
    check(S.settings.dirty, "writing a setting marks the screen unsaved");
    check(util::i(settings::get(path)) == want, format!("and the value took ({})", want));

    crate::settings::commit_prefs(S);
    let text = fs::read(crate::settings::prefs_path());
    if check(text is String, "the preferences file was written") {
        check(text.contains("keep"), "and names the setting that changed");
        settings::load(text);
        check(util::i(settings::get(path)) == want,
            format!("a re-read of the file agrees ({})", settings::get(path)));
    }

    crate::settings::write(S, path, before);
    if kept is String {
        fs::write(crate::settings::prefs_path(), kept);
    } else {
        fs::remove(crate::settings::prefs_path());
    }
    S.settings.dirty = false;
    log::info("selftest settings: done");
}

pub fn theme_switch(S) {
    check(S.theme.dark == true, "the editor starts on the dark theme");
    theme::set_dark(S, false);
    check(S.theme.dark == false, "the switch reaches the light theme");
    check(S.theme.bg != "", "and the light theme loaded its colours");
    theme::set_dark(S, true);
    check(S.theme.dark == true, "and switches back to the dark one");
    log::info("selftest theme: done");
}
