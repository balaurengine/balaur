// Editor plugins: unsandboxed Rune modules adding docks, windows, commands,
// inspector sections, property editors, overlays and start-up states.

use crate::style;
use crate::util;

/// The registries, before any plugin has been seen.
pub fn state() {
    #{
        docks: [],
        windows: [],
        commands: [],
        sections: [],
        overlays: [],
        editors: #{},
        states: #{},
        open: #{},
        loaded: [],
    }
}

/// Where a plugin lives: the editor's own, on for every project; the game's;
/// and each addon's `editor/`, on while the game carries that addon.
fn roots(S) {
    // With no project open there is only the editor's own directory: a
    // relative path off an empty root is a path outside every root there is.
    if S.game_root == "" {
        return ["plugins"];
    }
    let found = ["plugins", S.game_root + "/editor"];
    let addons = S.game_root + "/addons";
    for entry in util::vec(fs::list(addons)) {
        if entry.is_dir {
            found.push(addons + "/" + entry.name + "/editor");
        }
    }
    found
}

/// Load every plugin in every root, in name order so registration order
/// does not depend on the filesystem's.
///
/// A plugin declares `register()` returning what it adds, and optionally
/// `state()` for its slice at `S.plugins[<id>]`. It returns a description
/// rather than taking an `api` object because in Rune `api.dock(..)` is a
/// method call, not a call of a stored closure.
pub fn load(S) {
    // Before any plugin registers: what it draws with, and saves pointed at
    // the game's own folder.
    S.kit = crate::kit::make();
    crate::kit::adopt_game_data(S);
    for root in roots(S) {
        let names = [];
        for entry in util::vec(fs::list(root)) {
            let name = entry.name;
            if !entry.is_dir && name.ends_with(".rn") {
                names.push(name);
            }
        }
        names.sort();
        for name in names {
            load_one(S, root + "/" + name, name[..name.len() - 3]);
        }
    }
    if S.registry.loaded.len() > 0 {
        log::info(format!("editor plugins: {}", util::join(S.registry.loaded, ", ")));
    }
}

fn load_one(S, path, id) {
    // The host's own signatures, so a file that is not a plugin is skipped
    // with a reason rather than failing inside `require`.
    let has_register = false;
    let has_state = false;
    for f in util::vec(script::functions(path)) {
        if f.name == "register" {
            has_register = true;
        }
        if f.name == "state" {
            has_state = true;
        }
    }
    if !has_register {
        log::warn(format!("{}: no register(); skipped", path));
        return;
    }
    let module = script::require(path);
    if !(module is Object) {
        log::warn(format!("{}: did not load", path));
        return;
    }
    if has_state {
        let make = module["state"];
        S.plugins[id] = make();
    } else {
        S.plugins[id] = #{};
    }
    let register = module["register"];
    let (ok, declared) = script::attempt(|| register());
    if !ok {
        log::error(format!("{}: register() failed: {}", path, declared));
        return;
    }
    if !(declared is Object) {
        log::error(format!("{}: register() returned no object", path));
        return;
    }
    add_all(S, id, declared);
    S.registry.loaded.push(id);
}

// Every list is optional: a plugin declares only what it adds.
fn add_all(S, id, declared) {
    for entry in util::vec(declared.get("panels").unwrap_or([])) {
        S.registry.panels.push(#{
            id: entry.id, title: entry.title, icon: entry.get("icon").unwrap_or(""),
            tall: entry.get("tall").unwrap_or(false),
            draw: script::shared(entry.draw), owner: id,
        });
        // Registering a dock is not enough to reach it: a panel is drawn by
        // the dock whose tab list holds its id.
        crate::docks::adopt(S, entry.id);
    }
    for entry in util::vec(declared.get("dialogs").unwrap_or([])) {
        S.registry.dialogs.push(#{
            id: entry.id, title: entry.title,
            draw: script::shared(entry.draw), owner: id,
        });
    }
    for entry in util::vec(declared.get("commands").unwrap_or([])) {
        S.registry.commands.push(#{
            title: entry.title,
            icon: entry.get("icon").unwrap_or("·"),
            shortcut: entry.get("shortcut").unwrap_or(""),
            run: script::shared(entry.run), owner: id,
        });
    }
    for draw in util::vec(declared.get("inspector_sections").unwrap_or([])) {
        S.registry.inspector_sections.push(#{ draw: script::shared(draw), owner: id });
    }
    for draw in util::vec(declared.get("overlays").unwrap_or([])) {
        S.registry.overlays.push(#{ draw: script::shared(draw), owner: id });
    }
    let editors = util::obj(declared.get("property_editors").unwrap_or(#{}));
    for (datatype, draw) in editors.iter() {
        S.registry.property_editors[datatype] = #{ draw: script::shared(draw), owner: id };
    }
    let states = util::obj(declared.get("startup_states").unwrap_or(#{}));
    for (name, run) in states.iter() {
        S.registry.startup_states[name] = #{ run: script::shared(run), owner: id };
    }
}

/// A registered dock's entry, or `None`.
pub fn dock(S, id) {
    for entry in S.registry.docks {
        if entry.id == id {
            return Some(entry);
        }
    }
    None
}

/// Whatever a plugin registered for the inspector, drawn after the built-ins.
pub fn draw_sections(S, k, node) {
    for entry in S.registry.sections {
        let draw = entry.draw;
        draw(S, k, node);
    }
}

/// Viewport lines a plugin draws, each frame.
pub fn draw_overlays(S) {
    for entry in S.registry.overlays {
        let draw = entry.draw;
        draw(S);
    }
}

/// Every open plugin window, drawn as a sheet like every other surface.
pub fn draw_windows(S, k) {
    let n = 0;
    for entry in S.registry.windows {
        if S.registry.open.get(entry.id).unwrap_or(false) != true {
            continue;
        }
        let r = crate::layout::window_rect(S, n);
        n = n + 1;
        let draw = entry.draw;
        crate::style::sheet(k, entry.id, r, 12, 0, || {
            ui::horizontal(#{ height: 30 }, || {
                ui::label(entry.title, #{ size: style::MD, font: ui::FONT_HEADING, strong: true, color: k.text });
                ui::right(|| {
                    if ui::circle_button(crate::icons::ui("close"), #{ d: 20, size: style::SM, color: k.dim, tooltip: "Close" }) {
                        S.registry.open[entry.id] = false;
                    }
                });
            });
            ui::separator(k.line);
            ui::add_space(6);
            draw(S, k);
        });
    }
}

/// A property editor a plugin registered for `datatype`, or `None`.
pub fn editor(S, datatype) {
    match S.registry.editors.get(datatype) {
        Some(entry) => Some(entry.draw),
        None => None,
    }
}

/// A start-up state a plugin registered, or `None`.
pub fn start_state(S, name) {
    match S.registry.states.get(name) {
        Some(entry) => Some(entry.run),
        None => None,
    }
}
