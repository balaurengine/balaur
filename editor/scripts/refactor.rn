// Rename a name across the scripts a file's `mod` declarations reach, and
// find and replace across the same set. Textual, because Rune keeps no
// cross-file index, so both show the list before anything is written.

use crate::model;

pub fn state() {
    #{ open: false, mode: "rename", from: "", to: "", hits: [], written: [] }
}

/// Open over the word the caret is on, so a rename starts already filled in.
pub fn open(S, mode) {
    let rel = active_rel(S);
    if rel == "" {
        return;
    }
    S.refactor.open = true;
    S.refactor.mode = mode;
    S.refactor.from = if mode == "rename" { word_at_caret(S, rel) } else { "" };
    S.refactor.to = "";
    S.refactor.hits = [];
    S.refactor.written = [];
    preview(S);
    crate::signals::changed(S, "refactor");
}

pub fn close(S) {
    S.refactor.open = false;
    S.refactor.hits = [];
    S.refactor.written = [];
    crate::signals::changed(S, "refactor");
}

// The script the code pane is showing, "" when it is showing none.
fn active_rel(S) {
    if S.sel < 0 || S.sel >= S.doc.len() {
        return "";
    }
    let node = S.doc[S.sel];
    if !node.contains_key("script") {
        return "";
    }
    model::script_rel(node).unwrap_or("")
}

fn source_of(S, rel) {
    let abs = S.game_root + "/" + rel;
    match S.script_buffers.get(abs) {
        Some(buffer) => buffer,
        None => model::source(S, rel).unwrap_or(""),
    }
}

// The identifier under the caret, which is what a rename means by default.
// The same word the completion list opens on, so both read one definition of
// where an identifier starts.
fn word_at_caret(S, rel) {
    let index = S.complete.at_index;
    if index < 0 {
        return "";
    }
    crate::complete::prefix_at(source_of(S, rel), index)
}

/// Every place the name appears, and what a rename would write.
pub fn preview(S) {
    let rel = active_rel(S);
    if rel == "" || S.refactor.from == "" {
        S.refactor.hits = [];
        S.refactor.written = [];
        return;
    }
    let source = source_of(S, rel);
    let renaming = S.refactor.mode == "rename";
    let hits = if renaming {
        script::references(rel, source, S.refactor.from)
    } else {
        script::find(rel, source, S.refactor.from)
    };
    S.refactor.hits = if hits is Vec { hits } else { [] };
    if S.refactor.to == "" {
        S.refactor.written = [];
        return;
    }
    let written = if renaming {
        script::rename(rel, source, S.refactor.from, S.refactor.to)
    } else {
        script::replace(rel, source, S.refactor.from, S.refactor.to)
    };
    S.refactor.written = if written is Vec { written } else { [] };
}

/// Write every file the preview listed, into the buffers rather than to disk:
/// a rename is undone with the same ⌘S that saves it.
pub fn apply(S) {
    if S.refactor.written.len() == 0 {
        return;
    }
    for one in S.refactor.written {
        let abs = S.game_root + "/" + one.file;
        S.script_buffers[abs] = one.source;
        S.script_dirty[abs] = true;
        crate::lint::touched(S);
        crate::signals::bars(S);
    }
    crate::center::code_written(S);
    log::info(format!("{} {} to {} in {} files",
        if S.refactor.mode == "rename" { "renamed" } else { "replaced" },
        S.refactor.from, S.refactor.to, S.refactor.written.len()));
    close(S);
}

/// What the sheet shows: its fields as it opens, every place the name is,
/// and whether there is anything to apply.
pub fn view(S) {
    if !S.refactor.open {
        return #{ open: false };
    }
    let renaming = S.refactor.mode == "rename";
    let hits = [];
    for hit in S.refactor.hits {
        hits.push(format!("{}:{}", hit.file, hit.line));
    }
    #{
        open: true, title: if renaming { "RENAME" } else { "REPLACE" },
        from: S.refactor.from, to: S.refactor.to,
        from_hint: if renaming { "name" } else { "text to find" },
        to_hint: if renaming { "new name" } else { "replace with" },
        count: format!("{} matches in {} files", S.refactor.hits.len(), S.refactor.written.len()),
        hits: hits,
        ready: S.refactor.to != "" && S.refactor.written.len() > 0,
    }
}

/// One of the two fields, as it is typed.
pub fn set(S, field, text) {
    if field == "From" {
        S.refactor.from = text;
    } else {
        S.refactor.to = text;
    }
    preview(S);
    crate::signals::changed(S, "refactor");
}
