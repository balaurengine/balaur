// Commands over more than one node: group, align, distribute, hide, lock and
// isolate. Every one that changes the scene records a history step.

use editor;
use history;
use model;
use rig;
use selection;
use util;

/// World position of a row.
fn world_of(state: editor::State, row: int) -> [float] {
    let found = model::node(state, row);
    if found.is_valid() {
        util::xyz(found.transform.global_position())
    } else {
        [0.0, 0.0, 0.0]
    }
}

/// Move a row so its world position becomes `target`, in local terms.
fn move_world_to(state: &mut editor::State, row: int, target: [float]) {
    let world = world_of(state, row);
    let local = model::transform_part(model::node(state, row), "position", [0.0, 0.0, 0.0]);
    model::set_transform(state, row, rig::Parts { position: util::vadd(local, util::vsub(target, world)), rotation_euler: [], scale: [] });
}

/// `mode` is `min`, `mid` or `max` along `axis`; the whole set lands on the
/// same coordinate there.
pub fn align(state: &mut editor::State, axis: int, mode: str) {
    let rows = selection::roots(state);
    if rows.len() < 2 {
        log::info("align needs two or more nodes");
        return;
    }
    let lo = math::INFINITY;
    let hi = -math::INFINITY;
    let sum = 0.0;
    for row in rows {
        let coordinate = world_of(state, row)[axis];
        lo = util::min(lo, coordinate);
        hi = util::max(hi, coordinate);
        sum += coordinate;
    }
    let to = if mode == "min" {
        lo
    } else if mode == "max" {
        hi
    } else {
        sum / rows.len().as_float()
    };
    history::record(state, "align {axis_name(axis)}", nil);
    for row in rows {
        let target = world_of(state, row);
        target[axis] = to;
        move_world_to(state, row, target);
    }
    history::commit(state);
}

/// Even the gaps along `axis`: the two extremes stay put and everything
/// between them spreads at one spacing.
pub fn distribute(state: &mut editor::State, axis: int) {
    let rows = selection::roots(state);
    if rows.len() < 3 {
        log::info("distribute needs three or more nodes");
        return;
    }
    // Insertion sort by the axis: a handful of nodes, and Rune's `sort` takes
    // no comparator.
    let sorted: [int] = [];
    for row in rows {
        let coordinate = world_of(state, row)[axis];
        let at = sorted.len();
        for slot in 0..sorted.len() {
            let other = sorted[slot];
            if coordinate < world_of(state, other)[axis] && at == sorted.len() {
                at = slot;
            }
        }
        sorted.insert(at, row);
    }
    let first = world_of(state, sorted[0])[axis];
    let last = world_of(state, sorted[sorted.len() - 1])[axis];
    let step = (last - first) / (sorted.len() - 1).as_float();
    history::record(state, "distribute {axis_name(axis)}", nil);
    for rank in 0..sorted.len() {
        let row = sorted[rank];
        let target = world_of(state, row);
        target[axis] = first + step * rank.as_float();
        move_world_to(state, row, target);
    }
    history::commit(state);
}

fn axis_name(axis: int) -> str {
    if axis == 0 {
        "x"
    } else if axis == 1 {
        "y"
    } else {
        "z"
    }
}

/// Wrap the selection in a fresh empty node at its centroid, keeping every
/// world pose. The group's parent is the shared parent when there is one,
/// else the scene's root.
pub fn group(state: &mut editor::State) {
    let rows = selection::roots(state);
    if rows.len() == 0 {
        return;
    }
    let members: [Node] = [];
    for row in rows {
        let found = model::node(state, row);
        if model::is_instanced(found) || model::is_scene_root(state, found) {
            log::warn("cannot group the scene's root or inside a prefab");
            return;
        }
        members.push(found);
    }
    let parent = members[0].parent();
    for found in members {
        if found.parent() != parent {
            parent = state.scene_root.unwrap();
        }
    }
    let center = [0.0, 0.0, 0.0];
    for row in rows {
        center = util::vadd(center, world_of(state, row));
    }
    center = util::vscale(center, 1.0 / rows.len().as_float());
    // The group's own position is local to whatever it lands under.
    let base = util::xyz(parent.transform.global_position());
    history::record(state, "group", nil);
    let made = model::spawn(state, parent, "Group", map().with("transform", map()
        .with("position", util::vsub(center, base))
        .with("rotation_euler", [0.0, 0.0, 0.0])
        .with("scale", [1.0, 1.0, 1.0])));
    // Where the first member stood, so the group takes its place in the order.
    if members[0].parent() == parent {
        made.set_sibling_index(members[0].sibling_index());
    }
    // A move keeps the world pose, so each member stays where it was.
    for found in members {
        found.set_parent(made);
    }
    model::reindex(state);
    selection::only(state, model::index_of_node(state, made).unwrap_or(0));
    history::commit(state);
}

/// Lift a group's children to its parent, keeping their world poses, and
/// delete the emptied node.
pub fn ungroup(state: &mut editor::State) {
    let found = model::selected_node(state);
    if !found.is_valid() || model::is_scene_root(state, found) || model::is_instanced(found) {
        log::warn("cannot ungroup the scene's root or inside a prefab");
        return;
    }
    let kids = found.children();
    if kids.len() == 0 {
        log::info("nothing to ungroup");
        return;
    }
    history::record(state, "ungroup", nil);
    let up = found.parent();
    let place = found.sibling_index();
    for kid in kids {
        kid.set_parent(up);
        kid.set_sibling_index(place);
        place += 1;
    }
    found.free();
    model::reindex(state);
    selection::clamp(state);
    history::commit(state);
}

pub fn toggle_hidden(state: &mut editor::State) {
    toggle_hidden_of(state, selection::all(state));
}

/// Whether a node says it is hidden: its own `visible`, whatever its parent's.
pub fn is_hidden(state: editor::State, row: int) -> bool {
    let found = model::node(state, row);
    found.is_valid() && !found.visible()
}

/// Flip `visible` on the whole set: if anything is showing, hide it all;
/// otherwise show it all. Written to the scene, so it survives a save.
pub fn toggle_hidden_of(state: &mut editor::State, rows: [int]) {
    let any_visible = false;
    for row in rows {
        if !is_hidden(state, row) {
            any_visible = true;
        }
    }
    let to = !any_visible;
    history::record(state, if to { "show" } else { "hide" }, nil);
    for row in rows {
        let found = model::node(state, row);
        if found.is_valid() {
            found.set_visible(to);
        }
    }
    history::commit(state);
}

pub fn show_all(state: &mut editor::State) {
    leave_isolate(state);
    history::record(state, "show all", nil);
    for found in state.nodes {
        if found.is_valid() && !found.visible() {
            found.set_visible(true);
        }
    }
    history::commit(state);
}

/// Locks are editor state, so no history step: undoing a lock would be
/// undoing something the file never saw.
pub fn toggle_locked(state: &mut editor::State) {
    toggle_locked_of(state, selection::all(state));
}

pub fn toggle_locked_of(state: &mut editor::State, rows: [int]) {
    let any_free = false;
    for row in rows {
        if !selection::is_locked(state, row) {
            any_free = true;
        }
    }
    for row in rows {
        selection::set_locked(state, row, any_free);
    }
}

pub fn unlock_all(state: &mut editor::State) {
    selection::unlock_all(state);
}

/// Isolate hides everything outside the selection for a look, and nothing
/// of it is the scene's: what it hid it remembers and shows again, its
/// writes are no undo step's, and a save or a play leaves it first.
pub fn toggle_isolate(state: &mut editor::State) {
    if state.isolated {
        leave_isolate(state);
        return;
    }
    let keep: [Node] = [];
    for row in selection::all(state) {
        keep.push(model::node(state, row));
    }
    // An edit's changes go to its step before isolate writes its own.
    history::take(state);
    state.isolated = true;
    state.isolate_hidden = [];
    for found in state.nodes {
        let kept = false;
        for picked in keep {
            if model::is_within(found, picked) || model::is_within(picked, found) {
                kept = true;
            }
        }
        if !kept && found.visible() {
            found.set_visible(false);
            state.isolate_hidden.push(found);
        }
    }
    scene::take_changes();
    log::info("isolated the selection");
}

/// Show again what isolate hid.
pub fn leave_isolate(state: &mut editor::State) {
    if !state.isolated {
        return;
    }
    history::take(state);
    state.isolated = false;
    for found in state.isolate_hidden {
        if found.is_valid() {
            found.set_visible(true);
        }
    }
    state.isolate_hidden = [];
    scene::take_changes();
    log::info("left isolate");
}
