// Commands over more than one node: group, align, distribute, hide, lock and
// isolate. Every one records a history step and leaves the mirror to the
// caller, the way the rest of the editor's verbs do.

use editor;
use history;
use model;
use rig;
use selection;
use util;

/// A node a group takes in, and where it stood in the world before.
pub struct Member {
    node: any,
    world: [float],
}

/// World position of a document row, from the mirror when it resolves.
fn world_of(S: editor::State, i: int) -> [float] {
    let found = model::live(S, i);
    if found.is_valid() {
        util::xyz(found.transform.global_position())
    } else {
        model::doc_transform(S.doc[i], "position", [0.0, 0.0, 0.0])
    }
}

/// Move a row so its world position becomes `target`, in local terms.
fn move_world_to(S: &mut editor::State, i: int, target: [float]) {
    let world = world_of(S, i);
    let node = S.doc[i];
    let local = model::doc_transform(node, "position", [0.0, 0.0, 0.0]);
    model::set_transform(S, i, rig::Parts { position: util::vadd(local, util::vsub(target, world)), rotation_euler: [], scale: [] });
}

/// `mode` is `min`, `mid` or `max` along `axis`; the whole set lands on the
/// same coordinate there.
pub fn align(S: &mut editor::State, axis: int, mode: str) {
    let rows = selection::roots(S);
    if rows.len() < 2 {
        log::info("align needs two or more nodes");
        return;
    }
    let lo = math::INFINITY;
    let hi = -math::INFINITY;
    let sum = 0.0;
    for i in rows {
        let v = world_of(S, i)[axis];
        lo = util::min(lo, v);
        hi = util::max(hi, v);
        sum += v;
    }
    let to = if mode == "min" {
        lo
    } else if mode == "max" {
        hi
    } else {
        sum / rows.len().as_float()
    };
    history::record(S, "align {axis_name(axis)}", nil);
    for i in rows {
        let target = world_of(S, i);
        target[axis] = to;
        move_world_to(S, i, target);
    }
    history::commit(S);
}

/// Even the gaps along `axis`: the two extremes stay put and everything
/// between them spreads at one spacing.
pub fn distribute(S: &mut editor::State, axis: int) {
    let rows = selection::roots(S);
    if rows.len() < 3 {
        log::info("distribute needs three or more nodes");
        return;
    }
    // Insertion sort by the axis: a handful of nodes, and Rune's `sort` takes
    // no comparator.
    let sorted: [int] = [];
    for i in rows {
        let v = world_of(S, i)[axis];
        let at = sorted.len();
        for n in 0..sorted.len() {
            let j = sorted[n];
            if v < world_of(S, j)[axis] && at == sorted.len() {
                at = n;
            }
        }
        sorted.insert(at, i);
    }
    let first = world_of(S, sorted[0])[axis];
    let last = world_of(S, sorted[sorted.len() - 1])[axis];
    let step = (last - first) / (sorted.len() - 1).as_float();
    history::record(S, "distribute {axis_name(axis)}", nil);
    for n in 0..sorted.len() {
        let i = sorted[n];
        let target = world_of(S, i);
        target[axis] = first + step * n.as_float();
        move_world_to(S, i, target);
    }
    history::commit(S);
}

fn axis_name(axis: int) -> str {
    if axis == 0 {
        "x"
    } else if axis == 1 {
        "y"
    } else {
        "z"
    }
}

/// Wrap the selection in a fresh empty node at its centroid, keeping every
/// world pose. The group's parent is the shared parent when there is one.
pub fn group(S: &mut editor::State) {
    let rows = selection::roots(S);
    if rows.len() == 0 {
        return;
    }
    for i in rows {
        if model::is_instanced(S.doc[i]) {
            log::warn("cannot group inside a prefab; open it to change its structure");
            return;
        }
    }
    let parent = S.doc[rows[0]].get("parent").as_str();
    for i in rows {
        if S.doc[i].get("parent").as_str() != parent {
            parent = "";
        }
    }
    // The nodes and their world poses, read before the insert renumbers every
    // row after it. Rune objects are shared, so these stay the right nodes.
    let members: [Member] = [];
    let center = [0.0, 0.0, 0.0];
    let at = S.doc.len();
    for i in rows {
        members.push(Member { node: S.doc[i], world: world_of(S, i) });
        center = util::vadd(center, world_of(S, i));
        at = util::imin(at, i);
    }
    center = util::vscale(center, 1.0 / rows.len().as_float());
    // The group's own position is local to whatever it lands under.
    let matched3 = model::index_of_id(S.doc, parent);
    let base = if matched3.is_some() {
        let where_at = matched3.unwrap();
        world_of(S, where_at)
    } else {
        [0.0, 0.0, 0.0]
    };
    history::record(S, "group", nil);
    let id = model::fresh_id(S.doc, "Group");
    // Ahead of its children: a scene file's parent has to be declared before
    // the nodes naming it, and the engine says so rather than guessing.
    S.doc.insert(at, map()
        .with("id", id)
        .with("name", model::unique_name(S.doc, "Group"))
        .with("parent", parent)
        .with("transform", map()
            .with("position", util::vsub(center, base))
            .with("rotation_euler", [0.0, 0.0, 0.0])
            .with("scale", [1.0, 1.0, 1.0])));
    for member in members {
        member.node.parent = id;
        model::set_transform(S, model::index_of_id(S.doc, member.node.id).unwrap_or(0), rig::Parts { position: util::vsub(member.world, center), rotation_euler: [], scale: [] });
    }
    model::build_mirror(S);
    selection::only(S, at);
    history::commit(S);
}

/// Lift a group's children to its parent, keeping their world poses, and
/// delete the emptied node.
pub fn ungroup(S: &mut editor::State) {
    let i = S.sel;
    let node = S.doc[i];
    if model::is_instanced(node) {
        log::warn("cannot ungroup inside a prefab");
        return;
    }
    let id = node.get("id").as_str();
    let up = node.get("parent").as_str();
    let kids: [int] = [];
    for j in 0..S.doc.len() {
        let other = S.doc[j];
        if other.get("parent").as_str() == id {
            kids.push(j);
        }
    }
    if kids.len() == 0 {
        log::info("nothing to ungroup");
        return;
    }
    history::record(S, "ungroup", nil);
    let worlds = map();
    for j in kids {
        worlds.set("{j}", world_of(S, j));
    }
    let matched4 = model::index_of_id(S.doc, up);
    let base = if matched4.is_some() {
        let at = matched4.unwrap();
        world_of(S, at)
    } else {
        [0.0, 0.0, 0.0]
    };
    for j in kids {
        let kid = S.doc[j];
        kid.set("parent", up);
        model::set_transform(S, j, rig::Parts { position: util::vsub(worlds.get("{j}"), base), rotation_euler: [], scale: [] });
    }
    S.doc.remove(i);
    model::build_mirror(S);
    selection::clamp(S);
    history::commit(S);
}

pub fn toggle_hidden(S: &mut editor::State) {
    toggle_hidden_of(S, selection::all(S));
}

/// Whether a node says it is hidden: its own `visible`, whatever its parent's.
pub fn is_hidden(S: editor::State, i: int) -> bool {
    S.doc[i].get("visible") == false
}

/// Flip `visible` on the whole set: if anything is showing, hide it all;
/// otherwise show it all. Written to the document, so it survives a save.
pub fn toggle_hidden_of(S: &mut editor::State, rows: [int]) {
    let any_visible = false;
    for i in rows {
        if !is_hidden(S, i) {
            any_visible = true;
        }
    }
    let to = !any_visible;
    history::record(S, if to { "show" } else { "hide" }, nil);
    for i in rows {
        S.doc[i].set("visible", to);
        model::record_override(S, S.doc[i], "visible");
        let found = model::live(S, i);
        if found.is_valid() {
            found.set_visible(to);
        }
    }
    history::commit(S);
}

pub fn show_all(S: &mut editor::State) {
    history::record(S, "show all", nil);
    for i in 0..S.doc.len() {
        let node = S.doc[i];
        if node.get("visible") == false {
            node.set("visible", true);
            model::record_override(S, node, "visible");
            let found = model::live(S, i);
            if found.is_valid() {
                found.set_visible(true);
            }
        }
    }
    history::commit(S);
}

/// Locks are editor state, so no history step: undoing a lock would be
/// undoing something the file never saw.
pub fn toggle_locked(S: &mut editor::State) {
    toggle_locked_of(S, selection::all(S));
}

pub fn toggle_locked_of(S: &mut editor::State, rows: [int]) {
    let any_free = false;
    for i in rows {
        if !selection::is_locked(S, i) {
            any_free = true;
        }
    }
    for i in rows {
        selection::set_locked(S, i, any_free);
    }
}

pub fn unlock_all(S: &mut editor::State) {
    selection::unlock_all(S);
}

/// Isolate hides everything outside the selection on the mirror only, so
/// leaving it restores what the document says rather than what it wrote.
pub fn toggle_isolate(S: &mut editor::State) {
    let on = !S.isolated;
    S.isolated = on;
    let keep = map();
    if on {
        for i in selection::all(S) {
            keep.set("{i}", true);
            let node = S.doc[i];
            for j in 0..S.doc.len() {
                let other = S.doc[j];
                if model::has_ancestor(S.doc, other, node.id.as_str())
                    || model::has_ancestor(S.doc, node, other.id.as_str())
                {
                    keep.set("{j}", true);
                }
            }
        }
    }
    for i in 0..S.doc.len() {
        let found = model::live(S, i);
        if !found.is_valid() {
            continue;
        }
        let visible = S.doc[i].visible;
        let authored = visible.is_nil() || visible.as_bool();
        let shown = if on { keep.has("{i}") && authored } else { authored };
        found.set_visible(shown);
    }
    log::info(if on { "isolated the selection" } else { "left isolate" });
}
