    }

    pub fn tree_toggle_hidden() {
        arrange::toggle_hidden(self.state);
    }

    pub fn tree_toggle_locked() {
        arrange::toggle_locked(self.state);
    }

    pub fn tree_rename() {
        left::rename_open(self.state);
    }

    // The eye or the lock at the right of an outliner row.
    pub fn on_outline_changed(_change: any) {
        signals::heard(self.state, signals::OUTLINE);
        follow_document(self.state);
        relayout_if_moved(self.state);
    }

    /// An answer to a request the editor sent: the font catalogue's.
    pub async fn await_font_reply(request: int) {
        let reply = await task::wait(request);
        fonts::answered(self.state, reply);
    }

    /// Files dropped on the window, imported where the pointer is.
    pub fn on_files_dropped(paths: any) {
        if manager::showing(self.state) {
            return;
        }
        for path in paths {
            dropin::take(self.state, path.as_str());
        }
    }

    /// The edited scene's writes this frame (`model::follow_changes`).
    pub fn on_changed(entries: any) {
        model::follow_changes(self.state, entries);
        follow_document(self.state);
    }

    pub fn on_inspector_changed(_change: any) {
        signals::heard(self.state, signals::INSPECTOR);
        relayout_if_moved(self.state);
        widget_layer(self.state);
    }

    pub fn on_docks_changed(_change: any) {
        signals::heard(self.state, signals::DOCKS);
        relayout_if_moved(self.state);
    }

    /// Fill a dock's tab row and show the panel it has up: what the dock's
    /// script asks for when the docks moved. Answers the node of a panel that
    /// fills itself, for the dock to tell once it shows.
    pub fn dock_fill(side: str) -> str {
        docks::fill(self.state, side)
    }

    pub fn on_problems_changed(_change: any) {
        signals::heard(self.state, signals::PROBLEMS_CHANGED);
    }

    pub fn on_docs_changed(_change: any) {
        signals::heard(self.state, "docs_changed");
    }

    pub fn on_assets_changed(_change: any) {
        signals::heard(self.state, signals::ASSETS_CHANGED);
    }

    pub fn on_library_changed(_change: any) {
        signals::heard(self.state, "library_changed");
    }

    pub fn on_tiles_changed(_change: any) {
        signals::heard(self.state, "tiles_changed");
    }

    pub fn on_machine_changed(_change: any) {
