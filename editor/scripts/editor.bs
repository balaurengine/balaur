    /// A shell key's command, by the name of its node in scenes/panels/keys.toml.
    pub fn command(name: str) {
        commands::run(self.S, name);
        signals::bars(self.S);
    }

    /// What the keys need to say which of them are live.
    pub fn keys_view() -> commands::KeysView {
        commands::keys_view(self.S)
    }

    /// A script stopped, stopped somewhere else or went on: the engine's word,
    /// where the editor used to ask it every frame.
    pub fn on_debugger_stopped(stop: any) {
        shell::stopped(self.S, stop);
    }

    /// The Assets panel's cards and strip for a search, a card picked, and its
    /// verbs: up, import, folder, rename, delete and the new name submitted.
    pub fn assets_view(query: str) -> dock::AssetsView {
        dock::assets_view(self.S, query)
    }

    pub fn assets_pick(row: str) {
        dock::assets_pick(self.S, row);
    }

    pub fn assets_verb(verb: str, value: str) {
        dock::assets_verb(self.S, verb, value);
    }

    /// The Library panel's cards or templates, its kind, and what a pick places.
    pub fn library_view() -> library::View {
        library::view(self.S)
    }

    pub fn library_kind(kind: str) {
        library::choose(self.S, kind);
    }

    pub fn library_pick(row: str) {
        library::pick(self.S, row);
    }

    /// Fill the Tiles panel's chips and answer its atlas, and a tile picked.
    pub fn tiles_fill() -> tiles::Palette {
        tiles::palette(self.S)
    }

    pub fn tiles_pick(row: str) {
        tiles::pick(self.S, row);
    }

    /// Fill the State machine panel's header and rows.
    pub fn machine_fill() {
        statemachine::body(self.S);
    }

    /// Fill the Recordings panel's rows, and its verify switch.
    pub fn recordings_fill() -> dock::RecordingsFill {
        dock::recordings_fill(self.S)
    }

    pub fn recordings_verify() {
        dock::recordings_verify(self.S);
    }

    /// The Debugger panel's stop, its steps, pause, break on error and a frame
    /// picked in the stack.
    pub fn debugger_view() -> dock::DebuggerView {
        dock::debugger_view(self.S)
    }

    pub fn debugger_step(step: str) {
        dock::debugger_step(self.S, step);
    }

    pub fn debugger_pause() {
        debugger::request_break();
    }

    pub fn debugger_break_on_error() {
        debugger::set_break_on_error(!debugger::break_on_error());
    }

    pub fn debugger_frame(row: str) {
        dock::debugger_frame(self.S, row);
    }

    /// The Output panel's lines for a level and a search, and its "clear".
    pub fn output_view(level: str, query: str) -> dock::OutputView {
        dock::output_view(self.S, level, query)
    }

    pub fn output_clear() {
        dock::output_clear(self.S);
    }

    /// The Problems panel's lines, and what a pick on one opens.
    pub fn problems_view() -> dock::ProblemsView {
        dock::problems_view(self.S)
    }

    pub fn problems_pick(row: str) {
        dock::problems_pick(self.S, row);
    }

    /// A live meter's table and headline, and the Profiler's "scripts".
    pub fn meter_view(what: str) -> dock::MeterView {
        dock::meter_view(self.S, what)
    }

    pub fn profiler_scripts() {
        dock::profiler_scripts(self.S);
    }

    /// The Docs panel's page for a search, and its module picker.
    pub fn docs_view(query: str) -> docs::View {
        docs::view(self.S, query)
    }

    pub fn docs_pick(module: str) {
        docs::pick(self.S, module);
    }

    /// The Outline tab's rows, and what a pick on one does.
    pub fn secondary_view() -> [str] {
        left::secondary_view(self.S)
    }

    pub fn secondary_pick(row: str) {
        left::secondary_pick(self.S, row);
    }

    /// The Scene panel's "+".
    pub fn scene_add() {
        newnode::open(self.S);
    }

    /// What the Inspector panel's head says.
    pub fn inspector_view() -> inspector::View {
        inspector::view(self.S)
    }

    /// Fill the Inspector panel's form, filtered by `query`.
    pub fn inspector_fill(query: str) {
        inspector::fill(self.S, query);
    }

    /// The Inspector's "Add component".
    pub fn inspector_add() {
        inspector::add(self.S);
    }

    /// What the Scene panel shows for a search and a facet tag.
    pub fn outline_view(query: str, facet: str) -> left::OutlineView {
        left::outline_view(self.S, query, facet)
    }

    /// The Scene panel's tree picked the row written `row`.
    pub fn outline_pick(row: str) {
        left::outline_pick(self.S, row);
    }

    pub fn tree_mark(e: any) {
        left::mark_clicked(self.S, e.row.as_str(), e.mark.as_str());
    }

    pub fn tree_delete() {
        model::delete_selected(self.S);
    }
}
