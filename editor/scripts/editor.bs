    }

    /// Draw the viewport's lines again, on a word that what they show moved. The
    /// words of one frame are heard together and draw once.
    pub fn overlays_fill() {
        if self.state.overlays_frame != self.state.frame {
            draw_overlays(self.state);
        }
    }

