// The balaur editor: a regular balaur project whose modules draw the whole
// shell and edit the game given to `balaur edit`. Every module is handed
// `state`, its one `State`.

use anim;
use arrange;
use autosave;
use bench;
use bonemap;
use center;
use chrome;
use commands;
use complete;
use defs;
use disk;
