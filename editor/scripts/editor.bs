// The balaur editor: a regular balaur project whose modules draw the whole
// shell and edit the game given to `balaur edit`. Every module is handed
// `state`, its one `State`.

use anim;
use arrange;
use bench;
use bonemap;
use center;
use chrome;
use commands;
use complete;
use disk;
use dock;
use docks;
use docs;
use dropin;
use events;
use fonts;
use exporter;
use form;
use frame;
use gizmo;
use history;
use importer;
use inputview;
use inspector;
use kit;
use lanes;
use layout;
use left;
use library;
use lint;
use manager;
use model;
use newnode;
use palette;
use pen;
use plugins;
use polygon;
use populate;
use refactor;
use rig;
