use words::fields;
use words::layout_fields;
use words::project_fields;
use words::tabs;
use words::tools;

const ALL: str = "all";
const VIEWPORT: str = "viewport";

/// The Editor node's script: the node it runs on and everything it keeps.
pub class Editor {
    node: Node,
    state: State,
}

/// Every field the editor keeps; `fresh_state` gives each its starting value.
/// A map keyed by a name or an id is an `any`, and so is a key: what a cache
/// was built from, compared whole.
pub class State {
    internal workspace: str,
    internal tool: str,
    internal doctab: str,
    internal shader_rel: str,
    internal preview_line: int,
    internal preview_rel: str,
    internal docks: any,
    internal split: bool,
    internal script_open: bool,
    internal events_open: bool,
    internal zoom: float,
    internal playing: bool,
    internal formed: bool,
    internal palette: bool,
    internal palette_query: str,
    internal palette_submit: bool,
    internal picker_focused: bool,
    internal newnode: bool,
    internal newnode_query: str,
    internal newnode_change: bool,
    internal newnode_soft: str,
    internal renaming: bool,
    internal rename_text: str,
    internal chip_state: any,
    internal compact: bool,
    internal screen_key: str,
    internal touchscreen: bool,
    platform_read: bool,
    internal release_at: int,
    internal states_applied: bool,
    internal start_states: str,
    internal script_buffers: any,
    internal schemas: any,
    internal expects: any,
    internal opened: any,
    // Each open buffer typed into since it was written, by its path, with
    // the wall-clock second it was last typed into.
    internal script_dirty: any,
    // What each buffer's file held when they last agreed, by path: anything
    // else on disk was written by something other than this editor.
    internal script_disk: any,
    // Buffers whose file moved under them, which the autosave leaves alone
    // until the Changed on disk sheet has an answer for each.
    internal script_held: any,
    // A buffer was held since the sheet last filled.
    internal disk_new: bool,
    // The sheet was put up, so its being down means it was shut unanswered.
    internal disk_up: bool,
    internal collapsed: any,
    // Moved whenever the rows the outline shows may have.
    internal outline_rows: int,
    internal view_shot: str,
    view_logged: str,
    internal code_scroll: float,
    internal code_revision: int,
    internal layout_seen: float,
    /// The rows the Import tab's form was last filled with.
    internal form: [ui::Row],
    /// The Inspector's lines and which of them are on screen.
    internal inspect: inspector::Form,
    /// When the Inspector's whole form is filled again after a run of edits
    /// its rows followed alone; 0 for none pending.
    internal inspector_after: float,
    internal tree_cache: left::TreeCache,
    internal told: any,
    internal inspector_key: any,
    internal docks_key: any,
    internal chrome_key: any,
    internal status_key: any,
    internal rail_key: any,
    internal stage_key: any,
    internal overlays_key: any,
    internal stepping: [str],
    // The edit `--state bench:` makes every frame, or "".
    internal bench: str,
    overlays_frame: int,
    stepped: int,
    layout_key: any,
    internal theme_revision: int,
    internal is_2d_was: bool,
    internal overlay3d: Overlay3d,
    internal selected: int,
    internal selected_rows: [int],
    internal locks: any,
    internal bookmarks: any,
    internal isolated: bool,
    /// What isolate hid, to show again when it is left.
    internal isolate_hidden: [Node],
    internal fps: float,
    internal layout_demo: int,
    internal rows_demo: int,
    internal plugin_demo: int,
    /// `test:profiler`'s frames since it switched counting on; -1 at rest.
    internal profile_demo: int,
    internal events_demo: int,
    internal palette_demo: int,
    internal import_demo: int,
    internal import_waited: int,
    internal rows_want: int,
    internal rows_waited: int,
    internal gesture_demo: int,
    internal gesture_from: [float],
    internal frame: int,
    internal capture: shell::Capture?,
    internal show_input: bool,
    internal screen_width: float,
    internal screen_height: float,
    internal viewport: Viewport,
    internal rail_visible: bool,
    internal stage_chrome: bool,
    internal rail_shut: bool,
    internal chrome_off: bool,
    internal fontdemo: bool,
    internal menu_open: bool,
    internal doc_open: bool,
    internal hooks_open: bool,
    internal focus: bool,
    internal focus_was: any,
    internal layout: any,
    internal viewport_live: bool,
    internal mode2d: bool,
    internal sources: any,
    internal scene_doc: any,
    internal listings: any,
    internal clip: anim::Clip?,
    internal hooks_source: str,
    internal hooks_live: [center::Parsed],
    internal log_level: str,
    internal log_query: str,
    internal log_cache: dock::Built?,
    internal log_cursor: int,
    internal panels: docks::Panels?,
    internal palette_cache: palette::Found?,
    internal newnode_cache: [newnode::Entry]?,
    internal brand: chrome::Brand?,
    internal mirror: Node?,
    /// The edited scene's root, the one node under `mirror` the scene file
    /// builds.
    internal scene_root: Node?,
    /// The scene's nodes in tree order, its root first: the rows every tool
    /// and panel addresses by index (`model::reindex`).
    internal nodes: [Node],
    /// A component a tool is changing in place, held for the frame.
    internal edited: model::Edited?,
    /// The scene as play found it, which stop builds again.
    internal played: str,
    /// The text the last play ran from, and what the scene reads as once
    /// stopping has rebuilt it: while it still reads so, nothing was edited.
    internal last_played: str,
    internal stopped_as: str,
    internal theme: any,
    internal theme_half: str,
    internal gizmo: gizmo::GizmoState,
    internal camera_drag: int,
    internal complete: complete::CompleteState,
    internal docs: docs::DocsState,
    internal refactor: refactor::RefactorState,
    internal textedit: textedit::TexteditState,
    internal rig: rig::RigState,
    internal polygon: polygon::PolygonState,
    internal viewport_check: selftest::ViewportCheck?,
    internal camera_check: selftest::CameraCheck?,
    internal pick_check: selftest::PickCheck?,
    internal picture_check: selftest::PictureCheck?,
    internal pool_check: selftest::PoolCheck?,
    internal form_check: selftest::FormCheck?,
    internal reselect: selftest::Reselect?,
    internal empty_note: selftest::EmptyNote?,
    internal start_check: selftest::StartCheck?,
    internal pen: pen::PenState,
    weights: weights::WeightsState,
    internal bonemap: bonemap::BonemapState,
    internal machine: statemachine::StatemachineState,
    internal tiles: tiles::TilesState,
    internal anim: anim::AnimState,
    internal debug: shell::DebugState,
    events: events::EventsState,
    internal exporter: exporter::ExporterState,
    internal populate: populate::PopulateState,
    internal assets_touched: bool,
    internal jobs: any,
    internal import_queue: [str],
    internal import_drip: bool,
    internal session: session::SessionState,
    internal settings: settings::SettingsState,
    internal themewin: themewin::ThemewinState,
    internal window: window::WindowState,
    internal search: any,
    internal showcase: showcase::Sequence?,
    inputview: any,
    internal library: library::LibraryState,
    internal manager: manager::ManagerState,
    internal lint: lint::LintState,
    internal assets: dock::AssetsState,
    plugins: any,
    internal registry: plugins::PluginsState,
    // What `model::load` reads from the project: where it is and what it is
    // called. The scene itself is the live nodes under `mirror`.
    internal game_root: str,
    internal game_name: str,
    internal scene_rel: str,
    internal scene_path: str,
    internal script_profiling: bool,
    internal history: history::History,
    internal import_texture: importer::Held,
    internal import_shipped: importer::ImportShipped,
    /// The installed faces the font picker offers, by the label it shows
    /// them under, to their files; nil until the picker first asks.
    internal system_fonts: any,
    /// The font catalogue while it is up over the picker.
    internal font_finding: fonts::Finding?,
    /// The catalogue's families, nil until Forge has answered.
    internal font_families: any,
    /// What each request to the catalogue is for, by its id.
    internal font_requests: any,
    internal kit_state: any,
    internal rows_query: str,
    internal suite: suite::Run?,
}

/// The 3D light and camera marks, and what they were drawn for.
pub struct Overlay3d {
    internal key: [any],
    internal lines: [float],
}

/// The viewport's rect in design pixels, and the frame it was read on.
pub struct Viewport {
    internal x: float,
    internal y: float,
    internal width: float,
    internal height: float,
    internal at: int,
}

// Below this many design pixels wide the shell drops every label its icon
// already says.
const COMPACT_WIDTH: float = 1240.0;

// The frame the splash comes off whether or not the shell has stopped moving.
const FORM_BY: int = 30;

/// Every field the editor keeps, at its starting value.
pub fn fresh_state() -> State {
    State {
        workspace: tabs::SCENE,
        tool: tools::SELECT,
        doctab: tabs::SCENE,
        // A shader opened from a material; empty means the code pane shows
        // the selected node's script instead.
        shader_rel: "",
        // The shader line the viewport draws the value of; 0 draws the scene.
        preview_line: 0,
        preview_rel: "",
        docks: docks::state(),
        // The centre split: code and viewport side by side, instead of the
        // document tabs swapping one for the other.
        split: false,
        // The closable document tabs; the scene's is always there.
        script_open: false,
        events_open: false,
        zoom: 100.0,
        playing: false,
        formed: false,
        palette: false,
        palette_query: "",
        palette_submit: false,
        // Whether the picker's field has been handed the caret since it
        // opened; it takes it once, not every frame.
        picker_focused: false,
        newnode: false,
        newnode_query: "",
        // The picker lists what the selection can become, or, once a soft
        // body is picked, what to build it from ("2d" or "3d").
        newnode_change: false,
        newnode_soft: "",
        renaming: false,
        rename_text: "",
        chip_state: {},
        compact: false,
        // The room's answers the docks were last folded for: a change is a
        // new screen, whatever the class words did.
        screen_key: "",
        // What the reader set, kept apart from what the screen makes of it:
        // a touch screen draws larger without moving the setting.
        touchscreen: false,
        // Whether the first frame has run: the start-up states apply on it,
        // after the screen's room has folded the docks.
        platform_read: false,
        release_at: -1,
        states_applied: false,
        start_states: "",
        script_buffers: {},
        schemas: {},
        expects: {},
        opened: {},
        script_dirty: {},
        script_disk: {},
        script_held: {},
        disk_new: false,
        disk_up: false,
        collapsed: {},
        outline_rows: 0,
        // The panel `view:<id>` asked for, and the rect last logged for it.
        view_shot: "",
        view_logged: "",
        // Where the code pane is asked to scroll to, in design px; below zero
        // leaves it where the reader left it, and one frame is all it takes.
        code_scroll: -1.0,
        // Bumped when the open buffer is written from outside the editor, so
        // the code sheet writes its text again; typing is the widget's own.
        code_revision: 0,
        // The stage width the layout self-test last saw, so it asserts on a
        // settled shell rather than on the frame it was still bootstrapping.
        layout_seen: -1.0,
        form: [],
        inspect: inspector::fresh(),
        inspector_after: 0.0,
        tree_cache: left::TreeCache { key: "", rows: [] },
        // The guard on each word `signals` tells, and the keys each word was
        // last told for.
        told: {},
        inspector_key: nil,
        docks_key: nil,
        chrome_key: nil,
        status_key: nil,
        rail_key: nil,
        stage_key: nil,
        overlays_key: nil,
        // The self-tests under way, which step a frame each; see
        // `selftest::stepping`.
        stepping: [],
        bench: "",
        overlays_frame: -1,
        // The frame the viewport's tools last looked at the pointer: several
        // pointer words in one frame are one look.
        stepped: -1,
        layout_key: nil,
        // Bumped whenever another theme is worn or the worn one edited, so a
        // key can say the colours moved without holding the theme.
        theme_revision: 0,
        // `model::is_2d`'s answer, worked out when the rows are listed.
        is_2d_was: false,
        overlay3d: Overlay3d { key: [], lines: [] },
        // The selection set; `state.selected` is its head. Locks are editor state
        // keyed by node id, and isolate hides everything outside the set.
        selected: 0,
        selected_rows: [0],
        locks: {},
        // Four camera slots on the viewport chip row, kept for the session.
        bookmarks: {},
        isolated: false,
        isolate_hidden: [],
        fps: 0.0,
        // -1 when the layout self-test is not running.
        layout_demo: -1,
        // The same for the row views' test, and the row it asks for.
        rows_demo: -1,
        plugin_demo: -1,
        profile_demo: -1,
        events_demo: -1,
        palette_demo: -1,
        import_demo: -1,
        import_waited: 0,
        rows_want: 0,
        rows_waited: 0,
        gesture_demo: -1,
        gesture_from: [],
        frame: 0,
        // `frames=<directory>`: a PNG every `every` frames from `from`, numbered.
        capture: nil,
        show_input: false,
        screen_width: 1280.0,
        screen_height: 800.0,
        viewport: Viewport { x: 322.0, y: 112.0, width: 640.0, height: 482.0, at: 0 },
        rail_visible: false,
        // Whether the stage is worth labelling: a strip of it behind an
        // unfolded panel is the way back, not a viewport.
        stage_chrome: true,
        rail_shut: false,
        chrome_off: false,
        fontdemo: false,
        menu_open: false,
        // A document is over the scene; the hooks list is beside it.
        doc_open: false,
        hooks_open: false,
        // The code with the window to itself. `focus_was` is the layout it
        // folded, and nothing but leaving focus reads it.
        focus: false,
        focus_was: nil,
        layout: layout::state(),
        // Whether the centre is showing the viewport this frame, rather than
        // a document over it.
        viewport_live: true,
        mode2d: false,
        sources: {},
        // The edited scene's whole document, so a save keeps what the editor
        // does not model and the mirror sees its `[[assets]]`.
        scene_doc: {},
        listings: {},
        clip: nil,
        hooks_source: "",
        hooks_live: [],
        log_level: ALL,
        log_query: "",
        // Per-frame and per-session caches, built on first use.
        log_cache: nil,
        // Where `log::since` left off, and the rows the log node was last given.
        log_cursor: 0,
        panels: nil,
        palette_cache: nil,
        newnode_cache: nil,
        brand: nil,
        mirror: nil,
        theme: theme::dark(),
        // The half a start-up state pinned for the run, or "" to follow the mode.
        theme_half: "",
        gizmo: gizmo::state(),
        // The mouse button a camera drag begun on the stage holds, or -1.
        camera_drag: -1,
        complete: complete::state(),
        docs: docs::state(),
        refactor: refactor::state(),
        textedit: textedit::state(),
        rig: rig::state(),
        polygon: polygon::state(),
        // Where the Physics panel's pills drew this frame, for the selftest
        // that presses them.
        viewport_check: nil,
        camera_check: nil,
        pick_check: nil,
        picture_check: nil,
        pool_check: nil,
        reselect: nil,
        empty_note: nil,
        start_check: nil,
        pen: pen::state(),
        weights: weights::state(),
        bonemap: bonemap::state(),
        machine: statemachine::state(),
        tiles: tiles::state(),
        anim: anim::state(),
        debug: shell::debug_state(),
        events: events::state(),
        exporter: exporter::state(),
        populate: populate::state(),
        // Set once a tool edits the scene's `[[assets]]` blocks, so a save
        // writes them back as well as the nodes.
        assets_touched: false,
        // This batch of imports, by the source each reports: the ones running
        // and the ones lately ended. `chrome::toast` draws them.
        jobs: {},
        // What `imports:` still has to start, and the frame it starts on.
        import_queue: [],
        import_drip: false,
        session: session::state(),
        settings: settings::state(),
        themewin: themewin::state(),
        window: window::state(),
        search: {},
        showcase: showcase::state(),
        inputview: inputview::state(),
        library: library::state(),
        manager: manager::state(),
        lint: lint::state(),
        assets: dock::assets_state(),
        plugins: {},
        registry: plugins::state(),
        scene_root: nil,
        nodes: [],
        edited: nil,
        played: "",
        last_played: "",
        stopped_as: "",
        game_root: "",
        game_name: "",
        scene_rel: "",
        scene_path: "",
        script_profiling: false,
        history: history::History { past: [], future: [], saved: 0, key: nil, at: 0.0 },
        import_texture: importer::Held { rel: "", source: "" },
        import_shipped: importer::ImportShipped { rel: "", rows: [] },
        system_fonts: nil,
        font_finding: nil,
        font_families: nil,
        font_requests: {},
        kit_state: nil,
        rows_query: "",
        suite: nil,
    }
}

/// What `init` sets up, and what a `suite` run sets up again before each of
/// its states. `listen` only the first time: a listener added twice hears
/// every event twice.
pub fn boot(state: &mut State, editor: Node, listen: bool) {
    model::load(state);
    ui::set_load_progress(0.3);
    plugins::load(state);
    if listen {
        // Exports and imports run off the frame and report back here as they go.
        for name in ["export_event", "import_event", "release_event", "forge_event", "picture_event"] {
            events::listen(editor, name);
        }
        signals::hear_own(editor);
        signals::hear_engine(editor);
        signals::hear_boxes(state, editor);
    }
    // Before the theme and the scale are pushed: the preferences decide both,
    // and until this ran they only took effect once Settings was opened.
    settings::load_files(state);
    theme::apply(state);
    chrome::set_app_icon(engine::dark_mode());
    state.touchscreen = engine::target().touchscreen;
    signals::inspector(state);
    shell::apply_ui_scale(state);
    render::set_grid(true, 1.0, 5, 20);
    shell::apply_camera(state);
    log::info("editing {state.game_name} ({state.nodes.len()} nodes)");
    signals::outline(state);
    signals::docks(state);
}

impl Editor {
    pub fn init() {
        self.state = fresh_state();
        boot(self.state, self.node, true);
        // Optional start-up states, comma-separated (workspace id, "palette",
        // "light", "play", "select:<node>"), applied in order on the first
        // frame, after the screen's class has folded the docks.
        let arguments = engine::args();
        self.state.start_states = if arguments.len() > 1 { arguments[1] } else { "" };
        settings::recall_window_size(self.state);
        disk::follow(self.state);
    }

    pub fn update(delta_time: float) {
        suite::reboot(self.state, self.node);
        frame(self.state, delta_time);
        // Last: a reopen replaces `self.state`, and a call made back into the
        // Editor later in this one would still be handed the old state.
        suite::step(self.state);
    }

    // The system turned dark or light; the theme follows under `mode = "system"`.
    pub fn on_dark_mode_changed(dark: bool) {
        theme::follow(self.state, dark);
        chrome::set_app_icon(dark);
    }

    // Every export reports here: started, done or failed, one call per step.
    pub fn on_export_event(event: any) {
        exporter::report(self.state, event);
    }

    // A release check or install reports here, for the start screen and About.
    pub fn on_release_event(event: any) {
        manager::heard(self.state, event);
    }

    // A picture of the scene, written or not.
    pub fn on_picture_event(event: any) {
        shell::picture_done(event);
    }

    // A Forge search, add, fetch or copy: the Library and the start screen
    // each keep what they asked for.
    pub fn on_forge_event(event: any) {
        library::heard(self.state, event);
        manager::forge_heard(self.state, event);
    }

    // Every import reports here: what is coming, each file, then the end.
    pub fn on_import_event(event: any) {
        dropin::report(self.state, event);
    }

    // The window is closing: the next run opens at its size.
    pub fn on_quit_requested() {
        settings::keep_window_size(self.state);
    }

    /// The window changed size.
    pub fn on_resize(_width: float, _height: float) {
        relayout(self.state);
    }

    /// One of the shell's boxes moved: a seam was dragged, a dock eased open, or
    /// the layout's own write landed.
    pub fn on_resized(_box: any) {
        relayout(self.state);
    }

    /// Lay the shell out again, for a module that changed what it holds.
    pub fn relayout_shell() {
        relayout(self.state);
    }

    /// A search control's edit: the query under the `id` it carries.
    pub fn search_typed(id: any, text: any, control: Node) {
        search::typed(self.state, id.as_str(), text.as_str());
        refill_panel(control);
    }

    /// A pooled control's edit, for the function its spec's data names: see
    /// `pool::on`.
    pub fn handle(data: any, value: any, control: Node) {
        let handler: fn(&mut State, any, any) = data[fields::FN];
        handler(self.state, data, value);
        refill_panel(control);
    }

    /// The same for Enter in a field: see `pool::on_submit`.
    pub fn handle_submit(data: any, value: any, control: Node) {
        let handler: fn(&mut State, any, any) = data[project_fields::SUBMIT];
        handler(self.state, data, value);
        refill_panel(control);
    }

    /// Reload kept every field of the Editor whose name and type held; the
    /// theme is pushed again, since a theme edit is what a reload often is.
    pub fn on_hot_reload() {
        theme::apply(self.state);
        ui::request_repaint();
    }
}

// One frame: the frame rate, the splash, the capture, and every per-frame
// driver; the start screen has its own short list.
fn frame(state: &mut State, delta_time: float) {
    // Smoothed frame rate for the status bar; a raw 1/delta_time reads as noise.
    if delta_time > 0.0 {
        let now = 1.0 / delta_time;
        state.fps = (if state.fps == 0.0 { now } else { state.fps }) * 0.9 + now * 0.1;
    }
    state.frame += 1;
    shell::release_world(state);
    // The splash holds until the shell stops moving: every box is read back a
    // pass after it was written, so the sizes correct themselves for several.
    // `FORM_BY` is where it gives up waiting.
    if !state.formed {
        let ready = state.frame >= 3 && layout::settled(state);
        if ready || state.frame >= FORM_BY {
            state.formed = true;
            ui::finish_loading();
        } else {
            ui::set_load_progress(util::clamp(0.4 + 0.06 * state.frame, 0.0, 0.95));
        }
    }
    // Above the start screen's own return: a clip of a project converting is
    // taken on that screen, and it has no other frame to be caught on.
    if state.capture != nil {
        let capture = state.capture.unwrap();
        if state.frame >= capture.from && (state.frame - capture.from) % capture.every == 0 {
            render::screenshot("{capture.directory}/{padded(capture.count)}.png");
            capture.count += 1;
            state.capture = capture;
        }
    }
    // The start screen has no scene to step, no selection to follow and no
    // gizmo to drag: what it needs from a frame is the states and the
    // showcase, whose sequence turns this screen's own pages.
    if manager::showing(state) {
        showcase::step(state);
        apply_start_states(state);
        if state.stepping.len() > 0 {
            selftest::step_all(state, true);
        }
        showcase::acts(state);
        // An install or a conversion reports as events, which wake the loop.
        if !state.formed || state.showcase != nil || state.capture != nil || state.stepping.len() > 0 {
            ui::request_repaint();
        }
        return;
    }
    // The sweep a script edit asked for, once typing has stopped.
    lint::idle(state);
    session::update(state);
    // One queued import a frame once the shell has formed, so a shot catches
    // several at once.
    if state.import_drip && state.formed && state.import_queue.len() > 0 {
        let next = state.import_queue.remove(0);
        dropin::take(state, next);
    }
    if state.stepping.len() > 0 {
        selftest::step_all(state, false);
    }
    showcase::step(state);
    anim::update(state);
    textedit::step(state);
    autosave::step(state);
    bench::step(state);
    // What moves without input asks for the next frame; under `[window]
    // low_processor` nothing else draws one. The splash and a queued import
    // count frames, so they ask too.
    let telling = state.jobs.len() > 0 || state.import_queue.len() > 0 || !state.formed;
    if state.playing || state.showcase != nil || session::scrubbing(state) || state.capture != nil
        || state.stepping.len() > 0 || telling || layout::animating(state) || state.gizmo.drag != nil
        || state.debug.demo != nil || textedit::waiting(state) || autosave::waiting(state)
    {
        ui::request_repaint();
    }
    // Every live value the Inspector shows may have moved this frame.
    if state.playing {
        signals::playing_frame(state);
    }
    // A run of edits the Inspector's rows followed alone has stopped.
    if state.inspector_after > 0.0 {
        if engine::unix_time() >= state.inspector_after {
            state.inspector_after = 0.0;
            signals::refill_inspector(state);
        } else {
            ui::request_repaint();
        }
    }
    // After the frame's ticks, where a pass used to apply them: a state that
    // starts a recording starts it on the tick its replay will.
    if state.platform_read {
        apply_start_states(state);
    }
    showcase::acts(state);
}

// The `--state` list, applied once. Read here rather than at `init`, because
// a state that folds a dock has to run after the screen has been measured.
fn apply_start_states(state: &mut State) {
    if state.states_applied {
        return;
    }
    state.states_applied = true;
    for token in state.start_states.split(",") {
        if token != "" {
            shell::apply_start_state(state, token);
        }
    }
}

/// Lay the shell out again: the room it has, what the centre shows, and every
/// box sized once. On the window's resize, on a box's own `resized`, and on
/// the words that change what the docks and the centre hold; never a pass.
fn relayout(state: &mut State) {
    // The room the shell has, which the engine solved: the window less what a
    // notch covers. The window stands in until the shell has drawn once.
    let window = ui::window_size();
    let room = layout::shell_room(state);
    state.screen_width = if room.width > 0.0 { room.width } else { window.x };
    state.screen_height = if room.height > 0.0 { room.height } else { window.y };
    // Either forces it on: the setting asks for it at any width, and a narrow
    // window asks for it whatever the setting says.
    state.compact = state.settings.compact || window.x < COMPACT_WIDTH;
    signals::inspector(state);
    // A state that folds a dock has to run after the screen has been measured,
    // which this is; `update` applies them, at the end of the frame's ticks.
    if room.width > 0.0 {
        state.platform_read = true;
    }
    docks::follow_screen(state);
    if manager::showing(state) {
        return;
    }
    // Decide what is showing, then size every sheet once.
    center::modes(state);
    layout::compute(state);
    report_view(state);
    signals::bars(state);
    widget_layer(state);
    if state.fontdemo {
        selftest::font_sheet(state);
    }
}

// The game's UI layer, clipped to the viewport during play and in the
// Interface workspace; placed when the stage, play or the workspace moves.
fn widget_layer(state: State) {
    let rect = gizmo::viewport_rect(state);
    let widgets_on = (state.playing || state.workspace == defs::WORKSPACE_UI) && state.viewport_live;
    // Inset by the strip the axis and zoom pills own, so a bottom-anchored
    // HUD label sits above the editor's chrome instead of under it.
    let band = if widgets_on { center::hud_height(state) + 6.0 } else { 0.0 };
    ui::set_widget_layer(widgets_on, rect.x, rect.y, rect.width, util::max(0.0, rect.height - band));
}

/// What the layout is decided from besides the boxes themselves, so a word
/// that moved none of it, as a frame of play does, lays nothing out.
fn layout_key(state: State) -> any {
    [
        state.workspace, state.doctab, state.split, state.focus, state.settings.compact, state.touchscreen,
        "{state.docks}", state.rail_shut, state.chrome_off, state.script_open, state.events_open,
        state.selected, state.shader_rel, ui::scale(), manager::showing(state),
    ]
}

fn relayout_if_moved(state: &mut State) {
    let key = layout_key(state);
    if key == state.layout_key {
        return;
    }
    state.layout_key = key;
    relayout(state);
}

// Six digits, so a frame directory sorts as it was captured.
fn padded(number: int) -> str {
    let digits = "{number}";
    while digits.len() < 6 {
        digits = "0" + digits;
    }
    digits
}

/// Where the panel `view:<id>` asked for was drawn, in device pixels, so a
/// design pass can cut it out of the shot. Logged each time it moves: the
/// last line a run logs is the rect `--shot` saw.
fn report_view(state: &mut State) {
    if state.view_shot == "" {
        return;
    }
    let side = docks::side_of(state, state.view_shot);
    if side == nil {
        return;
    }
    let rect = state.layout[side.unwrap()];
    let scale = viewport::logical_per_design();
    let line = "viewrect {state.view_shot} {rect["x"].as_float() * scale} {rect["y"].as_float() * scale} {rect[layout_fields::WIDTH].as_float() * scale} {rect[layout_fields::HEIGHT].as_float() * scale}";
    if line != state.view_logged {
        state.view_logged = line;
        log::info(line);
    }
}

// What the document decides beside its outline: whether the scene is 2D,
// which scripts the sweep compiles, and what the engine warns about it.
fn follow_document(state: &mut State) {
    if manager::showing(state) {
        return;
    }
    let is2d = model::is_2d(state);
    if is2d != state.mode2d {
        state.mode2d = is2d;
        render::set_grid(!is2d, 1.0, 5, 20);
        shell::apply_camera(state);
        draw_overlays(state);
    }
    lint::follow(state);
    if state.lint.stale {
        lint::node_warnings(state);
    }
}

// The viewport's tools and the camera, once a frame the pointer did
// something in. A replay or a showcase feeds the pointer into the snapshot
// the tools read, so a drag would follow the feed rather than the mouse.
fn viewport_step(state: &mut State) {
    if state.stepped == state.frame || manager::showing(state) {
        return;
    }
    state.stepped = state.frame;
    if session::scrubbing(state) || showcase::feeding(state) {
        return;
    }
    // The camera's own: two fingers on the stage, or the mouse buttons and
    // wheel the editor drives itself. A gizmo never sees one.
    if !viewport::camera_gesture(state) && !viewport::mouse_camera(state) {
        gizmo::update(state);
    }
    gizmo::fill_marquee(state);
    textedit::update(state);
    if state.tool == "key" && state.workspace == defs::WORKSPACE_ANIMATION
        && input::mouse_just_pressed(input::MOUSE_BUTTON_LEFT)
    {
        anim::add_key(state, state.anim.time);
    }
    // Drawn now rather than on a word: a word is heard the frame after, and
    // the lines would trail the node they are dragging.
    let mouse = viewport::pointer(state);
    let over = state.viewport_live && viewport::owns_pointer(state, mouse.x, mouse.y);
    if signals::overlays_moved(state, over) {
        draw_overlays(state);
    }
}

// The viewport's lines, drawn and kept until they are drawn again: the
// gizmo, the rig, the tools, the guides and a plugin's overlays.
fn draw_overlays(state: &mut State) {
    state.overlays_frame = state.frame;
    if manager::showing(state) {
        render::clear_retained(VIEWPORT);
        return;
    }
    render::begin_retained(VIEWPORT);
    if state.mode2d {
        overlays::grid2d(state);
    }
    gizmo::draw(state);
    plugins::draw_overlays(state);
    rig::draw(state);
    if !session::scrubbing(state) {
        polygon::idle(state);
    }
    polygon::draw(state);
    pen::draw(state);
    tiles::draw(state);
    if state.workspace == defs::WORKSPACE_SCENE && defs::chip_on(state.chip_state, state.workspace, defs::CHIP_GUIDES) {
        overlays::guides(state);
    }
    if state.mode2d && defs::chip_on(state.chip_state, state.workspace, defs::CHIP_LIGHTS) {
        overlays::lights2d(state);
    }
    if state.workspace == defs::WORKSPACE_ANIMATION && defs::chip_on(state.chip_state, state.workspace, defs::CHIP_PATH) {
        overlays::motion_path(state);
    }
    if !state.mode2d && defs::chip_on(state.chip_state, state.workspace, defs::CHIP_LIGHTS) {
        overlays::lights3d(state);
    }
    if state.workspace == defs::WORKSPACE_PHYSICS && defs::chip_on(state.chip_state, state.workspace, defs::CHIP_COLLIDERS) {
        if state.mode2d {
            overlays::colliders2d(state);
        } else {
            overlays::colliders(state);
        }
    }
    render::end_retained();
}

impl Editor {
    // The outliner's context menu, one method a row. The right click that opened
    // it picked the row under the pointer, so each acts on the selection.
    pub fn tree_add_child() {
        newnode::open(self.state);
    }

    // A card dragged out of the Assets dock, let go wherever the pointer is.
