use search;
use signals;
use statemachine;
use suite;
use tests::panel_checks;
use textedit;
use theme;
use themewin;
use tiles;
use timeline;
use util;
use versions;
use weights;
use window;
use words::changes;
use words::fields;
use words::layout_fields;
use words::project_fields;
use words::tabs;
use words::tools;

const ALL: str = "all";

/// The Editor node's script: the node it runs on and everything it keeps.
pub class Editor {
    node: Node,
    state: State,
}

/// Every field the editor keeps. A scalar starts at its default, and
/// `fresh_state` names the rest. A map keyed by a name or an id is an `any`,
/// and so is a key: what a cache was built from, compared whole.
pub class State {
    internal workspace: str,
    internal tool: str,
    internal doctab: str,
    // A shader opened from a material; empty means the code pane shows
    // the selected node's script instead.
    internal shader_rel: str = "",
    // The shader line the viewport draws the value of; 0 draws the scene.
    internal preview_line: int = 0,
    internal preview_rel: str = "",
    internal docks: any,
    // The centre split: code and viewport side by side, instead of the
    // document tabs swapping one for the other.
    internal split: bool = false,
    // The closable document tabs; the scene's is always there.
    internal script_open: bool = false,
    internal events_open: bool = false,
    internal zoom: float = 100.0,
    internal playing: bool = false,
    internal formed: bool = false,
    internal palette: bool = false,
    internal palette_query: str = "",
    internal palette_submit: bool = false,
    // Whether the picker's field has been handed the caret since it
    // opened; it takes it once, not every frame.
    internal picker_focused: bool = false,
    internal newnode: bool = false,
    internal newnode_query: str = "",
    // The picker lists what the selection can become, or, once a soft
    // body is picked, what to build it from ("2d" or "3d").
    internal newnode_change: bool = false,
    internal newnode_soft: str = "",
    internal renaming: bool = false,
    internal rename_text: str = "",
    internal chip_state: any,
    internal compact: bool = false,
    // The room's answers the docks were last folded for: a change is a
    // new screen, whatever the class words did.
    internal screen_key: str = "",
    // What the reader set, kept apart from what the screen makes of it:
    // a touch screen draws larger without moving the setting.
    internal touchscreen: bool = false,
    // Whether the first frame has run: the start-up states apply on it,
    // after the screen's room has folded the docks.
    internal platform_read: bool = false,
    internal release_at: int = -1,
    internal states_applied: bool = false,
    internal start_states: str = "",
    internal script_buffers: any,
    internal schemas: any,
    internal expects: any,
    internal opened: any,
    // Each open buffer typed into since it was written, by its path, with
    // the wall-clock second it was last typed into.
    internal script_dirty: any,
    // What each buffer's file held when they last agreed, by path: anything
    // else on disk was written by something other than this editor.
    internal script_disk: any,
    // Buffers whose file moved under them, which the autosave leaves alone
    // until the Changed on disk sheet has an answer for each.
    internal script_held: any,
    // A buffer was held since the sheet last filled.
    internal disk_new: bool = false,
    // The sheet was put up, so its being down means it was shut unanswered.
    internal disk_up: bool = false,
    internal collapsed: any,
    // Moved whenever the rows the outline shows may have.
    internal outline_rows: int = 0,
    // The panel `view:<id>` asked for, and the rect last logged for it.
    internal view_shot: str = "",
    internal view_logged: str = "",
    // Where the code pane is asked to scroll to, in design px; below zero
    // leaves it where the reader left it, and one frame is all it takes.
    internal code_scroll: float = -1.0,
    // Bumped when the open buffer is written from outside the editor, so
    // the code sheet writes its text again; typing is the widget's own.
    internal code_revision: int = 0,
    // The stage width the layout self-test last saw, so it asserts on a
    // settled shell rather than on the frame it was still bootstrapping.
    internal layout_seen: float = -1.0,
    /// The rows the Import tab's form was last filled with.
    internal form: [form::Row],
    /// The Inspector's lines and which of them are on screen.
    internal inspect: inspector::Form,
    /// When the Inspector's whole form is filled again after a run of edits
    /// its rows followed alone; 0 for none pending.
    internal inspector_after: float = 0.0,
    /// The frames `util::wake_at` last asked for, for the refill and for the
    /// next autosave write.
    internal inspector_asked: float = 0.0,
    internal autosave_asked: float = 0.0,
    internal tree_cache: left::TreeCache,
    // The guard on each word `signals` tells, and the keys each word was
    // last told for.
    internal told: any,
    internal inspector_key: any,
    internal docks_key: any,
    internal chrome_key: any,
    internal status_key: any,
    internal rail_key: any,
    internal stage_key: any,
    internal overlays_key: any,
    // The self-tests under way, which step a frame each; see
    // `selftest::stepping`.
    internal stepping: [str],
    // The edit `--state bench:` makes every frame, or "".
    internal bench: str = "",
    // The frames `--state idle:` is counting, or nil.
    internal idle: bench::Idle?,
    internal overlays_frame: int = -1,
    // The frame the viewport's tools last looked at the pointer: several
    // pointer words in one frame are one look.
    internal stepped: int = -1,
    internal layout_key: any,
    // Bumped whenever another theme is worn or the worn one edited, so a
    // key can say the colours moved without holding the theme.
    internal theme_revision: int = 0,
    // `model::is_2d`'s answer, worked out when the rows are listed.
    internal is_2d_was: bool = false,
    internal overlay3d: Overlay3d,
    // The selection set; `state.selected` is its head. Locks are editor state
    // keyed by node id, and isolate hides everything outside the set.
    internal selected: int = 0,
    internal selected_rows: [int],
    internal locks: any,
    // Four camera slots on the viewport chip row, kept for the session.
    internal bookmarks: any,
    internal isolated: bool = false,
    /// What isolate hid, to show again when it is left.
    internal isolate_hidden: [Node],
    internal fps: float = 0.0,
    // -1 when the layout self-test is not running.
    internal layout_demo: int = -1,
    // `test:rail`'s frames since it started; -1 at rest.
    internal rail_demo: int = -1,
    // The same for the row views' test, and the row it asks for.
    internal rows_demo: int = -1,
    internal plugin_demo: int = -1,
    /// `test:profiler`'s frames since it switched counting on; -1 at rest.
    internal profile_demo: int = -1,
    internal events_demo: int = -1,
    internal palette_demo: int = -1,
    internal import_demo: int = -1,
    internal import_waited: int = 0,
    internal rows_want: int = 0,
    internal rows_waited: int = 0,
    internal gesture_demo: int = -1,
    internal gesture_from: [float],
    internal frame: int = 0,
    // `frames=<directory>`: a PNG every `every` frames from `from`, numbered.
    internal capture: shell::Capture?,
    internal show_input: bool = false,
    internal screen_width: float = 1280.0,
    internal screen_height: float = 800.0,
    internal viewport: Viewport,
    internal rail_visible: bool = false,
    // Whether the stage is worth labelling: a strip of it behind an
    // unfolded panel is the way back, not a viewport.
    internal stage_chrome: bool = true,
    internal rail_shut: bool = false,
    internal chrome_off: bool = false,
    internal fontdemo: bool = false,
    internal menu_open: bool = false,
    // A document is over the scene; the hooks list is beside it.
    internal doc_open: bool = false,
    internal hooks_open: bool = false,
    // The code with the window to itself. `focus_was` is the layout it
    // folded, and nothing but leaving focus reads it.
    internal focus: bool = false,
    internal focus_was: any,
    internal layout: any,
    // Whether the centre is showing the viewport this frame, rather than
    // a document over it.
    internal viewport_live: bool = true,
    internal mode2d: bool = false,
    internal sources: any,
    // The edited scene's whole document, so a save keeps what the editor
    // does not model and the mirror sees its `[[assets]]`.
    internal scene_doc: any,
    internal listings: any,
    internal clip: anim::Clip?,
    internal hooks_source: str = "",
    internal hooks_live: [center::Parsed],
    internal log_level: str,
    internal log_query: str = "",
    // Per-frame and per-session caches, built on first use.
    internal log_cache: dock::Built?,
    // Where `log::since` left off, and the rows the log node was last given.
    internal log_cursor: int = 0,
    internal panels: docks::Panels?,
    internal palette_cache: palette::Found?,
    internal newnode_cache: [newnode::Entry]?,
    internal brand: chrome::Brand?,
    internal mirror: Node?,
    /// The edited scene's root, the one node under `mirror` the scene file
    /// builds.
    internal scene_root: Node?,
    /// The scene's nodes in tree order, its root first: the rows every tool
    /// and panel addresses by index (`model::reindex`).
    internal nodes: [Node],
    /// A component a tool is changing in place, held for the frame.
    internal edited: model::Edited?,
    /// The scene as play found it, which stop builds again.
    internal played: str = "",
    /// The text the last play ran from, and what the scene reads as once
    /// stopping has rebuilt it: while it still reads so, nothing was edited.
    internal last_played: str = "",
    internal stopped_as: str = "",
    internal theme: any,
    // The half a start-up state pinned for the run, or "" to follow the mode.
    internal theme_half: str = "",
    internal gizmo: gizmo::GizmoState,
    // The mouse button a camera drag begun on the stage holds, or -1.
    internal camera_drag: int = -1,
    internal complete: complete::CompleteState,
    internal docs: docs::DocsState,
    internal refactor: refactor::RefactorState,
    internal textedit: textedit::TexteditState,
    internal rig: rig::RigState,
    internal polygon: polygon::PolygonState,
    // Where the Physics panel's pills drew this frame, for the selftest
    // that presses them.
    internal viewport_check: selftest::ViewportCheck?,
    internal camera_check: selftest::CameraCheck?,
    internal pick_check: selftest::PickCheck?,
    internal picture_check: selftest::PictureCheck?,
    internal pool_check: selftest::PoolCheck?,
    internal form_check: panel_checks::FormCheck?,
    internal reselect: selftest::Reselect?,
    internal empty_note: selftest::EmptyNote?,
    internal reads_check: selftest::ReadsCheck?,
    internal start_check: selftest::StartCheck?,
    internal pen: pen::PenState,
    weights: weights::WeightsState,
    internal bonemap: bonemap::BonemapState,
    internal machine: statemachine::StatemachineState,
    internal tiles: tiles::TilesState,
    internal anim: anim::AnimState,
    internal debug: shell::DebugState,
    events: events::EventsState,
    internal exporter: exporter::ExporterState,
    internal populate: populate::PopulateState,
    // Set once a tool edits the scene's `[[assets]]` blocks, so a save
    // writes them back as well as the nodes.
    internal assets_touched: bool = false,
    // This batch of imports, by the source each reports: the ones running
    // and the ones lately ended. `chrome::toast` draws them.
    internal jobs: any,
    // What `imports:` still has to start, and the frame it starts on.
    internal import_queue: [str],
    internal import_drip: bool = false,
    internal session: session::SessionState,
    internal settings: settings::SettingsState,
    internal themewin: themewin::ThemewinState,
    internal window: window::WindowState,
    internal search: any,
    internal showcase: showcase::Sequence?,
    inputview: any,
    internal library: library::LibraryState,
    internal manager: manager::ManagerState,
    internal lint: lint::LintState,
    internal assets: dock::AssetsState,
    plugins: any,
    internal registry: plugins::PluginsState,
    // What `model::load` reads from the project: where it is and what it is
    // called. The scene itself is the live nodes under `mirror`.
    internal game_root: str = "",
    internal game_name: str = "",
    internal scene_rel: str = "",
    internal scene_path: str = "",
    internal script_profiling: bool = false,
    internal history: history::History,
    internal import_texture: importer::Held,
    internal import_shipped: importer::ImportShipped,
    /// The installed faces the font picker offers, by the label it shows
    /// them under, to their files; nil until the picker first asks.
    internal system_fonts: any,
    /// The font catalogue while it is up over the picker.
    internal font_finding: fonts::Finding?,
    /// The catalogue's families, nil until Forge has answered.
    internal font_families: any,
    /// What each request to the catalogue is for, by its id.
    internal font_requests: any,
    internal kit_state: any,
    internal rows_query: str = "",
    internal suite: suite::Run?,
}

/// The 3D light and camera marks, and what they were drawn for.
pub struct Overlay3d {
    internal key: [any],
    internal lines: [render::Line3d],
}

/// The viewport's rect in design pixels, and the frame it was read on.
pub struct Viewport {
    internal x: float,
    internal y: float,
    internal width: float,
    internal height: float,
    internal at: int,
}

/// The starting values no default can state: the constants, the maps and
/// lists, and each module's own state. A field left out starts at its default
/// or nil.
pub fn fresh_state() -> State {
    State {
        workspace: tabs::SCENE,
        tool: tools::SELECT,
        doctab: tabs::SCENE,
        docks: docks::state(),
        chip_state: {},
        script_buffers: {},
        schemas: {},
        expects: {},
        opened: {},
        script_dirty: {},
        script_disk: {},
        script_held: {},
        collapsed: {},
        form: [],
        inspect: inspector::fresh(),
        tree_cache: left::TreeCache { key: "", rows: [] },
        told: {},
        stepping: [],
        overlay3d: Overlay3d { key: [], lines: [] },
        selected_rows: [0],
        locks: {},
        bookmarks: {},
        isolate_hidden: [],
        gesture_from: [],
        viewport: Viewport { x: 322.0, y: 112.0, width: 640.0, height: 482.0, at: 0 },
        layout: layout::state(),
        sources: {},
        scene_doc: {},
        listings: {},
        hooks_live: [],
        log_level: ALL,
        theme: theme::dark(),
        gizmo: gizmo::state(),
        complete: complete::state(),
        docs: docs::state(),
        refactor: refactor::state(),
        textedit: textedit::state(),
        rig: rig::state(),
        polygon: polygon::state(),
        pen: pen::state(),
        weights: weights::state(),
        bonemap: bonemap::state(),
        machine: statemachine::state(),
        tiles: tiles::state(),
        anim: anim::state(),
        debug: shell::debug_state(),
        events: events::state(),
        exporter: exporter::state(),
        populate: populate::state(),
        jobs: {},
        import_queue: [],
        session: session::state(),
        settings: settings::state(),
        themewin: themewin::state(),
        window: window::state(),
        search: {},
        showcase: showcase::state(),
        inputview: inputview::state(),
        library: library::state(),
        manager: manager::state(),
        lint: lint::state(),
        assets: dock::assets_state(),
        plugins: {},
        registry: plugins::state(),
        nodes: [],
        history: history::History { past: [], future: [], saved: 0, key: nil, at: 0.0 },
        import_texture: importer::Held { rel: "", source: "" },
        import_shipped: importer::ImportShipped { rel: "", rows: [] },
        font_requests: {},
    }
}

/// What `init` sets up, and what a `suite` run sets up again before each of
/// its states. `listen` only the first time: a listener added twice hears
/// every event twice.
pub fn boot(state: &mut State, editor: Node, listen: bool) {
    model::load(state);
    ui::set_load_progress(0.3);
    plugins::load(state);
    if listen {
        // Exports and imports run off the frame and report back here as they go.
        for name in ["export_event", "import_event", "release_event", "forge_event", "picture_event"] {
            events::listen(editor, name);
        }
        signals::hear_own(editor);
        signals::hear_engine(editor);
        signals::hear_boxes(state, editor);
    }
    // Before the theme and the scale are pushed: the preferences decide both,
    // and until this ran they only took effect once Settings was opened.
    settings::declare();
    settings::load_files(state);
    theme::apply(state);
    chrome::set_app_icon(engine::dark_mode());
    state.touchscreen = engine::target().touchscreen;
    signals::inspector(state);
    shell::apply_ui_scale(state);
    shell::apply_camera(state);
    log::info("editing {state.game_name} ({state.nodes.len()} nodes)");
    signals::outline(state);
    signals::docks(state);
}

impl Editor {
    pub fn init() {
        self.state = fresh_state();
        boot(self.state, self.node, true);
        // Optional start-up states, comma-separated (workspace id, "palette",
        // "light", "play", "select:<node>"), applied in order on the first
        // frame, after the screen's class has folded the docks.
        let arguments = engine::args();
        self.state.start_states = if arguments.len() > 1 { arguments[1] } else { "" };
        settings::recall_window_size(self.state);
        disk::follow(self.state);
        session::follow(self.state);
    }

    pub fn update(delta_time: float) {
        suite::reboot(self.state, self.node);
        frame::run(self.state, delta_time);
        // Last: a reopen replaces `self.state`, and a call made back into the
        // Editor later in this one would still be handed the old state.
        suite::step(self.state);
    }

    // The system turned dark or light; the theme follows under `mode = "system"`.
    pub fn on_dark_mode_changed(dark: bool) {
        theme::follow(self.state, dark);
        chrome::set_app_icon(dark);
    }

    // Every export reports here: started, done or failed, one call per step.
    pub fn on_export_event(event: any) { exporter::report(self.state, event); }

    // A release check or install reports here, for the start screen and About.
    pub fn on_release_event(event: any) { versions::heard(self.state, event); }

    // A picture of the scene, written or not.
    pub fn on_picture_event(event: any) { shell::picture_done(event); }

    // A Forge search, add, fetch or copy: the Library and the start screen
    // each keep what they asked for.
    pub fn on_forge_event(event: any) {
        library::heard(self.state, event);
        manager::forge_heard(self.state, event);
    }

    // Every import reports here: what is coming, each file, then the end.
    pub fn on_import_event(event: any) { dropin::report(self.state, event); }

    // The window is closing: the next run opens at its size.
    pub fn on_quit_requested() { settings::keep_window_size(self.state); }

    /// The window changed size.
    pub fn on_resize(_width: float, _height: float) { frame::relayout(self.state); }

    /// One of the shell's boxes moved: a seam was dragged, a dock eased open, or
    /// the layout's own write landed.
    pub fn on_resized(_box: any) { frame::relayout(self.state); }

    /// Lay the shell out again, for a module that changed what it holds.
    pub fn relayout_shell() { frame::relayout(self.state); }

    /// A search control's edit: the query under the `id` it carries.
    pub fn search_control_typed(id: any, text: any, control: Node) {
        search::typed(self.state, id.as_str(), text.as_str());
        refill_panel(control);
    }

    /// A pooled control's edit, for the function its spec's data names: see
    /// `pool::on`.
    pub fn handle(data: any, value: any, control: Node) {
        let handler: fn(&mut State, any, any) = data[fields::FN];
        handler(self.state, data, value);
        refill_panel(control);
    }

    /// The same for Enter in a field: see `pool::on_submit`.
    pub fn handle_submit(data: any, value: any, control: Node) {
        let handler: fn(&mut State, any, any) = data[project_fields::SUBMIT];
        handler(self.state, data, value);
        refill_panel(control);
    }

    /// Reload kept every field of the Editor whose name and type held; the
    /// theme is pushed again, since a theme edit is what a reload often is.
    pub fn on_hot_reload() {
        theme::apply(self.state);
        ui::request_repaint();
    }
}

impl Editor {
    // The outliner's context menu, one method a row. The right click that opened
    // it picked the row under the pointer, so each acts on the selection.
    pub fn tree_add_child() { newnode::open(self.state); }

    // A card dragged out of the Assets dock, let go wherever the pointer is.
    pub fn assets_dropped(card: any) { dock::drop_card(self.state, card); }

    pub fn tree_change_type() { newnode::open_change(self.state); }

    pub fn tree_move_up() { sceneedit::move_sibling(self.state, -1); }

    pub fn tree_move_down() { sceneedit::move_sibling(self.state, 1); }

    /// The palette, its first lines the verbs the selected node offers.
    pub fn tree_actions() { shell::open_palette(self.state, ""); }

    pub fn tree_attach_script() { shell::attach_script(self.state); }

    pub fn tree_duplicate() { sceneedit::duplicate_selected(self.state); }

    pub fn tree_toggle_hidden() { arrange::toggle_hidden(self.state); }

    pub fn tree_toggle_locked() { arrange::toggle_locked(self.state); }

    pub fn tree_rename() { left::rename_open(self.state); }

    // The eye or the lock at the right of an outliner row.
    pub fn on_outline_changed(_change: any) {
        signals::heard(self.state, signals::OUTLINE);
        frame::follow_document(self.state);
        frame::relayout_if_moved(self.state);
    }

    /// An answer to a request the editor sent: the font catalogue's.
    pub async fn await_font_reply(request: int) {
        let reply = await task::wait(request);
        fonts::answered(self.state, reply);
    }

    /// Files dropped on the window, imported where the pointer is.
    pub fn on_files_dropped(paths: any) {
        if manager::showing(self.state) {
            return;
        }
        for path in paths {
            dropin::take(self.state, path.as_str());
        }
    }

    /// The edited scene's writes this frame (`model::follow_changes`).
    pub fn on_changed(entries: any) {
        model::follow_changes(self.state, entries);
        frame::follow_document(self.state);
    }

    pub fn on_inspector_changed(_change: any) {
        signals::heard(self.state, signals::INSPECTOR);
        frame::relayout_if_moved(self.state);
        frame::widget_layer(self.state);
    }

    pub fn on_docks_changed(_change: any) {
        signals::heard(self.state, signals::DOCKS);
        frame::relayout_if_moved(self.state);
    }

    /// Fill a dock's tab row and show the panel it has up: what the dock's
    /// script asks for when the docks moved. Answers the node of a panel that
    /// fills itself, for the dock to tell once it shows.
    pub fn dock_fill(side: str) -> str { docks::fill(self.state, side) }

    pub fn on_problems_changed(_change: any) { signals::heard(self.state, signals::PROBLEMS_CHANGED); }

    pub fn on_docs_changed(_change: any) { signals::heard(self.state, "docs_changed"); }

    pub fn on_assets_changed(_change: any) { signals::heard(self.state, signals::ASSETS_CHANGED); }

    pub fn on_library_changed(_change: any) { signals::heard(self.state, "library_changed"); }

    pub fn on_tiles_changed(_change: any) { signals::heard(self.state, "tiles_changed"); }

    pub fn on_machine_changed(_change: any) { signals::heard(self.state, "machine_changed"); }

    pub fn on_recordings_changed(_change: any) { signals::heard(self.state, signals::RECORDINGS); }

    pub fn on_debugger_changed(_change: any) {
        signals::heard(self.state, signals::DEBUGGER_CHANGED);
        // A body play built, or one stopping took away, can warn without the
        // document moving.
        lint::node_warnings(self.state);
    }

    pub fn on_play_frame(_change: any) { signals::heard(self.state, signals::PLAY); }

    // What the pointer did, which is when the viewport's tools and the camera
    // look at it: the wheel, two fingers, a button, a move.
    pub fn on_pointer_moved(_spot: any) { frame::viewport_step(self.state); }

    pub fn on_pointer_pressed(_press: any) { frame::viewport_step(self.state); }

    pub fn on_pointer_released(_press: any) { frame::viewport_step(self.state); }

    pub fn on_pointer_scrolled(_turn: any) { frame::viewport_step(self.state); }

    pub fn on_pointer_gestured(_gesture: any) { frame::viewport_step(self.state); }

    /// Draw the viewport's lines again, on a word that what they show moved. The
    /// words of one frame are heard together and draw once.
    pub fn overlays_fill() {
        if self.state.overlays_frame != self.state.frame {
            frame::draw_overlays(self.state);
        }
    }

    pub fn on_chrome_changed(_change: any) {
        signals::heard(self.state, signals::CHROME);
        frame::relayout_if_moved(self.state);
    }

    pub fn on_status_changed(_change: any) { signals::heard(self.state, signals::STATUS); }

    pub fn on_sheet_changed(_change: any) { signals::heard(self.state, "sheet_changed"); }

    pub fn on_picker_changed(_change: any) { signals::heard(self.state, "picker_changed"); }

    pub fn on_manager_changed(_change: any) { signals::heard(self.state, "manager_changed"); }

    pub fn on_plugins_changed(_change: any) { signals::heard(self.state, signals::PLUGINS_CHANGED); }

    /// The scene's nodes in tree order, for a plugin reading the scene: a
    /// change made through the editor's verbs is one its undo takes back.
    pub fn nodes() -> [Node] { self.state.nodes }

    /// The folder of the game the editor has open, which a plugin's paths
    /// are relative to.
    pub fn game_root() -> str { self.state.game_root }

    /// The open scene's file; "" when none is open.
    pub fn open_scene_path() -> str { self.state.scene_path }

    /// The plugins the editor loaded, by file name.
    pub fn plugins() -> [str] { self.state.registry.loaded }

    /// Make row `row` of `document()` the selection.
    pub fn select(row: int) { shell::choose(self.state, row); }

    pub fn open_scene(rel: str) { model::open_scene(self.state, rel); }

    /// A plugin property editor's control writing its value: `data.at` is
    /// the `at` its `controls` method was handed.
    pub fn inspector_write(data: any, value: any, control: Node) {
        let at: inspector::AtTop = data[layout_fields::AT];
        inspector::write_at(self.state, at, value);
        refill_panel(control);
    }

    /// The kit, for a plugin filling its dock: see kit.bs. `part` names
    /// where on the dock `host`: "head", "foot", "side" or the body.
    pub fn kit_bar(host: str, part: str, controls: [ui::Control]) { kit::bar(host, part, controls); }

    pub fn kit_rows(host: str, part: str, specs: [any]) { kit::rows(host, part, specs); }

    pub fn kit_pages(host: str, id: str, groups: any) -> str { kit::pages(self.state, host, id, groups) }

    pub fn kit_heading(title: str) -> form::Row { kit::heading(title) }

    pub fn kit_empty(text: str) -> form::Row { kit::empty(text) }

    pub fn kit_field(label: str, value: any, options: any) -> form::Row {
        kit::field(self.state, label, value, options)
    }

    pub fn kit_tree(id: str, value: any, options: any) -> any { kit::tree(self.state, id, value, options) }

    pub fn kit_files(id: str, options: any) -> [form::Row] { kit::files(self.state, id, options) }

    pub fn kit_save_prefs() { kit::save_preferences(self.state); }

    pub fn kit_save_project() { kit::save_project(self.state); }

    pub fn kit_short_path(path: str) -> str { kit::short_path(path) }

    pub fn kit_changed() { kit::changed(self.state); }

    pub fn kit_open_dialog(id: str) { kit::open_dialog(self.state, id); }

    /// Have the plugin dock `id` fill its subtree, on a word its script heard.
    pub fn plugin_fill(id: str) { docks::fill_plugin(self.state, id); }

    /// The Import tab's form, and what its head says.
    pub fn import_fill() -> importer::Fill { importer::fill(self.state) }

    pub fn dialogs_fill() { plugins::fill_dialogs(self.state); }

    pub fn on_inputview_changed(_change: any) { signals::heard(self.state, "inputview_changed"); }

    /// The input overlay: where it goes, a key's chip, and the chips to show.
    pub fn inputview_view() -> inputview::View { inputview::view(self.state) }

    pub fn inputview_key(key: str) -> str { inputview::chip_of(key) }

    pub fn inputview_chips(names: [any]) { inputview::fill_chips(self.state, names); }

    /// The text edit field: where it is, what is typed, Enter, and leaving it.
    pub fn textedit_view() -> textedit::View { textedit::view(self.state) }

    pub fn textedit_typed(text: str) { textedit::typed(self.state, text); }

    pub fn textedit_submit(text: str) { textedit::submit(self.state, text); }

    pub fn textedit_close() { textedit::close(self.state); }

    pub fn on_textedit_changed(_change: any) { signals::heard(self.state, "textedit_changed"); }

    pub fn on_code_changed(_change: any) { signals::heard(self.state, signals::CODE_CHANGED); }

    pub fn on_complete_changed(_change: any) { signals::heard(self.state, "complete_changed"); }

    pub fn on_refactor_changed(_change: any) { signals::heard(self.state, "refactor_changed"); }

    /// The code sheet: what it shows, and what was typed, where the caret went
    /// and which gutter line was clicked.
    pub fn code_view() -> center::CodeView { center::code_view(self.state) }

    pub fn code_typed(text: str) { center::code_typed(self.state, text); }

    pub fn code_caret(caret: complete::Caret) { center::code_caret(self.state, caret); }

    pub fn code_gutter(line: int) { center::code_gutter(self.state, line); }

    /// Fill the event bindings tab.
    pub fn events_fill() { events::fill(self.state); }

    /// An open recording's lanes: fill them, the transport and the scrubber.
    pub fn lanes_fill() { lanes::fill(self.state); }

    pub fn lanes_verb(verb: str) { lanes::verb(self.state, verb); }

    pub fn lanes_seek(time: float) { lanes::seek(self.state, time); }

    /// The Timeline tab: fill it, seek the scrubber, and its verbs.
    pub fn timeline_fill() { timeline::fill(self.state); }

    pub fn timeline_seek(time: float) { anim::seek(self.state, time); }

    pub fn timeline_verb(verb: str) { timeline::verb(self.state, verb); }

    /// A clip setting the Timeline's head changed: its length or its loop.
    pub fn timeline_clip(setting: str, value: any) { timeline::clip(self.state, setting, value); }

    pub fn on_timeline_changed(_change: any) { signals::heard(self.state, signals::TIMELINE); }

    /// Fill the Weights tab from the polygon being edited.
    pub fn weights_fill() { weights::fill(self.state); }

    pub fn weights_verb(verb: str) { weights::verb(self.state, verb); }

    pub fn on_weights_changed(_change: any) { signals::heard(self.state, "weights_changed"); }

    /// Fill the Bone map tab from the rig selected and the map so far.
    pub fn bonemap_fill() { bonemap::fill(self.state); }

    pub fn bonemap_verb(verb: str) { bonemap::verb(self.state, verb); }

    pub fn on_bonemap_changed(_change: any) { signals::heard(self.state, "bonemap_changed"); }

    /// Fill the hooks list beside the code.
    pub fn hooks_fill() { center::fill_hooks(self.state); }

    /// The completion list: what it shows, its keys, and a row clicked.
    pub fn complete_view() -> complete::View { complete::view(self.state) }

    pub fn complete_key(name: str) { complete::key(self.state, name); }

    pub fn complete_pick(row: str) { complete::pick(self.state, row); }

    /// The refactor sheet: what it shows, a field typed, apply and cancel.
    pub fn refactor_view() -> refactor::View { refactor::view(self.state) }

    pub fn refactor_set(field: str, text: str) { refactor::set(self.state, field, text); }

    pub fn refactor_apply() { refactor::apply(self.state); }

    pub fn refactor_close() { refactor::close(self.state); }

    /// Fill the start screen, its filter as it is typed, and its verbs.
    pub fn manager_fill() { manager::fill(self.state); }

    pub fn manager_filter(text: str) { manager::set_filter(self.state, text); }

    pub fn manager_verb(name: str) { manager::verb(self.state, name); }

    /// Fill the sheet with whichever screen is up, and hear it shut.
    pub fn sheet_fill() { window::fill(self.state); }

    pub fn sheet_closed() { window::closed(self.state); }

    /// Fill the picker with whichever of the palette, the node picker and rename
    /// is up, and hear it shut.
    pub fn picker_fill() { window::picker_fill(self.state); }

    pub fn picker_closed() { window::picker_closed(self.state); }

    pub fn on_rail_changed(_change: any) {
        signals::heard(self.state, signals::RAIL);
        frame::relayout_if_moved(self.state);
    }

    /// Fill the tool rail.
    pub fn rail_fill() { center::fill_rail(self.state); }

    pub fn on_stage_changed(_change: any) {
        signals::heard(self.state, signals::STAGE);
        frame::relayout_if_moved(self.state);
    }

    /// What the stage chrome, the chips and the HUD show, and their verbs.
    pub fn stage_view() -> center::StageView { center::stage_view(self.state) }

    pub fn chips_fill() -> bool { center::fill_chips(self.state) }

    pub fn hud_view() -> center::HudView { center::hud_view(self.state) }

    pub fn stage_verb(verb: str) { center::stage_verb(self.state, verb); }

    /// Fill the top bar: the brand, its menu and the strip.
    pub fn chrome_fill() { chrome::fill(self.state); }

    /// Fill the import list and say what its bar and clock read.
    pub fn imports_fill() -> chrome::FillImports { chrome::fill_imports(self.state) }

    /// Fill the status strip at the bottom dock's foot.
    pub fn status_fill() { chrome::fill_status(self.state); }

    /// Files changed under a folder the editor follows: the project's cached
    /// reads go, the Assets tab says what is there now, a script open in the
    /// code sheet follows, and the recordings list is read again.
    pub fn on_files_changed(paths: any) {
        let named = util::list_or_empty(paths);
        if model::heard(self.state, named) {
            signals::changed(self.state, changes::ASSETS);
        }
        session::heard(self.state, named);
        disk::heard(self.state, named);
    }

    /// The replay moved: loaded, played, paused, sought, ran out or unloaded.
    pub fn on_replay_state_changed(playback: str) { session::moved(self.state, playback); }

    /// A project file was reloaded from disk: every read of one is stale, and
    /// the Assets tab says what is there now.
    pub fn on_assets_reloaded(_generation: any) {
        model::forget(self.state);
        signals::changed(self.state, changes::ASSETS);
        lint::touched(self.state);
        lint::node_warnings(self.state);
    }

    /// Text pasted where no field took it: ⌘V anywhere in the shell pastes a
    /// copied node.
    pub fn on_pasted(text: str) { sceneedit::paste_nodes(self.state, text); }

    /// An image pasted where no field took it is a sprite at the pointer, as
    /// a dropped one is.
    pub fn on_image_pasted(_size: any) { dropin::paste_image(self.state); }

    /// A shell key's command, by the name of its node in scenes/panels/keys.toml.
    pub fn command(name: str) {
        commands::run(self.state, name);
        signals::bars(self.state);
    }

    /// What the keys need to say which of them are live.
    pub fn keys_view() -> commands::KeysView { commands::keys_view(self.state) }

    /// A script stopped, or stopped somewhere else: the engine's word, where
    /// the editor used to ask it every frame.
    pub fn on_debugger_stopped(stop: any) { shell::stopped(self.state, stop); }

    /// The stopped script went on.
    pub fn on_debugger_resumed(_nothing: any) { shell::stopped(self.state); }

    /// The Assets panel's cards and strip for a search, a card picked, and its
    /// verbs: up, import, folder, rename, delete and the new name submitted.
    pub fn assets_view(query: str) -> dock::AssetsView { dock::assets_view(self.state, query) }

    pub fn assets_pick(row: str) { dock::assets_pick(self.state, row); }

    pub fn assets_verb(verb: str, value: str) { dock::assets_verb(self.state, verb, value); }

    /// The Library panel's cards or templates, its kind, and what a pick places.
    pub fn library_view() -> library::View { library::view(self.state) }

    pub fn library_kind(kind: str) { library::choose(self.state, kind); }

    pub fn library_pick(row: str) { library::pick(self.state, row); }

    /// Fill the Tiles panel's chips and answer its atlas, and a tile picked.
    pub fn tiles_fill() -> tiles::Palette { tiles::palette(self.state) }

    pub fn tiles_pick(row: str) { tiles::pick(self.state, row); }

    /// Fill the State machine panel's header and rows.
    pub fn machine_fill() { statemachine::body(self.state); }

    /// Fill the Recordings panel's rows, and its verify switch.
    pub fn recordings_fill() -> dock::RecordingsFill { dock::recordings_fill(self.state) }

    pub fn recordings_verify() { dock::recordings_verify(self.state); }

    /// The Debugger panel's stop, its steps, pause, break on error and a frame
    /// picked in the stack.
    pub fn debugger_view() -> dock::DebuggerView { dock::debugger_view(self.state) }

    pub fn debugger_step(step: str) { dock::debugger_step(self.state, step); }

    pub fn debugger_pause() { debugger::request_break(); }

    pub fn debugger_break_on_error() { debugger::set_break_on_error(!debugger::break_on_error()); }

    pub fn debugger_frame(row: str) { dock::debugger_frame(self.state, row); }

    /// The Output panel's lines for a level and a search, and its "clear".
    pub fn output_view(level: str, query: str) -> dock::OutputView { dock::output_view(self.state, level, query) }

    pub fn output_clear() { dock::output_clear(self.state); }

    /// The Problems panel's lines, and what a pick on one opens.
    pub fn problems_view() -> dock::ProblemsView { dock::problems_view(self.state) }

    pub fn problems_pick(row: str) { dock::problems_pick(self.state, row); }

    /// A live meter's table and headline, and the Profiler's "scripts".
    pub fn meter_view(what: str) -> dock::MeterView { dock::meter_view(self.state, what) }

    pub fn profiler_scripts() { dock::profiler_scripts(self.state); }

    /// The Docs panel's page for a search, and its module picker.
    pub fn docs_view(query: str) -> docs::View { docs::view(self.state, query) }

    pub fn docs_pick(module: str) { docs::pick(self.state, module); }

    /// The Outline tab's rows, and what a pick on one does.
    pub fn secondary_view() -> [ui::Item] { left::secondary_view(self.state) }

    pub fn secondary_pick(row: str) { left::secondary_pick(self.state, row); }

    /// The Scene panel's "+".
    pub fn scene_add() { newnode::open(self.state); }

    /// What the Inspector panel's head says.
    pub fn inspector_view() -> inspector::View { inspector::view(self.state) }

    /// Fill the Inspector panel's form, filtered by `query`.
    pub fn inspector_fill(query: str) { inspector::fill(self.state, query); }

    /// A frame of play read the Inspector's rows on screen again: true when
    /// that is all the word it heard meant.
    pub fn inspector_reread() -> bool { inspector::reread(self.state) }

    pub fn inspector_scrolled(offset: float) { inspector::scrolled(self.state, offset); }

    /// The Inspector's view changed size.
    pub fn inspector_resized() { inspector::resized(self.state); }

    /// An edit on one of the Inspector's rows.
    pub fn inspector_edit(data: any, value: any, _control: Node) { inspector::edited(self.state, data, value); }

    /// The Inspector's "Add component".
    pub fn inspector_add() { inspector::add(self.state); }

    /// What the Scene panel shows for a search and a facet tag.
    pub fn outline_view(query: str, facet: str, drawn: str) -> left::OutlineView {
        left::outline_view(self.state, query, facet, drawn)
    }

    /// The Scene panel's tree picked the row written `row`.
    pub fn outline_pick(row: str) { left::outline_pick(self.state, row); }

    pub fn tree_mark(event: any) {
        left::mark_clicked(self.state, event[fields::ROW].as_str(), event[fields::MARK].as_str());
    }

    pub fn tree_delete() { sceneedit::delete_selected(self.state); }
}

// A pooled control's handler has run: the panel it stands in, the nearest
// script above it with a `refill`, shows what that moved.
fn refill_panel(control: Node) {
    let at = control;
    while at.is_valid() {
        if at.has_method("refill") {
            at.call("refill");
            return;
        }
        at = at.parent();
    }
}
