// The balaur editor: a regular balaur project whose modules draw the whole
// shell and edit the game given to `balaur edit`; `S` is its one state.

use anim;
use arrange;
use bonemap;
use center;
use chrome;
use commands;
use complete;
use defs;
use dock;
use docks;
use docs;
use dropin;
use events;
use exporter;
use gizmo;
use history;
use importer;
use inputview;
use inspector;
use kit;
use layout;
use left;
use library;
use lint;
use manager;
use model;
use newnode;
use overlays;
use palette;
use pen;
use physics;
use plugins;
use polygon;
use populate;
use refactor;
use rig;
use selftest;
use session;
use settings;
use shell;
use showcase;
use search;
use signals;
use statemachine;
use suite;
use textedit;
use theme;
use themewin;
use tiles;
use util;
use viewport;
use weights;
use window;

/// The Editor node's script: the node it runs on and everything it keeps.
pub struct Editor {
    node: Node,
    S: State,
}

/// Every field the editor keeps; `fresh_state` gives each its starting value.
/// A map keyed by a name or an id is an `any`, and so is a key: what a cache
/// was built from, compared whole.
pub class State {
    workspace: str,
    tool: str,
    doctab: str,
    shader_rel: str,
    preview_line: int,
    preview_rel: str,
    docks: any,
    split: bool,
    script_open: bool,
    events_open: bool,
    zoom: float,
    playing: bool,
    formed: bool,
    palette: bool,
    palette_query: str,
    palette_submit: bool,
    picker_focused: bool,
    newnode: bool,
    newnode_query: str,
    newnode_change: bool,
    newnode_soft: str,
    renaming: bool,
    rename_text: str,
    chip_state: any,
    compact: bool,
    screen_key: str,
    ui_scale: float,
    asked_scale: float,
    touchscreen: bool,
    platform_read: bool,
    release_at: int,
    states_applied: bool,
    start_states: str,
    script_buffers: any,
    schemas: any,
    expects: any,
    opened: any,
    script_dirty: any,
    collapsed: any,
    view_shot: str,
    view_logged: str,
    code_scroll: float,
    code_rev: int,
    layout_seen: float,
    form: [any],
    pool_keys: any,
    doc_rev: int,
    doc_settled: int,
    doc_seen: DocSeen,
    inspect_warned: any,
    inspect_layout: any,
    tree_cache: left::TreeCache,
    told: any,
    inspector_key: any,
    docks_key: any,
    chrome_key: any,
    status_key: any,
    rail_key: any,
    stage_key: any,
    overlays_key: any,
    stepping: [str],
    overlays_frame: int,
    stepped: int,
    layout_key: any,
    theme_rev: int,
    is_2d_at: [int]?,
    is_2d_was: bool,
    overlay3d: Overlay3d,
    sel: int,
    sels: [int],
    locks: any,
    bookmarks: any,
    isolated: bool,
    fps: float,
    layout_demo: int,
    rows_demo: int,
    plugin_demo: int,
    /// `test:profiler`'s frames since it switched counting on; -1 at rest.
    profile_demo: int,
    events_demo: int,
    palette_demo: int,
    import_demo: int,
    import_waited: int,
    rows_want: int,
    rows_waited: int,
    gesture_demo: int,
    gesture_from: [float],
    frame: int,
    capture: shell::Capture?,
    show_input: bool,
    screen_w: float,
    screen_h: float,
    viewport: Viewport,
    rail_visible: bool,
    stage_chrome: bool,
    rail_shut: bool,
    chrome_off: bool,
    fontdemo: bool,
    menu_open: bool,
    doc_open: bool,
    hooks_open: bool,
    focus: bool,
    focus_was: any,
    layout: any,
    viewport_live: bool,
    mode2d: bool,
    refs: [Node],
    sources: any,
    id_paths: any,
    scene_doc: any,
    listings: any,
    clip: anim::Clip?,
    hooks_src: str,
    hooks_live: [center::Parsed],
    log_level: str,
    log_query: str,
    log_cache: dock::Built?,
    log_cursor: int,
    panels: docks::Panels?,
    palette_cache: palette::Found?,
    newnode_cache: [newnode::Entry]?,
    brand: chrome::Brand?,
    mirror: Node?,
    theme: any,
    theme_half: str,
    gizmo: gizmo::GizmoState,
    camera_drag: int,
    complete: complete::CompleteState,
    docs: docs::DocsState,
    refactor: refactor::RefactorState,
    textedit: textedit::TexteditState,
    rig: rig::RigState,
    polygon: polygon::PolygonState,
    phys_pills: [physics::Physpill],
    viewport_check: selftest::ViewportCheck?,
    camera_check: selftest::CameraCheck?,
    pick_check: selftest::PickCheck?,
    pool_check: selftest::PoolCheck?,
    reselect: selftest::Reselect?,
    empty_note: selftest::EmptyNote?,
    start_check: selftest::StartCheck?,
    rebound: int,
    phys_click: selftest::PhysClick?,
    pen: pen::PenState,
    weights: weights::WeightsState,
    bonemap: bonemap::BonemapState,
    machine: statemachine::StatemachineState,
    tiles: tiles::TilesState,
    anim: anim::AnimState,
    debug: shell::DebugState,
    events: events::EventsState,
    exporter: exporter::ExporterState,
    populate: populate::PopulateState,
    assets_touched: bool,
    jobs: any,
    import_queue: [str],
    import_drip: bool,
    session: session::SessionState,
    settings: settings::SettingsState,
    themewin: themewin::ThemewinState,
    window: window::WindowState,
    search: any,
    showcase: showcase::Q?,
    inputview: any,
    library: library::LibraryState,
    manager: manager::ManagerState,
    lint: lint::LintState,
    assets: dock::AssetsState,
    plugins: any,
    registry: plugins::PluginsState,
    // What `model::load` reads from the project: its document, where it is
    // and what it is called.
    doc: [any],
    game_root: str,
    game_name: str,
    scene_rel: str,
    scene_path: str,
    script_profiling: bool,
    history: history::History,
    import_texture: importer::Held,
    import_shipped: importer::ImportShipped,
    row_after: any,
    kit_state: any,
    rows_query: str,
    suite: suite::Run?,
}

/// The document text a self-test run's `model::check_revision` saw last
/// frame, and the revision it was at.
pub struct DocSeen {
    text: str,
    rev: int,
}

/// The 3D light and camera marks, and what they were drawn for.
pub struct Overlay3d {
    key: [any],
    lines: [any],
}

/// The viewport's rect in design pixels, and the frame it was read on.
pub struct Viewport {
    x: float,
    y: float,
    w: float,
    h: float,
    at: int,
}

// Below this many design pixels wide the shell drops every label its icon
// already says.
const COMPACT_W: float = 1240.0;

// The frame the splash comes off whether or not the shell has stopped moving.
const FORM_BY: int = 30;

/// Every field the editor keeps, at its starting value.
pub fn fresh_state() -> State {
    State {
        workspace: "scene",
        tool: "select",
        doctab: "scene",
        // A shader opened from a material; empty means the code pane shows
        // the selected node's script instead.
        shader_rel: "",
        // The shader line the viewport draws the value of; 0 draws the scene.
        preview_line: 0,
        preview_rel: "",
        docks: docks::state(),
        // The centre split: code and viewport side by side, instead of the
        // document tabs swapping one for the other.
        split: false,
        // The closable document tabs; the scene's is always there.
        script_open: false,
        events_open: false,
        zoom: 100.0,
        playing: false,
        formed: false,
        palette: false,
        palette_query: "",
        palette_submit: false,
        // Whether the picker's field has been handed the caret since it
        // opened; it takes it once, not every frame.
        picker_focused: false,
        newnode: false,
        newnode_query: "",
        // The picker lists what the selection can become, or, once a soft
        // body is picked, what to build it from ("2d" or "3d").
        newnode_change: false,
        newnode_soft: "",
        renaming: false,
        rename_text: "",
        chip_state: map(),
        compact: false,
        // The room's answers the docks were last folded for: a change is a
        // new screen, whatever the class words did.
        screen_key: "",
        ui_scale: 1.25,
        // What the reader set, kept apart from what the screen makes of it:
        // a touch screen draws larger without moving the setting.
        asked_scale: 1.25,
        touchscreen: false,
        // Whether the first frame has run: the start-up states apply on it,
        // after the screen's room has folded the docks.
        platform_read: false,
        release_at: -1,
        states_applied: false,
        start_states: "",
        script_buffers: map(),
        schemas: map(),
        expects: map(),
        opened: map(),
        script_dirty: map(),
        collapsed: map(),
        // The panel `view:<id>` asked for, and the rect last logged for it.
        view_shot: "",
        view_logged: "",
        // Where the code pane is asked to scroll to, in design px; below zero
        // leaves it where the reader left it, and one frame is all it takes.
        code_scroll: -1.0,
        // Bumped when the open buffer is written from outside the editor, so
        // the code sheet writes its text again; typing is the widget's own.
        code_rev: 0,
        // The stage width the layout self-test last saw, so it asserts on a
        // settled shell rather than on the frame it was still bootstrapping.
        layout_seen: -1.0,
        // The inspector's rows, described each frame and made by `pool.bs`.
        form: [],
        // What each pooled host was last filled for; see `pool::strip_when`.
        pool_keys: map(),
        // Bumped by every edit to `S.doc`: `history::record` before a recorded
        // one, `model::record_override` after the rest. A cache keyed on it
        // skips work a frame that edited nothing would otherwise repeat.
        doc_rev: 0,
        // What `model::settle_revision` last settled on, and the document a
        // self-test run's `model::check_revision` saw last frame.
        doc_settled: 0,
        doc_seen: DocSeen { text: "", rev: -1 },
        inspect_warned: map(),
        // Each component's rows cut into native runs, by component.
        inspect_layout: map(),
        tree_cache: left::TreeCache { key: "", rows: [] },
        // The guard on each word `signals` tells, and the keys each word was
        // last told for.
        told: map(),
        inspector_key: nil,
        docks_key: nil,
        chrome_key: nil,
        status_key: nil,
        rail_key: nil,
        stage_key: nil,
        overlays_key: nil,
        // The self-tests under way, which step a frame each; see
        // `selftest::stepping`.
        stepping: [],
        overlays_frame: -1,
        // The frame the viewport's tools last looked at the pointer: several
        // pointer words in one frame are one look.
        stepped: -1,
        layout_key: nil,
        // Bumped whenever another theme is worn or the worn one edited, so a
        // key can say the colours moved without holding the theme.
        theme_rev: 0,
        // `model::is_2d`'s answer, and the frame and document it was for.
        is_2d_at: [],
        is_2d_was: false,
        overlay3d: Overlay3d { key: [], lines: [] },
        // The selection set; `S.sel` is its head. Locks are editor state
        // keyed by node id, and isolate hides everything outside the set.
        sel: 0,
        sels: [0],
        locks: map(),
        // Four camera slots on the viewport chip row, kept for the session.
        bookmarks: map(),
        isolated: false,
        fps: 0.0,
        // -1 when the layout self-test is not running.
        layout_demo: -1,
        // The same for the row views' test, and the row it asks for.
        rows_demo: -1,
        plugin_demo: -1,
        profile_demo: -1,
        events_demo: -1,
        palette_demo: -1,
        import_demo: -1,
        import_waited: 0,
        rows_want: 0,
        rows_waited: 0,
        gesture_demo: -1,
        gesture_from: [],
        frame: 0,
        // `frames=<dir>`: a PNG every `every` frames from `from`, numbered.
        capture: nil,
        show_input: false,
        screen_w: 1280.0,
        screen_h: 800.0,
        viewport: Viewport { x: 322.0, y: 112.0, w: 640.0, h: 482.0, at: 0 },
        rail_visible: false,
        // Whether the stage is worth labelling: a strip of it behind an
        // unfolded panel is the way back, not a viewport.
        stage_chrome: true,
        rail_shut: false,
        chrome_off: false,
        fontdemo: false,
        menu_open: false,
        // A document is over the scene; the hooks list is beside it.
        doc_open: false,
        hooks_open: false,
        // The code with the window to itself. `focus_was` is the layout it
        // folded, and nothing but leaving focus reads it.
        focus: false,
        focus_was: nil,
        layout: layout::state(),
        // Whether the centre is showing the viewport this frame, rather than
        // a document over it.
        viewport_live: true,
        mode2d: false,
        refs: [],
        sources: map(),
        // Absolute path → the `id://` a document spelled it as, so a value
        // read back off the mirror keeps the id.
        id_paths: map(),
        // The edited scene's whole document, so a save keeps what the editor
        // does not model and the mirror sees its `[[assets]]`.
        scene_doc: map(),
        listings: map(),
        clip: nil,
        hooks_src: "",
        hooks_live: [],
        log_level: "all",
        log_query: "",
        // Per-frame and per-session caches, built on first use.
        log_cache: nil,
        // Where `log::since` left off, and the rows the log node was last given.
        log_cursor: 0,
        panels: nil,
        palette_cache: nil,
        newnode_cache: nil,
        brand: nil,
        mirror: nil,
        theme: theme::dark(),
        // The half a start-up state pinned for the run, or "" to follow the mode.
        theme_half: "",
        gizmo: gizmo::state(),
        // The mouse button a camera drag begun on the stage holds, or -1.
        camera_drag: -1,
        complete: complete::state(),
        docs: docs::state(),
        refactor: refactor::state(),
        textedit: textedit::state(),
        rig: rig::state(),
        polygon: polygon::state(),
        // Where the Physics panel's pills drew this frame, for the selftest
        // that presses them.
        phys_pills: [],
        viewport_check: nil,
        camera_check: nil,
        pick_check: nil,
        pool_check: nil,
        reselect: nil,
        empty_note: nil,
        start_check: nil,
        // The row the inspector last rebound, so a row that cannot resolve is
        // retried once rather than on every frame it is selected.
        rebound: -1,
        phys_click: nil,
        pen: pen::state(),
        weights: weights::state(),
        bonemap: bonemap::state(),
        machine: statemachine::state(),
        tiles: tiles::state(),
        anim: anim::state(),
        debug: shell::debug_state(),
        events: events::state(),
        exporter: exporter::state(),
        populate: populate::state(),
        // Set once a tool edits the scene's `[[assets]]` blocks, so a save
        // writes them back as well as the nodes.
        assets_touched: false,
        // This batch of imports, by the source each reports: the ones running
        // and the ones lately ended. `chrome::toast` draws them.
        jobs: map(),
        // What `imports:` still has to start, and the frame it starts on.
        import_queue: [],
        import_drip: false,
        session: session::state(),
        settings: settings::state(),
        themewin: themewin::state(),
        window: window::state(),
        search: map(),
        showcase: showcase::state(),
        inputview: inputview::state(),
        library: library::state(),
        manager: manager::state(),
        lint: lint::state(),
        assets: dock::assets_state(),
        plugins: map(),
        registry: plugins::state(),
        doc: [],
        game_root: "",
        game_name: "",
        scene_rel: "",
        scene_path: "",
        script_profiling: false,
        history: history::History { past: [], future: [], saved: 0, key: nil, at: 0.0 },
        import_texture: importer::Held { rel: "", source: "" },
        import_shipped: importer::ImportShipped { rel: "", rows: [] },
        row_after: nil,
        kit_state: nil,
        rows_query: "",
        suite: nil,
    }
}

/// What `init` sets up, and what a `suite` run sets up again before each of
/// its states. `listen` only the first time: a listener added twice hears
/// every event twice.
pub fn boot(S: &mut State, editor: Node, listen: bool) {
    model::load(S);
    ui::set_load_progress(0.3);
    plugins::load(S);
    if listen {
        // Exports and imports run off the frame and report back here as they go.
        export::listen(editor, map());
        import::listen(editor, map());
        release::listen(editor, map());
        signals::hear_own(editor);
        signals::hear_engine(editor);
        signals::hear_boxes(S, editor);
    }
    // Before the theme and the scale are pushed: the preferences decide both,
    // and until this ran they only took effect once Settings was opened.
    settings::load_files(S);
    theme::apply(S);
    chrome::set_app_icon(engine::dark_mode());
    S.touchscreen = engine::target().touchscreen;
    signals::inspector(S);
    shell::set_ui_scale(S, shell::scale_for_screen(S));
    // The shell redraws when something asks, not every frame: on the web the
    // pass is most of the frame, and nothing in it moves untouched.
    ui::set_lazy(true);
    render::set_grid(true, 1.0, 5, 20);
    shell::apply_camera(S);
    log::info("editing {S.game_name} ({S.doc.len()} nodes)");
    signals::outline(S);
    signals::docks(S);
}

impl Editor {
    pub fn init() {
        self.S = fresh_state();
        boot(self.S, self.node, true);
        // Optional start-up states, comma-separated (workspace id, "palette",
        // "light", "play", "select:<node>"), applied in order on the first
        // frame, after the screen's class has folded the docks.
        let args = engine::args();
        self.S.start_states = if args.len() > 1 { args[1] } else { "" };
    }

    pub fn update(dt: float) {
        suite::reboot(self.S, self.node);
        frame(self.S, dt);
        // Last: a reopen replaces `self.S`, and a call made back into the
        // Editor later in this one would still be handed the old state.
        suite::step(self.S);
    }

    // The system turned dark or light; the theme follows under `mode = "system"`.
    pub fn on_dark_mode_changed(dark: bool) {
        theme::follow(self.S, dark);
        chrome::set_app_icon(dark);
    }

    // Every export reports here: started, done or failed, one call per step.
    pub fn on_export_event(e: any) {
        exporter::report(self.S, e);
    }

    // A release check or install reports here, for the start screen and About.
    pub fn on_release_event(e: any) {
        manager::heard(self.S, e);
    }

    // Every import reports here: what is coming, each file, then the end.
    pub fn on_import_event(e: any) {
        dropin::report(self.S, e);
    }

    /// The window changed size.
    pub fn on_resize(_w: float, _h: float) {
        relayout(self.S);
    }

    /// One of the shell's boxes moved: a seam was dragged, a dock eased open, or
    /// the layout's own write landed.
    pub fn on_resized(_box: any) {
        relayout(self.S);
    }

    /// Lay the shell out again, for a module that changed what it holds.
    pub fn relayout_shell() {
        relayout(self.S);
    }

    /// A search control's edit: the query under the `id` it carries.
    pub fn search_typed(id: any, text: any) {
        search::typed(self.S, id.as_str(), text.as_str());
    }

    /// A pooled control's edit, for the function its spec's data names: see
    /// `pool::on`.
    pub fn handle(data: any, value: any) {
        let f: fn(&mut State, any, any) = data.fn;
        f(self.S, data, value);
    }

    /// The same for Enter in a field: see `pool::on_submit`.
    pub fn handle_submit(data: any, value: any) {
        let f: fn(&mut State, any, any) = data.submit;
        f(self.S, data, value);
    }

    /// Reload kept every field of the Editor whose name and type held; the
    /// theme is pushed again, since a theme edit is what a reload often is.
    pub fn on_hot_reload() {
        theme::apply(self.S);
        ui::request_repaint();
    }
}

// One frame: the frame rate, the splash, the capture, and every per-frame
// driver; the start screen has its own short list.
fn frame(S: &mut State, dt: float) {
    // Smoothed frame rate for the status bar; a raw 1/dt reads as noise.
    if dt > 0.0 {
        let now = 1.0 / dt;
        S.fps = (if S.fps == 0.0 { now } else { S.fps }) * 0.9 + now * 0.1;
    }
    S.frame += 1;
    model::settle_revision(S);
    if S.start_states != "" {
        model::check_revision(S);
    }
    shell::release_world(S);
    // The splash holds until the shell stops moving: every box is read back a
    // pass after it was written, so the sizes correct themselves for several.
    // `FORM_BY` is where it gives up waiting.
    if !S.formed {
        let ready = S.frame >= 3 && S.refs.len() == S.doc.len() && layout::settled(S);
        if ready || S.frame >= FORM_BY {
            S.formed = true;
            ui::finish_loading();
        } else {
            ui::set_load_progress(util::clamp(0.4 + 0.06 * S.frame.as_float(), 0.0, 0.95));
        }
    }
    // Above the start screen's own return: a clip of a project converting is
    // taken on that screen, and it has no other frame to be caught on.
    if S.capture.is_some() {
        let cap = S.capture.unwrap();
        if S.frame >= cap.from && (S.frame - cap.from) % cap.every == 0 {
            render::screenshot("{cap.dir}/{padded(cap.n)}.png");
            cap.n += 1;
            S.capture = cap;
        }
    }
    // The window, never `S.screen_w`: that is the shell's own solved rect, and
    // a surface taken from it shrinks the shell it sizes. The start screen is
    // a root on this surface too, so it is sized before that screen returns.
    let surface = ui::window_size();
    ui::set_widget_surface("shell", true, 0.0, 0.0, surface.x, surface.y);
    // The start screen has no scene to step, no selection to follow and no
    // gizmo to drag: what it needs from a frame is the states and the
    // showcase, whose sequence turns this screen's own pages.
    if manager::showing(S) {
        showcase::step(S);
        apply_start_states(S);
        if S.stepping.len() > 0 {
            selftest::step_all(S, true);
        }
        showcase::acts(S);
        // An install or a conversion reports as events, which wake the loop.
        if !S.formed || S.showcase.is_some() || S.capture.is_some() || S.stepping.len() > 0 {
            ui::request_repaint();
        }
        return;
    }
    // Nothing selected is not a stale mirror. Asking `live` about -1 rebuilt
    // the refs every frame with `get_node`, which resolves by name path and
    // so replaced the id-resolved ones a duplicate name needs.
    if S.refs.len() != S.doc.len() || (S.sel >= 0 && !model::live(S, S.sel).is_valid()) {
        model::resolve_refs(S);
    }
    // The sweep a script edit asked for, once typing has stopped; after the
    // mirror is resolved, since the scene half reads live nodes.
    lint::idle(S);
    session::update(S);
    // One queued import a frame once the shell has formed, so a shot catches
    // several at once.
    if S.import_drip && S.formed && S.import_queue.len() > 0 {
        let next = S.import_queue.remove(0);
        dropin::take(S, next);
    }
    if S.stepping.len() > 0 {
        selftest::step_all(S, false);
    }
    showcase::step(S);
    anim::update(S);
    // What moves without input asks for the next frame; under `[window]
    // low_processor` nothing else draws one. The splash and a queued import
    // count frames, so they ask too.
    let telling = S.jobs.len() > 0 || S.import_queue.len() > 0 || !S.formed;
    if S.playing || S.showcase.is_some() || session::scrubbing(S) || S.capture.is_some()
        || S.stepping.len() > 0 || telling || layout::animating(S) || S.gizmo.drag.is_some()
        || S.debug.demo.is_some()
    {
        ui::request_repaint();
    }
    // Every live value the Inspector shows may have moved this frame.
    if S.playing {
        signals::playing_frame(S);
    }
    // After the frame's ticks, where a pass used to apply them: a state that
    // starts a recording starts it on the tick its replay will.
    if S.platform_read {
        apply_start_states(S);
    }
    showcase::acts(S);
}

// The `--state` list, applied once. Read here rather than at `init`, because
// a state that folds a dock has to run after the screen has been measured.
fn apply_start_states(S: &mut State) {
    if S.states_applied {
        return;
    }
    S.states_applied = true;
    for token in S.start_states.split(",") {
        if token != "" {
            shell::apply_start_state(S, token);
        }
    }
}

/// Lay the shell out again: the room it has, what the centre shows, and every
/// box sized once. On the window's resize, on a box's own `resized`, and on
/// the words that change what the docks and the centre hold; never a pass.
fn relayout(S: &mut State) {
    // The room the shell has, which the engine solved: the window less what a
    // notch covers. The window stands in until the shell has drawn once.
    let window = ui::window_size();
    let room = layout::shell_room(S);
    S.screen_w = if room._0 > 0.0 { room._0 } else { window.x };
    S.screen_h = if room._1 > 0.0 { room._1 } else { window.y };
    // Either forces it on: the setting asks for it at any width, and a narrow
    // window asks for it whatever the setting says.
    S.compact = S.settings.compact || window.x < COMPACT_W;
    signals::inspector(S);
    // A state that folds a dock has to run after the screen has been measured,
    // which this is; `update` applies them, at the end of the frame's ticks.
    if room._0 > 0.0 {
        S.platform_read = true;
    }
    docks::follow_screen(S);
    if manager::showing(S) {
        return;
    }
    // Decide what is showing, then size every sheet once.
    center::modes(S);
    layout::compute(S);
    report_view(S);
    signals::bars(S);
    widget_layer(S);
    if S.fontdemo {
        selftest::font_sheet(S);
    }
}

// The game's UI layer, clipped to the viewport during play and in the
// Interface workspace; placed when the stage, play or the workspace moves.
fn widget_layer(S: State) {
    let rect = gizmo::viewport_rect(S);
    let widgets_on = (S.playing || S.workspace == defs::WORKSPACE_UI) && S.viewport_live;
    // Inset by the strip the axis and zoom pills own, so a bottom-anchored
    // HUD label sits above the editor's chrome instead of under it.
    let band = if widgets_on { center::hud_h(S) + 6.0 } else { 0.0 };
    ui::set_widget_layer(widgets_on, rect.x, rect.y, rect.w, util::max(0.0, rect.h - band));
}

/// What the layout is decided from besides the boxes themselves, so a word
/// that moved none of it, as a frame of play does, lays nothing out.
fn layout_key(S: State) -> any {
    [
        S.workspace, S.doctab, S.split, S.focus, S.settings.compact, S.touchscreen,
        "{S.docks}", S.rail_shut, S.chrome_off, S.script_open, S.events_open,
        S.sel, S.shader_rel, S.ui_scale, manager::showing(S),
    ]
}

fn relayout_if_moved(S: &mut State) {
    let key = layout_key(S);
    if key == S.layout_key {
        return;
    }
    S.layout_key = key;
    relayout(S);
}

// Six digits, so a frame directory sorts as it was captured.
fn padded(n: int) -> str {
    let s = "{n}";
    while s.len() < 6 {
        s = "0" + s;
    }
    s
}

/// Where the panel `view:<id>` asked for was drawn, in device pixels, so a
/// design pass can cut it out of the shot. Logged each time it moves: the
/// last line a run logs is the rect `--shot` saw.
fn report_view(S: &mut State) {
    if S.view_shot == "" {
        return;
    }
    let side = docks::side_of(S, S.view_shot);
    if side.is_none() {
        return;
    }
    let r = S.layout.get(side.unwrap());
    let f = S.ui_scale;
    let line = "viewrect {S.view_shot} {r.x.as_float() * f} {r.y.as_float() * f} {r.w.as_float() * f} {r.h.as_float() * f}";
    if line != S.view_logged {
        S.view_logged = line;
        log::info(line);
    }
}

// What the document decides beside its outline: whether the scene is 2D,
// which scripts the sweep compiles, and what the engine warns about it.
fn follow_document(S: &mut State) {
    if manager::showing(S) {
        return;
    }
    let is2d = model::is_2d(S);
    if is2d != S.mode2d {
        S.mode2d = is2d;
        render::set_grid(!is2d, 1.0, 5, 20);
        shell::apply_camera(S);
        draw_overlays(S);
    }
    lint::follow(S);
    if S.lint.warned_rev != S.doc_rev {
        lint::node_warnings(S);
    }
}

// The viewport's tools and the camera, once a frame the pointer did
// something in. A replay or a showcase feeds the pointer into the snapshot
// the tools read, so a drag would follow the feed rather than the mouse.
fn viewport_step(S: &mut State) {
    if S.stepped == S.frame || manager::showing(S) {
        return;
    }
    S.stepped = S.frame;
    if session::scrubbing(S) || showcase::feeding(S) {
        return;
    }
    // The camera's own: two fingers on the stage, or the mouse buttons and
    // wheel the editor drives itself. A gizmo never sees one.
    if !viewport::camera_gesture(S) && !viewport::mouse_camera(S) {
        gizmo::update(S);
    }
    gizmo::fill_marquee(S);
    textedit::update(S);
    if S.tool == "key" && S.workspace == defs::WORKSPACE_ANIMATION
        && input::mouse_just_pressed(input::MOUSE_BUTTON_LEFT)
    {
        anim::add_key(S, S.anim.time);
    }
    // Drawn now rather than on a word: a word is heard the frame after, and
    // the lines would trail the node they are dragging.
    let mouse = input::mouse_position();
    let dpi = util::max(render::camera_pose()[7], 0.01);
    let scale = dpi * S.ui_scale;
    let over = S.viewport_live && viewport::owns_pointer(S, mouse.x / scale, mouse.y / scale);
    if signals::overlays_moved(S, over) {
        draw_overlays(S);
    }
}

// The viewport's lines, drawn and kept until they are drawn again: the
// gizmo, the rig, the tools, the guides and a plugin's overlays.
fn draw_overlays(S: &mut State) {
    S.overlays_frame = S.frame;
    if manager::showing(S) {
        render::clear_retained("viewport");
        return;
    }
    render::begin_retained("viewport");
    if S.mode2d {
        overlays::grid2d(S);
    }
    gizmo::draw(S);
    plugins::draw_overlays(S);
    rig::draw(S);
    if !session::scrubbing(S) {
        polygon::idle(S);
    }
    polygon::draw(S);
    pen::draw(S);
    tiles::draw(S);
    if S.workspace == defs::WORKSPACE_SCENE && defs::chip_on(S.chip_state, S.workspace, defs::CHIP_GUIDES) {
        overlays::guides(S);
    }
    if S.mode2d && defs::chip_on(S.chip_state, S.workspace, defs::CHIP_LIGHTS) {
        overlays::lights2d(S);
    }
    if S.workspace == defs::WORKSPACE_ANIMATION && defs::chip_on(S.chip_state, S.workspace, defs::CHIP_PATH) {
        overlays::motion_path(S);
    }
    if !S.mode2d && defs::chip_on(S.chip_state, S.workspace, defs::CHIP_LIGHTS) {
        overlays::lights3d(S);
    }
    if S.workspace == defs::WORKSPACE_PHYSICS && defs::chip_on(S.chip_state, S.workspace, defs::CHIP_COLLIDERS) {
        if S.mode2d {
            overlays::colliders2d(S);
        } else {
            overlays::colliders(S);
        }
    }
    render::end_retained();
}

