    /// is up, and hear it shut.
    pub fn picker_fill() {
        window::picker_fill(self.state);
    }

    pub fn picker_closed() {
        window::picker_closed(self.state);
    }

    pub fn on_rail_changed(_change: any) {
        signals::heard(self.state, signals::RAIL);
        relayout_if_moved(self.state);
    }

    /// Fill the tool rail.
    pub fn rail_fill() {
        center::fill_rail(self.state);
    }

    pub fn on_stage_changed(_change: any) {
        signals::heard(self.state, signals::STAGE);
        relayout_if_moved(self.state);
    }

    /// What the stage chrome, the chips and the HUD show, and their verbs.
    pub fn stage_view() -> center::StageView {
        center::stage_view(self.state)
    }

    pub fn chips_fill(near: bool) -> bool {
        center::fill_chips(self.state, near)
    }

    pub fn hud_view() -> center::HudView {
        center::hud_view(self.state)
    }

    pub fn stage_verb(verb: str) {
        center::stage_verb(self.state, verb);
    }

    /// Fill the top bar: the brand, its menu and the strip.
    pub fn chrome_fill() {
        chrome::fill(self.state);
    }

    /// Fill the import list and say what its bar and clock read.
    pub fn imports_fill() -> chrome::FillImports {
        chrome::fill_imports(self.state)
    }

    /// Fill the status strip at the bottom dock's foot.
    pub fn status_fill() {
        chrome::fill_status(self.state);
    }

    /// A project file was reloaded from disk: every read of one is stale, and
    /// the Assets tab says what is there now.
    // Files changed under the project: a script open in the code sheet follows.
    pub fn on_files_changed(paths: any) {
        disk::heard(self.state, paths);
    }

    pub fn on_assets_reloaded(_generation: any) {
        model::forget(self.state);
        signals::changed(self.state, changes::ASSETS);
        lint::touched(self.state);
        lint::node_warnings(self.state);
    }

    /// Text pasted where no field took it: ⌘V anywhere in the shell pastes a
    /// copied node.
    pub fn on_pasted(text: str) {
        model::paste_nodes(self.state, text);
    }

    /// An image pasted where no field took it is a sprite at the pointer, as
    /// a dropped one is.
    pub fn on_pasted_image(_size: any) {
        dropin::paste_image(self.state);
    }

    /// A shell key's command, by the name of its node in scenes/panels/keys.toml.
    pub fn command(name: str) {
        commands::run(self.state, name);
        signals::bars(self.state);
    }

    /// What the keys need to say which of them are live.
    pub fn keys_view() -> commands::KeysView {
        commands::keys_view(self.state)
    }

    /// A script stopped, stopped somewhere else or went on: the engine's word,
    /// where the editor used to ask it every frame.
    pub fn on_debugger_stopped(stop: any) {
        shell::stopped(self.state, stop);
    }

    /// The Assets panel's cards and strip for a search, a card picked, and its
    /// verbs: up, import, folder, rename, delete and the new name submitted.
    pub fn assets_view(query: str) -> dock::AssetsView {
        dock::assets_view(self.state, query)
    }

    pub fn assets_pick(row: str) {
        dock::assets_pick(self.state, row);
    }

    pub fn assets_verb(verb: str, value: str) {
        dock::assets_verb(self.state, verb, value);
    }

    /// The Library panel's cards or templates, its kind, and what a pick places.
    pub fn library_view() -> library::View {
        library::view(self.state)
    }

    pub fn library_kind(kind: str) {
        library::choose(self.state, kind);
    }

    pub fn library_pick(row: str) {
        library::pick(self.state, row);
    }

    /// Fill the Tiles panel's chips and answer its atlas, and a tile picked.
    pub fn tiles_fill() -> tiles::Palette {
        tiles::palette(self.state)
    }

    pub fn tiles_pick(row: str) {
        tiles::pick(self.state, row);
    }

    /// Fill the State machine panel's header and rows.
    pub fn machine_fill() {
        statemachine::body(self.state);
    }

    /// Fill the Recordings panel's rows, and its verify switch.
    pub fn recordings_fill() -> dock::RecordingsFill {
        dock::recordings_fill(self.state)
    }

    pub fn recordings_verify() {
        dock::recordings_verify(self.state);
    }

    /// The Debugger panel's stop, its steps, pause, break on error and a frame
    /// picked in the stack.
    pub fn debugger_view() -> dock::DebuggerView {
        dock::debugger_view(self.state)
    }

    pub fn debugger_step(step: str) {
        dock::debugger_step(self.state, step);
    }

    pub fn debugger_pause() {
        debugger::request_break();
    }

    pub fn debugger_break_on_error() {
        debugger::set_break_on_error(!debugger::break_on_error());
    }

    pub fn debugger_frame(row: str) {
        dock::debugger_frame(self.state, row);
    }

    /// The Output panel's lines for a level and a search, and its "clear".
    pub fn output_view(level: str, query: str) -> dock::OutputView {
        dock::output_view(self.state, level, query)
    }

    pub fn output_clear() {
        dock::output_clear(self.state);
    }

    /// The Problems panel's lines, and what a pick on one opens.
    pub fn problems_view() -> dock::ProblemsView {
        dock::problems_view(self.state)
    }

    pub fn problems_pick(row: str) {
        dock::problems_pick(self.state, row);
    }

    /// A live meter's table and headline, and the Profiler's "scripts".
    pub fn meter_view(what: str) -> dock::MeterView {
        dock::meter_view(self.state, what)
    }

    pub fn profiler_scripts() {
        dock::profiler_scripts(self.state);
    }

    /// The Docs panel's page for a search, and its module picker.
    pub fn docs_view(query: str) -> docs::View {
        docs::view(self.state, query)
    }

    pub fn docs_pick(module: str) {
        docs::pick(self.state, module);
    }

    /// The Outline tab's rows, and what a pick on one does.
    pub fn secondary_view() -> [ui::Item] {
        left::secondary_view(self.state)
    }

    pub fn secondary_pick(row: str) {
        left::secondary_pick(self.state, row);
    }

    /// The Scene panel's "+".
    pub fn scene_add() {
        newnode::open(self.state);
    }

    /// What the Inspector panel's head says.
    pub fn inspector_view() -> inspector::View {
        inspector::view(self.state)
    }

    /// Fill the Inspector panel's form, filtered by `query`.
    pub fn inspector_fill(query: str) {
        inspector::fill(self.state, query);
    }

    /// A frame of play read the Inspector's rows on screen again: true when
    /// that is all the word it heard meant.
    pub fn inspector_reread() -> bool {
        inspector::reread(self.state)
    }

    /// The Inspector's form scrolled to `offset`.
    pub fn inspector_scrolled(offset: float) {
        inspector::scrolled(self.state, offset);
    }

    /// The Inspector's view changed size.
    pub fn inspector_resized() {
        inspector::resized(self.state);
    }

    /// An edit on one of the Inspector's rows.
    pub fn inspector_edit(data: any, value: any, _control: Node) {
        inspector::edited(self.state, data, value);
    }

    /// The Inspector's "Add component".
    pub fn inspector_add() {
        inspector::add(self.state);
    }

    /// What the Scene panel shows for a search and a facet tag.
    pub fn outline_view(query: str, facet: str, drawn: str) -> left::OutlineView {
        left::outline_view(self.state, query, facet, drawn)
    }

    /// The Scene panel's tree picked the row written `row`.
    pub fn outline_pick(row: str) {
        left::outline_pick(self.state, row);
    }

    pub fn tree_mark(event: any) {
        left::mark_clicked(self.state, event[fields::ROW].as_str(), event[fields::MARK].as_str());
    }

    pub fn tree_delete() {
        model::delete_selected(self.state);
    }
}

// A pooled control's handler has run: the panel it stands in, the nearest
// script above it with a `refill`, shows what that moved.
fn refill_panel(control: Node) {
    let at = control;
    while at.is_valid() {
        if at.has_method("refill") {
            at.call("refill");
            return;
        }
        at = at.parent();
    }
}
