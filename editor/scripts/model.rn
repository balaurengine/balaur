// The edited project: scene document model, live mirror scene, save/reset.
// `S.doc` is plain data parsed from the scene TOML; the mirror is a real node
// tree from the same TOML (scripts not attached, physics paused until play).

use crate::history;
use crate::selection;
use crate::util;

// Project reads, cached on `S`: four panels read the disk while drawing, so
// uncached that is a read per node per frame. `fs` has no mtime, hence
// interval + drop.
const TTL = 0.5;

// A hand-edited file can name a parent that names it back. Every walk is
// bounded so a cycle costs a wrong answer, not a hung editor.
const MAX_DEPTH = 256;

// The text of a project-relative file, or `None` when there is no such file —
// the caller that wants to say "missing" needs to tell that from "empty".
pub fn source(S, rel) {
    let now = engine::time();
    if let Some(entry) = S.sources.get(rel) {
        if now - entry.at < TTL {
            return entry.text;
        }
    }
    let text = fs::read(S.game_root + "/" + rel);
    let entry = #{
        text: if text is String { Some(text) } else { None },
        at: now, hooks: None, exports: None, lines: None,
    };
    S.sources[rel] = entry;
    entry.text
}

// How many lines a file has, counted once per cached read: the Script
// persona's list asked for every script's count on every frame it drew.
pub fn line_count(S, rel) {
    let text = match source(S, rel) {
        Some(text) => text,
        None => return 0,
    };
    let entry = S.sources[rel];
    if entry.lines.is_none() {
        entry.lines = Some(util::count_lines(text));
    }
    entry.lines.unwrap()
}

// The script's engine-facing hooks, read once per cached read. The host's own
// `script::symbols` rather than a parser here, so the outline, the Events tab
// and an editor outside Balaur all name the same functions.
pub fn hooks(S, rel) {
    let text = match source(S, rel) {
        Some(text) => text,
        None => return [],
    };
    let entry = S.sources[rel];
    if entry.hooks.is_none() {
        let found = script::symbols(rel, text);
        let hooks = [];
        if found is Vec {
            for one in found {
                if one.kind == "function" {
                    hooks.push(#{ name: one.name, line: one.line, detail: one.detail });
                }
            }
        }
        entry.hooks = Some(hooks);
    }
    entry.hooks.unwrap()
}

pub fn list(S, rel) {
    let now = engine::time();
    if let Some(entry) = S.listings.get(rel) {
        if now - entry.at < TTL {
            return entry.files;
        }
    }
    let entry = #{ files: util::vec(fs::list(S.game_root + "/" + rel)), at: now };
    S.listings[rel] = entry;
    entry.files
}

// Drop a cached read (`None` drops everything): what the editor just wrote
// must be visible on the next frame, not on the next interval.
pub fn forget(S, rel) {
    match rel {
        Some(rel) => {
            S.sources.remove(rel);
        }
        None => {
            S.sources = #{};
            S.listings = #{};
        }
    }
}

// A node's `script` key is either the path or `{ source, props }`, so every
// reader of it goes through here rather than assuming the string form.
pub fn script_rel(node) {
    match node.get("script") {
        Some(script) => if script is String {
            Some(script)
        } else {
            util::obj(script).get("source")
        },
        None => None,
    }
}

// What this node overrides of its script's exported defaults. Sparse: a
// property back at its default is absent, so a changed default reaches it.
pub fn script_props(node) {
    match node.get("script") {
        Some(script) => if script is String {
            #{}
        } else {
            util::obj(util::obj(script).get("props").unwrap_or(#{}))
        },
        None => #{},
    }
}

// The properties the script declares, cached beside its text: asking the host
// compiles the file, which is not something to do once a frame.
pub fn exports(S, rel) {
    if source(S, rel).is_none() {
        return [];
    }
    let entry = S.sources[rel];
    if entry.exports.is_none() {
        let declared = script::exports(S.game_root + "/" + rel);
        entry.exports = Some(if declared is Vec { declared } else { [] });
    }
    entry.exports.unwrap()
}

// Set one exported property on the selected node, writing the table form of
// the `script` key. Takes effect the next time the script attaches, which for
// play-in-editor is the next play.
pub fn set_script_prop(S, prop, value) {
    let node = S.doc[S.sel];
    let rel = match script_rel(node) {
        Some(rel) => rel,
        None => return,
    };
    history::record(S, "set " + prop, Some(format!("sprop:{}:{}", prop, S.sel)));
    let props = script_props(node);
    let stored = as_default_type(S, rel, prop, value);
    if same_as_default(S, rel, prop, stored) {
        props.remove(prop);
    } else {
        props[prop] = stored;
    }
    node.script = if props.is_empty() { rel } else { #{ source: rel, props: props } };
    record_override(S, node, "script");
}

// The editors all drag floats, so an export declared as a whole number is
// rounded back to one: a count that became 2.0 is a different value to the
// script, and to the file.
fn as_default_type(S, rel, prop, value) {
    for export in exports(S, rel) {
        if export.name == prop && export["type"] == "int" && value is f64 {
            return math::round(value) as i64;
        }
    }
    value
}

// A value equal to the export's default stops being an override. Numbers
// compare as numbers, so retyping 2 over an int default of 2 clears it.
fn same_as_default(S, rel, prop, value) {
    for export in exports(S, rel) {
        if export.name == prop {
            let d = export["default"];
            if (d is i64 || d is f64) && (value is i64 || value is f64) {
                return util::f(d) == util::f(value);
            }
            return d == value;
        }
    }
    false
}

// Whether the node's script draws its own interface, as opposed to carrying a
// `widget` component.
pub fn draws_ui(S, node) {
    match script_rel(node) {
        Some(rel) => match source(S, rel) {
            Some(text) => text.contains("draw_ui"),
            None => false,
        },
        None => false,
    }
}

// A scene file's `parent` is an id or a name path; `normalize` resolves the
// path form on load, so everything below walks a chain of ids.
pub fn by_id(doc, id) {
    for node in doc {
        if node.id == id {
            return Some(node);
        }
    }
    None
}

// The name path `scene::get_node` resolves, built by walking ids to the root.
pub fn node_path(doc, node) {
    let names = [node.name];
    let current = node;
    for _ in 0..MAX_DEPTH {
        if current.parent == "" {
            break;
        }
        let parent = match by_id(doc, current.parent) {
            Some(parent) => parent,
            None => break,
        };
        names.insert(0, parent.name);
        current = parent;
    }
    util::join(names, "/")
}

pub fn has_ancestor(doc, node, id) {
    let current = node;
    for _ in 0..MAX_DEPTH {
        if current.parent == "" {
            return false;
        }
        if current.parent == id {
            return true;
        }
        current = match by_id(doc, current.parent) {
            Some(parent) => parent,
            None => return false,
        };
    }
    false
}

// The engine's own id rule (`slug` in project.rs), so an id the editor
// generates is the one the engine would have generated for that name.
fn slug(name) {
    let alnum = "abcdefghijklmnopqrstuvwxyz0123456789";
    let out = "n_";
    let gap = true;
    for c in name.to_lowercase().chars() {
        let s = format!("{}", c);
        if alnum.contains(s) {
            out += s;
            gap = false;
        } else if !gap {
            out += "_";
            gap = true;
        }
    }
    while out.ends_with("_") {
        out = out[..out.len() - 1];
    }
    if out.len() > 2 { out } else { "n_node" }
}

/// A name no sibling has yet, for a node the editor makes.
pub fn unique_name(doc, base) {
    let name = base;
    let n = 1;
    while name_taken(doc, name) {
        n += 1;
        name = format!("{}{}", base, n);
    }
    name
}

/// The document row carrying `id`, or `None`.
pub fn index_of_id(doc, id) {
    for (i, node) in doc.iter().enumerate() {
        if node.get("id").unwrap_or("") == id {
            return Some(i);
        }
    }
    None
}

pub fn fresh_id(doc, name) {
    let taken = #{};
    for node in doc {
        let id_some = node.get("id");
        if let Some(id) = id_some {
            taken[id] = true;
        }
    }
    let base = slug(name);
    let candidate = base;
    let n = 2;
    while taken.contains_key(candidate) {
        candidate = format!("{}_{}", base, n);
        n += 1;
    }
    candidate
}

pub fn node_type(node) {
    let kind = body_kind(node);
    let kind2d = body2d_kind(node);
    if kind == Some(physics3d::BODY_DYNAMIC) {
        "RigidBody3D"
    } else if kind == Some(physics3d::BODY_STATIC) {
        "StaticBody3D"
    } else if kind == Some(physics3d::BODY_KINEMATIC) {
        "KinematicBody3D"
    } else if kind2d == Some(physics2d::BODY_DYNAMIC) {
        "RigidBody2D"
    } else if kind2d == Some(physics2d::BODY_STATIC) {
        "StaticBody2D"
    } else if kind2d == Some(physics2d::BODY_KINEMATIC) {
        "KinematicBody2D"
    } else if node.contains_key("widget") {
        "Widget"
    } else if node.contains_key("bone2d") {
        "Bone2D"
    } else if node.contains_key("bone3d") {
        "Bone3D"
    } else if node.contains_key("polygon") {
        "Polygon2D"
    } else if node.contains_key("shape3d") {
        "MeshInstance3D"
    } else if node.contains_key("shape2d") {
        "MeshInstance2D"
    } else {
        "Node"
    }
}

fn kind_of(body) {
    match body {
        Some(body) => {
            if body is Object {
                body.get("kind")
            } else {
                Some(body)
            }
        }
        None => None,
    }
}

pub fn body_kind(node) {
    kind_of(node.get("body3d"))
}

pub fn body2d_kind(node) {
    kind_of(node.get("body2d"))
}

// True when the edited scene is 2D (any node carries a 2D component). The
// editor switches camera, grid and gizmo accordingly.
pub fn is_2d(S) {
    for node in S.doc {
        if node.contains_key("shape2d") || node.contains_key("body2d") || node.contains_key("collider2d")
            || node.contains_key("polygon") || node.contains_key("bone2d") || node.contains_key("sprite")
            || node.contains_key("tilemap") {
            return true;
        }
        let camera = node.get("camera").unwrap_or(());
        if camera is Object && camera.get("kind") == Some("2d") {
            return true;
        }
    }
    false
}

// Icon glyph + colour role ("sage" physics, "accent" render/ui, "dim" other).
pub fn node_icon(node) {
    let kind = match body_kind(node) {
        Some(kind) => Some(kind),
        None => body2d_kind(node),
    };
    if node.contains_key("widget") {
        return (crate::icons::persona("ui"), "node_ui");
    }
    if kind.is_some() {
        return (crate::icons::persona("phys"), "node_phys");
    }
    if node.contains_key("bone2d") || node.contains_key("bone3d") {
        return (crate::icons::tool("bone"), "node_bone");
    }
    if node.contains_key("polygon") || node.contains_key("shape2d") || node.contains_key("sprite") {
        return (crate::icons::tool("polygon"), "node_2d");
    }
    if node.contains_key("shape3d") || node.contains_key("mesh") {
        return (crate::icons::persona("scene"), "node_3d");
    }
    if node.contains_key("script") {
        return (crate::icons::ui("scriptfile"), "node_plain");
    }
    return (crate::icons::node("world"), "node_plain");
}

// How deep prefabs may nest before the editor stops following them. The
// engine refuses a cycle outright; this is only a guard on pathological
// depth, so it can be generous.
const INSTANCE_DEPTH = 8;

// Read every `instance` node's prefab into the document as rows the file does
// not own, each carrying `owner` (the node that named the prefab) and `at`
// (its path inside): what turns an edit into an override and not a row.
pub fn expand_instances(S) {
    let out = [];
    for node in S.doc {
        if node.contains_key("owner") {
            continue;
        }
        out.push(node);
        if node.contains_key("instance") {
            expand_one(S, out, node, node.instance, node.id, "", 0);
        }
    }
    S.doc = out;
    S.doc_rev += 1;
}

fn expand_one(S, out, owner, rel, id_prefix, at_prefix, depth) {
    if depth >= INSTANCE_DEPTH {
        log::warn(format!("prefabs nest deeper than {} in {}", INSTANCE_DEPTH, rel));
        return;
    }
    let text = match source(S, rel) {
        Some(text) => text,
        None => {
            log::warn("instance '" + rel + "' on '" + owner.name + "' names no file");
            return;
        }
    };
    let inner = util::vec(util::obj(toml::parse(text)).get("nodes").unwrap_or([]));
    normalize(inner);
    let overrides = util::obj(owner.get("overrides").unwrap_or(#{}));
    for node in inner {
        let at = at_prefix + node_path(inner, node);
        let row = #{};
        for (key, value) in node.iter() {
            row[key] = value;
        }
        row.id = id_prefix + "/" + node.id;
        row.parent = if node.parent == "" { id_prefix } else { id_prefix + "/" + node.parent };
        row.owner = owner.id;
        row.at = at;
        // What the prefab says, so an edit that lands back on it stops being
        // an override. Canonicalised first: `body3d = "dynamic"` and the whole
        // table are the same component spelled two ways.
        row.base = canonical(util::copy(row));
        // What the instance says about this node wins, property by property,
        // exactly as the engine patches it — over the canonical form, since
        // that is what the patch lands on.
        for (key, value) in util::obj(overrides.get(at).unwrap_or(#{})).iter() {
            row[key] = merged(row.base.get(key), value);
        }
        out.push(row);
        if row.contains_key("instance") {
            expand_one(S, out, owner, row.instance, row.id, at + "/", depth + 1);
        }
    }
}

// The rows the scene file owns — everything the editor writes, and everything
// the mirror is built from, since the engine expands an instance itself.
pub fn authored(doc) {
    let out = [];
    for node in doc {
        if !node.contains_key("owner") {
            out.push(node);
        }
    }
    out
}

// Whether this row came from a prefab. Its properties can be overridden; it
// cannot be renamed, reparented, duplicated or deleted, because structure is
// the prefab's (`docs/PLAN-scenes-and-assets.md`).
pub fn is_instanced(node) {
    node.contains_key("owner")
}

// Structural equality through the encoder, because a scene key's value is a
// table or an array as often as it is a number, and one spelling of "equal"
// for all of them is what keeps an override sparse.
fn same_value(a, b) {
    match b {
        Some(b) => toml::encode(#{ v: a }) == toml::encode(#{ v: b }),
        None => false,
    }
}

// Every component key of a node table replaced by the property table the
// engine would build from it, so two spellings of one component compare equal.
fn canonical(node) {
    // Collected first: writing a key while iterating the same object is a
    // borrow error in Rune, not a silent surprise.
    let full = #{};
    for (key, value) in node.iter() {
        let properties = scene::component_properties(key, value);
        if properties is Object {
            full[key] = properties;
        }
    }
    for (key, value) in full.iter() {
        node[key] = value;
    }
    node
}

// An override laid over what the prefab said: a table merges property by
// property, anything else replaces. The engine patches components, so the
// editor has to show the same thing.
fn merged(base, over) {
    let base_some = base;
    match base_some {
        Some(base) => if base is Object && over is Object {
            let out = util::copy(base);
            for (key, value) in over.iter() {
                out[key] = value;
            }
            out
        } else {
            over
        },
        None => over,
    }
}

// What of `value` differs from `base`, so an override holds only the
// properties this instance actually changed and a later edit to the prefab
// still reaches the rest.
fn differing(value, base) {
    let value_some = value;
    let value = match value_some {
        Some(value) => value,
        None => return None,
    };
    let base_some = base;
    let base = match base_some {
        Some(base) => base,
        None => return Some(value),
    };
    if value is Object && base is Object {
        let out = #{};
        for (key, inner) in value.iter() {
            if !same_value(inner, base.get(key)) {
                out[key] = inner;
            }
        }
        return if out.is_empty() { None } else { Some(out) };
    }
    if same_value(value, Some(base)) { None } else { Some(value) }
}

// The engine repairs a missing id at load; the editor has to arrive at the
// same one or its refs point at nothing.
fn normalize(doc) {
    for node in doc {
        if !node.contains_key("parent") {
            node.parent = "";
        }
        if node.get("id").unwrap_or("") == "" {
            node.id = fresh_id(doc, node.name);
        }
    }
    // The engine also takes `parent` as a path of names down from the scene
    // root; the editor walks ids, so a path becomes the id it denotes here.
    for node in doc {
        if node.parent == "" || by_id(doc, node.parent).is_some() {
            continue;
        }
        let target = node_at_path(doc, node.parent);
        if target.is_some() {
            node.parent = target.unwrap().id;
        } else {
            log::warn("node " + node.name + " names parent " + node.parent
                + ", which this scene has neither as an id nor as a path");
        }
    }
}

// The node a `/`-separated path of names denotes, walked down from the root.
// Parents come before children, so each step's `parent` is already an id.
fn node_at_path(doc, path) {
    let parent_id = "";
    let found = None;
    for segment in path.split('/').collect::<Vec>() {
        found = None;
        for node in doc {
            if node.name == segment && node.parent == parent_id {
                found = Some(node);
                break;
            }
        }
        if found.is_none() {
            return None;
        }
        parent_id = found.unwrap().id;
    }
    found
}

// Load the game project pointed at by `engine::args()[0]`.
// A read the editor cannot do without: `fs::read` answers `()` for a file it
// could not open, and `toml::parse` then fails with the type, not the path.
fn must_read(path) {
    let text = fs::read(path);
    if !(text is String) {
        log::error(format!("cannot read {}", path));
        return "";
    }
    text
}

pub fn load(S) {
    let root = engine::args()[0];
    S.game_root = root;
    let manifest = toml::parse(must_read(root + "/project.toml"));
    let application = manifest.application;
    S.game_name = application.name;
    S.scene_rel = application.main_scene;
    // Same for the strings: the catalogue lives under the game's root, not
    // the editor's, and without this every `text_key` draws as its key.
    strings::set_root(root);
    // The engine read the *editor's* actions from its own project.toml, so
    // without this every action a played game asks for reads zero.
    let input_some = manifest.get("input");
    if let Some(table) = input_some {
        if table is Object {
            let actions = table.get("actions").unwrap_or(());
            if actions is Object {
                input::declare_actions(actions);
            }
            // The rest of `[input]`: the emulation switches and gesture thresholds.
            input::declare_config(table);
        }
    }
    S.scene_path = root + "/" + application.main_scene;
    let doc = util::obj(toml::parse(must_read(S.scene_path)));
    // The whole document, not only its nodes: a scene's `[[assets]]` blocks
    // and anything else it declares have to survive a save and reach the
    // mirror, or a `#id` reference resolves to nothing inside the editor.
    S.scene_doc = doc;
    S.doc = util::vec(doc.get("nodes").unwrap_or([]));
    S.doc_rev += 1;
    normalize(S.doc);
    expand_instances(S);
    selection::only(S, 0);
    history::reset(S);
    build_mirror(S);
}

// Only a value that reads as a file name is a file candidate: `..` and
// `../Rig` are node paths, and the game's parent directory exists too.
fn names_a_file(value) {
    if value == "" || value.starts_with("/") {
        return false;
    }
    let last = "";
    for segment in value.split('/') {
        if segment == "." || segment == ".." {
            return false;
        }
        last = segment;
    }
    match last.split_once('.') {
        Some((_, ext)) => ext != "" && ext.chars().all(|c| c.is_alphanumeric()),
        None => false,
    }
}

// The game-relative path an `id://` reference names in the game's own
// `assets/index.toml`, with its `#entry` kept, or `None` for an unknown id.
pub fn id_path(S, reference) {
    let rest = reference["id://".len()..];
    let (id, entry) = match rest.split_once('#') {
        Some((id, entry)) => (id, "#" + entry),
        None => (rest, ""),
    };
    let text = match source(S, "assets/index.toml") {
        Some(text) => text,
        None => return None,
    };
    match toml::parse(text).get(id) {
        Some(path) => Some(format!("{}{}", path, entry)),
        None => None,
    }
}

// Game-relative file paths (a texture) are made absolute for the mirror,
// whose engine resolves against the editor's root; `relative_file` undoes it
// on the way back, and `S.id_paths` keeps an `id://` spelling for that.
fn absolute_files(S, value) {
    if value is String {
        if value.starts_with("id://") {
            // Bound first: Rune does not take a `match` straight after
            // `return`, the way it does not take one straight before `[`.
            let resolved = match id_path(S, value) {
                Some(rel) => {
                    let abs = S.game_root + "/" + rel;
                    S.id_paths[abs] = value;
                    abs
                }
                None => value,
            };
            return resolved;
        }
        if names_a_file(value) && fs::exists(S.game_root + "/" + value) {
            let abs = S.game_root + "/" + value;
            // Inlined so what it names resolves against the editor's root (D24),
            // except a material: it resolves its own files, and a path saves.
            if value.ends_with(".toml") {
                let (ok, loaded) = script::attempt(|| assets::load(abs));
                if ok && loaded is Object && loaded.contains_key("type")
                    && loaded["type"] != "material" {
                    return absolute_files(S, loaded);
                }
            }
            return abs;
        }
        value
    } else if value is Object {
        let out = #{};
        for (key, inner) in value.iter() {
            out[key] = absolute_files(S, inner);
        }
        out
    } else if value is Vec {
        let out = [];
        for inner in value {
            out.push(absolute_files(S, inner));
        }
        out
    } else {
        value
    }
}

pub fn relative_file(S, value) {
    if value is String {
        if let Some(reference) = S.id_paths.get(value) {
            return reference;
        }
        let prefix = S.game_root + "/";
        if value.starts_with(prefix) {
            return value[prefix.len()..];
        }
    }
    value
}

pub fn build_mirror(S) {
    // Before the world goes: a game script still attached would get one more
    // update against bodies `physics::clear` has already removed.
    for found in S.refs {
        if found is balaur::Node && found.is_valid() {
            found.detach_script();
        }
    }
    if S.mirror is balaur::Node && S.mirror.is_valid() {
        S.mirror.queue_free();
    }
    physics::clear();
    S.mirror = scene::spawn("Edited");
    debugger::set_scope(S.mirror);
    // The whole document, not the file: a mirror read from disk cannot hold an
    // unsaved edit, and one built without the scene's `[[assets]]` block
    // cannot resolve the `#id` its nodes name.
    let building = util::obj(absolute_files(S, S.scene_doc));
    building.nodes = absolute_files(S, authored(S.doc));
    scene::instantiate(toml::encode(building), S.mirror, #{ scripts: false });
    physics::set_paused(true);
    S.playing = false;
    S.refs = [];
    let unresolved = 0;
    for node in S.doc {
        // By id rather than by name path: `find_node` answers with the first
        // sibling of a name, so two nodes called the same thing used to share
        // one live node and the inspector edited whichever came first.
        let id = node.get("id").unwrap_or("");
        let found = scene::node_by_id(id, S.mirror);
        S.refs.push(found);
        if !(found is balaur::Node) {
            unresolved += 1;
            log::warn(format!("no mirror node with id '{}' for '{}'", id, node.name));
        }
    }
    // A node with no ref is invisible to the inspector, the gizmo and every
    // transform read. Silence here is what let a whole class of nested nodes
    // go missing unnoticed, so it says so now.
    if unresolved > 0 {
        log::warn(format!("{} of {} nodes did not resolve in the mirror", unresolved, S.doc.len()));
    }
    // The mirror instantiates with the game's own `autoplay`, so pause every
    // animated node: nothing may animate under the inspector until play is
    // pressed.
    for (i, node) in S.doc.iter().enumerate() {
        if let Some(found) = live(S, i) {
            let animation_some = node.get("animation");
            if let Some(animation) = animation_some {
                if animation is Object {
                    animation::pause(found);
                }
            }
        }
    }
    // The clip cache belongs to the mirror that is gone, and every clip file
    // the new mirror names has to be pointed at the edited project before it
    // can load (`anim::rebind`, next frame).
    S.clip = None;
    S.anim.rebind = true;
}

// The live node for a doc index (`None` right after a rebuild).
pub fn live(S, i) {
    if let Some(found) = S.refs.get(i) {
        if found is balaur::Node && found.is_valid() {
            return Some(found);
        }
    }
    None
}

/// Write a node's transform to the document and the live node together.
///
/// The only place that spells the pair. `parts` carries any of `position`,
/// `rotation_euler` and `scale`; what it leaves out is left alone. History is
/// the caller's, because a drag records once at its start and then writes
/// every frame.
// A component's schema, cached: schemas are fixed for a session and the
// inspector asks for one per component per frame.
pub fn schema(S, name) {
    match S.schemas.get(name) {
        Some(cached) => cached,
        None => {
            let fresh = util::obj(scene::component_schema(name));
            S.schemas[name] = fresh;
            fresh
        }
    }
}

/// What a component declares it needs something from, cached beside the
/// schemas: the inspector asks once per component per frame otherwise.
pub fn expects(S, name) {
    match S.expects.get(name) {
        Some(cached) => cached,
        None => {
            let fresh = util::vec(scene::component_expects(name));
            S.expects[name] = fresh;
            fresh
        }
    }
}

pub fn set_transform(S, i, parts) {
    let node = S.doc[i];
    let target = live(S, i);
    // Moving a node is what gives it a transform: one the file left out is
    // written the first time something places it.
    if !node.contains_key(TRANSFORM) {
        node[TRANSFORM] = #{};
    }
    let held = node[TRANSFORM];
    for key in TRANSFORM_KEYS {
        match parts.get(key) {
            Some(v) => {
                held[key] = v;
                match target {
                    Some(t) => apply_transform(t, key, v),
                    None => (),
                }
            }
            None => (),
        }
    }
    record_override(S, node, TRANSFORM);
}

/// One of the transform's vectors as the *document* holds it, for a reader
/// that wants the authored value rather than the live node's.
pub fn doc_transform(node, key, fallback) {
    let held = node.get(TRANSFORM);
    match held {
        Some(held) => if held is Object {
            util::vec3(held.get(key).unwrap_or(()), fallback)
        } else {
            fallback
        },
        None => fallback,
    }
}

/// The transform component's name, and the properties it holds.
pub const TRANSFORM = "transform";
const TRANSFORM_KEYS = ["position", "rotation_euler", "scale"];

fn apply_transform(t, key, v) {
    if key == "position" {
        t.set_position(v[0], v[1], v[2]);
    } else if key == "rotation_euler" {
        t.set_rotation_euler(v[0], v[1], v[2]);
    } else {
        t.set_scale(v[0], v[1], v[2]);
    }
}

/// The document index whose live node is `node`, or `None`. What a picker
/// hands back is an engine node; everything the editor does is by index.
pub fn index_of_live(S, node) {
    for (i, found) in S.refs.iter().enumerate() {
        if found is balaur::Node && found.is_valid() && found.path() == node.path() {
            return Some(i);
        }
    }
    None
}

// The document index of the node at an absolute scene path, for a tool
// holding a live node and needing the document row behind it.
pub fn index_of_path(S, path) {
    for (i, found) in S.refs.iter().enumerate() {
        if found is balaur::Node && found.is_valid() && found.path() == path {
            return Some(i);
        }
    }
    None
}

pub fn selected(S) {
    (S.doc[S.sel], live(S, S.sel))
}

pub fn selected_node(S) {
    S.doc[S.sel]
}

// Write the document back to the scene file (hot reload on the game side is
// the game's watcher's business; the editor is a plain writer).
pub fn save(S) {
    // `patch`, not `encode`: a scene file is hand-written as often as not,
    // and encoding the nodes over it would drop its comments, its key order
    // and every table the editor does not model.
    let existing = fs::read(S.scene_path);
    let text = if existing is String { existing } else { "" };
    fs::write(S.scene_path, toml::patch(text, #{ nodes: authored(S.doc) }));
    forget(S, None);
    history::mark_saved(S);
    log::info("saved " + S.scene_rel);
}

fn name_taken(doc, candidate) {
    for node in doc {
        if node.name == candidate {
            return true;
        }
    }
    false
}

// Structure inside an instance belongs to the prefab: a node added, renamed
// or removed here would have nowhere in the file to live. Property overrides
// only (`docs/PLAN-scenes-and-assets.md`).
fn refuse_structure(S, what) {
    if !is_instanced(S.doc[S.sel]) {
        return false;
    }
    log::warn("cannot " + what + " inside an instance; open " + prefab_of(S, S.doc[S.sel]) + " to change its structure");
    true
}

// The prefab file a virtual row came from, for a message that says where to go.
pub fn prefab_of(S, node) {
    match by_id(S.doc, node.get("owner").unwrap_or("")) {
        Some(owner) => owner.get("instance").unwrap_or("the prefab"),
        None => "the prefab",
    }
}

// Every scene file under `scenes/`, which is what a prefab can be — the
// convention the Assets dock already opens on: a `.toml` there is a scene,
// anything else is an asset.
pub fn scene_files(S) {
    let out = [];
    // `fs::list` answers with `{ name, is_dir }`, not bare names.
    for entry in list(S, "scenes") {
        let name = util::obj(entry).get("name").unwrap_or("");
        if name.ends_with(".toml") {
            out.push("scenes/" + name);
        }
    }
    out
}

// Add a child of the selection that instances `rel`, as a plain node carrying
// `instance`: it keeps its own name and transform and the prefab's roots
// become its children, the shape `expand_instances` mirrors.
pub fn instance_scene(S, rel) {
    if refuse_structure(S, "instance a scene") {
        return;
    }
    if rel == S.scene_rel {
        log::warn("a scene cannot instance itself");
        return;
    }
    history::record(S, "instance " + rel, None);
    let base = prefab_name(rel);
    let name = base;
    let n = 1;
    while name_taken(S.doc, name) {
        n += 1;
        name = format!("{}{}", base, n);
    }
    let id = fresh_id(S.doc, name);
    S.doc.push(#{
        id: id,
        name: name,
        parent: S.doc[S.sel].get("id").unwrap_or(""),
        instance: rel,
        transform: #{ position: [0.0, 0.0, 0.0] },
    });
    // The engine builds the prefab, so the mirror has to be rebuilt rather
    // than grown a node: `expand_instances` reads the file again with it.
    expand_instances(S);
    build_mirror(S);
    // By id, not by name: expanding puts the prefab's own rows in the
    // document, and a prefab whose root shares the file's name then has two
    // rows called the same thing, of which the instance is the first.
    for (i, node) in S.doc.iter().enumerate() {
        if node.get("id").unwrap_or("") == id {
            selection::only(S, i);
        }
    }
    log::info("instanced " + rel);
}

// `scenes/enemy_camp.toml` -> `EnemyCamp`, so a placed prefab is named for
// what it is rather than for its path.
fn prefab_name(rel) {
    let file = util::last_segment(rel);
    let stem = match file.split_once('.') {
        Some((stem, _)) => stem,
        None => file,
    };
    if stem == "" {
        return "Instance";
    }
    stem[..1].to_uppercase() + stem[1..]
}

// Open the prefab behind the selection — the instance node's file, or the one
// the selected row came from. The button an instance row wants.
pub fn open_prefab(S) {
    let node = S.doc[S.sel];
    let rel = if node.contains_key("instance") {
        Some(node.instance)
    } else if is_instanced(node) {
        match by_id(S.doc, node.owner) {
            Some(owner) => owner.get("instance"),
            None => None,
        }
    } else {
        None
    };
    match rel {
        Some(rel) => open_scene(S, rel),
        None => log::info("the selection is not an instance and did not come from one"),
    }
}

// Move the selection among its siblings by `delta`: a scene edit, since order
// is what a `row` or a `column` lays out in.
pub fn move_sibling(S, delta) {
    if refuse_structure(S, "reorder nodes") {
        return;
    }
    let i = S.sel;
    if i >= S.doc.len() {
        return;
    }
    let parent = S.doc[i].get("parent").unwrap_or("");
    let sibs = [];
    for (j, node) in S.doc.iter().enumerate() {
        if node.get("parent").unwrap_or("") == parent {
            sibs.push(j);
        }
    }
    let at = 0;
    for (n, j) in sibs.iter().enumerate() {
        if j == i {
            at = n;
        }
    }
    let to = at + delta;
    if to < 0 || to >= sibs.len() {
        return;
    }
    history::record(S, "move node", None);
    let j = sibs[to];
    // The two arrays are parallel, so a swap has to move both.
    let entry = S.doc[i];
    S.doc[i] = S.doc[j];
    S.doc[j] = entry;
    let held = S.refs[i];
    S.refs[i] = S.refs[j];
    S.refs[j] = held;
    // And the live tree, so the viewport draws the order the file will hold.
    if let Some(found) = live(S, j) {
        found.set_sibling_index(to);
    }
    S.doc_rev += 1;
    selection::only(S, j);
}

// Add a node under the selected one, in both document and mirror, optionally
// applying a preset. A preset is a recipe: the components land on the node and
// nothing records which one put them there.
pub fn add_child(S, preset) {
    if refuse_structure(S, "add a node") {
        return;
    }
    history::record(S, "add node", None);
    let parent = S.doc[S.sel];
    let name = unique_name(S.doc, "Node");
    let entry = #{
        id: fresh_id(S.doc, name),
        name: name,
        parent: parent.get("id").unwrap_or(""),
        transform: #{ position: [0.0, 0.0, 0.0] },
    };
    S.doc.push(entry);
    if let Some(found) = live(S, S.sel) {
        let child = found.add_child(name);
        S.refs.push(child);
        let preset_some = preset;
        if let Some(preset) = preset_some {
            scene::apply_preset(child, preset);
            // Mirror what landed back into the document, so the saved scene
            // carries the components rather than only the live node.
            for component in child.component_names() {
                entry[component] = child.get_component(component);
            }
        }
    } else {
        S.refs.push(());
    }
    selection::only(S, S.doc.len() - 1);
}

// Take a live subtree the engine built into the document, so it lands in the
// tree, the inspector and the saved scene like anything the editor made.
// Nodes already mirrored are left alone, so calling this twice is not two.
pub fn adopt(S, found, parent_i) {
    if !(found is balaur::Node && found.is_valid()) {
        return None;
    }
    let at = index_of_path(S, found.path());
    let index = match at {
        Some(at) => at,
        None => {
            let name = found.name();
            let entry = #{
                id: fresh_id(S.doc, name),
                name: name,
                parent: match parent_i {
                    Some(parent_i) => S.doc[parent_i].get("id").unwrap_or(""),
                    None => "",
                },
                position: util::xyz(found.position()),
                rotation_euler: util::xyz(found.rotation_euler()),
                scale: util::xyz(found.scale()),
            };
            for component in found.component_names() {
                entry[component] = found.get_component(component);
            }
            S.doc.push(entry);
            S.refs.push(found);
            S.doc.len() - 1
        }
    };
    for child in found.children() {
        adopt(S, child, Some(index));
    }
    Some(index)
}

// Re-read one node's components off the live tree into its document row, for
// an engine call that wrote a component the editor did not.
pub fn adopt_components(S, i) {
    let found = match live(S, i) {
        Some(found) => found,
        None => return,
    };
    for component in found.component_names() {
        S.doc[i][component] = found.get_component(component);
    }
}

// Attach the game's scripts to the mirrored nodes (absolute paths, so the
// editor's script host loads them from the game project). This is what play
// runs: the actual game code against the actual scene.
pub fn attach_game_scripts(S) {
    for (i, node) in S.doc.iter().enumerate() {
        if let Some(found) = live(S, i) {
            let script_some = script_rel(node);
            if let Some(script) = script_some {
                found.attach_script(S.game_root + "/" + script, script_props(node));
            }
        }
    }
}

pub fn open_scene(S, rel) {
    S.scene_rel = rel;
    S.scene_path = S.game_root + "/" + rel;
    let doc = util::obj(toml::parse(fs::read(S.scene_path)));
    S.scene_doc = doc;
    S.doc = util::vec(doc.get("nodes").unwrap_or([]));
    S.doc_rev += 1;
    normalize(S.doc);
    expand_instances(S);
    selection::only(S, 0);
    history::reset(S);
    build_mirror(S);
    log::info("opened " + rel);
}

// The document mirrors the live node for saving, with two exceptions:
// `readonly` properties are stripped, and an `asset` property keeps the
// document's authored spelling — the engine's resolved one cannot be saved.
fn doc_value(S, name, data, previous) {
    let spec_of = schema(S, name);
    let out = #{};
    for (key, value) in data.iter() {
        let spec = spec_of.get(key);
        let authored = match previous {
            Some(previous) => if previous is Object { previous.get(key) } else { None },
            None => None,
        };
        let is_asset = match spec {
            Some(spec) => spec["type"] == "asset",
            None => false,
        };
        let readonly = match spec {
            Some(spec) => spec.get("readonly").unwrap_or(false) == true,
            None => false,
        };
        if is_asset && authored.is_some() {
            out[key] = authored.unwrap();
        } else if !readonly {
            out[key] = relative_file(S, value);
        }
    }
    out
}

pub fn sync_component_doc(S, name) {
    sync_component_doc_at(S, S.sel, name);
}

pub fn sync_component_doc_at(S, i, name) {
    let node = S.doc[i];
    let found = match live(S, i) {
        Some(found) => found,
        None => return,
    };
    let data = found.get_component(name);
    if data is Object {
        node[name] = doc_value(S, name, data, node.get(name));
    } else {
        node.remove(name);
    }
    record_override(S, node, name);
}

// An edit to a row inside an instance is not written to the file — the row is
// not in it. It becomes an `overrides` entry on the node that named the
// prefab, which is.
pub fn record_override(S, node, key) {
    if !is_instanced(node) {
        return;
    }
    let owner = match by_id(S.doc, node.owner) {
        Some(owner) => owner,
        None => return,
    };
    let table = util::obj(owner.get("overrides").unwrap_or(#{}));
    let entry = util::obj(table.get(node.at).unwrap_or(#{}));
    let base = util::obj(node.get("base").unwrap_or(#{}));
    match differing(node.get(key), base.get(key)) {
        Some(value) => entry[key] = value,
        None => entry.remove(key),
    }
    if entry.is_empty() {
        table.remove(node.at);
    } else {
        table[node.at] = entry;
    }
    if table.is_empty() {
        owner.remove("overrides");
    } else {
        owner.overrides = table;
    }
}

pub fn add_component(S, name) {
    let found = match live(S, S.sel) {
        Some(found) => found,
        None => return,
    };
    history::record(S, format!("add {}", name), None);
    found.set_component(name);
    sync_component_doc(S, name);
    log::info(format!("added {} to {}", name, S.doc[S.sel].name));
}

pub fn remove_component(S, name) {
    let found = match live(S, S.sel) {
        Some(found) => found,
        None => return,
    };
    // Whatever else on the node declares it needs this one goes first: taking
    // the transform out from under a body leaves the body driving nothing.
    let needed_by = [];
    for other in util::vec(found.component_names()) {
        if other != name && util::contains(expects(S, other), name) {
            needed_by.push(other);
        }
    }
    if !needed_by.is_empty() {
        let list = util::join(needed_by, " and ");
        log::warn(format!("cannot remove {}: {} needs it; remove {} first", name, list, list));
        return;
    }
    history::record(S, format!("remove {}", name), None);
    found.remove_component(name);
    S.doc[S.sel].remove(name);
}

// Push the document's component onto the live node, for a tool that edited
// the document in place and recorded history itself.
pub fn apply_component(S, name) {
    let node = S.doc[S.sel];
    let found = match live(S, S.sel) {
        Some(found) => found,
        None => return,
    };
    let authored = match node.get(name) {
        Some(authored) => authored,
        None => return,
    };
    found.set_component(name, absolute_files(S, authored));
    sync_component_doc(S, name);
    // `doc_value` keeps an asset's authored spelling only when it is a
    // reference; an inline table is the authored form, so it goes back whole.
    let spec_of = schema(S, name);
    for (key, spec) in spec_of.iter() {
        if spec["type"] == "asset" && authored is Object {
            if let Some(inline) = authored.get(key) {
                if inline is Object && node.contains_key(name) {
                    node[name][key] = inline;
                }
            }
        }
    }
}

/// Write one property across the selection: every selected node that carries
/// the component takes the value, and the whole write is one history step.
pub fn set_component_prop(S, name, prop, value) {
    history::record(S, format!("set {}.{}", name, prop), Some(format!("prop:{}:{}:{}", name, prop, S.sel)));
    for i in selection::all(S) {
        let has = match live(S, i) {
            Some(found) => found.has_component(name),
            None => false,
        };
        if has {
            set_component_prop_at(S, i, name, prop, value);
        }
    }
}

fn set_component_prop_at(S, i, name, prop, value) {
    let found = match live(S, i) {
        Some(found) => found,
        None => return,
    };
    let node = S.doc[i];
    let data = util::obj(found.get_component(name));
    let params = doc_value(S, name, data, node.get(name));
    params[prop] = value;
    found.set_component(name, absolute_files(S, params));
    sync_component_doc_at(S, i, name);
    // `doc_value` keeps the document's spelling of an asset property, which is
    // exactly wrong for the one property that was just retyped, so it is
    // stamped back over afterwards.
    let spec = schema(S, name).get(prop);
    let spec_some = spec;
    if let Some(spec) = spec_some {
        if spec["type"] == "asset" && node.contains_key(name) {
            node[name][prop] = value;
        }
    }
}

// Duplicate every selected node (without children), then rebuild the mirror.
pub fn duplicate_selected(S) {
    if refuse_structure(S, "duplicate a node") {
        return;
    }
    history::record(S, "duplicate node", None);
    let made = [];
    for i in selection::all(S) {
        let src = S.doc[i];
        let copy = #{};
        for (key, value) in src.iter() {
            copy[key] = util::copy(value);
        }
        copy.name = unique_name(S.doc, src.name);
        // The copy carried the original's id, which the engine then had to
        // regenerate for itself; children address a parent by id, so it is ours.
        copy.id = fresh_id(S.doc, copy.name);
        S.doc.push(copy);
        made.push(S.doc.len() - 1);
    }
    selection::set(S, made);
    build_mirror(S);
}

/// The selection as a scene document, for the clipboard. Its id goes: the
/// paste mints a fresh one, and two nodes with one id is what the engine
/// cannot mirror.
pub fn copy_selected(S) {
    let src = S.doc[S.sel];
    let out = #{};
    for (key, value) in src.iter() {
        if key != "id" && key != "parent" {
            out[key] = util::copy(value);
        }
    }
    toml::encode(#{ nodes: [out] })
}

/// Paste a scene document beside the selection. Anything that is not one is
/// left alone, because the clipboard is shared with every other application.
pub fn paste_nodes(S, text) {
    // The clipboard holds whatever the last application put there, so a
    // parse failure is an answer, not an error.
    let (parsed, doc) = script::attempt(|| toml::parse(text));
    if !parsed || !(doc is Object) {
        return false;
    }
    let nodes = util::vec(doc.get("nodes").unwrap_or([]));
    if nodes.len() == 0 {
        return false;
    }
    history::record(S, "paste node", None);
    for node in nodes {
        if !(node is Object) || !node.contains_key("name") {
            continue;
        }
        let copy = util::deep(node);
        let base = copy.name;
        let n = 2;
        while name_taken(S.doc, format!("{}{}", base, n)) {
            n += 1;
        }
        copy.name = format!("{}{}", base, n);
        copy.id = fresh_id(S.doc, copy.name);
        // A pasted node joins the selection's parent, not its own old one.
        copy.parent = S.doc[S.sel].parent;
        S.doc.insert(S.sel + 1, copy);
        selection::only(S, S.sel + 1);
    }
    build_mirror(S);
    true
}

pub fn delete_selected(S) {
    let rows = selection::all(S);
    if S.doc.len() <= rows.len() {
        log::warn("cannot delete every node");
        return;
    }
    if refuse_structure(S, "delete a node") {
        return;
    }
    let label = if rows.len() > 1 {
        format!("delete {} nodes", rows.len())
    } else {
        format!("delete {}", S.doc[S.sel].name)
    };
    history::record(S, label, None);
    let doomed = #{};
    for i in rows {
        doomed[S.doc[i].id] = true;
        if let Some(found) = live(S, i) {
            found.queue_free();
        }
    }
    let kept = [];
    for (i, node) in S.doc.iter().enumerate() {
        let gone = doomed.contains_key(node.id);
        for id in doomed.keys() {
            if has_ancestor(S.doc, node, id) {
                gone = true;
            }
        }
        if !gone {
            kept.push(node);
        }
    }
    S.doc = kept;
    S.doc_rev += 1;
    selection::only(S, util::clamp(S.sel, 0, S.doc.len() - 1));
    build_mirror(S);
    log::info(label);
}

pub fn stats(S) {
    let scripts = 0;
    for node in S.doc {
        if node.contains_key("script") {
            scripts += 1;
        }
    }
    (S.doc.len(), scripts)
}
