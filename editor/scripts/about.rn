// The About sheet: which build this is, the line it follows, and whether that
// line has moved on. The check and the install are the Engine tab's own, so
// the sheet and the start screen say the same thing.

use crate::style;
use crate::util;

const SHEET = "about";
const SITE = "https://balaurengine.org";
const SOURCE = "https://github.com/balaurengine/balaur";
const LABEL_W = 96.0;

/// Show the sheet. Opening it is asking, so the feed is read once here unless
/// the start screen already read it.
pub fn open(S) {
    crate::window::show(S, SHEET);
    if !S.manager.asked && !crate::manager::in_tab() {
        crate::manager::check(S);
    }
}

pub fn draw(S) {
    let hosts = crate::window::sheet_form(S, SHEET, "About Balaur", || {});
    if util::is_nil(hosts) {
        return;
    }
    crate::pool::sync(S, hosts.form, specs(S), LABEL_W, false);
}

/// Every row the sheet shows: which build this is, the line it follows, and
/// where to read more.
fn specs(S) {
    let mine = util::obj(release::installed());
    let out = [#{ full: true, height: 56, slot_role: "layout_actions", controls: [
        #{ kind: "panel", role: "sheet_logo", controls: [
            #{ kind: "image", source: crate::manager::LOGO, width: 44 },
        ] },
        #{ kind: "column", role: "layout_about", controls: [
            #{ kind: "label", role: "text_title", text: "Balaur " + mine.version },
            #{ kind: "label", role: "text_caption", text: crate::manager::build_line(mine) },
        ] },
    ] }];
    fact(out, "Version", mine.version);
    fact(out, "Build", if mine.source == true { "from a checkout" } else { mine.id });
    fact(out, "Channel", if mine.channel == "" { "none" } else { mine.channel });
    fact(out, "Platform", engine::platform().os);
    fact(out, "Licence", "MIT");
    // A tab runs the build the page served it, so it has no line to follow.
    // Drawn, because the check and the install are the start screen's own.
    if !crate::manager::in_tab() {
        out.push(#{ full: true, height: 72, draw: "draw_about_update" });
    }
    out.push(#{ full: true, height: 30, slot_role: "layout_actions", controls: [
        link("balaurengine.org", SITE),
        link("Source", SOURCE),
    ] });
    out
}

// One label and its value, the value in the monospace a build id reads in.
fn fact(out, name, value) {
    out.push(#{ label: name, height: 22, controls: [#{
        kind: "label", role: "text_code", grow: 1, text: value,
    }] });
}

fn link(text, url) {
    #{
        kind: "button", role: "chip", text: text, tooltip: url,
        on: |_| { engine::open_url(url); },
    }
}

/// The hatch the update row draws into: the line's standing, the release to
/// move to, and the press that asks again.
pub fn draw_update(S) {
    let k = S.theme;
    let mine = util::obj(release::installed());
    update(S, k, crate::window::inner_w(S), util::max(style::row_h(S), 30.0), mine);
}

// Where this build's line stands, the press that asks again, and the newest
// release on it when there is one to move to.
fn update(S, k, w, h, mine) {
    // A source build follows no line; the nightly is what it is nearest to.
    let line = if mine.channel == "" { "nightly" } else { mine.channel };
    let newest = crate::manager::newest_on(S, line);
    ui::row(#{ height: h, width: w }, || {
        let fresh = newest.get("order").unwrap_or("") == "newer";
        ui::label(line + ": " + crate::manager::standing(S, line), style::mono_sm(
            if fresh { k.success_text } else { k.text_subtle }));
        ui::align_right(|| {
            // Up to date already says it; only a release to move to gets a press.
            if newest.get("id").unwrap_or("") != "" && newest.get("order").unwrap_or("") != "same" {
                crate::manager::row_press(S, k, h, newest, mine);
                ui::add_space(8);
            }
            let word = if S.manager.reading { "Checking" } else { "Check" };
            if ui::button(word, #{
                height: h, font_size: style::SM, corner_radius: 8, padding_x: 12,
                fill: k.bg_control, text_color: k.text_muted,
            }) {
                crate::manager::check(S);
            }
        });
    });
    if mine.held != "" {
        ui::label(mine.held, util::merge(style::mono_sm(k.text_subtle), #{ wrap: true, width: w }));
    }
    let said = if S.manager.failed != "" { S.manager.failed } else { S.manager.note };
    if said != "" {
        let tone = if S.manager.failed != "" { k.warning_text } else { k.text_subtle };
        ui::label(said, util::merge(style::mono_sm(tone), #{ wrap: true, width: w }));
    }
    if crate::manager::installing(S) {
        crate::manager::install_progress(S, k, w);
    }
}


