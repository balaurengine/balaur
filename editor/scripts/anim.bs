//! The Animation workspace's adapter between the scene and the engine's
//! `assets` / `animation` modules: scrubbing seeks the engine, nothing here
//! samples. The clip belongs to the player (`player`), keyed by node path.
//! An inline clip is the player's `animation` table as asked, held for the
//! frame (`model::edited`) and handed back whole by `arm`.

use editor;
use history;
use model;
use signals;
use util;
use words::changes;
use words::components;
use words::fields;
use words::inspector_fields;
use words::log_fields;
use words::panel_keys;
use words::schema_fields;
use words::tabs;

const AUTOPLAY: str = "autoplay";
const ROOT_NODE: str = "root_node";
const SPEED_SCALE: str = "speed_scale";
const TRACKS: str = "tracks";

/// The animation timeline's own state, hung on `state.anim`.
pub class AnimState {
    internal time: float,
}

/// The library the Timeline edits, cached for the player at `index`: what
/// the component named (`source`), the document it holds, the file it was
/// read from, and whether an edit has not been written back yet.
pub class Clip {
    index: int,
    source: any,
    doc: any,
    path: str?,
    dirty: bool,
}

/// The player's node and its row.
pub struct Player {
    internal found: Node,
    index: int,
}

pub fn state() -> AnimState {
    AnimState { time: 0.0 }
}

/// The component a player is.
const COMPONENT: str = "animation";

// The asset type `balaur_animation` registers, written into the document so a
// promoted file declares what it is.
const CLIP_TYPE: str = "animation_library";
// The group a library document holds its named clips under. The engine finds
// an entry one level down whatever the group is called; the editor has to
// pick one to write.
const GROUP: str = "clips";
// How close two key times have to be to count as the same key: half a frame
// at 24 fps, which is the grain a person scrubbing can actually hit.
const SAME_TIME: float = 0.021;
// A hand-edited file can name a parent that names it back.
const MAX_DEPTH: int = 256;

/// The `animation` component as `found` asks for it, held for the frame so
/// an edit's calls change one table; nil for a node without one.
pub fn component(state: editor::State, found: Node) -> any {
    model::edited(state, found, COMPONENT)
}

/// Doc index of the node whose clip the Timeline edits: the selection when
/// it carries `animation`, else its nearest ancestor that does, else the
/// selection itself (the node a new clip would be created on).
pub fn player_index(state: editor::State) -> int {
    let selected = state.selected;
    // Nothing selected: no clip is being edited, and -1 is not an index.
    if selected < 0 {
        return selected;
    }
    let current = model::node(state, selected);
    for _depth in 0..MAX_DEPTH {
        if !current.is_valid() {
            break;
        }
        if current.has_component(COMPONENT) {
            return model::index_of_node(state, current).or(state.selected);
        }
        if model::is_scene_root(state, current) {
            break;
        }
        current = current.parent();
    }
    state.selected
}

pub fn player(state: editor::State) -> Player {
    let index = player_index(state);
    Player { found: model::node(state, index), index: index }
}

/// The selection's node path relative to the player: what a track's
/// `target` says. Empty when the selection is the player.
pub fn target_path(state: editor::State, player_node_index: int) -> str {
    if player_node_index == state.selected || state.selected < 0 {
        return "";
    }
    let names: [str] = [];
    let player = model::node(state, player_node_index);
    let current = model::selected_node(state);
    for _depth in 0..MAX_DEPTH {
        if !current.is_valid() || current == player {
            break;
        }
        names.insert(0, current.name());
        current = current.parent();
    }
    util::join(names, "/")
}

/// The clip the Timeline edits: the one the scene starts. An empty name means
/// the library reference is itself the clip, which is what a single-clip file
/// and an anonymous inline table each are.
pub fn clip_name(state: editor::State, found: Node) -> str {
    let animation_component = component(state, found);
    if animation_component == nil {
        return "";
    }
    let name = animation_component[AUTOPLAY];
    if name.kind() == types::KIND_STRING { name.as_str() } else { "" }
}

/// Where the library lives, for display: a path, or nil when it is inline.
pub fn library_path(state: editor::State, found: Node) -> str? {
    let animation_component = component(state, found);
    if animation_component == nil {
        return nil;
    }
    let library = animation_component[panel_keys::LIBRARY];
    if library.kind() == types::KIND_STRING && library.as_str() != "" { library.as_str() } else { nil }
}

// The named entry inside a library document, by the engine's own rule: a
// top-level table of that name, or one a single level down.
fn entry_of(doc: any, name: str) -> any {
    if name == "" {
        return doc;
    }
    let entry = doc[name];
    if entry.kind() == types::KIND_MAP {
        return entry;
    }
    for key in doc.keys() {
        let group = doc[key];
        if group.kind() == types::KIND_MAP && group[name].kind() == types::KIND_MAP {
            return group[name];
        }
    }
    nil
}

fn same(first: any, second: any) -> bool {
    first.kind() == second.kind() && (first.kind() == types::KIND_MAP || first.kind() == types::KIND_STRING) && first == second
}

fn library_of(animation_component: any) -> any {
    let library = animation_component[panel_keys::LIBRARY];
    if library == nil { "" } else { library }
}

fn cache(state: &mut editor::State, index: int, source: any, doc: any, path: str?) {
    state.clip = Clip { index: index, source: source, doc: doc, path: path, dirty: false };
    signals::inspector(state);
}

/// The library document for the player, cached on `state.clip`, or nil. Inline
/// it *is* the player's own table, as held for the frame; external it is
/// written back by `save`.
pub fn document(state: &mut editor::State) -> any {
    let owner = player(state);
    let animation_component = component(state, owner.found);
    if animation_component == nil {
        return nil;
    }
    let library = library_of(animation_component);
    if library.kind() == types::KIND_MAP {
        // The held table and not a copy from an earlier frame: what an edit
        // changes is what `arm` hands back.
        if state.clip != nil && state.clip.unwrap().index == owner.index && state.clip.unwrap().path == nil {
            let cached = state.clip.unwrap();
            cached.source = library;
            cached.doc = library;
        } else {
            cache(state, owner.index, library, library);
        }
        return library;
    }
    if state.clip != nil {
        let cached = state.clip.unwrap();
        if cached.index == owner.index && same(cached.source, library) {
            return cached.doc;
        }
    }
    if library.kind() == types::KIND_STRING && library.as_str() != "" {
        let path = library.as_str();
        let loaded = assets::load(util::engine_path(state.game_root, path));
        if loaded.kind() != types::KIND_MAP {
            log::warn("clip {path}: {loaded}");
            // Cached as a failure so the warning is printed once rather than
            // once a frame.
            cache(state, owner.index, library, nil, path);
            return nil;
        }
        cache(state, owner.index, library, loaded, path);
        return loaded;
    }
    cache(state, owner.index, library);
    nil
}

/// Every clip the player's library holds, by name: the entries one level
/// down, as the engine finds them.
pub fn clip_names(state: &mut editor::State) -> [str] {
    let out: [str] = [];
    let doc = document(state);
    if doc == nil {
        return out;
    }
    for key in doc.keys() {
        let group = doc[key];
        if group.kind() != types::KIND_MAP {
            continue;
        }
        for name in group.keys() {
            if group[name].kind() == types::KIND_MAP {
                out.push(name);
            }
        }
    }
    out
}

/// The clip definition under edit: length, loop, tracks; nil for none.
pub fn definition(state: &mut editor::State) -> any {
    let doc = document(state);
    if doc == nil { nil } else { entry_of(doc, clip_name(state, model::node(state, player_index(state)))) }
}

pub fn tracks(clip_definition: any) -> any {
    let tracks = clip_definition[TRACKS];
    if tracks.kind() == types::KIND_LIST { tracks } else { [] }
}

/// A lane's name: the property, prefixed by the node it drives when that is
/// not the player itself.
pub fn track_label(track: any) -> str {
    let property = if track[inspector_fields::PROPERTY] == nil { "call" } else { track[inspector_fields::PROPERTY].as_str() };
    let target = track[inspector_fields::TARGET].as_str();
    if target == "" { property } else { "{target} · {property}" }
}

pub fn length(clip_definition: any) -> float {
    let held = clip_definition[fields::LENGTH];
    util::max(if held == nil { 2.0 } else { held.as_float() }, 0.001)
}

pub fn key_count(clip_definition: any) -> int {
    let count = 0;
    for track in tracks(clip_definition) {
        count += util::list_or_empty(track[fields::KEYS]).len();
    }
    count
}

fn component_parameters(animation_component: any, library: any) -> any {
    let speed = animation_component[SPEED_SCALE];
    {
        panel_keys::LIBRARY: library,
        AUTOPLAY: animation_component[AUTOPLAY].as_str(),
        SPEED_SCALE: if speed == nil { 1.0 } else { speed.as_float() },
        ROOT_NODE: animation_component[ROOT_NODE].as_str(),
    }
}

/// Put the edited clip in front of the engine and hold it at the playhead:
/// `animation::add_clip` hands over the editor's in-memory table, edits
/// included.
pub fn arm(state: &mut editor::State) {
    let owner = player(state);
    let animation_component = component(state, owner.found);
    if animation_component == nil {
        cache(state, owner.index, "");
        return;
    }
    if !owner.found.is_valid() {
        // Nothing live to push the clip to. The document still reads, so
        // the Timeline shows it; filling the cache is what stops the
        // re-arm loop.
        document(state);
        return;
    }
    let library = library_of(animation_component);
    if library.kind() == types::KIND_STRING && library.as_str() != "" {
        library = util::engine_path(state.game_root, library.as_str());
    }
    owner.found.set_component(tabs::ANIMATION, component_parameters(animation_component, library));
    let clip_definition = definition(state);
    if clip_definition == nil {
        return;
    }
    let name = clip_name(state, owner.found);
    owner.found.animation.add_clip(name, clip_definition);
    // While the scene is running it is the game's transport, not the editor's:
    // restarting the clip to show the playhead would be the editor animating
    // over the thing it is supposed to be previewing.
    if state.playing {
        return;
    }
    owner.found.animation.play(name);
    owner.found.animation.pause();
    owner.found.animation.seek(state.anim.time);
}

/// The clip changed: the scene needs saving, an external clip needs writing,
/// and the engine needs the new table.
pub fn touch(state: &mut editor::State) {
    if state.clip != nil {
        let clip = state.clip.unwrap();
        clip.dirty = true;
    }
    arm(state);
    signals::changed(state, changes::TIMELINE);
}

/// Create an inline clip on the player, named after it. With no player above
/// the selection, the selection becomes one.
pub fn ensure_clip(state: &mut editor::State) -> any {
    let found = model::node(state, player_index(state));
    if !found.is_valid() {
        return nil;
    }
    if component(state, found) != nil {
        return definition(state);
    }
    history::record(state, "create clip");
    let name = found.name().to_lower();
    let clips: any = { name: { fields::LENGTH: 2.0, schema_fields::LOOP_MODE: animation::LOOP_LINEAR } };
    let library: any = { fields::TYPE: CLIP_TYPE, GROUP: clips };
    found.set_component(COMPONENT, { panel_keys::LIBRARY: library, AUTOPLAY: name, SPEED_SCALE: 1.0, ROOT_NODE: "" });
    // The node carries the component now, which the frame's held read did not.
    model::drop_edited(state);
    state.clip = nil;
    signals::inspector(state);
    signals::changed(state, changes::TIMELINE);
    arm(state);
    log::info("created clip '{name}' on {found.name()}");
    definition(state)
}

fn track_for(clip_definition: any, property: str, target: str) -> any {
    for track in tracks(clip_definition) {
        if track[inspector_fields::TARGET].as_str() == target && track[inspector_fields::PROPERTY].as_str() == property {
            return track;
        }
    }
    let track: any = { inspector_fields::PROPERTY: property, "interpolation": animation::INTERPOLATION_LINEAR, fields::KEYS: [] };
    if target != "" {
        track[inspector_fields::TARGET] = target;
    }
    if clip_definition[TRACKS].kind() != types::KIND_LIST {
        clip_definition[TRACKS] = [];
    }
    clip_definition[TRACKS].push(track);
    track
}

fn put_key(track: any, time: float, value: any) {
    let key: any = { log_fields::TIME: time, fields::VALUE: value };
    let keys = util::list_or_empty(track[fields::KEYS]);
    let out: [any] = [];
    let placed = false;
    for index in 0..keys.len() {
        let old = keys[index];
        let key_time = old[log_fields::TIME].as_float();
        if !placed && util::abs(key_time - time) < SAME_TIME {
            out.push(key);
            placed = true;
            continue;
        }
        if !placed && key_time > time {
            out.push(key);
            placed = true;
        }
        out.push(old);
    }
    if !placed {
        out.push(key);
    }
    track[fields::KEYS] = out;
}

/// Insert (or replace) a key at `time` from the selection's current transform,
/// on the player's clip, addressed by path. A bone keys its rotation alone:
/// its position is its rest, and a key there would tear the rig.
pub fn add_key(state: &mut editor::State, time: float) {
    let clip_definition = ensure_clip(state);
    let found = model::selected_node(state);
    if !found.is_valid() {
        return;
    }
    let player_node_index = player_index(state);
    if clip_definition == nil {
        log::warn("{found.name()}: the library has no clip called '{clip_name(state, model::node(state, player_node_index))}'");
        return;
    }
    history::record(state, "insert keyframe");
    let target = target_path(state, player_node_index);
    put_key(track_for(clip_definition, animation::PROPERTY_ROTATION_EULER, target), time, util::xyz(found.transform.rotation_euler));
    if !found.has_component(components::BONE2D) && !found.has_component(components::BONE3D) {
        put_key(track_for(clip_definition, animation::PROPERTY_POSITION, target), time, util::xyz(found.transform.position));
    }
    if time > length(clip_definition) {
        clip_definition[fields::LENGTH] = time;
    }
    touch(state);
    log::info("key at {seconds(time)}s ({key_count(clip_definition)} keys)");
}

// A time to two places, as a log line gives one.
fn seconds(time: float) -> str {
    let hundredths = math::round(time * 100.0) as int;
    let fraction = hundredths % 100;
    "{hundredths / 100}.{if fraction < 10 { "0" } else { "" }}{fraction}"
}

/// Insert (or replace) a key on one named property of the selection, for a
/// tool that keys something a transform snapshot does not cover: the Polygon
/// tool's `polygon/deform` is the first.
pub fn key_property(state: &mut editor::State, time: float, property: str, value: any) {
    let clip_definition = ensure_clip(state);
    let player_node_index = player_index(state);
    if clip_definition == nil {
        log::warn("the library has no clip called '{clip_name(state, model::node(state, player_node_index))}'");
        return;
    }
    history::record(state, "key {property}");
    put_key(track_for(clip_definition, property, target_path(state, player_node_index)), time, value);
    if time > length(clip_definition) {
        clip_definition["length"] = time;
    }
    touch(state);
    log::info("{property} keyed at {seconds(time)}s");
}

/// Delete the selection's keys at the playhead; other nodes' lanes keep theirs.
pub fn delete_key_at(state: &mut editor::State, time: float) {
    let clip_definition = definition(state);
    if clip_definition == nil {
        return;
    }
    history::record(state, "delete keyframe");
    let target = target_path(state, player_index(state));
    let kept: [any] = [];
    for track in tracks(clip_definition) {
        let keys: [any] = [];
        for key in util::list_or_empty(track[fields::KEYS]) {
            if track[inspector_fields::TARGET].as_str() != target || util::abs(key[log_fields::TIME].as_float() - time) >= 0.05 {
                keys.push(key);
            }
        }
        track[fields::KEYS] = keys;
        // A track with no keys is not a track: the engine rejects one, so
        // the editor never writes one.
        if keys.len() > 0 {
            kept.push(track);
        }
    }
    if kept.len() > 0 {
        clip_definition[TRACKS] = kept;
    } else {
        clip_definition.remove(TRACKS);
    }
    touch(state);
}

/// Move the playhead. The engine poses the node; the editor samples nothing.
pub fn seek(state: &mut editor::State, time: float) {
    state.anim.time = time;
    signals::changed(state, changes::TIMELINE);
    let owner = player(state);
    if owner.found.is_valid() && component(state, owner.found) != nil {
        owner.found.animation.seek(time);
    }
}

/// Inline to external: the same table, in a file of its own.
pub fn promote(state: &mut editor::State) {
    let owner = player(state);
    let animation_component = component(state, owner.found);
    let doc = document(state);
    if animation_component == nil || doc == nil {
        return;
    }
    history::record(state, "save clip as file");
    if library_of(animation_component).kind() != types::KIND_MAP {
        log::warn("this clip is already a file");
        return;
    }
    let rel = "animations/" + owner.found.name().to_lower() + ".toml";
    doc[fields::TYPE] = CLIP_TYPE;
    fs::write(util::engine_path(state.game_root, rel), toml::encode(doc));
    assets::reload(util::engine_path(state.game_root, rel));
    animation_component[panel_keys::LIBRARY] = rel;
    state.clip = nil;
    signals::inspector(state);
    arm(state);
    log::info("saved " + rel + " (undo detaches it; the file stays)");
}

/// External to inline: a private copy of the document, owned by this node.
pub fn make_inline(state: &mut editor::State) {
    let owner = player(state);
    let animation_component = component(state, owner.found);
    let rel = library_path(state, owner.found);
    if animation_component == nil || rel == nil {
        log::warn("this clip is already embedded");
        return;
    }
    history::record(state, "embed clip");
    let copy = assets::duplicate(util::engine_path(state.game_root, rel.unwrap()));
    if copy.kind() != types::KIND_MAP {
        log::warn("cannot embed {rel.unwrap()}: {copy}");
        return;
    }
    // A reference to one entry brings back that entry alone, so it is wrapped
    // back into a library under the name it was addressed by, which is also
    // the name `autoplay` now has to carry.
    let parts = rel.unwrap().split_once("#");
    if parts.len() == 2 {
        copy = { GROUP: { parts[1]: copy } };
        animation_component[AUTOPLAY] = parts[1];
    }
    copy[fields::TYPE] = CLIP_TYPE;
    animation_component[panel_keys::LIBRARY] = copy;
    state.clip = nil;
    signals::inspector(state);
    arm(state);
    log::info("clip is now embedded in {owner.found.name()}");
}

/// Write an external clip back to its file. An inline clip is saved with the
/// scene, so there is nothing separate to write.
pub fn save(state: &mut editor::State) {
    if state.clip == nil {
        return;
    }
    let clip = state.clip.unwrap();
    if clip.path == nil || clip.doc == nil || !clip.dirty {
        return;
    }
    let path = clip.path.unwrap();
    fs::write(util::engine_path(state.game_root, path), toml::encode(clip.doc));
    assets::reload(util::engine_path(state.game_root, path));
    clip.dirty = false;
    log::info("saved " + path);
}

/// Let the scene's players run again (F5). `arm` paused them; the scene is
/// built paused so it does not animate under the inspector.
pub fn resume_all(state: editor::State) {
    for found in state.nodes {
        if found.is_valid() && found.has_component(COMPONENT) {
            found.animation.resume();
        }
    }
}

/// The engine advances every player itself. All the editor does per frame is
/// follow the playhead while the scene runs, and re-arm when the selection
/// moves to another player.
pub fn update(state: &mut editor::State) {
    let player_node_index = player_index(state);
    if state.playing {
        let owner = player(state);
        if owner.found.is_valid() && owner.found.has_component(COMPONENT) {
            state.anim.time = owner.found.animation.time();
        }
        return;
    }
    let stale = state.clip == nil || state.clip.unwrap().index != player_node_index;
    if stale {
        // The cache is about to be replaced, so an external clip edited but
        // not yet written goes to its file now rather than being dropped.
        save(state);
        state.clip = nil;
        signals::inspector(state);
        signals::changed(state, changes::TIMELINE);
        arm(state);
    }
}
