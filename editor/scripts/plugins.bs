//! Editor plugins: `.bs` scripts on nodes under `Editor/Plugins`, adding
//! panels, dialogs, commands, inspector sections, property editors, overlays
//! and start-up states.

// `register()` names the methods a plugin adds; the editor calls each on its
// node with a payload, and the plugin reaches back through the Editor node's
// methods (`document`, `select`, `open_scene`, `kit_*`).

use docks;
use editor;
use icons;
use inspector;
use kit;
use pool;
use signals;
use util;

/// What every plugin added, each entry a table naming its `owner` node and
/// the method that answers it.
pub class PluginsState {
    panels: [any],
    dialogs: [any],
    commands: [any],
    inspector_sections: [any],
    overlays: [any],
    property_editors: any,
    startup_states: any,
    open: any,
    loaded: [str],
}

/// The registries, before any plugin has been seen.
pub fn state() -> PluginsState {
    PluginsState {
        panels: [],
        dialogs: [],
        commands: [],
        inspector_sections: [],
        overlays: [],
        property_editors: {},
        startup_states: {},
        open: {},
        loaded: [],
    }
}

// The node each plugin's script runs on is made under this one.
const HOST: str = "Editor/Plugins";

/// Where a plugin lives: the editor's own, on for every project; the game's;
/// and each addon's `editor/`, on while the game carries that addon.
fn roots(state: editor::State) -> [str] {
    // With no project open there is only the editor's own directory: a
    // relative path off an empty root is a path outside every root there is.
    if state.game_root == "" {
        return ["plugins"];
    }
    let found = ["plugins", state.game_root + "/editor"];
    let addons = state.game_root + "/addons";
    for entry in util::list_or_empty(fs::list(addons)) {
        if entry.is_dir.as_bool() {
            found.push(addons + "/" + entry.name.as_str() + "/editor");
        }
    }
    found
}

/// Load every plugin in every root, in name order so registration order
/// does not depend on the filesystem's.
pub fn load(state: &mut editor::State) {
    // Saves pointed at the game's own folder before any plugin registers.
    kit::adopt_game_data(state);
    let host = scene::get_node(HOST);
    if !host.is_valid() {
        host = scene::get_node("Editor").add_child("Plugins");
    }
    for root in roots(state) {
        let names: [str] = [];
        for entry in util::list_or_empty(fs::list(root)) {
            let name = entry.name.as_str();
            if !entry.is_dir.as_bool() && name.ends_with(".bs") {
                names.push(name);
            }
        }
        names.sort();
        for name in names {
            load_one(state, host, root + "/" + name, name.slice(0, name.len() - 3));
        }
    }
    if state.registry.loaded.len() > 0 {
        log::info("editor plugins: {util::join(state.registry.loaded, ", ")}");
    }
}

fn load_one(state: &mut editor::State, host: Node, path: str, id: str) {
    let node = host.add_child(id);
    node.attach_script(path);
    if !node.has_method("register") {
        log::warn("{path}: no register(); skipped");
        node.queue_free();
        return;
    }
    let declared = node.call("register");
    if declared.kind() != "map" {
        log::error("{path}: register() returned no table");
        return;
    }
    add_all(state, node, declared);
    state.registry.loaded.push(id);
}

// Every list is optional: a plugin declares only what it adds.
fn add_all(state: &mut editor::State, owner: Node, declared: any) {
    for entry in util::list_or_empty(declared.panels) {
        state.registry.panels.push({
            "id": entry.id,
            "title": entry.title,
            "icon": entry.icon.as_str(),
            "tall": entry.tall.as_bool(),
            "draw": entry.draw,
            "owner": owner,
        });
        // Registering a panel is not enough to reach it: a panel is drawn by
        // the dock whose tab list holds its id.
        docks::adopt(state, entry.id.as_str());
    }
    for entry in util::list_or_empty(declared.dialogs) {
        state.registry.dialogs.push({ "id": entry.id, "title": entry.title, "rows": entry.rows, "owner": owner });
    }
    for entry in util::list_or_empty(declared.commands) {
        let icon = entry.icon;
        state.registry.commands.push({
            "title": entry.title,
            "icon": if icon.is_nil() { "·" } else { icon.as_str() },
            "shortcut": entry.shortcut.as_str(),
            "run": entry.run,
            "owner": owner,
        });
    }
    for rows in util::list_or_empty(declared.inspector_sections) {
        state.registry.inspector_sections.push({ "rows": rows, "owner": owner });
    }
    for draw in util::list_or_empty(declared.overlays) {
        state.registry.overlays.push({ "draw": draw, "owner": owner });
    }
    // A property editor answers a row's controls for a value of its type.
    let editors = util::map_or_empty(declared.property_editors);
    for datatype in editors.keys() {
        state.registry.property_editors.set(datatype, { "controls": editors.get(datatype), "owner": owner });
    }
    let states = util::map_or_empty(declared.startup_states);
    for name in states.keys() {
        state.registry.startup_states.set(name, { "run": states.get(name), "owner": owner });
    }
}

// What the plugin that registered `entry` answers to its method under `key`.
fn ask(entry: any, key: str, payload: any) -> any {
    entry.owner.as_node().call(entry.get(key).as_str(), payload)
}

/// A registered panel's entry, or nil.
pub fn panel(state: editor::State, id: str) -> any {
    for entry in state.registry.panels {
        if entry.id.as_str() == id {
            return entry;
        }
    }
    nil
}

/// Have the plugin whose panel is `id` fill the node at `host`.
pub fn draw_panel(state: &mut editor::State, id: str, host: str) {
    let entry = panel(state, id);
    if !entry.is_nil() {
        ask(entry, "draw", { "host": host, "theme": state.theme });
    }
}

/// Run a command a plugin registered: one of `state.registry.commands`.
pub fn run(state: &mut editor::State, command: any) {
    ask(command, "run", {});
}

/// The rows each plugin's inspector section asks for, after the built-ins: a
/// section returns row specs as `pool.bs` takes them, and draws nothing.
pub fn section_rows(state: &mut editor::State, tokens: any, node: Node) {
    for entry in state.registry.inspector_sections {
        for row in util::list_or_empty(ask(entry, "rows", { "theme": tokens, "node": node })) {
            inspector::add_row(state, calls_back(entry, util::map_or_empty(row)));
        }
    }
}

// A control naming a `call` presses back into the plugin: that method runs
// on the plugin's node with the control's `data`.
fn calls_back(entry: any, row: any) -> any {
    let controls: [any] = [];
    for control in util::list_or_empty(row.get("controls")) {
        let call = control.get("call");
        if call.kind() == "str" {
            let data: any = { "owner": entry.owner, "call": call, "payload": control.get("data") };
            control.remove("call");
            controls.push(pool::on(control, pressed, data));
        } else {
            controls.push(control);
        }
    }
    let out = util::copy(row);
    out.set("controls", controls);
    out
}

fn pressed(state: &mut editor::State, data: any, _value: any) {
    data.owner.as_node().call(data.call.as_str(), data.payload);
    changed(state);
}

/// Viewport lines a plugin draws, kept with the editor's own until what they
/// show moves: see `draw_overlays` in editor.bs.
pub fn draw_overlays(state: editor::State) {
    for entry in state.registry.overlays {
        ask(entry, "draw", {});
    }
}

// Where the open dialogs go: a column down the left of the stage.
const DIALOGS: str = "Editor/Dialogs";
const DIALOG_WIDTH: float = 260.0;

/// Fill the open plugin dialogs, a sheet each with its title and close over
/// the rows the plugin hands back, and place them against the stage.
pub fn fill_dialogs(state: &mut editor::State) {
    let tokens = state.theme;
    let out: [any] = [];
    for entry in state.registry.dialogs {
        if !state.registry.open.get(entry.id.as_str()).as_bool() {
            continue;
        }
        let close = pool::on({
            "kind": "button",
            "role": "icon_action",
            "text": "",
            "icon": icons::ui("close"),
            "tooltip": "Close",
        }, close_dialog, { "id": entry.id });
        let head: [any] = [
            { "kind": "label", "role": "text_title_dialog", "text": entry.title },
            { "kind": "row", "grow": 1 },
            close,
        ];
        let body: [any] = [
            { "kind": "row", "align_items": "center", "controls": head },
            { "kind": "separator" },
        ];
        for row in util::list_or_empty(ask(entry, "rows", { "theme": tokens })) {
            body.push(row_controls(util::map_or_empty(row)));
        }
        out.push({
            "kind": "panel",
            "role": "sheet",
            "width": DIALOG_WIDTH,
            "padding": [12, 6, 12, 8],
            "gap": [6, 6],
            "controls": body,
        });
    }
    let viewport_rect = state.layout.stage;
    util::fill(DIALOGS, { "visible": out.len() > 0, "x": viewport_rect.x.as_float() + 12.0, "y": viewport_rect.y.as_float() + 12.0 });
    pool::strip(state, DIALOGS, out);
}

fn close_dialog(state: &mut editor::State, data: any, _value: any) {
    state.registry.open.set(data.id.as_str(), false);
    changed(state);
}

// A row a plugin hands back, as the pool's row specs read, laid out as one
// line: its label, then its controls.
fn row_controls(row: any) -> any {
    let controls: [any] = [];
    let label = row.label;
    if !label.is_nil() {
        controls.push({ "kind": "label", "role": "text_caption", "text": label });
    }
    for one in util::list_or_empty(row.controls) {
        controls.push(one);
    }
    { "kind": "row", "gap": [6, 6], "align_items": "center", "controls": controls }
}

/// What a plugin's docks and dialogs show moved.
pub fn changed(state: &mut editor::State) {
    signals::changed(state, "plugins");
}

/// The controls a plugin's property editor answers for a value of
/// `datatype`, or nil when no plugin registered one.
pub fn property_controls(state: editor::State, datatype: str, spec: any, value: any, at: inspector::AtTop) -> any {
    let entry = state.registry.property_editors.get(datatype);
    if entry.is_nil() {
        return nil;
    }
    ask(entry, "controls", { "spec": spec, "value": value, "at": at })
}

/// Whether a plugin registered the start-up state `name`.
pub fn has_start_state(state: editor::State, name: str) -> bool {
    state.registry.startup_states.has(name)
}

/// Run the start-up state `name` a plugin registered.
pub fn run_start_state(state: &mut editor::State, name: str) {
    let entry = state.registry.startup_states.get(name);
    if !entry.is_nil() {
        ask(entry, "run", {});
    }
}
