//! Editor plugins: `.bs` scripts on nodes under `Editor/Plugins`, adding
//! panels, dialogs, commands, inspector sections, property editors, overlays
//! and start-up states.

// `register()` names the methods a plugin adds; the editor calls each on its
// node with a payload, and the plugin reaches back through the Editor node's
// methods (`document`, `select`, `open_scene`, `kit_*`).

use docks;
use editor;
use icons;
use inspector;
use kit;
use pool;
use signals;
use util;
use words::changes;
use words::dock_fields;
use words::fields;
use words::form_fields;
use words::inspector_fields;
use words::layout_fields;
use words::panel_keys;
use words::project_fields;
use words::roles;
use words::schema_fields;

const CONTROLS: str = "controls";
const DRAW: str = "draw";
const PLUGINS: str = "plugins";
const READ: str = "read";
const ROWS: str = "rows";
const RUN: str = "run";
const WRITE: str = "write";
const OWNER: str = "owner";
const HOST_WORD: str = "host";

/// What every plugin added, each entry a table naming its `owner` node and
/// the method that answers it.
pub class PluginsState {
    internal panels: [any],
    internal dialogs: [any],
    internal commands: [any],
    inspector_sections: [any],
    overlays: [any],
    internal property_editors: any,
    startup_states: any,
    internal open: any,
    internal loaded: [str],
}

/// The registries, before any plugin has been seen.
pub fn state() -> PluginsState {
    PluginsState {
        panels: [],
        dialogs: [],
        commands: [],
        inspector_sections: [],
        overlays: [],
        property_editors: {},
        startup_states: {},
        open: {},
        loaded: [],
    }
}

// The node each plugin's script runs on is made under this one.
const HOST: str = "Editor/Plugins";

/// Where a plugin lives: the editor's own, on for every project; the game's;
/// and each addon's `editor/`, on while the game carries that addon.
fn roots(state: editor::State) -> [str] {
    let found = [PLUGINS];
    for root in game_roots(state) {
        found.push(root);
    }
    found
}

/// The folders a game adds to the editor from: its own `editor/` and each of
/// its addons'. None with no project open.
internal fn game_roots(state: editor::State) -> [str] {
    // A relative path off an empty root is a path outside every root there is.
    if state.game_root == "" {
        return [];
    }
    let found = [state.game_root + "/editor"];
    let addons = state.game_root + "/addons";
    for entry in util::list_or_empty(fs::list(addons)) {
        if entry[project_fields::IS_DIR].as_bool() {
            found.push(addons + "/" + entry[fields::NAME].as_str() + "/editor");
        }
    }
    found
}

/// Load every plugin in every root, in name order so registration order
/// does not depend on the filesystem's.
pub fn load(state: &mut editor::State) {
    // Saves pointed at the game's own folder before any plugin registers.
    kit::adopt_game_data(state);
    let host = scene::get_node(HOST);
    if !host.is_valid() {
        host = scene::get_node("Editor").add_child("Plugins");
    }
    for root in roots(state) {
        let names: [str] = [];
        for entry in util::list_or_empty(fs::list(root)) {
            let name = entry[fields::NAME].as_str();
            if !entry[project_fields::IS_DIR].as_bool() && name.ends_with(".bs") {
                names.push(name);
            }
        }
        names.sort();
        for name in names {
            load_one(state, host, root + "/" + name, name.slice(0, name.len() - 3));
        }
    }
    if state.registry.loaded.len() > 0 {
        log::info("editor plugins: {util::join(state.registry.loaded, ", ")}");
    }
}

fn load_one(state: &mut editor::State, host: Node, path: str, id: str) {
    let node = host.add_child(id);
    node.attach_script(path);
    if !node.has_method("register") {
        log::warn("{path}: no register(); skipped");
        node.queue_free();
        return;
    }
    let declared = node.call("register");
    if declared.kind() != types::KIND_MAP {
        log::error("{path}: register() returned no table");
        return;
    }
    add_all(state, node, declared);
    state.registry.loaded.push(id);
}

// Every list is optional: a plugin declares only what it adds.
fn add_all(state: &mut editor::State, owner: Node, declared: any) {
    for entry in util::list_or_empty(declared[dock_fields::PANELS]) {
        state.registry.panels.push({
            fields::ID: entry[fields::ID],
            fields::TITLE: entry[fields::TITLE],
            fields::ICON: entry[fields::ICON].as_str(),
            dock_fields::TALL: entry[dock_fields::TALL].as_bool(),
            DRAW: entry[DRAW],
            OWNER: owner,
        });
        // Registering a panel is not enough to reach it: a panel is drawn by
        // the dock whose tab list holds its id.
        docks::adopt(state, entry[fields::ID].as_str());
    }
    for entry in util::list_or_empty(declared["dialogs"]) {
        state.registry.dialogs.push({ fields::ID: entry[fields::ID], fields::TITLE: entry[fields::TITLE], fields::ROWS: entry[fields::ROWS], OWNER: owner });
    }
    for entry in util::list_or_empty(declared["commands"]) {
        let icon = entry[fields::ICON];
        state.registry.commands.push({
            fields::TITLE: entry[fields::TITLE],
            fields::ICON: if icon == nil { "·" } else { icon.as_str() },
            form_fields::SHORTCUT: entry[form_fields::SHORTCUT].as_str(),
            project_fields::RUN: entry[project_fields::RUN],
            OWNER: owner,
        });
    }
    // A section is a component of the plugin's own: a schema, and the methods
    // that read and write it.
    for section in util::list_or_empty(declared["inspector_sections"]) {
        state.registry.inspector_sections.push({
            inspector_fields::COMPONENT: section[inspector_fields::COMPONENT],
            schema_fields::SCHEMA: section[schema_fields::SCHEMA],
            READ: section[READ],
            project_fields::WRITE: section[project_fields::WRITE],
            OWNER: owner,
        });
    }
    for draw in util::list_or_empty(declared["overlays"]) {
        state.registry.overlays.push({ DRAW: draw, OWNER: owner });
    }
    // A property editor answers a row's controls for a value of its type.
    let editors = util::map_or_empty(declared["property_editors"]);
    for datatype in editors.keys() {
        state.registry.property_editors[datatype] = { CONTROLS: editors[datatype], OWNER: owner };
    }
    let states = util::map_or_empty(declared["startup_states"]);
    for name in states.keys() {
        state.registry.startup_states[name] = { project_fields::RUN: states[name], OWNER: owner };
    }
}

// What the plugin that registered `entry` answers to its method under `key`.
fn ask(entry: any, key: str, payload: any) -> any {
    entry[OWNER].as_node().call(entry[key].as_str(), payload)
}

/// A registered panel's entry, or nil.
pub fn panel(state: editor::State, id: str) -> any {
    for entry in state.registry.panels {
        if entry[fields::ID].as_str() == id {
            return entry;
        }
    }
    nil
}

/// Have the plugin whose panel is `id` fill the node at `host`.
pub fn draw_panel(state: &mut editor::State, id: str, host: str) {
    let entry = panel(state, id);
    if entry != nil {
        ask(entry, DRAW, { HOST_WORD: host, project_fields::THEME: state.theme });
    }
}

/// Run a command a plugin registered: one of `state.registry.commands`.
pub fn run(state: &mut editor::State, command: any) {
    ask(command, RUN, {});
}

/// The sections plugins registered, in the order they did.
pub fn sections(state: editor::State) -> [any] {
    state.registry.inspector_sections
}

/// What a section's component holds on `node`, as a table by property; nil
/// where the plugin has nothing to say of this node.
pub fn section_values(entry: any, node: Node) -> any {
    ask(entry, READ, { inspector_fields::NODE: node })
}

/// One of a section's rows edited: its plugin's `write` method hears it.
pub fn section_write(state: editor::State, component: str, property: str, value: any) {
    for entry in state.registry.inspector_sections {
        if entry[inspector_fields::COMPONENT].as_str() == component && entry[project_fields::WRITE] != nil {
            ask(entry, WRITE, { inspector_fields::PROPERTY: property, fields::VALUE: value });
        }
    }
}

/// Viewport lines a plugin draws, kept with the editor's own until what they
/// show moves: see `draw_overlays` in editor.bs.
pub fn draw_overlays(state: editor::State) {
    for entry in state.registry.overlays {
        ask(entry, DRAW, {});
    }
}

// Where the open dialogs go: a column down the left of the stage.
const DIALOGS: str = "Editor/Dialogs";
const DIALOG_WIDTH: float = 260.0;

/// Fill the open plugin dialogs, a sheet each with its title and close over
/// the rows the plugin hands back, and place them against the stage.
pub fn fill_dialogs(state: &mut editor::State) {
    let tokens = state.theme;
    let out: [ui::Control] = [];
    for entry in state.registry.dialogs {
        if !state.registry.open[entry[fields::ID].as_str()].as_bool() {
            continue;
        }
        let close = pool::on(ui::Control {
            kind: ui::WIDGET_BUTTON,
            role: roles::ICON_ACTION,
            text: "",
            icon: icons::ui(icons::CLOSE),
            tooltip: "Close",
        }, close_dialog, { fields::ID: entry[fields::ID] });
        let head: [ui::Control] = [
            ui::Control { kind: ui::WIDGET_LABEL, role: "text_title_dialog", text: entry[fields::TITLE] },
            ui::Control { kind: ui::WIDGET_ROW, grow: 1 },
            close,
        ];
        let body: [ui::Control] = [
            ui::Control { kind: ui::WIDGET_ROW, align_items: ui::ALIGN_CENTER, controls: head },
            ui::Control { kind: ui::WIDGET_SEPARATOR },
        ];
        for row in util::list_or_empty(ask(entry, ROWS, { project_fields::THEME: tokens })) {
            body.push(row_controls(util::map_or_empty(row)));
        }
        out.push(ui::Control {
            kind: ui::WIDGET_PANEL,
            role: roles::SHEET,
            width: DIALOG_WIDTH,
            padding: ui::sides(12, 6, 12, 8),
            gap: vec2(6, 6),
            controls: body,
        });
    }
    let viewport_rect = state.layout[panel_keys::STAGE];
    let filled = scene::get_node(DIALOGS);
    if filled.is_valid() {
        filled.set_visible(out.len() > 0);
        filled.widget.x = viewport_rect["x"].as_float() + 12.0;
        filled.widget.y = viewport_rect["y"].as_float() + 12.0;
    }
    ui::fill_strip(DIALOGS, out);
}

fn close_dialog(state: &mut editor::State, data: any, _value: any) {
    state.registry.open[data[fields::ID].as_str()] = false;
    changed(state);
}

// A row a plugin hands back, as the pool's row specs read, laid out as one
// line: its label, then its controls.
fn row_controls(row: any) -> ui::Control {
    let controls: [ui::Control] = [];
    let label = row[fields::LABEL];
    if label != nil {
        controls.push(ui::Control { kind: ui::WIDGET_LABEL, role: roles::TEXT_CAPTION, text: label });
    }
    for one in util::list_or_empty(row[CONTROLS]) {
        controls.push(one);
    }
    ui::Control { kind: ui::WIDGET_ROW, gap: vec2(6, 6), align_items: ui::ALIGN_CENTER, controls: controls }
}

/// What a plugin's docks and dialogs show moved.
pub fn changed(state: &mut editor::State) {
    signals::changed(state, changes::PLUGINS);
}

/// The controls a plugin's property editor answers for a value of
/// `datatype`, or nil when no plugin registered one.
pub fn property_controls(state: editor::State, datatype: str, spec: any, value: any, at: inspector::AtTop) -> any {
    let entry = state.registry.property_editors[datatype];
    if entry == nil {
        return nil;
    }
    ask(entry, CONTROLS, { schema_fields::SPEC: spec, fields::VALUE: value, layout_fields::AT: at })
}

/// Whether a plugin registered the start-up state `name`.
pub fn has_start_state(state: editor::State, name: str) -> bool {
    state.registry.startup_states.has(name)
}

/// Run the start-up state `name` a plugin registered.
pub fn run_start_state(state: &mut editor::State, name: str) {
    let entry = state.registry.startup_states[name];
    if entry != nil {
        ask(entry, RUN, {});
    }
}
