// What the bottom dock's panels are built from: each tab is a scene with its
// own script, and these are the views and verbs it asks the Editor for.

use crate::anim;
use crate::defs;
use crate::icons;
use crate::model;
use crate::session;
use crate::shell;
use crate::util;

// What the last frame cost, against the budget: the Profiler's headline, in
// the tab row because the panel's body is the table it fills.
fn frame_hint() {
    let timings = engine::timings();
    if !(timings is Object) {
        return "no timings yet";
    }
    let stage_ms = util::f(timings.frame) * 1000.0;
    let wall_ms = util::f(timings.wall) * 1000.0;
    let frame_ms = if wall_ms > 0.0 { wall_ms } else { stage_ms };
    let steps = util::i(timings.fixed_steps);
    let line = format!("{} ms of {} · {} step{}",
        fixed(frame_ms, 2), fixed(BUDGET_MS, 1), steps, if steps == 1 { "" } else { "s" });
    if frame_ms > BUDGET_MS {
        line += format!(" · {} fps", fixed(1000.0 / frame_ms, 1));
    }
    line
}

// What the frame draws, and how big the last export was where the row is wide
// enough to say both. A tab row cannot scroll, so a line too long is a line
// cut off mid-word.
fn cost_hint(S, room) {
    let stats = util::obj(render::stats());
    let line = format!("{} draws · {} triangles · {} in {} textures",
        util::i(stats.get("draws").unwrap_or(0)),
        util::i(stats.get("triangles").unwrap_or(0)),
        bytes(util::f(stats.get("texture_bytes").unwrap_or(0))),
        util::i(stats.get("textures").unwrap_or(0)));
    if room > 560.0 {
        line += format!(" · pack {}", pack_size(S));
    }
    line
}

// How loud an entry is, so `error` and `warn` stop looking identical.
fn severity(level) {
    match level {
        "error" => 3,
        "warn" => 2,
        "info" => 1,
        _ => 0,
    }
}

fn floor_of(level) {
    match level {
        "warn" => 2,
        "error" => 3,
        _ => 0,
    }
}

// The rows the level and the filter leave, and how many they took away.
// Filtering lowercases every message, so it is redone only when the log, the
// level or the filter has actually moved.
fn filtered(S) {
    // `since` hands back only what was logged after the cursor, so a frame
    // that logged nothing costs one call rather than the whole buffer.
    let news = log::since(S.log_cursor);
    S.log_cursor = news.cursor;
    let mark = format!("{}|{}", S.log_level, S.log_query);
    let cache = S.log_cache;
    if cache is Object && cache.mark == mark && news.entries.len() == 0 && news.missed == 0 {
        return cache;
    }
    // The buffer holds 500; asking for 60 threw away most of the session.
    let entries = util::vec(log::recent(500));
    let floor = floor_of(S.log_level);
    let query = S.log_query.to_lowercase();
    let rows = [];
    let hidden = 0;
    for entry in entries {
        let matches = query == ""
            || entry.message.to_lowercase().contains(query)
            || entry.tag.to_lowercase().contains(query);
        if severity(entry.level) < floor || !matches {
            hidden += 1;
            continue;
        }
        rows.push(entry);
    }
    let built = #{ mark: mark, rows: rows, hidden: hidden };
    S.log_cache = built;
    built
}

/// What the Output panel shows for a level and a search: the log's lines,
/// and what to say when there are none.
pub fn output_view(S, level, query) {
    S.log_level = level;
    S.log_query = query;
    let k = S.theme;
    let shown = filtered(S);
    // The lines are made once for the rows the filter kept, and again only for
    // new ones or a new theme.
    if shown.get("theme") != Some(k) {
        shown.items = log_lines(shown.rows, k);
        shown.theme = k;
    }
    let says = if shown.rows.len() > 0 {
        ""
    } else if shown.hidden > 0 {
        format!("{} entries hidden by the filter", shown.hidden)
    } else {
        "nothing logged yet"
    };
    #{ items: shown.items, says: says }
}

/// The Output panel's "clear".
pub fn output_clear(S) {
    log::clear();
    S.log_cache = ();
}

// One `list` row a log entry: its mark, the time, tag and message, its ink.
fn log_lines(rows, k) {
    let items = [];
    for entry in rows {
        let tint = k.text_muted;
        let marker = " ";
        if entry.level == "error" {
            tint = k.danger_text;
            marker = "\u{d7}";
        } else if entry.level == "warn" {
            tint = k.warning_text;
            marker = "!";
        } else if entry.tag == "env" {
            tint = k.secondary_text;
        }
        let tag = if entry.tag.len() > 9 { entry.tag[..9] } else { entry.tag };
        let line = marker + "\u{1f}";
        line += format!("{:6.1}s  {}  {}", util::f(entry.time), tag, entry.message);
        line += "\u{1f}\u{1f}" + tint;
        items.push(line);
    }
    items
}

// Icon and ink by extension, so a directory of assets reads at a glance. The
// tile is one fill for every card; only the mark is typed.
fn asset_look(name, is_dir) {
    if is_dir {
        return (crate::icons::panel("assets"), "text_muted");
    }
    if name.ends_with(".rn") {
        return (crate::icons::ui("scriptfile"), "secondary_text");
    }
    if name.ends_with(".toml") {
        return (crate::icons::panel("scene"), "primary_text");
    }
    if crate::importer::kind_of(name) == "texture" {
        return (crate::icons::workspace(defs::WORKSPACE_UI), "primary_text");
    }
    return (crate::icons::ui("dot"), "text_subtle");
}

// Opening a file means the thing the editor can actually do with it: jump to
// the node running a script, or open a scene. Anything else just selects.
fn open_asset(S, rel) {
    if rel.ends_with(".toml") && rel.starts_with("scenes/") {
        if S.scene_rel != rel {
            model::open_scene(S, rel);
        }
        return;
    }
    for (i, node) in S.doc.iter().enumerate() {
        if model::script_rel(node) == Some(rel) {
            shell::choose(S, i);
            shell::set_workspace(S, defs::WORKSPACE_SCRIPT);
            return;
        }
    }
    log::info(format!("{} is not attached to any node", rel));
}

fn parent_dir(dir) {
    let parts = dir.split('/').collect::<Vec>();
    if parts.len() <= 1 {
        return "";
    }
    parts.pop();
    util::join(parts, "/")
}

/// The Assets dock's own state, hung on `S.assets`. `sel` is the card acted
/// on by rename and delete; `renaming` swaps the breadcrumb for a field.
pub fn assets_state() {
    #{ dir: "", sel: "", renaming: false, cards: #{} }
}

fn asset_path(S, rel) {
    S.game_root + "/" + rel
}

pub fn new_folder(S) {
    let base = if S.assets.dir == "" { "new-folder" } else { format!("{}/new-folder", S.assets.dir) };
    let name = base;
    let n = 2;
    while fs::exists(asset_path(S, name)) {
        name = format!("{}-{}", base, n);
        n += 1;
    }
    fs::create_directory(asset_path(S, name));
    model::forget(S, None);
    S.assets.sel = name;
    crate::signals::changed(S, "assets");
    log::info(format!("made res://{}", name));
}

pub fn rename_asset(S, name) {
    S.assets.renaming = false;
    if name == "" || name.contains("/") {
        log::warn("a name cannot be empty or contain a slash");
        return;
    }
    let from = S.assets.sel;
    let to = if S.assets.dir == "" { name } else { format!("{}/{}", S.assets.dir, name) };
    if from == to {
        return;
    }
    if fs::exists(asset_path(S, to)) {
        log::warn(format!("res://{} already exists", to));
        return;
    }
    // The engine moves the file and rewrites every `.toml` naming it.
    let rewritten = ::assets::rename(asset_path(S, from), asset_path(S, to));
    model::forget(S, None);
    S.assets.sel = to;
    crate::signals::changed(S, "assets");
    log::info(format!("renamed res://{} to res://{}; {} file(s) updated", from, to, rewritten.len()));
}

pub fn delete_asset(S) {
    let rel = S.assets.sel;
    if fs::remove(asset_path(S, rel)) {
        log::info(format!("deleted res://{}", rel));
    } else {
        log::warn(format!("res://{} was not there", rel));
    }
    model::forget(S, None);
    S.assets.sel = "";
    crate::signals::changed(S, "assets");
}

/// What the Assets panel shows for a search: where the browser is, its cards
/// and the verbs' state. The cards are kept, so a pick names its file.
pub fn assets_view(S, query) {
    let k = S.theme;
    let dir = S.assets.dir;
    let files = [];
    for f in model::list(S, dir) {
        if crate::search::matches(query, f.name) {
            files.push(f);
        }
    }
    // One string a card: the mark, the name, the path it opens and its ink.
    let items = [];
    let paths = [];
    let dirs = [];
    let cards = #{};
    let picked = "";
    for f in files {
        let rel = if dir == "" { f.name } else { format!("{}/{}", dir, f.name) };
        let (icon, ink) = asset_look(f.name, f.is_dir);
        let item = util::row(icon, f.name, rel, k[ink]);
        if rel == S.assets.sel {
            picked = item;
        }
        if !f.is_dir {
            cards[item] = rel;
        }
        items.push(item);
        paths.push(rel);
        dirs.push(f.is_dir);
    }
    S.assets.cards = cards;
    S.assets.shown = #{ items: items, paths: paths, dirs: dirs };
    let importing = crate::dropin::in_flight(S) > 0;
    #{
        dir: dir,
        // A project-relative path: the absolute one is this machine's, and
        // lands in every screenshot.
        where: format!("res://{}", dir),
        renaming: S.assets.renaming,
        name: util::last_segment(S.assets.sel),
        count: format!("{} items", files.len()),
        importing: importing,
        import_text: icons::panel("import") + if importing { " cancel" } else { " import" },
        import_tip: if importing { "Stop the import after the file it is writing" }
            else { "Bring in a model, a sprite or a level" },
        folder_text: icons::ui("add") + " folder",
        chosen: S.assets.sel != "",
        items: items,
        picked: picked,
    }
}

/// A card clicked: the first click selects it, a second opens it.
pub fn assets_pick(S, row) {
    let shown = S.assets.get("shown").unwrap_or(#{ items: [], paths: [], dirs: [] });
    for (n, item) in shown.items.iter().enumerate() {
        if item != row {
            continue;
        }
        let rel = shown.paths[n];
        if rel == S.assets.sel {
            if shown.dirs[n] {
                S.assets.dir = rel;
                S.assets.sel = "";
            } else {
                open_asset(S, rel);
            }
        } else {
            S.assets.sel = rel;
            S.assets.renaming = false;
        }
        crate::signals::changed(S, "assets");
        return;
    }
}

/// The strip's verbs, by the name of the button pressed; `rename_to` is the
/// new name submitted.
pub fn assets_verb(S, verb, value) {
    let chosen = S.assets.sel != "";
    if verb == "Up" {
        S.assets.dir = parent_dir(S.assets.dir);
    } else if verb == "Import" {
        // Asks and imports: a dialog on a desktop, the page's own chooser in
        // a tab, and the same reports either way.
        if crate::dropin::in_flight(S) > 0 {
            import::cancel();
        } else {
            import::choose();
        }
    } else if verb == "Folder" {
        new_folder(S);
    } else if verb == "Rename" && chosen {
        S.assets.renaming = !S.assets.renaming;
    } else if verb == "Delete" && chosen {
        delete_asset(S);
    } else if verb == "rename_to" {
        rename_asset(S, value);
    }
    crate::signals::changed(S, "assets");
}

/// A card dragged out of the Assets panel and let go: over the viewport, the
/// file is placed where the pointer is; anywhere else, nothing happens.
pub fn drop_card(S, card) {
    let rel = match S.assets.get("cards").unwrap_or(#{}).get(card) {
        Some(rel) => rel,
        None => return false,
    };
    let (x, y) = input::mouse_position();
    if !crate::viewport::owns_pointer(S, x / S.ui_scale, y / S.ui_scale) {
        return false;
    }
    crate::dropin::place_file(S, rel)
}

// Keyframe timeline over the engine's clip (scripts/anim.rn is the adapter):
// scrubbing seeks the engine's player, so the viewport shows the engine's pose.
const TIMELINE = "Editor/Shell/Body/Centre/Bottom/Timeline";
const NAME_W = 150.0;

/// Fill the Timeline tab: what the player is missing, or the clip's ruler,
/// rules, lanes and keys placed by time against the tab's width, the playhead
/// and the scrubber. What its script asks for when any of them moved.
pub fn timeline_fill(S) {
    let k = S.theme;
    let (node, _, _) = anim::player(S);
    let found = anim::definition(S);
    let def = match found {
        Some(def) => def,
        None => {
            let missing = if anim::component(node).is_none() {
                node.name + " has no clip"
            } else {
                format!("{}: clip '{}' is not in its library", node.name, anim::clip_name(node))
            };
            util::fill(TIMELINE + "/Missing", #{ visible: true });
            util::fill(TIMELINE + "/Missing/Says", #{ text: missing });
            util::fill(TIMELINE + "/Missing/Create", #{ icon: icons::ui("add") });
            util::fill(TIMELINE + "/Body", #{ visible: false });
            return;
        }
    };
    util::fill(TIMELINE + "/Missing", #{ visible: false });
    util::fill(TIMELINE + "/Body", #{ visible: true });
    let length = util::max(anim::length(def), 1e-4);
    let tracks = anim::tracks(def);
    let lane_x = NAME_W + 14.0;
    let box = ui::widget_rect(scene::get_node(TIMELINE));
    let width = if util::is_nil(box) { 800.0 } else { util::f(box.width) };
    let lane_w = util::max(120.0, width - lane_x - 24.0);
    let at = |t| 8.0 + lane_x + (t / length) * lane_w;
    let name = anim::clip_name(node);
    util::fill(TIMELINE + "/Body/Head/AddKey", #{ icon: icons::ui("add") });
    util::fill(TIMELINE + "/Body/Head/Clip", #{
        text: format!("{} · {}", if name == "" { "unnamed" } else { name }, anim::library_path(node).unwrap_or("inline")),
    });
    util::fill(TIMELINE + "/Body/Head/Time", #{ text: format!("{:.2} / {:.2} s", S.anim.time, anim::length(def)) });
    // The ruler carries the scale the lanes are read against: a label and a
    // rule per tick straight down through the lanes.
    let step = tick_step(length);
    let ticks = [];
    let rules = [];
    let t = 0.0;
    while t <= length + 1e-4 {
        ticks.push(#{
            kind: "label", role: "text_code_quiet", font_size: 11, absolute: true,
            inset: [at(t), 2.0, -1.0, -1.0], text: format!("{:.2}", t),
        });
        rules.push(#{
            kind: "row", absolute: true, inset: [at(t), 0.0, -1.0, 0.0],
            width: 1, fill: "border_default", interactive: false,
        });
        t += step;
    }
    crate::pool::strip(S, TIMELINE + "/Body/Ruler", ticks);
    crate::pool::strip(S, TIMELINE + "/Body/Lanes/Rules", rules);
    util::fill(TIMELINE + "/Body/Lanes/Playhead", #{
        inset: [at(util::min(S.anim.time, length)) - 1.0, 0.0, -1.0, 0.0],
    });
    let rows = [];
    for (index, track) in tracks.iter().enumerate() {
        let color = if index % 2 == 0 { k.primary_text } else { k.secondary_text };
        let keys = [];
        for key in util::vec(track.get("keys").unwrap_or([])) {
            // Bound afresh: a closure made in a loop captures the binding.
            let when = util::f(key.get("time").unwrap_or(0.0));
            let before = when <= S.anim.time + 1e-4;
            // A key is its mark: filled once the playhead has passed it.
            keys.push(#{
                kind: "button", role: "chip_quiet", text: if before { "●" } else { "○" },
                font_size: 13, padding: 0, text_color: color,
                absolute: true, inset: [(when / length) * lane_w - 6.0, 2.0, -1.0, -1.0],
                tooltip: format!("{:.2} s", when),
                on: |_| { anim::seek(S, when); },
            });
        }
        rows.push(#{ full: true, height: LANE_H, controls: [
            #{ kind: "row", width: NAME_W, gap: [6, 6], align_items: "center", padding: [8, 0, 0, 0], controls: [
                #{ kind: "row", width: 6, height: 6, corner_radius: 3, fill: color },
                #{ kind: "label", role: "text_code", font_size: 11, text: anim::track_label(track) },
            ] },
            #{ kind: "row", width: lane_w, height: LANE_H, margin: [14, 0, 0, 0], controls: keys },
        ] });
    }
    crate::pool::sync(S, TIMELINE + "/Body/Lanes/Scroll/Tracks", rows, 0.0, false);
    util::fill(TIMELINE + "/Body/ScrubRow", #{ padding: [8.0 + lane_x, 0.0, 0.0, 0.0] });
    util::fill(TIMELINE + "/Body/ScrubRow/Scrub", #{ width: lane_w, value: S.anim.time, max: anim::length(def) });
}

/// The Timeline tab's verbs, by the name of the button pressed.
pub fn timeline_verb(S, verb) {
    match verb {
        "AddKey" => anim::add_key(S, S.anim.time),
        "DeleteKey" => anim::delete_key_at(S, S.anim.time),
        "Create" => {
            anim::ensure_clip(S);
        }
        _ => (),
    }
    crate::signals::changed(S, "timeline");
}

const LANE_H = 26.0;

// A tick every 0.25/0.5/1/2/5 s, whichever gives four to eight labels.
fn tick_step(length) {
    for step in [0.25, 0.5, 1.0, 2.0, 5.0, 10.0] {
        if length / step <= 8.0 {
            return step;
        }
    }
    length / 8.0
}

// A local as one line; a table is its JSON, cut short.
fn value_text(v) {
    if v is Object || v is Vec {
        // A node or a closure inside has no JSON form.
        let (ok, text) = script::attempt(|| json::encode(v));
        if !ok {
            return "‹object›";
        }
        if text.len() > 96 { text[..93] + "…" } else { text }
    } else if v is String {
        v
    } else {
        format!("{:?}", v)
    }
}

/// What the Debugger panel shows: the stop and its stack while a script is
/// stopped, and what to do while none is. The stack's rows are kept, so a
/// pick names its frame.
pub fn debugger_view(S) {
    let k = S.theme;
    let p = S.debug.paused;
    let on = debugger::break_on_error();
    if !(p is Object) {
        S.debug.rows = [];
        S.debug.owners = [];
        let where = if S.playing {
            "running · click a line number in the script to set a breakpoint"
        } else {
            "set breakpoints in the script gutter, then run the scene"
        };
        return #{
            stopped: false, can_pause: S.playing, steps: [], where: where, threw: "",
            break_on_error: on, frames: [], picked: "",
        };
    }
    // A frame is a row, and its locals are rows a tab deeper. The caret is the
    // tree's own, so nothing here folds.
    let items = [];
    let owners = [];
    for (i, frame) in p.frames.iter().enumerate() {
        let site = format!("{}:{}", shell::script_rel(S, frame.path), frame.line);
        // A recursion stacks frames that read alike; the depth keeps them apart.
        items.push(util::cells([icons::ui("step-into"), frame["function"], site, k.text_default, format!("{}", i)]));
        owners.push(i);
        for name in util::keys_sorted(frame.locals) {
            items.push("\t" + util::cells(["", name, value_text(frame.locals[name]), k.text_muted, format!("{}/{}", i, name)]));
            owners.push(i);
        }
    }
    let picked = "";
    for (n, owner) in owners.iter().enumerate() {
        if owner == S.debug.frame && picked == "" {
            picked = items[n];
        }
    }
    S.debug.rows = items;
    S.debug.owners = owners;
    #{
        stopped: true,
        can_pause: false,
        steps: [
            "▶ Continue",
            icons::ui("step-over") + " Over",
            icons::ui("step-into") + " Into",
            icons::ui("step-out") + " Out",
        ],
        where: format!("{} · {}:{}", p.reason, S.debug.paused_rel, p.line),
        threw: p.get("message").unwrap_or(""),
        break_on_error: on,
        frames: items,
        picked: picked,
    }
}

/// A step pressed, by the name of its button.
pub fn debugger_step(S, step) {
    let mode = match step {
        "over" => debugger::STEP_OVER,
        "into" => debugger::STEP_INTO,
        "out" => debugger::STEP_OUT,
        _ => debugger::CONTINUE,
    };
    shell::resume(S, mode);
}

/// A row of the stack picked: the frame it is, or is a local of.
pub fn debugger_frame(S, row) {
    let rows = S.debug.get("rows").unwrap_or([]);
    for (n, item) in rows.iter().enumerate() {
        if item == row {
            S.debug.frame = S.debug.owners[n];
            crate::signals::changed(S, "debugger");
            return;
        }
    }
}

// Problems: every finding the last sweep produced, worst first, each row a
// file and a line the click opens at.
// The findings in the order the list shows them: the errors first.
fn problem_rows(S) {
    let rows = [];
    for f in S.lint.found {
        if f.severity == "error" {
            rows.push(f);
        }
    }
    for f in S.lint.found {
        if f.severity != "error" {
            rows.push(f);
        }
    }
    rows
}

fn problem_line(f, k) {
    let bad = f.severity == "error";
    let at = if f.line > 0 { format!("{}:{}", f.file, f.line) } else { f.file };
    let line = if bad { "\u{d7}" } else { "!" };
    line += "\u{1f}" + format!("{}  {}", at, f.message);
    line += "\u{1f}\u{1f}" + if bad { k.danger_text } else { k.warning_text };
    line
}

/// What the Problems panel shows: a line a finding, and what to say when
/// there are none.
pub fn problems_view(S) {
    let items = [];
    for f in problem_rows(S) {
        items.push(problem_line(f, S.theme));
    }
    let says = if items.len() > 0 {
        ""
    } else if S.lint.at < 0.0 {
        "not checked yet"
    } else {
        "no problems"
    };
    #{ items: items, says: says }
}

/// The Problems panel picked the line written `picked`: open what it names.
pub fn problems_pick(S, picked) {
    for f in problem_rows(S) {
        if problem_line(f, S.theme) == picked {
            open_at(S, f);
            return;
        }
    }
}

// Select the node whose script this is and show it, so a click lands on the
// code rather than on a file name.
fn open_at(S, f) {
    for (i, node) in S.doc.iter().enumerate() {
        if model::script_rel(node) == Some(f.file) {
            shell::choose(S, i);
            shell::set_workspace(S, defs::WORKSPACE_SCRIPT);
            return;
        }
    }
    S.doctab = "scene";
    crate::signals::inspector(S);
}

// The Recordings tab while one is open: the replay's transport and lanes.
const LANES = "Editor/Shell/Body/Centre/Bottom/Lanes";
const LANE_NAME_W = 120.0;

/// Fill the recording lanes: the transport and scrubber, where the replay
/// parted from the recording, a lane a kind of event with its marks placed by
/// tick against the tab's width, and everything recorded at the playhead.
pub fn lanes_fill(S) {
    let k = S.theme;
    let split = replay::divergence_tick();
    let first = S.session.first;
    let last = S.session.last;
    let span = util::max(1.0, util::f(last - first));
    let box = ui::widget_rect(scene::get_node(LANES));
    let width = if util::is_nil(box) { 800.0 } else { util::f(box.width) };
    let lane_w = util::max(120.0, width - LANE_NAME_W - 60.0);
    let playing = replay::state() == replay::STATE_PLAYING;
    util::fill(LANES + "/Head/Play", #{ text: if playing { "⏸ Pause" } else { "▶ Play" } });
    // Before the first frame is fed the position is one tick short of the
    // session's start, which is off the near end of the ruler.
    let at = util::max(0.0, util::f(replay::position()) - util::f(first));
    util::fill(LANES + "/Head/Scrub", #{ value: at, max: span });
    util::fill(LANES + "/Head/At", #{ text: format!("{} / {}", replay::position(), last) });
    // A divergence is information, not a failure: the replay ran, and this is
    // the tick at which it stopped reproducing what was recorded.
    let parted = if split is Object { format!("parted from the recording at tick {}", split.tick) } else { "" };
    util::fill(LANES + "/Parted", #{ visible: parted != "", text: parted });
    let rows = [];
    for lane in S.session.lanes {
        let marks = [];
        for mark in lane.marks {
            // Bound afresh: a closure made in a loop captures the binding.
            let tick = mark.tick;
            let x = util::clamp(util::f(tick - first) / span, 0.0, 1.0) * (lane_w - 6.0);
            marks.push(#{
                kind: "button", role: "chip_quiet", text: "▮", font_size: 9, padding: 0,
                absolute: true, inset: [x, -1.0, -1.0, -1.0],
                text_color: if tick <= replay::position() { k.primary_text } else { k.border_default },
                tooltip: format!("{}: {}", tick, mark.label),
                on: |_| { session::seek(S, tick); },
            });
        }
        rows.push(#{ full: true, height: 20, controls: [
            #{ kind: "label", role: "text_code_quiet", font_size: 11, width: LANE_NAME_W - 12.0, text: lane.name, padding: [8, 0, 0, 0] },
            #{ kind: "row", width: lane_w, height: 20, controls: marks },
        ] });
    }
    // Everything recorded at the tick the playhead is on, in the order it
    // happened.
    for e in util::vec(replay::events(S.session.at, S.session.at)) {
        rows.push(#{ full: true, height: 20, controls: [
            #{ kind: "label", role: "text_code_quiet", font_size: 11, text: format!("{}", e.tick), padding: [8, 0, 0, 0] },
            #{ kind: "label", role: "text_code_quiet", font_size: 11, text: e.kind },
            #{ kind: "label", role: "text_code", font_size: 11, text: e.label },
        ] });
    }
    crate::pool::sync(S, LANES + "/Scroll/Rows", rows, 0.0, false);
}

/// The lanes' transport, by the name of the button pressed.
pub fn lanes_verb(S, verb) {
    match verb {
        "Play" => session::toggle_pause(S),
        "Step" => session::step(S),
        _ => session::close(S),
    }
    crate::signals::changed(S, "recordings");
}

/// The scrubber, at `t` ticks into the recording.
pub fn lanes_seek(S, t) {
    session::seek(S, S.session.first + util::i(t));
    crate::signals::changed(S, "recordings");
}

// The Recordings panel's rows, under its own scroll; the dock hides the panel
// while a recording is open, and the lanes take its room.
const RECORDINGS = "Editor/Shell/Body/Centre/Bottom/Recordings/Rows/Column";

/// Every recording this game has made, newest first, as a row each. "Keep"
/// renames one out of the ring that prunes the oldest, so a session worth
/// returning to survives the next ten runs.
pub fn recordings_fill(S) {
    let rows = session::listing(S);
    let specs = [];
    for entry in rows {
        // Bound afresh: a closure made in a loop captures the binding.
        let r = entry;
        specs.push(#{ full: true, height: 24, slot_role: "layout_actions", controls: session_row(S, r) });
    }
    crate::pool::sync(S, RECORDINGS, specs, 0.0, false);
    #{ verify: S.session.verify, count: rows.len() }
}

/// The Recordings panel's verify switch.
pub fn recordings_verify(S) {
    S.session.verify = !S.session.verify;
    crate::signals::changed(S, "recordings");
}

// One recording: the verb that plays it, what it is, and the three that keep,
// copy or drop it.
fn session_row(S, r) {
    let out = [
        #{
            kind: "button", role: "action_form_primary", text: "▶",
            tooltip: "Replay this recording",
            on: |_| { session::open(S, r.name); },
        },
        #{ kind: "label", role: "text_code", text: if r.started == "" { r.name } else { r.started } },
        #{
            kind: "label", role: "text_caption",
            text: format!("{} ticks · {:.1}s", r.ticks, r.seconds),
        },
    ];
    // How it ended, and whether its code has moved on since.
    if r.reason != "stop" {
        out.push(#{ kind: "label", role: "note_danger", text: r.reason });
    }
    if r.stale {
        out.push(#{ kind: "label", role: "note_warning", text: "scripts changed" });
    }
    out.push(#{ kind: "row", grow: 1 });
    out.push(#{
        kind: "button", role: "action_form", text: "delete",
        on: |_| { session::remove(S, r.name); },
    });
    out.push(#{
        kind: "button", role: "action_form", text: "copy to project",
        tooltip: "Copy into the project, for a bug report or `balaur replay`",
        on: |_| { session::export(S, r.name); },
    });
    if !r.name.starts_with("kept-") {
        out.push(#{
            kind: "button", role: "action_form", text: "keep",
            tooltip: "Never prune this one",
            on: |_| { session::keep(S, r.name); },
        });
    }
    out
}

// What one 60 Hz frame costs, as a bar per stage against that budget. The
// editor's own frame is what is measured while it is idle; press Play and it
// becomes the game's, which is the number anyone actually wants.
const BUDGET_MS = 16.667;

// Rune's `format!` takes a literal precision only, so a variable one is a
// match. Mirrors `inspector::fixed`, which is private to that module.
fn fixed(v, decimals) {
    match decimals {
        1 => format!("{:.1}", v),
        3 => format!("{:.3}", v),
        _ => format!("{:.2}", v),
    }
}

/// What a live meter shows, `what` being `profiler` or `cost`: its table,
/// its headline, and what to say when there is nothing to measure.
pub fn meter_view(S, what) {
    let k = S.theme;
    if what == "cost" {
        return cost_view(S, k);
    }
    let scripts = S.get("script_profiling").unwrap_or(false);
    let titles = ["what", "cost>", "share of a frame"];
    let widths = ["2", "1", "2"];
    let timings = engine::timings();
    if !(timings is Object) {
        return #{ titles: titles, widths: widths, items: [], says: "no timings yet",
            headline: frame_hint(), scripts: scripts };
    }
    let items = [];
    cost_rows(items, k, util::obj(timings.stages), "stage");
    let spans = util::obj(timings.spans);
    if !spans.is_empty() {
        cost_rows(items, k, spans, "span");
    }
    if scripts {
        script_rows(items, k);
    }
    #{ titles: titles, widths: widths, items: items, says: "", headline: frame_hint(), scripts: scripts }
}

/// The Profiler's "scripts": count what each script costs, or stop.
pub fn profiler_scripts(S) {
    let on = !S.get("script_profiling").unwrap_or(false);
    S.script_profiling = on;
    engine::set_script_profiling(on);
}

/// What each script and each of the dearest functions cost the last frame,
/// dearest first, against the dearest of them rather than against the budget:
/// the unit is instructions.
///
/// Instructions rather than milliseconds: the same frame runs the same
/// instructions on every machine, so a number that moved is a change in what
/// a script does. Re-armed after reading, so a row is one frame's work.
fn script_rows(items, k) {
    let costs = engine::script_costs();
    let worst = if costs.is_empty() { 0.0 } else { util::f(costs[0].instructions) };
    for row in costs {
        let count = util::f(row.instructions);
        let share = if worst > 0.0 { util::clamp(count / worst, 0.0, 1.0) } else { 0.0 };
        items.push(util::cells([
            row.path, format!("{} instr", row.instructions), bar(share), k.secondary_text,
        ]));
    }
    // Each function's own instructions under its file's rows: the VM's count,
    // so a `draw` callback and a closure the pool calls are in it too.
    let functions = engine::function_costs();
    let top = if functions.is_empty() { 0.0 } else { util::f(functions[0].instructions) };
    let n = 0;
    while n < functions.len() && n < FUNCTION_ROWS {
        let row = functions[n];
        let count = util::f(row.instructions);
        let share = if top > 0.0 { util::clamp(count / top, 0.0, 1.0) } else { 0.0 };
        items.push(util::cells([
            row.function, format!("{} instr · {} calls", row.instructions, row.calls), bar(share), k.text_muted,
        ]));
        n += 1;
    }
    engine::set_script_profiling(true);
}

/// How many of the dearest functions the Profiler lists under the scripts.
const FUNCTION_ROWS = 12;

/// A share as blocks, which reads at a glance where a number has to be read.
/// Twelve cells, so one is about eight percent: twenty overran the Cost
/// dock's column, which is a fifth of the dock.
///
/// Filled blocks and nothing else: a track drawn in the light block reads as
/// noise down a column of them.
fn bar(share) {
    let filled = util::i(util::clamp(share, 0.0, 1.0) * 12.0);
    util::repeat("\u{2588}", filled)
}

// Worst first. A hand-written pass rather than a comparator: a float
// comparison in Rune answers with an Option, and the list is eight rows long.
fn by_cost(table) {
    let left = [];
    for (name, seconds) in table.iter() {
        left.push(#{ name: name, ms: util::f(seconds) * 1000.0 });
    }
    let out = [];
    while !left.is_empty() {
        // Indexed, not `left.iter()`: an iterator holds a read borrow until it
        // goes out of scope, and `remove` below needs to write.
        let worst = 0;
        let i = 1;
        while i < left.len() {
            if left[i].ms > left[worst].ms {
                worst = i;
            }
            i += 1;
        }
        out.push(left.remove(worst));
    }
    out
}

// One row per entry, worst first, with a bar as its share of the budget: a
// number needs reading, a bar does not.
fn cost_rows(items, k, table, kind) {
    for row in by_cost(table) {
        let tint = if row.ms > BUDGET_MS * 0.5 {
            k.primary_text
        } else if kind == "span" {
            k.secondary_text
        } else {
            k.text_muted
        };
        items.push(util::cells([
            row.name, fixed(row.ms, 3) + " ms", bar(row.ms / BUDGET_MS), tint,
        ]));
    }
}



/// Bytes as the unit a person reads them in.
fn bytes(n) {
    if n < 1024.0 {
        return format!("{} B", n as i64);
    }
    if n < 1048576.0 {
        return fixed(n / 1024.0, 1) + " KB";
    }
    fixed(n / 1048576.0, 1) + " MB"
}

/// Rows sorted by one key, worst first. The same insertion pass `by_cost`
/// uses; a frame's node list is short and Rune's `sort` takes no comparator.
fn by_key(rows, key) {
    let left = [];
    for row in rows {
        left.push(row);
    }
    let out = [];
    while left.len() > 0 {
        let worst = 0;
        let i = 1;
        while i < left.len() {
            if util::f(left[i][key]) > util::f(left[worst][key]) {
                worst = i;
            }
            i += 1;
        }
        out.push(left.remove(worst));
    }
    out
}

/// What the frame draws, per node: the other half of the Profiler, beside the
/// milliseconds. `render.stats` counts it from the scene, so a headless run
/// reports the same triangles a windowed one does.
fn cost_view(S, k) {
    let titles = ["node", "triangles>", "textures>", "copies>", "share of the worst"];
    let widths = ["2", "1", "1", "0.7", "1.6"];
    let stats = util::obj(render::stats());
    let nodes = util::vec(stats.get("nodes").unwrap_or([]));
    let headline = cost_hint(S, 1000.0);
    if nodes.len() == 0 {
        return #{ titles: titles, widths: widths, items: [], says: "nothing is drawing",
            headline: headline, scripts: false };
    }
    let worst = util::f(by_key(nodes, "triangles")[0].triangles);
    let items = [];
    for row in by_key(nodes, "triangles") {
        let share = util::clamp(util::f(row.triangles) / util::max(worst, 1.0), 0.0, 1.0);
        let copies = util::i(row.copies);
        items.push(util::cells([
            util::leaf(row.node),
            format!("{} tri", util::i(row.triangles)),
            bytes(util::f(row.texture_bytes)),
            if copies > 1 { format!("x{}", copies) } else { "" },
            bar(share),
            k.text_muted,
        ]));
    }
    #{ titles: titles, widths: widths, items: items, says: "", headline: headline, scripts: false }
}

/// How big the last export was, or a line saying none has been made. The
/// pack is what a player downloads, so it belongs beside the frame's cost.
fn pack_size(S) {
    let out = export::output("web");
    if !(out is String) || !fs::exists(out) {
        return "not exported yet";
    }
    let total = 0.0;
    for entry in util::vec(fs::list(out)) {
        if !entry.is_dir {
            total += 1.0;
        }
    }
    format!("{} file(s) at {}", total as i64, util::leaf(out))
}
