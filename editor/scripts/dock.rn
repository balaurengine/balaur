// Bottom dock (150 px, 212 px for Timeline and Debugger): Output / Assets /
// Timeline / Debugger.

use crate::anim;
use crate::defs;
use crate::icons;
use crate::model;
use crate::session;
use crate::shell;
use crate::style;
use crate::util;

/// The right-hand hint for a panel, one table rather than an `if` chain that
/// fell through to the animation branch for everything unlisted.
pub fn hint(S, id, room) {
    if id == "assets" {
        // A project-relative path: the absolute one is this machine's, and
        // lands in every screenshot.
        return format!("res:// · {}", S.game_name);
    }
    if id == "debugger" {
        if S.debug.paused is Object {
            return S.debug.paused.reason;
        }
        return "F5 run · F10 over · F11 into · ⇧F11 out";
    }
    if id == "profiler" {
        return frame_hint();
    }
    if id == "cost" {
        return cost_hint(S, room);
    }
    if id == "timeline" {
        let (node, _, _) = anim::player(S);
        let text = match anim::definition(S) {
            None => "no clip",
            Some(def) => {
                let name = anim::clip_name(node);
                format!("0.00 – {:.2} s · {} · {}",
                    anim::length(def),
                    if name == "" { "unnamed" } else { name },
                    anim::library_path(node).unwrap_or("inline"))
            }
        };
        return text;
    }
    ""
}

// What the last frame cost, against the budget: the Profiler's headline, in
// the tab row because the panel's body is the table it fills.
fn frame_hint() {
    let timings = engine::timings();
    if !(timings is Object) {
        return "no timings yet";
    }
    let stage_ms = util::f(timings.frame) * 1000.0;
    let wall_ms = util::f(timings.wall) * 1000.0;
    let frame_ms = if wall_ms > 0.0 { wall_ms } else { stage_ms };
    let steps = util::i(timings.fixed_steps);
    let line = format!("{} ms of {} · {} step{}",
        fixed(frame_ms, 2), fixed(BUDGET_MS, 1), steps, if steps == 1 { "" } else { "s" });
    if frame_ms > BUDGET_MS {
        line += format!(" · {} fps", fixed(1000.0 / frame_ms, 1));
    }
    line
}

// What the frame draws, and how big the last export was where the row is wide
// enough to say both. A tab row cannot scroll, so a line too long is a line
// cut off mid-word.
fn cost_hint(S, room) {
    let stats = util::obj(render::stats());
    let line = format!("{} draws · {} triangles · {} in {} textures",
        util::i(stats.get("draws").unwrap_or(0)),
        util::i(stats.get("triangles").unwrap_or(0)),
        bytes(util::f(stats.get("texture_bytes").unwrap_or(0))),
        util::i(stats.get("textures").unwrap_or(0)));
    if room > 560.0 {
        line += format!(" · pack {}", pack_size(S));
    }
    line
}

/// The Profiler's one control, beside its numbers in the tab row.
pub fn profiler_tools(S, k) {
    let on = S.get("script_profiling").unwrap_or(false);
    ui::add_space(6);
    if ui::button("scripts", #{
        height: 24, font_size: style::SM, font_weight: 700,
        tooltip: "Count what each script costs, in VM instructions",
        fill: if on { k.primary_text } else { k.bg_control },
        text_color: if on { k.bg_control } else { k.text_muted },
    }) {
        S.script_profiling = !on;
        engine::set_script_profiling(!on);
    }
}

/// Output owns the tab row's slot when it is showing: a log without a filter,
/// a level and a clear is unusable.
pub fn output_tools(S, k, room) {
    if room < 90.0 {
        return;
    }
    ui::add_space(6);
    if ui::button("clear", #{
        height: 24, font_size: style::SM, font_weight: 700, tooltip: "Empty the log buffer",
        fill: k.bg_control, text_color: k.text_muted,
    }) {
        log::clear();
        S.log_cache = ();
    }
    if room < 200.0 {
        return;
    }
    for level in ["error", "warn", "all"] {
        let active = S.log_level == level;
        if ui::button(level, #{
            height: 24, font_size: style::SM, font_weight: 700,
            tooltip: format!("Show {} and above", level),
            fill: if active { k.primary_bg } else { k.bg_control },
            text_color: if active { k.primary_text } else { k.text_muted },
        }) {
            S.log_level = level;
        }
    }
    if S.compact || room < 350.0 {
        // No field on screen, so no invisible filter hiding rows.
        S.log_query = "";
    } else {
        let (query, _, _) = ui::text_field("log-search", "Search", #{
            font_size: style::SM, font_family: ui::FONT_MONO, width: 130, height: 24,
            fill: k.bg_control, stroke: k.border_default, text_color: k.text_default,
        });
        S.log_query = query;
    }
}

// How loud an entry is, so `error` and `warn` stop looking identical.
fn severity(level) {
    match level {
        "error" => 3,
        "warn" => 2,
        "info" => 1,
        _ => 0,
    }
}

fn floor_of(level) {
    match level {
        "warn" => 2,
        "error" => 3,
        _ => 0,
    }
}

// The rows the level and the filter leave, and how many they took away.
// Filtering lowercases every message, so it is redone only when the log, the
// level or the filter has actually moved.
fn filtered(S) {
    // `since` hands back only what was logged after the cursor, so a frame
    // that logged nothing costs one call rather than the whole buffer.
    let news = log::since(S.log_cursor);
    S.log_cursor = news.cursor;
    let mark = format!("{}|{}", S.log_level, S.log_query);
    let cache = S.log_cache;
    if cache is Object && cache.mark == mark && news.entries.len() == 0 && news.missed == 0 {
        return cache;
    }
    // The buffer holds 500; asking for 60 threw away most of the session.
    let entries = util::vec(log::recent(500));
    let floor = floor_of(S.log_level);
    let query = S.log_query.to_lowercase();
    let rows = [];
    let hidden = 0;
    for entry in entries {
        let matches = query == ""
            || entry.message.to_lowercase().contains(query)
            || entry.tag.to_lowercase().contains(query);
        if severity(entry.level) < floor || !matches {
            hidden += 1;
            continue;
        }
        rows.push(entry);
    }
    let built = #{ mark: mark, rows: rows, hidden: hidden };
    S.log_cache = built;
    built
}

// The bottom dock's `list` node, which the log-shaped panels fill instead of
// drawing a row at a time.
const LOG_NODE = "Editor/Shell/Body/Centre/Bottom/BottomLog";

// Put `items` on the node and show it. A row is icon, label, note and colour,
// separated by U+001F, which is what a `list` row splits on.
pub fn show_log(S, items) {
    // Written when it differs from what the node was last given: the Output
    // dock asks every frame, and five hundred rows are a large patch.
    if S.log_items == items {
        return;
    }
    S.log_items = items;
    util::fill(LOG_NODE, #{ options: items, visible: true });
}

// What the log reports as picked, cleared once the caller has acted on it.
fn taken_log() {
    util::taken(LOG_NODE)
}

// Hidden while a panel that is not a list is up.
pub fn hide_log(S) {
    util::hide(LOG_NODE);
    // What it held goes back on when it shows again.
    S.log_items = ();
}

// The bottom dock's column of pooled rows, which a panel whose rows are nodes
// fills instead of drawing them. One host, as the log and the table are: only
// the panel that is up may write to it.
const ROWS_NODE = "Editor/Shell/Body/Centre/Bottom/BottomRows";

/// The host a panel fills with `pool::sync`, shown by the asking.
pub fn rows_host(S) {
    util::fill(ROWS_NODE, #{ visible: true });
    ROWS_NODE + "/BottomRowsColumn"
}

pub fn hide_rows() {
    util::hide(ROWS_NODE);
}

// The bottom dock's card grid, which Assets, Library and Tiles take turns
// filling. Six across is the widest the dock ever wants; a view that wants
// fewer writes its own `columns`.
pub const CARDS_NODE = "Editor/Shell/Body/Centre/Bottom/BottomCards";

pub fn hide_cards() {
    util::hide(CARDS_NODE);
}

// The bottom dock's `tree` node: the Debugger's call stack, and the locals
// each frame opens onto.
pub const TREE_NODE = "Editor/Shell/Body/Centre/Bottom/BottomTree";

pub fn hide_tree() {
    util::hide(TREE_NODE);
}

// The bottom dock's `table` node, which the panels with columns fill: the
// Profiler and the Cost dock take turns on it, as the log panels do above.
const TABLE_NODE = "Editor/Shell/Body/Centre/Bottom/BottomTable";

// `titles` names the columns and a row is one cell a column. `widths` is a
// share a column, stated only when the columns change: restating it every
// frame would snap the reader's own drag away.
pub fn show_table(titles, widths, items) {
    let held = util::prop(TABLE_NODE, "titles");
    let same = util::cells(util::vec(if held is Vec { held } else { [] })) == util::cells(titles);
    let params = #{ titles: titles, options: items, visible: true, sortable: true };
    if !same {
        params["widths"] = widths;
        // The last panel's sort was by a column this one does not have.
        params["sort"] = "";
        params["reverse"] = false;
    }
    util::fill(TABLE_NODE, params);
}

pub fn hide_table() {
    util::hide(TABLE_NODE);
}

// What the table reports as picked, cleared once the caller has acted on it.
pub fn taken_table() {
    util::taken(TABLE_NODE)
}

pub fn output(S, k) {
    let shown = filtered(S);
    // The lines are made once for the rows the filter kept, and again only for
    // new ones or a new theme.
    if shown.get("theme") != Some(k) {
        shown.items = log_lines(shown.rows, k);
        shown.theme = k;
    }
    show_log(S, shown.items);
    if shown.rows.len() == 0 {
        style::empty(k, if shown.hidden > 0 {
            format!("{} entries hidden by the filter", shown.hidden)
        } else {
            "nothing logged yet"
        });
    }
}

// One `list` row a log entry: its mark, the time, tag and message, its ink.
fn log_lines(rows, k) {
    let items = [];
    for entry in rows {
        let tint = k.text_muted;
        let marker = " ";
        if entry.level == "error" {
            tint = k.danger_text;
            marker = "\u{d7}";
        } else if entry.level == "warn" {
            tint = k.warning_text;
            marker = "!";
        } else if entry.tag == "env" {
            tint = k.secondary_text;
        }
        let tag = if entry.tag.len() > 9 { entry.tag[..9] } else { entry.tag };
        let line = marker + "\u{1f}";
        line += format!("{:6.1}s  {}  {}", util::f(entry.time), tag, entry.message);
        line += "\u{1f}\u{1f}" + tint;
        items.push(line);
    }
    items
}

// Icon and ink by extension, so a directory of assets reads at a glance. The
// tile is one fill for every card; only the mark is typed.
fn asset_look(name, is_dir) {
    if is_dir {
        return (crate::icons::panel("assets"), "text_muted");
    }
    if name.ends_with(".rn") {
        return (crate::icons::ui("scriptfile"), "secondary_text");
    }
    if name.ends_with(".toml") {
        return (crate::icons::panel("scene"), "primary_text");
    }
    if crate::importer::kind_of(name) == "texture" {
        return (crate::icons::workspace(defs::WORKSPACE_UI), "primary_text");
    }
    return (crate::icons::ui("dot"), "text_subtle");
}

// Opening a file means the thing the editor can actually do with it: jump to
// the node running a script, or open a scene. Anything else just selects.
fn open_asset(S, rel) {
    if rel.ends_with(".toml") && rel.starts_with("scenes/") {
        if S.scene_rel != rel {
            model::open_scene(S, rel);
        }
        return;
    }
    for (i, node) in S.doc.iter().enumerate() {
        if model::script_rel(node) == Some(rel) {
            shell::choose(S, i);
            shell::set_workspace(S, defs::WORKSPACE_SCRIPT);
            return;
        }
    }
    log::info(format!("{} is not attached to any node", rel));
}

fn parent_dir(dir) {
    let parts = dir.split('/').collect::<Vec>();
    if parts.len() <= 1 {
        return "";
    }
    parts.pop();
    util::join(parts, "/")
}

/// The Assets dock's own state, hung on `S.assets`. `sel` is the card acted
/// on by rename and delete; `renaming` swaps the breadcrumb for a field.
pub fn assets_state() {
    #{ dir: "", sel: "", renaming: false, cards: #{} }
}

// New folder, rename and delete: what a file browser is for, and what this
// one could not do until `fs` gained the verbs.
fn asset_verbs(S, k) {
    let chosen = S.assets.sel != "";
    // One button, two jobs: an import to start, or the one running to stop.
    let importing = crate::dropin::in_flight(S) > 0;
    [
        #{
            kind: "button", text: icons::panel("import") + if importing { " cancel" } else { " import" },
            role: "action_dock", checked: importing,
            tooltip: if importing { "Stop the import after the file it is writing" }
                else { "Bring in a model, a sprite or a level" },
            on: |_| {
                if importing {
                    import::cancel();
                } else {
                    // Asks and imports: a dialog on a desktop, the page's own
                    // chooser in a tab, and the same reports either way.
                    import::choose();
                }
            },
        },
        #{
            kind: "button", role: "action_dock", text: icons::ui("add") + " folder",
            tooltip: "Make a folder here",
            on: |_| { new_folder(S); },
        },
        #{
            kind: "button", text: "rename",
            role: if chosen { "action_dock" } else { "action_dock_quiet" },
            tooltip: if chosen { "Rename the selected item" } else { "Select an item first" },
            on: |_| {
                if chosen {
                    S.assets.renaming = !S.assets.renaming;
                }
            },
        },
        #{
            kind: "button", text: "delete",
            role: if chosen { "action_dock_danger" } else { "action_dock_quiet" },
            tooltip: if chosen { "Delete the selected item" } else { "Select an item first" },
            on: |_| {
                if chosen {
                    delete_asset(S);
                }
            },
        },
    ]
}

fn asset_path(S, rel) {
    S.game_root + "/" + rel
}

pub fn new_folder(S) {
    let base = if S.assets.dir == "" { "new-folder" } else { format!("{}/new-folder", S.assets.dir) };
    let name = base;
    let n = 2;
    while fs::exists(asset_path(S, name)) {
        name = format!("{}-{}", base, n);
        n += 1;
    }
    fs::create_directory(asset_path(S, name));
    model::forget(S, None);
    S.assets.sel = name;
    log::info(format!("made res://{}", name));
}

pub fn rename_asset(S, name) {
    S.assets.renaming = false;
    if name == "" || name.contains("/") {
        log::warn("a name cannot be empty or contain a slash");
        return;
    }
    let from = S.assets.sel;
    let to = if S.assets.dir == "" { name } else { format!("{}/{}", S.assets.dir, name) };
    if from == to {
        return;
    }
    if fs::exists(asset_path(S, to)) {
        log::warn(format!("res://{} already exists", to));
        return;
    }
    // The engine moves the file and rewrites every `.toml` naming it.
    let rewritten = ::assets::rename(asset_path(S, from), asset_path(S, to));
    model::forget(S, None);
    S.assets.sel = to;
    log::info(format!("renamed res://{} to res://{}; {} file(s) updated", from, to, rewritten.len()));
}

pub fn delete_asset(S) {
    let rel = S.assets.sel;
    if fs::remove(asset_path(S, rel)) {
        log::info(format!("deleted res://{}", rel));
    } else {
        log::warn(format!("res://{} was not there", rel));
    }
    model::forget(S, None);
    S.assets.sel = "";
}

pub fn assets(S, k) {
    let dir = S.assets.dir;
    let query = crate::search::query(S, "assets");
    let files = [];
    for f in model::list(S, dir) {
        if crate::search::matches(query, f.name) {
            files.push(f);
        }
    }
    crate::docks::chrome_rows(S, [assets_chrome(S, k, dir, files.len())]);
    show_cards(S, k, dir, files);
}

/// The Assets strip: where the browser is, what is in it, and the verbs.
fn assets_chrome(S, k, dir, count) {
    let out = [];
    if dir != "" {
        out.push(#{
            kind: "button", role: "action_dock", text: "↑", tooltip: "Up one folder",
            on: |_| { S.assets.dir = parent_dir(dir); },
        });
    }
    if S.assets.renaming {
        out.push(#{
            kind: "text_field", role: "input_dock", width: 180,
            text: util::last_segment(S.assets.sel), placeholder: "new name",
            on_submit: |name| { rename_asset(S, name); },
        });
    } else {
        out.push(#{ kind: "label", role: "text_caption", text: format!("res://{}", dir) });
    }
    out.push(#{ kind: "row", grow: 1 });
    out.push(#{ kind: "label", role: "text_caption", text: format!("{} items", count) });
    for verb in asset_verbs(S, k) {
        out.push(verb);
    }
    out.push(crate::search::control(S, "assets", "Search", 140.0));
    out
}

// The cards themselves, on the bottom dock's `list` node in its icon mode.
// One string a card: the mark, the name, the path it opens and its own ink.
fn show_cards(S, k, dir, files) {
    let items = [];
    let paths = [];
    for f in files {
        let rel = if dir == "" { f.name } else { format!("{}/{}", dir, f.name) };
        let (icon, ink) = asset_look(f.name, f.is_dir);
        items.push(util::row(icon, f.name, rel, k[ink]));
        paths.push(rel);
    }
    let chosen = "";
    let cards = #{};
    for (n, rel) in paths.iter().enumerate() {
        if rel == S.assets.sel {
            chosen = items[n];
        }
        if !files[n].is_dir {
            cards[items[n]] = rel;
        }
    }
    S.assets.cards = cards;
    util::fill(CARDS_NODE, #{
        options: items, visible: true, columns: 6, text: chosen,
    });
    // `clicked` rather than a changed `text`: a second click on the selected
    // card reports the same string, and that is the one that opens it.
    if util::prop(CARDS_NODE, "clicked") != true {
        return;
    }
    let picked = util::prop(CARDS_NODE, "text");
    for (n, item) in items.iter().enumerate() {
        if item != picked {
            continue;
        }
        // A second click on the selected card opens it, so one click can
        // still mean "act on this one".
        if item == chosen {
            if files[n].is_dir {
                S.assets.dir = paths[n];
                S.assets.sel = "";
            } else {
                open_asset(S, paths[n]);
            }
            return;
        }
        S.assets.sel = paths[n];
        S.assets.renaming = false;
    }
}

/// A card dragged out of the Assets dock and let go: over the viewport, the
/// file is placed where the pointer is; anywhere else, nothing happens.
pub fn drop_card(S, card) {
    let rel = match S.assets.get("cards").unwrap_or(#{}).get(card) {
        Some(rel) => rel,
        None => return false,
    };
    let (x, y) = input::mouse_position();
    if !crate::viewport::owns_pointer(S, x / S.ui_scale, y / S.ui_scale) {
        return false;
    }
    crate::dropin::place_file(S, rel)
}

// Keyframe timeline over the engine's clip (scripts/anim.rn is the adapter):
// scrubbing seeks the engine's player, so the viewport shows the engine's pose.
pub fn timeline(S, k) {
    let (node, _, _) = anim::player(S);
    ui::add_space(4);
    let def = match anim::definition(S) {
        Some(def) => def,
        None => {
            ui::row(#{ height: 30 }, || {
                ui::add_space(12);
                let missing = if anim::component(node).is_none() {
                    node.name + " has no clip"
                } else {
                    format!("{}: clip '{}' is not in its library", node.name, anim::clip_name(node))
                };
                ui::label(missing, style::mono_lg(k.text_subtle));
                ui::add_space(12);
                if ui::button(icons::ui("add") + " Create clip", #{
                    height: 24, font_size: style::MD, font_weight: 700,
                    fill: k.primary_fill, text_color: k.text_on_primary,
                }) {
                    anim::ensure_clip(S);
                }
            });
            return;
        }
    };
    let length = anim::length(def);
    let tracks = anim::tracks(def);
    let name_w = 150.0;
    let lane_x = name_w + 14.0;
    let lane_w = util::max(120.0, ui::available_width() - lane_x - 24.0);
    let lanes_h = (tracks.len() as f64) * LANE_H;

    // The ruler carries the scale the lanes are read against: a rule per tick
    // straight down through them, and the playhead over the top.
    ui::row(#{ height: 24 }, || {
        ui::add_space(8);
        ui::row(#{ height: 24, width: name_w }, || {
            if ui::button(icons::ui("add") + " Key", #{
                role: "chip", checked: true, tooltip: "Insert keyframe at playhead (or press K)",
            }) {
                anim::add_key(S, S.anim.time);
            }
            if ui::button("− Key", #{ role: "chip", tooltip: "Delete keyframe at playhead" }) {
                anim::delete_key_at(S, S.anim.time);
            }
        });
        ui::align_right(|| {
            ui::add_space(8);
            ui::label(format!("{:.2} / {:.2} s", S.anim.time, length), style::mono_sm(k.text_subtle));
        });
    });
    let step = tick_step(length);
    ui::row(#{ height: 20 }, || {
        ui::add_space(8.0 + lane_x);
        let t = 0.0;
        let cursor = 0.0;
        while t <= length + 1e-4 {
            let x = (t / length) * lane_w;
            if x - cursor > 0.0 {
                ui::add_space(x - cursor);
            }
            ui::label(format!("{:.2}", t), style::mono_sm(k.text_subtle));
            cursor = x + 26.0;
            t += step;
        }
    });
    // Rules and playhead, drawn from the sheet's corner so they cross lanes.
    let top = ui::layout_y();
    let t = 0.0;
    while t <= length + 1e-4 {
        let x = 8.0 + lane_x + (t / length) * lane_w;
        ui::rect_stroke(x, top, 0.6, lanes_h, #{ stroke: k.border_default, stroke_width: 1.0 });
        t += step;
    }
    let head_x = 8.0 + lane_x + (S.anim.time / util::max(length, 1e-4)) * lane_w;
    ui::rect_stroke(head_x, top - 6.0, 0.6, lanes_h + 6.0, #{ stroke: k.primary_text, stroke_width: 1.5 });

    ui::scroll("timeline-tracks", #{ max_height: util::min(lanes_h, S.layout.body_h - 60.0) }, || {
        for (index, track) in tracks.iter().enumerate() {
            let label = anim::track_label(track);
            let color = if index % 2 == 0 { k.primary_text } else { k.secondary_text };
            ui::row(#{ height: LANE_H }, || {
                ui::add_space(8);
                ui::row(#{ height: LANE_H, width: name_w }, || {
                    ui::dot(color, 6);
                    ui::add_space(6);
                    ui::label(label, style::mono_sm(k.text_default));
                });
                ui::add_space(14);
                let cursor = 0.0;
                for key in util::vec(track.get("keys").unwrap_or([])) {
                    let t = util::f(key.get("time").unwrap_or(0.0));
                    let x = util::max(0.0, (t / length) * lane_w - 5.0);
                    if x - cursor > 0.0 {
                        ui::add_space(x - cursor);
                        cursor = x;
                    }
                    let before = t <= S.anim.time + 1e-4;
                    if ui::button("", #{
                        height: 11, min_width: 11, corner_radius: 10,
                        fill: if before { color } else { k.bg_app },
                        stroke: color,
                        tooltip: format!("{:.2} s", t),
                    }) {
                        anim::seek(S, t);
                    }
                    cursor += 13.0;
                }
            });
        }
    });
    // The scrubber sits under the lanes, spanning exactly the lane column.
    ui::row(#{ height: 20 }, || {
        ui::add_space(8.0 + lane_x);
        let (t, scrubbed) = ui::slider(S.anim.time, 0.0, length, #{
            width: lane_w, rail: k.bg_control, fill: k.primary_text, knob: k.bg_app,
        });
        if scrubbed {
            anim::seek(S, t);
        }
    });
}

const LANE_H = 26.0;

// A tick every 0.25/0.5/1/2/5 s, whichever gives four to eight labels.
fn tick_step(length) {
    for step in [0.25, 0.5, 1.0, 2.0, 5.0, 10.0] {
        if length / step <= 8.0 {
            return step;
        }
    }
    length / 8.0
}

// A local as one line; a table is its JSON, cut short.
fn value_text(v) {
    if v is Object || v is Vec {
        // A node or a closure inside has no JSON form.
        let (ok, text) = script::attempt(|| json::encode(v));
        if !ok {
            return "‹object›";
        }
        if text.len() > 96 { text[..93] + "…" } else { text }
    } else if v is String {
        v
    } else {
        format!("{:?}", v)
    }
}

// The pause: transport, then the frames with the chosen one's locals open.
// Stopping where a script threw costs every synchronous call a trip through
// the stepping executor, so it is opt-in and says so.
fn break_on_error_pill(k) {
    let on = debugger::break_on_error();
    if ui::button("break on error", #{
        height: 20, font_size: style::SM, font_weight: 700,
        tooltip: "Stop at the line a script throws on, instead of logging it",
        fill: if on { k.primary_fill } else { k.bg_control },
        text_color: if on { k.text_on_primary } else { k.text_subtle },
    }) {
        debugger::set_break_on_error(!on);
    }
}

pub fn debugger_view(S, k) {
    let p = S.debug.paused;
    if !(p is Object) {
        ui::row(#{ height: 30 }, || {
            ui::add_space(8);
            // Nothing stops on the click: the next line a script runs is where.
            if S.playing && ui::button("⏸ Pause", #{
                height: 24, font_size: style::MD, font_weight: 700, tooltip: "F6",
                fill: k.primary_bg, text_color: k.primary_text,
            }) {
                debugger::request_break();
            }
            ui::add_space(4);
            let hint = if S.playing {
                "running · click a line number in the script to set a breakpoint"
            } else {
                "set breakpoints in the script gutter, then run the scene"
            };
            ui::label(hint, style::mono(k.text_subtle));
            ui::align_right(|| {
                ui::add_space(8);
                break_on_error_pill(k);
            });
        });
        return;
    }
    ui::row(#{ height: 30 }, || {
        ui::add_space(8);
        let steps = [
            ["▶ Continue", debugger::CONTINUE, "F5"],
            [icons::ui("step-over") + " Over", debugger::STEP_OVER, "F10"],
            [icons::ui("step-into") + " Into", debugger::STEP_INTO, "F11"],
            [icons::ui("step-out") + " Out", debugger::STEP_OUT, "⇧F11"],
        ];
        for step in steps {
            if ui::button(step[0], #{
                height: 24, font_size: style::MD, font_weight: 700, tooltip: step[2],
                fill: k.primary_bg, text_color: k.primary_text,
            }) {
                shell::resume(S, step[1]);
            }
        }
        ui::add_space(12);
        ui::label(format!("{} · {}:{}", p.reason, S.debug.paused_rel, p.line), style::mono(k.text_muted));
        let threw = p.get("message").unwrap_or("");
        if threw != "" {
            ui::add_space(8);
            ui::label(threw, style::mono(k.primary_text));
        }
        ui::align_right(|| {
            ui::add_space(8);
            break_on_error_pill(k);
        });
    });
    show_frames(S, k, p);
}

// The call stack on the `tree` node: a frame is a row, and its locals are
// rows a tab deeper. The caret is the tree's own, so nothing here folds.
fn show_frames(S, k, p) {
    let items = [];
    let owners = [];
    for (i, frame) in p.frames.iter().enumerate() {
        let site = format!("{}:{}", shell::script_rel(S, frame.path), frame.line);
        // A recursion stacks frames that read alike; the depth keeps them apart.
        items.push(util::cells([icons::ui("step-into"), frame["function"], site, k.text_default, format!("{}", i)]));
        owners.push(i);
        for name in util::keys_sorted(frame.locals) {
            items.push("\t" + util::cells(["", name, value_text(frame.locals[name]), k.text_muted, format!("{}/{}", i, name)]));
            owners.push(i);
        }
    }
    let chosen = "";
    for (n, owner) in owners.iter().enumerate() {
        if owner == S.debug.frame && chosen == "" {
            chosen = items[n];
        }
    }
    util::fill(TREE_NODE, #{ options: items, visible: true, text: chosen });
    let picked = util::prop(TREE_NODE, "text");
    for (n, item) in items.iter().enumerate() {
        if item == picked {
            S.debug.frame = owners[n];
        }
    }
}

// Problems: every finding the last sweep produced, worst first, each row a
// file and a line the click opens at.
pub fn problems(S, k) {
    let rows = [];
    for f in S.lint.found {
        if f.severity == "error" {
            rows.push(f);
        }
    }
    for f in S.lint.found {
        if f.severity != "error" {
            rows.push(f);
        }
    }
    let items = [];
    for f in rows {
        let bad = f.severity == "error";
        let at = if f.line > 0 { format!("{}:{}", f.file, f.line) } else { f.file };
        let line = if bad { "\u{d7}" } else { "!" };
        line += "\u{1f}" + format!("{}  {}", at, f.message);
        line += "\u{1f}\u{1f}" + if bad { k.danger_text } else { k.warning_text };
        items.push(line);
    }
    if rows.len() == 0 {
        hide_log(S);
        style::empty(k, if S.lint.at < 0.0 { "not checked yet" } else { "no problems" });
        return;
    }
    show_log(S, items);
    // The pick is the row, so the click opens the file it names.
    let picked = taken_log();
    for (n, item) in items.iter().enumerate() {
        if item == picked {
            open_at(S, rows[n]);
        }
    }
}

// Select the node whose script this is and show it, so a click lands on the
// code rather than on a file name.
fn open_at(S, f) {
    for (i, node) in S.doc.iter().enumerate() {
        if model::script_rel(node) == Some(f.file) {
            shell::choose(S, i);
            shell::set_workspace(S, defs::WORKSPACE_SCRIPT);
            return;
        }
    }
    S.doctab = "scene";
}

// Session: the recordings this game has made, and the one being played back.
// The lanes are the Animate timeline's over ticks instead of seconds, and
// clicking the ruler seeks — backwards by rebuilding and running to it again.
pub fn session_view(S, k) {
    ui::add_space(4);
    let split = replay::divergence_tick();
    let first = S.session.first;
    let last = S.session.last;
    let span = util::max(1.0, util::f(last - first));
    let name_w = 120.0;
    let lane_w = util::max(120.0, ui::available_width() - name_w - 60.0);

    ui::row(#{ height: 24 }, || {
        ui::add_space(8);
        ui::row(#{ height: 24, width: name_w - 12.0 }, || {
            let playing = replay::state() == replay::STATE_PLAYING;
            if ui::button(if playing { "⏸ Pause" } else { "▶ Play" }, #{
                height: 24, font_size: style::SM, font_weight: 700,
                fill: k.primary_bg, text_color: k.primary_text,
            }) {
                session::toggle_pause(S);
            }
            if ui::button("⇥", #{
                height: 24, font_size: style::SM, font_weight: 700, tooltip: "One recorded tick forward",
                fill: k.bg_control, text_color: k.text_muted,
            }) {
                session::step(S);
            }
            if ui::button("■", #{
                height: 24, font_size: style::SM, font_weight: 700, tooltip: "Back to the edited scene",
                fill: k.bg_control, text_color: k.text_muted,
            }) {
                session::close(S);
                return;
            }
        });
        // Before the first frame is fed the position is one tick short of the
        // session's start, which is off the near end of the ruler.
        let at = util::max(0.0, util::f(replay::position()) - util::f(first));
        let (t, scrubbed) = ui::slider(at, 0.0, span, #{
            width: lane_w,
            rail: k.bg_control, fill: k.primary_fill, knob: k.bg_app,
        });
        if scrubbed {
            session::seek(S, first + util::i(t));
        }
        ui::add_space(6);
        ui::label(format!("{} / {}", replay::position(), last), style::mono_sm(k.text_subtle));
    });

    // A divergence is information, not a failure: the replay ran, and this is
    // the tick at which it stopped reproducing what was recorded.
    if split is Object {
        ui::row(#{ height: 20 }, || {
            ui::add_space(8);
            ui::label(format!("parted from the recording at tick {}", split.tick),
                style::mono_sm(k.primary_text));
        });
    }

    ui::scroll("session-lanes", (), || {
        ui::spacing(4, 2);
        for lane in S.session.lanes {
            ui::row(#{ height: 20 }, || {
                ui::add_space(8);
                ui::row(#{ height: 20, width: name_w - 12.0 }, || {
                    ui::label(lane.name, style::mono_sm(k.text_muted));
                });
                lane_marks(S, k, lane, first, span, lane_w);
            });
        }
        detail(S, k);
    });
}

// One lane's dots, placed by tick. Drawn as a row of fixed-width slots rather
// than free-positioned marks, because the widget seam has no canvas.
fn lane_marks(S, k, lane, first, span, lane_w) {
    let slots = util::i(util::max(24.0, util::min(160.0, lane_w / 6.0)));
    let hits = [];
    for _ in 0..slots {
        hits.push(());
    }
    for mark in lane.marks {
        let at = util::f(mark.tick - first) / span;
        let i = util::i(util::clamp(at * util::f(slots - 1), 0.0, util::f(slots - 1)));
        hits[i] = mark;
    }
    let w = lane_w / util::f(slots);
    for (i, hit) in hits.iter().enumerate() {
        ui::row(#{ height: 20, width: w }, || {
            if hit is Object {
                let behind = hit.tick <= replay::position();
                if ui::button("", #{
                    height: 8, min_width: util::max(4.0, w - 2.0),
                    tooltip: format!("{}: {}", hit.tick, hit.label),
                    fill: if behind { k.primary_text } else { k.border_default }, text_color: k.text_muted,
                }) {
                    session::seek(S, hit.tick);
                }
            }
        });
    }
}

// Everything recorded at the tick the playhead is on, in the order it
// happened.
fn detail(S, k) {
    let at = S.session.at;
    let rows = util::vec(replay::events(at, at));
    if rows.len() == 0 {
        return;
    }
    ui::add_space(6);
    for e in rows {
        ui::row(#{ height: 20 }, || {
            ui::add_space(8);
            ui::label(format!("{}", e.tick), style::mono_sm(k.text_subtle));
            ui::label(e.kind, style::mono_sm(k.text_muted));
            ui::label(e.label, style::mono_sm(k.text_default));
        });
    }
}

// Every recording this game has made, newest first. "Keep" renames one out of
// the ring that prunes the oldest, so a session worth returning to survives
// the next ten runs.
///
/// The list is the Session panel until a recording is open, when the lanes
/// take the node instead.
pub fn session_list(S, k) {
    if session::loaded(S) {
        hide_rows();
        return;
    }
    let on = S.session.verify;
    crate::docks::chrome_rows(S, [[
        #{ kind: "label", role: "text_caption", grow: 1, text: "every play is recorded" },
        #{
            kind: "button", text: "verify",
            role: "chip", checked: on,
            tooltip: "Hash the world every tick, so a replay can name where it parted",
            on: |_| { S.session.verify = !on; },
        },
    ]]);
    let rows = session::listing(S);
    let specs = [];
    if rows.len() == 0 {
        specs.push(#{ full: true, height: 0, controls: [#{
            kind: "label", role: "text_caption", grow: 1, wrap: true,
            text: "no recordings yet — press Play",
        }] });
    }
    for entry in rows {
        // Bound afresh: a closure made in a loop captures the binding.
        let r = entry;
        specs.push(#{ full: true, height: 24, slot_role: "layout_actions", controls: session_row(S, r) });
    }
    crate::pool::sync(S, rows_host(S), specs, 0.0, false);
}

// One recording: the verb that plays it, what it is, and the three that keep,
// copy or drop it.
fn session_row(S, r) {
    let out = [
        #{
            kind: "button", role: "action_form_primary", text: "▶",
            tooltip: "Replay this recording",
            on: |_| { session::open(S, r.name); },
        },
        #{ kind: "label", role: "text_code", text: if r.started == "" { r.name } else { r.started } },
        #{
            kind: "label", role: "text_caption",
            text: format!("{} ticks · {:.1}s", r.ticks, r.seconds),
        },
    ];
    // How it ended, and whether its code has moved on since.
    if r.reason != "stop" {
        out.push(#{ kind: "label", role: "note_danger", text: r.reason });
    }
    if r.stale {
        out.push(#{ kind: "label", role: "note_warning", text: "scripts changed" });
    }
    out.push(#{ kind: "row", grow: 1 });
    out.push(#{
        kind: "button", role: "action_form", text: "delete",
        on: |_| { session::remove(S, r.name); },
    });
    out.push(#{
        kind: "button", role: "action_form", text: "copy to project",
        tooltip: "Copy into the project, for a bug report or `balaur replay`",
        on: |_| { session::export(S, r.name); },
    });
    if !r.name.starts_with("kept-") {
        out.push(#{
            kind: "button", role: "action_form", text: "keep",
            tooltip: "Never prune this one",
            on: |_| { session::keep(S, r.name); },
        });
    }
    out
}

// What one 60 Hz frame costs, as a bar per stage against that budget. The
// editor's own frame is what is measured while it is idle; press Play and it
// becomes the game's, which is the number anyone actually wants.
const BUDGET_MS = 16.667;

// Rune's `format!` takes a literal precision only, so a variable one is a
// match. Mirrors `inspector::fixed`, which is private to that module.
fn fixed(v, decimals) {
    match decimals {
        1 => format!("{:.1}", v),
        3 => format!("{:.3}", v),
        _ => format!("{:.2}", v),
    }
}

pub fn profiler(S, k) {
    // Live numbers: the panel asks for the next pass for as long as it is open.
    ui::request_repaint();
    let timings = engine::timings();
    if !(timings is Object) {
        hide_table();
        style::empty(k, "no timings yet");
        return;
    }
    let items = [];
    cost_rows(items, k, util::obj(timings.stages), "stage");
    let spans = util::obj(timings.spans);
    if !spans.is_empty() {
        cost_rows(items, k, spans, "span");
    }
    if S.get("script_profiling").unwrap_or(false) {
        script_rows(items, k);
    }
    show_table(["what", "cost>", "share of a frame"], ["2", "1", "2"], items);
}

/// What each script and each of the dearest functions cost the last frame,
/// dearest first, against the dearest of them rather than against the budget:
/// the unit is instructions.
///
/// Instructions rather than milliseconds: the same frame runs the same
/// instructions on every machine, so a number that moved is a change in what
/// a script does. Re-armed after reading, so a row is one frame's work.
fn script_rows(items, k) {
    let costs = engine::script_costs();
    let worst = if costs.is_empty() { 0.0 } else { util::f(costs[0].instructions) };
    for row in costs {
        let count = util::f(row.instructions);
        let share = if worst > 0.0 { util::clamp(count / worst, 0.0, 1.0) } else { 0.0 };
        items.push(util::cells([
            row.path, format!("{} instr", row.instructions), bar(share), k.secondary_text,
        ]));
    }
    // Each function's own instructions under its file's rows: the VM's count,
    // so a `draw` callback and a closure the pool calls are in it too.
    let functions = engine::function_costs();
    let top = if functions.is_empty() { 0.0 } else { util::f(functions[0].instructions) };
    let n = 0;
    while n < functions.len() && n < FUNCTION_ROWS {
        let row = functions[n];
        let count = util::f(row.instructions);
        let share = if top > 0.0 { util::clamp(count / top, 0.0, 1.0) } else { 0.0 };
        items.push(util::cells([
            row.function, format!("{} instr · {} calls", row.instructions, row.calls), bar(share), k.text_muted,
        ]));
        n += 1;
    }
    engine::set_script_profiling(true);
}

/// How many of the dearest functions the Profiler lists under the scripts.
const FUNCTION_ROWS = 12;

/// A share as blocks, which reads at a glance where a number has to be read.
/// Twelve cells, so one is about eight percent: twenty overran the Cost
/// dock's column, which is a fifth of the dock.
///
/// Filled blocks and nothing else: a track drawn in the light block reads as
/// noise down a column of them.
fn bar(share) {
    let filled = util::i(util::clamp(share, 0.0, 1.0) * 12.0);
    util::repeat("\u{2588}", filled)
}

// Worst first. A hand-written pass rather than a comparator: a float
// comparison in Rune answers with an Option, and the list is eight rows long.
fn by_cost(table) {
    let left = [];
    for (name, seconds) in table.iter() {
        left.push(#{ name: name, ms: util::f(seconds) * 1000.0 });
    }
    let out = [];
    while !left.is_empty() {
        // Indexed, not `left.iter()`: an iterator holds a read borrow until it
        // goes out of scope, and `remove` below needs to write.
        let worst = 0;
        let i = 1;
        while i < left.len() {
            if left[i].ms > left[worst].ms {
                worst = i;
            }
            i += 1;
        }
        out.push(left.remove(worst));
    }
    out
}

// One row per entry, worst first, with a bar as its share of the budget: a
// number needs reading, a bar does not.
fn cost_rows(items, k, table, kind) {
    for row in by_cost(table) {
        let tint = if row.ms > BUDGET_MS * 0.5 {
            k.primary_text
        } else if kind == "span" {
            k.secondary_text
        } else {
            k.text_muted
        };
        items.push(util::cells([
            row.name, fixed(row.ms, 3) + " ms", bar(row.ms / BUDGET_MS), tint,
        ]));
    }
}



/// Bytes as the unit a person reads them in.
fn bytes(n) {
    if n < 1024.0 {
        return format!("{} B", n as i64);
    }
    if n < 1048576.0 {
        return fixed(n / 1024.0, 1) + " KB";
    }
    fixed(n / 1048576.0, 1) + " MB"
}

/// Rows sorted by one key, worst first. The same insertion pass `by_cost`
/// uses; a frame's node list is short and Rune's `sort` takes no comparator.
fn by_key(rows, key) {
    let left = [];
    for row in rows {
        left.push(row);
    }
    let out = [];
    while left.len() > 0 {
        let worst = 0;
        let i = 1;
        while i < left.len() {
            if util::f(left[i][key]) > util::f(left[worst][key]) {
                worst = i;
            }
            i += 1;
        }
        out.push(left.remove(worst));
    }
    out
}

/// What the frame draws, per node: the other half of the Profiler, beside the
/// milliseconds. `render.stats` counts it from the scene, so a headless run
/// reports the same triangles a windowed one does.
pub fn cost(S, k) {
    ui::request_repaint();
    let stats = util::obj(render::stats());
    let nodes = util::vec(stats.get("nodes").unwrap_or([]));
    if nodes.len() == 0 {
        hide_table();
        style::empty(k, "nothing is drawing");
        return;
    }
    let worst = util::f(by_key(nodes, "triangles")[0].triangles);
    let items = [];
    for row in by_key(nodes, "triangles") {
        let share = util::clamp(util::f(row.triangles) / util::max(worst, 1.0), 0.0, 1.0);
        let copies = util::i(row.copies);
        items.push(util::cells([
            util::leaf(row.node),
            format!("{} tri", util::i(row.triangles)),
            bytes(util::f(row.texture_bytes)),
            if copies > 1 { format!("x{}", copies) } else { "" },
            bar(share),
            k.text_muted,
        ]));
    }
    show_table(
        ["node", "triangles>", "textures>", "copies>", "share of the worst"],
        ["2", "1", "1", "0.7", "1.6"],
        items,
    );
}

/// How big the last export was, or a line saying none has been made. The
/// pack is what a player downloads, so it belongs beside the frame's cost.
fn pack_size(S) {
    let out = export::output("web");
    if !(out is String) || !fs::exists(out) {
        return "not exported yet";
    }
    let total = 0.0;
    for entry in util::vec(fs::list(out)) {
        if !entry.is_dir {
            total += 1.0;
        }
    }
    format!("{} file(s) at {}", total as i64, util::leaf(out))
}
