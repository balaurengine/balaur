// Bottom dock (150 px, 212 px for Timeline and Debugger): Output / Assets /
// Timeline / Debugger.

use crate::anim;
use crate::icons;
use crate::model;
use crate::session;
use crate::shell;
use crate::style;
use crate::util;

/// The right-hand hint for a panel, one table rather than an `if` chain that
/// fell through to the animation branch for everything unlisted.
pub fn hint(S, id) {
    if id == "assets" {
        // A project-relative path: the absolute one is this machine's, and
        // lands in every screenshot.
        return format!("res:// · {}", S.game_name);
    }
    if id == "debugger" {
        if S.debug.paused is Object {
            return S.debug.paused.reason;
        }
        return "F5 run · F10 over · F11 into · ⇧F11 out";
    }
    if id == "timeline" {
        let (node, _, _) = anim::player(S);
        let text = match anim::definition(S) {
            None => "no clip",
            Some(def) => {
                let name = anim::clip_name(node);
                format!("0.00 – {:.2} s · {} · {}",
                    anim::length(def),
                    if name == "" { "unnamed" } else { name },
                    anim::library_path(node).unwrap_or("inline"))
            }
        };
        return text;
    }
    ""
}

/// Output owns the tab row's slot when it is showing: a log without a filter,
/// a level and a clear is unusable.
pub fn output_tools(S, k, room) {
    if room < 90.0 {
        return;
    }
    ui::add_space(6);
    if ui::pill("clear", #{
        height: 24, size: style::SM, strong: true, tooltip: "Empty the log buffer",
        fill: k.sunken, color: k.dim,
    }) {
        log::clear();
    }
    if room < 200.0 {
        return;
    }
    for level in ["error", "warn", "all"] {
        let active = S.log_level == level;
        if ui::pill(level, #{
            height: 24, size: style::SM, strong: true,
            tooltip: format!("Show {} and above", level),
            fill: if active { k.accent_soft } else { k.sunken },
            color: if active { k.accent } else { k.dim },
        }) {
            S.log_level = level;
        }
    }
    if S.compact || room < 350.0 {
        // No field on screen, so no invisible filter hiding rows.
        S.log_query = "";
    } else {
        let (query, _, _) = ui::text_field("log-search", "Search", #{
            size: style::SM, font: ui::FONT_MONO, width: 130, height: 24,
            fill: k.sunken, stroke: k.line, color: k.text,
        });
        S.log_query = query;
    }
}

// How loud an entry is, so `error` and `warn` stop looking identical.
fn severity(level) {
    match level {
        "error" => 3,
        "warn" => 2,
        "info" => 1,
        _ => 0,
    }
}

fn floor_of(level) {
    match level {
        "warn" => 2,
        "error" => 3,
        _ => 0,
    }
}

// The rows the level and the filter leave, and how many they took away.
// Filtering lowercases every message, so it is redone only when the log, the
// level or the filter has actually moved.
fn filtered(S) {
    // The buffer holds 500; asking for 60 threw away most of the session.
    let entries = util::vec(log::recent(500));
    let newest = if entries.len() > 0 {
        format!("{}{}", util::f(entries[entries.len() - 1].time), entries[entries.len() - 1].message)
    } else {
        ""
    };
    let mark = format!("{}|{}|{}|{}", entries.len(), newest, S.log_level, S.log_query);
    let cache = S.log_cache;
    if cache is Object && cache.mark == mark {
        return cache;
    }
    let floor = floor_of(S.log_level);
    let query = S.log_query.to_lowercase();
    let rows = [];
    let hidden = 0;
    for entry in entries {
        let matches = query == ""
            || entry.message.to_lowercase().contains(query)
            || entry.tag.to_lowercase().contains(query);
        if severity(entry.level) < floor || !matches {
            hidden += 1;
            continue;
        }
        rows.push(entry);
    }
    let built = #{ mark: mark, rows: rows, hidden: hidden };
    S.log_cache = built;
    built
}

// The bottom dock's `list` node, which the log-shaped panels fill instead of
// drawing a row at a time.
const LOG_NODE = "Editor/Shell/Body/Centre/Bottom/BottomLog";

// Put `items` on the node and show it. A row is icon, label, note and colour,
// separated by U+001F, which is what a `list` row splits on.
pub fn show_log(items) {
    util::fill(LOG_NODE, #{ options: items, visible: true });
    true
}

// What the node reports as picked, and clearing it once acted on.
fn picked_log() {
    util::taken(LOG_NODE, util::fill(LOG_NODE, #{}))
}

// Hidden while a panel that is not a list is up.
pub fn hide_log() {
    util::hide(LOG_NODE);
}

// The bottom dock's card grid, which Assets, Library and Tiles take turns
// filling. Six across is the widest the dock ever wants; a view that wants
// fewer writes its own `columns`.
pub const CARDS_NODE = "Editor/Shell/Body/Centre/Bottom/BottomCards";

pub fn hide_cards() {
    util::hide(CARDS_NODE);
}

// The bottom dock's `tree` node: the Debugger's call stack, and the locals
// each frame opens onto.
pub const TREE_NODE = "Editor/Shell/Body/Centre/Bottom/BottomTree";

pub fn hide_tree() {
    util::hide(TREE_NODE);
}

pub fn output(S, k) {
    let shown = filtered(S);
    let items = [];
    for entry in shown.rows {
        let tint = k.dim;
        let marker = " ";
        if entry.level == "error" {
            tint = k.accent;
            marker = "\u{d7}";
        } else if entry.level == "warn" {
            tint = k.accent;
            marker = "!";
        } else if entry.tag == "env" {
            tint = k.sage;
        }
        let tag = if entry.tag.len() > 9 { entry.tag[..9] } else { entry.tag };
        let line = marker + "\u{1f}";
        line += format!("{:6.1}s  {}  {}", util::f(entry.time), tag, entry.message);
        line += "\u{1f}\u{1f}" + tint;
        items.push(line);
    }
    if show_log(items) {
        return;
    }
    ui::scroll("output", #{ stick_to_bottom: true, max_height: S.layout.body_h - 6.0 }, || {
        ui::spacing(4, 2);
        for entry in shown.rows {
            ui::horizontal((), || {
                ui::add_space(6);
                let color = k.dim;
                let marker = " ";
                if entry.level == "error" {
                    color = k.accent;
                    marker = icons::ui("close");
                } else if entry.level == "warn" {
                    color = k.accent;
                    marker = "!";
                } else if entry.tag == "env" {
                    color = k.sage;
                }
                ui::label(marker, util::merge(style::mono(color), #{ strong: true }));
                ui::label(format!("{:6.1}s", util::f(entry.time)), style::mono(k.faint));
                ui::add_space(6);
                let tag = if entry.tag.len() > 9 { entry.tag[..9] } else { entry.tag };
                let tag_color = if entry.level == "error" { k.accent } else { color };
                ui::label(tag + util::repeat(" ", 9 - tag.len()),
                    util::merge(style::mono(tag_color), #{ strong: true }));
                ui::add_space(6);
                let bad = entry.level == "error";
                ui::label(entry.message,
                    util::merge(style::mono(if bad { k.text } else { k.dim }), #{ strong: bad }));
                // Structured fields the event carried, which the message text
                // deliberately does not repeat.
                for field in util::vec(entry.get("fields").unwrap_or([])) {
                    ui::add_space(8);
                    ui::label(format!("{}={}", field.name, field.value), style::mono_sm(k.faint));
                }
            });
        }
        if shown.rows.len() == 0 {
            style::empty(k, if shown.hidden > 0 {
                format!("{} entries hidden by the filter", shown.hidden)
            } else {
                "nothing logged yet"
            });
        }
    });
}

// Icon and ink by extension, so a directory of assets reads at a glance. The
// tile is one fill for every card; only the mark is typed.
fn asset_look(name, is_dir) {
    if is_dir {
        return (crate::icons::panel("assets"), "dim");
    }
    if name.ends_with(".rn") {
        return (crate::icons::ui("scriptfile"), "sage");
    }
    if name.ends_with(".toml") {
        return (crate::icons::panel("scene"), "accent");
    }
    if name.ends_with(".png") || name.ends_with(".jpg") {
        return (crate::icons::persona("ui"), "accent");
    }
    return (crate::icons::ui("dot"), "faint");
}

// Opening a file means the thing the editor can actually do with it: jump to
// the node running a script, or open a scene. Anything else just selects.
fn open_asset(S, rel) {
    if rel.ends_with(".toml") && rel.starts_with("scenes/") {
        if S.scene_rel != rel {
            model::open_scene(S, rel);
        }
        return;
    }
    for (i, node) in S.doc.iter().enumerate() {
        if model::script_rel(node) == Some(rel) {
            shell::choose(S, i);
            shell::set_persona(S, "script");
            return;
        }
    }
    log::info(format!("{} is not attached to any node", rel));
}

fn parent_dir(dir) {
    let parts = dir.split('/').collect::<Vec>();
    if parts.len() <= 1 {
        return "";
    }
    parts.pop();
    util::join(parts, "/")
}

/// The Assets dock's own state, hung on `S.assets`. `sel` is the card acted
/// on by rename and delete; `renaming` swaps the breadcrumb for a field.
pub fn assets_state() {
    #{ dir: "", sel: "", renaming: false }
}

// New folder, rename and delete: what a file browser is for, and what this
// one could not do until `fs` gained the verbs.
fn asset_verbs(S, k) {
    let chosen = S.assets.sel != "";
    if ui::pill(icons::ui("add") + " folder", #{
        height: 20, size: style::SM, strong: true, tooltip: "Make a folder here",
        fill: k.sunken, color: k.dim,
    }) {
        new_folder(S);
    }
    ui::add_space(6);
    if ui::pill("rename", #{
        height: 20, size: style::SM, strong: true,
        tooltip: if chosen { "Rename the selected item" } else { "Select an item first" },
        fill: k.sunken, color: if chosen { k.dim } else { k.line },
    }) {
        if chosen {
            S.assets.renaming = !S.assets.renaming;
        }
    }
    ui::add_space(6);
    if ui::pill("delete", #{
        height: 20, size: style::SM, strong: true,
        tooltip: if chosen { "Delete the selected item" } else { "Select an item first" },
        fill: k.sunken, color: if chosen { k.accent } else { k.line },
    }) {
        if chosen {
            delete_asset(S);
        }
    }
}

fn asset_path(S, rel) {
    S.game_root + "/" + rel
}

pub fn new_folder(S) {
    let base = if S.assets.dir == "" { "new-folder" } else { format!("{}/new-folder", S.assets.dir) };
    let name = base;
    let n = 2;
    while fs::exists(asset_path(S, name)) {
        name = format!("{}-{}", base, n);
        n += 1;
    }
    fs::mkdir(asset_path(S, name));
    model::forget(S, None);
    S.assets.sel = name;
    log::info(format!("made res://{}", name));
}

pub fn rename_asset(S, name) {
    S.assets.renaming = false;
    if name == "" || name.contains("/") {
        log::warn("a name cannot be empty or contain a slash");
        return;
    }
    let from = S.assets.sel;
    let to = if S.assets.dir == "" { name } else { format!("{}/{}", S.assets.dir, name) };
    if from == to {
        return;
    }
    if fs::exists(asset_path(S, to)) {
        log::warn(format!("res://{} already exists", to));
        return;
    }
    // The engine moves the file and rewrites every `.toml` naming it.
    let rewritten = ::assets::rename(asset_path(S, from), asset_path(S, to));
    model::forget(S, None);
    S.assets.sel = to;
    log::info(format!("renamed res://{} to res://{}; {} file(s) updated", from, to, rewritten.len()));
}

pub fn delete_asset(S) {
    let rel = S.assets.sel;
    if fs::remove(asset_path(S, rel)) {
        log::info(format!("deleted res://{}", rel));
    } else {
        log::warn(format!("res://{} was not there", rel));
    }
    model::forget(S, None);
    S.assets.sel = "";
}

pub fn assets(S, k) {
    let dir = S.assets.dir;
    let query = crate::search::query(S, "assets");
    let files = [];
    for f in model::list(S, dir) {
        if crate::search::matches(query, f.name) {
            files.push(f);
        }
    }
    ui::horizontal(#{ height: 24 }, || {
        ui::add_space(12);
        if dir != "" {
            if ui::pill("↑", #{ height: 20, size: style::SM, strong: true, fill: k.sunken, color: k.dim, tooltip: "Up one folder" }) {
                S.assets.dir = parent_dir(dir);
            }
            ui::add_space(6);
        }
        if S.assets.renaming {
            let (name, _, submitted) = ui::text_field("asset-rename", "new name",
                util::merge(style::field(k, 180.0), #{ value: util::last_segment(S.assets.sel) }));
            if submitted {
                rename_asset(S, name);
            }
        } else {
            ui::label(format!("res://{}", dir), style::mono_sm(k.faint));
        }
        ui::right(|| {
            ui::add_space(12);
            ui::label(format!("{} items", files.len()), style::mono_sm(k.faint));
            ui::add_space(12);
            asset_verbs(S, k);
            ui::add_space(8);
            crate::search::field(S, k, "assets", "Search", 140.0);
        });
    });
    show_cards(S, k, dir, files);
}

// The cards themselves, on the bottom dock's `list` node in its icon mode.
// One string a card: the mark, the name, the path it opens and its own ink.
fn show_cards(S, k, dir, files) {
    let items = [];
    let paths = [];
    for f in files {
        let rel = if dir == "" { f.name } else { format!("{}/{}", dir, f.name) };
        let (icon, ink) = asset_look(f.name, f.is_dir);
        items.push(util::row(icon, f.name, rel, k[ink]));
        paths.push(rel);
    }
    let chosen = "";
    for (n, rel) in paths.iter().enumerate() {
        if rel == S.assets.sel {
            chosen = items[n];
        }
    }
    let params = util::fill(CARDS_NODE, #{
        options: items, visible: true, columns: 6, text: chosen,
    });
    // `clicked` rather than a changed `text`: a second click on the selected
    // card reports the same string, and that is the one that opens it.
    if !params["clicked"] {
        return;
    }
    let picked = params["text"];
    for (n, item) in items.iter().enumerate() {
        if item != picked {
            continue;
        }
        // A second click on the selected card opens it, so one click can
        // still mean "act on this one".
        if item == chosen {
            if files[n].is_dir {
                S.assets.dir = paths[n];
                S.assets.sel = "";
            } else {
                open_asset(S, paths[n]);
            }
            return;
        }
        S.assets.sel = paths[n];
        S.assets.renaming = false;
    }
}

// Keyframe timeline over the engine's clip (scripts/anim.rn is the adapter):
// scrubbing seeks the engine's player, so the viewport shows the engine's pose.
pub fn timeline(S, k) {
    let (node, _, _) = anim::player(S);
    ui::add_space(4);
    let def = match anim::definition(S) {
        Some(def) => def,
        None => {
            ui::horizontal(#{ height: 30 }, || {
                ui::add_space(12);
                let missing = if anim::component(node).is_none() {
                    node.name + " has no clip"
                } else {
                    format!("{}: clip '{}' is not in its library", node.name, anim::clip_name(node))
                };
                ui::label(missing, style::mono_lg(k.faint));
                ui::add_space(12);
                if ui::pill(icons::ui("add") + " Create clip", #{
                    height: 24, size: style::MD, strong: true,
                    fill: k.accent_fill, color: k.on_accent,
                }) {
                    anim::ensure_clip(S);
                }
            });
            return;
        }
    };
    let length = anim::length(def);
    let tracks = anim::tracks(def);
    let name_w = 150.0;
    let lane_x = name_w + 14.0;
    let lane_w = util::max(120.0, ui::available_width() - lane_x - 24.0);
    let lanes_h = (tracks.len() as f64) * LANE_H;

    // The ruler carries the scale the lanes are read against: a rule per tick
    // straight down through them, and the playhead over the top.
    ui::horizontal(#{ height: 24 }, || {
        ui::add_space(8);
        ui::horizontal(#{ height: 24, width: name_w }, || {
            if ui::pill(icons::ui("add") + " Key", #{
                role: "chip_on", tooltip: "Insert keyframe at playhead (or press K)",
            }) {
                anim::add_key(S, S.anim.time);
            }
            if ui::pill("− Key", #{ role: "chip", tooltip: "Delete keyframe at playhead" }) {
                anim::delete_key_at(S, S.anim.time);
            }
        });
        ui::right(|| {
            ui::add_space(8);
            ui::label(format!("{:.2} / {:.2} s", S.anim.time, length), style::mono_sm(k.faint));
        });
    });
    let step = tick_step(length);
    ui::horizontal(#{ height: 20 }, || {
        ui::add_space(8.0 + lane_x);
        let t = 0.0;
        let cursor = 0.0;
        while t <= length + 1e-4 {
            let x = (t / length) * lane_w;
            if x - cursor > 0.0 {
                ui::add_space(x - cursor);
            }
            ui::label(format!("{:.2}", t), style::mono_sm(k.faint));
            cursor = x + 26.0;
            t += step;
        }
    });
    // Rules and playhead, drawn from the sheet's corner so they cross lanes.
    let top = ui::cursor_y();
    let t = 0.0;
    while t <= length + 1e-4 {
        let x = 8.0 + lane_x + (t / length) * lane_w;
        ui::rect_stroke(x, top, 0.6, lanes_h, #{ color: k.line, width: 1.0 });
        t += step;
    }
    let head_x = 8.0 + lane_x + (S.anim.time / util::max(length, 1e-4)) * lane_w;
    ui::rect_stroke(head_x, top - 6.0, 0.6, lanes_h + 6.0, #{ color: k.accent, width: 1.5 });

    ui::scroll("timeline-tracks", #{ max_height: util::min(lanes_h, S.layout.body_h - 60.0) }, || {
        for (index, track) in tracks.iter().enumerate() {
            let label = anim::track_label(track);
            let color = if index % 2 == 0 { k.accent } else { k.sage };
            ui::horizontal(#{ height: LANE_H }, || {
                ui::add_space(8);
                ui::horizontal(#{ height: LANE_H, width: name_w }, || {
                    ui::dot(color, 6);
                    ui::add_space(6);
                    ui::label(label, style::mono_sm(k.text));
                });
                ui::add_space(14);
                let cursor = 0.0;
                for key in util::vec(track.get("keys").unwrap_or([])) {
                    let t = util::f(key.get("t").unwrap_or(0.0));
                    let x = util::max(0.0, (t / length) * lane_w - 5.0);
                    if x - cursor > 0.0 {
                        ui::add_space(x - cursor);
                        cursor = x;
                    }
                    let before = t <= S.anim.time + 1e-4;
                    if ui::pill("", #{
                        height: 11, min_width: 11, radius: 10,
                        fill: if before { color } else { k.bg },
                        stroke: color,
                        tooltip: format!("{:.2} s", t),
                    }) {
                        anim::seek(S, t);
                    }
                    cursor += 13.0;
                }
            });
        }
    });
    // The scrubber sits under the lanes, spanning exactly the lane column.
    ui::horizontal(#{ height: 20 }, || {
        ui::add_space(8.0 + lane_x);
        let (t, scrubbed) = ui::slider(S.anim.time, 0.0, length, #{
            width: lane_w, rail: k.sunken, fill: k.accent, knob: k.bg,
        });
        if scrubbed {
            anim::seek(S, t);
        }
    });
}

const LANE_H = 26.0;

// A tick every 0.25/0.5/1/2/5 s, whichever gives four to eight labels.
fn tick_step(length) {
    for step in [0.25, 0.5, 1.0, 2.0, 5.0, 10.0] {
        if length / step <= 8.0 {
            return step;
        }
    }
    length / 8.0
}

// A local as one line; a table is its JSON, cut short.
fn value_text(v) {
    if v is Object || v is Vec {
        // A node or a closure inside has no JSON form.
        let (ok, text) = script::attempt(|| json::encode(v));
        if !ok {
            return "‹object›";
        }
        if text.len() > 96 { text[..93] + "…" } else { text }
    } else if v is String {
        v
    } else {
        format!("{:?}", v)
    }
}

// The pause: transport, then the frames with the chosen one's locals open.
// Stopping where a script threw costs every synchronous call a trip through
// the stepping executor, so it is opt-in and says so.
fn break_on_error_pill(k) {
    let on = debugger::break_on_error();
    if ui::pill("break on error", #{
        height: 20, size: style::SM, strong: true,
        tooltip: "Stop at the line a script throws on, instead of logging it",
        fill: if on { k.accent_fill } else { k.sunken },
        color: if on { k.on_accent } else { k.faint },
    }) {
        debugger::set_break_on_error(!on);
    }
}

pub fn debugger_view(S, k) {
    let p = S.debug.paused;
    if !(p is Object) {
        ui::horizontal(#{ height: 30 }, || {
            ui::add_space(8);
            // Nothing stops on the click: the next line a script runs is where.
            if S.playing && ui::pill("⏸ Pause", #{
                height: 24, size: style::MD, strong: true, tooltip: "F6",
                fill: k.accent_soft, color: k.accent,
            }) {
                debugger::request_break();
            }
            ui::add_space(4);
            let hint = if S.playing {
                "running · click a line number in the script to set a breakpoint"
            } else {
                "set breakpoints in the script gutter, then run the scene"
            };
            ui::label(hint, style::mono(k.faint));
            ui::right(|| {
                ui::add_space(8);
                break_on_error_pill(k);
            });
        });
        return;
    }
    ui::horizontal(#{ height: 30 }, || {
        ui::add_space(8);
        let steps = [
            ["▶ Continue", debugger::CONTINUE, "F5"],
            [icons::ui("step-over") + " Over", debugger::STEP_OVER, "F10"],
            [icons::ui("step-into") + " Into", debugger::STEP_INTO, "F11"],
            [icons::ui("step-out") + " Out", debugger::STEP_OUT, "⇧F11"],
        ];
        for step in steps {
            if ui::pill(step[0], #{
                height: 24, size: style::MD, strong: true, tooltip: step[2],
                fill: k.accent_soft, color: k.accent,
            }) {
                shell::resume(S, step[1]);
            }
        }
        ui::add_space(12);
        ui::label(format!("{} · {}:{}", p.reason, S.debug.paused_rel, p.line), style::mono(k.dim));
        let threw = p.get("message").unwrap_or("");
        if threw != "" {
            ui::add_space(8);
            ui::label(threw, style::mono(k.accent));
        }
        ui::right(|| {
            ui::add_space(8);
            break_on_error_pill(k);
        });
    });
    show_frames(S, k, p);
}

// The call stack on the `tree` node: a frame is a row, and its locals are
// rows a tab deeper. The caret is the tree's own, so nothing here folds.
fn show_frames(S, k, p) {
    let items = [];
    let owners = [];
    for (i, frame) in p.frames.iter().enumerate() {
        let site = format!("{}:{}", shell::script_rel(S, frame.path), frame.line);
        items.push(util::row(icons::ui("step-into"), frame["function"], site, k.text));
        owners.push(i);
        for name in util::keys_sorted(frame.locals) {
            items.push("\t" + util::row("", name, value_text(frame.locals[name]), k.dim));
            owners.push(i);
        }
    }
    let chosen = "";
    for (n, owner) in owners.iter().enumerate() {
        if owner == S.debug.frame && chosen == "" {
            chosen = items[n];
        }
    }
    let params = util::fill(TREE_NODE, #{ options: items, visible: true, text: chosen });
    let picked = params["text"];
    for (n, item) in items.iter().enumerate() {
        if item == picked {
            S.debug.frame = owners[n];
        }
    }
}

// Problems: every finding the last sweep produced, worst first, each row a
// file and a line the click opens at.
pub fn problems(S, k) {
    let rows = [];
    for f in S.lint.found {
        if f.severity == "error" {
            rows.push(f);
        }
    }
    for f in S.lint.found {
        if f.severity != "error" {
            rows.push(f);
        }
    }
    let items = [];
    for f in rows {
        let bad = f.severity == "error";
        let at = if f.line > 0 { format!("{}:{}", f.file, f.line) } else { f.file };
        let line = if bad { "\u{d7}" } else { "!" };
        line += "\u{1f}" + format!("{}  {}", at, f.message);
        line += "\u{1f}\u{1f}" + if bad { k.accent } else { k.sage };
        items.push(line);
    }
    if rows.len() > 0 && show_log(items) {
        // The pick is the row, so the click opens the file it names.
        let picked = picked_log();
        for (n, item) in items.iter().enumerate() {
            if item == picked {
                open_at(S, rows[n]);
            }
        }
        return;
    }
    ui::scroll("problems", #{ max_height: S.layout.body_h - 6.0 }, || {
        ui::spacing(4, 2);
        if rows.len() == 0 {
            style::empty(k, if S.lint.at < 0.0 { "not checked yet" } else { "no problems" });
            return;
        }
        for f in rows {
            let bad = f.severity == "error";
            ui::horizontal(#{ height: 24 }, || {
                ui::add_space(6);
                // `×`, not `✕`: the mono face has no glyph for the latter.
                ui::label(if bad { "×" } else { "!" },
                    util::merge(style::mono(if bad { k.accent } else { k.sage }), #{ strong: true }));
                ui::add_space(6);
                let at = if f.line > 0 { format!("{}:{}", f.file, f.line) } else { f.file };
                if ui::pill(at, #{
                    height: 20, size: style::SM, font: ui::FONT_MONO,
                    fill: k.sunken, color: k.dim,
                    tooltip: "Open the file at this line",
                }) {
                    open_at(S, f);
                }
                ui::add_space(6);
                ui::label(f.message,
                    util::merge(style::mono(if bad { k.text } else { k.dim }), #{ strong: bad }));
            });
        }
    });
}

// Select the node whose script this is and show it, so a click lands on the
// code rather than on a file name.
fn open_at(S, f) {
    for (i, node) in S.doc.iter().enumerate() {
        if model::script_rel(node) == Some(f.file) {
            shell::choose(S, i);
            shell::set_persona(S, "script");
            return;
        }
    }
    S.doctab = "scene";
}

// Session: the recordings this game has made, and the one being played back.
// The lanes are the Animate timeline's over ticks instead of seconds, and
// clicking the ruler seeks — backwards by rebuilding and running to it again.
pub fn session_view(S, k) {
    ui::add_space(4);
    if !session::loaded(S) {
        session_list(S, k);
        return;
    }
    let split = replay::diverged();
    let first = S.session.first;
    let last = S.session.last;
    let span = util::max(1.0, util::f(last - first));
    let name_w = 120.0;
    let lane_w = util::max(120.0, ui::available_width() - name_w - 60.0);

    ui::horizontal(#{ height: 24 }, || {
        ui::add_space(8);
        ui::horizontal(#{ height: 24, width: name_w - 12.0 }, || {
            let playing = replay::state() == replay::STATE_PLAYING;
            if ui::pill(if playing { "⏸ Pause" } else { "▶ Play" }, #{
                height: 24, size: style::SM, strong: true,
                fill: k.accent_soft, color: k.accent,
            }) {
                session::toggle_pause(S);
            }
            if ui::pill("⇥", #{
                height: 24, size: style::SM, strong: true, tooltip: "One recorded tick forward",
                fill: k.sunken, color: k.dim,
            }) {
                session::step(S);
            }
            if ui::pill("■", #{
                height: 24, size: style::SM, strong: true, tooltip: "Back to the edited scene",
                fill: k.sunken, color: k.dim,
            }) {
                session::close(S);
                return;
            }
        });
        // Before the first frame is fed the position is one tick short of the
        // session's start, which is off the near end of the ruler.
        let at = util::max(0.0, util::f(replay::position()) - util::f(first));
        let (t, scrubbed) = ui::slider(at, 0.0, span, #{
            width: lane_w,
            rail: k.sunken, fill: k.accent_fill, knob: k.bg,
        });
        if scrubbed {
            session::seek(S, first + util::i(t));
        }
        ui::add_space(6);
        ui::label(format!("{} / {}", replay::position(), last), style::mono_sm(k.faint));
    });

    // A divergence is information, not a failure: the replay ran, and this is
    // the tick at which it stopped reproducing what was recorded.
    if split is Object {
        ui::horizontal(#{ height: 20 }, || {
            ui::add_space(8);
            ui::label(format!("parted from the recording at tick {}", split.tick),
                style::mono_sm(k.accent));
        });
    }

    ui::scroll("session-lanes", (), || {
        ui::spacing(4, 2);
        for lane in S.session.lanes {
            ui::horizontal(#{ height: 20 }, || {
                ui::add_space(8);
                ui::horizontal(#{ height: 20, width: name_w - 12.0 }, || {
                    ui::label(lane.name, style::mono_sm(k.dim));
                });
                lane_marks(S, k, lane, first, span, lane_w);
            });
        }
        detail(S, k);
    });
}

// One lane's dots, placed by tick. Drawn as a row of fixed-width slots rather
// than free-positioned marks, because the widget seam has no canvas.
fn lane_marks(S, k, lane, first, span, lane_w) {
    let slots = util::i(util::max(24.0, util::min(160.0, lane_w / 6.0)));
    let hits = [];
    for _ in 0..slots {
        hits.push(());
    }
    for mark in lane.marks {
        let at = util::f(mark.tick - first) / span;
        let i = util::i(util::clamp(at * util::f(slots - 1), 0.0, util::f(slots - 1)));
        hits[i] = mark;
    }
    let w = lane_w / util::f(slots);
    for (i, hit) in hits.iter().enumerate() {
        ui::horizontal(#{ height: 20, width: w }, || {
            if hit is Object {
                let behind = hit.tick <= replay::position();
                if ui::pill("", #{
                    height: 8, min_width: util::max(4.0, w - 2.0),
                    tooltip: format!("{}: {}", hit.tick, hit.label),
                    fill: if behind { k.accent } else { k.line }, color: k.dim,
                }) {
                    session::seek(S, hit.tick);
                }
            }
        });
    }
}

// Everything recorded at the tick the playhead is on, in the order it
// happened.
fn detail(S, k) {
    let at = S.session.at;
    let rows = util::vec(replay::events(at, at));
    if rows.len() == 0 {
        return;
    }
    ui::add_space(6);
    for e in rows {
        ui::horizontal(#{ height: 20 }, || {
            ui::add_space(8);
            ui::label(format!("{}", e.tick), style::mono_sm(k.faint));
            ui::label(e.kind, style::mono_sm(k.dim));
            ui::label(e.label, style::mono_sm(k.text));
        });
    }
}

// Every recording this game has made, newest first. "Keep" renames one out of
// the ring that prunes the oldest, so a session worth returning to survives
// the next ten runs.
fn session_list(S, k) {
    ui::horizontal(#{ height: 24 }, || {
        ui::add_space(8);
        ui::label("sessions are recorded on every play", style::mono_sm(k.faint));
        ui::right(|| {
            ui::add_space(8);
            let on = S.session.verify;
            if ui::pill("verify", #{
                height: 20, size: style::SM, strong: true,
                tooltip: "Hash the world every tick, so a replay can name where it parted",
                fill: if on { k.accent_fill } else { k.sunken },
                color: if on { k.on_accent } else { k.faint },
            }) {
                S.session.verify = !on;
            }
        });
    });
    let rows = session::listing(S);
    if rows.len() == 0 {
        style::empty(k, "no sessions yet — press Play");
        return;
    }
    ui::scroll("session-list", (), || {
        ui::spacing(4, 2);
        for r in rows {
            ui::horizontal(#{ height: 24 }, || {
                ui::add_space(8);
                if ui::pill("▶", #{
                    height: 20, size: style::SM, strong: true, tooltip: "Replay this session",
                    fill: k.accent_soft, color: k.accent,
                }) {
                    session::open(S, r.name);
                }
                let when = if r.started == "" { r.name } else { r.started };
                ui::label(when, style::mono_sm(k.text));
                ui::label(format!("{} ticks · {:.1}s", r.ticks, r.seconds),
                    style::mono_sm(k.faint));
                // How it ended, and whether its code has moved on since.
                if r.reason != "stop" {
                    ui::label(r.reason, style::mono_sm(k.accent));
                }
                if r.stale {
                    ui::label("scripts changed", style::mono_sm(k.accent));
                }
                ui::right(|| {
                    ui::add_space(8);
                    if ui::pill("delete", #{
                        height: 20, size: style::SM, strong: true,
                        fill: k.sunken, color: k.faint,
                    }) {
                        session::remove(S, r.name);
                    }
                    if ui::pill("export", #{
                        height: 20, size: style::SM, strong: true,
                        tooltip: "Copy into the project, for a bug report or `balaur replay`",
                        fill: k.sunken, color: k.dim,
                    }) {
                        session::export(S, r.name);
                    }
                    if !r.name.starts_with("kept-") && ui::pill("keep", #{
                        height: 20, size: style::SM, strong: true,
                        tooltip: "Never prune this one",
                        fill: k.sunken, color: k.dim,
                    }) {
                        session::keep(S, r.name);
                    }
                });
            });
        }
    });
}

// What one 60 Hz frame costs, as a bar per stage against that budget. The
// editor's own frame is what is measured while it is idle; press Play and it
// becomes the game's, which is the number anyone actually wants.
const BUDGET_MS = 16.667;

// Rune's `format!` takes a literal precision only, so a variable one is a
// match. Mirrors `inspector::fixed`, which is private to that module.
fn fixed(v, decimals) {
    match decimals {
        1 => format!("{:.1}", v),
        3 => format!("{:.3}", v),
        _ => format!("{:.2}", v),
    }
}

pub fn profiler(S, k) {
    // Live numbers: the panel asks for the next pass for as long as it is open.
    ui::request_repaint();
    let timings = engine::timings();
    if !(timings is Object) {
        style::empty(k, "no timings yet");
        return;
    }
    // The stages are the smaller half of a windowed frame: the mirror, the UI
    // pass and the render are named spans, and `wall` is what the loop took.
    let stage_ms = util::f(timings.frame) * 1000.0;
    let wall_ms = util::f(timings.wall) * 1000.0;
    let frame_ms = if wall_ms > 0.0 { wall_ms } else { stage_ms };
    ui::add_space(8);
    ui::horizontal((), || {
        ui::add_space(12);
        ui::label("FRAME", style::heading(k));
        ui::add_space(8);
        let over = frame_ms > BUDGET_MS;
        ui::label(
            format!("{} ms of {} ({} steps)", fixed(frame_ms, 2), fixed(BUDGET_MS, 1), timings.fixed_steps),
            style::mono(if over { k.accent } else { k.text }),
        );
        if over {
            ui::add_space(8);
            ui::label(format!("{} fps", fixed(1000.0 / frame_ms, 1)), style::mono_sm(k.accent));
        }
    });
    ui::add_space(6);
    ui::horizontal((), || {
        ui::add_space(12);
        let on = S.get("script_profiling").unwrap_or(false);
        if ui::pill("scripts", #{
            height: 24, size: style::SM, strong: true,
            tooltip: "Count what each script costs, in VM instructions",
            fill: if on { k.accent } else { k.sunken },
            color: if on { k.sunken } else { k.dim },
        }) {
            S.script_profiling = !on;
            engine::profile_scripts(!on);
        }
    });
    ui::add_space(6);
    let items = [];
    log_rows(items, k, util::obj(timings.stages), "stage");
    let spans = util::obj(timings.spans);
    if !spans.is_empty() {
        log_rows(items, k, spans, "span");
    }
    if show_log(items) {
        return;
    }
    ui::scroll("profiler", (), || {
        rows(k, util::obj(timings.stages), "stage");
        let spans = util::obj(timings.spans);
        if !spans.is_empty() {
            style::section_label(k, "named");
            rows(k, spans, "span");
        }
        if S.get("script_profiling").unwrap_or(false) {
            style::section_label(k, "scripts");
            script_rows(k);
        }
    });
}

/// What each script cost the last frame, dearest first.
///
/// Instructions rather than milliseconds: the same frame runs the same
/// instructions on every machine, so a number that moved is a change in what
/// a script does. Re-armed after reading, so a row is one frame's work.
fn script_rows(k) {
    let costs = engine::script_costs();
    if costs.is_empty() {
        ui::add_space(4);
        ui::horizontal(#{ height: 20 }, || {
            ui::add_space(12);
            ui::label("nothing ran this frame", style::mono_sm(k.dim));
        });
        engine::profile_scripts(true);
        return;
    }
    let worst = util::f(costs[0].instructions);
    for row in costs {
        let count = util::f(row.instructions);
        let share = if worst > 0.0 { util::clamp(count / worst, 0.0, 1.0) } else { 0.0 };
        ui::horizontal(#{ height: 20 }, || {
            ui::add_space(12);
            ui::horizontal(#{ height: 20, width: 132 }, || {
                ui::label(row.path, style::mono_sm(k.sage));
            });
            ui::horizontal(#{ height: 20, width: 68 }, || {
                ui::label(format!("{}", row.instructions), style::mono_sm(k.dim));
            });
            let width = util::max(1.0, share * 180.0);
            ui::frame(#{ fill: k.sage, radius: 3, padding_x: 0 }, || {
                ui::horizontal(#{ height: 8, width: width }, || {});
            });
        });
    }
    engine::profile_scripts(true);
}

// Worst first. A hand-written pass rather than a comparator: a float
// comparison in Rune answers with an Option, and the list is eight rows long.
fn by_cost(table) {
    let left = [];
    for (name, seconds) in table.iter() {
        left.push(#{ name: name, ms: util::f(seconds) * 1000.0 });
    }
    let out = [];
    while !left.is_empty() {
        // Indexed, not `left.iter()`: an iterator holds a read borrow until it
        // goes out of scope, and `remove` below needs to write.
        let worst = 0;
        let i = 1;
        while i < left.len() {
            if left[i].ms > left[worst].ms {
                worst = i;
            }
            i += 1;
        }
        out.push(left.remove(worst));
    }
    out
}

// One row per entry, worst first, with a bar as its share of the budget.
// The same rows as `rows`, as strings for the `list` node: a name, its cost
// and a bar drawn in blocks rather than a filled rect.
fn log_rows(items, k, table, kind) {
    for row in by_cost(table) {
        let share = util::clamp(row.ms / BUDGET_MS, 0.0, 1.0);
        let filled = util::i(share * 20.0);
        let bar = util::repeat("\u{2588}", filled) + util::repeat("\u{2591}", 20 - filled);
        let line = "\u{1f}";
        line += format!("{:<26}{:>9} ms  {}", row.name, fixed(row.ms, 3), bar);
        line += "\u{1f}\u{1f}";
        line += if row.ms > BUDGET_MS * 0.5 { k.accent } else if kind == "span" { k.sage } else { k.dim };
        items.push(line);
    }
}

fn rows(k, table, kind) {
    for row in by_cost(table) {
        let name = row.name;
        let ms = row.ms;
        let share = util::clamp(ms / BUDGET_MS, 0.0, 1.0);
        ui::horizontal(#{ height: 20 }, || {
            ui::add_space(12);
            ui::horizontal(#{ height: 20, width: 132 }, || {
                ui::label(name, style::mono_sm(if kind == "span" { k.sage } else { k.text }));
            });
            ui::horizontal(#{ height: 20, width: 68 }, || {
                ui::label(fixed(ms, 3) + " ms", style::mono_sm(k.dim));
            });
            // The bar is the point: a number needs reading, a bar does not.
            let width = util::max(1.0, share * 180.0);
            ui::frame(#{
                fill: if ms > BUDGET_MS * 0.5 { k.accent } else { k.sage },
                radius: 3, padding_x: 0,
            }, || {
                ui::horizontal(#{ height: 8, width: width }, || {});
            });
        });
    }
}



/// Bytes as the unit a person reads them in.
fn bytes(n) {
    if n < 1024.0 {
        return format!("{} B", n as i64);
    }
    if n < 1048576.0 {
        return fixed(n / 1024.0, 1) + " KB";
    }
    fixed(n / 1048576.0, 1) + " MB"
}

/// Rows sorted by one key, worst first. The same insertion pass `by_cost`
/// uses; a frame's node list is short and Rune's `sort` takes no comparator.
fn by_key(rows, key) {
    let left = [];
    for row in rows {
        left.push(row);
    }
    let out = [];
    while left.len() > 0 {
        let worst = 0;
        let i = 1;
        while i < left.len() {
            if util::f(left[i][key]) > util::f(left[worst][key]) {
                worst = i;
            }
            i += 1;
        }
        out.push(left.remove(worst));
    }
    out
}

/// What the frame draws, per node: the other half of the Profiler, beside the
/// milliseconds. `render.stats` counts it from the scene, so a headless run
/// reports the same triangles a windowed one does.
pub fn cost(S, k) {
    ui::request_repaint();
    let stats = util::obj(render::stats());
    ui::add_space(8);
    ui::horizontal((), || {
        ui::add_space(12);
        ui::label("FRAME", style::heading(k));
        ui::add_space(8);
        ui::label(format!("{} draws · {} triangles · {} in {} textures",
            util::i(stats.get("draws").unwrap_or(0)),
            util::i(stats.get("triangles").unwrap_or(0)),
            bytes(util::f(stats.get("texture_bytes").unwrap_or(0))),
            util::i(stats.get("textures").unwrap_or(0))),
            style::mono(k.text));
    });
    ui::add_space(4);
    ui::horizontal((), || {
        ui::add_space(12);
        ui::label(format!("pack · {}", pack_size(S)), style::mono_sm(k.faint));
    });
    ui::add_space(6);
    let nodes = util::vec(stats.get("nodes").unwrap_or([]));
    if nodes.len() == 0 {
        style::empty(k, "nothing is drawing");
        return;
    }
    let worst = util::f(by_key(nodes, "triangles")[0].triangles);
    let items = [];
    for row in by_key(nodes, "triangles") {
        let share = util::clamp(util::f(row.triangles) / util::max(worst, 1.0), 0.0, 1.0);
        let filled = util::i(share * 16.0);
        let bar = util::repeat("\u{2588}", filled) + util::repeat("\u{2591}", 16 - filled);
        let copies = util::i(row.copies);
        let mark = if copies > 1 { format!("x{}", copies) } else { "" };
        let line = "\u{1f}";
        line += format!("{:<22}{:>10} tri {:>9}  {}  {}",
            util::leaf(row.node), util::i(row.triangles),
            bytes(util::f(row.texture_bytes)), bar, mark);
        line += "\u{1f}\u{1f}" + k.dim;
        items.push(line);
    }
    if show_log(items) {
        return;
    }
    ui::scroll("cost", (), || {
        for row in by_key(nodes, "triangles") {
            let share = util::clamp(util::f(row.triangles) / util::max(worst, 1.0), 0.0, 1.0);
            ui::horizontal(#{ height: 20 }, || {
                ui::add_space(12);
                ui::horizontal(#{ height: 20, width: 150 }, || {
                    ui::label(util::leaf(row.node), style::mono_sm(k.text));
                });
                ui::horizontal(#{ height: 20, width: 76 }, || {
                    ui::label(format!("{} tri", util::i(row.triangles)), style::mono_sm(k.dim));
                });
                ui::horizontal(#{ height: 20, width: 62 }, || {
                    ui::label(bytes(util::f(row.texture_bytes)), style::mono_sm(k.dim));
                });
                let copies = util::i(row.copies);
                ui::horizontal(#{ height: 20, width: 46 }, || {
                    if copies > 1 {
                        ui::label(format!("x{}", copies), style::mono_sm(k.sage));
                    }
                });
                ui::frame(#{ fill: k.sage, radius: 3, padding_x: 0 }, || {
                    ui::horizontal(#{ height: 8, width: util::max(1.0, share * 150.0) }, || {});
                });
            });
        }
    });
}

/// How big the last export was, or a line saying none has been made. The
/// pack is what a player downloads, so it belongs beside the frame's cost.
fn pack_size(S) {
    let out = export::output("web");
    if !(out is String) || !fs::exists(out) {
        return "not exported yet";
    }
    let total = 0.0;
    for entry in util::vec(fs::list(out)) {
        if !entry.is_dir {
            total += 1.0;
        }
    }
    format!("{} file(s) at {}", total as i64, util::leaf(out))
}
