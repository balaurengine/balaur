// Showcase sequences: the clips the manual shows. Each is a frame-paced list
// of the calls the UI would make plus the input a person would feed, so a
// clip is retaken with `--state show:<name>` and nobody at the mouse.

use crate::anim;
use crate::history;
use crate::model;
use crate::session;
use crate::shell;
use crate::util;

// Where the node tree's first row sits and how tall a row is, in design px,
// so the pointer lands on the row it selects.
const TREE_TOP = 110.0;
const ROW = 27.0;

// How long the pointer takes to walk to a control, in frames. Long enough to
// read as a hand moving, short enough that a clip is not mostly travel.
const GLIDE = 22;

pub fn state() {
    ()
}

// Whether a fed button is held: the pointer is the game's then, and a gizmo
// reading the same snapshot would drag the selection along with it.
pub fn feeding(S) {
    S.showcase is Object && input::is_mouse_down(input::MOUSE_LEFT)
}

pub fn start(S, name) {
    let q = #{
        name: name, at: 0, kept: #{}, ptr: (0.0, 0.0),
        steps: [], spans: [], seen: 0,
        acts: [], spans_ui: [], seen_ui: 0,
    };
    match name {
        "scenes" => scenes(S, q),
        "scripting" => scripting(S, q),
        "animation" => animation(S, q),
        "physics" => physics(S, q),
        "input" => input_clip(S, q),
        "determinism" => determinism(S, q),
        "shaders" => shaders(S, q),
        _ => {
            log::warn(format!("show:{}: no such showcase", name));
            return;
        }
    }
    S.show_input = true;
    S.showcase = q;
    log::info(format!("showcase {}: {} steps, {} acts", name, q.steps.len() + q.spans.len(), q.acts.len() + q.spans_ui.len()));
}

// The update phase: input is fed here, before the game's own update reads
// the frame's snapshot. Steps fire on their frame; spans run every frame
// from `from` to `to` with their progress.
pub fn step(S) {
    let q = S.showcase;
    if !(q is Object) {
        return;
    }
    q.at = q.at + 1;
    q.seen = run_phase(q.steps, q.spans, q.seen, q.at);
}

// The UI phase, from `draw_ui`: what a click on the chrome would do runs
// here, after the game's update, as a click does.
pub fn draw(S) {
    let q = S.showcase;
    if !(q is Object) {
        return;
    }
    q.seen_ui = run_phase(q.acts, q.spans_ui, q.seen_ui, q.at);
}

// Everything due since this phase last ran, not only what is due exactly
// now: the first frame's UI pass never happens, and a step missed for being
// one frame early would take the rest of the sequence with it.
fn run_phase(steps, spans, seen, t) {
    for s in steps {
        if s.at > seen && s.at <= t {
            (s.run)();
        }
    }
    for sp in spans {
        if t >= sp.from && t <= sp.to {
            let p = ((t - sp.from) as f64) / ((sp.to - sp.from) as f64);
            (sp.run)(p);
        }
    }
    t
}

fn at(q, frame, run) {
    q.steps.push(#{ at: frame, run: run });
}

fn over(q, from, to, run) {
    q.spans.push(#{ from: from, to: to, run: run });
}

fn act(q, frame, run) {
    q.acts.push(#{ at: frame, run: run });
}

fn over_ui(q, from, to, run) {
    q.spans_ui.push(#{ from: from, to: to, run: run });
}

fn ease(p) {
    p * p * (3.0 - 2.0 * p)
}

fn lerp(a, b, p) {
    a + (b - a) * p
}

// Design px to the window px the snapshot holds. Where the pointer landed is
// kept on the sequence, because a glide has to know where it starts from.
fn feed_pointer(S, x, y) {
    let (_, _, _, _, _, _, _, dpi) = render::camera_pose();
    input::feed_mouse(x * S.ui_scale * dpi, y * S.ui_scale * dpi);
    if S.showcase is Object {
        S.showcase.ptr = (x, y);
    }
}

// The pointer walks to a place over `from`..`to` instead of appearing there.
// Where it starts is only known once the walk begins, so the span's first
// frame reads it and the rest interpolate.
fn glide(S, q, from, to, place) {
    let seg = #{ ready: false, x0: 0.0, y0: 0.0, x1: 0.0, y1: 0.0 };
    over(q, from, to, |p| {
        if !seg.ready {
            let (x1, y1) = (place)();
            let (x0, y0) = q.ptr;
            seg.ready = true;
            seg.x1 = x1;
            seg.y1 = y1;
            // Nothing has placed the pointer yet: start at the target rather
            // than sweeping in from the window's corner.
            let unplaced = x0 == 0.0 && y0 == 0.0;
            seg.x0 = if unplaced { x1 } else { x0 };
            seg.y0 = if unplaced { y1 } else { y0 };
        }
        let e = ease(p);
        feed_pointer(S, lerp(seg.x0, seg.x1, e), lerp(seg.y0, seg.y1, e));
    });
}

// A 2D world point in design px, through the camera the viewport draws with.
fn design_of_world(S, wx, wy) {
    let (cx, cy, zoom) = render::camera_2d();
    let sw = S.screen_w * S.ui_scale;
    let sh = S.screen_h * S.ui_scale;
    ((sw / 2.0 + (wx - cx) * zoom) / S.ui_scale, (sh / 2.0 - (wy - cy) * zoom) / S.ui_scale)
}

fn point_at_world(S, wx, wy) {
    let (x, y) = design_of_world(S, wx, wy);
    feed_pointer(S, x, y);
}

fn point_at_row(S, i) {
    feed_pointer(S, 110.0, TREE_TOP + (i as f64) * ROW);
}

// Where the selected node sits, in design px; its own place when it has none.
fn selection_spot(S) {
    let found = model::live(S, S.sel);
    match found {
        Some(node) => {
            let p = node.global_position();
            design_of_world(S, p.x, p.y)
        }
        None => S.showcase.ptr,
    }
}

fn point_at_selection(S) {
    let (x, y) = selection_spot(S);
    feed_pointer(S, x, y);
}

fn press(S) {
    input::feed_mouse_button(input::MOUSE_LEFT, true);
}

fn release(S) {
    input::feed_mouse_button(input::MOUSE_LEFT, false);
}

fn tap(q, frame, key) {
    at(q, frame, || input::feed_key(key, true));
    at(q, frame + 8, || input::feed_key(key, false));
}

// A chord held while `run` happens: the overlay names the keys, which is the
// only thing that explains a shortcut nobody can see being typed.
fn chord(S, q, frame, held, run) {
    at(q, frame, || {
        for key in held {
            input::feed_key(key, true);
        }
    });
    act(q, frame + 3, run);
    at(q, frame + 16, || {
        for key in held {
            input::feed_key(key, false);
        }
    });
}

// Where a control sits, in design px. Measured off the rendered editor: the
// showcase feeds the snapshot, and egui reads the window, so a click here is
// drawn rather than delivered — the sequence calls the verb itself.
fn spot(S, name) {
    let sw = S.screen_w;
    let sh = S.screen_h;
    match name {
        "scene_tab" => (136.0, 27.0),
        "script_tab" => (201.0, 27.0),
        "anim_tab" => (270.0, 27.0),
        "phys_tab" => (345.0, 27.0),
        "ui_tab" => (422.0, 27.0),
        "play" => (sw - 266.0, 27.0),
        "stop" => (sw - 198.0, 27.0),
        // The dock, when a session is loaded: its transport, and its ruler.
        "transport" => (296.0, sh - 181.0),
        "ruler" => (420.0, sh - 181.0),
        // The newest recording's play button in the session list.
        "session" => (283.0, sh - 156.0),
        "key" => (294.0, sh - 182.0),
        "bone_tool" => (281.0, 150.0),
        "doc_scene" => (358.0, 74.0),
        "doc_code" => (437.0, 74.0),
        "shader_field" => (1130.0, 601.0),
        "scale_x" => (1105.0, 231.0),
        _ => (sw / 2.0, sh / 2.0),
    }
}

fn row_spot(S, i) {
    (110.0, TREE_TOP + (i as f64) * ROW)
}

// The gutter of the code editor, by line. The pane starts under the document
// tabs and each line is one 12.5 px row.
fn gutter_spot(S, line) {
    (286.0, 112.0 + ((line - 1) as f64) * 12.44)
}

// A click a viewer can follow: the cursor walks in, presses where the control
// is, the verb runs under it, and the button comes back up.
fn click(S, q, frame, place, run) {
    glide(S, q, frame - GLIDE, frame, place);
    at(q, frame, || {
        let (x, y) = (place)();
        feed_pointer(S, x, y);
        press(S);
    });
    act(q, frame + 3, run);
    at(q, frame + 12, || release(S));
}

// Click a node's row in the tree, which is how a selection is made.
fn click_row(S, q, frame, name) {
    click(S, q, frame, || {
        match index_of(S, name) {
            Some(i) => row_spot(S, i),
            None => (110.0, TREE_TOP),
        }
    }, || choose(S, name));
}

fn index_of(S, name) {
    for (i, node) in S.doc.iter().enumerate() {
        if node.name == name {
            return Some(i);
        }
    }
    None
}

// Select a node the way a click on its row would.
fn choose(S, name) {
    let found = index_of(S, name);
    if let Some(i) = found {
        shell::choose(S, i);
    }
}

fn line_of(S, rel, needle) {
    let text = model::source(S, rel).unwrap_or("");
    let lines = text.split('\n').collect::<Vec>();
    for (i, line) in lines.iter().enumerate() {
        if line.contains(needle) {
            return i + 1;
        }
    }
    0
}

// Change the open buffer the way typing would; `save_active` writes it.
fn edit_source(S, rel, from, to) {
    let abs = S.game_root + "/" + rel;
    let current = match S.script_buffers.get(abs) {
        Some(text) => text,
        None => model::source(S, rel).unwrap_or(""),
    };
    let text = current.replace(from, to);
    ui::set_text("edit:" + abs, text);
    S.script_buffers[abs] = text;
    S.script_dirty[abs] = true;
}

// Put the file back as it was when the clip began.
fn restore_source(S, rel, q) {
    let abs = S.game_root + "/" + rel;
    let original = q.kept.get(rel).unwrap_or("");
    if original == "" {
        return;
    }
    ui::set_text("edit:" + abs, original);
    S.script_buffers[abs] = original;
    shell::save_active(S);
}

// The angrynerds level framed for the viewport: the game's own camera is set
// for a whole window, and the editor's panels cover its edges.
fn fit_level(S) {
    render::set_camera_2d(1.0, 2.2, 30.0);
}

// The slingshot: grab the bird, pull down and left, let go.
fn fling(S, q, from) {
    glide(S, q, from - GLIDE, from, || design_of_world(S, -8.0, 2.2));
    at(q, from + 10, || press(S));
    over(q, from + 10, from + 70, |p| {
        let e = ease(p);
        point_at_world(S, lerp(-8.0, -10.2, e), lerp(2.2, 1.3, e));
    });
    at(q, from + 80, || release(S));
}

fn open_newest(S) {
    let rows = session::listing(S);
    if rows.len() > 0 {
        session::open(S, rows[0].name);
    }
}

// Scenes and nodes, `examples/hello`: the tree, the inspector following the
// selection, an edit, and its undo.
fn scenes(S, q) {
    act(q, 1, || shell::set_persona(S, "scene"));
    click_row(S, q, 30, "Platform");
    click_row(S, q, 150, "Ball");
    click_row(S, q, 250, "Spinner");
    click_row(S, q, 350, "CrateB");
    click_row(S, q, 450, "Spinner");
    // A drag on the inspector's scale field, with the button held throughout.
    glide(S, q, 520 - GLIDE, 520, || spot(S, "scale_x"));
    at(q, 540, || {
        press(S);
        history::record(S, "scale Spinner", None);
    });
    over_ui(q, 540, 620, |p| {
        let s = lerp(1.0, 2.4, ease(p));
        model::set_transform(S, S.sel, #{ scale: [s, s, s] });
    });
    over(q, 540, 620, |p| {
        let (x, y) = spot(S, "scale_x");
        feed_pointer(S, x + 30.0 * ease(p), y);
    });
    at(q, 630, || release(S));
    chord(S, q, 700, ["LWin", "Z"], || shell::undo(S));
}

// Scripting, `examples/hello`: a change saved while the scene runs, then a
// breakpoint stepped in the Debugger dock.
fn scripting(S, q) {
    let rel = "scripts/spinner.rn";
    act(q, 1, || {
        q.kept[rel] = model::source(S, rel).unwrap_or("");
    });
    click(S, q, 30, || spot(S, "script_tab"), || shell::set_persona(S, "script"));
    click_row(S, q, 110, "Spinner");
    click(S, q, 200, || spot(S, "play"), || shell::toggle_play(S));
    // The edit lands on the line the cursor is resting on.
    glide(S, q, 300 - GLIDE, 300, || {
        let (x, y) = gutter_spot(S, line_of(S, rel, "this.angle += dt"));
        (x + 220.0, y)
    });
    act(q, 320, || edit_source(S, rel, "(this.speed + nudge", "(this.speed * 4.0 + nudge"));
    chord(S, q, 400, ["LWin", "S"], || shell::save_active(S));
    click(S, q, 520, || gutter_spot(S, line_of(S, rel, "let nudge")),
        || shell::toggle_breakpoint(S, rel, line_of(S, rel, "let nudge")));
    chord(S, q, 640, ["F10"], || {
        if S.debug.paused is Object {
            shell::resume(S, debugger::STEP_OVER);
        }
    });
    chord(S, q, 720, ["F10"], || {
        if S.debug.paused is Object {
            shell::resume(S, debugger::STEP_OVER);
        }
    });
    act(q, 800, || {
        shell::toggle_breakpoint(S, rel, line_of(S, rel, "let nudge"));
        if S.debug.paused is Object {
            shell::resume(S, debugger::CONTINUE);
        }
    });
    act(q, 860, || restore_source(S, rel, q));
}

// The rig scene carries a `camera` node, which outvotes the editor's own
// zoom every frame, so the clip's framing is that node's.
fn fit_figure(S) {
    let held = S.sel;
    match index_of(S, "Camera") {
        Some(i) => {
            S.sel = i;
            model::set_transform(S, i, #{ position: [0.6, 0.1, 0.0] });
            model::set_component_prop(S, "camera", "zoom", 150.0);
        }
        None => (),
    }
    S.sel = held;
}

// Animation, `examples/rig`: scrub the clip, pose the thigh, key it, play.
fn animation(S, q) {
    act(q, 1, || fit_figure(S));
    click(S, q, 20, || spot(S, "anim_tab"), || shell::set_persona(S, "anim"));
    click_row(S, q, 90, "Thigh");
    click(S, q, 150, || spot(S, "bone_tool"), || {
        S.tool = "bone";
    });
    over_ui(q, 200, 340, |p| anim::seek(S, 2.0 * ease(p)));
    act(q, 380, || anim::seek(S, 1.0));
    // Drag the bone itself: the cursor sits on it while it turns.
    glide(S, q, 430 - GLIDE, 430, || selection_spot(S));
    at(q, 430, || press(S));
    act(q, 434, || history::record(S, "pose Thigh", None));
    over_ui(q, 434, 520, |p| {
        model::set_transform(S, S.sel, #{ rotation_euler: [0.0, 0.0, lerp(0.5, 0.95, ease(p))] });
    });
    over(q, 434, 520, |p| point_at_selection(S));
    at(q, 530, || release(S));
    click(S, q, 600, || spot(S, "key"), || anim::add_key(S, S.anim.time));
    click(S, q, 700, || spot(S, "play"), || shell::toggle_play(S));
}

// Physics, `examples/angrynerds`: the collider overlays, then play and a
// shot at the towers.
fn physics(S, q) {
    click(S, q, 20, || spot(S, "phys_tab"), || {
        shell::set_persona(S, "phys");
        shell::set_zoom(S, 45.0);
    });
    click_row(S, q, 80, "Bird");
    click(S, q, 150, || spot(S, "play"), || shell::toggle_play(S));
    act(q, 160, || fit_level(S));
    fling(S, q, 220);
}

// Input, `examples/hello`: the overlay, fed the keys and clicks a person
// would press.
fn input_clip(S, q) {
    act(q, 1, || shell::set_persona(S, "scene"));
    click_row(S, q, 30, "Spinner");
    click(S, q, 110, || spot(S, "play"), || shell::toggle_play(S));
    tap(q, 200, "Space");
    at(q, 260, || input::feed_key("A", true));
    at(q, 340, || input::feed_key("A", false));
    at(q, 370, || input::feed_key("D", true));
    at(q, 450, || input::feed_key("D", false));
    glide(S, q, 470 - GLIDE, 470, || {
        let v = S.viewport;
        (util::f(v.x) + util::f(v.w) * 0.3, util::f(v.y) + util::f(v.h) * 0.6)
    });
    over(q, 470, 520, |p| {
        let v = S.viewport;
        let e = ease(p);
        feed_pointer(S, util::f(v.x) + util::f(v.w) * lerp(0.3, 0.55, e),
            util::f(v.y) + util::f(v.h) * lerp(0.6, 0.45, e));
    });
    at(q, 530, || press(S));
    at(q, 545, || release(S));
    tap(q, 600, "Space");
    at(q, 650, || {
        input::feed_key("LShift", true);
        input::feed_key("W", true);
    });
    at(q, 710, || {
        input::feed_key("LShift", false);
        input::feed_key("W", false);
    });
}

// Determinism, `examples/angrynerds`: play records, the bird flies, stop;
// open the session and it flies again with nobody at the mouse; scrub back,
// pause, play on.
fn determinism(S, q) {
    act(q, 1, || {
        shell::set_persona(S, "scene");
        shell::set_zoom(S, 45.0);
        S.session.verify = true;
        S.dock = "session";
    });
    click_row(S, q, 40, "Bird");
    click(S, q, 120, || spot(S, "play"), || {
        shell::toggle_play(S);
        S.dock = "session";
    });
    act(q, 130, || fit_level(S));
    fling(S, q, 200);
    click(S, q, 520, || spot(S, "stop"), || {
        shell::stop_play(S);
        S.dock = "session";
    });
    click(S, q, 640, || spot(S, "session"), || open_newest(S));
    act(q, 650, || fit_level(S));
    // Scrub the ruler back: the cursor walks it, and the seek lands on release.
    glide(S, q, 1000 - GLIDE, 1000, || {
        let (x, y) = spot(S, "ruler");
        (x + 420.0, y)
    });
    at(q, 1000, || press(S));
    over(q, 1000, 1080, |p| {
        let (x, y) = spot(S, "ruler");
        feed_pointer(S, x + 420.0 - 400.0 * ease(p), y);
    });
    act(q, 1080, || {
        session::seek(S, S.session.first + 10);
        fit_level(S);
    });
    at(q, 1090, || release(S));
    click(S, q, 1300, || spot(S, "transport"), || session::toggle_pause(S));
    click(S, q, 1420, || spot(S, "transport"), || session::toggle_pause(S));
}

// On until the 2D material pipeline binds the preview's probe.
const PREVIEW = true;

fn preview(S, rel, needle) {
    let line = line_of(S, rel, needle);
    if PREVIEW && line > 0 {
        shell::toggle_shader_preview(S, rel, line);
    }
}

// One value preview: click the line in the gutter, hold on the marked line,
// then show the viewport drawing it.
fn preview_step(S, q, frame, rel, needle) {
    click(S, q, frame, || gutter_spot(S, line_of(S, rel, needle)),
        || preview(S, rel, needle));
    click(S, q, frame + 90, || spot(S, "doc_scene"), || {
        S.doctab = "scene";
    });
    click(S, q, frame + 220, || spot(S, "doc_code"), || {
        S.doctab = "script";
    });
}

// Shaders, `examples/shaders`: the material in the inspector, its shader in
// the code editor, what three of its lines compute, a channel view, and a
// save that relinks the sprite.
fn shaders(S, q) {
    let rel = "shaders/glow.wesl";
    act(q, 1, || {
        shell::set_persona(S, "scene");
        // The dock names each previewed line and its type as it is asked for.
        S.dock = "output";
        q.kept[rel] = model::source(S, rel).unwrap_or("");
    });
    click_row(S, q, 40, "Logo");
    click(S, q, 150, || spot(S, "shader_field"), || {
        S.shader_rel = rel;
        S.doctab = "script";
    });
    preview_step(S, q, 260, rel, "let uv");
    preview_step(S, q, 560, rel, "let wave");
    preview_step(S, q, 860, rel, "let ramp");
    act(q, 1150, || {
        if S.preview_line > 0 {
            shell::toggle_shader_preview(S, rel, S.preview_line);
        }
        S.doctab = "scene";
        render::set_channel("uv");
    });
    act(q, 1260, || render::set_channel(""));
    act(q, 1300, || {
        S.doctab = "script";
        edit_source(S, rel, "dist * params.rings", "dist * params.rings * 3.0");
    });
    chord(S, q, 1360, ["LWin", "S"], || shell::save_active(S));
    click(S, q, 1420, || spot(S, "doc_scene"), || {
        S.doctab = "scene";
    });
    act(q, 1600, || {
        S.doctab = "script";
        restore_source(S, rel, q);
    });
}
