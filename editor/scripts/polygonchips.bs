//! The Polygon tool's chips in the viewport's strip: one per mode, then the
//! mode's own settings.

use editor;
use polygon;
use signals;
use util;
use words::project_fields;
use words::tabs;

const CHIP_SCENE: str = "scenes/items/chip.toml";

// The settings' fields in the strip's Options row, by name.
const BONE: str = "Bone";

const RADIUS: str = "Radius";

const STRENGTH: str = "Strength";

const TOLERANCE: str = "Tolerance";

/// The modes as chips under `modes`, then the mode's own settings under
/// `options`: the trace's tolerance for the points, and in weights the bone
/// painted and the brush. Tool state, never a property, so never the
/// Inspector's. Both hide unless `shown`.
pub fn fill(state: editor::State, modes: Node, options: Node, shown: bool) {
    let ids: [str] = if shown { polygon::modes(state) } else { [] };
    let items: [scene::RepeatItem] = [];
    for id in ids {
        items.push(scene::RepeatItem { key: id, scene: CHIP_SCENE });
    }
    let nodes = scene::repeat(modes, items);
    for index in 0..ids.len() {
        nodes[index].widget.text = polygon::mode_name(ids[index]);
        nodes[index].widget_check.checked = state.polygon.mode == ids[index];
    }
    modes.set_visible(shown);
    let weights = shown && state.polygon.mode == tabs::WEIGHTS;
    let points = shown && state.polygon.mode == polygon::POINTS;
    let names = bone_names(state);
    let bone = options.get_node(BONE);
    bone.set_visible(weights && names.len() > 0);
    if weights && names.len() > 0 {
        let active = if state.polygon.bone != nil { state.polygon.bone.unwrap() } else { 0 };
        bone.widget_dropdown.options = names;
        bone.widget.text = names[util::int_min(active, names.len() - 1)];
    }
    field(options.get_node(RADIUS), weights, state.polygon.radius);
    field(options.get_node(STRENGTH), weights, state.polygon.strength);
    field(options.get_node(TOLERANCE), points, state.polygon.tolerance);
    options.set_visible(weights || points);
}

fn field(node: Node, shown: bool, value: float) {
    node.set_visible(shown);
    if shown {
        node.widget_range.value = value;
    }
}

fn bone_names(state: editor::State) -> [str] {
    let names: [str] = [];
    for bone in polygon::bones(state) {
        names.push(bone[project_fields::PATH].as_str());
    }
    names
}

/// One of the settings' fields moved, by its name.
pub fn option_changed(state: &mut editor::State, name: str, value: any) {
    if name == BONE {
        let names = bone_names(state);
        for at in 0..names.len() {
            if names[at] == value.as_str() {
                state.polygon.bone = at;
            }
        }
    } else if name == RADIUS {
        state.polygon.radius = value.as_float();
    } else if name == STRENGTH {
        state.polygon.strength = value.as_float();
    } else if name == TOLERANCE {
        state.polygon.tolerance = value.as_float();
    }
    signals::bars(state);
}
