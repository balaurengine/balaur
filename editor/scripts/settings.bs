// The settings screen: every setting the engine, its plugins and this game
// declare, grouped by the first segment of its path and searchable by any.

use editor;
use pool;
use search;
use shell;
use signals;
use style;
use theme;
use themewin;
use util;
use window;
use words::changes;
use words::datatypes;
use words::fields;
use words::general;
use words::layout_fields;
use words::project_fields;
use words::roles;
use words::schema_fields;
use words::verbs;

const EDITOR: str = "editor";
const PROJECT: str = "project";

pub class SettingsState {
    at: str,
    internal dirty: bool,
    internal compact: bool,
    internal demo: int,
    internal target: str,
}

// The search field this screen filters with; `crate::search` keys its own
// buffer by the same id.
const FIELD: str = "settings";

pub fn state() -> SettingsState {
    SettingsState {
        // The category showing, "" until the first is picked.
        at: "",
        dirty: false,
        // What `editor/appearance/compact` asks for, which the window width
        // can only add to.
        compact: false,
        // Where `--state settingsdemo` has got to; -1 when it is not running.
        demo: -1,
        // The tag the header offers an override for, "" for none: one choice
        // for the page, as Godot's "Override For", not a picker per row.
        target: "",
    }
}

// The search box's own buffer is the query: typing in it and a deep link
// write the same text. Non-empty means the list is results, not categories.
fn set_query(state: &mut editor::State, text: str) {
    search::typed(state, FIELD, text);
}

pub fn query(state: editor::State) -> str {
    search::query(state, FIELD)
}

// Open on a search, for a screenshot or a "configure this" link that knows
// the word but not the page.
pub fn open_search(state: &mut editor::State, query: str) {
    open(state);
    set_query(state, query);
}

// Open at a named category, for a screenshot or a deep link from a dock.
pub fn open_at(state: &mut editor::State, category: str) {
    open(state);
    state.settings.at = category;
}

pub fn open(state: &mut editor::State) {
    window::show(state, verbs::SETTINGS);
    load_files(state);
}

/// Read both settings files and apply what the editor acts on. Called at boot
/// and again when the window opens, so a hand edit between the two is not
/// silently reverted on the next write.
pub fn load_files(state: &mut editor::State) {
    // With no project open there is no manifest to read: a relative path off
    // an empty root is a path outside every root there is.
    if state.game_root != "" {
        let manifest = fs::read(state.game_root + "/project.toml");
        if manifest != nil {
            settings::merge_toml(manifest.unwrap());
        }
    }
    let preferences = fs::read(preferences_path());
    if preferences != nil {
        settings::merge_toml(preferences.unwrap());
    }
    apply(state);
}

// The editor's own settings are the person's, in the folder every project shares.
pub fn preferences_path() -> str {
    project::editor_data_directory() + "/editor.toml"
}

// Categories in definition order, project first: a game author looks for what
// ships far more often than for what does not.
fn categories() -> [str] {
    let all = settings::all();
    let seen: [str] = [];
    for scope in [PROJECT, EDITOR] {
        for setting in all {
            if setting.scope == scope && !util::contains(seen, setting.category) {
                seen.push(setting.category);
            }
        }
    }
    seen
}

// Where each category is listed: one with anything that ships is a project
// one, and its editor-only rows follow under their own heading.
fn scopes() -> any {
    let out: any = {};
    for setting in settings::all() {
        if setting.scope == PROJECT || !out.has(setting.category) {
            out[setting.category] = setting.scope;
        }
    }
    out
}

fn scope_of(category: str) -> str {
    let found = scopes()[category];
    if found == nil { PROJECT } else { found.as_str() }
}

fn current(state: editor::State) -> str {
    let all = categories();
    if all.len() == 0 {
        return "";
    }
    if util::contains(all, state.settings.at) {
        return state.settings.at;
    }
    all[0]
}

// What the list shows: the search results when there is a query, otherwise
// everything in the chosen category, project rows first and each in the
// order it asks for.
fn showing(state: editor::State) -> [settings::Setting] {
    let query = query(state).to_lower();
    let at = current(state);
    let rows: [settings::Setting] = [];
    for setting in settings::all() {
        let matches = if query == "" {
            setting.category == at
        } else {
            // The path and the help both, so "packet" finds `multiplayer/loss`
            // by its sentence when its name does not say it.
            setting.path.to_lower().contains(query) || setting.spec[fields::HELP].as_str().to_lower().contains(query)
        };
        if matches {
            // Slid in after every row that ranks the same or before, so equal
            // ranks keep their definition order.
            let at_rank = 0;
            while at_rank < rows.len() && rank_of(rows[at_rank]) <= rank_of(setting) {
                at_rank += 1;
            }
            rows.insert(at_rank, setting);
        }
    }
    rows
}

// Project rows before editor ones, each in the order it asks for.
fn rank_of(setting: settings::Setting) -> float {
    let tail = if setting.scope == EDITOR { 100000.0 } else { 0.0 };
    tail + order_of(setting)
}

fn order_of(setting: settings::Setting) -> float {
    let order = setting.spec[fields::ORDER];
    if order == nil { 1000.0 } else { order.as_float() }
}

// `editor/appearance/theme` groups under "appearance"; `physics/gravity`
// under nothing, since there is nothing between its category and its key.
fn group_of(setting: settings::Setting) -> str {
    let parts = setting.label.split("/");
    if parts.len() < 2 { "" } else { parts[0] }
}

// The last segment: what a row is labelled inside its group.
fn key_of(setting: settings::Setting) -> str {
    util::leaf(setting.path)
}

// Write both files. Only the paths a scope defines are touched, so a comment
// or an unrelated table in project.toml survives.
pub fn commit(state: &mut editor::State) {
    commit_project(state);
    commit_preferences(state);
    state.settings.dirty = false;
}

/// The game's half alone: what a choice made outside this screen saves.
pub fn commit_project(state: editor::State) {
    let path = state.game_root + "/project.toml";
    fs::write(path, settings::to_toml(PROJECT, fs::read(path).or("")));
}

/// The editor's half alone: what a self-test can round-trip without rewriting
/// the game's manifest.
pub fn commit_preferences(state: editor::State) {
    fs::write(preferences_path(), settings::to_toml(EDITOR, fs::read(preferences_path()).or("")));
}

// Under this the list of categories goes above the rows rather than beside
// them: two columns of 190 and a row's own controls do not fit a phone.
const STACK_BELOW: float = 520.0;

// The sidebar's own column, and the air between it and the rows. A row that
// measured the whole sheet wrapped its help under the sidebar and ran past
// the sheet's edge.
const SIDEBAR_WIDTH: float = 190.0;

const SIDEBAR_GAP: float = 20.0;

/// What a settings row has across it: the sheet, less the sidebar where one
/// is beside it.
fn row_width(state: editor::State) -> float {
    let inner = window::inner_width(state);
    if ui::window_size().x < STACK_BELOW {
        return inner;
    }
    util::max(inner - SIDEBAR_WIDTH - SIDEBAR_GAP, 160.0)
}

/// Fill the sheet: what its script asks for when Settings is up.
pub fn fill(state: &mut editor::State) {
    let tokens = state.theme;
    let stacked = ui::window_size().x < STACK_BELOW;
    let found = window::sheet_form(state, verbs::SETTINGS, "Settings", save_button(state));
    if found == nil {
        return;
    }
    let hosts = found.unwrap();
    // Narrow, the categories go above the rows rather than beside them: a
    // sidebar and a column of settings leave neither enough room.
    ui::fill_strip(hosts.side_rows, if stacked { [] } else { side_controls(state, tokens) });
    util::set_visible(hosts.side, !stacked);
    let label_width = label_column_width(state);
    let specs = form_specs(state, tokens);
    if stacked {
        specs.insert(0, picker_spec(state));
    }
    ui::fill_rows(hosts.form, specs, label_width, stacked);
}

/// The label column a settings row keeps, and the picker a narrow sheet
/// shows in place of its sidebar.
fn label_column_width(state: editor::State) -> float {
    util::clamp(row_width(state) * 0.42, 120.0, 260.0)
}

fn picker_spec(state: editor::State) -> ui::Row {
    let picker: ui::Control = ui::Control {
        kind: ui::WIDGET_DROPDOWN,
        role: roles::CHOICE_FORM,
        grow: 1,
        text: current(state),
        options: categories(),
    };
    ui::Row { height: style::row_height(state), controls: [pool::on(picker, on_category_picked, {})] }
}

fn on_category_picked(state: &mut editor::State, data: any, picked: any) {
    set_query(state, "");
    state.settings.at = picked.as_str();
}

// Save, beside the close, while there is something to save.
fn save_button(state: editor::State) -> [ui::Control] {
    if !state.settings.dirty {
        return [];
    }
    let save: [ui::Control] = [
        ui::Control {
            kind: ui::WIDGET_BUTTON,
            role: roles::ACTION_FORM_PRIMARY,
            text: "Save",
            on_click: "handle",
            data: { fields::FN: on_save_clicked },
        },
    ];
    save
}

fn on_save_clicked(state: &mut editor::State, data: any, _value: any) {
    commit(state);
}

/// The column down the left: the search box, and a row per category under
/// the scope it belongs to.
fn side_controls(state: editor::State, tokens: any) -> [ui::Control] {
    let out = [search::control(state, FIELD, "Search", SIDEBAR_WIDTH)];
    let scope = "";
    let at = current(state);
    let scopes = scopes();
    for name in categories() {
        // Bound afresh: a closure made in a loop captures the binding.
        let category = name;
        let held = scopes[category];
        let here = if held == nil { PROJECT } else { held.as_str() };
        if here != scope {
            scope = here;
            out.push(ui::Control {
                kind: ui::WIDGET_LABEL,
                role: roles::TEXT_CAPTION,
                text: if scope == PROJECT { "PROJECT" } else { "THIS EDITOR" },
            });
        }
        let on = query(state) == "" && category == at;
        out.push(ui::Control {
            kind: ui::WIDGET_BUTTON,
            text: category,
            role: roles::ITEM_SIDEBAR,
            checked: on,
            on_click: "handle",
            data: { fields::FN: on_category_clicked, fields::CATEGORY: category },
        });
    }
    out
}

fn on_category_clicked(state: &mut editor::State, data: any, _value: any) {
    let category: any = data[fields::CATEGORY];
    set_query(state, "");
    state.settings.at = category.as_str();
}

/// Every row the form shows: a note at its head, a heading per group, and a
/// row per setting with its help under it.
fn form_specs(state: editor::State, tokens: any) -> [ui::Row] {
    let rows = showing(state);
    let out: [ui::Row] = [];
    let row_height = style::row_height(state);
    if query(state) != "" {
        out.push(note_spec("{rows.len()} matching \"{query(state)}\""));
    } else if scope_of(current(state)) == PROJECT {
        out.push(ui::Row {
            height: 34,
            controls: [
                ui::Control {
                    kind: ui::WIDGET_LABEL,
                    role: roles::TEXT_CAPTION,
                    grow: 1,
                    text: "Written to project.toml, and shipped with the game.",
                },
                target_control(state),
            ],
            slot_role: roles::LAYOUT_ACTIONS,
        });
    } else {
        out.push(note_spec("Kept in this editor only, and never written to the project."));
    }
    if rows.len() == 0 {
        out.push(note_spec(search::nothing_says(query(state))));
        return out;
    }
    // Grouped by the middle of the path, in the order the first setting of
    // each group asks for. A search result skips the headings: its rows show
    // whole paths, and a heading would say the same thing.
    let searching = query(state) != "";
    let group = "";
    let scope = scope_of(current(state));
    for setting in rows {
        if !searching && setting.scope != scope {
            scope = setting.scope;
            group = "";
            out.push(head_spec("THIS EDITOR"));
        }
        let here = group_of(setting);
        if !searching && here != group {
            group = here;
            if group != "" {
                out.push(head_spec(group.to_upper()));
            }
        }
        let path = setting.path;
        let controls = [editor_control(state, setting, path)];
        if path == theme::SETTING {
            controls.push(ui::Control {
                kind: ui::WIDGET_BUTTON,
                role: roles::ACTION_FORM_PRIMARY,
                text: "Edit…",
                tooltip: "Open the Theme dialog",
                on_click: "handle",
                data: { fields::FN: on_theme_edit_clicked },
            });
        }
        out.push(ui::Row {
            height: row_height,
            controls: controls,
            slot_role: roles::LAYOUT_ACTIONS,
            label: if searching { path } else { key_of(setting) },
        });
        let help = setting.spec[fields::HELP].as_str();
        if help != "" {
            let tail = if setting.applies_now { "" } else { "  ·  takes effect on the next run" };
            out.push(note_spec(help + tail));
        }
        for on in settings::overrides(path) {
            let at = override_path(on, path);
            out.push(ui::Row {
                height: row_height,
                controls: [
                    editor_control(state, setting, at),
                    ui::Control {
                        kind: ui::WIDGET_BUTTON,
                        role: roles::CHIP_QUIET,
                        text: "×",
                        tooltip: "Reset this override",
                        on_click: "handle",
                        data: { fields::FN: on_override_reset_clicked, layout_fields::AT: at },
                    },
                ],
                slot_role: roles::LAYOUT_ACTIONS,
                label: "  on " + on,
            });
        }
    }
    out
}

fn on_theme_edit_clicked(state: &mut editor::State, data: any, _value: any) {
    themewin::open(state);
}

fn on_override_reset_clicked(state: &mut editor::State, data: any, _value: any) {
    settings::clear(data[layout_fields::AT].as_str());
    state.settings.dirty = true;
}

/// A line of prose across both columns, and a group's heading.
fn note_spec(text: str) -> ui::Row {
    ui::Row {
        height: 0,
        controls: [
            ui::Control {
                kind: ui::WIDGET_LABEL,
                role: roles::TEXT_CAPTION,
                grow: 1,
                wrap: true,
                text: text,
            },
        ],
    }
}

fn head_spec(text: str) -> ui::Row {
    ui::Row {
        height: 24,
        controls: [
            ui::Control {
                kind: ui::WIDGET_LABEL,
                role: roles::TEXT_CAPTION,
                grow: 1,
                text: text,
            },
        ],
    }
}

// The page's one override choice. The dropdown draws what it is handed, so the
// prompt is its own text until a tag is picked.
/// Which override a project setting is written to, or none.
fn target_control(state: editor::State) -> ui::Control {
    let options = ["none"];
    for tag in settings::known_tags() {
        options.push(tag);
    }
    ui::Control {
        kind: ui::WIDGET_DROPDOWN,
        role: roles::CHOICE_FORM,
        width: 170,
        text: if state.settings.target == "" { "override for…" } else { "override for " + state.settings.target },
        options: options,
        on_change: "handle",
        data: { fields::FN: on_override_target_picked },
    }
}

fn on_override_target_picked(state: &mut editor::State, data: any, picked: any) {
    state.settings.target = if picked.as_str() == general::NONE { "" } else { picked.as_str() };
}

fn override_path(tag: str, path: str) -> str {
    "override/" + tag + "/" + path
}

// `base`, never `get`: the editor edits what the file says. A screen showing
// the override this machine happened to match would write it onto the key it
// overrides.
/// The control one setting's row carries, by the schema's datatype.
fn editor_control(state: editor::State, setting: settings::Setting, path: str) -> ui::Control {
    let spec = util::map_or_empty(setting.spec);
    let datatype = if spec[fields::TYPE] == nil { datatypes::STRING } else { spec[fields::TYPE].as_str() };
    let value = settings::base(path);
    if datatype == datatypes::BOOL {
        return ui::Control {
            kind: ui::WIDGET_SWITCH,
            role: roles::SWITCH_FORM,
            checked: value.as_bool(),
            on_change: "handle",
            data: { fields::FN: on_switch_toggled, project_fields::PATH: path },
        };
    }
    if datatype == datatypes::ENUM {
        // The person's own themes are folders, so the list is read, not declared.
        let named = path == theme::SETTING;
        return ui::Control {
            kind: ui::WIDGET_DROPDOWN,
            role: roles::CHOICE_FORM,
            grow: 1,
            text: if value.kind() == types::KIND_STRING { value.as_str() } else { "" },
            options: if named { theme::names() } else { util::list_or_empty(spec[schema_fields::OPTIONS]) },
            on_change: "handle",
            data: { fields::FN: on_choice_picked, project_fields::PATH: path },
        };
    }
    if datatype == datatypes::INT || datatype == datatypes::FLOAT {
        let low = spec[schema_fields::MIN].as_float();
        let high = if spec[schema_fields::MAX] != nil { spec[schema_fields::MAX].as_float() } else if datatype == datatypes::INT { 1000000.0 } else { 1.0 };
        // A setting declared with no default reads as nil; the control starts
        // at its floor instead.
        let now = if value == nil { low } else { value.as_float() };
        let whole = datatype == datatypes::INT;
        return ui::Control {
            kind: ui::WIDGET_NUMBER_FIELD,
            role: roles::INPUT_NUMBER,
            grow: 1,
            value: now,
            min: low,
            max: high,
            drag_speed: if whole { 1.0 } else { 0.01 },
            on_change: "handle",
            data: { fields::FN: on_number_changed, project_fields::PATH: path, layout_fields::WHOLE: whole },
        };
    }
    // Everything else reads and writes as text, a comma-separated list
    // included: a row of its own per entry would be a page per setting.
    let shown = if datatype == datatypes::LIST {
        commas(value)
    } else if value.kind() == types::KIND_STRING {
        value.as_str()
    } else if value == nil {
        ""
    } else {
        "{value}"
    };
    ui::Control {
        kind: ui::WIDGET_TEXT_FIELD,
        role: roles::INPUT_FORM,
        grow: 1,
        text: shown,
        secret: spec["secret"].as_bool(),
        on_submit: "handle_submit",
        data: { project_fields::SUBMIT: on_text_submitted, project_fields::PATH: path, schema_fields::DATATYPE: datatype },
    }
}

fn on_switch_toggled(state: &mut editor::State, data: any, on: any) {
    write(state, data[project_fields::PATH].as_str(), on);
}

fn on_choice_picked(state: &mut editor::State, data: any, picked: any) {
    write(state, data[project_fields::PATH].as_str(), picked);
}

fn on_number_changed(state: &mut editor::State, data: any, value: any) {
    if data[layout_fields::WHOLE].as_bool() {
        write(state, data[project_fields::PATH].as_str(), math::round(value.as_float()) as int);
    } else {
        write(state, data[project_fields::PATH].as_str(), value);
    }
}

fn on_text_submitted(state: &mut editor::State, data: any, text: any) {
    if data[schema_fields::DATATYPE].as_str() == datatypes::LIST {
        write(state, data[project_fields::PATH].as_str(), split_commas(text.as_str()));
    } else {
        write(state, data[project_fields::PATH].as_str(), text);
    }
}

// A list as one line, and back.
fn commas(value: any) -> str {
    let out = "";
    for item in util::list_or_empty(value) {
        if out != "" {
            out += ", ";
        }
        out += "{item}";
    }
    out
}

fn split_commas(text: str) -> [str] {
    let out: [str] = [];
    for part in text.split(",") {
        let item = part.trim();
        if item != "" {
            out.push(item);
        }
    }
    out
}

pub fn write(state: &mut editor::State, path: str, value: any) {
    settings::set(path, value);
    state.settings.dirty = true;
    apply(state);
    window::changed(state);
}

// Editor settings take effect as they change, not on save: a theme you have
// to save to see is a theme you cannot preview.
pub fn apply(state: &mut editor::State) {
    let theme_name = settings::get(theme::SETTING);
    if theme_name.kind() == types::KIND_STRING {
        theme::use_named(state, theme_name.as_str());
    }
    let scale = settings::get("editor/appearance/ui_scale");
    if !(scale == nil) {
        shell::ask_ui_scale(state, scale.as_float());
    }
    // Kept apart from `state.compact`, which the window width also writes: the
    // setting forces compact on, it never forces it off.
    let compact = settings::get("editor/appearance/compact");
    if compact.kind() == types::KIND_BOOL {
        state.settings.compact = compact.as_bool();
    }
    let verify = settings::get("editor/recordings/verify");
    if verify.kind() == types::KIND_BOOL {
        state.session.verify = verify.as_bool();
        signals::changed(state, changes::RECORDINGS);
    }
}
