//! A form: rows of a label beside, or above, the controls it names. A row is
//! plain controls, which `strip` puts on a host as item scenes, one a control,
//! each written by `ui::write`; `slot_at` keeps the few rows of a long form on
//! screen. Under the host, a row's label is `C<row>/C0` and its controls
//! `C<row>/C1/C<n>`.

use editor;
use util;
use words::fields;
use words::hooks;
use words::project_fields;
use words::roles;

/// One row: its `label` and `controls`, with no label across both columns;
/// `height`, which hugs what is in it unless stated; `tooltip`; the roles
/// that dress the label and the control column; and `y`, the height it sits
/// at in a host laid out by hand.
pub class Row {
    internal label: str?,
    internal controls: [ui::Control],
    internal height: float?,
    internal tooltip: str?,
    internal label_role: str?,
    internal slot_role: str?,
    internal y: float?,
}

const DEFAULT_HEIGHT: float = 0.0;

const CONTROL_SCENE: str = "scenes/items/control.toml";

const GROUP_SCENE: str = "scenes/items/control_group.toml";

// A control's name under its host: its place, as `C0`, `C1`.
const PLACE: str = "C";

// A stacked label's line: the label role's text and its air.
const LABEL_LINE: float = 16.0;
const STACKED_GAP: float = 2.0;

/// The control column's place in a row, as `patch_at` takes it.
pub const CELLS: int = 1;

/// One row as a control: its label, then its controls in a row taking what
/// is left, or under the label when `stacked`.
pub fn control(row: Row, label_width: float, stacked: bool) -> ui::Control {
    let label = row.label.or("");
    let labelled = label != "";
    let stack = stacked && labelled;
    let height = row.height.or(DEFAULT_HEIGHT);
    let tall = if height <= 0.0 { 0.0 } else if stack { height + LABEL_LINE + STACKED_GAP } else { height };
    let label_role = row.label_role.or("");
    let slot_role = row.slot_role.or("");
    // Beside, the label sits on the controls' middle line and the theme says
    // the air between; stacked, the label's line is counted above.
    let out = ui::Control {
        kind: if stack { ui::WIDGET_COLUMN } else { ui::WIDGET_ROW },
        role: roles::LAYOUT_FORM,
        height: tall,
        controls: [
            ui::Control {
                kind: ui::WIDGET_LABEL,
                visible: labelled,
                text: label,
                width: if stack { 0.0 } else { label_width },
                height: if stack { LABEL_LINE } else { 0.0 },
                role: if label_role == "" { roles::TEXT_LABEL } else { label_role },
                tooltip: row.tooltip.or(""),
            },
            ui::Control {
                kind: ui::WIDGET_ROW,
                grow: 1.0,
                role: if slot_role == "" { roles::LAYOUT_CELLS } else { slot_role },
                align_items: ui::ALIGN_CENTER,
                controls: row.controls,
            },
        ],
    };
    if stack {
        out.gap = vec2(STACKED_GAP, STACKED_GAP);
    } else {
        out.align_items = ui::ALIGN_CENTER;
    }
    if row.y != nil {
        out.absolute = true;
        out.inset = ui::Sides { left: 0.0, top: row.y.unwrap(), right: 0.0, bottom: -1.0 };
    }
    out
}

/// A heading between groups of rows, in the heading role's capitals.
pub fn heading(title: str) -> Row {
    Row { controls: [ui::Control { kind: ui::WIDGET_LABEL, role: roles::TEXT_HEADING, text: title }] }
}

/// A line that says something, across the row and wrapping: what a panel
/// with nothing in it says, or a hint under a group.
pub fn note(text: str) -> Row {
    Row { controls: [ui::Control { kind: ui::WIDGET_LABEL, role: roles::TEXT_CAPTION, grow: 1, wrap: true, text: text }] }
}

/// The same line for something wrong.
pub fn warning(text: str) -> Row {
    Row { controls: [ui::Control { kind: ui::WIDGET_LABEL, role: roles::NOTE_WARNING, grow: 1, wrap: true, text: text }] }
}

/// Every row of a form as the controls `strip` takes.
pub fn controls(rows: [Row], label_width: float, stacked: bool) -> [ui::Control] {
    let out: [ui::Control] = [];
    for row in rows {
        out.push(control(row, label_width, stacked));
    }
    out
}

/// Fill the node at `host` with `rows`, the labels `label_width` wide or
/// above their controls when `stacked`: true when a control's table changed.
pub fn fill(host: str, rows: [Row], label_width: float?, stacked: bool?) -> bool {
    strip(host, controls(rows, width_of(label_width), stacked == true))
}

/// The row at `slot` under `host`, or that row hidden for nil.
pub fn fill_slot(host: Node, slot: int, row: Row?, label_width: float?, stacked: bool?) -> bool {
    if row == nil {
        return slot_at(host, slot);
    }
    slot_at(host, slot, control(row.unwrap(), width_of(label_width), stacked == true))
}

/// Put one node a control under the node at `host`, a path from the root:
/// made, reused and hidden as the list changes, and each written only where
/// its table changed. True when a control's table differed from the last one
/// written to it.
pub fn strip(host: str, controls: [ui::Control]) -> bool {
    let node = scene::root().get_node(host);
    if !node.is_valid() {
        return false;
    }
    shown(node);
    under(node, controls)
}

/// One child of `host`, the one at `slot`, filled as `strip` fills each and
/// made with any before it that are missing, or hidden for nil. The others are
/// left as they are, so a list of hundreds of rows writes the few on screen.
pub fn slot_at(host: Node, slot: int, control: ui::Control?) -> bool {
    shown(host);
    let node = host.get_node(PLACE + "{slot}");
    if !node.is_valid() {
        let items: [scene::RepeatItem] = [];
        for at in 0..slot + 1 {
            items.push(scene::RepeatItem { key: PLACE + "{at}", scene: GROUP_SCENE });
        }
        node = scene::repeat(host, items)[slot];
    }
    if control == nil {
        return ui::patch(node, ui::Control { visible: false });
    }
    let held = control.unwrap();
    let changed = one(node, held);
    // A slot is a group's node: one control in it hides what the group held.
    if held.controls == nil {
        under(node, []);
    }
    changed
}

/// What `patch` names written to the control at `at`, places down from
/// `host`, and remembered, so the next fill compares against it. False where
/// no control is there or nothing moved.
pub fn patch_at(host: Node, at: [int], patch: ui::Control) -> bool {
    shown(host);
    let node = host;
    for index in at {
        node = node.get_node(PLACE + "{index}");
        if !node.is_valid() {
            return false;
        }
    }
    ui::patch(node, patch)
}

// A host is shown by filling it: a script hides a whole form with a plain write.
fn shown(host: Node) {
    if host.visible() == false {
        host.set_visible(true);
    }
}

fn under(host: Node, controls: [ui::Control]) -> bool {
    let items: [scene::RepeatItem] = [];
    for at in 0..controls.len() {
        let scene = if controls[at].controls == nil { CONTROL_SCENE } else { GROUP_SCENE };
        items.push(scene::RepeatItem { key: PLACE + "{at}", scene: scene });
    }
    let nodes = scene::repeat(host, items);
    let changed = ui::write(nodes, controls);
    for at in 0..controls.len() {
        let inner = controls[at].controls;
        if inner != nil && under(nodes[at], inner.unwrap()) {
            changed = true;
        }
    }
    changed
}

fn one(node: Node, control: ui::Control) -> bool {
    let changed = ui::write([node], [control]);
    let inner = control.controls;
    if inner != nil && under(node, inner.unwrap()) {
        changed = true;
    }
    changed
}

fn width_of(label_width: float?) -> float {
    if label_width == nil { 0.0 } else { label_width.unwrap() }
}

/// What moved of the row at `slot`: each patch written to the control at its
/// place among the row's controls, nil for one that stands.
pub fn patch(host: Node, slot: int, patches: [any]) -> bool {
    let wrote = false;
    for index in 0..patches.len() {
        let patch = patches[index];
        if patch != nil && patch_at(host, [slot, CELLS, index], patch) {
            wrote = true;
        }
    }
    wrote
}

/// A row a plugin hands over: a plain table, or a row the kit made for it.
pub fn row_of(table: any) -> Row {
    let out = Row { controls: [] };
    if table == nil {
        return out;
    }
    if table.kind() != types::KIND_MAP {
        let made: Row = table;
        return made;
    }
    for key in table.keys() {
        let value = table[key];
        if value == nil {
            continue;
        }
        out = with_field(out, key, value);
    }
    out
}

const LABEL: str = "label";
const CONTROLS: str = "controls";
const HEIGHT: str = "height";
const TOOLTIP: str = "tooltip";
const LABEL_ROLE: str = "label_role";
const SLOT_ROLE: str = "slot_role";
const Y: str = "y";

fn with_field(row: Row, key: str, value: any) -> Row {
    if key == LABEL {
        row.label = value.as_str();
    } else if key == CONTROLS {
        let controls: [ui::Control] = value;
        row.controls = controls;
    } else if key == HEIGHT {
        row.height = value.as_float();
    } else if key == TOOLTIP {
        row.tooltip = value.as_str();
    } else if key == LABEL_ROLE {
        row.label_role = value.as_str();
    } else if key == SLOT_ROLE {
        row.slot_role = value.as_str();
    } else if key == Y {
        row.y = value.as_float();
    }
    row
}

const BUTTON: str = "button";

const EDITOR: str = "Editor";

/// The Editor's node, which every shell control's handler is called on.
pub fn editor() -> Node {
    scene::root().get_node(EDITOR)
}

/// `spec`, whose edit `handler` hears with `data` and the edit: what a closure over
/// the locals in `data` was. The Editor's `handle` makes the call.
pub fn on(spec: ui::Control, handler: fn(&mut editor::State, any, any), data: any) -> ui::Control {
    let carried = util::copy(util::map_or_empty(data));
    carried[fields::FN] = handler;
    if spec.kind.or("") == BUTTON {
        spec.on_click = hooks::HANDLE;
    } else {
        spec.on_change = hooks::HANDLE;
    }
    spec.target = editor();
    spec.data = carried;
    spec
}

/// The same for Enter in a field, beside or instead of its edit.
pub fn on_submit(spec: ui::Control, handler: fn(&mut editor::State, any, any), data: any) -> ui::Control {
    let held = spec.data;
    let carried = if held == nil { data } else { held };
    let kept = util::copy(util::map_or_empty(carried));
    kept[project_fields::SUBMIT] = handler;
    spec.on_submit = hooks::HANDLE_SUBMIT;
    spec.target = editor();
    spec.data = kept;
    spec
}
