// A sheet over the shell: a title, a close, and a body. What the settings
// screen is, and what anything else needing a window should be.

use crate::style;
use crate::util;

// Sized as a fraction of the screen rather than in pixels, so the same sheet
// suits a laptop and a monitor. Bounded, so it never fills a huge display
// edge to edge nor shrinks below what a form needs.
const WIDTH_FRACTION = 0.62;
const HEIGHT_FRACTION = 0.74;
const MIN_WIDTH = 640.0;
const MAX_WIDTH = 1100.0;
const MIN_HEIGHT = 420.0;
// What a sheet leaves of the screen around itself, so it reads as a sheet
// over the shell rather than a second shell.
const MARGIN = 16.0;
const PAD_X = 18.0;

/// A sheet's own box. The floor is what a form needs and the screen is what
/// there is: on a phone the second wins, less the margin around it.
pub fn size(S) {
    let screen = ui::screen_size();
    let room = util::max(screen[0] - 2.0 * MARGIN, 240.0);
    let tall = util::max(screen[1] - 2.0 * MARGIN, 200.0);
    #{
        w: util::min(util::clamp(screen[0] * WIDTH_FRACTION, MIN_WIDTH, MAX_WIDTH), room),
        h: util::min(util::clamp(screen[1] * HEIGHT_FRACTION, MIN_HEIGHT, screen[1] - 120.0), tall),
    }
}

/// What a sheet leaves inside itself: what a body measures its columns
/// against, since a row with no stated width reads the whole layer instead.
pub fn inner_w(S) {
    util::max(size(S).w - 2.0 * PAD_X, 120.0)
}

/// Every open window, so one place decides what is on top and `esc` has
/// something to close.
pub fn state() {
    #{ open: "" }
}

pub fn show(S, id) {
    S.window.open = id;
}

pub fn hide(S) {
    S.window.open = "";
}

pub fn showing(S, id) {
    S.window.open == id
}

/// Draw `body` in a titled sheet. Returns nothing; the window closes itself
/// through the title bar, the scrim or `esc`.
///
/// `actions` draws beside the close button, for a window with something to
/// commit. A window with nothing passes a callback that draws nothing.
pub fn sheet(S, id, title, actions, body) {
    if !showing(S, id) {
        return;
    }
    let k = S.theme;
    let box = size(S);
    let scrim_clicked = ui::modal(id, #{
        width: box.w, height: box.h, top: 0.09,
        fill: k.panel, stroke: k.line, scrim: "#0b0e126b",
    }, || {
        ui::frame(#{ padding_x: PAD_X, padding_y: 14 }, || {
            bar(S, k, title, actions);
            ui::add_space(10);
            body();
        });
    });
    // Both ways out mean the same thing, so neither is the special one.
    if scrim_clicked || ui::shortcut("escape") {
        hide(S);
    }
}

fn bar(S, k, title, actions) {
    ui::horizontal(#{ height: 30 }, || {
        ui::label(title, style::mono_lg(k.text));
        ui::right(|| {
            if ui::pill("Close", #{ height: 24, size: style::MD, radius: 8, fill: k.sunken, color: k.dim }) {
                hide(S);
            }
            ui::add_space(8);
            actions();
        });
    });
}
