// A sheet over the shell: a title, a close, and a body. What the settings
// screen is, and what anything else needing a window should be.

use crate::util;

// Sized as a fraction of the screen rather than in pixels, so the same sheet
// suits a laptop and a monitor. Bounded, so it never fills a huge display
// edge to edge nor shrinks below what a form needs.
const WIDTH_FRACTION = 0.62;
const HEIGHT_FRACTION = 0.74;
const MIN_WIDTH = 640.0;
const MAX_WIDTH = 1100.0;
const MIN_HEIGHT = 420.0;
// What a sheet leaves of the screen around itself, so it reads as a sheet
// over the shell rather than a second shell.
const MARGIN = 16.0;
const PAD_X = 18.0;

/// A sheet's own box. The floor is what a form needs and the screen is what
/// there is: on a phone the second wins, less the margin around it.
pub fn size(S) {
    let screen = ui::window_size();
    let room = util::max(screen[0] - 2.0 * MARGIN, 240.0);
    let tall = util::max(screen[1] - 2.0 * MARGIN, 200.0);
    #{
        w: util::min(util::clamp(screen[0] * WIDTH_FRACTION, MIN_WIDTH, MAX_WIDTH), room),
        h: util::min(util::clamp(screen[1] * HEIGHT_FRACTION, MIN_HEIGHT, screen[1] - 120.0), tall),
    }
}

/// What a sheet leaves inside itself: what a body measures its columns
/// against, since a row with no stated width reads the whole layer instead.
pub fn inner_w(S) {
    util::max(size(S).w - 2.0 * PAD_X, 120.0)
}

/// Every open window, so one place decides what is on top and `esc` has
/// something to close.
pub fn state() {
    // `drawn` is the sheet the last frame drew, so a shut it did not ask for
    // can be told from one that has not opened yet.
    #{ open: "", drawn: "", demo: -1 }
}

pub fn show(S, id) {
    S.window.open = id;
}

pub fn hide(S) {
    S.window.open = "";
    S.window.drawn = "";
    util::fill(SHEET, #{ open: false });
}

/// Whether egui shut the sheet since the last frame drew it: a `dialog` puts
/// `open` back on Escape or a click on the dim. Read before this frame writes
/// `open` again, and only for a sheet that was already up.
fn shut_outside(S, id) {
    let was = S.window.drawn == id;
    S.window.drawn = id;
    was && util::prop(SHEET, "open") == false
}

pub fn showing(S, id) {
    S.window.open == id
}

/// Draw `body` in a titled sheet. Returns nothing; the window closes itself
/// through the title bar, the scrim or `esc`.
///
/// `actions` draws beside the close button, for a window with something to
/// commit. A window with nothing passes a callback that draws nothing.
const SHEET = "Editor/Sheet";

pub fn sheet(S, id, title, actions, body) {
    // Every screen calls this every frame, and they share the one node: a
    // screen that is not up leaves it alone rather than shutting it.
    if !showing(S, id) {
        return;
    }
    if shut_outside(S, id) {
        hide(S);
        return;
    }
    // The body and the bar's own verbs are drawn, so the hatch under this
    // node runs them: what the sheet gives them is the frame, not the rows.
    S.sheet_drawn = #{ actions: actions, body: body };
    let box = size(S);
    util::fill(SHEET, #{ open: true, width: box.w, height: box.h });
    crate::pool::strip(S, SHEET + "/SheetBar", bar_controls(S, title));
    util::fill(SHEET + "/SheetBody/SheetPage", #{ visible: true });
    util::hide(SHEET + "/SheetBody/SheetSplit");
}

/// The bar across a sheet: its name, the verbs it carries, and the close.
fn bar_controls(S, title) {
    [
        #{ kind: "label", role: "text_title_dialog", text: title },
        #{ kind: "row", grow: 1 },
        #{ kind: "draw", draw: "draw_sheet_actions", width: 120 },
        #{
            kind: "button", role: "icon_action_dialog", text: "Close",
            on: |_| { hide(S); },
        },
    ]
}

// A body for a sheet that has none: `|| {}` reads as a short-circuit there.
fn nothing() {}

/// The hosts a sheet whose rows are nodes fills: its own column down the
/// left, and the rows beside it. Opens the sheet as `sheet` does and hides
/// the drawn page, so one screen cannot show both.
pub fn sheet_form(S, id, title, actions) {
    if !showing(S, id) {
        return ();
    }
    if shut_outside(S, id) {
        hide(S);
        return ();
    }
    S.sheet_drawn = #{ actions: actions, body: nothing };
    let box = size(S);
    util::fill(SHEET, #{ open: true, width: box.w, height: box.h });
    crate::pool::strip(S, SHEET + "/SheetBar", bar_controls(S, title));
    util::hide(SHEET + "/SheetBody/SheetPage");
    util::fill(SHEET + "/SheetBody/SheetSplit", #{ visible: true });
    // Shut by the asking: a screen with no sidebar leaves it alone, and one
    // that fills it shows it. Hidden, the rows beside it take the whole sheet.
    util::hide(SHEET + "/SheetBody/SheetSplit/SheetSide");
    #{
        side: SHEET + "/SheetBody/SheetSplit/SheetSide",
        form: SHEET + "/SheetBody/SheetSplit/SheetScroll/SheetForm",
    }
}

// A query and what it matches, over everything: the command palette and the
// node picker take turns on it, since only one of them is ever up.
const PICKER = "Editor/Picker";

/// Shut the picker, for the screen that was using it.
pub fn picker_shut(S) {
    util::fill(PICKER, #{ open: false });
    S.picker_focused = false;
}

/// Open the picker and answer where its rows go, or `()` when it was shut
/// from the outside — Escape, or a click on the dim.
///
/// `opts` names the glyph before the query, the `placeholder` behind it, the
/// `query` itself and what to do with an edit (`on`) and an Enter
/// (`on_submit`), the `width` it would like, and how tall its rows are.
pub fn picker(S, opts) {
    let screen = ui::window_size();
    // One width, taken from the screen: a phone is narrower than what a
    // laptop gets, and every column inside is measured off what is left.
    let width = util::min(util::f(opts.width), util::max(screen[0] - 32.0, 240.0));
    // A `dialog` shuts itself on Escape or a click on the dim, and says so by
    // putting `open` back. Read before `open` is written again, and only once
    // the picker has drawn, which is what the focus flag records.
    if S.picker_focused == true && util::prop(PICKER, "open") == false {
        return ();
    }
    util::fill(PICKER, #{ open: true, width: width });
    crate::pool::strip(S, PICKER + "/PickerHead", [
        #{ kind: "label", role: "text_mark_picker", text: opts.mark },
        #{
            kind: "text_field", role: "input_picker", grow: 1,
            text: opts.query, placeholder: opts.placeholder,
            on: opts.on, on_submit: opts.on_submit,
        },
        #{ kind: "label", role: "chip", text: "esc" },
    ]);
    util::fill(PICKER + "/PickerScroll", #{
        visible: true,
        height: util::min(util::max(screen[1] * 0.5, 160.0), util::f(opts.rows_h)),
    });
    // The field takes the caret the frame the picker opens, and keeps it: a
    // search box you have to click into is one you may as well not have.
    if S.picker_focused != true {
        let field = scene::get_node(PICKER + "/PickerHead/C1");
        if !util::is_nil(field) {
            ui::set_focus(field);
            S.picker_focused = true;
        }
    }
    PICKER + "/PickerScroll/PickerRows"
}

/// The two hatches a sheet keeps: the verbs beside its close, and its body.
pub fn draw_actions(S) {
    let held = S.sheet_drawn;
    if held is Object {
        let act = held.actions;
        act();
    }
}

pub fn draw_body(S) {
    let held = S.sheet_drawn;
    if held is Object {
        let body = held.body;
        body();
    }
}
