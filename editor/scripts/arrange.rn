// A tree of boxes into rects: the rules `crates/balaur_ui`'s containers use,
// over the editor's own shell. Read `scenes/shell.toml`, hand `run` the
// window and the sizes that move, and every sheet's rect comes back by id.

use crate::util;

/// The tree from a shell file: `#{ id, parent, kind, width, height, grow,
/// gap, padding }` per node, in file order.
pub fn read(path) {
    let doc = util::obj(toml::parse(fs::read(path)));
    let out = [];
    for entry in util::vec(doc.get("nodes").unwrap_or([])) {
        let node = util::obj(entry);
        let w = util::obj(node.get("widget").unwrap_or(#{}));
        out.push(#{
            id: node.get("id").unwrap_or(""),
            parent: node.get("parent").unwrap_or(""),
            kind: w.get("kind").unwrap_or("panel"),
            width: util::f(w.get("width").unwrap_or(0.0)),
            height: util::f(w.get("height").unwrap_or(0.0)),
            grow: util::f(w.get("grow").unwrap_or(0.0)),
            gap: util::f(w.get("gap").unwrap_or(0.0)),
            padding: util::f(w.get("padding").unwrap_or(0.0)),
        });
    }
    out
}

fn rect(x, y, w, h) {
    #{ x: x, y: y, w: w, h: h }
}

/// Every node's rect, by id.
///
/// `sizes` states what a node takes along its parent's direction where the
/// file cannot: a dock the pointer resized, a rail that is only as tall as
/// its tools. A node absent from both is a grower or nothing at all.
pub fn run(nodes, window, sizes) {
    let kids = #{};
    let by_id = #{};
    let root = "";
    for node in nodes {
        by_id[node.id] = node;
        if node.parent == "" {
            root = node.id;
            continue;
        }
        if !kids.contains_key(node.parent) {
            kids[node.parent] = [];
        }
        kids[node.parent].push(node.id);
    }
    let out = #{};
    if root == "" {
        return out;
    }
    place(by_id, kids, sizes, out, root, window);
    out
}

// What a node takes along its parent's direction: what the caller stated,
// else what the file did.
fn extent_of(by_id, sizes, id, row) {
    let node = by_id[id];
    let stated = sizes.get(id);
    if let Some(size) = stated {
        return util::f(size);
    }
    if row {
        node.width
    } else {
        node.height
    }
}

fn place(by_id, kids, sizes, out, id, box) {
    out[id] = box;
    let children = kids.get(id).unwrap_or([]);
    if children.len() == 0 {
        return;
    }
    let node = by_id[id];
    let row = node.kind == "row";
    let pad = node.padding;
    let inner = rect(box.x + pad, box.y + pad, box.w - pad * 2.0, box.h - pad * 2.0);

    // A box with no size takes no gap either: a hidden rail must not leave a
    // seam where it would have been.
    let spent = 0.0;
    let shares = 0.0;
    let seams = 0.0;
    let drawn = 0.0;
    for kid in children {
        let size = extent_of(by_id, sizes, kid, row);
        let grow = by_id[kid].grow;
        if grow > 0.0 {
            shares += grow;
            drawn += 1.0;
            continue;
        }
        spent += size;
        if size > 0.0 {
            drawn += 1.0;
        }
    }
    if drawn > 1.0 {
        seams = node.gap * (drawn - 1.0);
    }
    let room = if row { inner.w } else { inner.h };
    let free = util::max(0.0, room - spent - seams);

    let head = if row { inner.x } else { inner.y };
    let placed = 0.0;
    for kid in children {
        let grow = by_id[kid].grow;
        let size = if grow > 0.0 {
            free * (grow / shares)
        } else {
            extent_of(by_id, sizes, kid, row)
        };
        if size <= 0.0 {
            out[kid] = if row { rect(head, inner.y, 0.0, inner.h) } else { rect(inner.x, head, inner.w, 0.0) };
            continue;
        }
        if placed > 0.0 {
            head += node.gap;
        }
        let child = if row {
            rect(head, inner.y, size, inner.h)
        } else {
            rect(inner.x, head, inner.w, size)
        };
        place(by_id, kids, sizes, out, kid, child);
        head += size;
        placed += 1.0;
    }
}
