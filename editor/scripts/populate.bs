// Godot's MultiMesh › Populate Surface over the selected multimesh: the
// handle's `populate` lays the instances out, and this writes them in one step.

use editor;
use history;
use model;
use pool;
use util;
use window;

pub class PopulateState {
    kind: str,
    surface: str,
    count: int,
    columns: int,
    rows: int,
    step: float,
    radius: float,
    rotation: float,
    tilt: float,
    scale: float,
    random_scale: float,
    seed: int,
    said: str,
}

const SHEET: str = "populate";

const LABEL_WIDTH: float = 110.0;

const MULTIMESH3D: str = "multimesh3d";

const MULTIMESH2D: str = "multimesh2d";

const NONE: str = "— none —";

pub fn state() -> PopulateState {
    PopulateState {
        kind: render::POPULATE_SURFACE,
        surface: "",
        count: 50,
        columns: 4,
        rows: 4,
        step: 1.0,
        radius: 2.0,
        rotation: 1.0,
        tilt: 0.0,
        scale: 1.0,
        random_scale: 0.2,
        seed: 1,
        said: "",
    }
}

/// The multimesh component a node carries, if it carries one.
pub fn component(found: Node) -> str? {
    if !found.is_valid() {
        return nil;
    }
    if found.has_component(MULTIMESH3D) {
        return MULTIMESH3D;
    }
    if found.has_component(MULTIMESH2D) {
        return MULTIMESH2D;
    }
    nil
}

pub fn open(state: &mut editor::State) {
    if !model::has_selection(state) || component(model::selected_node(state)) == nil {
        return;
    }
    state.populate.said = "";
    window::show(state, SHEET);
}

/// Fill the sheet: what its script asks for when Populate is up.
pub fn fill(state: &mut editor::State) {
    let hosts = window::sheet_form(state, SHEET, "Populate", []);
    if hosts == nil {
        return;
    }
    pool::sync(state, hosts.unwrap().form, specs(state), LABEL_WIDTH, false);
}

fn specs(state: editor::State) -> [any] {
    let fields = state.populate;
    let node = model::selected_node(state);
    let name = component(node).or(MULTIMESH3D);
    let out: [any] = [];
    out.push({
        "full": false,
        "height": 24,
        "controls": [
            {
                "kind": "dropdown",
                "grow": 1,
                "text": fields.kind,
                "options": [render::POPULATE_SURFACE, render::POPULATE_ROW, render::POPULATE_RING, render::POPULATE_GRID],
                "on": "handle",
                "data": { "fn": on_layout_picked },
            },
        ],
        "label": "Layout",
    });
    if fields.kind == render::POPULATE_SURFACE {
        let paths = [NONE];
        for other in state.nodes {
            if drawn(other) && other != node {
                paths.push("/" + model::path_in_scene(state, other));
            }
        }
        out.push({
            "full": false,
            "height": 24,
            "controls": [
                {
                    "kind": "dropdown",
                    "grow": 1,
                    "text": if fields.surface == "" { NONE } else { fields.surface },
                    "options": paths,
                    "on": "handle",
                    "data": { "fn": on_surface_picked },
                },
            ],
            "label": "Surface",
        });
    }
    if fields.kind == render::POPULATE_GRID {
        out.push(whole(state, "Columns", fields.columns, write_columns));
        out.push(whole(state, "Rows", fields.rows, write_rows));
    } else {
        out.push(whole(state, "Count", fields.count, write_count));
    }
    if fields.kind == render::POPULATE_ROW || fields.kind == render::POPULATE_GRID {
        out.push(number(state, "Step", fields.step, 0.1, write_step));
    }
    if fields.kind == render::POPULATE_RING {
        out.push(number(state, "Radius", fields.radius, 0.1, write_radius));
    }
    out.push(fraction(state, "Rotation", fields.rotation, write_rotation));
    if name == MULTIMESH3D {
        out.push(fraction(state, "Tilt", fields.tilt, write_tilt));
    }
    out.push(number(state, "Scale", fields.scale, 0.05, write_scale));
    out.push(fraction(state, "Random scale", fields.random_scale, write_random_scale));
    out.push(whole(state, "Seed", fields.seed, write_seed));
    out.push({
        "full": false,
        "height": 24,
        "controls": [
            { "kind": "label", "role": "text_caption", "grow": 1, "text": target_text(state, node, name) },
        ],
        "label": "Writes",
    });
    if fields.said != "" {
        out.push({
            "full": false,
            "height": 24,
            "controls": [
                { "kind": "label", "role": "text_caption", "grow": 1, "text": fields.said },
            ],
        });
    }
    out.push({
        "full": true,
        "height": 30,
        "slot_role": "layout_actions",
        "controls": [
            {
                "kind": "button",
                "role": "action_form_primary",
                "grow": 1,
                "text": "Populate",
                "tooltip": "Replace the asset's instances with this layout, as one undo step",
                "on": "handle",
                "data": { "fn": on_populate_pressed },
            },
        ],
    });
    out
}

fn on_layout_picked(state: &mut editor::State, data: any, picked: any) {
    state.populate.kind = picked.as_str();
}

fn on_surface_picked(state: &mut editor::State, data: any, picked: any) {
    state.populate.surface = if picked.as_str() == NONE { "" } else { picked.as_str() };
}

fn write_columns(state: &mut editor::State, value: int) {
    state.populate.columns = value;
}

fn write_rows(state: &mut editor::State, value: int) {
    state.populate.rows = value;
}

fn write_count(state: &mut editor::State, value: int) {
    state.populate.count = value;
}

fn write_step(state: &mut editor::State, value: float) {
    state.populate.step = value;
}

fn write_radius(state: &mut editor::State, value: float) {
    state.populate.radius = value;
}

fn write_rotation(state: &mut editor::State, value: float) {
    state.populate.rotation = value;
}

fn write_tilt(state: &mut editor::State, value: float) {
    state.populate.tilt = value;
}

fn write_scale(state: &mut editor::State, value: float) {
    state.populate.scale = value;
}

fn write_random_scale(state: &mut editor::State, value: float) {
    state.populate.random_scale = value;
}

fn write_seed(state: &mut editor::State, value: int) {
    state.populate.seed = value;
}

fn on_populate_pressed(state: &mut editor::State, data: any, _value: any) {
    apply(state);
}

fn whole(state: editor::State, label: str, value: int, write: fn(&mut editor::State, int)) -> any {
    {
        "full": false,
        "height": 24,
        "controls": [
            {
                "kind": "number_field",
                "grow": 1,
                "value": value as float,
                "drag_speed": 1.0,
                "on": "handle",
                "data": { "fn": on_whole_changed, "write": write },
            },
        ],
        "label": label,
    }
}

fn on_whole_changed(state: &mut editor::State, data: any, value: any) {
    let write: fn(&mut editor::State, int) = data["write"];
    write(state, util::max(math::round(value.as_float()), 0.0) as int);
}

fn number(state: editor::State, label: str, value: float, step: float, write: fn(&mut editor::State, float)) -> any {
    {
        "full": false,
        "height": 24,
        "controls": [
            {
                "kind": "number_field",
                "grow": 1,
                "value": value,
                "drag_speed": step,
                "on": "handle",
                "data": { "fn": on_number_changed, "write": write },
            },
        ],
        "label": label,
    }
}

fn on_number_changed(state: &mut editor::State, data: any, value: any) {
    let write: fn(&mut editor::State, float) = data["write"];
    write(state, value.as_float());
}

// A share from nothing to all of it: of a half turn for rotation and tilt, of
// `scale` for its variation.
fn fraction(state: editor::State, label: str, value: float, write: fn(&mut editor::State, float)) -> any {
    {
        "full": false,
        "height": 24,
        "controls": [
            {
                "kind": "number_field",
                "grow": 1,
                "value": value,
                "drag_speed": 0.05,
                "min": 0.0,
                "max": 1.0,
                "on": "handle",
                "data": { "fn": on_fraction_changed, "write": write },
            },
        ],
        "label": label,
    }
}

fn on_fraction_changed(state: &mut editor::State, data: any, value: any) {
    let write: fn(&mut editor::State, float) = data["write"];
    write(state, util::clamp(value.as_float(), 0.0, 1.0));
}

// Whether a node draws something a surface can be read off.
fn drawn(found: Node) -> bool {
    found.has_component("mesh") || found.has_component("shape3d") || found.has_component("polygon") || found.has_component("shape2d")
}

/// What the node asks of its multimesh's `source`: an inline table, a `#id`
/// of the scene's blocks, or a file.
fn source_of(found: Node, name: str) -> any {
    if found.is_valid() && found.has_component(name) { found.authored(name)["source"] } else { nil }
}

// Where the list lands, in words: the asset itself when it is inline, the
// scene's block, or a file, which is written outside the undo history.
fn target_text(state: editor::State, node: Node, name: str) -> str {
    if source_of(node, name).kind() == "map" {
        return "this node's own asset";
    }
    let source = source_of(node, name).as_str();
    if source.starts_with("#") {
        return "the scene's [[assets]] block {source}";
    }
    if source == "" {
        return "nothing: the node names no asset";
    }
    "{source}, saved now and outside undo"
}

/// The options the engine's `populate` reads, from the sheet's fields.
fn options(state: editor::State, flat: bool) -> any {
    let fields = state.populate;
    let step = if fields.kind == render::POPULATE_ROW {
        [fields.step, 0.0, 0.0]
    } else if flat {
        [fields.step, fields.step, 0.0]
    } else {
        [fields.step, 0.0, fields.step]
    };
    let counts = if flat { [fields.columns, fields.rows, 1] } else { [fields.columns, 1, fields.rows] };
    {
        "kind": fields.kind,
        "count": fields.count,
        "radius": fields.radius,
        "rotation": fields.rotation,
        "tilt": fields.tilt,
        "scale": fields.scale,
        "random_scale": fields.random_scale,
        "seed": fields.seed,
        "step": step,
        "counts": counts,
    }
}

pub fn apply(state: &mut editor::State) {
    let node = model::selected_node(state);
    let component_name = component(node);
    if component_name == nil {
        return;
    }
    let name = component_name.unwrap();
    let found = node;
    if !found.is_valid() {
        return;
    }
    let flat = name == MULTIMESH2D;
    let asked = options(state, flat);
    if state.populate.kind == render::POPULATE_SURFACE {
        let surface = surface_node(state);
        if !surface.is_valid() {
            state.populate.said = "Pick the surface to populate.";
            return;
        }
        asked["surface"] = surface;
    }
    let instances = render::populate(found, asked);
    let wrote = write(state, node, name, instances);
    state.populate.said = "{instances.len()} instances written to {wrote}.";
}

// The live node the Surface row names, by the path the dropdown showed.
fn surface_node(state: editor::State) -> Node {
    if state.populate.surface == "" {
        return nil;
    }
    for found in state.nodes {
        if "/" + model::path_in_scene(state, found) == state.populate.surface {
            return found;
        }
    }
    nil
}

// The list into wherever the node's asset lives. Inline and in a scene block
// it is one history step; a file has no place in the document's history.
fn write(state: &mut editor::State, node: Node, name: str, instances: any) -> str {
    let asked = util::map_or_empty(node.authored(name));
    if asked["source"].kind() == "map" {
        history::record(state, "Populate", nil);
        asked["source"]["instances"] = instances;
        node.set_component(name, asked);
        return "this node's asset";
    }
    let source = asked["source"].as_str();
    if source.starts_with("#") {
        let id = source.slice(1, source.len());
        history::record(state, "Populate", nil);
        for block in util::list_or_empty(state.scene_doc["assets"]) {
            if block["id"].as_str() == id {
                block["instances"] = instances;
            }
        }
        state.assets_touched = true;
        // A scene's blocks are read when it is built, so it is built again.
        model::build(state, model::scene_text(state));
        return source;
    }
    let definition = assets::duplicate(source);
    definition["instances"] = instances;
    assets::save(source, definition);
    // The node reads its file again when it is given the same table.
    node.set_component(name, asked);
    source
}
