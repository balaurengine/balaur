// Turning a node into another kind of node: what it draws becomes what the
// new kind is built from, in one undo step. A soft body made from a sprite
// traces the image's opaque outline and bends a polygon textured with it.

use dropin;
use editor;
use history;
use model;
use newnode;
use selection;
use util;
use words::asset_kinds;
use words::components;
use words::fields;
use words::geometry_fields;
use words::inspector_fields;
use words::project_fields;
use words::roles;
use words::schema_fields;
use words::tools;

const COLLIDER2D: str = "collider2d";
const COLLIDER3D: str = "collider3d";
const SOFTBODY2D: str = "softbody2d";
const SOFTBODY3D: str = "softbody3d";
const CONVEX_DECOMPOSITION2D: str = "convex_decomposition2d";
const CONVEX_DECOMPOSITION3D: str = "convex_decomposition3d";
const EXPORT: str = "export";
const MATERIAL: str = "material";
const MESH_COLLIDER2D: str = "mesh_collider2d";
const MESH_COLLIDER3D: str = "mesh_collider3d";
const POLYGON: str = "polygon";
const SHAPE: str = "shape";
const SOFT_CIRCLE2D: str = "soft_circle2d";
const SOFT_GRID2D: str = "soft_grid2d";
const SOFT_GRID3D: str = "soft_grid3d";
const SOFT_SPHERE3D: str = "soft_sphere3d";
const SOFT_VOLUMETRIC2D: str = "soft_volumetric2d";
const TARGET: str = "target";
const CELL_SIZE: str = "cell_size";
const INDICES: str = "indices";

/// A preset the selected node can be changed to, and what the change makes.
pub struct Target {
    internal name: str,
    internal note: str,
    internal tags: [str],
}

// The keys a recipe reads off the components it converts.
const TEXTURE: str = "texture";
internal const PIXELS_PER_UNIT: str = "pixels_per_unit";
const SIZE: str = "size";
const RADIUS: str = "radius";
const COLOR: str = "color";
const MESH: str = "mesh";

// What a soft body replaces on a node: the rigid body and its shape.
fn rigid(two_d: bool) -> [str] {
    if two_d {
        [components::BODY2D, "collider2d", MESH_COLLIDER2D, CONVEX_DECOMPOSITION2D, components::CHARACTER2D]
    } else {
        [components::BODY3D, "collider3d", MESH_COLLIDER3D, CONVEX_DECOMPOSITION3D, components::CHARACTER3D]
    }
}

// The components that sit beside `component` and mean nothing without it.
fn beside_of(component: str) -> [str] {
    if component == COLLIDER2D {
        return [MESH_COLLIDER2D, CONVEX_DECOMPOSITION2D];
    }
    if component == COLLIDER3D {
        return [MESH_COLLIDER3D, CONVEX_DECOMPOSITION3D];
    }
    if component == SOFTBODY2D {
        return [SOFT_GRID2D, SOFT_CIRCLE2D, "soft_rope2d", "soft_outline2d", "soft_polyline2d", SOFT_VOLUMETRIC2D, "soft_custom2d"];
    }
    if component == SOFTBODY3D {
        return [SOFT_GRID3D, SOFT_SPHERE3D, "soft_cloth_tube3d", "soft_rope3d", "soft_volumetric3d", "soft_custom3d"];
    }
    return [];
}

fn take_off(node: any, component: str) {
    node.remove(component);
    for other in beside_of(component) {
        node.remove(other);
    }
}

// Components a node holds one of at a time: what it draws, and what body it
// is. A new type replaces what the node holds from each group it fills.
fn groups() -> [[str]] {
    [
        [components::SPRITE, components::SHAPE2D, components::LINE2D, POLYGON, "text2d", components::TILEMAP],
        ["mesh", components::SHAPE3D, components::TEXT3D],
        [components::BODY2D, "softbody2d", components::CHARACTER2D],
        [components::BODY3D, "softbody3d", components::CHARACTER3D, "vehicle3d"],
    ]
}

// Properties that mean the same on every member of a group, carried from the
// component a new type replaces when the new one has them.
fn carried() -> [str] {
    ["color", "texture", MATERIAL]
}

// The presets a recipe builds better than their plain parts would.
const SOFT_2D: str = "soft_body2d";
const SOFT_3D: str = "soft_body3d";
const POLYGON_2D: str = "polygon2d";

/// What `soft_body` would build from on row `index`, as a word for a menu, or
/// nil when the node draws nothing a soft body can be made of.
pub fn soft_body_source(state: editor::State, index: int) -> str? {
    let node = model::row_of(model::node(state, index));
    let usable = if node.has(components::SPRITE) {
        sprite_convertible(node[components::SPRITE])
    } else if node.has(components::SHAPE2D) {
        shape2d_kind(node[components::SHAPE2D]) != ""
    } else if node.has(components::SHAPE3D) && mesh_source(node) == nil {
        shape3d_kind(node[components::SHAPE3D]) != ""
    } else {
        true
    };
    if !usable {
        return nil;
    }
    let word = if node.has(components::SPRITE) {
        components::SPRITE
    } else if node.has(POLYGON) {
        tools::POLYGON
    } else if node.has(components::SHAPE2D) || node.has(components::SHAPE3D) && mesh_source(node) == nil {
        SHAPE
    } else if mesh_source(node) != nil {
        MESH
    } else {
        ""
    };
    if word == "" { nil } else { word }
}

/// Make row `index` a soft body built from what it draws, in one undo step;
/// `false`, with a log line saying why, when it draws nothing to build from.
pub fn soft_body(state: &mut editor::State, index: int) -> bool {
    let parts = soft_parts(state, index);
    if parts == nil {
        return false;
    }
    history::record(state, "make soft body");
    make_soft(state, index, parts)
}

// What `soft_body` puts on row `index`, or nil, said in the log, when the node
// draws nothing to build one from.
fn soft_parts(state: editor::State, index: int) -> any {
    if soft_body_source(state, index) == nil {
        log::warn("{model::node(state, index).name()} draws nothing a soft body can be made of: give it a sprite, a polygon, a shape or a mesh");
        return nil;
    }
    let node = model::row_of(model::node(state, index));
    if is_2d_source(node) { soft_parts_2d(state, node) } else { soft_parts_3d(node) }
}

// The soft body half of `soft_body`, with the history step the caller's.
fn make_soft(state: &mut editor::State, index: int, parts: any) -> bool {
    let found = model::node(state, index);
    let node = model::row_of(found);
    let source = soft_body_source(state, index).or(SHAPE);
    replace(node, rigid(is_2d_source(node)), parts);
    model::write_row(found, node);
    selection::only(state, index);
    log::info("{found.name()} is a soft body now, made from its {source}");
    true
}

fn is_2d_source(node: any) -> bool {
    node.has(components::SPRITE) || node.has(POLYGON) || node.has(components::SHAPE2D)
}

/// What row `index` can be changed to: every preset of its kind (2D, 3D or UI)
/// but the one it already is, each with the line saying what the change
/// makes of it. A node of no kind yet can be any.
pub fn targets(state: editor::State, index: int) -> [Target] {
    let found = model::node(state, index);
    let facet = model::facet(found);
    let out: [Target] = [];
    for name in scene::presets() {
        let info = scene::preset_info(name);
        if info == nil {
            continue;
        }
        let preset = info.unwrap();
        if facet != "" && !util::contains(preset.tags, facet) {
            continue;
        }
        if found.is_valid() && already(found, preset.parts) {
            continue;
        }
        let note = recipe_note(state, index, name);
        out.push(Target { name: name, note: note.or(preset.description), tags: preset.tags });
    }
    out
}

/// Make row `index` the preset `name` in one undo step. What it drew carries over
/// where the new type can use it: a sprite becomes the soft body's outline,
/// and a new collider is fitted to it.
pub fn change_type(state: &mut editor::State, index: int, name: str) -> bool {
    let found = model::node(state, index);
    let node = model::row_of(found);
    if (name == SOFT_2D || name == SOFT_3D) && soft_body_source(state, index) != nil {
        return soft_body(state, index);
    }
    if name == POLYGON_2D && outline_2d(state, node, false) != nil {
        return to_polygon(state, index);
    }
    let info = scene::preset_info(name);
    if info == nil {
        log::warn("no preset named {name}");
        return false;
    }
    let parts = info.unwrap().parts;
    history::record(state, "change to " + name);
    let fresh: [str] = [];
    for component in parts.keys() {
        if !node.has(component) {
            fresh.push(component);
        }
    }
    switch(node, parts);
    for component in fresh {
        fit_collider(state, node, component, parts);
    }
    model::write_row(found, node);
    selection::only(state, index);
    log::info("{found.name()} is a {name} now");
    true
}

// Put a preset's parts on a node: a part it has is patched, one it lacks is
// added, and each group a part fills gives up what else the node held of it.
fn switch(node: any, parts: any) {
    for component in parts.keys() {
        let own = util::map_or_empty(node[component]);
        let accepts = util::map_or_empty(scene::component_properties(component, {}));
        for group in groups() {
            if !util::contains(group, component) {
                continue;
            }
            for other in group {
                if other == component || !node.has(other) {
                    continue;
                }
                let held = util::map_or_empty(node[other]);
                for key in carried() {
                    let value = held[key];
                    if value != nil && accepts.has(key) && !own.has(key) {
                        own[key] = value;
                    }
                }
                take_off(node, other);
            }
        }
        let parameters = util::map_or_empty(parts[component]);
        for key in parameters.keys() {
            own[key] = parameters[key];
        }
        node[component] = own;
    }
    // A soft body collides as its own particles; a rigid shape beside it
    // would be a second body in the same place.
    if parts.has(SOFTBODY2D) {
        take_off(node, COLLIDER2D);
    }
    if parts.has(SOFTBODY3D) {
        take_off(node, COLLIDER3D);
    }
}

// A collider the change added, shaped to what the node draws rather than the
// unit square a bare one is.
fn fit_collider(state: editor::State, node: any, component: str, parts: any) {
    let two_d = component == COLLIDER2D;
    if !two_d && component != COLLIDER3D {
        return;
    }
    let shape = if two_d { fitted_2d(state, node) } else { fitted_3d(node, parts) };
    if shape == nil {
        return;
    }
    let own = util::map_or_empty(node[component]);
    own[schema_fields::SHAPE] = shape;
    node[component] = own;
}

fn fitted_2d(state: editor::State, node: any) -> any {
    if node.has(components::SHAPE2D) {
        let shape = node[components::SHAPE2D];
        if shape2d_kind(shape) == render::SHAPE_CIRCLE {
            return { fields::KIND: physics2d::SHAPE_CIRCLE, RADIUS: or_float(form(shape)[RADIUS], 0.5) };
        }
        return { fields::KIND: physics2d::SHAPE_RECTANGLE, SIZE: util::list2_or(form(shape)[SIZE], [1.0, 1.0]) };
    }
    let mesh = outline_2d(state, node, true);
    if mesh == nil {
        return nil;
    }
    { fields::KIND: physics2d::SHAPE_CONVEX_DECOMPOSITION, MESH: mesh }
}

fn fitted_3d(node: any, parts: any) -> any {
    let static_body = util::map_or_empty(parts[components::BODY3D])[fields::KIND].as_str() == physics3d::BODY_STATIC;
    let source = mesh_source(node);
    if source != nil {
        let kind = if static_body { physics3d::SHAPE_TRIANGLE_MESH } else { physics3d::SHAPE_CONVEX_HULL };
        return { fields::KIND: kind, MESH: source };
    }
    if !node.has(components::SHAPE3D) {
        return nil;
    }
    let shape = node[components::SHAPE3D];
    if shape3d_kind(shape) == render::SHAPE_SPHERE {
        return { fields::KIND: physics3d::SHAPE_SPHERE, RADIUS: or_float(form(shape)[RADIUS], 0.5) };
    }
    { fields::KIND: physics3d::SHAPE_BOX, SIZE: util::list3_or(form(shape)[SIZE], [1.0, 1.0, 1.0]) }
}

// A number a table states, or `fallback` where it states none.
fn or_float(value: any, fallback: float) -> float {
    if value == nil { fallback } else { value.as_float() }
}

// A mesh as a polygon or a collider names it: an inline table, or a path.
fn names_mesh(mesh: any) -> bool {
    mesh.kind() == types::KIND_MAP || mesh.kind() == types::KIND_STRING && mesh.as_str() != ""
}

// The outline a 2D node draws, as a mesh: its polygon's own, its sprite's
// traced, or its shape's corners; nil for none. `trace` false only says
// whether there is one, without tracing an image.
fn outline_2d(state: editor::State, node: any, trace: bool) -> any {
    if node.has(POLYGON) {
        let mesh = node[POLYGON][MESH];
        if names_mesh(mesh) {
            return mesh;
        }
    }
    if node.has(components::SPRITE) && sprite_convertible(node[components::SPRITE]) {
        if !trace {
            return {};
        }
        let polygon = sprite_polygon(state, node[components::SPRITE]);
        return if polygon == nil { nil } else { polygon[MESH] };
    }
    if node.has(components::SHAPE2D) && shape2d_kind(node[components::SHAPE2D]) != "" {
        return { geometry_fields::POSITIONS: shape_points(node[components::SHAPE2D]) };
    }
    nil
}

// Enough for a circle to read as round at the size a node is drawn.
const RIM_POINTS: int = 32;

// A rect's corners or a circle's rim, counter-clockwise with y up.
fn shape_points(shape: any) -> [[float]] {
    if shape2d_kind(shape) == render::SHAPE_CIRCLE {
        let radius = or_float(form(shape)[RADIUS], 0.5);
        let points: [[float]] = [];
        for step in 0..RIM_POINTS {
            let angle = step as float / RIM_POINTS as float * 2.0 * math::PI;
            points.push([radius * math::cos(angle), radius * math::sin(angle)]);
        }
        return points;
    }
    let size = util::list2_or(form(shape)[SIZE], [1.0, 1.0]);
    let half_x = size[0] / 2.0;
    let half_y = size[1] / 2.0;
    [[0.0 - half_x, 0.0 - half_y], [half_x, 0.0 - half_y], [half_x, half_y], [0.0 - half_x, half_y]]
}

// A sprite or a shape made a polygon of the same outline, in one undo step.
fn to_polygon(state: &mut editor::State, index: int) -> bool {
    let found = model::node(state, index);
    let node = model::row_of(found);
    if node.has(components::SPRITE) {
        return sprite_to_polygon(state, index);
    }
    let shape = node[components::SHAPE2D];
    history::record(state, "make polygon");
    let color = shape[COLOR];
    let polygon: any = {
        MESH: { geometry_fields::POSITIONS: shape_points(shape) },
        COLOR: if color == nil { [0.8, 0.8, 0.8, 1.0] } else { color },
    };
    node.remove(components::SHAPE2D);
    node[POLYGON] = polygon;
    model::write_row(found, node);
    selection::only(state, index);
    true
}

// A preset whose every part the node holds as the preset sets it.
fn already(found: Node, parts: any) -> bool {
    for component in parts.keys() {
        if !found.has_component(component) {
            return false;
        }
        let held = util::map_or_empty(found.get_component(component));
        let parameters = util::map_or_empty(parts[component]);
        for key in parameters.keys() {
            let had = held[key];
            if had == nil || !same(had, parameters[key]) {
                return false;
            }
        }
    }
    true
}

// Equal, with an integer and a float of one value alike: a preset spells
// `pinned_particles = [0]` where the component reads back `[0.0]`.
fn same(first: any, second: any) -> bool {
    let numbers = (first.kind() == types::KIND_INT || first.kind() == types::KIND_FLOAT) && (second.kind() == types::KIND_INT || second.kind() == types::KIND_FLOAT);
    if numbers {
        return first.as_float() == second.as_float();
    }
    if first.kind() == types::KIND_LIST && second.kind() == types::KIND_LIST {
        if first.len() != second.len() {
            return false;
        }
        for index in 0..first.len() {
            if !same(first[index], second[index]) {
                return false;
            }
        }
        return true;
    }
    if first.kind() == types::KIND_STRING && second.kind() == types::KIND_STRING || first.kind() == types::KIND_BOOL && second.kind() == types::KIND_BOOL {
        return first == second;
    }
    false
}

// What a recipe makes of row `index` as preset `name`, for the picker's line; nil
// where the preset's own description says it.
fn recipe_note(state: editor::State, index: int, name: str) -> str? {
    let node = model::row_of(model::node(state, index));
    if name == SOFT_2D || name == SOFT_3D {
        let source = soft_body_source(state, index);
        if source != nil {
            return "bent from its {source.unwrap()}, which it keeps drawing";
        }
        return nil;
    }
    if name == POLYGON_2D && outline_2d(state, node, false) != nil {
        return "the same outline as a polygon a rig or a soft body can bend";
    }
    let info = scene::preset_info(name);
    if info == nil {
        return nil;
    }
    let parts = info.unwrap().parts;
    let collider = parts.has(COLLIDER2D) && !node.has(COLLIDER2D) || parts.has(COLLIDER3D) && !node.has(COLLIDER3D);
    let drawn = outline_2d(state, node, false) != nil || mesh_source(node) != nil || node.has(components::SHAPE3D);
    if collider && drawn {
        return "{info.unwrap().description}, its collider fitted to what it draws";
    }
    nil
}

/// What a new soft body can be made from: a shape, or any image (2D) or
/// model (3D) in the project, as the node picker's rows.
pub fn soft_sources(state: &mut editor::State, two_d: bool) -> [newnode::Entry] {
    let out: [newnode::Entry] = [];
    if two_d {
        out.push(source_row("Rectangle", "a block of cells", "Jelly", { components::SHAPE2D: { schema_fields::SHAPE: { fields::KIND: render::SHAPE_RECTANGLE } } }));
        out.push(source_row("Circle", "a ring of particles holding its area", "Blob", { components::SHAPE2D: { schema_fields::SHAPE: { fields::KIND: render::SHAPE_CIRCLE, RADIUS: 0.5 } } }));
        for rel in project_files(state, asset_kinds::IMAGE) {
            out.push(source_row(rel, "traced to its opaque outline", dropin::stem_of(rel), { components::SPRITE: { TEXTURE: rel } }));
        }
    } else {
        out.push(source_row("Box", "a block of cells", "Jelly", { components::SHAPE3D: { schema_fields::SHAPE: { fields::KIND: render::SHAPE_BOX } } }));
        out.push(source_row("Sphere", "a ball of cells", "Blob", { components::SHAPE3D: { schema_fields::SHAPE: { fields::KIND: render::SHAPE_SPHERE, RADIUS: 0.5 } } }));
        out.push(source_row("Plane", "a sheet of cloth", "Cloth", { components::SHAPE3D: { schema_fields::SHAPE: { fields::KIND: render::SHAPE_PLANE, SIZE: [2.0, 0.0, 2.0] } } }));
        for rel in project_files(state, asset_kinds::MODEL) {
            out.push(source_row(rel, "filled with cells that carry it as a skin", dropin::stem_of(rel), { MESH: { inspector_fields::SOURCE: { inspector_fields::SOURCE: rel } } }));
        }
    }
    out
}

fn source_row(label: str, note: str, name: str, parts: any) -> newnode::Entry {
    newnode::Entry { name: name, note: note, tags: "", group: "", preset: false, label: label, parts: parts }
}

/// Add a child soft body made from one of `soft_sources`, in one undo step.
pub fn add_soft_body(state: &mut editor::State, source: newnode::Entry) -> bool {
    let before = state.nodes.len();
    model::add_child(state);
    if state.nodes.len() == before {
        return false;
    }
    model::selected_node(state).set_name(model::unique_name(state, source.name));
    fill_soft(state, state.selected, source)
}

/// Rebuild row `index` as a soft body made from one of `soft_sources`, in one
/// undo step: what it drew gives way to the source.
pub fn give_soft_body(state: &mut editor::State, index: int, source: newnode::Entry) -> bool {
    history::record(state, "make soft body");
    fill_soft(state, index, source)
}

fn fill_soft(state: &mut editor::State, index: int, source: newnode::Entry) -> bool {
    let found = model::node(state, index);
    let row = model::row_of(found);
    switch(row, util::deep(source.parts));
    model::write_row(found, row);
    let parts = soft_parts(state, index);
    if parts == nil {
        return false;
    }
    make_soft(state, index, parts)
}

/// "2d" or "3d" for a preset that makes a soft body a recipe builds, else "".
pub fn soft_dimension(name: str) -> str {
    if name == SOFT_2D {
        model::DIM_2D
    } else if name == SOFT_3D {
        model::DIM_3D
    } else {
        ""
    }
}

pub fn is_model(rel: str) -> bool {
    let lower = rel.to_lower();
    lower.ends_with(".glb") || lower.ends_with(".gltf") || lower.ends_with(".obj")
}

// Directories a project keeps no source art in.
fn skipped() -> [str] {
    [TARGET, EXPORT, "build"]
}

// Far enough for `art/characters/hero/idle.png`, and a bound on a big tree.
const MAX_DEPTH: int = 4;
const MAX_FILES: int = 200;

// Project-relative paths of the images or the models, breadth first.
fn project_files(state: &mut editor::State, kind: str) -> [str] {
    let out: [str] = [];
    let directories = [""];
    let depth = 0;
    while directories.len() > 0 && depth <= MAX_DEPTH && out.len() < MAX_FILES {
        let next: [str] = [];
        for directory in directories {
            for entry in util::list_or_empty(model::list(state, directory)) {
                let name = entry[fields::NAME].as_str();
                let rel = if directory == "" { name } else { directory + "/" + name };
                if entry[project_fields::IS_DIR].as_bool() {
                    if !util::contains(skipped(), name) {
                        next.push(rel);
                    }
                } else if wanted(rel, kind) && out.len() < MAX_FILES {
                    out.push(rel);
                }
            }
        }
        directories = next;
        depth += 1;
    }
    out
}

fn wanted(rel: str, kind: str) -> bool {
    if kind == asset_kinds::MODEL { is_model(rel) } else { dropin::kind_of(rel) == asset_kinds::IMAGE }
}

/// Make a sprite on row `index` a polygon textured with the same image and cut
/// to its opaque outline, in one undo step.
pub fn sprite_to_polygon(state: &mut editor::State, index: int) -> bool {
    let found = model::node(state, index);
    let node = model::row_of(found);
    if !node.has(components::SPRITE) {
        return false;
    }
    let polygon = sprite_polygon(state, node[components::SPRITE]);
    if polygon == nil {
        return false;
    }
    history::record(state, "trace sprite");
    replace(node, [], { POLYGON: polygon });
    node.remove(components::SPRITE);
    model::write_row(found, node);
    selection::only(state, index);
    true
}

// Take `gone` off the node and put `parts` on it; a part named `-key` takes
// that key off too.
fn replace(node: any, gone: [str], parts: any) {
    for key in gone {
        node.remove(key);
    }
    for key in parts.keys() {
        if key.starts_with("-") {
            node.remove(key.slice(1, key.len()));
        } else {
            node[key] = parts[key];
        }
    }
}

// What a 2D node becomes: its own polygon kept and bent by cells, a sprite
// traced into one, or a shape turned into the generator that matches it.
fn soft_parts_2d(state: editor::State, node: any) -> any {
    if node.has(components::SPRITE) {
        let polygon = sprite_polygon(state, node[components::SPRITE]);
        if polygon == nil {
            return nil;
        }
        let body: any = { fields::KIND: physics2d::SOFT_VOLUMETRIC, MESH: util::deep(polygon[MESH]) };
        let fill: any = { CELL_SIZE: cell_size(polygon[MESH][geometry_fields::POSITIONS]) };
        return { "-sprite": true, SOFTBODY2D: body, SOFT_VOLUMETRIC2D: fill, POLYGON: polygon };
    }
    if node.has(POLYGON) {
        let mesh = node[POLYGON][MESH];
        if !names_mesh(mesh) {
            log::warn("{node["name"]}'s polygon has no mesh yet: trace or draw it first");
            return nil;
        }
        let body: any = { fields::KIND: physics2d::SOFT_VOLUMETRIC, MESH: util::copy(mesh) };
        let parts: any = { SOFTBODY2D: body };
        if mesh.kind() == types::KIND_MAP {
            parts[SOFT_VOLUMETRIC2D] = { CELL_SIZE: cell_size(mesh[geometry_fields::POSITIONS]) };
        }
        return parts;
    }
    let shape = node[components::SHAPE2D];
    let color = shape[COLOR];
    let tint: any = if color == nil { [0.8, 0.8, 0.8, 1.0] } else { color };
    if shape2d_kind(shape) == render::SHAPE_RECTANGLE {
        let size = util::list2_or(form(shape)[SIZE], [1.0, 1.0]);
        let body: any = { fields::KIND: physics2d::SOFT_GRID, COLOR: tint };
        let grid: any = { SIZE: size, geometry_fields::CELLS: cells_2d(size) };
        return { "-shape2d": true, SOFTBODY2D: body, SOFT_GRID2D: grid };
    }
    let body: any = { fields::KIND: physics2d::SOFT_CIRCLE, COLOR: tint };
    let circle: any = { RADIUS: or_float(form(shape)[RADIUS], 0.5), "particle_count": 32 };
    { "-shape2d": true, SOFTBODY2D: body, SOFT_CIRCLE2D: circle }
}

// What a 3D node becomes: a mesh the cells carry as a skin, or a shape turned
// into the generator that matches it.
fn soft_parts_3d(node: any) -> any {
    let source = mesh_source(node);
    if source != nil {
        return { SOFTBODY3D: { fields::KIND: physics3d::SOFT_VOLUMETRIC, MESH: source }, components::SOFT_SKIN3D: { geometry_fields::SKIN: true } };
    }
    let shape = node[components::SHAPE3D];
    let color = shape[COLOR];
    let tint: any = if color == nil { [0.8, 0.8, 0.8, 1.0] } else { color };
    let kind = shape3d_kind(shape);
    if kind == render::SHAPE_SPHERE {
        let body: any = { fields::KIND: physics3d::SOFT_SPHERE, COLOR: tint };
        let sphere: any = { RADIUS: or_float(form(shape)[RADIUS], 0.5) };
        return { "-shape3d": true, SOFTBODY3D: body, SOFT_SPHERE3D: sphere };
    }
    let size = util::list3_or(form(shape)[SIZE], [1.0, 1.0, 1.0]);
    if kind == render::SHAPE_PLANE {
        let body: any = { fields::KIND: physics3d::SOFT_CLOTH, COLOR: tint };
        let grid: any = { SIZE: [size[0], 0.0, size[2]], geometry_fields::CELLS: [12.0, 12.0, 1.0] };
        return { "-shape3d": true, SOFTBODY3D: body, SOFT_GRID3D: grid };
    }
    let body: any = { fields::KIND: physics3d::SOFT_BOX, COLOR: tint };
    let grid: any = { SIZE: size, geometry_fields::CELLS: [4.0, 4.0, 4.0] };
    { "-shape3d": true, SOFTBODY3D: body, SOFT_GRID3D: grid }
}

// A sprite drawn from one whole image converts; one cut from a sheet or a
// region is a frame of an image, which a trace of the whole would not match.
fn sprite_convertible(sprite: any) -> bool {
    sprite[TEXTURE].as_str() != "" && sprite[roles::SHEET].as_str() == "" && sprite["region_size"] == nil
}

// The polygon a sprite becomes: the image's opaque outline, traced at the
// scale the sprite is drawn at, carrying its texture and colour; nil when
// there is nothing to trace.
fn sprite_polygon(state: editor::State, sprite: any) -> any {
    if !sprite_convertible(sprite) {
        log::warn("only a sprite drawing one whole image can be traced, not a sheet's frame or a region");
        return nil;
    }
    let texture = sprite[TEXTURE].as_str();
    let pixels_per_unit = drawn_scale(state, sprite, texture);
    // Every loop, so an image of two shapes gives both; `islands` drops the holes.
    let options: any = { PIXELS_PER_UNIT: pixels_per_unit, "threshold": 0.5, "tolerance": 2.0, "holes": true };
    let mesh = islands(sprite, render::trace_texture(state.game_root + "/" + texture, options));
    if mesh[INDICES].len() == 0 {
        log::warn("{texture} has no opaque pixels to trace");
        return nil;
    }
    let color = sprite[COLOR];
    {
        MESH: mesh,
        TEXTURE: texture,
        PIXELS_PER_UNIT: pixels_per_unit,
        COLOR: if color == nil { [1.0, 1.0, 1.0, 1.0] } else { color },
    }
}

// Every opaque island of an image as one mesh: each traced outline placed
// where the sprite draws it and cut into triangles, so an image of two
// shapes stays two shapes.
fn islands(sprite: any, loops: [[Vec2]]) -> any {
    let positions: [[float]] = [];
    let indices: [[int]] = [];
    for found in loops {
        // Traced counter-clockwise, a hole runs the other way.
        if found.len() < 3 || geometry2d::is_clockwise(found) {
            continue;
        }
        let points = placed(sprite, found);
        let outline: [Vec2] = [];
        for point in points {
            outline.push(vec2(point[0], point[1]));
        }
        let base = positions.len();
        for triangle in geometry2d::triangulate(outline) {
            indices.push([triangle[0] + base, triangle[1] + base, triangle[2] + base]);
        }
        for point in points {
            positions.push(point);
        }
    }
    { geometry_fields::POSITIONS: positions, INDICES: indices }
}

// The pixels a world unit holds where the sprite is drawn: its own setting, a
// size it was stretched to, or the texture's import setting.
fn drawn_scale(state: editor::State, sprite: any, texture: str) -> float {
    let size = sprite[SIZE];
    if size != nil && size[0].as_float() > 0.0 {
        let texture_width = render::texture_size(state.game_root + "/" + texture)[0];
        return texture_width as float / size[0].as_float();
    }
    let own = sprite[PIXELS_PER_UNIT].as_float();
    if own > 0.0 { own } else { render::texture_pixels_per_unit(state.game_root + "/" + texture) }
}

// A traced outline where the sprite puts its image: flipped as it is, and
// moved by its offset and by a corner anchor when it is not centred.
fn placed(sprite: any, points: [Vec2]) -> [[float]] {
    let flip_x = sprite["flip_x"].as_bool();
    let flip_y = sprite["flip_y"].as_bool();
    let offset = util::list2_or(sprite["offset"], [0.0, 0.0]);
    let out: [[float]] = [];
    for point in points {
        let point_x = if flip_x { 0.0 - point.x } else { point.x };
        let point_y = if flip_y { 0.0 - point.y } else { point.y };
        out.push([point_x + offset[0], point_y + offset[1]]);
    }
    // A flip reverses the outline's winding, which a fill reads as inside out.
    if flip_x != flip_y {
        let reversed: [[float]] = [];
        for index in 0..out.len() {
            reversed.push(out[out.len() - 1 - index]);
        }
        return reversed;
    }
    out
}

// A cell about a tenth of the shape's widest side: fine enough to bend, and
// coarse enough to stay well under the particle cap.
fn cell_size(points: any) -> float {
    let low = [1000000.0, 1000000.0];
    let high = [-1000000.0, -1000000.0];
    for point in util::list_or_empty(points) {
        let point_x = point[0].as_float();
        let point_y = point[1].as_float();
        low = [util::min(low[0], point_x), util::min(low[1], point_y)];
        high = [util::max(high[0], point_x), util::max(high[1], point_y)];
    }
    let widest = util::max(high[0] - low[0], high[1] - low[1]);
    util::clamp(widest / 10.0, 0.02, 1.0)
}

fn cells_2d(size: [float]) -> [float] {
    let longest = util::max(size[0], size[1]);
    let per_unit = 8.0 / util::max(longest, 0.01);
    [util::max(2.0, math::round(size[0] * per_unit)), util::max(2.0, math::round(size[1] * per_unit))]
}

// A shape component's `shape`: its kind and the dimensions that kind reads.
fn form(shape: any) -> any {
    util::map_or_empty(shape[schema_fields::SHAPE])
}

// A shape's kind when a recipe converts it, "" when it does not.
fn shape2d_kind(shape: any) -> str {
    let held = form(shape)[fields::KIND];
    let kind = if held == nil { render::SHAPE_RECTANGLE } else { held.as_str() };
    if kind == render::SHAPE_RECTANGLE || kind == render::SHAPE_CIRCLE { kind } else { "" }
}

fn shape3d_kind(shape: any) -> str {
    let held = form(shape)[fields::KIND];
    let kind = if held == nil { render::SHAPE_BOX } else { held.as_str() };
    if kind == render::SHAPE_BOX || kind == render::SHAPE_SPHERE || kind == render::SHAPE_PLANE { kind } else { "" }
}

// The mesh asset a 3D node draws, when it draws one from a file; nil if not.
fn mesh_source(node: any) -> any {
    let mesh = node[MESH];
    let source = if mesh.kind() == types::KIND_MAP { mesh[inspector_fields::SOURCE] } else { mesh };
    if names_mesh(source) { source } else { nil }
}
