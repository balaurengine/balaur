// The balaur editor: a regular balaur project whose modules draw the whole
// shell and edit the game given to `balaur edit`; `S` is its one state object.

mod about;
mod anim;
mod arrange;
mod bonemap;
mod statemachine;
mod center;
mod chrome;
mod commands;
mod complete;
mod defs;
mod dock;
mod docks;
mod docs;
mod dropin;
mod events;
mod exporter;
mod gizmo;
mod gizmo2d;
mod history;
mod icons;
mod importer;
mod inputview;
mod inspector;
mod kit;
mod layout;
mod library;
mod manager;
mod left;
mod lint;
mod menu;
mod model;
mod newnode;
mod overlays;
mod palette;
mod pen;
mod physics;
mod plugins;
mod polygon;
