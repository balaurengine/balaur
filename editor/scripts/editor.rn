/// Give `S` every field a fresh state has and it lacks.
///
/// Reload hands the running object to the new code, so a field only the new
/// code knows about is absent and errors on every frame that reads it.
pub fn backfill(S) {
    let added = [];
    for (key, value) in fresh_state() {
        if !S.contains_key(key) {
            S[key] = value;
            added.push(key);
        }
    }
    added
}

pub fn on_hot_reload(this) {
    let S = this.S;
    let added = backfill(S);
    if !added.is_empty() {
        log::info(format!("reload: state gained {:?}", added));
    }
    theme::apply(S);
    ui::request_repaint();
}
