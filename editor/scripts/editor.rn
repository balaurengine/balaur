// The balaur editor: a regular balaur project whose modules draw the whole
// shell and edit the game given to `balaur edit`; `S` is its one state object.

mod anim;
mod center;
mod chrome;
mod defs;
mod dock;
mod docks;
mod gizmo;
mod gizmo2d;
mod highlight;
mod history;
mod icons;
mod inputview;
mod inspector;
mod layout;
mod left;
mod lint;
mod model;
mod overlays;
mod palette;
mod plugins;
mod polygon;
mod rig;
mod selftest;
mod session;
mod shell;
mod showcase;
mod style;
mod theme;
mod util;
mod viewport;

pub fn init(this) {
    let S = #{
        persona: "scene",
        tool: "select",
        doctab: "scene",
        // A shader opened from a material; empty means the code pane shows
        // the selected node's script instead.
        shader_rel: "",
        // The shader line the viewport draws the value of; 0 draws the scene.
        preview_line: 0,
        preview_rel: "",
        docks: docks::state(),
        // The centre split: code and viewport side by side, instead of the
        // document tabs swapping one for the other.
        split: false,
        zoom: 100.0,
        playing: false,
        palette: false,
        palette_query: "",
        palette_submit: false,
        chip_state: #{},
        compact: false,
        version: "0.1.0",
        ui_scale: 1.25,
        script_buffers: #{},
        schemas: #{},
        script_dirty: #{},
        collapsed: #{},
        fps: 0.0,
        // -1 when the layout self-test is not running.
        layout_demo: -1,
        frame: 0,
        shot: None,
        // `frames=<dir>`: a PNG every `every` frames from `from`, numbered.
        capture: (),
        // The input overlay: keys, buttons, actions and the pointer.
        show_input: false,
        screen_w: 1280.0,
        screen_h: 800.0,
        viewport: #{ x: 322.0, y: 112.0, w: 640.0, h: 482.0, at: 0 },
        rail_visible: false,
        fontdemo: false,
        // A document is over the scene; the hooks list is beside it.
        doc_open: false,
        hooks_open: false,
        layout: layout::state(),
        // Whether the centre is showing the viewport this frame, rather than
        // a document over it.
        viewport_live: true,
        mode2d: false,
        refs: [],
        sources: #{},
        listings: #{},
        clip: None,
        hooks_src: "",
        hooks_live: [],
        log_level: "all",
        log_query: "",
        mirror: (),
        theme: theme::dark(),
        gizmo: gizmo::state(),
        rig: rig::state(),
        polygon: polygon::state(),
        anim: anim::state(),
        debug: shell::debug_state(),
        session: session::state(),
        showcase: showcase::state(),
        inputview: inputview::state(),
        lint: lint::state(),
        assets: dock::assets_state(),
        // Where an editor plugin keeps its own state, by id.
        plugins: #{},
        registry: plugins::state(),
    };
    this.S = S;

    model::load(S);
    plugins::load(S);
    theme::apply(S);
    render::set_app_icon("assets/balaur-logo.png");
    ui::set_scale(S.ui_scale);
    render::set_grid(true, 1.0, 5, 20);
    shell::apply_camera(S);
    log::info(format!("editing {} ({} nodes)", S.game_name, S.doc.len()));

    // Optional start-up states, comma-separated (persona id, "palette",
    // "light", "play", "select:<node>", "shot=<png path>"), applied in order.
    let states = engine::args().get(1).unwrap_or("");
    for token in states.split(',') {
        if token != "" {
            shell::apply_start_state(S, token);
        }
    }
}

// Mirror was rebuilt: re-resolve node handles.
fn resolve_refs(S) {
    S.refs = [];
    for node in S.doc {
        S.refs.push(S.mirror.get_node(model::node_path(S.doc, node)));
    }
}

pub fn update(this, dt) {
    let S = this.S;
    // Smoothed frame rate for the status bar; a raw 1/dt reads as noise.
    if dt > 0.0 {
        let now = 1.0 / dt;
        S.fps = (if S.fps == 0.0 { now } else { S.fps }) * 0.9 + now * 0.1;
    }
    S.frame += 1;
    let shot_some = S.shot;
    if let Some(shot) = shot_some {
        if S.frame == 60 {
            render::screenshot(shot);
        }
    }
    let cap = S.capture;
    if cap is Object && S.frame >= cap.from && (S.frame - cap.from) % cap.every == 0 {
        render::screenshot(format!("{}/{}.png", cap.dir, padded(cap.n)));
        cap.n = cap.n + 1;
    }
    let paused = debugger::paused();
    if paused is Object && !(S.debug.paused is Object) {
        shell::on_pause(S, paused);
    }
    S.debug.paused = paused;
    if let Some(n) = S.debug.demo {
        if S.debug.paused is Object {
            S.debug.demo = Some(n + 1);
            shell::resume(S, if (n + 1) % 2 == 1 { debugger::STEP_OVER } else { debugger::CONTINUE });
        }
    }
    if S.refs.len() != S.doc.len() || model::live(S, S.sel).is_none() {
        resolve_refs(S);
    }
    // A sweep is a compile per script, so it waits for typing to stop; the
    // mirror has to be resolved first, since the scene half reads live nodes.
    lint::idle(S);
    // 2D/3D viewport mode follows the edited scene's components.
    let is2d = model::is_2d(S);
    if is2d != S.mode2d {
        S.mode2d = is2d;
        render::set_grid(!is2d, 1.0, 5, 20);
        shell::apply_camera(S);
    }
    if is2d {
        overlays::grid2d(S);
    }
    session::update(S);
    if S.session.demo is Object {
        selftest::session_step(S);
    }
    if S.layout_demo >= 0 {
        selftest::layout_step(S);
    }
    showcase::step(S);
    // A replay or a showcase feeds the pointer into the snapshot the viewport
    // tools read, so a drag would follow the feed rather than the mouse.
    if !session::scrubbing(S) && !showcase::feeding(S) {
        gizmo::update(S);
    }
    anim::update(S);
    // Scene-tree UI widgets draw during play (and for preview in the Interface
    // persona), clipped to the viewport — and only while there is one, or the
    // rect is the stale one a document is now filling.
    let rect = gizmo::viewport_rect(S);
    let widgets_on = (S.playing || S.persona == "ui") && S.viewport_live;
    ui::set_widget_layer(widgets_on, rect.x, rect.y, rect.w, rect.h);
    if S.tool == "key" && S.persona == "anim" && input::mouse_just_pressed(input::MOUSE_LEFT) {
        anim::add_key(S, S.anim.time);
    }
    gizmo::draw(S);
    plugins::draw_overlays(S);
    rig::draw(S);
    if !session::scrubbing(S) {
        polygon::idle(S);
    }
    polygon::draw(S);
    let chips = util::obj(S.chip_state.get(S.persona).unwrap_or(#{}));
    if S.persona == "scene" && chips.get("guides").unwrap_or(false) {
        overlays::guides(S);
    }
    if S.persona == "anim" && chips.get("path").unwrap_or(true) {
        overlays::motion_path(S);
    }
    if S.persona == "phys" && chips.get("colliders").unwrap_or(true) {
        if S.mode2d {
            overlays::colliders2d(S);
        } else {
            overlays::colliders(S);
        }
    }
}

pub fn draw_ui(this) {
    let S = this.S;
    // egui hands a paste to the frame it arrived on: this is the only place
    // it can be read, so ⌘V anywhere in the shell pastes a copied node.
    let pasted = ui::clipboard();
    if pasted != "" {
        model::paste_nodes(S, pasted);
    }
    let (sw, sh) = ui::screen_size();
    S.screen_w = sw;
    S.screen_h = sh;
    S.compact = sw < 1240.0;

    // Global shortcuts.
    if ui::shortcut("cmd", "K") {
        if S.palette {
            shell::close_palette(S);
        } else {
            shell::open_palette(S, "");
        }
    }
    if ui::shortcut("cmd", "S") {
        shell::save_active(S);
    }
    if ui::shortcut("cmd", "Backslash") {
        shell::toggle_split(S);
    }
    if ui::shortcut("cmd", "Equals") {
        shell::set_ui_scale(S, S.ui_scale + 0.125);
    }
    if ui::shortcut("cmd", "Minus") {
        shell::set_ui_scale(S, S.ui_scale - 0.125);
    }
    // Debugger keys work with the code editor focused: they are not text.
    if S.debug.paused is Object {
        if ui::shortcut("none", "F5") {
            shell::resume(S, debugger::CONTINUE);
        } else if ui::shortcut("none", "F10") {
            shell::resume(S, debugger::STEP_OVER);
        } else if ui::shortcut("none", "F11") {
            shell::resume(S, debugger::STEP_INTO);
        } else if ui::shortcut("shift", "F11") {
            shell::resume(S, debugger::STEP_OUT);
        }
    }
    if !ui::wants_keyboard() {
        if !(S.debug.paused is Object) && ui::shortcut("none", "F5") {
            shell::toggle_play(S);
        }
        if S.playing && !(S.debug.paused is Object) && ui::shortcut("none", "F6") {
            debugger::request_break();
        }
        let personas = ["scene", "script", "anim", "phys", "ui"];
        for (i, id) in personas.iter().enumerate() {
            if ui::shortcut("alt", format!("{}", i + 1)) {
                shell::set_persona(S, id);
            }
        }
        if ui::shortcut("shift", "A") {
            model::add_child(S, None);
        }
        // Gated with the rest, so typing in the code editor keeps egui's own
        // per-widget undo; redo first, to claim the shifted chord.
        if ui::shortcut("shift+cmd", "Z") || ui::shortcut("cmd", "Y") {
            shell::redo(S);
        } else if ui::shortcut("cmd", "Z") {
            shell::undo(S);
        }
        if ui::shortcut("alt", "L") {
            theme::set_dark(S, !S.theme.dark);
        }
        if S.persona == "anim" && ui::shortcut("none", "K") {
            anim::add_key(S, S.anim.time);
        }
        if ui::shortcut("none", "Escape") {
            polygon::cancel(S);
        }
    }

    showcase::draw(S);
    // Stage: decide what is showing, size every sheet once, then draw them.
    // Nothing below computes a rect of its own.
    center::modes(S);
    S.layout.dock_h = if docks::bottom_tall(S) { 212.0 } else { 150.0 };
    layout::compute(S);
    center::draw(S);
    for side in docks::sides() {
        docks::draw(S, S.theme, side);
    }
    chrome::persona_bar(S);
    chrome::command_bar(S);
    chrome::status_row(S);
    plugins::draw_windows(S, S.theme);
    if S.show_input {
        inputview::draw(S);
    }
    if S.fontdemo {
        selftest::font_sheet(S);
    }
    palette::draw(S);
}

// Six digits, so a frame directory sorts as it was captured.
fn padded(n) {
    let s = format!("{}", n);
    while s.len() < 6 {
        s = "0" + s;
    }
    s
}

pub fn hot_reload(this) {
    theme::apply(this.S);
}
