// The balaur editor: a regular balaur project whose modules draw the whole
// shell and edit the game given to `balaur edit`; `S` is its one state object.

mod about;
mod anim;
mod arrange;
mod bonemap;
mod statemachine;
mod center;
mod chrome;
mod complete;
mod defs;
mod dock;
mod docks;
mod docs;
mod dropin;
mod events;
mod exporter;
mod gizmo;
mod gizmo2d;
mod history;
mod icons;
mod importer;
mod inputview;
mod inspector;
mod kit;
mod layout;
mod library;
mod manager;
mod left;
mod lint;
mod menu;
mod model;
mod newnode;
mod overlays;
mod palette;
mod pen;
mod physics;
mod plugins;
mod polygon;
mod pool;
mod refactor;
mod rig;
mod selftest;
mod search;
mod session;
mod settings;
mod window;
mod shell;
mod showcase;
mod style;
mod theme;
mod textedit;
mod tiles;
mod selection;
mod util;
mod weights;
mod viewport;

// Below this many design pixels wide the shell drops every label its icon
// already says.
const COMPACT_W = 1240.0;

// The frame the splash comes off whether or not the shell has stopped moving.
const FORM_BY = 30;

/// Every field the editor keeps, at its starting value.
///
/// A function rather than a literal in `init` so `hot_reload` can fill in
/// whatever a running session predates: reload hands the old object to the
/// new code, and a field only the new code knows about is otherwise absent,
/// which errors on every frame that reads it.
pub fn fresh_state() {
    let S = #{
        persona: "scene",
        tool: "select",
        doctab: "scene",
        // A shader opened from a material; empty means the code pane shows
        // the selected node's script instead.
        shader_rel: "",
        // The shader line the viewport draws the value of; 0 draws the scene.
        preview_line: 0,
        preview_rel: "",
        docks: docks::state(),
        // The centre split: code and viewport side by side, instead of the
        // document tabs swapping one for the other.
        split: false,
        // The closable document tabs; the scene's is always there.
        script_open: false,
        events_open: false,
        zoom: 100.0,
        playing: false,
        formed: false,
        palette: false,
        palette_query: "",
        palette_submit: false,
        // Whether the picker's field has been handed the caret since it
        // opened; it takes it once, not every frame.
        picker_focused: false,
        newnode: false,
        newnode_query: "",
        renaming: false,
        rename_text: "",
        chip_state: #{},
        compact: false,
        // Empty until the first frame reads the screen, so whatever class it
        // turns out to be is a change and folds the docks accordingly.

        // The room's answers the docks were last folded for: a change is a
        // new screen, whatever the class words did.
        screen_key: "",
        ui_scale: 1.25,
        // What the reader set, kept apart from what the screen makes of it:
        // a touch screen draws larger without moving the setting.
        asked_scale: 1.25,
        touchscreen: false,
        // Whether the first frame has run: the start-up states apply on it,
        // after the screen's room has folded the docks.
        platform_read: false,
        release_at: -1,
        states_applied: false,
        start_states: "",
        script_buffers: #{},
        schemas: #{},
        expects: #{},
        opened: #{},
        script_dirty: #{},
        collapsed: #{},
        // The panel `view:<id>` asked for, reported once the shot is taken.
        view_shot: "",
        // Where the code pane is asked to scroll to, in design px; below zero
        // leaves it where the reader left it, and one frame is all it takes.
        code_scroll: -1.0,
        // The stage width the layout self-test last saw, so it asserts on a
        // settled shell rather than on the frame it was still bootstrapping.
        layout_seen: -1.0,
        // The inspector's rows, described each frame and made by `pool.rn`.
        form: [], form_draws: [], form_cursor: 0, pool: #{},
        // Bumped whenever `S.doc` is replaced, so the outliner can keep a
        // flattened tree across frames instead of rebuilding one each pass.
        doc_rev: 0,
        tree_cache: #{},
        // The selection set; `S.sel` is its head. Locks are editor state
        // keyed by node id, and isolate hides everything outside the set.
        sels: [0],
        locks: #{},
        // The outliner's component facet: "" is every node.
        tree_facet: "",
        // Four camera slots on the viewport chip row, kept for the session.
        bookmarks: #{},
        isolated: false,
        fps: 0.0,
        // -1 when the layout self-test is not running.
        layout_demo: -1,
        // The same for the row views' test, and the row it asks for.
        rows_demo: -1,
        plugin_demo: -1,
        events_demo: -1,
        palette_demo: -1,
        import_demo: -1,
        import_waited: 0,
        // The start screen's conversion under test: frames waited, and where
        // it said it landed. Unit when no test is running.
        convert_demo: (),
        rows_want: 0,
        rows_waited: 0,
        gesture_demo: -1,
        gesture_from: [],
        frame: 0,
        shot: None,
        // `frames=<dir>`: a PNG every `every` frames from `from`, numbered.
        capture: (),
        show_input: false,
        screen_w: 1280.0,
        screen_h: 800.0,
        viewport: #{ x: 322.0, y: 112.0, w: 640.0, h: 482.0, at: 0 },
        rail_visible: false,
        // Whether the stage is worth labelling: a strip of it behind an
        // unfolded panel is the way back, not a viewport.
        stage_chrome: true,
        rail_shut: false,
        chrome_off: false,
        fontdemo: false,
        menu_open: false,
        // A document is over the scene; the hooks list is beside it.
        doc_open: false,
        hooks_open: false,
        // The code with the window to itself. `focus_was` is the layout it
        // folded, and nothing but leaving focus reads it.
        focus: false,
        focus_was: (),
        layout: layout::state(),
        // Whether the centre is showing the viewport this frame, rather than
        // a document over it.
        viewport_live: true,
        mode2d: false,
        refs: [],
        sources: #{},
        // Absolute path → the `id://` a document spelled it as, so a value
        // read back off the mirror keeps the id.
        id_paths: #{},
        // The edited scene's whole document, so a save keeps what the editor
        // does not model and the mirror sees its `[[assets]]`.
        scene_doc: #{},
        listings: #{},
        clip: None,
        hooks_src: "",
        hooks_live: [],
        log_level: "all",
        log_query: "",
        // Per-frame and per-session caches, built on first use.
        log_cache: (),
        panels: (),
        palette_cache: (),
        newnode_cache: (),
        brand: (),
        mirror: (),
        theme: theme::dark(),
        gizmo: gizmo::state(),
        complete: complete::state(),
        docs: docs::state(),
        refactor: refactor::state(),
        textedit: textedit::state(),
        rig: rig::state(),
        polygon: polygon::state(),
        // Where the Physics panel's pills drew this frame, for the selftest
        // that presses them.
        phys_pills: [],
        viewport_check: (),
        camera_check: (),
        reselect: (),
        empty_note: (),
        // The row the inspector last rebound, so a row that cannot resolve is
        // retried once rather than on every frame it is selected.
        rebound: -1,
        // What each pill caption measured last time it drew, so the wrap
        // stops guessing.
        phys_widths: #{},
        phys_click: (),
        pen: pen::state(),
        weights: weights::state(),
        bonemap: bonemap::state(),
        machine: statemachine::state(),
        tiles: tiles::state(),
        anim: anim::state(),
        debug: shell::debug_state(),
        events: events::state(),
        exporter: exporter::state(),
        // This batch of imports, by the source each reports: the ones running
        // and the ones lately ended. `chrome::toast` draws them.
        jobs: #{},
        // What `imports:` still has to start, and the frame it starts on.
        import_queue: [],
        import_from: 0,
        session: session::state(),
        settings: settings::state(),
        window: window::state(),
        search: #{},
        showcase: showcase::state(),
        inputview: inputview::state(),
        library: library::state(),
        manager: manager::state(),
        lint: lint::state(),
        assets: dock::assets_state(),
        plugins: #{},
        registry: plugins::state(),
    };
    S
}

pub fn init(this) {
    let S = fresh_state();
    this.S = S;

    model::load(S);
    ui::set_loading(0.3, "");
    plugins::load(S);
    // Exports and imports run off the frame and report back here as they go.
    export::listen(this.node, #{});
    import::listen(this.node, #{});
    release::listen(this.node, #{});
    // Before the theme and the scale are pushed: the preferences decide both,
    // and until this ran they only took effect once Settings was opened.
    settings::load_files(S);
    theme::apply(S);
    chrome::set_app_icon();
    S.touchscreen = engine::platform().touchscreen;
    shell::set_ui_scale(S, shell::scale_for_screen(S));
    // The shell redraws when something asks, not every frame: on the web the
    // pass is most of the frame, and nothing in it moves untouched.
    ui::set_lazy(true);
    render::set_grid(true, 1.0, 5, 20);
    shell::apply_camera(S);
    log::info(format!("editing {} ({} nodes)", S.game_name, S.doc.len()));

    // Optional start-up states, comma-separated (persona id, "palette",
    // "light", "play", "select:<node>", "shot=<png path>"), applied in order.
    // Applied on the first frame, after the screen's class has folded the docks.
    S.start_states = engine::args().get(1).unwrap_or("");
}



// Every export reports here: started, done or failed, one call per step.
pub fn on_export(this, e) {
    exporter::report(this.S, e);
}

// A release check or install reports here, for the start screen and About.
pub fn on_release(this, e) {
    manager::heard(this.S, e);
}

// Every import reports here: what is coming, each file, then the end.
pub fn on_import(this, e) {
    let S = this.S;
    // The start screen's conversion is its own; every other import is a drop's.
    if manager::owns(S, e) {
        manager::report(S, e);
    } else {
        dropin::report(S, e);
    }
}

pub fn update(this, dt) {
    let S = this.S;
    // Smoothed frame rate for the status bar; a raw 1/dt reads as noise.
    if dt > 0.0 {
        let now = 1.0 / dt;
        S.fps = (if S.fps == 0.0 { now } else { S.fps }) * 0.9 + now * 0.1;
    }
    S.frame += 1;
    shell::release_world(S);
    // The splash holds until the shell stops moving: every box is read back a
    // pass after it was written, so the sizes correct themselves for several.
    // `FORM_BY` is where it gives up waiting.
    if !S.formed {
        let ready = S.frame >= 3 && S.refs.len() == S.doc.len() && layout::settled(S);
        if ready || S.frame >= FORM_BY {
            S.formed = true;
            ui::loaded();
        } else {
            ui::set_loading(util::clamp(0.4 + 0.06 * util::f(S.frame), 0.0, 0.95), "");
        }
    }
    let shot_some = S.shot;
    if let Some(shot) = shot_some {
        if S.frame == 60 {
            render::screenshot(shot);
            report_view(S);
        }
    }
    // Above the start screen's own return: a clip of a project converting is
    // taken on that screen, and it has no other frame to be caught on.
    let cap = S.capture;
    if cap is Object && S.frame >= cap.from && (S.frame - cap.from) % cap.every == 0 {
        render::screenshot(format!("{}/{}.png", cap.dir, padded(cap.n)));
        cap.n = cap.n + 1;
    }
    // The start screen has no scene to step, no selection to follow and no
    // gizmo to drag: what it needs from a frame is the shot, the states and
    // the showcase, whose sequence turns this screen's own pages.
    if manager::showing(S) {
        showcase::step(S);
        apply_start_states(S);
        ui::request_repaint();
        return;
    }
    let paused = debugger::paused();
    if paused is Object && !(S.debug.paused is Object) {
        shell::on_pause(S, paused);
    }
    S.debug.paused = paused;
    if let Some(n) = S.debug.demo {
        if S.debug.paused is Object {
            S.debug.demo = Some(n + 1);
            shell::resume(S, if (n + 1) % 2 == 1 { debugger::STEP_OVER } else { debugger::CONTINUE });
        }
    }
    // Nothing selected is not a stale mirror. Asking `live` about -1 rebuilt
    // the refs every frame with `get_node`, which resolves by name path and
    // so replaced the id-resolved ones a duplicate name needs.
    let stale = S.refs.len() != S.doc.len()
        || (S.sel >= 0 && model::live(S, S.sel).is_none());
    if stale {
        model::resolve_refs(S);
    }
    // A sweep is a compile per script, so it waits for typing to stop; the
    // mirror has to be resolved first, since the scene half reads live nodes.
    lint::idle(S);
    dropin::update(S);
    let is2d = model::is_2d(S);
    if is2d != S.mode2d {
        S.mode2d = is2d;
        render::set_grid(!is2d, 1.0, 5, 20);
        shell::apply_camera(S);
    }
    if is2d {
        overlays::grid2d(S);
    }
    session::update(S);
    if S.session.demo is Object {
        selftest::session_step(S);
    }
    if S.layout_demo >= 0 {
        selftest::layout_step(S);
    }
    if S.rows_demo >= 0 {
        selftest::rows_step(S);
    }
    if S.import_demo >= 0 {
        selftest::import_step(S);
    }
    if S.convert_demo is Object {
        selftest::convert_step(S);
    }
    // One queued import a frame, so a shot catches several at once.
    if !S.import_queue.is_empty() && S.frame >= S.import_from {
        let next = S.import_queue.remove(0);
        dropin::take(S, next);
    }
    if S.gesture_demo >= 0 {
        selftest::gesture_step(S);
    }
    if S.phys_click is Object {
        selftest::physics_click_step(S);
    }
    if S.viewport_check is Object {
        selftest::viewport_click_step(S);
    }
    if S.empty_note is Object {
        selftest::empty_note_step(S);
    }
    if S.reselect is Object {
        selftest::reselect_step(S);
    }
    if S.camera_check is Object {
        selftest::camera_check_step(S);
    }
    if S.settings.demo >= 0 {
        selftest::settings_step(S);
    }
    if S.machine.demo >= 0 {
        statemachine::demo_step(S);
    }
    if S.plugin_demo >= 0 {
        selftest::plugin_step(S);
    }
    if S.events_demo >= 0 {
        selftest::events_step(S);
    }
    if S.palette_demo >= 0 {
        selftest::palette_step(S);
    }
    showcase::step(S);
    // A replay or a showcase feeds the pointer into the snapshot the viewport
    // tools read, so a drag would follow the feed rather than the mouse.
    if !session::scrubbing(S) && !showcase::feeding(S) {
        // The camera's own frames: two fingers on the stage, or the mouse
        // buttons and wheel the editor drives itself. A gizmo never sees one.
        if viewport::camera_gesture(S) || viewport::mouse_camera(S) {
            render::set_camera_input(false);
        } else {
            gizmo::update(S);
        }
        textedit::update(S);
    }
    anim::update(S);
    // Scene-tree UI widgets draw during play (and for preview in the Interface
    // persona), clipped to the viewport — and only while there is one, or the
    // rect is the stale one a document is now filling.
    let rect = gizmo::viewport_rect(S);
    let widgets_on = (S.playing || S.persona == "ui") && S.viewport_live;
    // Inset by the strip the axis and zoom pills own, so a bottom-anchored
    // HUD label sits above the editor's chrome instead of under it.
    let band = if widgets_on { center::hud_h(S) + 6.0 } else { 0.0 };
    ui::set_widget_layer(widgets_on, rect.x, rect.y, rect.w, util::max(0.0, rect.h - band));
    // The window, never `S.screen_w`: that is the shell's own solved rect, and
    // a surface taken from it shrinks the shell it sizes, frame by frame.
    let (surface_w, surface_h) = ui::screen_size();
    ui::set_widget_surface("shell", true, 0.0, 0.0, surface_w, surface_h);
    if S.tool == "key" && S.persona == "anim" && input::mouse_just_pressed(input::MOUSE_LEFT) {
        anim::add_key(S, S.anim.time);
    }
    gizmo::draw(S);
    plugins::draw_overlays(S);
    rig::draw(S);
    if !session::scrubbing(S) {
        polygon::idle(S);
    }
    polygon::draw(S);
    pen::draw(S);
    tiles::draw(S);
    let chips = util::obj(S.chip_state.get(S.persona).unwrap_or(#{}));
    if S.persona == "scene" && chips.get("guides").unwrap_or(false) {
        overlays::guides(S);
    }
    if S.mode2d && chips.get("lights").unwrap_or(S.persona == "scene") {
        overlays::lights2d(S);
    }
    if S.persona == "anim" && chips.get("path").unwrap_or(true) {
        overlays::motion_path(S);
    }
    if !S.mode2d && chips.get("lights").unwrap_or(S.persona == "scene") {
        overlays::lights3d(S);
    }
    if S.persona == "phys" && chips.get("colliders").unwrap_or(true) {
        if S.mode2d {
            overlays::colliders2d(S);
        } else {
            overlays::colliders(S);
        }
    }
    // What moves without input asks for the next pass; the rest waits for one.
    // A folding dock, a gizmo drag and an import counting up all move the
    // picture while the pointer holds still, so all three are listed.
    let telling = !S.jobs.is_empty();
    if S.playing || S.showcase is Object || session::scrubbing(S) || S.capture is Object
        || S.session.demo is Object || S.layout_demo >= 0 || S.settings.demo >= 0
        || S.rows_demo >= 0 || S.machine.demo >= 0 || S.plugin_demo >= 0
        || S.events_demo >= 0 || S.palette_demo >= 0
        || S.gesture_demo >= 0 || telling
        || layout::animating(S) || S.gizmo.drag is Object
    {
        ui::request_repaint();
    }
    if let Some(_) = S.debug.demo {
        ui::request_repaint();
    }
}

// The `--state` list, applied once. Read here rather than at `init`, because
// a state that folds a dock has to run after the screen has been measured.
fn apply_start_states(S) {
    if S.states_applied {
        return;
    }
    S.states_applied = true;
    for token in S.start_states.split(',') {
        if token != "" {
            shell::apply_start_state(S, token);
        }
    }
}

pub fn draw_ui(this) {
    let S = this.S;
    // egui hands a paste to the frame it arrived on: this is the only place
    // it can be read, so ⌘V anywhere in the shell pastes a copied node.
    let pasted = ui::clipboard();
    if pasted != "" {
        model::paste_nodes(S, pasted);
    }
    // The room the shell has, which the engine solved: the window less what
    // a notch covers. Read back a pass late, as every other rect here is;
    // the window stands in until it has drawn once.
    let (sw, sh) = ui::screen_size();
    let (rw, rh) = crate::layout::shell_room(S);
    S.screen_w = if rw > 0.0 { rw } else { sw };
    S.screen_h = if rh > 0.0 { rh } else { sh };
    // Either forces it on: the setting asks for it at any width, and a narrow
    // window asks for it whatever the setting says.
    let compact = S.settings.compact || sw < COMPACT_W;
    S.compact = compact;
    let first = !S.platform_read;
    S.platform_read = true;
    docks::follow_screen(S);
    if first {
        apply_start_states(S);
    }

    // The popup owns the arrows, Tab, Enter and Escape while it is open, so
    // the shell's own keys do not fire under it.
    let completing = complete::key(S);
    if ui::shortcut("cmd+k") {
        if S.palette {
            shell::close_palette(S);
        } else {
            shell::open_palette(S, "");
        }
    }
    if ui::shortcut("cmd+s") {
        shell::save_active(S);
    }
    if ui::shortcut("alt+shift+f") {
        shell::format_active(S);
    }
    if ui::shortcut("cmd+b") {
        shell::goto_definition(S);
    }
    if ui::shortcut("cmd+shift+r") {
        refactor::open(S, "rename");
    }
    if ui::shortcut("cmd+shift+f") {
        refactor::open(S, "replace");
    }
    // Before the split's chord: a key arrives as its physical code, so `⌘\`
    // matches the shifted one too unless this consumes it first.
    if ui::shortcut("cmd+shift+backslash") {
        shell::toggle_focus(S);
    }
    if ui::shortcut("cmd+backslash") {
        shell::toggle_split(S);
    }
    if ui::shortcut("cmd+equals") {
        shell::ask_ui_scale(S, S.ui_scale + 0.125);
    }
    if ui::shortcut("cmd+minus") {
        shell::ask_ui_scale(S, S.ui_scale - 0.125);
    }
    if ui::shortcut("cmd+comma") {
        settings::open(S);
    }
    if ui::shortcut("cmd+e") {
        exporter::open(S);
    }
    // Debugger keys work with the code editor focused: they are not text.
    if S.debug.paused is Object {
        if ui::shortcut("f5") {
            shell::resume(S, debugger::CONTINUE);
        } else if ui::shortcut("f10") {
            shell::resume(S, debugger::STEP_OVER);
        } else if ui::shortcut("f11") {
            shell::resume(S, debugger::STEP_INTO);
        } else if ui::shortcut("shift+f11") {
            shell::resume(S, debugger::STEP_OUT);
        }
    }
    if !ui::wants_keyboard() {
        if !(S.debug.paused is Object) && ui::shortcut("f5") {
            shell::toggle_play(S);
        }
        if S.playing && !(S.debug.paused is Object) && ui::shortcut("f6") {
            debugger::request_break();
        }
        let personas = ["scene", "script", "anim", "phys", "ui"];
        for (i, id) in personas.iter().enumerate() {
            if ui::shortcut(format!("alt+{}", i + 1)) {
                shell::set_persona(S, id);
            }
        }
        if ui::shortcut("shift+a") {
            model::add_child(S, None);
        }
        if ui::shortcut("alt+s") {
            shell::attach_script(S);
        }
        if ui::shortcut("shift+r") {
            shell::reload_scripts(S);
        }
        // ⌘V is read from the paste event above; the clipboard cannot be read
        // on demand, so only the copy half is a chord.
        if ui::shortcut("cmd+c") {
            ui::set_clipboard(model::copy_selected(S));
        }
        // Gated with the rest, so typing in the code editor keeps egui's own
        // per-widget undo; redo first, to claim the shifted chord.
        if ui::shortcut("shift+cmd+z") || ui::shortcut("cmd+y") {
            shell::redo(S);
        } else if ui::shortcut("cmd+z") {
            shell::undo(S);
        }
        if ui::shortcut("alt+l") {
            theme::set_dark(S, !S.theme.dark);
        }
        if ui::shortcut("cmd+a") {
            selection::select_all(S);
        }
        // Shifted first, so the plain chord does not eat the shifted one.
        if ui::shortcut("shift+cmd+g") {
            arrange::ungroup(S);
        } else if ui::shortcut("cmd+g") {
            arrange::group(S);
        }
        if ui::shortcut("shift+cmd+l") {
            arrange::unlock_all(S);
        } else if ui::shortcut("cmd+l") {
            arrange::toggle_locked(S);
        }
        if ui::shortcut("shift+h") {
            arrange::show_all(S);
        } else if ui::shortcut("h") {
            arrange::toggle_hidden(S);
        }
        if ui::shortcut("slash") {
            arrange::toggle_isolate(S);
        }
        if S.persona == "anim" && ui::shortcut("k") {
            anim::add_key(S, S.anim.time);
        }
        if !completing && ui::shortcut("escape") {
            polygon::cancel(S);
            pen::cancel(S);
            tiles::cancel(S);
        }
    }

    showcase::draw(S);
    // The start screen has the window to itself: no project is open, so there
    // is no scene to draw behind it and no dock to put over it.
    if manager::showing(S) {
        manager::draw(S, S.theme);
        if S.show_input {
            inputview::draw(S);
        }
        return;
    }
    // Stage: decide what is showing, size every sheet once, then draw them.
    // Nothing below computes a rect of its own.
    center::modes(S);
    layout::compute(S);
    // After the layout: the strip drops columns as the dock narrows, so it
    // cannot be filled until the dock's width is known.
    chrome::top_bar(S);
    chrome::status_bar(S, S.theme, S.layout.bottom.w);
    chrome::toast(S, S.theme);
    docks::right_foot(S);
    center::draw(S);
    // Every dock is nodes now: the scene lays them out, paints them, and calls
    // `draw_dock_*` to fill them.
    plugins::draw_windows(S, S.theme);
    if S.show_input {
        inputview::draw(S);
    }
    if S.fontdemo {
        selftest::font_sheet(S);
    }
    // Over everything but the palette: settings is a sheet you work in, the
    // palette is a thing you summon on top of whatever you are working in.
    exporter::draw(S);
    // Under the sheets, over the viewport: a field that edits what is drawn
    // belongs with the drawing, not over a dialog.
    textedit::draw(S, S.theme);
    settings::draw(S);
    about::draw(S);
    palette::draw(S);
    newnode::draw(S);
    left::rename_draw(S);
}

// Six digits, so a frame directory sorts as it was captured.
fn padded(n) {
    let s = format!("{}", n);
    while s.len() < 6 {
        s = "0" + s;
    }
    s
}

// The shell's side docks: the scene lays the box out and paints it, and this
// fills it. `docks::draw` still owns what goes in.
pub fn draw_dock_left(this) {
    docks::draw_body(this.S, this.S.theme, "left");
}

pub fn draw_dock_right(this) {
    docks::draw_body(this.S, this.S.theme, "right");
}

// One hatch per painting view, so the scene names each rather than four of
// them sharing the dock's body.
/// Where the panel `view:<id>` asked for was drawn, in device pixels, so a
/// design pass can cut it out of the shot.
fn report_view(S) {
    if S.view_shot == "" {
        return;
    }
    let side = match docks::side_of(S, S.view_shot) {
        Some(side) => side,
        None => return,
    };
    let r = S.layout[side];
    let f = S.ui_scale;
    log::info(format!("viewrect {} {} {} {} {}", S.view_shot,
        r.x * f, r.y * f, r.w * f, r.h * f));
}

