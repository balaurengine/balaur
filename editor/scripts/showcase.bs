//! Showcase sequences: the clips the manual shows. Each is a frame-paced list
//! of the calls the UI would make plus the input a person would feed, so a
//! clip is retaken with `--state show:<name>` and nobody at the mouse.

// A step runs at its frame, a span every frame of its stretch with its
// progress; a place the pointer goes is read by `place_of` when the step
// runs, so it is where the control is then.

use anim;
use center;
use chrome;
use complete;
use defs;
use docks;
use dropin;
use editor;
use history;
use inspector;
use left;
use lint;
use manager;
use model;
use rig;
use selection;
use session;
use settings;
use shell;
use signals;
use theme;
use themewin;
use util;
use viewport;
use window;

/// A sequence under way: its frame, the steps and spans of each phase and
/// how far each phase has run, where the pointer is, and what the clip keeps
/// to put back.
pub class Sequence {
    name: str,
    at: int,
    kept: any,
    pointer: [float],
    steps: [Step],
    spans: [Span],
    seen: int,
    acts: [Step],
    spans_ui: [Span],
    seen_ui: int,
}

/// `run` with `data`, once, at frame `at`.
pub struct Step {
    at: int,
    run: fn(&mut editor::State, any),
    data: any,
}

/// `run` with `data` and how far along the span is, every frame from `from`
/// to `to`.
pub struct Span {
    from: int,
    to: int,
    run: fn(&mut editor::State, any, float),
    data: any,
}

// The tool rail's first button below the sheet's own padding, and the pitch of
// the buttons under it.
const TOOL_TOP: float = 22.0;

const TOOL_PITCH: float = 32.0;

// The code pane's first line, from the pane's own top, the pitch of the lines
// under it, and one column of its monospaced face.
const CODE_TOP: float = 21.6;

const LINE_HEIGHT: float = 16.0;

const CHAR_WIDTH: float = 7.3;

// How long the pointer takes to walk to a control, in frames. Long enough to
// read as a hand moving, short enough that a clip is not mostly travel.
const GLIDE: int = 22;

// The example script the scripting clips edit.
const SPINNER: str = "scripts/spinner.bs";

pub fn state() -> Sequence? {
    nil
}

// Whether a fed button is held: the pointer is the game's then, and a gizmo
// reading the same snapshot would drag the selection along with it.
pub fn feeding(state: editor::State) -> bool {
    state.showcase != nil && input::mouse_down(input::MOUSE_BUTTON_LEFT)
}

/// Whether a sequence is running, so the code pane leaves the popup to it.
pub fn driving(state: editor::State) -> bool {
    state.showcase != nil
}

pub fn start(state: &mut editor::State, name: str) {
    let sequence = Sequence { name: name, at: 0, kept: {}, pointer: [0.0, 0.0], steps: [], spans: [], seen: 0, acts: [], spans_ui: [], seen_ui: 0 };
    if name == "scenes" {
        scenes(state, sequence);
    } else if name == "scripting" {
        scripting(state, sequence);
    } else if name == "completion" {
        completion(state, sequence, "        physics2d::a");
    } else if name == "addon_completion" {
        completion(state, sequence, "        gamend::lobbies::");
    } else if name == "animation" {
        animation(state, sequence);
    } else if name == "physics" {
        physics(state, sequence);
    } else if name == "input" {
        input_clip(state, sequence);
    } else if name == "determinism" {
        determinism(state, sequence);
    } else if name == "shaders" {
        shaders(state, sequence);
    } else if name == "focus" {
        focusing(state, sequence);
    } else if name == "manager" {
        manager_pages(state, sequence);
    } else if name == "importing" {
        importing(state, sequence);
    } else if name == "theme_editor" {
        theme_editor(state, sequence);
    } else {
        log::warn("show:{name}: no such showcase");
        return;
    }
    state.show_input = true;
    signals::changed(state, "inputview");
    state.showcase = sequence;
    log::info("showcase {name}: {sequence.steps.len() + sequence.spans.len()} steps, {sequence.acts.len() + sequence.spans_ui.len()} acts");
}

// The update phase: input is fed here, before the game's own update reads
// the frame's snapshot. Steps fire on their frame; spans run every frame
// from `from` to `to` with their progress.
pub fn step(state: &mut editor::State) {
    if state.showcase == nil {
        return;
    }
    let sequence = state.showcase.unwrap();
    sequence.at = sequence.at + 1;
    sequence.seen = run_phase(state, sequence.steps, sequence.spans, sequence.seen, sequence.at);
}

// The act phase, at the end of the Editor's update: what a click on the
// chrome would do runs here, after the game's update, as a click does.
pub fn acts(state: &mut editor::State) {
    if state.showcase == nil {
        return;
    }
    let sequence = state.showcase.unwrap();
    sequence.seen_ui = run_phase(state, sequence.acts, sequence.spans_ui, sequence.seen_ui, sequence.at);
}

// Everything due since this phase last ran, not only what is due exactly
// now: a step missed for being one frame early would take the rest of the
// sequence with it.
fn run_phase(state: &mut editor::State, steps: [Step], spans: [Span], seen: int, now: int) -> int {
    for entry in steps {
        if entry.at > seen && entry.at <= now {
            let run = entry.run;
            run(state, entry.data);
        }
    }
    for span in spans {
        if now >= span.from && now <= span.to {
            let run = span.run;
            run(state, span.data, ((now - span.from) as float) / ((span.to - span.from) as float));
        }
    }
    now
}

fn at(sequence: Sequence, frame: int, run: fn(&mut editor::State, any), data: any) {
    sequence.steps.push(Step { at: frame, run: run, data: data });
}

fn over(sequence: Sequence, from: int, to: int, run: fn(&mut editor::State, any, float), data: any) {
    sequence.spans.push(Span { from: from, to: to, run: run, data: data });
}

fn act(sequence: Sequence, frame: int, run: fn(&mut editor::State, any), data: any) {
    sequence.acts.push(Step { at: frame, run: run, data: data });
}

fn over_ui(sequence: Sequence, from: int, to: int, run: fn(&mut editor::State, any, float), data: any) {
    sequence.spans_ui.push(Span { from: from, to: to, run: run, data: data });
}

// One of `verb`'s verbs as an act, with what else it reads.
fn act_verb(sequence: Sequence, frame: int, name: str, data: any) {
    let carried = util::copy(data);
    carried["verb"] = name;
    act(sequence, frame, verb, carried);
}

fn ease(progress: float) -> float {
    progress * progress * (3.0 - 2.0 * progress)
}

fn lerp(from: float, to: float, progress: float) -> float {
    from + (to - from) * progress
}

// Design px to the window px the snapshot holds. Where the pointer landed is
// kept on the sequence, because a glide has to know where it starts from.
fn feed_pointer(state: &mut editor::State, pointer_x: float, pointer_y: float) {
    let per_design = ui::pixels_per_design();
    input::feed_mouse(pointer_x * per_design, pointer_y * per_design);
    if state.showcase != nil {
        let sequence = state.showcase.unwrap();
        sequence.pointer = [pointer_x, pointer_y];
    }
}

// The pointer walks to a place over `from`..`to` instead of appearing there.
// Where it starts is only known once the walk begins, so the span's first
// frame reads it and the rest interpolate.
fn glide(sequence: Sequence, from: int, to: int, place: any) {
    over(sequence, from, to, gliding, { "place": place, "ready": false });
}

fn gliding(state: &mut editor::State, segment: any, progress: float) {
    if !segment["ready"].as_bool() {
        let target = place_of(state, segment["place"]);
        let was = state.showcase.unwrap().pointer;
        // Nothing has placed the pointer yet: start at the target rather
        // than sweeping in from the window's corner.
        let unplaced = was[0] == 0.0 && was[1] == 0.0;
        segment["ready"] = true;
        segment["from"] = if unplaced { target } else { was };
        segment["to"] = target;
    }
    let eased = ease(progress);
    feed_pointer(state, lerp(segment["from"][0].as_float(), segment["to"][0].as_float(), eased), lerp(segment["from"][1].as_float(), segment["to"][1].as_float(), eased));
}

// A 2D world point in design px, as a list the glides read.
fn design_of_world(state: editor::State, world_x: float, world_y: float) -> [float] {
    let at = viewport::screen_of_2d(state, world_x, world_y);
    [at.x, at.y]
}

// Where the selected node sits, in design px; the pointer's own place when
// it has none.
fn selection_spot(state: editor::State) -> [float] {
    let found = model::selected_node(state);
    if !found.is_valid() {
        return state.showcase.unwrap().pointer;
    }
    let position = found.transform.global_position();
    design_of_world(state, position.x, position.y)
}

fn press(state: &mut editor::State, data: any) {
    input::feed_mouse_button(input::MOUSE_BUTTON_LEFT, true);
}

fn release(state: &mut editor::State, data: any) {
    input::feed_mouse_button(input::MOUSE_BUTTON_LEFT, false);
}

// Each of `data.keys` down, or up.
fn keys(state: &mut editor::State, data: any) {
    for key in util::list_or_empty(data["keys"]) {
        input::feed_key(key.as_str(), data["down"].as_bool());
    }
}

// Keys held from one frame to another.
fn hold(sequence: Sequence, from: int, to: int, held: [str]) {
    at(sequence, from, keys, { "keys": held, "down": true });
    at(sequence, to, keys, { "keys": held, "down": false });
}

fn tap(sequence: Sequence, frame: int, key: str) {
    hold(sequence, frame, frame + 8, [key]);
}

// A chord held while the verb `name` runs: the overlay names the keys, which
// is the only thing that explains a shortcut nobody can see being typed.
fn chord(sequence: Sequence, frame: int, held: [str], name: str) {
    at(sequence, frame, keys, { "keys": held, "down": true });
    act_verb(sequence, frame + 3, name, {});
    at(sequence, frame + 16, keys, { "keys": held, "down": false });
}

/// Where a control sits, in design px, read off the rects `layout.bs`
/// publishes rather than measured off a screenshot. The showcase feeds the
/// snapshot and the widgets read the window, so a click here is drawn rather
/// than delivered: the sequence calls the verb itself.
fn spot(state: editor::State, name: str) -> [float] {
    let bottom = state.layout["bottom"];
    let right = state.layout["right"];
    if name.ends_with("_tab") {
        return of(chrome::workspace_spot(state, name.slice(0, name.len() - 4)));
    }
    if name == "focus_chip" {
        return of(chrome::focus_spot(state));
    }
    if name == "play" || name == "stop" {
        return of(chrome::transport_spot(state, if name == "play" { 0 } else { 2 }));
    }
    if name == "recordings" {
        // The newest recording's play button in the session list.
        return [bottom["x"].as_float() + 21.0, bottom["y"].as_float() + 94.0];
    }
    if name == "key" {
        return [bottom["x"].as_float() + 32.0, bottom["y"].as_float() + 68.0];
    }
    if name == "bone_tool" {
        return tool_spot(state, "bone");
    }
    if name == "doc_scene" || name == "doc_code" {
        return of(chrome::doc_spot(state, if name == "doc_scene" { "scene" } else { "script" }));
    }
    if name == "shader_field" {
        // Two rows deep in the inspector, whose sections are the scene's; the
        // column is the published one, the offset down it is the clip's.
        return [right["x"].as_float() + right["width"].as_float() * 0.53, right["y"].as_float() + 539.0];
    }
    if name == "scale_x" {
        let found = form_spot(state, "Scale");
        if found.len() == 2 {
            return found;
        }
        return [right["x"].as_float() + 127.0, right["y"].as_float() + 169.0];
    }
    return [state.screen_width / 2.0, state.screen_height / 2.0];
}

fn of(at: chrome::Spot) -> [float] {
    return [at.x, at.y];
}

// A tool in the rail, by the id `defs::tools` gives it in this workspace.
fn tool_spot(state: editor::State, tool: str) -> [float] {
    let rail = state.layout["rail"];
    let slot = util::position(defs::tools(state.workspace), tool);
    let index = if slot != nil { slot.unwrap() } else { 0 };
    return [rail["x"].as_float() + rail["width"].as_float() / 2.0, rail["y"].as_float() + TOOL_TOP + (index as float) * TOOL_PITCH];
}

// The centre of the node at `path`, or nothing before it has drawn.
fn centre_of(path: str) -> [float] {
    let node = scene::get_node(path);
    let rect = if node.is_valid() { ui::widget_rect(node) } else { nil };
    if rect == nil {
        return [];
    }
    let box = rect.unwrap();
    return [box.x + box.width / 2.0, box.y + box.height / 2.0];
}

// Where an inspector row's first control sits, by the label the form gave it:
// the pool answers where it drew the row, so a section moving does not move
// the pointer off it. Nothing before the form has drawn.
fn form_spot(state: editor::State, label: str) -> [float] {
    let control = inspector::control_of(state, label);
    if !control.is_valid() {
        return [];
    }
    let rect = ui::widget_rect(control);
    if rect == nil {
        return [];
    }
    let box = rect.unwrap();
    return [box.x + box.width / 2.0, box.y + box.height / 2.0];
}

// A row of the node tree, by document index: the tree answers where it drew
// it, and the dock's middle is only reached before it has drawn once.
fn row_spot(state: &mut editor::State, index: int) -> [float] {
    let found = left::row_spot(state, index);
    if found != nil {
        return [found.unwrap().x, found.unwrap().y];
    }
    let box = state.layout["left"];
    return [box["x"].as_float() + box["width"].as_float() * 0.4, box["y"].as_float() + box["height"].as_float() / 2.0];
}

// The gutter of the code editor, by line: the pane's own padding, then one
// row per line at the editor's line height.
fn gutter_spot(state: editor::State, line: int) -> [float] {
    let doc = state.layout["doc"];
    // The pane does not scroll, so a line past its foot answers with the last
    // one it shows rather than a pointer drawn below the pane.
    let last = ((doc["height"].as_float() - CODE_TOP - LINE_HEIGHT) / LINE_HEIGHT) as int + 1;
    let shown = util::int_min(line, last);
    return [doc["x"].as_float() + 17.0, doc["y"].as_float() + CODE_TOP + ((shown - 1) as float) * LINE_HEIGHT];
}

// Scroll the code pane so `line` sits `row` lines down it, and answer where its
// gutter mark then is. Offscreen the pane takes no wheel from a fed pointer, so
// the clip asks for the offset outright.
fn scrolled_gutter_spot(state: &mut editor::State, rel: str, line: int, row: int) -> [float] {
    let doc = state.layout["doc"];
    let lines = model::source(state, rel).as_str().split("\n").len();
    // The pane stops scrolling at its last line, and the cursor has to stop
    // with it: past that the mark is drawn where the line is not.
    let last = util::max(0.0, CODE_TOP + ((lines + 2) as float) * LINE_HEIGHT - doc["height"].as_float());
    let want = if line > row { ((line - row) as float) * LINE_HEIGHT } else { 0.0 };
    let off = util::min(want, last);
    state.code_scroll = off;
    return [doc["x"].as_float() + 17.0, doc["y"].as_float() + CODE_TOP + ((line - 1) as float) * LINE_HEIGHT - off];
}

// Where the start screen's control `name` sits; the middle of the window
// before it has drawn once.
fn manager_spot(state: editor::State, name: str) -> [float] {
    let found = manager::spot(state, name);
    if found != nil {
        return [found.unwrap().x, found.unwrap().y];
    }
    return [state.screen_width / 2.0, state.screen_height / 2.0];
}

/// Where a place the clip names is now, in design px. A place is one of:
/// `{ spot }` a named control, `{ row }` a tree row by node name,
/// `{ selection }`, `{ world: [x, y] }`, `{ viewport: [fraction_x, fraction_y] }`,
/// `{ gutter, rel, dx }` the line holding `gutter`, `{ scrolled, rel, row }`,
/// `{ manager }`, `{ centre }` a node's path, `{ head }` a theme head
/// button's caption, or `{ form, at }` a theme form row's control.
fn place_of(state: &mut editor::State, place: any) -> [float] {
    let found: [float] = [];
    if place.has("spot") {
        found = spot(state, place["spot"].as_str());
    } else if place.has("row") {
        let index = index_of(state, place["row"].as_str());
        found = row_spot(state, if index != nil { index.unwrap() } else { 0 });
    } else if place.has("selection") {
        found = selection_spot(state);
    } else if place.has("world") {
        found = design_of_world(state, place["world"][0].as_float(), place["world"][1].as_float());
    } else if place.has("viewport") {
        let rect = state.viewport;
        found = [rect.x + rect.width * place["viewport"][0].as_float(), rect.y + rect.height * place["viewport"][1].as_float()];
    } else if place.has("gutter") {
        let at = gutter_spot(state, line_of(state, place["rel"].as_str(), place["gutter"].as_str()));
        found = [at[0] + place["dx"].as_float(), at[1]];
    } else if place.has("scrolled") {
        let rel = place["rel"].as_str();
        found = scrolled_gutter_spot(state, rel, line_of(state, rel, place["scrolled"].as_str()), place["row"].as_int());
    } else if place.has("manager") {
        found = manager_spot(state, place["manager"].as_str());
    } else if place.has("centre") {
        found = centre_of(place["centre"].as_str());
    } else if place.has("head") {
        found = head_control(place["head"].as_str());
    } else if place.has("form") {
        found = form_control(place["form"].as_str(), place["at"].as_int());
    }
    if found.len() < 2 {
        return [0.0, 0.0];
    }
    found
}

// A place named by one key: `at_place("spot", "play")`.
fn at_place(name: str, value: any) -> any {
    { name: value }
}

// A click a viewer can follow: the cursor walks in, presses where the control
// is, the verb runs under it, and the button comes back up.
fn click(sequence: Sequence, frame: int, place: any, name: str, data: any) {
    glide(sequence, frame - GLIDE, frame, place);
    at(sequence, frame, pressed_at, { "place": place });
    act_verb(sequence, frame + 3, name, data);
    at(sequence, frame + 12, release);
}

fn pressed_at(state: &mut editor::State, data: any) {
    let at = place_of(state, data["place"]);
    feed_pointer(state, at[0], at[1]);
    press(state);
}

fn click_row(sequence: Sequence, frame: int, name: str) {
    click(sequence, frame, at_place("row", name), "choose", { "name": name });
}

fn index_of(state: editor::State, name: str) -> int? {
    for index in 0..state.nodes.len() {
        if state.nodes[index].name() == name {
            return index;
        }
    }
    nil
}

// The script at `rel` as it is open: its unsaved buffer, or the file.
fn source_of(state: &mut editor::State, rel: str) -> str {
    let buffer = state.script_buffers[state.game_root + "/" + rel];
    if buffer == nil { model::source(state, rel).as_str() } else { buffer.as_str() }
}

fn line_of(state: &mut editor::State, rel: str, needle: str) -> int {
    let lines = model::source(state, rel).as_str().split("\n");
    for index in 0..lines.len() {
        if lines[index].contains(needle) {
            return index + 1;
        }
    }
    0
}

// Change the open buffer the way typing would; `save_active` writes it.
fn edit_source(state: &mut editor::State, rel: str, from: str, to: str) {
    let absolute_path = state.game_root + "/" + rel;
    state.script_buffers[absolute_path] = source_of(state, rel).replace(from, to);
    center::code_written(state);
    state.script_dirty[absolute_path] = true;
    lint::touched(state);
    signals::bars(state);
}

fn restore_source(state: &mut editor::State, rel: str) {
    let original = state.showcase.unwrap().kept[rel].as_str();
    if original == "" {
        return;
    }
    state.script_buffers[state.game_root + "/" + rel] = original;
    center::code_written(state);
    shell::save_active(state);
}

// What the clips do, by the name a step carries, with what else it carries.
fn verb(state: &mut editor::State, data: any) {
    let name = data["verb"].as_str();
    if name == "workspace" {
        shell::set_workspace(state, data["id"].as_str());
    } else if name == "choose" {
        let index = index_of(state, data["name"].as_str());
        if index != nil {
            shell::choose(state, index.unwrap());
        }
    } else if name == "play" {
        shell::toggle_play(state);
    } else if name == "stop" {
        shell::stop_play(state);
    } else if name == "undo" {
        shell::undo(state);
    } else if name == "save" {
        shell::save_active(state);
    } else if name == "focus" {
        shell::toggle_focus(state);
    } else if name == "palette" {
        shell::open_palette(state, "");
    } else if name == "dock" {
        docks::show(state, data["id"].as_str());
    } else if name == "doctab" {
        state.doctab = data["id"].as_str();
        signals::inspector(state);
    } else if name == "shader" {
        state.shader_rel = data["rel"].as_str();
        state.doctab = "script";
        signals::inspector(state);
    } else if name == "debug_view" {
        render::set_debug_view(data["id"].as_str());
    } else if name == "zoom" {
        shell::set_zoom(state, data["to"].as_float());
    } else if name == "keep" {
        state.showcase.unwrap().kept[data["rel"].as_str()] = model::source(state, data["rel"].as_str()).as_str();
    } else if name == "edit" {
        edit_source(state, data["rel"].as_str(), data["from"].as_str(), data["to"].as_str());
    } else if name == "restore" {
        restore_source(state, data["rel"].as_str());
    } else if name == "breakpoint" {
        let rel = data["rel"].as_str();
        shell::toggle_breakpoint(state, rel, line_of(state, rel, data["needle"].as_str()));
    } else if name == "step_over" {
        if state.debug.paused.kind() == "map" {
            shell::resume(state, debugger::STEP_OVER);
        }
    } else if name == "continue" {
        if state.debug.paused.kind() == "map" {
            shell::resume(state, debugger::CONTINUE);
        }
    } else if name == "record" {
        history::record(state, data["label"].as_str());
    } else if name == "seek" {
        anim::seek(state, data["time"].as_float());
    } else if name == "key" {
        anim::add_key(state, state.anim.time);
    } else if name == "bone_tool" {
        state.tool = "bone";
        signals::inspector(state);
    } else if name == "fit_level" {
        // The angrynerds level framed for the viewport: the game's own camera
        // is set for a whole window, and the editor's panels cover its edges.
        model::set_view_2d(1.0, 2.2, 30.0);
    } else if name == "fit_figure" {
        fit_figure(state);
    } else if name == "open_newest" {
        let rows = session::listing(state);
        if rows.len() > 0 {
            session::open(state, rows[0].name);
        }
    } else if name == "verify" {
        state.session.verify = true;
        signals::changed(state, "recordings");
    } else if name == "manager" {
        manager::open(state);
    } else if name == "manager_tab" {
        state.manager.tab = data["id"].as_str();
    } else if name == "manager_new" {
        manager::open_new(state);
    } else if name == "drip_off" {
        // The queue's own drip is off; the pointer takes one file per beat.
        state.import_drip = false;
    } else if name == "import_next" {
        if state.import_queue.len() > 0 {
            dropin::take(state, state.import_queue.remove(0));
        }
    } else if name == "theme" {
        shell::close_palette(state);
        themewin::open(state);
    } else if name == "theme_duplicate" {
        themewin::duplicate(state);
    } else if name == "theme_page" {
        state.themewin.page = data["id"].as_str();
    } else if name == "theme_role" {
        themewin::show_role(state, data["id"].as_str(), "");
    } else if name == "theme_save" {
        themewin::save(state);
    } else if name == "window_hide" {
        window::hide(state);
    } else if name == "theme_put_back" {
        // Put back what the take changed on disk, with the editor still
        // wearing the copy for the frames already written.
        fs::remove(theme::path_of(state.theme["name"].as_str(), state.theme["half"].as_str()));
        if data["kept"].kind() == "str" {
            fs::write(data["prefs"].as_str(), data["kept"].as_str());
        } else {
            fs::remove(data["prefs"].as_str());
        }
    }
}

// The rig scene carries a `camera` node, which outvotes the editor's own
// zoom every frame, so the clip's framing is that node's.
fn fit_figure(state: &mut editor::State) {
    let held = state.selected;
    let found = index_of(state, "Camera");
    if found != nil {
        selection::only(state, found.unwrap());
        model::set_transform(state, found.unwrap(), rig::Parts { position: [0.6, 0.1, 0.0], rotation_euler: [], scale: [] });
        model::set_component_property(state, "camera2d", "pixels_per_unit", 150.0);
    }
    selection::only(state, held);
}

// The pointer follows a place every frame of a span, `dx` right of it by
// the end.
fn follow(state: &mut editor::State, data: any, progress: float) {
    let at = place_of(state, data["place"]);
    feed_pointer(state, at[0] + data["dx"].as_float() * ease(progress), at[1]);
}

fn following(place: any, offset_x: float) -> any {
    { "place": place, "dx": offset_x }
}

// The slingshot: grab the bird, pull down and left, let go.
fn fling(sequence: Sequence, from: int) {
    glide(sequence, from - GLIDE, from, at_place("world", [-8.0, 2.2]));
    at(sequence, from + 10, press);
    over(sequence, from + 10, from + 70, pulling);
    at(sequence, from + 80, release);
}

fn pulling(state: &mut editor::State, data: any, progress: float) {
    let eased = ease(progress);
    let at = design_of_world(state, lerp(-8.0, -10.2, eased), lerp(2.2, 1.3, eased));
    feed_pointer(state, at[0], at[1]);
}

// The screen the editor starts on: its pages in turn, then the sheet that
// makes a project from a template.
fn manager_pages(state: &mut editor::State, sequence: Sequence) {
    act_verb(sequence, 1, "manager", {});
    click(sequence, 50, at_place("manager", "examples"), "manager_tab", { "id": "examples" });
    click(sequence, 210, at_place("manager", "projects"), "manager_tab", { "id": "projects" });
    click(sequence, 330, at_place("manager", "new"), "manager_new", {});
}

// Files arriving one at a time, each let go where the pointer is: the editor
// keeps drawing while the job writes them.
fn importing(state: &mut editor::State, sequence: Sequence) {
    act_verb(sequence, 1, "workspace", { "id": defs::WORKSPACE_SCENE });
    act_verb(sequence, 1, "dock", { "id": "assets" });
    act_verb(sequence, 1, "drip_off", {});
    drop_file(sequence, 70, 0.34, 0.44);
    drop_file(sequence, 190, 0.56, 0.34);
    drop_file(sequence, 310, 0.44, 0.62);
    drop_file(sequence, 430, 0.62, 0.54);
}

// The pointer walks somewhere in the viewport and lets the next file go.
fn drop_file(sequence: Sequence, frame: int, fraction_x: float, fraction_y: float) {
    click(sequence, frame, at_place("viewport", [fraction_x, fraction_y]), "import_next", {});
}

// The code pane taking the window: a node with a script, the Focus chip
// folding the three docks away, and the shortcut putting them back.
fn focusing(state: &mut editor::State, sequence: Sequence) {
    act_verb(sequence, 1, "workspace", { "id": defs::WORKSPACE_SCRIPT });
    click_row(sequence, 40, "Spinner");
    click(sequence, 200, at_place("spot", "focus_chip"), "focus", {});
    chord(sequence, 480, [input::KEY_LEFT_SHIFT, input::KEY_LEFT_META, input::KEY_BACKSLASH], "focus");
}

// Scenes and nodes, `examples/hello`: the tree, the inspector following the
// selection, an edit, and its undo.
fn scenes(state: &mut editor::State, sequence: Sequence) {
    act_verb(sequence, 1, "workspace", { "id": defs::WORKSPACE_SCENE });
    click_row(sequence, 30, "Platform");
    click_row(sequence, 150, "Ball");
    click_row(sequence, 250, "Spinner");
    click_row(sequence, 350, "CrateB");
    click_row(sequence, 450, "Spinner");
    // A drag on the inspector's scale field, with the button held throughout.
    glide(sequence, 520 - GLIDE, 520, at_place("spot", "scale_x"));
    at(sequence, 540, press);
    at(sequence, 540, verb, { "verb": "record", "label": "scale Spinner" });
    over_ui(sequence, 540, 620, scaling);
    over(sequence, 540, 620, follow, following(at_place("spot", "scale_x"), 30.0));
    at(sequence, 630, release);
    chord(sequence, 700, [input::KEY_LEFT_META, input::KEY_Z], "undo");
}

fn scaling(state: &mut editor::State, data: any, progress: float) {
    let scale = lerp(1.0, 2.4, ease(progress));
    model::set_transform(state, state.selected, rig::Parts { position: [], rotation_euler: [], scale: [scale, scale, scale] });
}

// Scripting, `examples/hello`: a change saved while the scene runs, then a
// breakpoint stepped in the Debugger dock.
fn scripting(state: &mut editor::State, sequence: Sequence) {
    act_verb(sequence, 1, "keep", { "rel": SPINNER });
    click(sequence, 30, at_place("spot", "script_tab"), "workspace", { "id": defs::WORKSPACE_SCRIPT });
    click_row(sequence, 110, "Spinner");
    click(sequence, 200, at_place("spot", "play"), "play", {});
    // The cursor rests on the edited line, or on the last one the pane can
    // show when the edit is below its foot.
    glide(sequence, 300 - GLIDE, 300, { "gutter": "self.angle += dt", "rel": SPINNER, "dx": 220.0 });
    act_verb(sequence, 320, "edit", { "rel": SPINNER, "from": "(self.speed + nudge", "to": "(self.speed * 4.0 + nudge" });
    chord(sequence, 400, [input::KEY_LEFT_META, input::KEY_S], "save");
    // Scrolled to first: the line the breakpoint goes on is near the file's
    // foot, and a mark on a line half off the pane reads as nothing happening.
    let place: any = { "scrolled": "action_just_pressed", "rel": SPINNER, "row": 8 };
    click(sequence, 520, place, "breakpoint", { "rel": SPINNER, "needle": "action_just_pressed" });
    chord(sequence, 640, ["F10"], "step_over");
    chord(sequence, 720, ["F10"], "step_over");
    act_verb(sequence, 800, "breakpoint", { "rel": SPINNER, "needle": "let nudge" });
    act_verb(sequence, 800, "continue", {});
    act_verb(sequence, 860, "restore", { "rel": SPINNER });
}

// Completion, `examples/hello`: the caret lands after `text`, a module path,
// and the popup opens under it. The caret is placed rather than typed, the
// way `edit_source` writes the buffer rather than typing into it.
fn completion(state: &mut editor::State, sequence: Sequence, text: str) {
    act_verb(sequence, 1, "keep", { "rel": SPINNER });
    // Re-opened every frame: `center::code_pane` runs after this and would
    // otherwise close it from the widget's own caret, which offscreen is none.
    over_ui(sequence, 20, 400, completing, { "rel": SPINNER, "text": text });
    act_verb(sequence, 420, "restore", { "rel": SPINNER });
}

// Put `text` on its own line after `fn init`, where the pane already looks
// (it does not scroll to a placed caret), and open the popup at its end, at
// the gutter's own geometry, as the code pane hands it.
fn completing(state: &mut editor::State, data: any, _progress: float) {
    let rel = data["rel"].as_str();
    let text = data["text"].as_str();
    let line = line_of(state, rel, "fn init");
    let lines = model::source(state, rel).as_str().split("\n");
    let out: [str] = [];
    let head: [str] = [];
    for line_index in 0..lines.len() {
        out.push(lines[line_index]);
        if line_index < line {
            head.push(lines[line_index]);
        }
        if line_index + 1 == line {
            out.push(text);
        }
    }
    let joined = util::join(out, "\n");
    let index = util::join(head, "\n").chars().len() + 1 + text.chars().len();
    state.script_buffers[state.game_root + "/" + rel] = joined;
    let at = gutter_spot(state, line + 1);
    complete::update(state, rel, joined, complete::Caret {
        index: index,
        x: at[0] + 34.0 + (text.chars().len() as float) * CHAR_WIDTH,
        y: at[1] + LINE_HEIGHT,
    });
}

// Animation, `examples/rig`: scrub the clip, pose the thigh, key it, play.
fn animation(state: &mut editor::State, sequence: Sequence) {
    act_verb(sequence, 1, "fit_figure", {});
    click(sequence, 20, at_place("spot", "animation_tab"), "workspace", { "id": defs::WORKSPACE_ANIMATION });
    click_row(sequence, 90, "Thigh");
    click(sequence, 150, at_place("spot", "bone_tool"), "bone_tool", {});
    over_ui(sequence, 200, 340, scrubbing);
    act_verb(sequence, 380, "seek", { "time": 1.0 });
    // Drag the bone itself: the cursor sits on it while it turns.
    glide(sequence, 430 - GLIDE, 430, at_place("selection", true));
    at(sequence, 430, press);
    act_verb(sequence, 434, "record", { "label": "pose Thigh" });
    over_ui(sequence, 434, 520, posing);
    over(sequence, 434, 520, follow, following(at_place("selection", true), 0.0));
    at(sequence, 530, release);
    click(sequence, 600, at_place("spot", "key"), "key", {});
    click(sequence, 700, at_place("spot", "play"), "play", {});
    // Stopped while the figure is still on its feet: the rig's own script
    // ragdolls it a few seconds in, which reads as the clip breaking.
    click(sequence, 800, at_place("spot", "stop"), "stop", {});
}

fn scrubbing(state: &mut editor::State, data: any, progress: float) {
    anim::seek(state, 2.0 * ease(progress));
}

fn posing(state: &mut editor::State, data: any, progress: float) {
    model::set_transform(state, state.selected, rig::Parts { position: [], rotation_euler: [0.0, 0.0, lerp(0.5, 0.95, ease(progress))], scale: [] });
}

// Physics, `examples/angrynerds`: the collider overlays, then play and a
// shot at the towers.
fn physics(state: &mut editor::State, sequence: Sequence) {
    click(sequence, 20, at_place("spot", "physics_tab"), "workspace", { "id": defs::WORKSPACE_PHYSICS });
    act_verb(sequence, 23, "zoom", { "to": 45.0 });
    click_row(sequence, 80, "Bird");
    click(sequence, 150, at_place("spot", "play"), "play", {});
    act_verb(sequence, 160, "fit_level", {});
    fling(sequence, 220);
}

// Input, `examples/hello`: the overlay, fed the keys and clicks a person
// would press.
fn input_clip(state: &mut editor::State, sequence: Sequence) {
    act_verb(sequence, 1, "workspace", { "id": defs::WORKSPACE_SCENE });
    click_row(sequence, 30, "Spinner");
    click(sequence, 110, at_place("spot", "play"), "play", {});
    tap(sequence, 200, "Space");
    hold(sequence, 260, 340, [input::KEY_A]);
    hold(sequence, 370, 450, [input::KEY_D]);
    glide(sequence, 470 - GLIDE, 470, at_place("viewport", [0.3, 0.6]));
    over(sequence, 470, 520, sweeping);
    at(sequence, 530, press);
    at(sequence, 545, release);
    tap(sequence, 600, "Space");
    hold(sequence, 650, 710, [input::KEY_LEFT_SHIFT, input::KEY_W]);
}

fn sweeping(state: &mut editor::State, data: any, progress: float) {
    let rect = state.viewport;
    let eased = ease(progress);
    feed_pointer(state, rect.x + rect.width * lerp(0.3, 0.55, eased), rect.y + rect.height * lerp(0.6, 0.45, eased));
}

// Determinism, `examples/angrynerds`: play records, the bird flies, stop;
// open the session and it flies again with nobody at the mouse; scrub back,
// pause, play on.
fn determinism(state: &mut editor::State, sequence: Sequence) {
    act_verb(sequence, 1, "workspace", { "id": defs::WORKSPACE_SCENE });
    act_verb(sequence, 1, "zoom", { "to": 45.0 });
    act_verb(sequence, 1, "verify", {});
    act_verb(sequence, 1, "dock", { "id": "recordings" });
    click_row(sequence, 40, "Bird");
    click(sequence, 120, at_place("spot", "play"), "play", {});
    act_verb(sequence, 123, "dock", { "id": "recordings" });
    act_verb(sequence, 130, "fit_level", {});
    fling(sequence, 200);
    click(sequence, 520, at_place("spot", "stop"), "stop", {});
    act_verb(sequence, 523, "dock", { "id": "recordings" });
    click(sequence, 640, at_place("spot", "recordings"), "open_newest", {});
    act_verb(sequence, 650, "fit_level", {});
}

// Shaders, `examples/shaders`: the material in the inspector, its shader in
// the code editor, a channel view, and a save that relinks the sprite.
fn shaders(state: &mut editor::State, sequence: Sequence) {
    let rel = "shaders/glow.wesl";
    act_verb(sequence, 1, "workspace", { "id": defs::WORKSPACE_SCENE });
    // The dock names each previewed line and its type as it is asked for.
    act_verb(sequence, 1, "dock", { "id": "output" });
    act_verb(sequence, 1, "keep", { "rel": rel });
    click_row(sequence, 40, "Logo");
    click(sequence, 150, at_place("spot", "shader_field"), "shader", { "rel": rel });
    // No per-line value preview: `render::set_shader_preview` relinks the
    // material in a run and not in the editor, so the viewport would show the
    // same picture whichever line was asked for.
    click(sequence, 320, at_place("spot", "doc_scene"), "doctab", { "id": "scene" });
    act_verb(sequence, 400, "debug_view", { "id": "uv" });
    act_verb(sequence, 520, "debug_view", { "id": "normals" });
    act_verb(sequence, 640, "debug_view", { "id": "" });
    click(sequence, 700, at_place("spot", "doc_code"), "doctab", { "id": "script" });
    act_verb(sequence, 780, "edit", { "rel": rel, "from": "dist * params.rings", "to": "dist * params.rings * 3.0" });
    chord(sequence, 840, [input::KEY_LEFT_META, input::KEY_S], "save");
    click(sequence, 900, at_place("spot", "doc_scene"), "doctab", { "id": "scene" });
    act_verb(sequence, 1080, "doctab", { "id": "script" });
    act_verb(sequence, 1080, "restore", { "rel": rel });
}

// The Theme window, `examples/hello`: a duplicate's primary colour walked to
// amber, every token derived from it following, and a chip's padding dragged.
// The copy and the preferences file are put back.
const FORM: str = "Editor/Sheet/SheetBody/SheetSplit/SheetScroll/SheetForm";

const SIDE: str = "Editor/Sheet/SheetBody/SheetSplit/SheetSide/SheetSideRows";

// A form row's control, found by the row's label: the rows are pooled, so a
// row's index moves with whatever the page shows above it.
fn form_control(label: str, at: int) -> [float] {
    let host = scene::get_node(FORM);
    if !host.is_valid() {
        return [];
    }
    for row in host.children() {
        let named = row.get_node("L");
        if row.visible() && named.is_valid()
            && named.widget.text == label {
            return centre_of("{FORM}/{row.name()}/H/C/C{at}");
        }
    }
    return [];
}

// The head row's buttons, by their caption.
fn head_control(text: str) -> [float] {
    let slot = FORM + "/R0/H/C";
    let host = scene::get_node(slot);
    if !host.is_valid() {
        return [];
    }
    for control in host.children() {
        if control.widget.text == text {
            return centre_of(slot + "/" + control.name());
        }
    }
    return [];
}

fn mix(from: str, to: str, progress: float) -> str {
    let from_rgb = util::hex_to_rgb(from);
    let to_rgb = util::hex_to_rgb(to);
    util::to_hex([lerp(from_rgb.red, to_rgb.red, progress), lerp(from_rgb.green, to_rgb.green, progress), lerp(from_rgb.blue, to_rgb.blue, progress)])
}

fn theme_editor(state: &mut editor::State, sequence: Sequence) {
    let preferences = settings::preferences_path();
    let was = fs::read(preferences);
    act_verb(sequence, 1, "workspace", { "id": defs::WORKSPACE_SCENE });
    chord(sequence, 40, [input::KEY_LEFT_META, input::KEY_K], "palette");
    over_ui(sequence, 70, 110, typing, { "word": "theme" });
    click(sequence, 150, at_place("centre", "Editor/Picker/PickerScroll/PickerRows/R0"), "theme", {});
    click(sequence, 250, at_place("head", "Duplicate"), "theme_duplicate", {});
    // One source: the fills, the inks and the tints derived from it follow.
    glide(sequence, 330 - GLIDE, 330, { "form": "primary", "at": 0 });
    at(sequence, 330, press);
    over_ui(sequence, 335, 455, recolouring);
    at(sequence, 460, release);
    click(sequence, 540, at_place("centre", SIDE + "/C3"), "theme_page", { "id": "controls" });
    click(sequence, 620, { "form": "chip", "at": 1 }, "theme_role", { "id": "chip" });
    let padding: any = { "form": "  padding_x", "at": 0 };
    glide(sequence, 700 - GLIDE, 700, padding);
    at(sequence, 700, press);
    over_ui(sequence, 705, 785, padding_out);
    over(sequence, 705, 785, follow, following(padding, 40.0));
    at(sequence, 790, release);
    // The bar reads title, spring, Save, close: Save is its third node.
    click(sequence, 870, at_place("centre", "Editor/Sheet/SheetBar/C2"), "theme_save", {});
    click(sequence, 950, at_place("centre", "Editor/Sheet/SheetBar/C3"), "window_hide", {});
    let put_back: any = { "verb": "theme_put_back", "prefs": preferences };
    if was != nil {
        put_back["kept"] = was.unwrap();
    }
    at(sequence, 1030, verb, put_back);
}

// The palette's query typed a letter at a time.
fn typing(state: &mut editor::State, data: any, progress: float) {
    let word = data["word"].as_str();
    let last = word.len() as float;
    state.palette_query = word.slice(0, util::min(last, progress * (last + 1.0)) as int);
}

fn recolouring(state: &mut editor::State, data: any, progress: float) {
    themewin::edit(state, ["colors"], "primary", mix("#4287cc", "#c8843e", ease(progress)));
}

fn padding_out(state: &mut editor::State, data: any, progress: float) {
    themewin::edit(state, ["roles", "chip"], "padding_x", (lerp(8.0, 16.0, ease(progress)) + 0.5) as int);
}
