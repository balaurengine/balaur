// The strip along the stage's foot that the axis and zoom pills own. The
// game's screen stops short of it, so a game's bottom-anchored HUD sits above
// the editor's chrome rather than under it.

use complete;
use defs;
use disk;
use docks;
use editor;
use icons;
use layout;
use lint;
use model;
use polygon;
use polygonchips;
use shell;
use showcase;
use signals;
use style;
use util;
use words::changes;
use words::command;
use words::components;
use words::dock_fields;
use words::fields;
use words::general;
use words::hooks;
use words::layout_fields;
use words::panel_keys;
use words::roles;
use words::sides;
use words::statuses;
use words::tabs;
use words::theme_tokens;
use words::tools;
use words::window_marks;

internal const OPEN_BOTTOM: str = "open_bottom";
internal const OPEN_LEFT: str = "open_left";
internal const OPEN_RIGHT: str = "open_right";
const HEIGHT: str = "height";
const WARNING: str = "warning";
const RESTORE: str = "restore";
const CODE: str = "code";

pub struct StageFloor {
    internal width: float,
    internal height: float,
}

pub struct RailMetrics {
    internal diameter: float,
    gap: float,
    internal padding: float,
}

pub struct RailGrid {
    internal rows: float,
    internal columns: float,
    diameter: float,
    gap: float,
    padding: float,
}

pub struct StageView {
    internal safe: bool,
    internal resolution: bool,
    internal res_inset: [float],
    internal left: SheetHandle,
    internal right: SheetHandle,
    internal rail_handle: bool,
}

/// The round button that opens a side sheet over the stage.
pub struct SheetHandle {
    internal shown: bool,
    internal icon: str,
    internal tooltip: str,
}

pub struct HudView {
    internal shown: bool,
    internal inset: [any],
    internal x_ink: str,
    internal y_ink: str,
    internal zoom: str,
    internal add_icon: str,
    internal remove_icon: str,
    internal bottom: bool,
    internal bottom_icon: str,
}

pub struct OpenFile {
    relative_path: str,
    shading: bool,
    note: str,
}

pub struct CodeView {
    internal shown: bool,
    internal inset: [any],
    internal note: str,
    internal path: str,
    internal rev: int,
    internal text: any,
    internal scroll_to: float,
    internal look: Look,
}

pub struct Look {
    language: str,
    breakpoints: any,
    problems: [any],
    warnings: [any],
    current_line: int,
}

/// A function the open buffer declares, for the hooks list.
pub struct Parsed {
    name: str,
    line: int,
    detail: str,
}

// The least stage worth labelling or pointing at beside a rail: below this
// what is left is the way back to the viewport, not the viewport.
const STAGE_MIN_WIDTH: float = 160.0;

const STAGE_MIN_HEIGHT: float = 120.0;

/// The least stage the shell draws chrome on, which is also the least it
/// leaves the docks: below this a window has no scene worth pointing at.
pub fn stage_floor() -> StageFloor {
    StageFloor { width: STAGE_MIN_WIDTH, height: STAGE_MIN_HEIGHT }
}

/// The strip's height: tall enough for the controls in it, which are bigger
/// where a finger reaches them.
pub fn hud_height(state: editor::State) -> float {
    style::role_size_in_pixels(state, roles::HEADER_STAGE, HEIGHT, 30.0)
}

/// The pill either side of the zoom reading, and the axis row's own height.
pub fn hud_step(state: editor::State) -> float {
    style::role_size_in_pixels(state, roles::CHIP, HEIGHT, 20.0)
}

// The centre: the tool rail, then the viewport's chrome, the code pane or
// the event bindings over the stage. The document tabs are the top bar's.

// Which of the centre's surfaces are showing. Decided before the layout is
// computed, because the rail and the document both change what is left for
// the scene.
pub fn modes(state: &mut editor::State) {
    shell::keep_focus(state);
    // A tab the centre is showing is open, whoever pointed it there.
    if state.doctab == tabs::SCRIPT {
        state.script_open = true;
        signals::bars(state);
    }
    if state.doctab == tabs::EVENTS {
        state.events_open = true;
        signals::bars(state);
    }
    let code = state.doctab == tabs::SCRIPT;
    let document = state.doctab == tabs::EVENTS || code;
    let split = state.split && (state.doctab != tabs::EVENTS);
    let live = split || !document;
    state.viewport_live = live;
    // Into a local first: `state.doc_open = document || split` writes the result
    // into `document` too, which is the pitfall AGENTS.md names.
    let open = document || split;
    state.doc_open = open;
    let has_tools = defs::tools(state.workspace).len() > 0;
    // Each shows where its own minimum fits in the room the docks leave: a
    // rail wants its column and a stage worth pointing at beside it, and the
    // chip and foot strips want the stage taller than the two of them.
    let room = layout::stage_room(state);
    let rail = rail_metrics(state);
    let rail_width = 2.0 * rail.padding + rail.diameter;
    let rail_on = state.viewport_live && has_tools && room.width >= rail_width + STAGE_MIN_WIDTH && !state.chrome_off;
    state.rail_visible = rail_on;
    // Into a local first: a field assigned a short circuit takes the local's
    // slot too, which is the pitfall AGENTS.md names.
    let chrome = room.width >= STAGE_MIN_WIDTH && room.height >= 2.0 * hud_height(state) + STAGE_MIN_HEIGHT && !state.chrome_off;
    state.stage_chrome = chrome;
    // The hooks list only earns its 172 px when the code has the centre to
    // itself; a split is already two columns.
    let hooks_on = code && !split;
    state.hooks_open = hooks_on;
}

/// One mark's size, the gap to the next and the sheet's own inset. Public so
/// `layout.bs` can state a rail exactly as tall as what this draws into it:
/// the two disagreed by 18 px, which showed as padding only at the foot.
pub fn rail_metrics(state: editor::State) -> RailMetrics {
    // The theme's tool tile, so a folded dock's handle is the same control on
    // the same sheet, and the sheet's own air.
    RailMetrics {
        diameter: style::role_size_in_pixels(state, roles::ICON_ACTION, HEIGHT, 30.0),
        gap: style::role_size_in_pixels(state, roles::LAYOUT_MARKS, layout_fields::GAP, 4.0),
        padding: style::role_size_in_pixels(state, roles::SHEET_RAIL, layout_fields::PADDING, 6.0),
    }
}

/// The marks the rail carries: the workspace's tools, then the one that folds
/// them away. Folded, only the one that brings them back.
pub fn rail_marks(state: editor::State) -> [str] {
    if state.rail_shut {
        return [RESTORE];
    }
    let marks: [str] = [];
    for tool in defs::tools(state.workspace) {
        marks.push(tool);
    }
    marks.push(window_marks::COLLAPSE);
    marks
}

/// How the marks are laid out in a column `room` design pixels tall: as many
/// rows as fit, then as many columns as that takes. A rail that cannot fit
/// goes wider rather than running past the foot of the window.
pub fn rail_grid(state: editor::State, room: float) -> RailGrid {
    let metrics = rail_metrics(state);
    let mark_count = rail_marks(state).len() as float;
    let fits = math::max(1.0, math::floor((room - 2.0 * metrics.padding + metrics.gap) / (metrics.diameter + metrics.gap)));
    let columns = math::ceil(mark_count / math::min(mark_count, fits));
    RailGrid { rows: math::ceil(mark_count / columns), columns: columns, diameter: metrics.diameter, gap: metrics.gap, padding: metrics.padding }
}

/// What a rail of that grid measures, inset included.
pub fn rail_span(grid: RailGrid, count: float) -> float {
    2.0 * grid.padding + count * grid.diameter + (count - 1.0) * grid.gap
}

// The rail's grid, one mark a cell.
const MARKS: str = "Editor/Shell/Body/Centre/UpperRow/RailSlot/Rail/Marks";

const MARK_SCENE: str = "scenes/items/rail_mark.toml";

const AUTO: str = "auto";

/// What the rail is built from, which `signals::bars` compares.
pub fn rail_key(state: editor::State) -> [any] {
    let grid = rail_grid(state, state.layout[dock_fields::RAIL_ROOM].as_float());
    [state.workspace, state.tool, state.rail_shut, state.rail_visible, state.compact, state.touchscreen, grid.rows, grid.columns, state.theme_revision]
}

/// Fill the rail: the marks in as many rows as its height leaves room for,
/// column by column. What its script asks for.
pub fn fill_rail(state: editor::State) {
    let host = scene::root().get_node(MARKS);
    if !host.is_valid() {
        return;
    }
    let grid = rail_grid(state, state.layout[dock_fields::RAIL_ROOM].as_float());
    let rows = AUTO;
    for _ in 1..(grid.rows as int) {
        rows = rows + " " + AUTO;
    }
    host.widget_grid.grid_rows = rows;
    let marks = rail_marks(state);
    let items: [scene::RepeatItem] = [];
    for mark in marks {
        items.push(scene::RepeatItem { key: mark, scene: MARK_SCENE });
    }
    let nodes = scene::repeat(host, items);
    for index in 0..marks.len() {
        rail_mark(state, nodes[index], marks[index], grid.diameter);
    }
}

// One mark's face: a tool, or the one that folds the rail away or brings it back.
fn rail_mark(state: editor::State, node: Node, mark: str, side: float) {
    node.widget.width = side;
    node.widget_check.checked = state.tool == mark;
    if mark == window_marks::RESTORE {
        node.widget_button.icon = icons::ui(icons::RESTORE);
        node.widget.tooltip = "Show the tools";
    } else if mark == window_marks::COLLAPSE {
        node.widget_button.icon = icons::ui("collapse");
        node.widget.tooltip = "Hide the tools";
    } else {
        node.widget_button.icon = defs::tool_icon(mark);
        node.widget.tooltip = defs::tool_name(mark);
    }
}

/// A mark pressed: its tool, or the rail folded or opened.
pub fn rail_marked(state: &mut editor::State, mark: str) {
    if mark == window_marks::RESTORE || mark == window_marks::COLLAPSE {
        state.rail_shut = mark == window_marks::COLLAPSE;
        signals::bars(state);
    } else {
        shell::set_tool(state, mark);
    }
}

// The chip strip's row, whose chips are scene::repeat items.
const CHIPS: str = "Editor/Shell/Body/Centre/UpperRow/Stack/Upper/Work/Canvas/Stage/Chrome/Chips/Row";

const CHIPS_BOX: str = "Editor/Shell/Body/Centre/UpperRow/Stack/Upper/Work/Canvas/Stage/Chrome/Chips";

const CHIP_SCENE: str = "scenes/items/chip.toml";

// The strip's groups, which a pressed chip is told apart by.
const TOGGLES: str = "Toggles";

const MODES: str = "Modes";

const OPTIONS: str = "Options";

const VIEW: str = "View";

const VIEWS: str = "Views";

/// What the stage chrome, the chips and the HUD are built from, which
/// `signals::bars` compares.
pub fn stage_key(state: editor::State) -> [any] {
    let handles = docks::handles(state);
    [
        state.viewport_live,
        state.stage_chrome,
        state.chrome_off,
        state.workspace,
        state.tool,
        state.mode2d,
        "{state.chip_state[state.workspace]}",
        shell::chip_value(state, state.workspace, defs::CHIP_SLEEP),
        "{state.polygon.mode}",
        render::debug_view(),
        "{state.bookmarks}",
        state.compact,
        state.touchscreen,
        state.zoom as int,
        state.theme_revision,
        state.rail_visible,
        handles.left.shown,
        handles.right.shown,
        handles.bottom.shown,
        state.layout[panel_keys::STAGE][layout_fields::WIDTH],
        state.layout[panel_keys::STAGE][layout_fields::HEIGHT],
        hud_inset(state),
        docks::fold_inset(state),
    ]
}

/// What the stage chrome shows: the Interface guides and the handles.
pub fn stage_view(state: editor::State) -> StageView {
    let handles = docks::handles(state);
    let chrome = state.viewport_live && state.stage_chrome;
    let ui_frames = chrome && state.workspace == defs::WORKSPACE_UI;
    // The left handle sits above the tools where there is a rail, and at the
    // stage's corner where there is none.
    let over_rail = state.rail_visible;
    StageView {
        safe: ui_frames && defs::chip_on(state.chip_state, defs::WORKSPACE_UI, defs::CHIP_SAFE),
        resolution: ui_frames && defs::chip_on(state.chip_state, defs::WORKSPACE_UI, defs::CHIP_RESOLUTION),
        res_inset: frame_16_9(state.layout[panel_keys::STAGE]),
        left: SheetHandle {
            shown: state.viewport_live && handles.left.shown && !over_rail,
            icon: handles.left.icon,
            tooltip: handles.left.tooltip,
        },
        right: SheetHandle {
            shown: state.viewport_live && handles.right.shown,
            icon: handles.right.icon,
            tooltip: handles.right.tooltip,
        },
        rail_handle: handles.left.shown && over_rail,
    }
}

// The 16:9 frame inside the stage, as the inset an `absolute` child keeps.
fn frame_16_9(viewport_rect: any) -> [float] {
    let target = 16.0 / 9.0;
    let width = viewport_rect[layout_fields::WIDTH];
    let height: any = viewport_rect[layout_fields::WIDTH].as_float() / target;
    if height.as_float() > viewport_rect[layout_fields::HEIGHT].as_float() {
        height = viewport_rect[layout_fields::HEIGHT];
        width = viewport_rect[layout_fields::HEIGHT].as_float() * target;
    }
    let margin_x = math::max(0.0, (viewport_rect[layout_fields::WIDTH].as_float() - width.as_float()) / 2.0);
    let margin_y = math::max(0.0, (viewport_rect[layout_fields::HEIGHT].as_float() - height.as_float()) / 2.0);
    [margin_x, margin_y, margin_x, margin_y]
}

/// Fill the chip strip, and say whether it shows.
pub fn fill_chips(state: &mut editor::State) -> bool {
    if !(state.viewport_live && state.stage_chrome) {
        return false;
    }
    let row = scene::root().get_node(CHIPS);
    if !row.is_valid() {
        return false;
    }
    let toggles = defs::chips(state.workspace);
    let items: [scene::RepeatItem] = [];
    for definition in toggles {
        items.push(scene::RepeatItem { key: definition.key, scene: CHIP_SCENE });
    }
    let nodes = scene::repeat(row.get_node(TOGGLES), items);
    for index in 0..toggles.len() {
        let definition = toggles[index];
        let label = if definition.key == defs::CHIP_PROJECTION && state.mode2d { "2D · Orthographic" } else { definition.label };
        chip(state, nodes[index], definition.key, label, definition.starts);
    }
    row.get_node(TOGGLES).set_visible(toggles.len() > 0);
    // The Polygon tool's modes sit with the chips: Godot's UV editor tabs, in
    // the viewport rather than a window.
    let polygon = state.tool == tools::POLYGON;
    polygonchips::fill(state, row.get_node(MODES), row.get_node(OPTIONS), polygon);
    let scene_space = state.workspace == defs::WORKSPACE_SCENE;
    view_chip(row.get_node(VIEW), scene_space);
    // The camera slots are the first thing a small window drops: four
    // numbered pills for what ⌥1-4 already does.
    bookmark_chips(state, row.get_node(VIEWS), scene_space && !state.compact);
    // Clear of the folded left dock's handle, which shares this row.
    let filled = scene::root().get_node(CHIPS_BOX);
    if filled.is_valid() {
        filled.patch_component(components::WIDGET, { dock_fields::INSET: [docks::fold_inset(state), 0.0, 0.0, -1.0] });
    }
    true
}

fn chip(state: &mut editor::State, node: Node, key: str, label: str, default_on: bool?) {
    if !state.chip_state.has(state.workspace) {
        state.chip_state[state.workspace] = {};
    }
    let chips = state.chip_state[state.workspace];
    // Engine-backed chips (no declared default, see defs::chips) read their
    // value back from the engine; the rest live in `chip_state`.
    let live = shell::chip_value(state, state.workspace, key);
    if live == nil && !chips.has(key) {
        chips[key] = default_on != nil && default_on.unwrap();
    }
    node.widget.text = label;
    node.widget_check.checked = chip_on(state, key);
}

// Whether the workspace's chip `key` is on now.
fn chip_on(state: &mut editor::State, key: str) -> bool {
    let live = shell::chip_value(state, state.workspace, key);
    if live != nil { live.unwrap() } else { state.chip_state[state.workspace][key].as_bool() }
}

/// A chip pressed, by the group it sits in and its name: a toggle, a Polygon
/// mode or a camera slot.
pub fn chip_pressed(state: &mut editor::State, group: str, key: str) {
    if group == TOGGLES {
        let workspace = state.workspace;
        let now = !chip_on(state, key);
        if shell::chip_value(state, workspace, key) == nil {
            state.chip_state[workspace][key] = now;
        }
        shell::on_chip(state, workspace, key, now);
    } else if group == MODES {
        polygon::set_mode(state, key);
    } else if group == VIEWS {
        bookmark(state, key);
    }
    signals::bars(state);
}

// What the viewport draws instead of the picture: the shaded scene, or one
// channel of it. The channels come from the engine, so a plugin's is here too.
fn view_modes() -> [[str]] {
    let out = [["", "Shaded"]];
    for name in render::debug_views() {
        out.push([name, util::match_case("A", name)]);
    }
    out
}

/// The view-mode chip: shaded, or one channel drawn instead. Never a game
/// feature; `render.set_debug_view` is the same call the palette makes.
fn view_chip(node: Node, shown: bool) {
    node.set_visible(shown);
    if !shown {
        return;
    }
    let current = render::debug_view();
    let label = "Shaded";
    let labels: [str] = [];
    for mode in view_modes() {
        if mode[0] == current {
            label = mode[1];
        }
        labels.push(mode[1]);
    }
    node.widget.text = ui::glyph(icons::ui("viewmode")) + "  " + label;
    node.widget_check.checked = current != "";
    node.widget_menu.options = labels;
}

/// A view mode picked from the chip's menu, by its label.
pub fn view_picked(state: &mut editor::State, label: str) {
    for mode in view_modes() {
        if mode[1] == label {
            render::set_debug_view(mode[0]);
        }
    }
    signals::bars(state);
}

/// Four camera slots on the chip row: click to go, hold ⇧ to store where the
/// camera is now. Editor state, kept nowhere: a view is not the scene.
fn bookmark_chips(state: editor::State, views: Node, shown: bool) {
    views.set_visible(shown);
    if !shown {
        return;
    }
    for slot in views.children() {
        let key = slot.name();
        let held = state.bookmarks[key] != nil;
        slot.widget_check.checked = held;
        slot.widget.tooltip = if held { "Go to view " + key + " (⇧ stores)" } else { "⇧ click to store this view" };
    }
}

fn bookmark(state: &mut editor::State, key: str) {
    if input::key_down(input::KEY_SHIFT) {
        let camera = render::camera_pose();
        let eye_x = camera.eye.x;
        let eye_y = camera.eye.y;
        let eye_z = camera.eye.z;
        let target_x = camera.target.x;
        let target_y = camera.target.y;
        let target_z = camera.target.z;
        state.bookmarks[key] = [eye_x, eye_y, eye_z, target_x, target_y, target_z];
        log::info("stored view " + key);
        signals::bars(state);
        return;
    }
    let pose = state.bookmarks[key];
    if pose != nil {
        model::set_view_3d(pose[0].as_float(), pose[1].as_float(), pose[2].as_float(), pose[3].as_float(), pose[4].as_float(), pose[5].as_float());
    }
}

// How far the HUD stops short of the row's right edge: the code beside a
// split, which the foot does not run under.
fn hud_inset(state: editor::State) -> any {
    let row: any = state.layout["upper"];
    let viewport_rect: any = state.layout[panel_keys::STAGE];
    math::max(0.0, (row["x"].as_float() + row[layout_fields::WIDTH].as_float() - viewport_rect["x"].as_float() - viewport_rect[layout_fields::WIDTH].as_float()))
}

/// What the HUD shows along the scene's foot.
pub fn hud_view(state: editor::State) -> HudView {
    let tokens = state.theme;
    let handles = docks::handles(state);
    HudView {
        shown: state.viewport_live && state.stage_chrome && !state.chrome_off,
        inset: [0.0, -1.0, hud_inset(state), 0.0],
        x_ink: tokens[theme_tokens::AXIS_X].as_str(),
        y_ink: tokens[theme_tokens::AXIS_Y].as_str(),
        zoom: "{state.zoom as int} %",
        add_icon: icons::ui(icons::ADD),
        remove_icon: icons::ui("minimize"),
        bottom: handles.bottom.shown,
        bottom_icon: handles.bottom.icon,
    }
}

/// The HUD's and the handles' commands, by name.
pub fn stage_pressed(state: &mut editor::State, name: str) {
    if name == command::ZOOM_OUT {
        shell::set_zoom(state, state.zoom - 25.0);
    } else if name == command::ZOOM_IN {
        shell::set_zoom(state, state.zoom + 25.0);
    } else if name == OPEN_LEFT {
        docks::open_from_handle(state, sides::LEFT);
    } else if name == OPEN_RIGHT {
        docks::open_from_handle(state, sides::RIGHT);
    } else if name == OPEN_BOTTOM {
        docks::open_from_handle(state, sides::BOTTOM);
    }
    signals::bars(state);
}

// The file the code sheet shows: a shader a material opened, else the
// selected node's script. `()` with what to say instead when there is none.
fn open_file(state: editor::State) -> OpenFile {
    if state.shader_rel != "" {
        return OpenFile { relative_path: state.shader_rel, shading: true, note: "" };
    }
    let node = model::selected_node(state);
    let relative_path = model::script_rel(node);
    if relative_path != nil {
        OpenFile { relative_path: relative_path.as_str(), shading: false, note: "" }
    } else {
        OpenFile { relative_path: "", shading: false, note: "no script attached to " + (if node.is_valid() { node.name() } else { "the selection" }) }
    }
}

/// The path of the file the code sheet has open, or "" for none.
pub fn open_path(state: editor::State) -> str {
    let relative_path = open_file(state).relative_path;
    if relative_path == "" { "" } else { state.game_root + "/" + relative_path }
}

/// Say the open buffer was written from outside the editor: a format, a
/// rename, a completion accepted. The sheet writes the text again on it.
pub fn code_written(state: &mut editor::State) {
    state.code_revision += 1;
    signals::changed(state, CODE);
}

/// What the code sheet shows: where it sits against the stage, the file, its
/// text when the buffer moved under it, and the gutter's marks. Not a split's
/// events tab: that is its own panel.
pub fn code_view(state: &mut editor::State) -> CodeView {
    let shown = state.doc_open && state.doctab != tabs::EVENTS;
    if !shown {
        return CodeView {
            shown: false,
            inset: [0.0, 0.0, 0.0, 0.0],
            note: "",
            path: "",
            rev: 0,
            text: nil,
            scroll_to: 0.0,
            look: Look { language: "", breakpoints: nil, problems: [], warnings: [], current_line: 0 },
        };
    }
    let tokens = state.theme;
    let box: any = state.layout[panel_keys::STAGE_BOX];
    let doc_rect: any = state.layout[fields::DOC];
    let inset = [
        math::max(0.0, (doc_rect["x"].as_float() - box["x"].as_float())),
        math::max(0.0, (doc_rect["y"].as_float() - box["y"].as_float())),
        math::max(0.0, (box["x"].as_float() + box[layout_fields::WIDTH].as_float() - doc_rect["x"].as_float() - doc_rect[layout_fields::WIDTH].as_float())),
        math::max(0.0, (box["y"].as_float() + box[layout_fields::HEIGHT].as_float() - doc_rect["y"].as_float() - doc_rect[layout_fields::HEIGHT].as_float())),
    ];
    let file = open_file(state);
    if file.relative_path == "" {
        return CodeView {
            shown: true,
            inset: inset,
            note: file.note,
            path: "",
            rev: 0,
            text: nil,
            scroll_to: 0.0,
            look: Look { language: "", breakpoints: nil, problems: [], warnings: [], current_line: 0 },
        };
    }
    let relative_path = file.relative_path;
    let path = state.game_root + "/" + relative_path;
    let on_disk = model::source(state, relative_path);
    if on_disk == nil {
        return CodeView {
            shown: true,
            inset: inset,
            note: "missing file: " + relative_path,
            path: "",
            rev: 0,
            text: nil,
            scroll_to: 0.0,
            look: Look { language: "", breakpoints: nil, problems: [], warnings: [], current_line: 0 },
        };
    }
    let source = on_disk;
    let buffered = state.script_buffers[path];
    let text = if buffered == nil { source } else { buffered };
    let stopped_here = !file.shading && state.debug.paused.kind() == types::KIND_MAP && state.debug.paused_rel == relative_path;
    // An offset asked for is taken once.
    let scroll_to = state.code_scroll;
    state.code_scroll = -1.0;
    CodeView {
        shown: true,
        inset: inset,
        note: "",
        path: path,
        rev: state.code_revision,
        text: text,
        scroll_to: scroll_to,
        look: Look {
            language: if file.shading { "wesl" } else { "bs" },
            breakpoints: if file.shading {
                if state.preview_line > 0 { [state.preview_line] } else { [] }
            } else {
                shell::breakpoint_lines(state, relative_path)
            },
            problems: lint::lines(state, relative_path, statuses::ERROR),
            warnings: lint::lines(state, relative_path, WARNING),
            current_line: if stopped_here { state.debug.paused[layout_fields::LINE].as_int() } else { 0 },
        },
    }
}

/// What was typed into the code sheet: the buffer keeps it, unsaved, and the
/// hooks are read off it again.
pub fn code_typed(state: &mut editor::State, text: str) {
    let file = open_file(state);
    if file.relative_path == "" {
        return;
    }
    let path = state.game_root + "/" + file.relative_path;
    disk::edit(state, path, text);
    lint::touched(state);
    signals::bars(state);
    if !file.shading && read_hooks(state, file.relative_path, text) {
        signals::changed(state, CODE);
    }
}

// The functions a buffer declares, read again only when it moved. Answers
// whether it had.
fn read_hooks(state: &mut editor::State, relative_path: str, text: str) -> bool {
    if state.hooks_source == text {
        return false;
    }
    state.hooks_source = text;
    let parsed: [Parsed] = [];
    for one in script::symbols(relative_path, text) {
        if one.kind == general::FUNCTION {
            parsed.push(Parsed { name: one.name, line: one.line, detail: one.detail });
        }
    }
    state.hooks_live = parsed;
    true
}

/// The caret moved: what completes there. A shader has no script tooling
/// behind it, and a showcase sequence places its own caret.
pub fn code_caret(state: &mut editor::State, caret: complete::Caret) {
    let file = open_file(state);
    if file.relative_path == "" || file.shading {
        complete::reset(state);
        signals::changed(state, changes::COMPLETE);
        return;
    }
    if showcase::driving(state) {
        return;
    }
    let path = state.game_root + "/" + file.relative_path;
    let buffered = state.script_buffers[path];
    let text = if buffered == nil { model::source(state, file.relative_path).as_str() } else { buffered.as_str() };
    complete::update(state, file.relative_path, text, caret);
    signals::changed(state, changes::COMPLETE);
}

/// A gutter line clicked: a breakpoint in a script, and in a shader the line
/// whose value the preview shows, since a shader has no breakpoints.
pub fn code_gutter(state: &mut editor::State, line: int) {
    let file = open_file(state);
    if file.relative_path == "" {
        return;
    }
    if file.shading {
        shell::toggle_shader_preview(state, file.relative_path, line);
    } else {
        shell::toggle_breakpoint(state, file.relative_path, line);
    }
    signals::changed(state, CODE);
}

// The hooks list beside the code: a pill a function the file declares, read
// off the live buffer, and whether the buffer is unsaved.
const HOOKS: str = "Editor/Shell/Body/Centre/UpperRow/Stack/Upper/Work/Canvas/Hooks";

const PILL_SCENE: str = "scenes/items/hook_pill.toml";

/// Fill the hooks list: the file's engine-facing surface, beside the code.
pub fn fill_hooks(state: &mut editor::State) {
    let file = open_file(state);
    util::set_text(HOOKS + "/Title", if file.shading { "Shader" } else { "Hooks in file" });
    let names: [str] = [];
    if !file.shading && file.relative_path != "" {
        // The file as it is open, buffer or disk: what the list was read off
        // may be the last file's.
        let path = state.game_root + "/" + file.relative_path;
        let buffered = state.script_buffers[path];
        let text = if buffered == nil { model::source(state, file.relative_path).as_str() } else { buffered.as_str() };
        read_hooks(state, file.relative_path, text);
        for hook in state.hooks_live {
            names.push(hook.name);
        }
    }
    let items: [scene::RepeatItem] = [];
    for at in 0..names.len() {
        items.push(scene::RepeatItem { key: "{at}", scene: PILL_SCENE });
    }
    let pills = scene::repeat(scene::root().get_node(HOOKS + "/Pills"), items);
    for at in 0..names.len() {
        let lifecycle = names[at] == hooks::INIT || names[at] == hooks::UPDATE;
        pills[at].get_node("Lamp").widget.role = if lifecycle { roles::MARK_LAMP_PRIMARY } else { roles::MARK_LAMP_SECONDARY };
        pills[at].get_node("Name").widget.text = names[at];
    }
    let dirty = file.relative_path != "" && state.script_dirty.has(state.game_root + "/" + file.relative_path);
    util::set_visible(HOOKS + "/Unsaved", dirty);
}
