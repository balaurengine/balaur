// The strip along the stage's foot that the axis and zoom pills own. The
// widget layer is inset by it, so a game's bottom-anchored HUD sits above
// the editor's chrome rather than under it.
pub const HUD_H = 28.0;

// The centre: the tool rail, then the viewport's chrome, the code pane or
// the event bindings over the stage. The document tabs are the top bar's.

use crate::defs;
use crate::highlight;
use crate::icons;
use crate::lint;
use crate::model;
use crate::polygon;
use crate::shell;
use crate::style;
use crate::util;

// Which of the centre's surfaces are showing. Decided before the layout is
// computed, because the rail and the document both change what is left for
// the scene.
pub fn modes(S) {
    // A tab the centre is showing is open, whoever pointed it there.
    if S.doctab == "script" {
        S.script_open = true;
    }
    if S.doctab == "events" {
        S.events_open = true;
    }
    let code = S.doctab == "script";
    let document = S.doctab == "events" || code;
    let split = S.split && (S.doctab != "events");
    let live = split || !document;
    S.viewport_live = live;
    // Into a local first: `S.doc_open = document || split` writes the result
    // into `document` too, which is the pitfall AGENTS.md names.
    let open = document || split;
    S.doc_open = open;
    let has_tools = defs::tools(S.persona).len() > 0;
    let rail_on = S.viewport_live && has_tools;
    S.rail_visible = rail_on;
    // The hooks list only earns its 172 px when the code has the centre to
    // itself; a split is already two columns.
    let hooks_on = code && !split;
    S.hooks_open = hooks_on;
}

fn rail(S, k) {
    style::sheet(k, "rail", S.layout.rail, 0, 7, || {
        ui::vertical(|| {
            ui::spacing(4, 3);
            if S.rail_shut {
                ui::horizontal((), || {
                    ui::add_space(6);
                    if ui::circle_button(icons::ui("restore"), #{
                        role: "tool", d: 28, size: 13, tooltip: "Show the tools",
                    }) {
                        S.rail_shut = false;
                    }
                });
                return;
            }
            for tool in defs::tools(S.persona) {
                ui::horizontal((), || {
                    ui::add_space(6);
                    let active = S.tool == tool;
                    if ui::circle_button(defs::tool_icon(tool), #{
                        role: if active { "tool_on" } else { "tool" },
                        tooltip: defs::tool_name(tool),
                    }) {
                        S.tool = tool;
                    }
                });
            }
            ui::horizontal((), || {
                ui::add_space(6);
                if ui::circle_button(icons::ui("collapse"), #{
                    role: "tool", d: 22, size: 11, tooltip: "Hide the tools",
                }) {
                    S.rail_shut = true;
                }
            });
        });
    });
}

fn chip(S, k, key, label, default_on, near) {
    if !S.chip_state.contains_key(S.persona) {
        S.chip_state[S.persona] = #{};
    }
    let state = S.chip_state[S.persona];
    // Engine-backed chips (no declared default, see defs::chips) read their
    // value back from the engine every frame; the rest live in `chip_state`.
    let live = shell::chip_value(S, S.persona, key);
    if live.is_none() && !state.contains_key(key) {
        state[key] = default_on.unwrap_or(false);
    }
    let on = match live {
        Some(live) => live,
        None => state.get(key).unwrap_or(false),
    };
    let role = if on {
        if near { "chip_on" } else { "chip_on_quiet" }
    } else if near {
        "chip"
    } else {
        "chip_quiet"
    };
    if ui::pill(label, #{ role: role }) {
        if live.is_none() {
            state[key] = !on;
        }
        shell::on_chip(S, S.persona, key, !on);
    }
}

// The pointer inside the stage's top band, where the chips live.
fn chips_wanted(S, vp) {
    let (px, py) = crate::inputview::pointer(S);
    px >= vp.x && px <= vp.x + vp.w && py >= vp.y - 8.0 && py <= vp.y + 64.0
}

fn viewport(S, k) {
    let vp = S.layout.stage;
    // The chrome is placed against the stage, so an unplaced stage draws none
    // of it rather than piling it into the window's corner.
    if !style::placed(vp) {
        return;
    }
    // Interface overlays: the safe-area inset and the 16:9 frame.
    let chips_ui = util::obj(S.chip_state.get(S.persona).unwrap_or(#{}));
    if S.persona == "ui" {
        ui::overlay("vp-frames", #{ x: vp.x, y: vp.y, w: vp.w, h: vp.h }, || {
            if chips_ui.get("safe").unwrap_or(true) {
                ui::rect_stroke(34.0, 34.0, vp.w - 68.0, vp.h - 68.0, #{ color: k.accent_fill, dashed: true });
            }
            if chips_ui.get("res").unwrap_or(false) {
                let target = 16.0 / 9.0;
                let w = vp.w;
                let h = vp.w / target;
                if h > vp.h {
                    h = vp.h;
                    w = vp.h * target;
                }
                ui::rect_stroke((vp.w - w) / 2.0, (vp.h - h) / 2.0, w, h, #{ color: k.line, dashed: true });
            }
        });
    }
    // The scene is the document: the chips step back until the pointer comes
    // for them, the way a canvas tool's context bar does.
    let near = chips_wanted(S, vp);
    ui::overlay("vp-chips", #{ x: vp.x, y: vp.y }, || {
        ui::horizontal((), || {
            ui::spacing(6, 0);
            for c in defs::chips(S.persona) {
                let label = c[1];
                if c[0] == "proj" && S.mode2d {
                    label = "2D · Orthographic";
                }
                chip(S, k, c[0], label, if c.len() > 2 { Some(c[2]) } else { None }, near);
            }
            // The Polygon tool's modes sit with the chips: Godot's UV editor
            // tabs, in the viewport rather than a window.
            if S.tool == "polygon" {
                ui::add_space(8);
                polygon::mode_chips(S, k);
            }
        });
    });
    ui::overlay("vp-hud", #{ x: vp.x, y: vp.y + vp.h - HUD_H, w: vp.w, h: HUD_H }, || {
        ui::horizontal(#{ height: HUD_H }, || {
            ui::frame(#{ fill: k.panel, radius: 8, padding_x: 10, padding_y: 3 }, || {
                ui::horizontal(#{ height: 20, tight: true }, || {
                    ui::label("x →", style::mono_sm(k.accent));
                    ui::add_space(6);
                    ui::label("y ↑", style::mono_sm(k.sage));
                    ui::add_space(6);
                    ui::label("z ↓", style::mono_sm(k.dim));
                });
            });
            ui::right(|| {
                ui::frame(#{ fill: k.panel, radius: 8, padding_x: 6, padding_y: 3 }, || {
                    // A width, not `tight`: a hugging row measures zero here
                    // and `ui::right` then pushes it off the stage's edge.
                    ui::horizontal(#{ height: 20, width: 94 }, || {
                        ui::spacing(2, 0);
                        if ui::pill("−", #{ height: 20, size: 12, min_width: 20, color: k.dim }) {
                            shell::set_zoom(S, S.zoom - 25.0);
                        }
                        ui::label(format!("{} %", S.zoom as i64), style::mono_sm(k.text));
                        if ui::pill(icons::ui("add"), #{ height: 20, size: 12, min_width: 20, color: k.dim }) {
                            shell::set_zoom(S, S.zoom + 25.0);
                        }
                    });
                });
            });
        });
    });
}

// A document sheet: `code_bg` rather than `panel`, and never full-bleed —
// text under a floating sheet cannot be read.
fn document_sheet(S, k, id) {
    let r = S.layout.doc;
    if !style::placed(r) {
        return;
    }
    ui::overlay(id, #{
        x: r.x, y: r.y, w: r.w, h: r.h,
        fill: k.code_bg, stroke: k.line, radius: 11,
    }, || code_pane(S, k));
}

// The file's engine-facing surface, beside the code rather than inside it.
fn hooks_sheet(S, k) {
    let shading = S.shader_rel != "";
    let rel = if shading { S.shader_rel } else { model::script_rel(model::selected_node(S)).unwrap_or("") };
    style::sheet(k, "hooks", S.layout.hooks, 12, 0, || {
        style::section_label(k, if shading { "shader" } else { "hooks in file" });
        if !shading {
            for hook in S.hooks_live {
                style::hook_pill(k, hook.name, hook.name, "");
            }
        }
        if S.script_dirty.contains_key(S.game_root + "/" + rel) {
            ui::add_space(8);
            ui::label("● unsaved · ⌘S", util::merge(style::mono(k.accent), #{ size: 10 }));
        }
    });
}

fn script_editor(S, k) {
    document_sheet(S, k, "code");
}

// The code side of a split, beside the scene rather than over it.
fn split_code(S, k) {
    document_sheet(S, k, "split");
}

// `hooks` is off in a split, where 172 px of a narrowed pane is the code's.
fn code_pane(S, k) {
    let node = model::selected_node(S);
    // A shader opened from a material takes the pane; otherwise the
    // selected node's script does.
    let shading = S.shader_rel != "";
    let rel = if shading {
        S.shader_rel
    } else {
        match model::script_rel(node) {
            Some(rel) => rel,
            None => {
                style::empty(k, "no script attached to " + node.name);
                return;
            }
        }
    };
    let path = S.game_root + "/" + rel;
    let src = match model::source(S, rel) {
        Some(src) => src,
        None => {
            style::empty(k, "missing file: " + rel);
            return;
        }
    };
    // Hooks come from the live buffer, so they update while typing —
    // re-analysed only when that buffer actually changed.
    let current = S.script_buffers.get(path).unwrap_or(src);
    if !shading && S.hooks_src != current {
        S.hooks_src = current;
        let (_, parsed) = highlight::analyze(current);
        S.hooks_live = parsed;
    }
        // Editable, syntax-highlighted buffer (persists per file; ⌘S saves
    // and hot reloads the game code).
    ui::scroll("code", (), || {
        ui::add_space(12);
        let stopped_here = !shading && S.debug.paused is Object && S.debug.paused_rel == rel;
        let (text, changed, hit) = ui::code_editor("edit:" + path, src, #{
            size: 12.5, gutter_width: 34, gutter_color: k.faint,
            k_key: k.k_key, k_str: k.k_str, k_num: k.k_num,
            k_com: k.k_com, k_fn: k.k_fn, k_type: k.k_type,
            k_punc: k.k_punc,
            language: if shading { "wesl" } else { "rune" },
            breakpoints: if shading {
                if S.preview_line > 0 { [S.preview_line] } else { [] }
            } else {
                shell::breakpoint_lines(S, rel)
            },
            problems: lint::lines(S, rel, "error"),
            warnings: lint::lines(S, rel, "warning"),
            problem_color: k.accent, warning_color: k.sage,
            current_line: if stopped_here { S.debug.paused.line } else { () },
            breakpoint_color: k.accent, current_fill: k.accent_soft,
        });
        S.script_buffers[path] = text;
        if changed {
            S.script_dirty[path] = true;
        }
        if hit is i64 {
            // A shader's gutter has no breakpoints, so the same click
            // asks for the line's value instead.
            if shading {
                shell::toggle_shader_preview(S, rel, hit);
            } else {
                shell::toggle_breakpoint(S, rel, hit);
            }
        }
        ui::add_space(12);
    });
}

// The `events` document tab: every script's engine-facing hooks, per node.
fn events_view(S, k) {
    let r = S.layout.doc;
    if !style::placed(r) {
        return;
    }
    ui::overlay("events", #{
        x: r.x, y: r.y, w: r.w, h: r.h,
        fill: k.bg, stroke: k.line, radius: 11,
        padding_x: 20, padding_y: 14,
    }, || {
        style::section_label(k, "event bindings");
        for node in S.doc {
            let script_some = model::script_rel(node);
            if let Some(script) = script_some {
                for hook in model::hooks(S, script) {
                    style::hook_pill(k, hook.name,
                        format!("{}.{}()", node.name, hook.name),
                        format!("{}:{}", script, hook.line));
                }
            }
        }
    });
}

pub fn draw(S) {
    let k = S.theme;
    // The scene is the window: a transparent central panel is the hole egui
    // leaves for it, and every sheet floats above in the overlay layer.
    ui::central_panel(#{ transparent: true }, || {});
    if S.rail_visible {
        rail(S, k);
    }
    if S.viewport_live {
        viewport(S, k);
    }
    if S.doc_open {
        if S.doctab == "events" {
            events_view(S, k);
        } else if S.viewport_live {
            split_code(S, k);
        } else {
            script_editor(S, k);
            if S.hooks_open {
                hooks_sheet(S, k);
            }
        }
    }
}
