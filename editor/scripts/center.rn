// The strip along the stage's foot that the axis and zoom pills own. The
// widget layer is inset by it, so a game's bottom-anchored HUD sits above
// the editor's chrome rather than under it.
pub const HUD_H = 28.0;

// The least stage worth labelling or pointing at beside a rail: below this
// what is left is the way back to the viewport, not the viewport.
const STAGE_W_MIN = 160.0;
const STAGE_H_MIN = 120.0;

/// The least stage the shell draws chrome on, which is also the least it
/// leaves the docks: below this a window has no scene worth pointing at.
pub fn stage_floor() {
    #{ w: STAGE_W_MIN, h: STAGE_H_MIN }
}

/// The strip's height: tall enough for the controls in it, which are bigger
/// where a finger reaches them.
pub fn hud_h(S) {
    if S.touchscreen { 40.0 } else { HUD_H }
}

/// The pill either side of the zoom reading, and the axis row's own height.
pub fn hud_step(S) {
    if S.touchscreen { 28.0 } else { 20.0 }
}

// The centre: the tool rail, then the viewport's chrome, the code pane or
// the event bindings over the stage. The document tabs are the top bar's.

use crate::complete;
use crate::defs;
use crate::icons;
use crate::lint;
use crate::model;
use crate::polygon;
use crate::shell;
use crate::style;
use crate::util;

// Which of the centre's surfaces are showing. Decided before the layout is
// computed, because the rail and the document both change what is left for
// the scene.
pub fn modes(S) {
    shell::keep_focus(S);
    // A tab the centre is showing is open, whoever pointed it there.
    if S.doctab == "script" {
        S.script_open = true;
        crate::signals::bars(S);
    }
    if S.doctab == "events" {
        S.events_open = true;
        crate::signals::bars(S);
    }
    let code = S.doctab == "script";
    let document = S.doctab == "events" || code;
    let split = S.split && (S.doctab != "events");
    let live = split || !document;
    S.viewport_live = live;
    // Into a local first: `S.doc_open = document || split` writes the result
    // into `document` too, which is the pitfall AGENTS.md names.
    let open = document || split;
    S.doc_open = open;
    let has_tools = defs::tools(S.workspace).len() > 0;
    // Each shows where its own minimum fits in the room the docks leave: a
    // rail wants its column and a stage worth pointing at beside it, and the
    // chip and foot strips want the stage taller than the two of them.
    let room = crate::layout::stage_room(S);
    let rail = rail_metrics(S);
    let rail_w = 2.0 * rail.pad + rail.d;
    let rail_on = S.viewport_live && has_tools && room.w >= rail_w + STAGE_W_MIN
        && !S.chrome_off;
    S.rail_visible = rail_on;
    // Into a local first: a field assigned a short circuit takes the local's
    // slot too, which is the pitfall AGENTS.md names.
    let chrome = room.w >= STAGE_W_MIN && room.h >= 2.0 * hud_h(S) + STAGE_H_MIN
        && !S.chrome_off;
    S.stage_chrome = chrome;
    // The hooks list only earns its 172 px when the code has the centre to
    // itself; a split is already two columns.
    let hooks_on = code && !split;
    S.hooks_open = hooks_on;
}

/// One mark's size, the gap to the next and the sheet's own inset. Public so
/// `layout.rn` can state a rail exactly as tall as what this draws into it:
/// the two disagreed by 18 px, which showed as padding only at the foot.
pub fn rail_metrics(S) {
    // The theme's tool tile, so a folded dock's handle is the same control on
    // the same sheet; the pad a pixel wider than the gap, clear of the corner.
    let d = style::role_px(S, "icon_action", "height", 26.0);
    if S.compact {
        return #{ d: d, gap: 3.0, pad: 6.0 };
    }
    #{ d: d, gap: 4.0, pad: 8.0 }
}

/// The marks the rail carries: the workspace's tools, then the one that folds
/// them away. Folded, only the one that brings them back.
pub fn rail_marks(S) {
    if S.rail_shut {
        return ["restore"];
    }
    let marks = [];
    for tool in defs::tools(S.workspace) {
        marks.push(tool);
    }
    marks.push("collapse");
    marks
}

/// How the marks are laid out in a column `room` design pixels tall: as many
/// rows as fit, then as many columns as that takes. A rail that cannot fit
/// goes wider rather than running past the foot of the window.
pub fn rail_grid(S, room) {
    let m = rail_metrics(S);
    let n = util::f(rail_marks(S).len());
    let fits = util::max(1.0, math::floor((room - 2.0 * m.pad + m.gap) / (m.d + m.gap)));
    let cols = math::ceil(n / util::min(n, fits));
    #{ rows: math::ceil(n / cols), cols: cols, d: m.d, gap: m.gap, pad: m.pad }
}

/// What a rail of that grid measures, inset included.
pub fn rail_span(g, n) {
    2.0 * g.pad + n * g.d + (n - 1.0) * g.gap
}

// The rail's sheet, which the pool fills with a column of marks a column.
const RAIL = "Editor/Shell/Body/Centre/UpperRow/RailSlot/Rail";

/// What the rail is built from, which `signals::bars` compares.
pub fn rail_key(S) {
    let g = rail_grid(S, S.layout.rail_room);
    [S.workspace, S.tool, S.rail_shut, S.rail_visible, S.compact, S.touchscreen, g.rows, g.cols, S.theme_rev]
}

/// Fill the rail: the marks in as many columns as its height leaves room
/// for, each a node a click on which runs its tool. What its script asks for.
pub fn fill_rail(S) {
    let g = rail_grid(S, S.layout.rail_room);
    let columns = [];
    let column = [];
    for mark in rail_marks(S) {
        column.push(rail_mark(S, mark, g.d));
        if util::f(column.len()) >= g.rows {
            columns.push(#{ kind: "column", gap: [g.gap, g.gap], controls: column });
            column = [];
        }
    }
    if column.len() > 0 {
        columns.push(#{ kind: "column", gap: [g.gap, g.gap], controls: column });
    }
    util::fill(RAIL, #{ padding: g.pad, gap: [g.gap, g.gap] });
    crate::pool::strip(S, RAIL, columns);
}

// One mark: a tool, or the one that folds the rail away or brings it back.
fn rail_mark(S, mark, d) {
    let round = #{ kind: "button", role: "icon_action", text: "", width: d, height: d, padding: 0, corner_radius: d / 2.0 };
    if mark == "restore" {
        round.icon = icons::ui("restore");
        round.tooltip = "Show the tools";
        round.on = |_| {
            S.rail_shut = false;
            crate::signals::bars(S);
        };
        return round;
    }
    if mark == "collapse" {
        round.icon = icons::ui("collapse");
        round.tooltip = "Hide the tools";
        round.on = |_| {
            S.rail_shut = true;
            crate::signals::bars(S);
        };
        return round;
    }
    round.icon = defs::tool_icon(mark);
    round.tooltip = defs::tool_name(mark);
    round.checked = S.tool == mark;
    round.on = |_| { crate::shell::set_tool(S, mark); };
    round
}

// The chip strip's row, which the pool fills with a node a chip.
const CHIPS = "Editor/Shell/Body/Centre/UpperRow/Stack/Upper/Work/Canvas/Stage/Chrome/Chips/Row";
const CHIPS_BOX = "Editor/Shell/Body/Centre/UpperRow/Stack/Upper/Work/Canvas/Stage/Chrome/Chips";

/// What the stage chrome, the chips and the HUD are built from, which
/// `signals::bars` compares.
pub fn stage_key(S) {
    let handles = crate::docks::handles(S);
    [
        S.viewport_live, S.stage_chrome, S.chrome_off, S.workspace, S.tool, S.mode2d,
        format!("{:?}", S.chip_state.get(S.workspace)), shell::chip_value(S, S.workspace, defs::CHIP_SLEEP),
        format!("{:?}", S.polygon.mode), render::debug_view(), format!("{:?}", S.bookmarks),
        S.compact, S.touchscreen, S.zoom as i64, S.theme_rev, S.rail_visible,
        handles.left.shown, handles.right.shown, handles.bottom.shown,
        S.layout.stage.w, S.layout.stage.h, hud_inset(S), crate::docks::fold_inset(S),
    ]
}

/// What the stage chrome shows: the Interface guides and the handles.
pub fn stage_view(S) {
    let m = rail_metrics(S);
    let handles = crate::docks::handles(S);
    let chrome = S.viewport_live && S.stage_chrome;
    let ui_frames = chrome && S.workspace == defs::WORKSPACE_UI;
    // The left handle sits above the tools where there is a rail, and at the
    // stage's corner where there is none.
    let over_rail = S.rail_visible;
    #{
        safe: ui_frames && defs::chip_on(S, defs::WORKSPACE_UI, defs::CHIP_SAFE),
        resolution: ui_frames && defs::chip_on(S, defs::WORKSPACE_UI, defs::CHIP_RESOLUTION),
        res_inset: frame_16_9(S.layout.stage),
        left: #{
            shown: S.viewport_live && handles.left.shown && !over_rail,
            icon: handles.left.icon, tooltip: handles.left.tooltip,
        },
        right: #{
            shown: S.viewport_live && handles.right.shown,
            icon: handles.right.icon, tooltip: handles.right.tooltip,
        },
        rail_handle: handles.left.shown && over_rail,
        pad: m.pad, d: m.d,
    }
}

// The 16:9 frame inside the stage, as the inset an `absolute` child keeps.
fn frame_16_9(vp) {
    let target = 16.0 / 9.0;
    let w = vp.w;
    let h = vp.w / target;
    if h > vp.h {
        h = vp.h;
        w = vp.h * target;
    }
    let x = util::max(0.0, (vp.w - w) / 2.0);
    let y = util::max(0.0, (vp.h - h) / 2.0);
    [x, y, x, y]
}

/// Fill the chip strip, and say whether it shows. `near` is whether the
/// pointer is over it, which is when the chips step forward.
pub fn fill_chips(S, near) {
    if !(S.viewport_live && S.stage_chrome) {
        return false;
    }
    let out = [];
    for c in defs::chips(S.workspace) {
        let label = c[1];
        if c[0] == defs::CHIP_PROJECTION && S.mode2d {
            label = "2D · Orthographic";
        }
        out.push(chip(S, c[0], label, if c.len() > 2 { Some(c[2]) } else { None }, near));
    }
    // The Polygon tool's modes sit with the chips: Godot's UV editor tabs, in
    // the viewport rather than a window.
    if S.tool == "polygon" {
        out.push(#{ kind: "row", width: 2 });
        for spec in polygon::mode_specs(S) {
            out.push(spec);
        }
    }
    if S.workspace == defs::WORKSPACE_SCENE {
        out.push(#{ kind: "row", width: 2 });
        out.push(view_chip(S));
        // The camera slots are the first thing a small window drops: four
        // numbered pills for what ⌥1-4 already does.
        if !S.compact {
            out.push(#{ kind: "row", width: 0 });
            for spec in bookmark_chips(S) {
                out.push(spec);
            }
        }
    }
    crate::pool::strip(S, CHIPS, out);
    util::fill(CHIPS, #{ height: hud_h(S) });
    // Clear of the folded left dock's handle, which shares this row.
    util::fill(CHIPS_BOX, #{ inset: [crate::docks::fold_inset(S), 0.0, 0.0, -1.0], height: hud_h(S) });
    true
}

fn chip(S, key, label, default_on, near) {
    if !S.chip_state.contains_key(S.workspace) {
        S.chip_state[S.workspace] = #{};
    }
    let state = S.chip_state[S.workspace];
    // Engine-backed chips (no declared default, see defs::chips) read their
    // value back from the engine; the rest live in `chip_state`.
    let live = shell::chip_value(S, S.workspace, key);
    if live.is_none() && !state.contains_key(key) {
        state[key] = default_on.unwrap_or(false);
    }
    let on = match live {
        Some(live) => live,
        None => state.get(key).unwrap_or(false),
    };
    let workspace = S.workspace;
    #{
        kind: "button", text: label, role: if near { "chip" } else { "chip_quiet" }, checked: on,
        on: |_| {
            if live.is_none() {
                S.chip_state[workspace][key] = !on;
            }
            shell::on_chip(S, workspace, key, !on);
            crate::signals::bars(S);
        },
    }
}

// What the viewport draws instead of the picture: the shaded scene, or one
// channel of it. The channels come from the engine, so a plugin's is here too.
fn view_modes() {
    let out = [["", "Shaded"]];
    for name in render::debug_views() {
        out.push([name, crate::util::match_case("A", name)]);
    }
    out
}

/// The view-mode chip: shaded, or one channel drawn instead. Never a game
/// feature; `render.set_debug_view` is the same call the palette makes.
fn view_chip(S) {
    let k = S.theme;
    let current = render::debug_view();
    let label = "Shaded";
    let rows = [];
    for mode in view_modes() {
        if mode[0] == current {
            label = mode[1];
        }
        // Bound afresh: a closure made in a loop captures the binding.
        let name = mode[0];
        rows.push(#{
            kind: "button", role: "item_menu", text: mode[1],
            text_color: if name == current { k.primary_text } else { k.text_default },
            on: |_| {
                render::set_debug_view(name);
                crate::signals::bars(S);
            },
        });
    }
    #{
        kind: "menu", role: "chip", checked: current != "",
        text: icons::ui("viewmode") + "  " + label, controls: rows,
    }
}

/// Four camera slots on the chip row: click to go, hold ⇧ to store where the
/// camera is now. Editor state, kept nowhere: a view is not the scene.
fn bookmark_chips(S) {
    let k = S.theme;
    let out = [];
    for slot in 1..5 {
        let key = format!("{}", slot);
        let held = S.bookmarks.get(key).is_some();
        out.push(#{
            kind: "button", text: key, height: 20, font_size: style::SM, min_width: 20, corner_radius: 4,
            fill: if held { k.primary_bg } else { k.bg_control },
            text_color: if held { k.primary_text } else { k.text_subtle },
            tooltip: if held { "Go to view " + key + " (⇧ stores)" } else { "⇧ click to store this view" },
            on: |_| { bookmark(S, key); },
        });
    }
    out
}

fn bookmark(S, key) {
    if input::key_down(input::KEY_SHIFT) {
        let (ex, ey, ez, tx, ty, tz, _, _) = render::camera_pose();
        S.bookmarks[key] = [ex, ey, ez, tx, ty, tz];
        log::info("stored view " + key);
        crate::signals::bars(S);
        return;
    }
    if let Some(pose) = S.bookmarks.get(key) {
        render::set_camera(pose[0], pose[1], pose[2], pose[3], pose[4], pose[5]);
    }
}

// How far the HUD stops short of the row's right edge: the code beside a
// split, which the foot does not run under.
fn hud_inset(S) {
    let row = S.layout.upper;
    let vp = S.layout.stage;
    util::max(0.0, row.x + row.w - vp.x - vp.w)
}

/// What the HUD shows along the scene's foot.
pub fn hud_view(S) {
    let k = S.theme;
    let handles = crate::docks::handles(S);
    #{
        shown: S.viewport_live && S.stage_chrome && !S.chrome_off,
        inset: [0.0, -1.0, hud_inset(S), 0.0],
        h: hud_h(S),
        step: hud_step(S),
        x_ink: k.axis_x, y_ink: k.axis_y, quiet_ink: k.text_muted,
        zoom: format!("{} %", S.zoom as i64),
        add_icon: icons::ui("add"),
        bottom: handles.bottom.shown,
        bottom_icon: handles.bottom.icon,
    }
}

/// The HUD's and the handles' verbs, by name.
pub fn stage_verb(S, verb) {
    match verb {
        "zoom_out" => shell::set_zoom(S, S.zoom - 25.0),
        "zoom_in" => shell::set_zoom(S, S.zoom + 25.0),
        "open_left" => crate::docks::open_from_handle(S, "left"),
        "open_right" => crate::docks::open_from_handle(S, "right"),
        "open_bottom" => crate::docks::open_from_handle(S, "bottom"),
        _ => (),
    }
    crate::signals::bars(S);
}

fn viewport(S, k) {
    let vp = S.layout.stage;
    if !style::placed(vp) {
        return;
    }
    // A box select draws with the chrome hidden.
    crate::gizmo::draw_marquee(S, k);
}

// A document sheet: the sunken surface rather than `panel`, never full-bleed —
// text under a floating sheet cannot be read.
fn document_sheet(S, k, id) {
    let r = S.layout.doc;
    if !style::placed(r) {
        return;
    }
    ui::overlay(id, #{
        x: r.x, y: r.y, width: r.w, height: r.h,
        fill: k.bg_control, stroke: k.border_default, corner_radius: 11,
    }, || code_pane(S, k));
}

// The file's engine-facing surface, beside the code rather than inside it.
fn hooks_sheet(S, k) {
    let shading = S.shader_rel != "";
    let rel = if shading { S.shader_rel } else { model::script_rel(model::selected_node(S)).unwrap_or("") };
    style::sheet(k, "hooks", S.layout.hooks, 12, 0, || {
        style::section_label(k, if shading { "shader" } else { "hooks in file" });
        if !shading {
            for hook in S.hooks_live {
                style::hook_pill(k, hook.name, hook.name, "");
            }
        }
        if S.script_dirty.contains_key(S.game_root + "/" + rel) {
            ui::add_space(8);
            ui::label("● unsaved · ⌘S", util::merge(style::mono(k.primary_text), #{ font_size: style::SM }));
        }
    });
}

fn script_editor(S, k) {
    document_sheet(S, k, "code");
}

// The code side of a split, beside the scene rather than over it.
fn split_code(S, k) {
    document_sheet(S, k, "split");
}

// `hooks` is off in a split, where 172 px of a narrowed pane is the code's.
fn code_pane(S, k) {
    let node = model::selected_node(S);
    // A shader opened from a material takes the pane; otherwise the
    // selected node's script does.
    let shading = S.shader_rel != "";
    let rel = if shading {
        S.shader_rel
    } else {
        match model::script_rel(node) {
            Some(rel) => rel,
            None => {
                style::empty(k, "no script attached to " + node.name);
                return;
            }
        }
    };
    let path = S.game_root + "/" + rel;
    let src = match model::source(S, rel) {
        Some(src) => src,
        None => {
            style::empty(k, "missing file: " + rel);
            return;
        }
    };
    // Hooks come from the live buffer, so they update while typing —
    // re-analysed only when that buffer actually changed.
    let current = S.script_buffers.get(path).unwrap_or(src);
    if !shading && S.hooks_src != current {
        S.hooks_src = current;
        let found = script::symbols(rel, current);
        let parsed = [];
        if found is Vec {
            for one in found {
                if one.kind == "function" {
                    parsed.push(#{ name: one.name, line: one.line, detail: one.detail });
                }
            }
        }
        S.hooks_live = parsed;
    }
    // Editable, syntax-highlighted buffer (persists per file; ⌘S saves
    // and hot reloads the game code). An offset asked for lasts one frame.
    let scroll_to = S.code_scroll;
    S.code_scroll = -1.0;
    ui::scroll("code", #{ scroll_offset: scroll_to }, || {
        ui::add_space(12);
        let stopped_here = !shading && S.debug.paused is Object && S.debug.paused_rel == rel;
        let (text, changed, hit, caret) = ui::code_editor("edit:" + path, src, #{
            font_size: style::MD, gutter_width: 34,
            language: if shading { "wesl" } else { "rune" },
            breakpoints: if shading {
                if S.preview_line > 0 { [S.preview_line] } else { [] }
            } else {
                shell::breakpoint_lines(S, rel)
            },
            problems: lint::lines(S, rel, "error"),
            warnings: lint::lines(S, rel, "warning"),
            problem_color: k.danger_text, warning_color: k.warning_text,
            current_line: if stopped_here { S.debug.paused.line } else { () },
            breakpoint_color: k.primary_text, current_fill: k.primary_bg,
        });
        S.script_buffers[path] = text;
        if changed {
            S.script_dirty[path] = true;
            crate::signals::bars(S);
        }
        // A shader has no script tooling behind it; a Rune buffer does, and a
        // showcase sequence places its own caret.
        if shading {
            complete::reset(S);
        } else if !crate::showcase::driving(S) {
            complete::update(S, rel, text, caret);
        }
        if hit is i64 {
            // A shader's gutter has no breakpoints, so the same click
            // asks for the line's value instead.
            if shading {
                shell::toggle_shader_preview(S, rel, hit);
            } else {
                shell::toggle_breakpoint(S, rel, hit);
            }
        }
        ui::add_space(12);
    });
    complete::draw(S, S.theme);
    crate::refactor::draw(S, S.theme);
}

pub fn draw(S) {
    let k = S.theme;
    // The scene is the window: a transparent central panel is the hole egui
    // leaves for it, and every sheet floats above in the overlay layer.
    ui::central_panel(#{ transparent: true }, || {});
    if S.viewport_live {
        viewport(S, k);
    }
    // The event bindings fill a node; every other document tab draws, so the
    // node goes away for them.
    if !S.doc_open || S.doctab != "events" {
        crate::events::hide();
    }
    if S.doc_open {
        if S.doctab == "events" {
            crate::events::view(S, k);
        } else if S.viewport_live {
            split_code(S, k);
        } else {
            script_editor(S, k);
            if S.hooks_open {
                hooks_sheet(S, k);
            }
        }
    }
}
