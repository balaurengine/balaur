// The Polygon tool: trace a polygon's outline in the viewport, draw its
// polygons over interior points, place its UVs over the texture, and paint
// bone weights. Every edit lands in the node's inline `mesh` table.

use anim;
use defs;
use editor;
use history;
use model;
use signals;
use style;
use util;
use viewport;

pub class PolygonState {
    hover: int?,
    drag: int?,
    chain: [int]?,
    mode: str,
    texture: Texture?,
    bone: int?,
    radius: float,
    strength: float,
    backdrop: Node,
    picked: [int],
    threshold: float,
    tolerance: float,
    deform: [float],
}

/// A texture's size in pixels.
pub struct Size {
    w: float,
    h: float,
}

/// The texture last measured, and its size; `nil` when it would not load.
pub struct Texture {
    path: str,
    size: Size?,
}

// The mesh and frame an edit of one vertex works in.
struct Target {
    mesh: any,
    f: util::Frame,
}

/// The polygon tool's own state, hung on `S.polygon`. `chain` is the loop
/// being clicked out, `backdrop` the UV reference node, `picked` the vertices
/// the Weights dock lists and Mirror reflects.
pub fn state() -> PolygonState {
    PolygonState {
        hover: nil,
        drag: nil,
        chain: nil,
        mode: "points",
        texture: nil,
        bone: nil,
        radius: 40.0,
        strength: 0.5,
        backdrop: nil,
        picked: [],
        threshold: 0.5,
        tolerance: 2.0,
        deform: [],
    }
}

const W: float = 2.0;

const PICK_PX: float = 8.0;

const MARK_PX: float = 4.0;

// The name halves Mirror swaps a bone's weights across, longest first so
// `left` is tried before `l`. Every pair is matched both ways.
fn SIDE_PAIRS() -> [[str]] {
    [["left", "right"], ["_l_", "_r_"], ["l_", "r_"], ["_l", "_r"], [".l", ".r"]]
}

// The modes the selection offers. An `occluder2d` is an outline and nothing
// else: it has no triangles to draw, no texture to lay UVs over, and no rig.
pub fn modes(S: editor::State) -> [str] {
    if occluding(S) {
        return ["points"];
    }
    // An explicit return: a block followed by `[` parses as an index.
    return ["points", "polygons", "uv", "weights"];
}

pub fn mode_name(id: str) -> str {
    if id == "points" {
        "Points"
    } else if id == "polygons" {
        "Polygons"
    } else if id == "uv" {
        "UV"
    } else if id == "weights" {
        "Weights"
    } else {
        id
    }
}

// Which component the tool edits on this node. A `polygon` wins: a node can
// carry both, and the one with the texture is the one being drawn.
pub fn target(node: any) -> str? {
    for key in ["polygon", "occluder2d"] {
        if node.get(key).kind() == "map" {
            return key;
        }
    }
    nil
}

pub fn component(node: any) -> any {
    let key = target(node);
    if key.is_some() { node.get(key.unwrap()) } else { nil }
}

pub fn occluding(S: editor::State) -> bool {
    let key = target(model::selected_node(S));
    key.is_some() && key.unwrap() == "occluder2d"
}

// The inline mesh table under edit, or nil: a mesh that is a file reference
// is edited by making it inline first (the inspector's asset row).
pub fn mesh(S: editor::State) -> any {
    let comp = component(model::selected_node(S));
    if comp.is_nil() || comp.mesh.kind() != "map" {
        return nil;
    }
    comp.mesh
}

pub fn editable(S: editor::State) -> bool {
    let comp = component(model::selected_node(S));
    if comp.is_nil() {
        return false;
    }
    let mesh = comp.mesh;
    mesh.is_nil() || mesh.kind() == "map" || mesh.as_str() == ""
}

// The polygon's world frame, for a tool outside this module that has to
// place a vertex the way the viewport does.
pub fn world_frame(S: editor::State) -> util::Frame? {
    frame(S)
}

// One vertex in world space, deform included, as `[x, y]`.
pub fn world_point(S: &mut editor::State, mesh: any, f: util::Frame, at: int) -> [float] {
    let points = world_points(S, mesh, f, false);
    if at >= 0 && at < points.len() {
        return points[at];
    }
    return [f.x, f.y];
}

// The live node the polygon's skin names as its rig, or nil.
pub fn rig_root(S: editor::State) -> Node {
    let picked = model::selected(S);
    let comp = component(picked._0);
    let found = picked._1;
    if !found.is_valid() || comp.is_nil() {
        return nil;
    }
    let skel = comp.skeleton.as_str();
    if skel == "" { found } else { found.get_node(skel) }
}

// The polygon's world frame: how a local vertex lands on screen.
fn frame(S: editor::State) -> util::Frame? {
    let found = model::live(S, S.sel);
    if found.is_valid() {
        util::frame_of(found)
    } else {
        nil
    }
}

pub fn internal_count(mesh: any) -> int {
    util::imax(0, mesh.internal.as_int())
}

fn positions(mesh: any) -> any {
    util::vec(mesh.positions)
}

fn outline_count(mesh: any) -> int {
    positions(mesh).len() - internal_count(mesh)
}

// A stored point as numbers.
fn xy(p: any) -> [float] {
    [util::f(p[0]), util::f(p[1])]
}

// Texture pixel size for the selection, cached per path.
fn texture_size(S: &mut editor::State) -> Size? {
    let comp = component(model::selected_node(S));
    if comp.is_nil() {
        return nil;
    }
    let texture = comp.texture.as_str();
    if texture == "" {
        return nil;
    }
    if S.polygon.texture.is_some() {
        let cache = S.polygon.texture.unwrap();
        if cache.path == texture {
            return cache.size;
        }
    }
    let size = render::texture_size(S.game_root + "/" + texture);
    let found: Size? = nil;
    if size.len() == 2 {
        found = Size { w: size[0] as float, h: size[1] as float };
    } else {
        log::warn("texture {texture}: no size");
    }
    S.polygon.texture = Texture { path: texture, size: found };
    signals::inspector(S);
    found
}

fn pixels_per_unit(S: editor::State) -> float {
    let comp = component(model::selected_node(S));
    if comp.is_nil() || comp.pixels_per_unit.is_nil() {
        return util::DEFAULT_PIXELS_PER_UNIT;
    }
    util::f(comp.pixels_per_unit)
}

// The engine's default UV of a local point: the texture centred on the
// origin at `pixels_per_unit`, v downward.
fn default_uv(S: &mut editor::State, lx: float, ly: float) -> [float] {
    let size = texture_size(S);
    if size.is_none() {
        return [0.5, 0.5];
    }
    let ppu = pixels_per_unit(S);
    return [0.5 + lx * ppu / size.unwrap().w, 0.5 - ly * ppu / size.unwrap().h];
}

// A UV's place in the polygon's local frame, over the texture backdrop.
fn uv_to_local(S: &mut editor::State, u: float, v: float) -> [float] {
    let size = texture_size(S);
    if size.is_none() {
        return [u - 0.5, 0.5 - v];
    }
    let ppu = pixels_per_unit(S);
    return [(u - 0.5) * size.unwrap().w / ppu, (0.5 - v) * size.unwrap().h / ppu];
}

// Every edit records history *before* touching the mesh, then pushes the
// document's polygon onto the live node. A `key` coalesces a drag.
fn begin(S: &mut editor::State, label: str, key: str?) {
    history::record(S, label, key);
}

fn apply(S: &mut editor::State) {
    let key = target(S.doc[S.sel]);
    if key.is_some() {
        model::apply_component(S, key.unwrap());
    }
}

// The mesh, created empty when the polygon has none yet. The caller has
// already recorded history.
fn ensure_mesh(S: editor::State) -> any {
    let found = mesh(S);
    if !found.is_nil() {
        return found;
    }
    if !editable(S) {
        log::warn("this polygon's mesh is a file; embed it to edit it here");
        return nil;
    }
    let comp = component(S.doc[S.sel]);
    let none: [any] = [];
    comp.set("mesh", map().with("positions", none));
    comp.mesh
}

fn bone_list(mesh: any) -> any {
    let skin = mesh.skin;
    if skin.kind() == "map" { util::vec(skin.bones) } else { util::vec(nil) }
}

// Insert a vertex at `at`, keeping every per-vertex list square and shifting
// polygon indices past it.
fn insert_vertex(S: &mut editor::State, mesh: any, at: int, lx: float, ly: float) {
    mesh.positions.insert(at, [lx, ly]);
    let uvs = mesh.uvs;
    if uvs.kind() == "list" {
        uvs.insert(at, default_uv(S, lx, ly));
    }
    for bone in bone_list(mesh) {
        let weights = bone.weights;
        if weights.kind() == "list" {
            weights.insert(at, 0.0);
        }
    }
    for ring in util::vec(mesh.polygons) {
        for j in 0..ring.len() {
            let v = ring[j].as_int();
            if v >= at {
                ring[j] = v + 1;
            }
        }
    }
}

fn remove_at(mesh: any, at: int) {
    mesh.positions.remove(at);
    let uvs = mesh.uvs;
    if uvs.kind() == "list" && at < uvs.len() {
        uvs.remove(at);
    }
    for bone in bone_list(mesh) {
        let weights = bone.weights;
        if weights.kind() == "list" && at < weights.len() {
            weights.remove(at);
        }
    }
    if at >= outline_count(mesh) {
        mesh.set("internal", internal_count(mesh) - 1);
    }
    let kept: [any] = [];
    for ring in util::vec(mesh.polygons) {
        let uses = false;
        for j in 0..ring.len() {
            let v = ring[j].as_int();
            if v == at {
                uses = true;
            } else if v > at {
                ring[j] = v - 1;
            }
        }
        if !uses {
            kept.push(ring);
        }
    }
    if kept.len() > 0 {
        mesh.set("polygons", kept);
    } else {
        mesh.remove("polygons");
    }
}

// Add an outline vertex (after the last outline one) or an internal one, at
// a world point. Returns its index.
pub fn add_vertex(S: &mut editor::State, wx: float, wy: float, internal: bool) -> int? {
    let f = frame(S);
    if f.is_none() || !editable(S) {
        return nil;
    }
    begin(S, if internal { "add internal vertex" } else { "add vertex" }, nil);
    let mesh = ensure_mesh(S);
    if mesh.is_nil() {
        return nil;
    }
    let l = util::to_local(f.unwrap(), wx, wy);
    let at = if internal { mesh.positions.len() } else { outline_count(mesh) };
    insert_vertex(S, mesh, at, l.x, l.y);
    if internal {
        mesh.set("internal", internal_count(mesh) + 1);
    }
    apply(S);
    at
}

pub fn remove_vertex(S: &mut editor::State, at: int) {
    let mesh = mesh(S);
    if mesh.is_nil() || at >= mesh.positions.len() {
        return;
    }
    begin(S, "remove vertex", nil);
    remove_at(mesh, at);
    apply(S);
}

/// The mesh and frame an edit of vertex `at` works in, or nil when the
/// selection has no mesh, no frame, or no such vertex.
fn vertex_target(S: editor::State, at: int) -> Target? {
    let mesh = mesh(S);
    if mesh.is_nil() {
        return nil;
    }
    let f = frame(S);
    if f.is_none() || at >= mesh.positions.len() {
        return nil;
    }
    Target { mesh: mesh, f: f.unwrap() }
}

pub fn move_vertex(S: &mut editor::State, at: int, wx: float, wy: float) {
    let t = vertex_target(S, at);
    if t.is_none() {
        return;
    }
    let mesh = t.unwrap().mesh;
    let l = util::to_local(t.unwrap().f, wx, wy);
    // Armed, a drag is a deformation of the shape rather than a change to it:
    // the offset moves and the mesh the clip deforms stays where it was.
    if deforming(S) {
        let rest = xy(mesh.positions[at]);
        set_deform(S, at, l.x - rest[0], l.y - rest[1]);
        return;
    }
    begin(S, "move vertex", "poly:move:{S.sel}:{at}");
    mesh.positions[at] = [l.x, l.y];
    apply(S);
}

pub fn close_loop(S: &mut editor::State) {
    if S.polygon.chain.is_none() {
        return;
    }
    let ring = S.polygon.chain.unwrap();
    if mesh(S).is_nil() || ring.len() < 3 {
        S.polygon.chain = nil;
        signals::inspector(S);
        return;
    }
    begin(S, "draw polygon", nil);
    let mesh = mesh(S);
    if mesh.polygons.kind() != "list" {
        let none: [any] = [];
        mesh.set("polygons", none);
    }
    mesh.polygons.push(ring);
    S.polygon.chain = nil;
    signals::inspector(S);
    apply(S);
}

// Back to automatic triangulation of the outline.
pub fn clear_polygons(S: &mut editor::State) {
    let mesh = mesh(S);
    if mesh.is_nil() || !mesh.has("polygons") {
        return;
    }
    begin(S, "clear polygons", nil);
    mesh.remove("polygons");
    apply(S);
}

// UVs materialised from the defaults, so one can be moved on its own.
fn ensure_uvs(S: &mut editor::State, mesh: any) -> any {
    let uvs = mesh.uvs;
    if uvs.kind() == "list" && uvs.len() == mesh.positions.len() {
        return uvs;
    }
    let made: [any] = [];
    for p in positions(mesh) {
        let q = xy(p);
        made.push(default_uv(S, q[0], q[1]));
    }
    mesh.set("uvs", made);
    mesh.uvs
}

pub fn move_uv(S: &mut editor::State, at: int, wx: float, wy: float) {
    let t = vertex_target(S, at);
    if t.is_none() {
        return;
    }
    begin(S, "move uv", "poly:uv:{S.sel}:{at}");
    let uvs = ensure_uvs(S, t.unwrap().mesh);
    let l = util::to_local(t.unwrap().f, wx, wy);
    uvs[at] = default_uv(S, l.x, l.y);
    apply(S);
}

// The rig's bones, as paths relative to the rig root the polygon names.
fn rig_bone_paths(S: editor::State) -> [str]? {
    let picked = model::selected(S);
    if !picked._1.is_valid() || component(picked._0).is_nil() {
        return nil;
    }
    let rig = rig_root(S);
    if !rig.is_valid() {
        log::warn("polygon rig '{component(picked._0).skeleton.as_str()}' names no node");
        return nil;
    }
    let base = rig.path();
    let paths: [str] = [];
    for bone in skeleton::bones(rig) {
        let full = bone.path();
        if full != base {
            paths.push(full.slice(base.len() + 1, full.len()));
        }
    }
    paths
}

// Sync Bones to Polygon: the skin lists the rig's bones, in rig order,
// keeping the weights of any it already had.
pub fn sync_bones(S: &mut editor::State) {
    let paths = rig_bone_paths(S);
    if paths.is_none() || !editable(S) {
        return;
    }
    begin(S, "sync bones to polygon", nil);
    let mesh = ensure_mesh(S);
    if mesh.is_nil() {
        return;
    }
    let had = map();
    for bone in bone_list(mesh) {
        had.set(bone.path.as_str(), util::vec(bone.weights));
    }
    let count = mesh.positions.len();
    let bones: [any] = [];
    for path in paths.unwrap() {
        let weights: [float] = [];
        for w in util::vec(had.get(path)) {
            weights.push(util::f(w));
        }
        while weights.len() < count {
            weights.push(0.0);
        }
        bones.push(map().with("path", path).with("weights", weights));
    }
    mesh.set("skin", map().with("bones", bones));
    S.polygon.bone = if bones.len() > 0 { 0 } else { nil };
    signals::inspector(S);
    apply(S);
    log::info("{bones.len()} bones synced to the polygon");
}

pub fn bones(S: editor::State) -> any {
    let mesh = mesh(S);
    if mesh.is_nil() { util::vec(nil) } else { bone_list(mesh) }
}

// Add `amount` (negative to unpaint) to the active bone's weight on vertex
// `at`, clamped; the engine renormalises across bones when it loads.
pub fn paint(S: &mut editor::State, at: int, amount: float) {
    let mesh = mesh(S);
    if mesh.is_nil() || S.polygon.bone.is_none() {
        return;
    }
    let bone = bones(S).at(S.polygon.bone.unwrap());
    if bone.is_nil() || at >= mesh.positions.len() {
        return;
    }
    begin(S, "paint weights", "poly:paint:{S.sel}");
    if bone.weights.kind() != "list" {
        let none: [float] = [];
        bone.set("weights", none);
    }
    let weights = bone.weights;
    while weights.len() <= at {
        weights.push(0.0);
    }
    weights[at] = util::clamp(util::f(weights[at]) + amount, 0.0, 1.0);
    apply(S);
}

// The vertices the Weights dock lists and Mirror reflects. An empty pick
// means the whole mesh, so a first-time user gets the obvious thing.
pub fn picked(S: editor::State) -> [int] {
    let mesh = mesh(S);
    let count = if mesh.is_nil() { 0 } else { mesh.positions.len() };
    let out: [int] = [];
    for i in S.polygon.picked {
        if i < count {
            out.push(i);
        }
    }
    if out.len() > 0 {
        return out;
    }
    for i in 0..count {
        out.push(i);
    }
    out
}

// Whether the pick is a real one rather than the whole-mesh fallback.
pub fn has_pick(S: editor::State) -> bool {
    S.polygon.picked.len() > 0
}

pub fn pick_vertex(S: &mut editor::State, at: int, add: bool) {
    if !add {
        S.polygon.picked = [at];
        signals::inspector(S);
        return;
    }
    let kept: [int] = [];
    let had = false;
    for i in S.polygon.picked {
        if i == at {
            had = true;
        } else {
            kept.push(i);
        }
    }
    if !had {
        kept.push(at);
    }
    S.polygon.picked = kept;
    signals::inspector(S);
}

pub fn clear_pick(S: &mut editor::State) {
    S.polygon.picked = [];
    signals::inspector(S);
}

// The same name on the other side, or nil when it names no side. Tried
// longest first, so `left_arm` does not match on its leading `l`.
pub fn mirror_name(path: str) -> str? {
    let lower = path.to_lower();
    for pair in SIDE_PAIRS() {
        for k in 0..2 {
            let from = pair[k];
            let to = pair[1 - k];
            // The replacement takes the case the original half was written
            // in, so `Arm_L` mirrors to `Arm_R` and `arm_l` to `arm_r`.
            if lower.starts_with(from) {
                let was = path.slice(0, from.len());
                return util::match_case(was, to) + path.slice(from.len(), path.len());
            }
            if lower.ends_with(from) {
                let at = path.len() - from.len();
                return path.slice(0, at) + util::match_case(path.slice(at, path.len()), to);
            }
            let found = util::index_of(lower, from);
            if found.is_some() {
                let at = found.unwrap();
                let was = path.slice(at, at + from.len());
                return path.slice(0, at) + util::match_case(was, to) + path.slice(at + from.len(), path.len());
            }
        }
    }
    nil
}

// Reflect the picked vertices over the node's own x or y axis, and hand each
// bone's weights to the bone whose name differs by a side.
pub fn mirror(S: &mut editor::State, axis: str) {
    let mesh = mesh(S);
    if mesh.is_nil() {
        return;
    }
    if !editable(S) {
        log::warn("this polygon's mesh is a file; embed it to mirror it");
        return;
    }
    let at = picked(S);
    begin(S, "mirror vertices over {axis}", nil);
    for i in at {
        let p = xy(mesh.positions[i]);
        mesh.positions[i] = if axis == "x" { [-p[0], p[1]] } else { [p[0], -p[1]] };
    }
    // A reflection reverses the outline's winding, and a mesh whose outline
    // runs the other way triangulates inside out.
    if !has_pick(S) {
        reverse_outline(mesh);
    }
    mirror_weights(mesh);
    // UVs are laid over the texture, not over the shape: a mirrored vertex
    // keeps the pixels it had, which is the whole point of mirroring a
    // weighted half.
    apply(S);
    log::info("mirrored {at.len()} vertices over {axis}");
}

// Reverse the outline in place, leaving internal vertices and remapping every
// polygon index onto the new order.
fn reverse_outline(mesh: any) {
    let outline = outline_count(mesh);
    if outline < 3 {
        return;
    }
    swap_outline(mesh.positions, outline);
    swap_outline(mesh.uvs, outline);
    for bone in bone_list(mesh) {
        swap_outline(bone.weights, outline);
    }
    for ring in util::vec(mesh.polygons) {
        for j in 0..ring.len() {
            let v = ring[j].as_int();
            if v < outline {
                ring[j] = outline - 1 - v;
            }
        }
    }
}

// The first `outline` elements of a per-vertex list, end to end.
fn swap_outline(list: any, outline: int) {
    if list.kind() != "list" {
        return;
    }
    for i in 0..(outline / 2) {
        let j = outline - 1 - i;
        let keep = list[i];
        list[i] = list[j];
        list[j] = keep;
    }
}

// Every bone's weights handed to its opposite number, both ways at once, so
// one call mirrors a whole rig rather than half of it twice.
fn mirror_weights(mesh: any) {
    let bones = bone_list(mesh);
    let by_path = map();
    for i in 0..bones.len() {
        by_path.set(bones[i].path.as_str(), i);
    }
    let taken: [any] = [];
    for bone in bones {
        taken.push(util::vec(bone.weights));
    }
    for bone in bones {
        let other = mirror_name(bone.path.as_str());
        if other.is_some() {
            let from = by_path.get(other.unwrap());
            if !from.is_nil() {
                bone.set("weights", taken[from.as_int()]);
            }
        }
    }
}

// Trace the texture's alpha into this polygon's outline. Spine's Generate:
// the shape a sprite already has, without clicking it out.
pub fn trace(S: &mut editor::State) {
    let comp = component(S.doc[S.sel]);
    if comp.is_nil() {
        return;
    }
    let texture = comp.texture.as_str();
    if texture == "" {
        log::warn("this polygon has no texture to trace");
        return;
    }
    if !editable(S) {
        log::warn("this polygon's mesh is a file; embed it to trace into it");
        return;
    }
    let opts = map()
        .with("threshold", S.polygon.threshold)
        .with("tolerance", S.polygon.tolerance)
        .with("pixels_per_unit", pixels_per_unit(S));
    let loops = render::trace_texture(S.game_root + "/" + texture, opts);
    if loops.len() == 0 || loops[0].len() < 3 {
        log::warn("{texture} has no opaque pixels at this threshold");
        return;
    }
    begin(S, "trace polygon", nil);
    let mesh = ensure_mesh(S);
    if mesh.is_nil() {
        return;
    }
    let points: [any] = [];
    for p in loops[0] {
        points.push([p.x, p.y]);
    }
    mesh.set("positions", points);
    // The old UVs, weights and drawn polygons indexed vertices that are gone;
    // a trace is a new shape, not an edit of the one that was there.
    mesh.remove("uvs");
    mesh.remove("polygons");
    mesh.remove("skin");
    mesh.set("internal", 0);
    S.polygon.picked = [];
    S.polygon.bone = nil;
    signals::inspector(S);
    apply(S);
    log::info("traced {points.len()} points from {texture}");
}

// Free-form deformation: an offset per vertex over the mesh's authored
// positions, which the engine adds before it skins. The offsets live on the
// tool, because the document's `positions` are the rest they measure from.
// Whether a vertex drag is deforming rather than reshaping.
pub fn deforming(S: editor::State) -> bool {
    S.workspace == defs::WORKSPACE_ANIMATION && S.clip.is_some() && !mesh(S).is_nil()
}

// The offsets, grown to the mesh and zero where they have not been set.
pub fn deform(S: &mut editor::State) -> [float] {
    let mesh = mesh(S);
    let count = if mesh.is_nil() { 0 } else { mesh.positions.len() };
    let out = S.polygon.deform;
    while out.len() < count * 2 {
        out.push(0.0);
    }
    out
}

pub fn deformed(S: editor::State) -> bool {
    for v in S.polygon.deform {
        if v != 0.0 {
            return true;
        }
    }
    false
}

fn set_deform(S: &mut editor::State, at: int, dx: float, dy: float) {
    let out = deform(S);
    if at * 2 + 1 >= out.len() {
        return;
    }
    out[at * 2] = dx;
    out[at * 2 + 1] = dy;
    signals::inspector(S);
}

pub fn clear_deform(S: &mut editor::State) {
    S.polygon.deform = [];
    signals::inspector(S);
}

// Key the offsets on the armed clip, at the playhead. One track for the whole
// mesh, because a deform is one value with two numbers per vertex.
pub fn key_deform(S: &mut editor::State) {
    if mesh(S).is_nil() {
        return;
    }
    anim::key_property(S, S.anim.time, animation::PROPERTY_DEFORM, deform(S));
}

fn uv_of(S: &mut editor::State, mesh: any, i: int, p: any) -> [float] {
    let uvs = mesh.uvs;
    if uvs.kind() == "list" && i < uvs.len() && !uvs[i].is_nil() {
        return xy(uvs[i]);
    }
    let q = xy(p);
    default_uv(S, q[0], q[1])
}

fn world_points(S: &mut editor::State, mesh: any, f: util::Frame, in_uv: bool) -> [[float]] {
    let out: [[float]] = [];
    let offsets = S.polygon.deform;
    let items = positions(mesh);
    for i in 0..items.len() {
        let p = items[i];
        let l = xy(p);
        if in_uv {
            let uv = uv_of(S, mesh, i, p);
            l = uv_to_local(S, uv[0], uv[1]);
        } else if i * 2 + 1 < offsets.len() {
            l = [l[0] + offsets[i * 2], l[1] + offsets[i * 2 + 1]];
        }
        let w = util::to_world(f, l[0], l[1]);
        out.push([w.x, w.y]);
    }
    out
}

fn pick(S: &mut editor::State, mesh: any, f: util::Frame, mx: float, my: float, in_uv: bool) -> int? {
    let best: int? = nil;
    let best_d = PICK_PX * viewport::world_per_px(S);
    let points = world_points(S, mesh, f, in_uv);
    for i in 0..points.len() {
        let p = points[i];
        let d = math::sqrt((p[0] - mx) * (p[0] - mx) + (p[1] - my) * (p[1] - my));
        if d < best_d {
            best = i;
            best_d = d;
        }
    }
    best
}

fn line(a: [float], b: [float], color: [float]) {
    render::draw_line_2d(a[0], a[1], b[0], b[1], color[0], color[1], color[2], W);
}

fn marker(S: editor::State, x: float, y: float, color: [float], filled: bool) {
    let h = MARK_PX * viewport::world_per_px(S);
    let width = if filled { 2.0 * MARK_PX } else { W };
    render::draw_line_2d(x - h, y - h, x + h, y - h, color[0], color[1], color[2], width);
    render::draw_line_2d(x + h, y - h, x + h, y + h, color[0], color[1], color[2], width);
    render::draw_line_2d(x + h, y + h, x - h, y + h, color[0], color[1], color[2], width);
    render::draw_line_2d(x - h, y + h, x - h, y - h, color[0], color[1], color[2], width);
}

pub fn draw(S: &mut editor::State) {
    if S.tool != "polygon" || !S.mode2d {
        return;
    }
    let mesh = mesh(S);
    if mesh.is_nil() {
        return;
    }
    let f = frame(S);
    if f.is_none() {
        return;
    }
    let k = S.theme;
    let accent = util::rgb(k.primary_text.as_str());
    let sage = util::rgb(k.secondary_text.as_str());
    let mode = S.polygon.mode;
    let points = world_points(S, mesh, f.unwrap(), mode == "uv");
    let n = points.len();
    let outline = outline_count(mesh);
    // The outline, closed; then the drawn polygons over it.
    for i in 0..outline {
        let j = if i == outline - 1 { 0 } else { i + 1 };
        if i < n && j < n {
            line(points[i], points[j], accent);
        }
    }
    for ring in util::vec(mesh.polygons) {
        for i in 0..ring.len() {
            let a = ring[i].as_int();
            let b = ring[if i == ring.len() - 1 { 0 } else { i + 1 }].as_int();
            if a >= 0 && a < n && b >= 0 && b < n {
                line(points[a], points[b], sage);
            }
        }
    }
    if S.polygon.chain.is_some() {
        let ring = S.polygon.chain.unwrap();
        for i in 1..ring.len() {
            if ring[i - 1] < n && ring[i] < n {
                line(points[ring[i - 1]], points[ring[i]], viewport::hover_color());
            }
        }
    }
    let active = if S.polygon.bone.is_some() { bones(S).at(S.polygon.bone.unwrap()) } else { nil };
    let hover = if S.polygon.hover.is_some() { S.polygon.hover.unwrap() } else { -1 };
    for i in 0..n {
        let p = points[i];
        let color = if hover == i { viewport::hover_color() } else { accent };
        if mode == "weights" && !active.is_nil() {
            let w = util::f(util::vec(active.weights).at(i));
            color = [w, w, w];
        }
        marker(S, p[0], p[1], color, i >= outline);
    }
}

fn backdrop_live(S: editor::State) -> bool {
    S.polygon.backdrop.is_valid()
}

// A translucent copy of the texture, undeformed, under the UV points.
fn enter_uv(S: &mut editor::State) {
    if backdrop_live(S) {
        return;
    }
    let comp = component(S.doc[S.sel]);
    if comp.is_nil() {
        return;
    }
    let texture = comp.texture.as_str();
    if texture == "" || S.mirror.is_none() {
        return;
    }
    let backdrop = S.mirror.unwrap().add_child("UvBackdrop");
    backdrop.set_component("sprite", map()
        .with("texture", S.game_root + "/" + texture)
        .with("pixels_per_unit", pixels_per_unit(S))
        .with("color", [1.0, 1.0, 1.0, 0.55]));
    S.polygon.backdrop = backdrop;
    signals::inspector(S);
}

fn leave_uv(S: &mut editor::State) {
    if backdrop_live(S) {
        S.polygon.backdrop.queue_free();
    }
    S.polygon.backdrop = nil;
    signals::inspector(S);
}

pub fn set_mode(S: &mut editor::State, mode: str) {
    // Selecting an occluder while in a mode it does not have leaves the tool
    // pointing at nothing; points is the one every target offers.
    let mode = if util::contains(modes(S), mode) { mode } else { "points" };
    S.polygon.mode = mode;
    S.polygon.chain = nil;
    signals::inspector(S);
    if mode != "uv" {
        leave_uv(S);
    }
    if mode == "weights" && S.polygon.bone.is_none() && bones(S).len() > 0 {
        S.polygon.bone = 0;
        signals::inspector(S);
    }
}

// Runs every frame whatever the tool: the backdrop follows the polygon and
// goes away with the mode.
pub fn idle(S: &mut editor::State) {
    if S.tool != "polygon" || S.polygon.mode != "uv" || mesh(S).is_nil() {
        leave_uv(S);
        return;
    }
    enter_uv(S);
    let f = frame(S);
    if f.is_none() || !backdrop_live(S) {
        return;
    }
    let found = model::live(S, S.sel);
    if found.is_valid() {
        let backdrop = S.polygon.backdrop;
        backdrop.transform.position = found.transform.global_position();
        backdrop.transform.rotation_euler = found.transform.global_rotation_euler();
        backdrop.transform.scale = Vec3 { x: f.unwrap().sx, y: f.unwrap().sy, z: 1.0 };
    }
}

pub fn cancel(S: &mut editor::State) {
    S.polygon.chain = nil;
    S.polygon.drag = nil;
    signals::inspector(S);
}

fn alt_down() -> bool {
    input::key_down(input::KEY_ALT)
}

pub fn update(S: &mut editor::State, over_viewport: bool, mx: float, my: float) {
    let mode = S.polygon.mode;
    let f_or = frame(S);
    if f_or.is_none() {
        return;
    }
    let f = f_or.unwrap();
    let mesh = mesh(S);
    if mesh.is_nil() {
        S.polygon.hover = nil;
        signals::inspector(S);
        if over_viewport && input::mouse_just_pressed(input::MOUSE_BUTTON_LEFT) && mode == "points" {
            add_vertex(S, mx, my, alt_down());
        }
        return;
    }
    let hover = if over_viewport { pick(S, mesh, f, mx, my, mode == "uv") } else { nil };
    S.polygon.hover = hover;
    if !input::mouse_down(input::MOUSE_BUTTON_LEFT) {
        S.polygon.drag = nil;
    }
    signals::inspector(S);
    if S.polygon.drag.is_some() {
        let drag = S.polygon.drag.unwrap();
        if mode == "uv" {
            move_uv(S, drag, mx, my);
        } else {
            move_vertex(S, drag, mx, my);
        }
        return;
    }
    if !over_viewport {
        return;
    }
    if mode == "points" {
        if input::mouse_just_pressed(input::MOUSE_BUTTON_LEFT) {
            if hover.is_some() {
                S.polygon.drag = hover;
                signals::inspector(S);
            } else {
                add_vertex(S, mx, my, alt_down());
            }
        } else if input::mouse_just_pressed(input::MOUSE_BUTTON_RIGHT) && hover.is_some() {
            remove_vertex(S, hover.unwrap());
        }
    } else if mode == "polygons" {
        if input::mouse_just_pressed(input::MOUSE_BUTTON_LEFT) && hover.is_some() {
            let at = hover.unwrap();
            let ring: [int] = if S.polygon.chain.is_some() { S.polygon.chain.unwrap() } else { [] };
            if ring.len() >= 3 && at == ring[0] {
                S.polygon.chain = ring;
                signals::inspector(S);
                close_loop(S);
            } else if !util::icontains(ring, at) {
                ring.push(at);
                S.polygon.chain = ring;
                signals::inspector(S);
            }
        } else if input::mouse_just_pressed(input::MOUSE_BUTTON_RIGHT) {
            S.polygon.chain = nil;
            signals::inspector(S);
        }
    } else if mode == "uv" {
        if input::mouse_just_pressed(input::MOUSE_BUTTON_LEFT) && hover.is_some() {
            S.polygon.drag = hover;
            signals::inspector(S);
        }
    } else if mode == "weights" {
        let sign = if input::mouse_down(input::MOUSE_BUTTON_LEFT) {
            1.0
        } else if input::mouse_down(input::MOUSE_BUTTON_RIGHT) {
            -1.0
        } else {
            0.0
        };
        if sign != 0.0 {
            let radius = S.polygon.radius * viewport::world_per_px(S);
            let amount = sign * S.polygon.strength * engine::delta() * 2.0;
            let points = world_points(S, mesh, f, false);
            for i in 0..points.len() {
                let p = points[i];
                if math::sqrt((p[0] - mx) * (p[0] - mx) + (p[1] - my) * (p[1] - my)) <= radius {
                    paint(S, i, amount);
                }
            }
        }
    }
}

pub fn mode_specs(S: editor::State) -> [any] {
    let k = S.theme;
    let mode = S.polygon.mode;
    let out: [any] = [];
    for id in modes(S) {
        let on = mode == id;
        out.push(map()
            .with("kind", "button")
            .with("text", mode_name(id))
            .with("height", 24)
            .with("font_size", style::SM)
            .with("font_weight", 700)
            .with("fill", if on { k.primary_bg } else { k.bg_panel })
            .with("stroke", k.border_default)
            .with("text_color", if on { k.primary_text } else { k.text_muted })
            .with("on", "handle")
            .with("data", map().with("fn", mode_specs_on_0).with("picked", id)));
    }
    out
}

fn mode_specs_on_0(S: &mut editor::State, data: any, _0: any) {
    set_mode(S, data.picked.as_str());
    signals::bars(S);
}
