// The shapes a node's mesh can be turned into, as the palette offers them:
// what it collides as and what it deforms as. Every action writes component
// properties, never geometry; the engine does the work at apply time.

use editor;
use model;
use polygon;
use selection;

/// One of the shapes an action writes: what it is called, what it costs,
/// the properties it sets, and those of the components beside the main one,
/// by component name.
pub struct Shape {
    id: str,
    tip: str,
    properties: any,
    beside: any,
}

fn shape(id: str, tip: str, properties: any) -> Shape {
    Shape { id: id, tip: tip, properties: properties, beside: {} }
}

fn shape_beside(id: str, tip: str, properties: any, beside: any) -> Shape {
    Shape { id: id, tip: tip, properties: properties, beside: beside }
}

/// The mesh asset a node draws, which is what every shape below is built
/// from: a `mesh` component's source in 3D, a `polygon`'s in 2D. Either is a
/// path or an inline table, like the one a traced sprite's polygon holds;
/// nil when it draws none.
pub fn drawn_mesh(node: Node, two_d: bool) -> any {
    if !node.is_valid() {
        return nil;
    }
    if two_d {
        let key = polygon::target(node);
        let found = if key.is_some() { node.authored(key.unwrap()) } else { nil };
        if !found.is_nil() && named(found["mesh"]) {
            return found["mesh"];
        }
        return nil;
    }
    // A table names its `source`; a plain string is the source itself.
    let mesh = if node.has_component("mesh") { node.authored("mesh") } else { nil };
    let source = if mesh.kind() == "map" { mesh["source"] } else { mesh };
    if named(source) { source } else { nil }
}

fn named(source: any) -> bool {
    source.kind() == "map" || source.kind() == "str" && source.as_str() != ""
}

// The collider shapes a mesh can be turned into.
pub fn collider_shapes(two_d: bool) -> [Shape] {
    if two_d {
        [
            shape("hull", "Convex hull: the smallest convex outline around the points. One shape, fast, and it fills every dent", { "kind": "convex_hull" }),
            shape_beside("pieces", "Convex decomposition: cut into convex pieces exactly, over a triangulation. The only way a concave shape can be a dynamic body", { "kind": "convex_decomposition" }, { "convex_decomposition2d": { "method": { "kind": "exact" } } }),
            shape_beside("approx", "The same cut approximately, over a voxel grid: fewer pieces and faster to solve, at the cost of the outline", { "kind": "convex_decomposition" }, { "convex_decomposition2d": { "method": { "kind": "vhacd" } } }),
            shape("mesh", "The triangles as they are. Exact and concave, but static only: a dynamic triangle mesh has no inside", { "kind": "triangle_mesh" }),
        ]
    } else {
        [
            shape("hull", "Convex hull: the smallest convex shape around the points. One shape, fast, and it fills every dent", { "kind": "convex_hull" }),
            shape("pieces", "Convex decomposition: parry's VHACD cuts the mesh into convex pieces held as one compound. The only way a concave shape can be a dynamic body", { "kind": "convex_decomposition" }),
            shape("mesh", "The triangles as they are. Exact and concave, but static only: a dynamic triangle mesh has no inside", { "kind": "triangle_mesh" }),
            shape("voxels", "Voxelize: the mesh as filled cells, which a script may dig into while the game runs", { "kind": "voxelized_mesh" }),
            shape("box", "The axis-aligned box around the mesh: the cheapest shape there is", { "kind": "fit", "fit": "aabb" }),
            shape("obb", "The tightest turned box around the mesh, which beats an axis-aligned one on anything drawn at an angle", { "kind": "fit", "fit": "obb" }),
        ]
    }
}

// The soft bodies a mesh can be filled with.
pub fn soft_shapes(two_d: bool) -> [Shape] {
    if two_d {
        [
            shape("solid", "Fill the outline with triangles and simulate those, with the polygon riding them: a soft body as coarse as its cell size, which a soft_volumetric2d beside it sets", { "kind": "volumetric" }),
            shape("outline", "Simulate the outline alone, holding the area it encloses: a balloon rather than a jelly", { "kind": "polygon" }),
            shape("surface", "Simulate the mesh's own vertices and triangles, with no cell size to choose", { "kind": "triangle_mesh" }),
        ]
    } else {
        [
            shape_beside("solid", "Fill the mesh with tetrahedra and simulate those: a soft body as coarse as its cell size, which a soft_volumetric3d beside it sets. The mesh has to be closed", { "kind": "volumetric" }, { "soft_skin3d": { "skin": false } }),
            shape_beside("skinned", "The same, keeping the drawn mesh as the surface the cells carry: a detail the cell size cannot resolve survives, and contacts stay as coarse as the cells", { "kind": "volumetric" }, { "soft_skin3d": { "skin": true } }),
            shape("surface", "Simulate the mesh's own vertices and triangles: a sheet or a shell rather than a filled body, and no cell size to choose", { "kind": "triangle_mesh" }),
        ]
    }
}

/// One shape action: the collider is given the mesh and the properties, and
/// whatever shape it was is replaced; `beside` patches the components beside
/// it, by name, on the same nodes, in the same undo step.
pub fn make_collider(state: &mut editor::State, two_d: bool, properties: any, beside: any) {
    let name = if two_d { "collider2d" } else { "collider3d" };
    model::set_component_properties_each(state, name, with_shape_of, { "two_d": two_d, "props": properties });
    patch_beside(state, two_d, beside);
}

// The components beside the main one, patched on every selected node that
// draws a mesh.
fn patch_beside(state: &mut editor::State, two_d: bool, beside: any) {
    for row in selection::all(state) {
        let found = model::node(state, row);
        if !found.is_valid() || drawn_mesh(found, two_d).is_nil() {
            continue;
        }
        for component in beside.keys() {
            found.try_patch_component(component, beside[component]);
        }
    }
}

fn with_mesh_of(node: Node, data: any) -> any {
    with_mesh(node, data["two_d"].as_bool(), data["props"])
}

// A collider's: the shape a kind and the node's own mesh make.
fn with_shape_of(node: Node, data: any) -> any {
    let shape = with_mesh_of(node, data);
    if shape.is_nil() { nil } else { { "shape": shape } }
}

// The properties an action writes, on a node's own mesh; nil for a node in
// the selection that draws none.
fn with_mesh(node: Node, two_d: bool, properties: any) -> any {
    let source = drawn_mesh(node, two_d);
    if source.is_nil() {
        return nil;
    }
    let parameters: any = { "mesh": source };
    for key in properties.keys() {
        parameters[key] = properties[key];
    }
    parameters
}

/// One soft body action: each selected node is filled from its own mesh,
/// and `beside` patches the components beside the body as `make_collider`'s
/// does.
pub fn make_soft_body(state: &mut editor::State, two_d: bool, properties: any, beside: any) {
    let name = if two_d { "softbody2d" } else { "softbody3d" };
    model::set_component_properties_each(state, name, with_mesh_of, { "two_d": two_d, "props": properties });
    patch_beside(state, two_d, beside);
}
