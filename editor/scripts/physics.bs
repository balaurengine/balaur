// The Physics workspace's section of the inspector: what a node can be given,
// and the shapes its mesh can be turned into. Every action writes component
// properties, never geometry; the engine does the work at apply time.

use editor;
use inspector;
use model;
use polygon;
use pool;
use recipes;
use style;
use util;

/// Where one pill was put: its form row, its place in it, and what it does,
/// for `selftest::physics_clicks` to find its node.
pub struct Physpill {
    row: int,
    n: int,
    id: str,
    label: str,
}

/// One pill before it is laid out: what it is known by, what it says, and
/// the button it is.
pub struct Pill {
    id: str,
    label: str,
    control: any,
}

/// One of the shapes an action writes: what it is called, what it costs,
/// and the properties it sets.
pub struct Shape {
    id: str,
    tip: str,
    props: any,
}

fn shape(id: str, tip: str, props: any) -> Shape {
    Shape { id: id, tip: tip, props: props }
}

/// The physics components a node can be given, per dimension, in the order
/// the row offers them: what a body is first, what it collides with second,
/// and the rest after. Each is the component, its label and what it is.
fn addable(two_d: bool) -> [[str]] {
    if two_d {
        [
            ["body2d", "Body", "A body physics moves: dynamic, static or kinematic"],
            ["collider2d", "Collider", "The shape it collides with; without a body it is static geometry"],
            ["softbody2d", "Soft body", "A deformable body of particles: jelly, cloth, rope"],
            ["joint2d", "Joint", "Holds this node's body to another's"],
            ["character2d", "Character", "A controller that walks, climbs steps and slides along walls"],
        ]
    } else {
        [
            ["body3d", "Body", "A body physics moves: dynamic, static or kinematic"],
            ["collider3d", "Collider", "The shape it collides with; without a body it is static geometry"],
            ["softbody3d", "Soft body", "A deformable body of particles: jelly, cloth, rope"],
            ["joint3d", "Joint", "Holds this node's body to another's"],
            ["character3d", "Character", "A controller that walks, climbs steps and slides along walls"],
            ["vehicle3d", "Vehicle", "A raycast car; each wheel is a wheel3d under it"],
            ["wheel3d", "Wheel", "One wheel of the vehicle3d above it"],
        ]
    }
}

/// The mesh asset a node draws, which is what every shape below is built
/// from: a `mesh` component's source in 3D, a `polygon`'s in 2D. Either is a
/// path or an inline table, like the one a traced sprite's polygon holds;
/// nil when it draws none.
pub fn drawn_mesh(node: any, two_d: bool) -> any {
    if two_d {
        let found = polygon::component(node);
        if !found.is_nil() && named(found.mesh) {
            return found.mesh;
        }
        return nil;
    }
    // A table names its `source`; a plain string is the source itself.
    let mesh = node.mesh;
    let source = if mesh.kind() == "map" { mesh.source } else { mesh };
    if named(source) { source } else { nil }
}

fn named(source: any) -> bool {
    source.kind() == "map" || source.kind() == "str" && source.as_str() != ""
}

// The collider shapes a mesh can be turned into.
fn collider_shapes(two_d: bool) -> [Shape] {
    if two_d {
        [
            shape("hull", "Convex hull: the smallest convex outline around the points. One shape, fast, and it fills every dent", map().with("kind", "convex_hull")),
            shape("pieces", "Convex decomposition: cut into convex pieces exactly, over a triangulation. The only way a concave shape can be a dynamic body", map().with("kind", "convex_decomposition").with("method", "exact")),
            shape("approx", "The same cut approximately, over a voxel grid: fewer pieces and faster to solve, at the cost of the outline", map().with("kind", "convex_decomposition").with("method", "vhacd")),
            shape("mesh", "The triangles as they are. Exact and concave, but static only: a dynamic triangle mesh has no inside", map().with("kind", "triangle_mesh")),
        ]
    } else {
        [
            shape("hull", "Convex hull: the smallest convex shape around the points. One shape, fast, and it fills every dent", map().with("kind", "convex_hull")),
            shape("pieces", "Convex decomposition: parry's VHACD cuts the mesh into convex pieces held as one compound. The only way a concave shape can be a dynamic body", map().with("kind", "convex_decomposition")),
            shape("mesh", "The triangles as they are. Exact and concave, but static only: a dynamic triangle mesh has no inside", map().with("kind", "triangle_mesh")),
            shape("voxels", "Voxelize: the mesh as filled cells, which a script may dig into while the game runs", map().with("kind", "voxelized_mesh")),
            shape("box", "The axis-aligned box around the mesh: the cheapest shape there is", map().with("kind", "fit").with("fit", "aabb")),
            shape("obb", "The tightest turned box around the mesh, which beats an axis-aligned one on anything drawn at an angle", map().with("kind", "fit").with("fit", "obb")),
        ]
    }
}

// The soft bodies a mesh can be filled with.
fn soft_shapes(two_d: bool) -> [Shape] {
    if two_d {
        [
            shape("solid", "Fill the outline with triangles and simulate those, with the polygon riding them: a soft body as coarse as its cell size, which the Shape rows below set", map().with("kind", "volumetric")),
            shape("outline", "Simulate the outline alone, holding the area it encloses: a balloon rather than a jelly", map().with("kind", "polygon")),
            shape("surface", "Simulate the mesh's own vertices and triangles, with no cell size to choose", map().with("kind", "triangle_mesh")),
        ]
    } else {
        [
            shape("solid", "Fill the mesh with tetrahedra and simulate those: a soft body as coarse as its cell size, which the Shape rows below set. The mesh has to be closed", map().with("kind", "volumetric").with("skin", false)),
            shape("skinned", "The same, keeping the drawn mesh as the surface the cells carry: a detail the cell size cannot resolve survives, and contacts stay as coarse as the cells", map().with("kind", "volumetric").with("skin", true)),
            shape("surface", "Simulate the mesh's own vertices and triangles: a sheet or a shell rather than a filled body, and no cell size to choose", map().with("kind", "triangle_mesh").with("skin", false)),
        ]
    }
}

/// One shape action: the collider is given the mesh and the properties, and
/// whatever shape it was is replaced.
pub fn make_collider(S: &mut editor::State, two_d: bool, props: any) {
    let name = if two_d { "collider2d" } else { "collider3d" };
    model::set_component_props_each(S, name, with_mesh_of, map().with("two_d", two_d).with("props", props));
}

fn with_mesh_of(node: any, data: any) -> any {
    with_mesh(node, data.two_d.as_bool(), data.props)
}

// The properties an action writes, on a node's own mesh; nil for a node in
// the selection that draws none.
fn with_mesh(node: any, two_d: bool, props: any) -> any {
    let source = drawn_mesh(node, two_d);
    if source.is_nil() {
        return nil;
    }
    let params = map().with("mesh", source);
    for key in props.keys() {
        params.set(key, props.get(key));
    }
    params
}

/// The Physics section: what this node can be given, and what its mesh can
/// become. Drawn above the components so the panel reads as "add, then
/// configure".
pub fn actions(S: &mut editor::State, k: any) {
    // Rebuilt with the rows, so it never describes an older form.
    S.phys_pills = [];
    if !inspector::section(S, k, "Physics") {
        return;
    }
    let node = model::selected_node(S);
    let two_d = model::is_2d(S);
    add_row(S, k, node, two_d);
    make_row(S, k, node, two_d);
    if !drawn_mesh(node, two_d).is_nil() {
        shape_rows(S, k, two_d);
    } else {
        inspector::form_row(S, "From mesh", []);
        let says = if two_d { "needs a polygon" } else { "needs a mesh" };
        inspector::note_row(S, style::row_h(S), "text_note", says);
    }
}

// A pill is about seven pixels a character plus its padding: what the wrap
// below plans with, since nothing is measured as it is drawn.
const PILL_PAD: float = 18.0;
const CHAR_W: float = 7.0;
const LABEL_COL: float = 62.0;
const GAP: float = 5.0;

fn pill_w(label: str) -> float {
    PILL_PAD + CHAR_W * label.len().as_float()
}

// The wrapped rows of pills, the label on the first. The sheet is 308 px at
// its widest and these rows are five to seven pills long, so one row per
// action would clip every one of them.
fn pill_rows(S: &mut editor::State, label: str, pills: [Pill]) {
    let room = inspector::sheet_w(S).as_float() - LABEL_COL;
    let head = label;
    let controls: [any] = [];
    let used = 0.0;
    for pill in pills {
        let w = pill_w(pill.label) + GAP;
        if controls.len() > 0 && used + w > room {
            inspector::form_row(S, head, controls);
            head = "";
            controls = [];
            used = 0.0;
        }
        S.phys_pills.push(Physpill { row: S.form.len(), n: controls.len(), id: pill.id, label: pill.label });
        controls.push(pill.control);
        used += w;
    }
    if controls.len() > 0 {
        inspector::form_row(S, head, controls);
    }
}

fn button(text: str, tooltip: str) -> any {
    map().with("kind", "button").with("role", "action_form").with("text", text).with("tooltip", tooltip)
}

// The pills that give the node a component it does not have yet.
fn add_row(S: &mut editor::State, k: any, node: any, two_d: bool) {
    let pills: [Pill] = [];
    for row in addable(two_d) {
        if node.has(row[0]) {
            continue;
        }
        let control = button(row[1], "{row[0]}: {row[2]}").with("fill", k.secondary_bg).with("text_color", k.secondary_text);
        pills.push(Pill { id: row[0], label: row[1], control: pool::on(control, add_component, map().with("name", row[0])) });
    }
    if pills.len() > 0 {
        pill_rows(S, "Add", pills);
    }
}

fn add_component(S: &mut editor::State, data: any, _value: any) {
    model::add_component(S, data.name.as_str());
}

// What the node can be made into from what it draws, each one undo step: a
// soft body bent from its sprite, shape or mesh, and a sprite's outline.
fn make_row(S: &mut editor::State, k: any, node: any, two_d: bool) {
    if !model::has_selection(S) {
        return;
    }
    let soft = if two_d { "softbody2d" } else { "softbody3d" };
    let pills: [Pill] = [];
    let source = recipes::soft_body_source(S, S.sel);
    if source.is_some() && !node.has(soft) {
        let tip = "A soft body bent from its {source.unwrap()}, which it keeps drawing";
        pills.push(Pill { id: "soft body", label: "soft body", control: pool::on(button("soft body", tip), make_soft_body, map()) });
    }
    if two_d && node.has("sprite") {
        let tip = "A polygon of the sprite's opaque outline, textured with it: what a rig or a soft body bends";
        pills.push(Pill { id: "polygon", label: "polygon", control: pool::on(button("polygon", tip), make_polygon, map()) });
    }
    if pills.len() > 0 {
        pill_rows(S, "Make", pills);
    }
}

fn make_soft_body(S: &mut editor::State, _data: any, _value: any) {
    recipes::soft_body(S, S.sel);
}

fn make_polygon(S: &mut editor::State, _data: any, _value: any) {
    recipes::sprite_to_polygon(S, S.sel);
}

// The shapes the node's mesh can be turned into, and the soft body it can be
// filled with. Two actions: what it collides as, and what it deforms as.
fn shape_rows(S: &mut editor::State, k: any, two_d: bool) {
    let collide: [Pill] = [];
    for s in collider_shapes(two_d) {
        let data = map().with("two_d", two_d).with("props", s.props);
        collide.push(Pill { id: s.id, label: s.id, control: pool::on(button(s.id, s.tip), collide_as, data) });
    }
    pill_rows(S, "Collide as", collide);
    let deform: [Pill] = [];
    for s in soft_shapes(two_d) {
        let control = button(s.id, s.tip).with("fill", k.secondary_bg).with("text_color", k.secondary_text);
        let data = map().with("two_d", two_d).with("props", s.props);
        deform.push(Pill { id: s.id, label: s.id, control: pool::on(control, deform_as, data) });
    }
    pill_rows(S, "Deform as", deform);
}

fn collide_as(S: &mut editor::State, data: any, _value: any) {
    make_collider(S, data.two_d.as_bool(), data.props);
}

fn deform_as(S: &mut editor::State, data: any, _value: any) {
    let name = if data.two_d.as_bool() { "softbody2d" } else { "softbody3d" };
    model::set_component_props_each(S, name, with_mesh_of, data);
}

/// How the inspector orders a physics component's property groups.
///
/// A soft body has nine of them and alphabetical put `elasticity` above
/// `shape`, which is the one an author sets first. Named here so the order
/// is the order the work is done in.
pub fn group_order(group: str) -> int {
    let order = [
        "shape", "stiffness", "elasticity", "volume", "plasticity", "tearing", "regions",
        "particles", "mass", "surface", "contacts", "motion", "filtering",
    ];
    // After every named group, in the order the rows met them.
    util::position(order, group).or(order.len())
}
