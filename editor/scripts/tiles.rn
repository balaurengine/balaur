// The Tiles tool: paint a `tilemap` in the viewport from a palette cut out of
// its tile set, and keep the layers of a map as sibling nodes.

use crate::history;
use crate::model;
use crate::style;
use crate::util;
use crate::viewport;

/// The tool's own state, hung on `S.tiles`. `stroke` is the button held down,
/// `anchor` the cell a rectangle was started at, `sheet` the cached size of
/// the atlas image.
pub fn state() {
    #{ tile: 0, mode: "paint", stroke: None, anchor: None, hover: None, sheet: (), terrain: 1, stamp: (1, 1), editing: false }
}

// A map is centred on its node, so the grid grows to the right and down only
// and the node is moved to hold the tiles that are already down still. A cell
// left of column zero or above row zero has nowhere to go: move the node.
const MODES = ["paint", "rect", "bucket", "line", "stamp", "pick", "terrain"];

// How far a bucket fill will reach before it gives up: a runaway fill on a
// map with no border would otherwise hang the editor.
const FILL_LIMIT = 4096;

pub fn mode_name(id) {
    match id {
        "paint" => "Paint",
        "rect" => "Rectangle",
        "bucket" => "Fill",
        "line" => "Line",
        "stamp" => "Stamp",
        "pick" => "Pick",
        "terrain" => "Terrain",
        _ => id,
    }
}

/// The terrains the tile set names, for the brush to choose between.
pub fn terrains(S) {
    let comp = match component(S.doc[S.sel]) {
        Some(comp) => comp,
        None => return [],
    };
    let named = comp.get("tileset").unwrap_or("");
    let def = if named is Object {
        named
    } else if named is String && named != "" {
        let (ok, loaded) = script::attempt(|| assets::load(S.game_root + "/" + named));
        if !ok || !(loaded is Object) {
            return [];
        }
        loaded
    } else {
        return [];
    };
    let list = def.get("terrains").unwrap_or([]);
    let out = [];
    if list is Vec {
        for (i, entry) in list.iter().enumerate() {
            if entry is Object {
                let name = entry.get("name").unwrap_or("");
                let value = util::i(entry.get("value").unwrap_or(util::i(i) + 1));
                out.push(#{ name: name, value: value });
            }
        }
    }
    out
}

/// Every cell the fill reaches: the ones holding what the first one held,
/// four-connected, inside the map the tool can see.
fn flood(S, x, y) {
    let want = cell(S, x, y);
    let rows = grid(S);
    let (ox, oy) = origin(S);
    let wide = util::i(columns(rows));
    let tall = util::i(rows.len());
    let seen = #{};
    let queue = [(x, y)];
    let out = [];
    while queue.len() > 0 && out.len() < FILL_LIMIT {
        let at = queue.remove(0);
        let (cx, cy) = at;
        let key = format!("{},{}", cx, cy);
        if seen.contains_key(key) {
            continue;
        }
        seen.insert(key, true);
        if cx < ox || cy < oy || cx >= ox + wide || cy >= oy + tall {
            continue;
        }
        if cell(S, cx, cy) != want {
            continue;
        }
        out.push((cx, cy));
        queue.push((cx + 1, cy));
        queue.push((cx - 1, cy));
        queue.push((cx, cy + 1));
        queue.push((cx, cy - 1));
    }
    out
}

/// The cells a straight line from one to another passes through.
fn line_cells(from, to) {
    let (x0, y0) = from;
    let (x1, y1) = to;
    let dx = util::abs(x1 - x0);
    let dy = util::abs(y1 - y0);
    let sx = if x0 < x1 { 1 } else { -1 };
    let sy = if y0 < y1 { 1 } else { -1 };
    let err = dx - dy;
    let x = x0;
    let y = y0;
    let out = [];
    let guard = 0;
    while guard < FILL_LIMIT {
        guard += 1;
        out.push((x, y));
        if x == x1 && y == y1 {
            break;
        }
        let twice = err * 2;
        if twice > -dy {
            err -= dy;
            x += sx;
        }
        if twice < dx {
            err += dx;
            y += sy;
        }
    }
    out
}

/// Put the block of tiles the palette selection spans, its top-left corner at
/// a cell: a stamp is the selected tile and the ones right and below it.
pub fn stamp_at(S, x, y) {
    let set = match tileset(S) {
        Some(set) => set,
        None => return false,
    };
    let (wide, tall) = S.tiles.stamp;
    let first = S.tiles.tile;
    let count = tile_count(S);
    let rows = [];
    for row in 0..tall {
        let line = [];
        for column in 0..wide {
            let id = first + row * set.columns + column;
            // A stamp that runs off the sheet's row wraps nowhere: it stops.
            let over_edge = (first % set.columns) + column >= set.columns;
            line.push(if over_edge || id >= count { -1 } else { id });
        }
        rows.push(line);
    }
    write_block(S, x, y, rows, "stamp tiles")
}

/// Write a block of tiles in one step, growing the map to hold it.
fn write_block(S, x, y, rows, label) {
    let changed = false;
    for (row, line) in rows.iter().enumerate() {
        for (column, id) in line.iter().enumerate() {
            if id < 0 {
                continue;
            }
            // One key, so the whole block is one undo step.
            if write_cells(S, [(x + util::i(column), y + util::i(row))], id, label, Some("stamp")) {
                changed = true;
            }
        }
    }
    changed
}

/// Paint a terrain value and let the engine's own rules pick the tiles, then
/// take the cells it resolved back into the document.
pub fn paint_terrain(S, x, y, value) {
    let found = match model::live(S, S.sel) {
        Some(found) => found,
        None => return false,
    };
    let comp = match component(S.doc[S.sel]) {
        Some(comp) => comp,
        None => return false,
    };
    let (ok, _) = script::attempt(|| render::set_terrain(found, x, y, value));
    if !ok {
        return false;
    }
    let (read, table) = script::attempt(|| found.tilemap.get());
    if !read || !(table is Object) {
        return false;
    }
    history::record(S, if value < 0 { "erase terrain" } else { "paint terrain" }, Some("terrain"));
    comp.cells = table.get("cells").unwrap_or(comp.cells);
    comp.terrain = table.get("terrain").unwrap_or(());
    comp.origin = table.get("origin").unwrap_or([0.0, 0.0]);
    let turned = table.get("flags").unwrap_or(());
    if turned is Vec {
        comp.flags = turned;
    }
    true
}

/// The `tilemap` table on a node, or `None` for a node that carries none.
pub fn component(node) {
    match node.get("tilemap") {
        Some(comp) => if comp is Object { Some(comp) } else { None },
        None => None,
    }
}

pub fn editable(S) {
    S.sel >= 0 && S.sel < S.doc.len() && component(S.doc[S.sel]).is_some()
}

/// The tile set behind the selected map: its texture, tile size and columns.
///
/// An inline table is the definition itself; a string names a file, which the
/// engine reads by absolute path because the editor's own project root is not
/// the game's.
pub fn tileset(S) {
    let comp = match component(S.doc[S.sel]) {
        Some(comp) => comp,
        None => return None,
    };
    let named = comp.get("tileset").unwrap_or("");
    let def = if named is Object {
        named
    } else if named is String && named != "" {
        let (ok, loaded) = script::attempt(|| assets::load(S.game_root + "/" + named));
        if !ok || !(loaded is Object) {
            return None;
        }
        loaded
    } else {
        return None;
    };
    let (w, h) = tile_extent(def.get("tile_size").unwrap_or(0.0));
    let columns = util::i(def.get("columns").unwrap_or(0));
    let texture = def.get("texture").unwrap_or("");
    if w <= 0.0 || h <= 0.0 || columns < 1 || !(texture is String) || texture == "" {
        return None;
    }
    Some(#{
        texture: texture,
        w: w,
        h: h,
        columns: columns,
        spacing: gap(def, "spacing"),
        margin: gap(def, "margin"),
    })
}

/// `tile_size` as a width and a height: a number is a square tile, a pair is
/// a sheet whose tiles are not one. The same two forms the engine reads.
fn tile_extent(size) {
    let pair = util::vec2(size, ());
    if pair is Vec {
        return (pair[0], pair[1]);
    }
    let (ok, edge) = script::attempt(|| util::f(size));
    if !ok {
        return (0.0, 0.0);
    }
    return (edge, edge);
}

/// A gutter or a border in sheet pixels, zero when the sheet names none.
fn gap(def, key) {
    let (ok, value) = script::attempt(|| util::f(def.get(key).unwrap_or(0.0)));
    if !ok {
        return 0.0;
    }
    return util::max(value, 0.0);
}

/// Where one tile sits on the sheet, in pixels: the gutter between tiles and
/// the border around them both count.
pub fn tile_rect(set, tile) {
    let column = util::f(tile % set.columns);
    let row = math::floor(util::f(tile) / util::f(set.columns));
    return [
        set.margin + column * (set.w + set.spacing),
        set.margin + row * (set.h + set.spacing),
        set.w,
        set.h,
    ];
}

/// How many tiles the atlas holds: its columns times the rows its height
/// makes. Cached by path, because it costs a file read.
pub fn tile_count(S) {
    let set = match tileset(S) {
        Some(set) => set,
        None => return 0,
    };
    let cache = S.tiles.sheet;
    if !(cache is Object) || cache.path != set.texture {
        let (ok, size) = script::attempt(|| render::texture_size(S.game_root + "/" + set.texture));
        let height = if ok {
            let (_, h) = size;
            util::f(h)
        } else {
            log::warn(format!("tile set texture {}: {:?}", set.texture, size));
            0.0
        };
        S.tiles.sheet = #{ path: set.texture, height: height };
        cache = S.tiles.sheet;
    }
    // As many rows as fit under the border, counting the gutter between them.
    let step = set.h + set.spacing;
    let room = cache.height - set.margin - set.h;
    if step <= 0.0 || room < 0.0 {
        return 0;
    }
    let rows = util::i(math::floor(room / step)) + 1;
    set.columns * util::max(rows, 0)
}

fn pixels_per_unit(S) {
    match component(S.doc[S.sel]) {
        Some(comp) => util::max(util::f(comp.get("pixels_per_unit").unwrap_or(100.0)), 0.01),
        None => 100.0,
    }
}

/// The grid as rows of tile ids, whichever form the document wrote. Empty is
/// -1, the same spelling `cells` takes as a list.
pub fn grid(S) {
    let comp = match component(S.doc[S.sel]) {
        Some(comp) => comp,
        None => return [],
    };
    let cells = comp.get("cells").unwrap_or("");
    if cells is String {
        let rows = [];
        for line in cells.split('\n') {
            if line == "" {
                continue;
            }
            let row = [];
            for c in line.chars() {
                row.push(tile_of_char(c));
            }
            rows.push(row);
        }
        return rows;
    }
    let rows = [];
    for row in util::vec(cells) {
        let ids = [];
        for id in util::vec(row) {
            ids.push(util::i(id));
        }
        rows.push(ids);
    }
    rows
}

// The characters `cells` spells a tile with, tile 0 first. A tile past the
// end of this has no character, which is what the list-of-rows form is for.
fn alphabet() {
    "0123456789abcdefghijklmnopqrstuvwxyz".chars().collect::<Vec>()
}

// A signed id, not the unsigned one `enumerate` counts with: -1 is what an
// empty cell holds, and an unsigned slot cannot be compared against it.
fn tile_of_char(c) {
    match util::position(alphabet(), c) {
        Some(index) => util::i(index),
        None => -1,
    }
}

fn char_of_tile(tile) {
    let letters = alphabet();
    if tile < 0 || tile >= letters.len() {
        return ".";
    }
    format!("{}", letters[tile])
}

/// The widest row: what the engine counts as the map's columns.
pub fn columns(rows) {
    let widest = 0;
    for row in rows {
        widest = util::max(widest, util::i(row.len()));
    }
    widest
}

/// Write a grid back in the form it was authored in.
///
/// The text form stays text while every tile it holds has a character, so a
/// hand-written map keeps the shape its author can read in a diff; a tile
/// past 35 has no character and turns the whole map into rows of ids.
fn cells_value(rows, was_text) {
    if was_text && spellable(rows) {
        let lines = [];
        for row in rows {
            let line = "";
            for tile in row {
                line += char_of_tile(tile);
            }
            lines.push(line);
        }
        return util::join(lines, "\n");
    }
    rows
}

/// Whether every tile has a character, so the text form can still spell the
/// map. A tile set past 36 tiles is what takes it away.
fn spellable(rows) {
    let letters = alphabet().len();
    for row in rows {
        for tile in row {
            if tile >= letters {
                return false;
            }
        }
    }
    true
}

fn authored_as_text(S) {
    match component(S.doc[S.sel]) {
        Some(comp) => comp.get("cells").unwrap_or("") is String,
        None => true,
    }
}

/// Where the map's own origin sits and how a world point lands in it.
///
/// Cell 0,0 has its top-left corner on the node, so a cell's place is its
/// coordinate alone and the map may grow in any direction.
pub fn frame(S) {
    let found = match model::live(S, S.sel) {
        Some(found) => found,
        None => return None,
    };
    let set = match tileset(S) {
        Some(set) => set,
        None => return None,
    };
    let rows = grid(S);
    let p = found.global_position();
    let angle = found.global_rotation_euler().z;
    let s = found.global_scale();
    let start = origin(S);
    Some(#{
        x: p.x, y: p.y, c: math::cos(angle), s: math::sin(angle),
        sx: s.x, sy: s.y,
        tw: set.w / pixels_per_unit(S),
        th: set.h / pixels_per_unit(S),
        columns: util::max(columns(rows), 1),
        rows: util::max(rows.len(), 1),
        ox: start.0, oy: start.1,
    })
}

fn to_local(f, wx, wy) {
    let dx = wx - f.x;
    let dy = wy - f.y;
    let px = f.c * dx + f.s * dy;
    let py = -f.s * dx + f.c * dy;
    (px / (if util::abs(f.sx) > 1e-6 { f.sx } else { 1.0 }), py / (if util::abs(f.sy) > 1e-6 { f.sy } else { 1.0 }))
}

fn to_world(f, lx, ly) {
    let px = lx * f.sx;
    let py = ly * f.sy;
    (f.x + f.c * px - f.s * py, f.y + f.s * px + f.c * py)
}

/// The cell a world point falls in, counted from the top left. Outside the
/// grid is still a cell: painting there is what grows the map.
pub fn cell_at(S, f, wx, wy) {
    let (lx, ly) = to_local(f, wx, wy);
    let column = util::i(math::floor(lx / f.tw));
    let row = util::i(math::floor(-ly / f.th));
    (column, row)
}

/// The coordinate of the map's first stored cell.
pub fn origin(S) {
    let comp = match component(S.doc[S.sel]) {
        Some(comp) => comp,
        None => return (0, 0),
    };
    let at = util::vec3(comp.get("origin").unwrap_or(()), [0.0, 0.0, 0.0]);
    (util::i(util::f(at[0])), util::i(util::f(at[1])))
}

/// A cell's four corners in world space, for the hover outline.
fn cell_corners(f, column, row) {
    let x0 = util::f(column) * f.tw;
    let y1 = -util::f(row) * f.th;
    [
        to_world(f, x0, y1),
        to_world(f, x0 + f.tw, y1),
        to_world(f, x0 + f.tw, y1 - f.th),
        to_world(f, x0, y1 - f.th),
    ]
}

fn apply(S) {
    model::apply_component(S, "tilemap");
}

/// Put `tile` in every one of `cells`, growing the map to reach them.
///
/// The grid is read once, changed, and written back, so a drag across fifty
/// cells is one document write rather than fifty. History is recorded here
/// and only when something actually changes: clicking a cell that already
/// holds the tile must not cost an undo step.
pub fn write_cells(S, cells, tile, label, key) {
    let comp = match component(S.doc[S.sel]) {
        Some(comp) => comp,
        None => return false,
    };
    let rows = grid(S);
    let was_text = authored_as_text(S);
    let (ox, oy) = origin(S);
    // Reach every cell first: the rows grow left and up by moving the origin,
    // which is what keeps the tiles already down where they are.
    let low_x = ox;
    let low_y = oy;
    let high_x = ox + util::i(columns(rows));
    let high_y = oy + util::i(rows.len());
    for cell in cells {
        let (x, y) = cell;
        low_x = util::min(low_x, x);
        low_y = util::min(low_y, y);
        high_x = util::max(high_x, x + 1);
        high_y = util::max(high_y, y + 1);
    }
    let width = high_x - low_x;
    let grown = [];
    for y in low_y..high_y {
        let line = [];
        for x in low_x..high_x {
            let dy = y - oy;
            let dx = x - ox;
            let held = if dy >= 0 && dy < util::i(rows.len()) && dx >= 0 && dx < util::i(rows[dy].len()) {
                rows[dy][dx]
            } else {
                -1
            };
            line.push(held);
        }
        grown.push(line);
    }
    rows = grown;
    let changed = false;
    for cell in cells {
        let (x, y) = cell;
        let row = rows[y - low_y];
        if row[x - low_x] != tile {
            row[x - low_x] = tile;
            changed = true;
        }
        rows[y - low_y] = row;
    }
    if !changed {
        return false;
    }
    // Every row is as wide as the widest: a ragged grid draws the same, but
    // the text form cannot spell one and a diff of it reads badly.
    let widest = columns(rows);
    for i in 0..rows.len() {
        let row = rows[i];
        while row.len() < widest {
            row.push(-1);
        }
        rows[i] = row;
    }
    // Recorded with the document still as it was: everything below is the
    // step this undoes.
    history::record(S, label, key);
    comp.cells = cells_value(rows, was_text);
    comp.origin = [util::f(low_x), util::f(low_y)];
    apply(S);
    true
}

/// The tile at a cell, or -1 for an empty one or one off the grid.
pub fn cell(S, x, y) {
    let rows = grid(S);
    let (ox, oy) = origin(S);
    let dy = y - oy;
    let dx = x - ox;
    if dy < 0 || dy >= util::i(rows.len()) {
        return -1;
    }
    let row = rows[dy];
    if dx < 0 || dx >= util::i(row.len()) {
        return -1;
    }
    row[dx]
}

/// One cell. Every cell of one drag shares a history key, so the stroke is
/// one undo step however many cells it crossed.
pub fn paint(S, x, y, tile) {
    write_cells(S, [(x, y)], tile, if tile < 0 { "erase tiles" } else { "paint tiles" }, Some("tiles"))
}

/// Every cell of the rectangle between two corners, as one step.
pub fn fill_rect(S, from, to, tile) {
    let (x0, y0) = from;
    let (x1, y1) = to;
    let (lo_x, hi_x) = if x0 <= x1 { (x0, x1) } else { (x1, x0) };
    let (lo_y, hi_y) = if y0 <= y1 { (y0, y1) } else { (y1, y0) };
    let cells = [];
    for y in lo_y..(hi_y + 1) {
        for x in lo_x..(hi_x + 1) {
            cells.push((x, y));
        }
    }
    write_cells(S, cells, tile, if tile < 0 { "erase tiles" } else { "fill tiles" }, None)
}

/// A second map beside this one, same tile set and same place, with no tiles
/// in it: what a layer is. Duplicating is what gives it the parent, the
/// transform and a name nothing else has.
pub fn add_layer(S) {
    if !editable(S) {
        log::warn("select a tilemap to add a layer beside it");
        return false;
    }
    model::duplicate_selected(S);
    let comp = match component(S.doc[S.sel]) {
        Some(comp) => comp,
        None => return false,
    };
    comp.cells = if authored_as_text(S) { "" } else { [] };
    apply(S);
    true
}

/// Every tilemap under the selected map's parent: the layers of one map.
pub fn layers(S) {
    if !editable(S) {
        return [];
    }
    let parent = S.doc[S.sel].get("parent").unwrap_or("");
    let out = [];
    for (i, node) in S.doc.iter().enumerate() {
        if component(node).is_some() && node.get("parent").unwrap_or("") == parent {
            out.push(#{ index: i, name: node.name });
        }
    }
    out
}

pub fn set_mode(S, mode) {
    if util::contains(MODES, mode) {
        S.tiles.mode = mode;
        S.tiles.anchor = None;
    }
}

pub fn cancel(S) {
    S.tiles.stroke = None;
    S.tiles.anchor = None;
}

/// The pointer over the viewport, once per frame. The Tiles tool owns the
/// click the way the Polygon tool does: no gizmo, no camera drag.
pub fn update(S, over_viewport, mx, my) {
    let f = match frame(S) {
        Some(f) => f,
        None => {
            S.tiles.hover = None;
            return;
        }
    };
    let (x, y) = cell_at(S, f, mx, my);
    S.tiles.hover = if over_viewport { Some((x, y)) } else { None };
    let left = input::is_mouse_down(input::MOUSE_LEFT);
    let right = input::is_mouse_down(input::MOUSE_RIGHT);
    if !left && !right {
        // A rectangle is drawn on release, from the cell the drag began in.
        let anchor_some = S.tiles.anchor;
        if let Some(anchor) = anchor_some {
            let tile = if S.tiles.stroke == Some("erase") { -1 } else { S.tiles.tile };
            if S.tiles.mode == "line" {
                write_cells(S, line_cells(anchor, (x, y)), tile, "draw tiles", None);
            } else {
                fill_rect(S, anchor, (x, y), tile);
            }
        }
        cancel(S);
        history::commit(S);
        return;
    }
    if !over_viewport && S.tiles.stroke.is_none() {
        return;
    }
    let stroke = if left { "paint" } else { "erase" };
    let tile = if left { S.tiles.tile } else { -1 };
    if S.tiles.mode == "pick" {
        if S.tiles.stroke.is_none() {
            let held = cell(S, x, y);
            if held >= 0 {
                S.tiles.tile = held;
            }
            S.tiles.stroke = Some(stroke);
        }
        return;
    }
    if S.tiles.mode == "terrain" {
        S.tiles.stroke = Some(stroke);
        paint_terrain(S, x, y, if left { S.tiles.terrain } else { -1 });
        return;
    }
    if S.tiles.mode == "stamp" {
        S.tiles.stroke = Some(stroke);
        if left {
            stamp_at(S, x, y);
        } else {
            let (wide, tall) = S.tiles.stamp;
            fill_rect(S, (x, y), (x + wide - 1, y + tall - 1), -1);
        }
        return;
    }
    if S.tiles.mode == "bucket" {
        if S.tiles.stroke.is_none() {
            S.tiles.stroke = Some(stroke);
            let reached = flood(S, x, y);
            write_cells(S, reached, tile, "fill tiles", None);
        }
        return;
    }
    if S.tiles.mode == "line" {
        if S.tiles.anchor.is_none() {
            S.tiles.anchor = Some((x, y));
            S.tiles.stroke = Some(stroke);
        }
        return;
    }
    if S.tiles.mode == "rect" {
        if S.tiles.anchor.is_none() {
            S.tiles.anchor = Some((x, y));
            S.tiles.stroke = Some(stroke);
        }
        return;
    }
    S.tiles.stroke = Some(stroke);
    paint(S, x, y, tile);
}

fn line(a, b, color, width) {
    render::draw_line_2d(a.0, a.1, b.0, b.1, color[0], color[1], color[2], width);
}

fn outline(f, x, y, color, width) {
    let corners = cell_corners(f, x, y);
    for i in 0..4 {
        line(corners[i], corners[(i + 1) % 4], color, width);
    }
}

/// The grid over the map, the cell under the pointer, and the rectangle a
/// drag has swept so far.
pub fn draw(S) {
    if S.tool != "tiles" || !S.mode2d {
        return;
    }
    let f = match frame(S) {
        Some(f) => f,
        None => return,
    };
    let k = S.theme;
    let faint = util::rgb(k.faint);
    let accent = util::rgb(k.accent);
    let w = viewport::world_per_px(S);
    // The grid is a guide, not the drawing: one pixel wide, and skipped
    // entirely when a cell is too small on screen to aim at.
    if f.tw / w >= 6.0 {
        let last_x = f.ox + f.columns - 1;
        let last_y = f.oy + f.rows - 1;
        for row in f.oy..(f.oy + f.rows + 1) {
            let a = cell_corners(f, f.ox, row)[0];
            let b = cell_corners(f, last_x, row)[1];
            line(a, b, faint, 1.0);
        }
        for column in f.ox..(f.ox + f.columns + 1) {
            let a = cell_corners(f, column, f.oy)[0];
            let b = cell_corners(f, column, last_y)[3];
            line(a, b, faint, 1.0);
        }
    }
    let anchor_some = S.tiles.anchor;
    let hover_some = S.tiles.hover;
    if let Some(anchor) = anchor_some {
        if let Some(hover) = hover_some {
            if S.tiles.mode == "line" {
                for at in line_cells(anchor, hover) {
                    let (x, y) = at;
                    outline(f, x, y, accent, 1.5);
                }
                return;
            }
            let (x0, y0) = anchor;
            let (x1, y1) = hover;
            let (lo_x, hi_x) = if x0 <= x1 { (x0, x1) } else { (x1, x0) };
            let (lo_y, hi_y) = if y0 <= y1 { (y0, y1) } else { (y1, y0) };
            for y in lo_y..(hi_y + 1) {
                for x in lo_x..(hi_x + 1) {
                    outline(f, x, y, accent, 1.5);
                }
            }
            return;
        }
    }
    if let Some(hover) = hover_some {
        let (x, y) = hover;
        outline(f, x, y, viewport::hover_color(), 2.0);
    }
}

/// The tile set behind the map, as a file to write back to: an inline
/// definition is edited on the node instead, and has no file of its own.
fn tileset_file(S) {
    let comp = match component(S.doc[S.sel]) {
        Some(comp) => comp,
        None => return None,
    };
    let named = comp.get("tileset").unwrap_or("");
    if named is String && named != "" && !named.starts_with("#") {
        Some(named)
    } else {
        None
    }
}

/// Change one key of the selected tile in the tile set, and write the file.
///
/// The set is a file the game owns, not a node, so this edits it in place
/// rather than through the document's history.
fn edit_tile(S, key, value) {
    let rel = match tileset_file(S) {
        Some(rel) => rel,
        None => {
            log::warn("this map's tile set is written on the node, so there is no file to edit");
            return false;
        }
    };
    let path = S.game_root + "/" + rel;
    let (ok, definition) = script::attempt(|| assets::load(path));
    if !ok || !(definition is Object) {
        log::warn(format!("the tile set will not load: {:?}", definition));
        return false;
    }
    let tiles = definition.get("tiles").unwrap_or(#{});
    let id = format!("{}", S.tiles.tile);
    let tile = tiles.get(id).unwrap_or(#{});
    if value is () {
        tile.remove(key);
    } else {
        tile.insert(key, value);
    }
    tiles.insert(id, tile);
    definition.tiles = tiles;
    let (written, err) = script::attempt(|| assets::save(path, definition));
    if !written {
        log::warn(format!("the tile set would not save: {:?}", err));
        return false;
    }
    // The map is built from the file, so it has to be read again.
    apply(S);
    true
}

/// What the selected tile says about itself, out of the tile set's file.
fn tile_table(S) {
    let rel = match tileset_file(S) {
        Some(rel) => rel,
        None => return #{},
    };
    let (ok, definition) = script::attempt(|| assets::load(S.game_root + "/" + rel));
    if !ok || !(definition is Object) {
        return #{};
    }
    let tiles = definition.get("tiles").unwrap_or(#{});
    let found = tiles.get(format!("{}", S.tiles.tile));
    match found {
        Some(table) => if table is Object { table } else { #{} },
        None => #{},
    }
}

/// The Set panel: what the selected tile is, written back to the tile set.
pub fn set_panel(S, k) {
    let tile = tile_table(S);
    let solid = tile.get("collision").unwrap_or("") == "full";
    let one_way = tile.get("one_way").unwrap_or(false) == true;
    let occluder = tile.get("occluder").unwrap_or(false) == true;
    ui::add_space(4);
    ui::horizontal(#{ height: 26 }, || {
        ui::add_space(8);
        ui::label(format!("tile {}", S.tiles.tile), style::mono_sm(k.dim));
        ui::add_space(8);
        if ui::pill("Solid", #{
            height: 22, size: 11,
            fill: if solid { k.accent_soft } else { k.panel },
            stroke: k.line_soft,
            color: if solid { k.accent } else { k.dim },
        }) {
            edit_tile(S, "collision", if solid { () } else { "full" });
        }
        if ui::pill("One-way", #{
            height: 22, size: 11,
            fill: if one_way { k.accent_soft } else { k.panel },
            stroke: k.line_soft,
            color: if one_way { k.accent } else { k.dim },
        }) {
            edit_tile(S, "one_way", if one_way { () } else { true });
        }
        if ui::pill("Blocks light", #{
            height: 22, size: 11,
            fill: if occluder { k.accent_soft } else { k.panel },
            stroke: k.line_soft,
            color: if occluder { k.accent } else { k.dim },
        }) {
            edit_tile(S, "occluder", if occluder { () } else { true });
        }
    });
    let named = terrains(S);
    if named.len() > 0 {
        ui::horizontal(#{ height: 26 }, || {
            ui::add_space(8);
            ui::label("terrain", style::mono_sm(k.faint));
            for entry in named {
                let on = tile.get("terrain").unwrap_or("") == entry.name;
                if ui::pill(entry.name, #{
                    height: 22, size: 11,
                    fill: if on { k.accent_soft } else { k.panel },
                    stroke: k.line_soft,
                    color: if on { k.accent } else { k.dim },
                }) {
                    edit_tile(S, "terrain", if on { () } else { entry.name });
                }
            }
        });
    }
}

const SWATCH = 34.0;

/// The palette dock: the tile set's texture cut into tiles to pick from, the
/// two modes, and the layers of the map beside it.
pub fn palette(S, k) {
    if !editable(S) {
        ui::add_space(10);
        style::empty(k, "Select a node with a tilemap to paint it.");
        return;
    }
    let set = match tileset(S) {
        Some(set) => set,
        None => {
            ui::add_space(10);
            style::empty(k, "This tilemap names no tile set, or one that will not load.");
            return;
        }
    };
    ui::horizontal(#{ height: 30 }, || {
        ui::add_space(8);
        for id in MODES {
            let on = S.tiles.mode == id;
            if ui::pill(mode_name(id), #{
                height: 24, size: 11, strong: true,
                fill: if on { k.accent_soft } else { k.panel },
                stroke: k.line_soft,
                color: if on { k.accent } else { k.dim },
            }) {
                set_mode(S, id);
            }
        }
        ui::add_space(10);
        if ui::pill("Add layer", #{ height: 24, size: 11, fill: k.panel, stroke: k.line_soft, color: k.text }) {
            add_layer(S);
        }
        let editing = S.tiles.editing;
        if ui::pill("Set", #{
            height: 24, size: 11,
            fill: if editing { k.accent_soft } else { k.panel },
            stroke: k.line_soft,
            color: if editing { k.accent } else { k.text },
        }) {
            S.tiles.editing = !editing;
        }
        ui::right(|| {
            ui::add_space(8);
            ui::label(format!("tile {}", S.tiles.tile), style::mono_sm(k.faint));
        });
    });
    if S.tiles.mode == "stamp" {
        let (wide, tall) = S.tiles.stamp;
        ui::horizontal(#{ height: 26 }, || {
            ui::add_space(8);
            ui::label("block", style::mono_sm(k.faint));
            for size in [1, 2, 3, 4] {
                let on = wide == size;
                if ui::pill(format!("{} wide", size), #{
                    height: 22, size: 11,
                    fill: if on { k.accent_soft } else { k.panel },
                    stroke: k.line_soft,
                    color: if on { k.accent } else { k.dim },
                }) {
                    S.tiles.stamp = (size, tall);
                }
            }
            for size in [1, 2, 3, 4] {
                let on = tall == size;
                if ui::pill(format!("{} tall", size), #{
                    height: 22, size: 11,
                    fill: if on { k.accent_soft } else { k.panel },
                    stroke: k.line_soft,
                    color: if on { k.accent } else { k.dim },
                }) {
                    S.tiles.stamp = (wide, size);
                }
            }
        });
    }
    if S.tiles.mode == "terrain" {
        let named = terrains(S);
        if named.len() == 0 {
            ui::add_space(6);
            style::empty(k, "This tile set names no terrains, so there is nothing to paint.");
        } else {
            ui::horizontal(#{ height: 26 }, || {
                ui::add_space(8);
                for entry in named {
                    let on = S.tiles.terrain == entry.value;
                    if ui::pill(entry.name, #{
                        height: 22, size: 11,
                        fill: if on { k.accent_soft } else { k.panel },
                        stroke: k.line_soft,
                        color: if on { k.accent } else { k.dim },
                    }) {
                        S.tiles.terrain = entry.value;
                    }
                }
            });
        }
    }
    if S.tiles.editing {
        set_panel(S, k);
    }
    let count = tile_count(S);
    if count < 1 {
        ui::add_space(10);
        style::empty(k, "The tile set's texture could not be measured.");
        return;
    }
    let texture = S.game_root + "/" + set.texture;
    let per_row = util::max(util::i(math::floor((ui::available_width() - 16.0) / (SWATCH + 4.0))), 1);
    // The rows are cut before they are drawn: a `ui::` closure captures what
    // it reads, so a counter advanced inside one never reaches the loop
    // outside it, and the loop would never end.
    let shelves = [];
    let index = 0;
    while index < count {
        let shelf = [];
        let column = 0;
        while column < per_row && index < count {
            shelf.push(index);
            index += 1;
            column += 1;
        }
        shelves.push(shelf);
    }
    ui::scroll("tiles-palette", #{ max_height: util::max(S.layout.body_h - 44.0, 60.0) }, || {
        for shelf in shelves {
            ui::horizontal(#{ height: SWATCH + 4.0 }, || {
                ui::add_space(8);
                for tile in shelf {
                    let rect = tile_rect(set, tile);
                    if ui::image_button(texture, #{
                        width: SWATCH, height: SWATCH,
                        region: rect,
                        selected: S.tiles.tile == tile,
                        fill: k.sunken, stroke: k.accent, hover_fill: k.line,
                        tooltip: format!("tile {}", tile),
                    }) {
                        S.tiles.tile = tile;
                    }
                }
            });
        }
    });
    let found = layers(S);
    if found.len() > 1 {
        ui::add_space(6);
        style::section_label(k, "Layers");
        for layer in found {
            let on = layer.index == S.sel;
            if ui::pill(layer.name, #{
                height: 22, size: 11,
                fill: if on { k.accent_soft } else { k.panel },
                stroke: k.line_soft,
                color: if on { k.accent } else { k.dim },
            }) {
                crate::selection::only(S, layer.index);
            }
        }
    }
}
