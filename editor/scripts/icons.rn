// Every glyph the shell draws, named for what it means. Phosphor Fill, in the
// icons chain each font family falls back to; every weight of the set shares
// its codepoints, so a solid shell is the font file and nothing else.

/// A viewport tool, by `defs::tools` id.
pub fn tool(id) {
    match id {
        "select" => "\u{e1dc}",
        "move" => "\u{e0a4}",
        "rotate" => "\u{e036}",
        "scale" => "\u{e0a2}",
        "zoom" => "\u{e30c}",
        "key" => "\u{e1ec}",
        "bone" => "\u{e7f2}",
        "polygon" => "\u{e6d0}",
        "pen" => "\u{e64a}",
        "tiles" => "\u{e464}",
        _ => "\u{e1dc}",
    }
}

/// A persona, by `defs::personas` id.
pub fn persona(id) {
    match id {
        "scene" => "\u{e1da}",
        "script" => "\u{e1bc}",
        "anim" => "\u{e19a}",
        "phys" => "\u{e6ce}",
        "ui" => "\u{e6d6}",
        _ => "\u{e1da}",
    }
}

/// A dock panel, by its tab id.
/// The mark an inspector section wears, by component. A component with none
/// of its own takes the plain node mark, so every heading is marked.
/// A component's glyph, and the theme token it is drawn in -- the same pair
/// `model::node_icon` gives the tree, so a `body2d` section and a node holding
/// one read as the same thing in both panels.
pub fn component(name) {
    if name == "transform" {
        return (tool("move"), "node_plain");
    }
    if name == "widget" {
        return (persona("ui"), "node_ui");
    }
    if name == "script" {
        return (ui("scriptfile"), "node_plain");
    }
    if name == "bone2d" || name == "bone3d" || name == "skeleton" {
        return (tool("bone"), "node_bone");
    }
    if name == "polygon" || name == "shape2d" || name == "sprite" || name == "text2d" {
        return (tool("polygon"), "node_2d");
    }
    if name == "shape3d" || name == "mesh" || name == "text3d" {
        return (persona("scene"), "node_3d");
    }
    if name.starts_with("body") || name.starts_with("collider")
        || name.starts_with("character") || name.starts_with("joint")
        || name == "ragdoll" || name == "vehicle" {
        return (persona("phys"), "node_phys");
    }
    if name == "camera" || name == "camera2d" || name == "light" || name == "environment" {
        return (ui("viewmode"), "node_plain");
    }
    if name == "animation" || name == "animation_player" {
        return (panel("timeline"), "node_plain");
    }
    if name == "tilemap" || name == "tileset" {
        return (panel("tiles"), "node_2d");
    }
    if name == "audio" || name == "audio_player" {
        return (panel("session"), "node_plain");
    }
    if name == "bindings" || name == "events" {
        return (ui("events"), "node_plain");
    }
    (node("world"), "node_plain")
}

pub fn panel(id) {
    match id {
        "scene" => "\u{e67c}",
        "outline" => "\u{e2f0}",
        "inspector" => "\u{e432}",
        "import" => "\u{e2c6}",
        "output" => "\u{eae8}",
        "problems" => "\u{e4e0}",
        "assets" => "\u{e24a}",
        "docs" => "\u{e02f}",
        "timeline" => "\u{e792}",
        "debugger" => "\u{e5f4}",
        "session" => "\u{e3ee}",
        "profiler" => "\u{e150}",
        "tiles" => "\u{e464}",
        "weights" => "\u{e3ec}",
        "bonemap" => "\u{e0b0}",
        "library" => "\u{e468}",
        "material" => "\u{e6c8}",
        "cost" => "\u{e462}",
        "events" => "\u{e2e2}",
        _ => "\u{e546}",
    }
}

/// The shell's own controls.
pub fn ui(name) {
    match name {
        // Fill draws a stroke-only glyph as a solid tile, which is too heavy
        // for a mark this small: these two are letters, not icons.
        "add" => "+",
        "close" => "\u{00d7}",
        "check" => "\u{e182}",
        "reset" => "\u{e038}",
        "settings" => "\u{e270}",
        "export" => "\u{eaf0}",
        "minimise" => "\u{e32a}",
        "open" => "\u{e13c}",
        "shut" => "\u{e136}",
        "caret-open" => "\u{e136}",
        "caret-shut" => "\u{e13a}",
        "search" => "\u{e30c}",
        "dark" => "\u{e330}",
        "light" => "\u{e472}",
        "play" => "\u{e3d0}",
        "pause" => "\u{e39e}",
        "stop" => "\u{e46c}",
        "instance" => "\u{e1ca}",
        "events" => "\u{e2e2}",
        "split" => "\u{e546}",
        "restore" => "\u{e13c}",
        "collapse" => "\u{e136}",
        "caret-left" => "\u{e138}",
        "caret-right" => "\u{e13a}",
        "caret-up" => "\u{e13c}",
        "caret-down" => "\u{e136}",
        "arrow-line-left" => "\u{e062}",
        "arrow-line-right" => "\u{e064}",
        "arrow-line-down" => "\u{e05c}",
        "step-over" => "\u{e08c}",
        "step-into" => "\u{e05c}",
        "step-out" => "\u{e066}",
        "scriptfile" => "\u{e914}",
        "lock" => "\u{e2fa}",
        "unlock" => "\u{e306}",
        "visible" => "\u{e220}",
        "hidden" => "\u{e224}",
        "align-left" => "\u{e50e}",
        "align-right" => "\u{e510}",
        "align-center-h" => "\u{e50c}",
        "align-top" => "\u{e512}",
        "align-bottom" => "\u{e506}",
        "align-center-v" => "\u{e50a}",
        "distribute-h" => "\u{e534}",
        "distribute-v" => "\u{e536}",
        "group" => "\u{e6ce}",
        "ungroup" => "\u{e69a}",
        "select-all" => "\u{e69c}",
        "isolate" => "\u{e1d0}",
        "filter" => "\u{e268}",
        "light" => "\u{e2dc}",
        "sky" => "\u{e288}",
        "camera" => "\u{e4da}",
        "pen" => "\u{e64a}",
        "path" => "\u{e6d2}",
        "material" => "\u{e6c8}",
        "library" => "\u{e468}",
        "viewmode" => "\u{e744}",
        "bookmark" => "\u{e0e8}",
        "copy" => "\u{e1cc}",
        _ => "\u{ecde}",
    }
}

/// A node's kind in the tree, by the role `model::node_icon` reports.
pub fn node(role) {
    match role {
        "sage" => "\u{ebe4}",
        "accent" => "\u{e1da}",
        "dim" => "\u{e6d6}",
        "world" => "\u{e18a}",
        _ => "\u{e18a}",
    }
}
