/// A node's kind in the tree, by the role `model::node_icon` reports.
pub fn node(role) {
    match role {
        "sage" => "\u{ebe4}",
        "accent" => "\u{e1da}",
        "dim" => "\u{e6d6}",
        "world" => "\u{e18a}",
        _ => "\u{e18a}",
    }
}
