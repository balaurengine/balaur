// Every glyph the shell draws, named for what it means. Phosphor Fill, in the
// icons chain each font family falls back to; every weight of the set shares
// its codepoints, so a solid shell is the font file and nothing else.

/// A viewport tool, by `defs::tools` id.
pub fn tool(id) {
    match id {
        "select" => "\u{e1dc}",
        "move" => "\u{e0a4}",
        "rotate" => "\u{e036}",
        "scale" => "\u{e0a2}",
        "zoom" => "\u{e30c}",
        "key" => "\u{e1ec}",
        "bone" => "\u{e7f2}",
        "polygon" => "\u{e6d0}",
        "pen" => "\u{e64a}",
        "tiles" => "\u{e464}",
        _ => "\u{e1dc}",
    }
}

/// A persona, by `defs::personas` id.
pub fn persona(id) {
    match id {
        "scene" => "\u{e1da}",
        "script" => "\u{e1bc}",
        "anim" => "\u{e19a}",
        "phys" => "\u{e6ce}",
        "ui" => "\u{e6d6}",
        _ => "\u{e1da}",
    }
}

/// A dock panel, by its tab id.
pub fn panel(id) {
    match id {
        "scene" => "\u{e67c}",
        "outline" => "\u{e2f0}",
        "inspector" => "\u{e432}",
        "import" => "\u{e2c6}",
        "output" => "\u{eae8}",
        "problems" => "\u{e4e0}",
        "assets" => "\u{e24a}",
        "docs" => "\u{e02f}",
        "timeline" => "\u{e792}",
        "debugger" => "\u{e5f4}",
        "session" => "\u{e3ee}",
        "profiler" => "\u{e150}",
        "tiles" => "\u{e464}",
        "weights" => "\u{e3ec}",
        "bonemap" => "\u{e0b0}",
        "library" => "\u{e468}",
        "material" => "\u{e6c8}",
        "cost" => "\u{e462}",
        "events" => "\u{e2e2}",
        _ => "\u{e546}",
    }
}

