// Left column (262 px): node tree + per-workspace secondary panel.

use anim;
use arrange;
use defs;
use editor;
use icons;
use inspector;
use lint;
use model;
use pool;
use search;
use selection;
use shell;
use style;
use util;
use window;

pub struct TreeCache {
    key: str,
    rows: [any],
}

/// The workspace's secondary list: its title and its rows.
pub struct Secondary {
    title: str,
    rows: [Item],
}

/// One row of the secondary list, and what picking it does: `verb` is
/// "choose" (the node at `at`), "script" (the node running `rel`), "scene"
/// (open `rel`) or "" for a row that only says something.
pub struct Item {
    icon: str,
    name: str,
    meta: str,
    key: str,
    verb: str,
    at: int,
    rel: str,
}

pub struct OutlineView {
    items: [str],
    chosen: [str],
    filtering: bool,
    nothing: str,
    add_icon: str,
}

pub struct Built {
    items: [str],
    chosen: [str],
}

/// Where the tree drew a row, in design px.
pub struct RowSpot {
    x: float,
    y: float,
}

// The Scene tab is its own scene and script (scenes/panels/scene_tree.toml);
// this file builds the rows it asks for and acts on what it picks.
const PANEL: str = "Editor/Shell/Body/Left/LeftSheet/SceneTree";

const TREE_NODE: str = "Editor/Shell/Body/Left/LeftSheet/SceneTree/Tree";

const OUTLINE: str = "Editor/Shell/Body/Left/LeftSheet/Outline";

// The pitch the `tree` node draws at. Stated rather than measured: the node
// takes it as `row_height`, so `row_spot` and the rows cannot drift apart.
const TREE_ROW: float = 23.0;

// The names the tree reports a row's marks by.
const MARK_EYE: str = "eye";

const MARK_LOCK: str = "lock";

// Rebuilt only when the document or a fold changed; both loops below are
// linear in the document, which the drawing no longer is.
fn open_rows(S: &mut editor::State) -> [any] {
    let key = "{S.doc_rev}:{S.doc.len()}:{S.collapsed.len()}";
    if S.tree_cache.key == key {
        return S.tree_cache.rows;
    }
    let kids = map();
    for i in 0..S.doc.len() {
        let parent = S.doc[i].parent.as_str();
        if !kids.has(parent) {
            let none: [int] = [];
            kids.set(parent, none);
        }
        kids.get(parent).push(i);
    }
    let rows = flatten(S, kids, "", 0);
    S.tree_cache = TreeCache { key: key, rows: rows };
    rows
}

// `kids` is bucketed by the parent's **id**, so the recursion carries an id
// too: no bucket is ever keyed by a path.
fn flatten(S: editor::State, kids: any, parent_id: str, depth: int) -> [any] {
    let out: [any] = [];
    let children = util::vec(kids.get(parent_id));
    for j in 0..children.len() {
        let i = children[j].as_int();
        let id = S.doc[i].id.as_str();
        let is_last = j == children.len() - 1;
        let has_kids = kids.has(id);
        out.push(map().with("index", i).with("depth", depth).with("is_last", is_last).with("has_kids", has_kids));
        if has_kids && !S.collapsed.has(id) {
            for row in flatten(S, kids, id, depth + 1) {
                out.push(row);
            }
        }
    }
    out
}

// `key` tells apart two rows that read the same; it is never drawn.
fn item(icon: str, name: str, meta: str, key: str, verb: str, at: int, rel: str) -> Item {
    Item { icon: icon, name: name, meta: meta, key: key, verb: verb, at: at, rel: rel }
}

// A row that only says something: picking it does nothing.
fn said(icon: str, name: str) -> Item {
    item(icon, name, "", "", "", -1, "")
}

// Per-workspace secondary contents, from real project data where it exists.
// The title and the rows; drawing is the caller's, so the tree above can size
// itself to what this actually holds.
fn secondary_content(S: &mut editor::State) -> Secondary {
    let rows: [Item] = [];
    if S.workspace == defs::WORKSPACE_SCRIPT {
        for f in model::list(S, "scripts") {
            let name = f.name.as_str();
            if !f.is_dir.as_bool() && name.ends_with(".bs") {
                let rel = "scripts/" + name;
                rows.push(item("‹›", name, "{model::line_count(S, rel)} L", rel, "script", -1, rel));
            }
        }
        return Secondary { title: "Scripts", rows: rows };
    }
    if S.workspace == defs::WORKSPACE_PHYSICS {
        // A 2D scene carries `body2d`/`collider2d`; reading `body` alone left
        // this panel empty for every 2D project.
        for i in 0..S.doc.len() {
            let node = S.doc[i];
            let kind = model::body_kind(node);
            if kind.is_nil() {
                kind = model::body2d_kind(node);
            }
            let collider = node.has("collider3d") || node.has("collider2d");
            if !kind.is_nil() || collider {
                let dim = if node.has("body2d") || node.has("collider2d") { "2D" } else { "3D" };
                let what = if kind.is_nil() { "collider3d" } else { kind.as_str() };
                rows.push(item("▣", node.name.as_str(), "{what} · {dim}", node.id.as_str(), "choose", i, ""));
            }
        }
        if rows.len() == 0 {
            rows.push(said("▣", "no bodies or colliders"));
        }
        return Secondary { title: "Collision", rows: rows };
    }
    if S.workspace == defs::WORKSPACE_ANIMATION {
        for i in 0..S.doc.len() {
            let node = S.doc[i];
            if !anim::component(node).is_nil() {
                let name = anim::clip_name(node);
                let library = anim::library_path(node);
                let shown = if name == "" { node.name.as_str() } else { name };
                rows.push(item("◷", shown, if library.is_none() { "inline" } else { library.unwrap() }, node.id.as_str(), "choose", i, ""));
            }
        }
        if rows.len() == 0 {
            rows.push(said("◷", "no clips — {icons::ui("add")} Key in Timeline"));
        }
        return Secondary { title: "Clips", rows: rows };
    }
    if S.workspace == defs::WORKSPACE_UI {
        for i in 0..S.doc.len() {
            let node = S.doc[i];
            let widget = node.widget;
            if !widget.is_nil() {
                let kind = if widget.kind() != "map" {
                    widget.text()
                } else if widget.kind.is_nil() {
                    "widget"
                } else {
                    widget.kind.as_str()
                };
                rows.push(item("▤", node.name.as_str(), kind, node.id.as_str(), "choose", i, ""));
            }
        }
        if rows.len() == 0 {
            rows.push(said("▤", "no widgets"));
        }
        return Secondary { title: "Widgets", rows: rows };
    }
    for f in model::list(S, "scenes") {
        if !f.is_dir.as_bool() {
            let name = f.name.as_str();
            let rel = "scenes/" + name;
            rows.push(item("◇", name, if S.scene_rel == rel { "open" } else { "" }, rel, "scene", -1, rel));
        }
    }
    Secondary { title: "Scenes", rows: rows }
}

// What picking a secondary row does.
fn act(S: &mut editor::State, row: Item) {
    if row.verb == "choose" {
        shell::choose(S, row.at);
    } else if row.verb == "script" {
        for i in 0..S.doc.len() {
            if model::script_rel(S.doc[i]).as_str() == row.rel {
                shell::choose(S, i);
                return;
            }
        }
    } else if row.verb == "scene" && S.scene_rel != row.rel {
        model::open_scene(S, row.rel);
    }
}

/// The tab name the workspace's secondary list gets.
pub fn outline_title(S: &mut editor::State) -> str {
    secondary_content(S).title
}

/// Whether a node has any component carrying `tag`, which is what a facet
/// chip filters on.
fn tagged(S: editor::State, i: int, tag: str) -> bool {
    if tag == "script" {
        return S.doc[i].has("script");
    }
    let found = model::live(S, i);
    if !found.is_valid() {
        return false;
    }
    for name in found.component_names() {
        let tags = scene::component_tags(name);
        if tags.is_some() && util::contains(tags.unwrap(), tag) {
            return true;
        }
    }
    false
}

/// The Scene panel's rows for a search and a facet tag: each row's string,
/// the selected ones, and what to say when the filter leaves none.
pub fn outline_view(S: &mut editor::State, query: str, facet: str) -> OutlineView {
    let filtering = query != "" || facet != "";
    let rows = if filtering { filtered_rows(S, query, facet) } else { open_rows(S) };
    let built = tree_items(S, S.theme, rows);
    let says = if query != "" { query } else { facet };
    OutlineView {
        items: built.items,
        chosen: built.chosen,
        filtering: filtering,
        nothing: search::nothing_says(says),
        add_icon: icons::ui("add"),
    }
}

/// A row the Scene panel's tree picked, by the id its string carries: that
/// node is chosen, with the modifiers the click was made with.
pub fn outline_pick(S: &mut editor::State, row: str) {
    let found = model::index_of_id(S.doc, row_id(row));
    if found.is_some() {
        let i = found.unwrap();
        if i != S.sel {
            shell::choose_click(S, i);
        }
    }
}

// Each row's string, and the strings of the selected rows.
fn tree_items(S: editor::State, k: any, rows: [any]) -> Built {
    let items: [str] = [];
    for row in rows {
        let i = row.index.as_int();
        let node = S.doc[i];
        let id = node.id.as_str();
        let icon = model::node_icon(node);
        // The type's own colour on the row, which is what a mark alone
        // cannot say: 2D, 3D, UI and physics each read at a glance. The id is
        // the row's key: two nodes may share a name, never a row.
        let note = if lint::warned(S, id).len() > 0 { "⚠" } else { "" };
        let tint = if k.get(icon._1).is_nil() { k.text_default.as_str() } else { k.get(icon._1).as_str() };
        let line = util::repeat("\t", row.depth.as_int());
        items.push(line + util::cells([icon._0, node.name.as_str(), note, tint, id, row_marks(S, i)]));
    }
    // Every selected node lit, not only the active one: the document holds a
    // set, and `multi_select` is what draws one.
    let chosen: [str] = [];
    for n in 0..rows.len() {
        let row = rows[n];
        if selection::contains(S, row.index.as_int()) {
            chosen.push(items[n]);
        }
    }
    Built { items: items, chosen: chosen }
}

/// The eye on every row, open or closed, and the lock only on a locked one,
/// rightmost: the tree draws them and reports a click as `tree_mark`.
pub fn row_marks(S: editor::State, i: int) -> str {
    let eye = if arrange::is_hidden(S, i) { "eye-closed" } else { "visible" };
    let marks = "{MARK_EYE}={icons::ui(eye)}";
    if selection::is_locked(S, i) {
        marks += "\u{1e}{MARK_LOCK}={icons::ui("lock")}";
    }
    marks
}

// The node id a tree row's string carries, its fifth cell.
fn row_id(row: str) -> str {
    let parts = row.split("\u{1f}");
    if parts.len() > 4 { parts[4] } else { "" }
}

/// A mark clicked on a tree row: the eye shows or hides that node, the lock
/// unlocks it. The row stays as it was picked, or not.
pub fn mark_clicked(S: &mut editor::State, row: str, mark: str) {
    let i_or = model::index_of_id(S.doc, row_id(row));
    if i_or.is_none() {
        return;
    }
    let i = i_or.unwrap();
    if mark == MARK_EYE {
        arrange::toggle_hidden_of(S, [i]);
    } else if mark == MARK_LOCK {
        arrange::toggle_locked_of(S, [i]);
    }
}

/// Where the tree drew the row for document index `i`, in design px; `None`
/// before it has drawn. The node's own rect, so no caller counts the chrome
/// above it, and the walk's row, so a folded branch cannot shift it.
pub fn row_spot(S: &mut editor::State, i: int) -> RowSpot? {
    let found = scene::get_node(TREE_NODE);
    if !found.is_valid() {
        return nil;
    }
    let rect = ui::widget_rect(found);
    if rect.is_none() {
        return nil;
    }
    let box = rect.unwrap();
    let n = selected_row(open_rows(S), i) as float;
    RowSpot { x: box.x + box.width * 0.4, y: box.y + (n + 0.5) * TREE_ROW }
}

// Which drawn row is the selection, so the node can mark it.
fn selected_row(rows: [any], sel: int) -> int {
    for n in 0..rows.len() {
        if rows[n].index.as_int() == sel {
            return n;
        }
    }
    0
}

// Hidden while another panel is up; it fills itself, so showing it is all
// the dock does.
pub fn hide_tree(S: editor::State) {
    util::hide(PANEL);
}

pub fn show_tree() {
    let found = scene::get_node(PANEL);
    if found.is_valid() {
        found.patch_component("widget", map().with("visible", true));
    }
}

// Every node the query and the facet chip both allow, as a flat walk. One
// shape with `open_rows`, so the same node draws both.
fn filtered_rows(S: editor::State, query: str, facet: str) -> [any] {
    let out: [any] = [];
    for i in 0..S.doc.len() {
        let node = S.doc[i];
        let text = "{node.name.as_str()} {model::node_type(node)}";
        if !search::matches(query, text) {
            continue;
        }
        if facet != "" && !tagged(S, i, facet) {
            continue;
        }
        out.push(map().with("index", i).with("depth", 0).with("is_last", true).with("has_kids", false));
    }
    out
}

/// The Outline tab's rows for the workspace, one string a row.
pub fn secondary_view(S: &mut editor::State) -> [str] {
    let items: [str] = [];
    for row in secondary_content(S).rows {
        items.push(util::cells([row.icon, row.name, row.meta, "", row.key]));
    }
    items
}

/// The Outline tab picked the row written `picked`: that row's own action,
/// found again by its string rather than held on the node.
pub fn secondary_pick(S: &mut editor::State, picked: str) {
    for row in secondary_content(S).rows {
        if util::cells([row.icon, row.name, row.meta, "", row.key]) == picked {
            act(S, row);
        }
    }
}

pub fn show_outline() {
    let found = scene::get_node(OUTLINE);
    if found.is_valid() {
        found.patch_component("widget", map().with("visible", true));
    }
}

// Hidden while another panel is up, the way the tree is.
pub fn hide_outline() {
    util::hide(OUTLINE);
}

/// Open the rename sheet on the selected node, with its name ready to replace.
pub fn rename_open(S: &mut editor::State) {
    if !model::has_selection(S) {
        return;
    }
    S.renaming = true;
    S.rename_text = S.doc[S.sel].get("name").as_str();
    window::picker_changed(S);
}

pub fn rename_close(S: &mut editor::State) {
    S.renaming = false;
    window::picker_shut(S);
}

/// One field and one verb, on the picker every search box in the shell uses:
/// the tree is a widget-layer list, which has no cell to edit in place, so
/// the rename happens over it.
/// Fill the picker: what its script asks for while a rename is up.
pub fn rename_fill(S: &mut editor::State) {
    let row_h = util::max(style::row_h(S), 28.0);
    let host = window::picker(S, map()
        .with("width", 420.0)
        // The node's own mark, which is what the tree row it renames wears.
        .with("mark", node_mark(S))
        .with("placeholder", "Name")
        .with("query", S.rename_text)
        .with("rows_h", row_h + 6.0)
        .with("on", "handle")
        .with("on_submit", "handle_submit")
        .with("data", map().with("fn", rename_fill_on_9).with("submit", rename_fill_on_10)));
    pool::sync(S, host, [
        map()
            .with("full", true)
            .with("height", row_h)
            .with("controls", [
                map()
                    .with("kind", "button")
                    .with("role", "action_form_primary")
                    .with("grow", 1)
                    .with("text", "Rename")
                    .with("on", "handle")
                    .with("data", map().with("fn", rename_fill_on_11)),
            ]),
    ], 0.0, false);
}

fn rename_fill_on_9(S: &mut editor::State, data: any, text: any) {
    S.rename_text = text.as_str();
}

fn rename_fill_on_10(S: &mut editor::State, data: any, text: any) {
    S.rename_text = text.as_str();
    apply_rename(S);
}

fn rename_fill_on_11(S: &mut editor::State, data: any, _0: any) {
    apply_rename(S);
}

fn node_mark(S: editor::State) -> any {
    let found = model::selected_row(S);
    if !found.is_nil() {
        let node = found;
        let mark_1 = model::node_icon(node);
        let mark = mark_1._0;
        mark
    } else {
        icons::ui("search")
    }
}

fn apply_rename(S: &mut editor::State) {
    model::rename_selected(S, S.rename_text);
    rename_close(S);
}
