// Left column (262 px): node tree + per-workspace secondary panel.

use anim;
use arrange;
use defs;
use editor;
use icons;
use lint;
use model;
use search;
use selection;
use shell;
use style;
use util;
use window;
use words::components;
use words::fields;
use words::form_fields;
use words::hooks;
use words::layout_fields;
use words::project_fields;
use words::roles;
use words::tabs;
use words::theme_tokens;

const CHOOSE: str = "choose";
const INLINE: str = "inline";
const OPEN: str = "open";
const SCENES: str = "scenes";
const SCRIPTS: str = "scripts";
const DEPTH: str = "depth";
const HAS_KIDS: str = "has_kids";
const IS_LAST: str = "is_last";

pub struct TreeCache {
    internal key: str,
    internal rows: [any],
}

/// The workspace's secondary list: its title and its rows.
pub struct Secondary {
    title: str,
    rows: [Item],
}

/// One row of the secondary list, and what picking it does: `verb` is
/// "choose" (the node at `at`), "script" (the node running `rel`), "scene"
/// (open `rel`) or "" for a row that only says something.
pub struct Item {
    icon: str,
    name: str,
    meta: str,
    key: str,
    verb: str,
    at: int,
    rel: str,
}

pub struct OutlineView {
    /// The rows, or none where they are the ones `stamp` already names.
    internal items: [ui::Item],
    internal stamp: str,
    internal chosen: [str],
    internal empty: bool,
    internal filtering: bool,
    internal nothing: str,
    internal add_icon: str,
}

/// Where the tree drew a row, in design px.
pub struct RowSpot {
    internal x: float,
    internal y: float,
}

// The Scene tab is its own scene and script (scenes/panels/scene_tree.toml);
// this file builds the rows it asks for and acts on what it picks.
const PANEL: str = "Editor/Shell/Body/Left/LeftSheet/SceneTree";

const TREE_NODE: str = "Editor/Shell/Body/Left/LeftSheet/SceneTree/Tree";

const OUTLINE: str = "Editor/Shell/Body/Left/LeftSheet/Outline";

// The pitch the `tree` node draws at. Stated rather than measured: the node
// takes it as `row_height`, so `row_spot` and the rows cannot drift apart.
const TREE_ROW: float = 23.0;

// The names the tree reports a row's marks by.
const MARK_EYE: str = "eye";

const MARK_LOCK: str = "lock";

/// Rebuilt only when the rows were listed again (`model::reindex` drops the
/// key) or a fold changed. The rows are the tree in order already, so this is
/// one pass: a node's depth is its parent's and one, and a folded node hides
/// the rows under it.
fn open_rows(state: &mut editor::State) -> [any] {
    let key = "{state.nodes.len()}:{state.collapsed.len()}";
    if state.tree_cache.key == key {
        return state.tree_cache.rows;
    }
    let rows: [any] = [];
    let depth_of: any = {};
    let folded: Node = nil;
    for index in 0..state.nodes.len() {
        let found = state.nodes[index];
        if folded.is_valid() && found != folded && model::is_within(found, folded) {
            continue;
        }
        folded = nil;
        let id = found.stable_id();
        let parent = model::parent_id(state, found);
        let depth = if parent == "" { 0 } else { depth_of[parent].as_int() + 1 };
        depth_of[id] = depth;
        let has_kids = found.children().len() > 0;
        let is_last = model::is_scene_root(state, found) || found.sibling_index() == found.parent().children().len() - 1;
        rows.push({ fields::INDEX: index, DEPTH: depth, IS_LAST: is_last, HAS_KIDS: has_kids });
        if has_kids && state.collapsed.has(id) {
            folded = found;
        }
    }
    state.tree_cache = TreeCache { key: key, rows: rows };
    rows
}

// `key` tells apart two rows that read the same; it is never drawn.
fn item(icon: str, name: str, meta: str, key: str, verb: str, at: int, rel: str) -> Item {
    Item { icon: icon, name: name, meta: meta, key: key, verb: verb, at: at, rel: rel }
}

// A row that only says something: picking it does nothing.
fn said(icon: str, name: str) -> Item {
    item(icon, name, "", "", "", -1, "")
}

// Per-workspace secondary contents, from real project data where it exists.
// The title and the rows; drawing is the caller's, so the tree above can size
// itself to what this actually holds.
fn secondary_content(state: &mut editor::State) -> Secondary {
    let rows: [Item] = [];
    if state.workspace == defs::WORKSPACE_SCRIPT {
        for file in model::list(state, SCRIPTS) {
            let name = file[fields::NAME].as_str();
            if !file[project_fields::IS_DIR].as_bool() && name.ends_with(".bs") {
                let rel = "scripts/" + name;
                rows.push(item("‹›", name, "{model::line_count(state, rel)} L", rel, tabs::SCRIPT, -1, rel));
            }
        }
        return Secondary { title: "Scripts", rows: rows };
    }
    if state.workspace == defs::WORKSPACE_PHYSICS {
        // A 2D scene carries `body2d`/`collider2d`; reading `body` alone left
        // this panel empty for every 2D project.
        for index in 0..state.nodes.len() {
            let found = state.nodes[index];
            let kind = model::body_kind(found);
            if kind == nil {
                kind = model::body2d_kind(found);
            }
            let collider = found.has_component(components::COLLIDER3D) || found.has_component(components::COLLIDER2D);
            if kind != nil || collider {
                let dimension = if found.has_component(components::BODY2D) || found.has_component(components::COLLIDER2D) { "2D" } else { "3D" };
                let what = if kind == nil { components::COLLIDER3D } else { kind.as_str() };
                rows.push(item("▣", found.name(), "{what} · {dimension}", found.stable_id(), CHOOSE, index, ""));
            }
        }
        if rows.len() == 0 {
            rows.push(said("▣", "no bodies or colliders"));
        }
        return Secondary { title: "Collision", rows: rows };
    }
    if state.workspace == defs::WORKSPACE_ANIMATION {
        for index in 0..state.nodes.len() {
            let found = state.nodes[index];
            if found.has_component(tabs::ANIMATION) {
                let name = anim::clip_name(state, found);
                let library = anim::library_path(state, found);
                let shown = if name == "" { found.name() } else { name };
                rows.push(item("◷", shown, if library == nil { INLINE } else { library.unwrap() }, found.stable_id(), CHOOSE, index, ""));
            }
        }
        if rows.len() == 0 {
            rows.push(said("◷", "no clips — {icons::ui("add")} Key in Timeline"));
        }
        return Secondary { title: "Clips", rows: rows };
    }
    if state.workspace == defs::WORKSPACE_UI {
        for index in 0..state.nodes.len() {
            let found = state.nodes[index];
            if found.has_component(components::WIDGET) {
                let widget = found.authored(components::WIDGET);
                let kind = if widget[fields::KIND] == nil { components::WIDGET } else { widget[fields::KIND].as_str() };
                rows.push(item("▤", found.name(), kind, found.stable_id(), CHOOSE, index, ""));
            }
        }
        if rows.len() == 0 {
            rows.push(said("▤", "no widgets"));
        }
        return Secondary { title: "Widgets", rows: rows };
    }
    for file in model::list(state, SCENES) {
        if !file[project_fields::IS_DIR].as_bool() {
            let name = file[fields::NAME].as_str();
            let rel = "scenes/" + name;
            rows.push(item("◇", name, if state.scene_rel == rel { OPEN } else { "" }, rel, tabs::SCENE, -1, rel));
        }
    }
    Secondary { title: "Scenes", rows: rows }
}

// What picking a secondary row does.
fn act(state: &mut editor::State, row: Item) {
    if row.verb == CHOOSE {
        shell::choose(state, row.at);
    } else if row.verb == tabs::SCRIPT {
        for index in 0..state.nodes.len() {
            if model::script_rel(state.nodes[index]).as_str() == row.rel {
                shell::choose(state, index);
                return;
            }
        }
    } else if row.verb == tabs::SCENE && state.scene_rel != row.rel {
        model::open_scene(state, row.rel);
    }
}

/// The tab name the workspace's secondary list gets.
pub fn outline_title(state: &mut editor::State) -> str {
    secondary_content(state).title
}

/// Whether a node has any component carrying `tag`, which is what a facet
/// chip filters on.
fn tagged(state: editor::State, index: int, tag: str) -> bool {
    let found = model::node(state, index);
    if tag == tabs::SCRIPT {
        return model::script_rel(found) != nil;
    }
    if !found.is_valid() {
        return false;
    }
    for name in found.component_names() {
        let tags = scene::component_tags(name);
        if tags != nil && util::contains(tags.unwrap(), tag) {
            return true;
        }
    }
    false
}

/// The Scene panel's rows for a search and a facet tag: each row, the keys of
/// the selected ones, and what to say when the filter leaves none. A panel that
/// drew the rows `drawn` names is handed none: a click moves the selection, and
/// on a long document the rows are most of what a click costs.
pub fn outline_view(state: &mut editor::State, query: str, facet: str, drawn: str) -> OutlineView {
    let filtering = query != "" || facet != "";
    let rows = if filtering { filtered_rows(state, query, facet) } else { open_rows(state) };
    let stamp = "{state.outline_rows}|{query}|{facet}";
    let says = if query != "" { query } else { facet };
    OutlineView {
        items: if stamp == drawn { [] } else { tree_items(state, state.theme, rows) },
        stamp: stamp,
        chosen: chosen_keys(state, rows),
        empty: rows.len() == 0,
        filtering: filtering,
        nothing: search::nothing_says(says),
        add_icon: icons::ui(icons::ADD),
    }
}

/// A row the Scene panel's tree picked, by the id that is its key: that node
/// is chosen, with the modifiers the click was made with.
pub fn outline_pick(state: &mut editor::State, row: str) {
    let found = model::index_of_id(state, row);
    if found != nil {
        let index = found.unwrap();
        if index != state.selected {
            shell::choose_click(state, index);
        }
    }
}

// Every selected node lit, not only the active one: the document holds a set,
// and `multi_select` is what draws one.
fn chosen_keys(state: editor::State, rows: [any]) -> [str] {
    let chosen: [str] = [];
    for row in rows {
        let index = row[fields::INDEX].as_int();
        if selection::contains(state, index) {
            chosen.push(state.nodes[index].stable_id());
        }
    }
    chosen
}

fn tree_items(state: editor::State, tokens: any, rows: [any]) -> [ui::Item] {
    let items: [ui::Item] = [];
    for row in rows {
        let index = row[fields::INDEX].as_int();
        let node = state.nodes[index];
        let id = node.stable_id();
        let icon = model::node_icon(node);
        // The type's own colour on the row, which is what a mark alone
        // cannot say: 2D, 3D, UI and physics each read at a glance. The id is
        // the row's key: two nodes may share a name, never a row.
        let note = if lint::warned(state, id).len() > 0 { "⚠" } else { "" };
        let tint = if tokens[icon.role] == nil { tokens[theme_tokens::TEXT_DEFAULT].as_str() } else { tokens[icon.role].as_str() };
        items.push(ui::Item { icon: icon.glyph, label: node.name(), note: note, tint: tint, key: id, depth: row[DEPTH].as_int(), marks: row_marks(state, index) });
    }
    items
}

/// The eye on every row, open or closed, and the lock only on a locked one,
/// rightmost: the tree draws them and reports a click as `tree_mark`.
pub fn row_marks(state: editor::State, index: int) -> [ui::Mark] {
    let eye = if arrange::is_hidden(state, index) { "eye-closed" } else { components::VISIBLE };
    let marks = [ui::Mark { name: MARK_EYE, glyph: icons::ui(eye) }];
    if selection::is_locked(state, index) {
        marks.push(ui::Mark { name: MARK_LOCK, glyph: icons::ui("lock") });
    }
    marks
}

/// A mark clicked on a tree row: the eye shows or hides that node, the lock
/// unlocks it. The row stays as it was picked, or not.
pub fn mark_clicked(state: &mut editor::State, row: str, mark: str) {
    let index_or = model::index_of_id(state, row);
    if index_or == nil {
        return;
    }
    let index = index_or.unwrap();
    if mark == MARK_EYE {
        arrange::toggle_hidden_of(state, [index]);
    } else if mark == MARK_LOCK {
        arrange::toggle_locked_of(state, [index]);
    }
}

/// Where the tree drew the row for document index `index`, in design px; `None`
/// before it has drawn. The node's own rect, so no caller counts the chrome
/// above it, and the walk's row, so a folded branch cannot shift it.
pub fn row_spot(state: &mut editor::State, index: int) -> RowSpot? {
    let found = scene::get_node(TREE_NODE);
    if !found.is_valid() {
        return nil;
    }
    let rect = ui::widget_rect(found);
    if rect == nil {
        return nil;
    }
    let box = rect.unwrap();
    let position = selected_row(open_rows(state), index) as float;
    RowSpot { x: box.x + box.width * 0.4, y: box.y + (position + 0.5) * TREE_ROW }
}

// Which drawn row is the selection, so the node can mark it.
fn selected_row(rows: [any], selected_index: int) -> int {
    for position in 0..rows.len() {
        if rows[position][fields::INDEX].as_int() == selected_index {
            return position;
        }
    }
    0
}

// Hidden while another panel is up; it fills itself, so showing it is all
// the dock does.
pub fn hide_tree(state: editor::State) {
    util::hide(PANEL);
}

pub fn show_tree() {
    let found = scene::get_node(PANEL);
    if found.is_valid() {
        found.set_visible(true);
    }
}

// Every node the query and the facet chip both allow, as a flat walk. One
// shape with `open_rows`, so the same node draws both.
fn filtered_rows(state: editor::State, query: str, facet: str) -> [any] {
    let out: [any] = [];
    for index in 0..state.nodes.len() {
        let node = state.nodes[index];
        let text = "{node.name()} {model::node_type(node)}";
        if !search::matches(query, text) {
            continue;
        }
        if facet != "" && !tagged(state, index, facet) {
            continue;
        }
        out.push({ fields::INDEX: index, DEPTH: 0, IS_LAST: true, HAS_KIDS: false });
    }
    out
}

/// The Outline tab's rows for the workspace.
pub fn secondary_view(state: &mut editor::State) -> [ui::Item] {
    let items: [ui::Item] = [];
    for row in secondary_content(state).rows {
        items.push(ui::Item { icon: row.icon, label: row.name, note: row.meta, key: row.key });
    }
    items
}

/// The Outline tab picked the row `picked` names: that row's own action,
/// found again by its key rather than held on the node.
pub fn secondary_pick(state: &mut editor::State, picked: str) {
    for row in secondary_content(state).rows {
        if row.key == picked {
            act(state, row);
        }
    }
}

pub fn show_outline() {
    let found = scene::get_node(OUTLINE);
    if found.is_valid() {
        found.set_visible(true);
    }
}

// Hidden while another panel is up, the way the tree is.
pub fn hide_outline() {
    util::hide(OUTLINE);
}

/// Open the rename sheet on the selected node, with its name ready to replace.
pub fn rename_open(state: &mut editor::State) {
    if !model::has_selection(state) {
        return;
    }
    state.renaming = true;
    state.rename_text = model::selected_node(state).name();
    window::picker_changed(state);
}

pub fn rename_close(state: &mut editor::State) {
    state.renaming = false;
    window::picker_shut(state);
}

/// One field and one verb, on the picker every search box in the shell uses:
/// the tree is a widget-layer list, which has no cell to edit in place, so
/// the rename happens over it.
/// Fill the picker: what its script asks for while a rename is up.
pub fn rename_fill(state: &mut editor::State) {
    let row_height = util::max(style::row_height(state), 28.0);
    let host = window::picker(state, {
        layout_fields::WIDTH: 420.0,
        fields::MARK: node_mark(state),
        form_fields::PLACEHOLDER: "Name",
        form_fields::QUERY: state.rename_text,
        form_fields::ROWS_H: row_height + 6.0,
        form_fields::ON_CHANGE: hooks::HANDLE,
        form_fields::ON_SUBMIT: hooks::HANDLE_SUBMIT,
        fields::DATA: { fields::FN: on_rename_typed, project_fields::SUBMIT: on_rename_submitted },
    });
    ui::fill_rows(host, [
        ui::Row {
            height: row_height,
            controls: [
                ui::Control {
                    kind: ui::WIDGET_BUTTON,
                    role: roles::ACTION_FORM_PRIMARY,
                    grow: 1,
                    text: "Rename",
                    on_click: "handle",
                    data: { fields::FN: on_rename_clicked },
                },
            ],
        },
    ]);
}

fn on_rename_typed(state: &mut editor::State, data: any, text: any) {
    state.rename_text = text.as_str();
}

fn on_rename_submitted(state: &mut editor::State, data: any, text: any) {
    state.rename_text = text.as_str();
    apply_rename(state);
}

fn on_rename_clicked(state: &mut editor::State, data: any, _value: any) {
    apply_rename(state);
}

fn node_mark(state: editor::State) -> any {
    let found = model::selected_node(state);
    if found.is_valid() { model::node_icon(found).glyph } else { icons::ui(icons::SEARCH) }
}

fn apply_rename(state: &mut editor::State) {
    model::rename_selected(state, state.rename_text);
    rename_close(state);
}
