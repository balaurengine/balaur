// Rename a name in the script the code pane shows, and find and replace in
// it. Both show the list before anything is written.

use center;
use complete;
use editor;
use lint;
use model;
use signals;

const RENAME: str = "rename";
const NAME: str = "name";
const REFACTOR: str = "refactor";

pub class RefactorState {
    open: bool,
    mode: str,
    from: str,
    to: str,
    hits: [script::Place],
    written: [script::Edit],
}

/// What the sheet shows.
pub struct View {
    internal open: bool,
    internal title: str,
    internal from: str,
    internal to: str,
    internal from_hint: str,
    internal to_hint: str,
    internal count: str,
    internal hits: [ui::Item],
    internal ready: bool,
}

pub fn state() -> RefactorState {
    RefactorState { open: false, mode: RENAME, from: "", to: "", hits: [], written: [] }
}

/// Open over the word the caret is on, so a rename starts already filled in.
pub fn open(state: &mut editor::State, mode: str) {
    let rel = active_rel(state);
    if rel == "" {
        return;
    }
    state.refactor.open = true;
    state.refactor.mode = mode;
    state.refactor.from = if mode == RENAME { word_at_caret(state, rel) } else { "" };
    state.refactor.to = "";
    state.refactor.hits = [];
    state.refactor.written = [];
    preview(state);
    signals::changed(state, REFACTOR);
}

pub fn close(state: &mut editor::State) {
    state.refactor.open = false;
    state.refactor.hits = [];
    state.refactor.written = [];
    signals::changed(state, REFACTOR);
}

// The script the code pane is showing, "" when it is showing none.
fn active_rel(state: editor::State) -> str {
    let rel = model::script_rel(model::selected_node(state));
    if rel == nil { "" } else { rel.as_str() }
}

fn source_of(state: &mut editor::State, rel: str) -> str {
    let buffer = state.script_buffers[state.game_root + "/" + rel];
    if buffer == nil { model::source(state, rel).as_str() } else { buffer.as_str() }
}

// The identifier under the caret, which is what a rename means by default.
// The same word the completion list opens on, so both read one definition of
// where an identifier starts.
fn word_at_caret(state: &mut editor::State, rel: str) -> str {
    let index = state.complete.at_index;
    if index < 0 {
        return "";
    }
    complete::prefix_at(source_of(state, rel), index)
}

/// Every place the name appears, and what a rename would write.
pub fn preview(state: &mut editor::State) {
    let rel = active_rel(state);
    if rel == "" || state.refactor.from == "" {
        state.refactor.hits = [];
        state.refactor.written = [];
        return;
    }
    let source = source_of(state, rel);
    let renaming = state.refactor.mode == RENAME;
    state.refactor.hits = if renaming {
        script::references(rel, source, state.refactor.from)
    } else {
        script::find(rel, source, state.refactor.from)
    };
    if state.refactor.to == "" {
        state.refactor.written = [];
        return;
    }
    state.refactor.written = if renaming {
        script::rename(rel, source, state.refactor.from, state.refactor.to)
    } else {
        script::replace(rel, source, state.refactor.from, state.refactor.to)
    };
}

/// Write every file the preview listed, into the buffers rather than to disk:
/// a rename is undone with the same ⌘S that saves it.
pub fn apply(state: &mut editor::State) {
    if state.refactor.written.len() == 0 {
        return;
    }
    for one in state.refactor.written {
        let absolute_path = state.game_root + "/" + one.file;
        state.script_buffers[absolute_path] = one.source;
        state.script_dirty[absolute_path] = engine::unix_time();
        lint::touched(state);
        signals::bars(state);
    }
    center::code_written(state);
    let did = if state.refactor.mode == RENAME { "renamed" } else { "replaced" };
    log::info("{did} {state.refactor.from} to {state.refactor.to} in {state.refactor.written.len()} files");
    close(state);
}

/// What the sheet shows: its fields as it opens, every place the name is,
/// and whether there is anything to apply.
pub fn view(state: editor::State) -> View {
    if !state.refactor.open {
        return View { open: false, title: "", from: "", to: "", from_hint: "", to_hint: "", count: "", hits: [], ready: false };
    }
    let renaming = state.refactor.mode == RENAME;
    let hits: [ui::Item] = [];
    for hit in state.refactor.hits {
        hits.push(ui::Item { label: "{hit.file}:{hit.line}" });
    }
    View {
        open: true,
        title: if renaming { "RENAME" } else { "REPLACE" },
        from: state.refactor.from,
        to: state.refactor.to,
        from_hint: if renaming { NAME } else { "text to find" },
        to_hint: if renaming { "new name" } else { "replace with" },
        count: "{state.refactor.hits.len()} matches in {state.refactor.written.len()} files",
        hits: hits,
        ready: state.refactor.to != "" && state.refactor.written.len() > 0,
    }
}

/// One of the two fields, as it is typed.
pub fn set(state: &mut editor::State, field: str, text: str) {
    if field == "From" {
        state.refactor.from = text;
    } else {
        state.refactor.to = text;
    }
    preview(state);
    signals::changed(state, REFACTOR);
}
