//! The edited project and its scene. The scene is the live nodes under
//! `state.mirror`, which the engine builds from the scene file, holds unscripted
//! and unstepped until play, and writes back (PLAN-editor-as-scene §10).
//! `state.nodes` lists them in tree order: a row is a node.

use arrange;
use defs;
use editor;
use history;
use icons;
use inspector;
use presets;
use rig;
use selection;
use shell;
use signals;
use util;
use words::changes;
use words::components;
use words::datatypes;
use words::fields;
use words::general;
use words::inspector_fields;
use words::layout_fields;
use words::project_fields;
use words::roles;
use words::schema_fields;
use words::tabs;
use words::tools;

const ADDED: str = "added";
const ATTACHED: str = "attached";
const COMPONENT: str = "component";
const FREED: str = "freed";
const KEYS: str = "keys";
const MOVED: str = "moved";
const REMOVED: str = "removed";
const RENAMED: str = "renamed";
const ROTATION_EULER: str = "rotation_euler";
const CHANGED: str = "changed";
const KIND: str = "kind";
const MULTIMESH2D: str = "multimesh2d";
const MULTIMESH3D: str = "multimesh3d";
const SCENES: str = "scenes";
const EXPORTS: str = "exports";
const HOOKS: str = "hooks";
const INSTANCE: str = "instance";
const LINES: str = "lines";
const PARENT: str = "parent";
const PLACE: str = "place";
const PROCESS: str = "process";
const VISIBLE: str = "visible";
const WAS: str = "was";
const Z_INDEX: str = "z_index";

/// The Godot class a node holding `component` reads as.
pub struct DisplayType {
    component: str,
    class: str,
}

/// A node's glyph in the tree and the colour role it is drawn in.
pub struct NodeIcon {
    internal glyph: str,
    internal role: str,
}

/// How many nodes the scene has, and how many of them name a script.
pub struct Stats {
    internal nodes: int,
    internal scripts: int,
}

// Project reads, cached on `state`: four panels read the disk while drawing, so
// uncached that is a read per node per frame. `fs` has no mtime, hence
// interval + drop.
const TTL: float = 0.5;

// A hand-edited file can name a parent that names it back. Every walk is
// bounded so a cycle costs a wrong answer, not a hung editor.
const MAX_DEPTH: int = 256;

// The text of a project-relative file, or `None` when there is no such file —
// the caller that wants to say "missing" needs to tell that from "empty".
pub fn source(state: &mut editor::State, rel: str) -> any {
    let now = engine::unix_time();
    let entry = state.sources[rel];
    if entry != nil {
        if now - entry[layout_fields::AT].as_float() < TTL {
            return entry[fields::TEXT];
        }
    }
    let text: any = fs::read(state.game_root + "/" + rel);
    state.sources[rel] = { fields::TEXT: text, layout_fields::AT: now };
    text
}

// How many lines a file has, counted once per cached read: the Script
// workspace's list asked for every script's count on every frame it drew.
pub fn line_count(state: &mut editor::State, rel: str) -> any {
    let text = source(state, rel);
    if text == nil {
        return 0;
    }
    let entry = state.sources[rel];
    if entry[LINES] == nil {
        entry[LINES] = util::count_lines(text.as_str());
    }
    entry[LINES]
}

// The script's engine-facing hooks, read once per cached read. The host's own
// `script::symbols` rather than a parser here, so the outline, the Events tab
// and an editor outside Balaur all name the same functions.
pub fn hooks(state: &mut editor::State, rel: str) -> any {
    let text = source(state, rel);
    if text == nil {
        return [];
    }
    let entry = state.sources[rel];
    if entry[HOOKS] == nil {
        let hooks: [any] = [];
        for one in script::symbols(rel, text.as_str()) {
            if one.kind == general::FUNCTION {
                hooks.push({ fields::NAME: one.name, layout_fields::LINE: one.line, "detail": one.detail });
            }
        }
        entry[HOOKS] = hooks;
    }
    entry[HOOKS]
}

pub fn list(state: &mut editor::State, rel: str) -> any {
    // No project, no listing: the start screen is up, and asking `fs` for a
    // path under a root that does not exist is an error rather than nothing.
    if state.game_root == "" {
        return [];
    }
    let now = engine::unix_time();
    let entry = state.listings[rel];
    if entry != nil {
        if now - entry[layout_fields::AT].as_float() < TTL {
            return entry[project_fields::FILES];
        }
    }
    let files = util::list_or_empty(fs::list(state.game_root + "/" + rel));
    state.listings[rel] = { project_fields::FILES: files, layout_fields::AT: now };
    files
}

// Drop a cached read (`None` drops everything): what the editor just wrote
// must be visible on the next frame, not on the next interval.
pub fn forget(state: &mut editor::State, rel: str?) {
    if rel != nil {
        state.sources.remove(rel.unwrap());
    } else {
        state.sources = {};
        state.listings = {};
    }
}

// The script a node names, as the game spells it, or nil.
pub fn script_rel(found: Node) -> any {
    if !found.is_valid() {
        return nil;
    }
    let path = found.script_path();
    if path == "" { nil } else { path }
}

// What this node sets over its script's exported defaults. Sparse: a
// property back at its default is absent, so a changed default reaches it.
pub fn script_props(found: Node) -> any {
    if found.is_valid() { util::map_or_empty(found.script_props()) } else { {} }
}

// The properties the script declares, cached beside its text: asking the host
// compiles the file, which is not something to do once a frame.
pub fn exports(state: &mut editor::State, rel: str) -> any {
    if source(state, rel) == nil {
        return [];
    }
    let entry = state.sources[rel];
    if entry[EXPORTS] == nil {
        entry[EXPORTS] = script::exports(state.game_root + "/" + rel);
    }
    entry[EXPORTS]
}

// Set one exported property on the selected node's script. Takes effect the
// next time the script attaches, which for play-in-editor is the next play.
pub fn set_script_property(state: &mut editor::State, property: str, value: any) {
    let found = selected_node(state);
    let rel = script_rel(found);
    if rel == nil {
        return;
    }
    history::record(state, "set " + property, "sprop:{property}:{state.selected}");
    let properties = script_props(found);
    let stored = as_default_type(state, rel.as_str(), property, value);
    if same_as_default(state, rel.as_str(), property, stored) {
        properties.remove(property);
    } else {
        properties[property] = stored;
    }
    found.set_script(rel, properties);
}

// The editors all drag floats, so an export declared as a whole number is
// rounded back to one: a count that became 2.0 is a different value to the
// script, and to the file.
fn as_default_type(state: &mut editor::State, rel: str, property: str, value: any) -> any {
    for export in exports(state, rel) {
        if export[fields::NAME].as_str() == property && export[fields::TYPE].as_str() == datatypes::INT && value.kind() == types::KIND_FLOAT {
            return math::round(value.as_float()) as int;
        }
    }
    value
}

// A value equal to the export's default stops being an override. Numbers
// compare as numbers, so retyping 2 over an int default of 2 clears it.
fn same_as_default(state: &mut editor::State, rel: str, property: str, value: any) -> bool {
    for export in exports(state, rel) {
        if export[fields::NAME].as_str() == property {
            let default_value = export[schema_fields::DEFAULT];
            if (default_value.kind() == types::KIND_INT || default_value.kind() == types::KIND_FLOAT) && (value.kind() == types::KIND_INT || value.kind() == types::KIND_FLOAT) {
                return default_value.as_float() == value.as_float();
            }
            return default_value == value;
        }
    }
    false
}

/// The node of the scene carrying `id`, or nil.
pub fn node_by_id(state: editor::State, id: str) -> Node {
    if state.mirror == nil {
        return nil;
    }
    scene::node_by_id(id, state.mirror.unwrap())
}

/// The id a row's parent carries, "" for the scene's root.
pub fn parent_id(state: editor::State, found: Node) -> str {
    if !found.is_valid() || is_scene_root(state, found) {
        return "";
    }
    found.parent().stable_id()
}

pub fn is_scene_root(state: editor::State, found: Node) -> bool {
    state.scene_root != nil && found.is_valid() && found == state.scene_root.unwrap()
}

/// The path of names from the scene's root to `found`, as `find_node` walks
/// it inside the scene.
pub fn path_in_scene(state: editor::State, found: Node) -> str {
    let names: [str] = [];
    let current = found;
    for _depth in 0..MAX_DEPTH {
        if !current.is_valid() {
            break;
        }
        names.insert(0, current.name());
        if is_scene_root(state, current) {
            break;
        }
        current = current.parent();
    }
    util::join(names, "/")
}

/// Whether `found` is `ancestor` or somewhere under it.
pub fn is_within(found: Node, ancestor: Node) -> bool {
    let current = found;
    for _depth in 0..MAX_DEPTH {
        if !current.is_valid() {
            return false;
        }
        if current == ancestor {
            return true;
        }
        current = current.parent();
    }
    false
}

// The engine's own id rule (`slug` in project.rs), so an id the editor
// generates is the one the engine would have generated for that name.
fn slug(name: str) -> str {
    let alnum = "abcdefghijklmnopqrstuvwxyz0123456789";
    let out = "n_";
    let gap = true;
    for character in name.to_lower().chars() {
        if alnum.contains(character) {
            out += character;
            gap = false;
        } else if !gap {
            out += "_";
            gap = true;
        }
    }
    while out.ends_with("_") {
        out = out.slice(0, out.len() - 1);
    }
    if out.len() > 2 { out } else { "n_node" }
}

/// A name no node of the scene has yet, for a node the editor makes.
pub fn unique_name(state: editor::State, base: str) -> str {
    let name = base;
    let suffix = 1;
    while name_taken(state, name) {
        suffix += 1;
        name = "{base}{suffix}";
    }
    name
}

fn name_taken(state: editor::State, candidate: str) -> bool {
    for found in state.nodes {
        if found.is_valid() && found.name() == candidate {
            return true;
        }
    }
    false
}

/// The row of the node carrying `id`, or `None`.
pub fn index_of_id(state: editor::State, id: str) -> int? {
    for row in 0..state.nodes.len() {
        if state.nodes[row].is_valid() && state.nodes[row].stable_id() == id {
            return row;
        }
    }
    nil
}

/// An id no node of the scene carries, named for `name` the way the engine
/// names a node a scene gave none.
pub fn fresh_id(state: editor::State, name: str) -> str {
    let taken: any = {};
    for found in state.nodes {
        if found.is_valid() {
            taken[found.stable_id()] = true;
        }
    }
    let base = slug(name);
    let candidate = base;
    let suffix = 2;
    while taken.has(candidate) {
        candidate = "{base}_{suffix}";
        suffix += 1;
    }
    candidate
}

pub fn node_type(found: Node) -> str {
    if !found.is_valid() {
        return "Node";
    }
    // A controller is what a character is, whatever body it moves.
    if found.has_component(components::CHARACTER3D) {
        return "CharacterBody3D";
    }
    if found.has_component(components::CHARACTER2D) {
        return "CharacterBody2D";
    }
    let kind = body_kind(found);
    if kind == physics3d::BODY_DYNAMIC {
        return "RigidBody3D";
    }
    if kind == physics3d::BODY_STATIC {
        return "StaticBody3D";
    }
    if kind != nil {
        return "AnimatableBody3D";
    }
    let kind2d = body2d_kind(found);
    if kind2d == physics2d::BODY_DYNAMIC {
        return "RigidBody2D";
    }
    if kind2d == physics2d::BODY_STATIC {
        return "StaticBody2D";
    }
    if kind2d != nil {
        return "AnimatableBody2D";
    }
    for display in display_types() {
        if found.has_component(display.component) {
            return display.class;
        }
    }
    "Node"
}

// The Godot 4 class a node's first component reads as, in the order a node
// carrying several is named by.
fn display_types() -> [DisplayType] {
    [
        DisplayType { component: components::WIDGET, class: "Control" },
        DisplayType { component: components::BONE2D, class: "Bone2D" },
        DisplayType { component: components::BONE3D, class: "Bone3D" },
        DisplayType { component: tools::POLYGON, class: "Polygon2D" },
        DisplayType { component: components::MULTIMESH3D, class: "MultiMeshInstance3D" },
        DisplayType { component: components::MULTIMESH2D, class: "MultiMeshInstance2D" },
        DisplayType { component: components::MESH, class: "MeshInstance3D" },
        DisplayType { component: components::SHAPE3D, class: "MeshInstance3D" },
        DisplayType { component: components::SHAPE2D, class: "MeshInstance2D" },
        DisplayType { component: components::SPRITE, class: "Sprite2D" },
        DisplayType { component: components::TILEMAP, class: "TileMapLayer" },
        DisplayType { component: "camera2d", class: "Camera2D" },
        DisplayType { component: components::CAMERA3D, class: "Camera3D" },
        DisplayType { component: "sound", class: "AudioStreamPlayer" },
    ]
}

/// A body's kind, nil for a node without that body.
fn kind_of(found: Node, component: str) -> any {
    if found.is_valid() && found.has_component(component) {
        found.component_property(component, KIND)
    } else {
        nil
    }
}

pub fn body_kind(found: Node) -> any {
    kind_of(found, components::BODY3D)
}

pub fn body2d_kind(found: Node) -> any {
    kind_of(found, components::BODY2D)
}

/// True when the edited scene is 2D, which switches the camera, grid and gizmo.
/// Worked out when the rows are listed (`reindex`), not each time it is asked.
pub fn is_2d(state: editor::State) -> bool {
    state.is_2d_was
}

/// More of `nodes` 2D than 3D, read off the engine's tags, so every 2D
/// component counts, a plugin's included, and a 3D scene with one 2D label
/// stays 3D.
pub fn nodes_are_2d(nodes: [Node]) -> bool {
    let flat = 0;
    let deep = 0;
    for found in nodes {
        let kind = facet(found);
        if kind == DIM_2D {
            flat += 1;
        } else if kind == DIM_3D {
            deep += 1;
        }
    }
    flat > deep
}

/// Whether `nodes` are an interface: widgets, and nothing of the 2D or the
/// 3D world beside them.
pub fn nodes_are_interface(nodes: [Node]) -> bool {
    let widgets = 0;
    for found in nodes {
        let kind = facet(found);
        if kind == DIM_2D || kind == DIM_3D {
            return false;
        }
        if kind == UI {
            widgets += 1;
        }
    }
    widgets > 0
}

pub const DIM_2D: str = "2d";

pub const DIM_3D: str = "3d";

pub const UI: str = "ui";

/// "ui", "2d" or "3d" from the components a node holds, "" for one holding
/// none, which any type fits.
pub fn facet(found: Node) -> str {
    if !found.is_valid() {
        return "";
    }
    for key in found.component_names() {
        let tags = scene::component_tags(key);
        if tags == nil {
            continue;
        }
        let tags = tags.unwrap();
        if util::contains(tags, UI) {
            return UI;
        }
        let flat = util::contains(tags, DIM_2D);
        let deep = util::contains(tags, DIM_3D);
        if flat && !deep {
            return DIM_2D;
        }
        if deep && !flat {
            return DIM_3D;
        }
    }
    ""
}

fn carries(found: Node, component: str) -> bool {
    found.is_valid() && found.has_component(component)
}

// Icon glyph + colour role ("sage" physics, "accent" render/ui, "dim" other).
pub fn node_icon(found: Node) -> NodeIcon {
    let body = body_kind(found);
    let kind = if body == nil { body2d_kind(found) } else { body };
    if carries(found, components::WIDGET) {
        return NodeIcon { glyph: icons::workspace(defs::WORKSPACE_UI), role: "node_ui" };
    }
    if kind != nil {
        return NodeIcon { glyph: icons::workspace(defs::WORKSPACE_PHYSICS), role: roles::NODE_PHYSICS };
    }
    if carries(found, components::BONE2D) || carries(found, components::BONE3D) {
        return NodeIcon { glyph: icons::tool(icons::BONE), role: roles::NODE_BONE };
    }
    if carries(found, tools::POLYGON) || carries(found, components::SHAPE2D) || carries(found, components::SPRITE) || carries(found, MULTIMESH2D) {
        return NodeIcon { glyph: icons::tool(icons::POLYGON), role: roles::NODE_2D };
    }
    if carries(found, components::SHAPE3D) || carries(found, components::MESH) || carries(found, MULTIMESH3D) {
        return NodeIcon { glyph: icons::workspace(defs::WORKSPACE_SCENE), role: "node_3d" };
    }
    if script_rel(found) != nil {
        return NodeIcon { glyph: icons::ui(icons::SCRIPTFILE), role: roles::NODE_DEFAULT };
    }
    NodeIcon { glyph: icons::node("world"), role: roles::NODE_DEFAULT }
}

/// The node whose prefab built `found`, or nil for a node of the scene's own:
/// a prefab's nodes carry the instancing node's id as their prefix.
pub fn instance_owner(found: Node) -> Node {
    if !found.is_valid() {
        return nil;
    }
    let id = found.stable_id();
    let current = found.parent();
    for _depth in 0..MAX_DEPTH {
        if !current.is_valid() {
            return nil;
        }
        if current.instance() != nil && id.starts_with(current.stable_id() + "/") {
            return current;
        }
        current = current.parent();
    }
    nil
}

/// The path from the node that instanced `found`'s prefab down to it, which
/// an override on that node is filed under; "" for a node of the scene's own.
pub fn path_in_instance(found: Node) -> str {
    let owner = instance_owner(found);
    if !owner.is_valid() {
        return "";
    }
    let names: [str] = [];
    let current = found;
    for _depth in 0..MAX_DEPTH {
        if !current.is_valid() || current == owner {
            break;
        }
        names.insert(0, current.name());
        current = current.parent();
    }
    util::join(names, "/")
}

// Whether this node came from a prefab. Its properties can be overridden; it
// cannot be renamed, reparented, duplicated or deleted, because structure is
// the prefab's (`docs/PLAN-scenes-and-assets.md`).
pub fn is_instanced(found: Node) -> bool {
    instance_owner(found).is_valid()
}

// Load the game project pointed at by `engine::args()[0]`.
// A read the editor cannot do without: `fs::read` answers `()` for a file it
// could not open, and `toml::parse` then fails with the type, not the path.
fn must_read(path: str) -> str {
    let text = fs::read(path);
    if text == nil {
        log::error("cannot read {path}");
        return "";
    }
    let text = text.unwrap();
    text
}

pub fn load(state: &mut editor::State) {
    let arguments = engine::args();
    let root = if arguments.len() > 0 { arguments[0] } else { "" };
    state.game_root = root;
    // The game's strings and fonts live under its root, not the editor's:
    // without this every `text_key` draws as its key, in the editor's faces.
    // The start screen plays nothing, so its empty root puts it back.
    engine::set_content_root(root);
    // No project named: the start screen is what this run is for, and there is
    // no manifest to read.
    if root == "" {
        state.game_name = "";
        state.scene_rel = "";
        state.scene_path = "";
        state.scene_doc = {};
        clear_scene(state);
        history::reset(state);
        return;
    }
    let manifest = toml::parse(must_read(root + "/project.toml"));
    let application = manifest[project_fields::APPLICATION];
    state.game_name = application[fields::NAME].as_str();
    open_scene(state, application["main_scene"].as_str());
}

pub fn open_scene(state: &mut editor::State, rel: str) {
    state.scene_rel = rel;
    state.scene_path = state.game_root + "/" + rel;
    let text = must_read(state.scene_path);
    // The file's other tables: its `[[assets]]`, which a tool writes and a
    // save writes back beside the nodes.
    state.scene_doc = util::map_or_empty(toml::parse(text));
    build(state, text);
    selection::only(state, 0);
    history::reset(state);
    // The Scene workspace draws the world, and an interface has none.
    if state.workspace == defs::WORKSPACE_SCENE && nodes_are_interface(state.nodes) {
        shell::set_workspace(state, defs::WORKSPACE_UI);
    }
    log::info("opened " + rel);
}

// Only a value that reads as a file name is a file candidate: `..` and
// `../Rig` are node paths, and the game's parent directory exists too.
pub fn names_a_file(value: str) -> bool {
    if value == "" || is_absolute(value) {
        return false;
    }
    let last = "";
    for segment in value.split("/") {
        if segment == "." || segment == ".." {
            return false;
        }
        last = segment;
    }
    let parts = last.split_once(".");
    if parts.len() != 2 || parts[1] == "" {
        return false;
    }
    for character in parts[1].chars() {
        if !"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789".contains(character) {
            return false;
        }
    }
    true
}

// Absolute on every OS: `/x`, `\\server\x`, and a Windows drive, `D:/x` or
// `D:\x`. The engine hands back a drive path on Windows, and read as a file
// name it joins under the game root into a path outside every root.
pub fn is_absolute(value: str) -> bool {
    if value.starts_with("/") || value.starts_with("\\") {
        return true;
    }
    let parts = value.split_once(":");
    parts.len() == 2 && parts[0].len() == 1
}

// A path the engine hands back resolved, a component's live value, as the
// game spells it.
pub fn relative_file(state: editor::State, value: any) -> any {
    if value.kind() == types::KIND_STRING {
        let prefix = state.game_root + "/";
        let text = value.as_str();
        if text.starts_with(prefix) {
            return text.slice(prefix.len(), text.len());
        }
    }
    value
}

/// The two camera components, and the key that says a camera is the one the
/// game looks through.
pub const CAMERA_3D: str = "camera3d";

// The nearest a `camera3d` takes its focus.
const NEAREST_FOCUS: float = 0.001;

pub const CAMERA_2D: str = "camera2d";

pub const CAMERA_CURRENT: str = "current";

const VIEW_3D: str = "EditorView3D";

const VIEW_2D: str = "EditorView2D";

/// Hand the view to the game's own cameras, or take it back. While editing
/// it is the editor's view to own: left to them, the scene's camera is
/// written over the viewport's every frame, so an orbit or a zoom is undone
/// as fast as it is made. The cameras keep what the scene asked of them.
pub fn hold_game_cameras(state: editor::State, playing: bool) {
    render::hold_cameras(if playing { nil } else { state.mirror });
    view_3d().camera3d.current = !playing;
    view_2d().camera2d.current = !playing;
}

// The editor's own view: a camera of each kind beside what is edited, standing
// where the engine's default view does until the viewport moves it.
fn view_3d() -> Node {
    let root = scene::root();
    let found = root.get_node(VIEW_3D);
    if found.is_valid() {
        return found;
    }
    let made = root.add_child(VIEW_3D);
    made.set_component(CAMERA_3D);
    aim_3d(made, vec3(8.0, 5.0, 12.0), vec3(0.0, 1.0, 0.0));
    made
}

fn view_2d() -> Node {
    let root = scene::root();
    let found = root.get_node(VIEW_2D);
    if found.is_valid() {
        return found;
    }
    let made = root.add_child(VIEW_2D);
    made.set_component(CAMERA_2D);
    made
}

/// Stand a view at `eye` facing `target`, focused there: `render::camera_pose`
/// answers `target` back, which is the point the viewport orbits.
fn aim_3d(view: Node, eye: Vec3, target: Vec3) {
    let x = target.x - eye.x;
    let y = target.y - eye.y;
    let z = target.z - eye.z;
    view.transform.position = eye;
    view.transform.look_at(target);
    view.camera3d.focus_distance = util::max(math::sqrt(x * x + y * y + z * z), NEAREST_FOCUS);
}

/// Point the editor's 3D view: the eye, then the world point it looks at.
pub fn set_view_3d(eye_x: float, eye_y: float, eye_z: float, target_x: float, target_y: float, target_z: float) {
    aim_3d(view_3d(), vec3(eye_x, eye_y, eye_z), vec3(target_x, target_y, target_z));
}

/// Point the editor's 2D view: the world centre, then the zoom in logical
/// pixels per world unit.
pub fn set_view_2d(centre_x: float, centre_y: float, zoom: float) {
    let view = view_2d();
    view.transform.position = vec3(centre_x, centre_y, 0.0);
    view.camera2d.pixels_per_unit = zoom;
}

/// The container the scene is built under, made the first time: what the
/// engine plays as the game's content, and the subtree the editor hears and
/// keeps the changes of.
fn mirror(state: &mut editor::State) -> Node {
    if state.mirror == nil || !state.mirror.unwrap().is_valid() {
        let made = scene::root().add_child("Edited");
        // What the edited scene's writes move, and nothing the shell writes.
        events::listen(scene::get_node("Editor"), CHANGED, made);
        debugger::set_scope(made);
        state.mirror = made;
    }
    state.mirror.unwrap()
}

/// Take down whatever was built under the container: the scene and anything
/// a tool built beside it, the scripts first, which would otherwise get one
/// more update against bodies `physics::clear` has already removed.
fn clear_scene(state: &mut editor::State) {
    if state.mirror != nil && state.mirror.unwrap().is_valid() {
        for found in state.mirror.unwrap().descendants() {
            found.detach_script();
        }
        for found in state.mirror.unwrap().children() {
            found.free();
        }
    }
    state.scene_root = nil;
    state.nodes = [];
}

/// Build the scene from a scene file's text in place of what was built, the
/// selection kept on the nodes of the same ids: held unscripted, unstepped
/// and unanimated, its cameras not driving the view, until play.
pub fn build(state: &mut editor::State, text: str) {
    scene::keep_changes(nil);
    let picked = selected_ids(state);
    drop_edited(state);
    clear_scene(state);
    physics::clear();
    let under = mirror(state);
    scene::instantiate(text, under, scene::InstantiateOptions { scripts: false, root: state.game_root });
    let built = under.children();
    state.scene_root = if built.len() > 0 { built[0] } else { nil };
    physics::set_paused(true);
    state.playing = false;
    hold_game_cameras(state, false);
    reindex(state);
    select_ids(state, picked);
    // The scene builds with the game's own `autoplay`: nothing may animate
    // under the inspector until play is pressed.
    for found in state.nodes {
        if found.has_component(tabs::ANIMATION) {
            found.animation.pause();
        }
    }
    // The clip cache belongs to the scene that is gone.
    state.clip = nil;
    signals::inspector(state);
    signals::changed(state, changes::DEBUGGER);
    signals::outline(state);
    state.lint.stale = true;
    // The scene's own changes, and not a tool's overlay built beside it.
    scene::keep_changes(state.scene_root);
}

/// The scene as a scene file's text, its `[[assets]]` with it: what play
/// keeps for stop to build again.
pub fn scene_text(state: &mut editor::State) -> str {
    arrange::leave_isolate(state);
    let written = toml::parse(scene::to_toml(state.scene_root.unwrap(), scene::ToTomlOptions { root: state.game_root }));
    let assets = state.scene_doc[project_fields::ASSETS];
    if assets != nil {
        written[project_fields::ASSETS] = assets;
    }
    toml::encode(written)
}

/// List the scene's nodes in tree order again, after its structure moved,
/// the selection kept on the nodes it was on.
pub fn reindex(state: &mut editor::State) {
    let picked: [Node] = [];
    for row in selection::all(state) {
        let found = node(state, row);
        if found.is_valid() {
            picked.push(found);
        }
    }
    let rows: [Node] = [];
    if state.scene_root != nil && state.scene_root.unwrap().is_valid() {
        let root = state.scene_root.unwrap();
        rows.push(root);
        for found in root.descendants() {
            rows.push(found);
        }
    }
    state.nodes = rows;
    state.is_2d_was = nodes_are_2d(rows);
    state.tree_cache.key = "";
    let at: [int] = [];
    for found in picked {
        let row = index_of_node(state, found);
        if row != nil {
            at.push(row.unwrap());
        }
    }
    state.selected_rows = at;
    state.selected = if at.len() > 0 { at[0] } else { -1 };
}

/// The ids of the selected nodes, the active one first: a selection that
/// outlives the nodes, through a build or an undo.
pub fn selected_ids(state: editor::State) -> [str] {
    let out: [str] = [];
    for row in selection::all(state) {
        let found = node(state, row);
        if found.is_valid() {
            out.push(found.stable_id());
        }
    }
    out
}

/// Select the nodes carrying these ids, the first active; none found leaves
/// the selection as it is.
pub fn select_ids(state: &mut editor::State, ids: [str]) {
    let rows: [int] = [];
    for id in ids {
        let at = index_of_id(state, id);
        if at != nil {
            rows.push(at.unwrap());
        }
    }
    selection::set(state, rows);
}

/// What the edited scene's writes this frame move, from the engine's change
/// log heard from the mirror: a node added, freed, renamed or moved, or a
/// component put on or taken off, lists the rows again and is the outline's
/// word; a component of the selected node written, or what its script sets,
/// is the Inspector's rows of what it names, and its whole form once the edits
/// stop for `REFILL_AFTER`.
pub fn follow_changes(state: &mut editor::State, entries: any) {
    state.lint.stale = true;
    let selected = node(state, state.selected);
    let structure = false;
    // Each component of the selected node written, with the properties it
    // was written by; one written whole has none.
    let written: { str: [str] } = {};
    let whole: [str] = [];
    for entry in entries {
        if entry[fields::KIND].as_str() == tabs::SCRIPT && selected.is_valid() && entry[inspector_fields::NODE].as_node() == selected && inspector::script_stands(state, selected) {
            if !util::contains(whole, inspector::SCRIPT) {
                whole.push(inspector::SCRIPT);
            }
        } else if entry[fields::KIND].as_str() != COMPONENT {
            structure = true;
        } else if selected.is_valid() && entry[inspector_fields::NODE].as_node() == selected {
            let name = entry[COMPONENT].as_str();
            let properties = entry[schema_fields::PROPERTIES];
            if properties == nil {
                if !util::contains(whole, name) {
                    whole.push(name);
                }
            } else {
                let held: [str] = if written.has(name) { written[name].unwrap() } else { [] };
                for property in properties {
                    if !util::contains(held, property.as_str()) {
                        held.push(property.as_str());
                    }
                }
                written[name] = held;
            }
        }
    }
    if structure {
        reindex(state);
        signals::outline(state);
    } else if whole.len() > 0 || written.len() > 0 {
        for name in whole {
            inspector::rows_moved(state, name);
        }
        for name in written.keys() {
            if !util::contains(whole, name) {
                inspector::rows_moved(state, name, written[name]);
            }
        }
        state.inspector_after = engine::unix_time() + REFILL_AFTER;
    }
}

/// How long the Inspector's rows alone follow a run of edits before its
/// whole form is filled again: a drag, or typing.
const REFILL_AFTER: float = 0.3;

/// The node at row `row`, nil past the end and at -1, the no-selection row.
pub fn node(state: editor::State, row: int) -> Node {
    if row < 0 || row >= state.nodes.len() {
        return nil;
    }
    state.nodes[row]
}

/// The row `found` is at, or `None` for a node the scene does not hold.
pub fn index_of_node(state: editor::State, found: Node) -> int? {
    if !found.is_valid() {
        return nil;
    }
    for row in 0..state.nodes.len() {
        if state.nodes[row] == found {
            return row;
        }
    }
    nil
}

/// The row whose node is `found` or the nearest above it: a pick can land on
/// a node the scene never named, one a solver owns, and the row that owns it
/// is what the click meant.
pub fn index_of_live(state: editor::State, found: Node) -> int? {
    let current = found;
    for _depth in 0..MAX_DEPTH {
        if !current.is_valid() {
            return nil;
        }
        let at = index_of_node(state, current);
        if at != nil {
            return at;
        }
        current = current.parent();
    }
    nil
}

/// Write a node's transform to the document and the live node together.
///
/// The only place that spells the pair. `parts` carries any of `position`,
/// `rotation_euler` and `scale`; what it leaves out is left alone. History is
/// the caller's, because a drag records once at its start and then writes
/// every frame.
// A component's schema, cached: schemas are fixed for a session and the
// inspector asks for one per component per frame.
pub fn schema(state: &mut editor::State, name: str) -> any {
    let cached = state.schemas[name];
    if cached != nil {
        cached
    } else {
        let fresh = util::map_or_empty(scene::component_schema(name));
        state.schemas[name] = fresh;
        fresh
    }
}

/// What a component declares it needs something from, cached beside the
/// schemas: the inspector asks once per component per frame otherwise.
pub fn expects(state: &mut editor::State, name: str) -> any {
    let cached = state.expects[name];
    if cached != nil {
        cached
    } else {
        let fresh = util::list_or_empty(scene::component_expects(name));
        state.expects[name] = fresh;
        fresh
    }
}

/// Write a node's transform. `parts` carries any of `position`,
/// `rotation_euler` and `scale`; what it leaves out is left alone, and a node
/// without a transform is given one. History is the caller's, because a drag
/// records once at its start and then writes every frame.
pub fn set_transform(state: &mut editor::State, row: int, parts: rig::Parts) {
    let target = node(state, row);
    if !target.is_valid() {
        return;
    }
    if parts.position.len() > 0 {
        target.transform.position = as_vector(parts.position);
    }
    if parts.rotation_euler.len() > 0 {
        target.transform.rotation_euler = as_vector(parts.rotation_euler);
    }
    if parts.scale.len() > 0 {
        target.transform.scale = as_vector(parts.scale);
    }
}

fn as_vector(values: [float]) -> Vec3 {
    vec3(values[0], values[1], values[2])
}

/// One of the transform's vectors as the scene asked for it, else as the node
/// holds it: a rotation the scene wrote reads back as written, not through a
/// quaternion.
pub fn transform_part(found: Node, key: str, fallback: [float]) -> [float] {
    if !found.is_valid() || !found.has_component(TRANSFORM) {
        return fallback;
    }
    let asked = found.authored(TRANSFORM);
    if asked.kind() == types::KIND_MAP && asked[key] != nil {
        return util::list3_or(asked[key], fallback);
    }
    if key == components::POSITION {
        util::xyz(found.transform.position)
    } else if key == ROTATION_EULER {
        util::xyz(found.transform.rotation_euler)
    } else {
        util::xyz(found.transform.scale)
    }
}

/// The transform component's name, and the properties it holds.
pub const TRANSFORM: str = "transform";

/// Whether a row is active. A click on empty stage leaves none, so a verb on
/// "the selected node" asks first.
pub fn has_selection(state: editor::State) -> bool {
    state.selected >= 0 && state.selected < state.nodes.len()
}

/// The active row's node, nil with nothing selected.
pub fn selected_node(state: editor::State) -> Node {
    node(state, state.selected)
}

// Write the scene back to its file and say so: what ⌘S does. A dependency's
// scene is its project's: the game changes what it uses through an
// instance's overrides, or takes the file over in Assets.
pub fn save(state: &mut editor::State) {
    let owner = dependency::of(state.scene_path);
    if owner != nil {
        log::warn("{state.scene_rel} is in the dependency {owner.unwrap()}, which is read-only here: make it local in Assets to change it, or edit the dependency");
        return;
    }
    write(state);
    log::info("saved " + state.scene_rel);
}

/// Whether the scene open is a dependency's, which this project only reads.
pub fn read_only(state: editor::State) -> bool {
    dependency::of(state.scene_path) != nil
}

// Write the scene back to its file (hot reload on the game side is the game's
// watcher's business; the editor is a plain writer). Quiet: the autosave runs
// after every edit that settles.
pub fn write(state: &mut editor::State) {
    // `patch`, not `encode`: a scene file is hand-written as often as not,
    // and encoding over it would drop its comments, its key order and every
    // table the engine does not write.
    arrange::leave_isolate(state);
    let text = fs::read(state.scene_path).or("");
    let written = toml::parse(scene::to_toml(state.scene_root.unwrap(), scene::ToTomlOptions { root: state.game_root }));
    // The blocks only once a tool changed one: patching them rewrites the
    // whole list, comments and all.
    if state.assets_touched {
        let assets = state.scene_doc[project_fields::ASSETS];
        if assets != nil {
            written[project_fields::ASSETS] = assets;
        }
        state.assets_touched = false;
    }
    fs::write(state.scene_path, toml::patch(text, written));
    forget(state, state.scene_rel);
    history::mark_saved(state);
}

// Structure inside an instance belongs to the prefab: a node added, renamed
// or removed here would have nowhere in the file to live. Property overrides
// only (`docs/PLAN-scenes-and-assets.md`).
fn refuse_structure(state: editor::State, what: str) -> bool {
    if !has_selection(state) {
        return true;
    }
    let found = selected_node(state);
    if !is_instanced(found) {
        return false;
    }
    log::warn("cannot " + what + " inside a prefab; open " + prefab_of(found) + " to change its structure");
    true
}

// The prefab file a node came from, for a message that says where to go.
pub fn prefab_of(found: Node) -> str {
    let owner = instance_owner(found);
    if owner.is_valid() { owner.instance().or("the prefab") } else { "the prefab" }
}

// Every scene file under `scenes/`, which is what a prefab can be — the
// convention the Assets dock already opens on: a `.toml` there is a scene,
// anything else is an asset.
pub fn scene_files(state: &mut editor::State) -> [str] {
    let out: [str] = [];
    // `fs::list` answers with `{ name, is_dir }`, not bare names.
    for entry in list(state, SCENES) {
        let name = util::map_or_empty(entry)[fields::NAME].as_str();
        if name.ends_with(".toml") {
            out.push("scenes/" + name);
        }
    }
    out
}

// Add a child of the selection that instances `rel`: it keeps its own name
// and transform, and the engine builds the prefab's nodes under it.
pub fn instance_scene(state: &mut editor::State, rel: str) {
    if refuse_structure(state, "instantiate a scene") {
        return;
    }
    if rel == state.scene_rel {
        log::warn("a scene cannot instantiate itself");
        return;
    }
    history::record(state, "instance " + rel);
    let made = spawn(state, selected_node(state), prefab_name(rel), {
        INSTANCE: rel,
        TRANSFORM: { inspector_fields::POSITION: [0.0, 0.0, 0.0] },
    });
    reindex(state);
    selection::only(state, index_of_node(state, made).or(0));
    log::info("instanced " + rel);
}

// `scenes/enemy_camp.toml` -> `EnemyCamp`, so a placed prefab is named for
// what it is rather than for its path.
fn prefab_name(rel: str) -> str {
    let file = util::last_segment(rel);
    let parts = file.split_once(".");
    let stem = if parts.len() == 2 { parts[0] } else { file };
    if stem == "" {
        return "Instance";
    }
    util::camel(stem)
}

// Open the prefab behind the selection: the instance node's file, or the one
// the selected node came from. The button an instance row wants.
pub fn open_prefab(state: &mut editor::State) {
    let found = selected_node(state);
    if !found.is_valid() {
        return;
    }
    let owner = if found.instance() != nil { found } else { instance_owner(found) };
    if owner.is_valid() {
        open_scene(state, owner.instance().unwrap());
    } else {
        log::info("the selection is not an instance and did not come from one");
    }
}

// Move the selection among its siblings by `delta`: a scene edit, since order
// is what a `row` or a `column` lays out in.
pub fn move_sibling(state: &mut editor::State, delta: int) {
    if refuse_structure(state, "reorder nodes") {
        return;
    }
    let found = selected_node(state);
    if is_scene_root(state, found) {
        return;
    }
    let to = found.sibling_index() + delta;
    if to < 0 || to >= found.parent().children().len() {
        return;
    }
    history::record(state, "move node");
    found.set_sibling_index(to);
    reindex(state);
}

/// Rename the selected node. The name is made unique first: two siblings
/// sharing one is what made `find_node` answer with whichever came first.
pub fn rename_selected(state: &mut editor::State, name: str) {
    let wanted = name.trim();
    if wanted == "" || refuse_structure(state, "rename a node") {
        return;
    }
    let found = selected_node(state);
    if wanted == found.name() {
        return;
    }
    history::record(state, "rename node");
    found.set_name(unique_name(state, wanted));
}

/// Add a node under the selected one, of `kind`: a preset's name, a
/// component's, or `nil` for a bare node. A preset is a recipe: the
/// components land on the node and nothing records which one put them there.
pub fn add_child(state: &mut editor::State, kind: str?) {
    if !has_selection(state) {
        selection::only(state, 0);
    }
    if refuse_structure(state, "add a node") {
        return;
    }
    let parent = selected_node(state);
    let name = if kind != nil { kind_name(kind.unwrap()) } else { "Node" };
    history::record(state, "add {name}");
    let made = spawn(state, parent, name, { TRANSFORM: { inspector_fields::POSITION: landing(state, parent) } });
    if kind != nil {
        let preset = presets::find(state, kind.unwrap());
        if preset != nil {
            presets::build(made, preset.unwrap());
        } else {
            made.set_component(kind.unwrap());
        }
    }
    reindex(state);
    selection::only(state, index_of_node(state, made).or(0));
}

/// What a node made of `kind` is called: `text2d` is a `Text` and
/// `rigid_body3d` a `RigidBody`, the dimension being the scene's already.
pub fn kind_name(kind: str) -> str {
    let bare = if kind.ends_with("2d") || kind.ends_with("3d") { kind.slice(0, kind.len() - 2) } else { kind };
    let named = util::camel(bare);
    if named == "" { "Node" } else { named }
}

/// The world point the view is looking at: the 2D camera's centre, or the
/// point the 3D camera orbits.
pub fn view_centre(state: editor::State) -> [float] {
    if is_2d(state) {
        let camera = render::camera_2d();
        return [camera.center.x, camera.center.y, 0.0];
    }
    let pose = render::camera_pose();
    [pose.target.x, pose.target.y, pose.target.z]
}

// Where a node added under `parent` lands, in the parent's space: where the
// view is looking for one at the top of the scene, and on its parent for a
// child of anything else.
fn landing(state: editor::State, parent: Node) -> [float] {
    if !is_scene_root(state, parent) {
        return [0.0, 0.0, 0.0];
    }
    let centre = view_centre(state);
    if !parent.has_component(TRANSFORM) {
        return centre;
    }
    if is_2d(state) {
        let local = util::to_local(util::frame_of(parent), centre[0], centre[1]);
        return [local.x, local.y, 0.0];
    }
    let origin = parent.transform.global_position();
    [centre[0] - origin.x, centre[1] - origin.y, centre[2] - origin.z]
}

/// Build one node from a scene file's node table under `parent`, last among
/// its children, named `name` made unique and given a fresh id: how the
/// editor makes every node, so each carries a scene's id across a save and a
/// play. The rows are the caller's to list again, once it has made them all.
pub fn spawn(state: &mut editor::State, parent: Node, name: str, entry: any) -> Node {
    let unique = unique_name(state, name);
    entry[fields::ID] = fresh_id(state, unique);
    entry[fields::NAME] = unique;
    entry.remove(PARENT);
    let document: any = { inspector_fields::NODES: [entry] };
    // The scene's own blocks, so a `#id` the node names resolves.
    let assets = state.scene_doc[project_fields::ASSETS];
    if assets != nil {
        document[project_fields::ASSETS] = assets;
    }
    scene::instantiate(toml::encode(document), parent, scene::InstantiateOptions { scripts: false, root: state.game_root });
    let made = parent.children();
    let found = made[made.len() - 1];
    // Listed now, so a second spawn before the caller lists the rows again
    // takes neither its name nor its id.
    state.nodes.push(found);
    found
}

// Run the game's scripts on the scene's nodes: what play does, the actual
// game code against the actual scene.
pub fn attach_game_scripts(state: editor::State) {
    if state.scene_root != nil {
        scene::attach_scripts(state.scene_root.unwrap());
    }
}

pub fn add_component(state: &mut editor::State, name: str) {
    let found = selected_node(state);
    if !found.is_valid() {
        return;
    }
    history::record(state, "add {name}");
    found.set_component(name);
    log::info("added {name} to {found.name()}");
}

pub fn remove_component(state: &mut editor::State, name: str) {
    let found = selected_node(state);
    if !found.is_valid() {
        return;
    }
    // Whatever else on the node declares it needs this one goes first: taking
    // the transform out from under a body leaves the body driving nothing.
    let needed_by: [any] = [];
    for other in util::list_or_empty(found.component_names()) {
        if other.as_str() != name && util::contains(expects(state, other.as_str()), name) {
            needed_by.push(other);
        }
    }
    if needed_by.len() > 0 {
        let list = util::join(needed_by, " and ");
        log::warn("cannot remove {name}: {list} needs it; remove {list} first");
        return;
    }
    history::record(state, "remove {name}");
    found.remove_component(name);
}

/// Write one property across the selection: every selected node that carries
/// the component takes the value, and the whole write is one history step.
/// The engine keeps what each write refused as a warning on the property,
/// which the inspector marks its row with.
pub fn set_component_property(state: &mut editor::State, name: str, property: str, value: any) {
    history::record(state, "set {name}.{property}", "prop:{name}:{property}:{state.selected}");
    for row in selection::all(state) {
        let found = node(state, row);
        if found.is_valid() && found.has_component(name) {
            found.set_property(name, property, value);
        }
    }
}

/// Set several of a component's properties at once, adding the component when
/// the node has none.
///
/// One history entry rather than one per property: an action that says "make
/// this a convex decomposition" writes three of them, and undo should take
/// all three back together.
pub fn set_component_properties(state: &mut editor::State, name: str, properties: any) {
    set_component_properties_each(state, name, given, properties);
}

fn given(_found: Node, properties: any) -> any {
    properties
}

/// As `set_component_properties`, with each selected node's own properties:
/// `props_of(node, data)` answers them, or `nil` to leave that node alone. A
/// shape built from a mesh is built from each node's mesh, not the active one's.
pub fn set_component_properties_each(state: &mut editor::State, name: str, properties_of: fn(Node, any) -> any, data: any) {
    history::record(state, "set {name}");
    for row in selection::all(state) {
        let found = node(state, row);
        if !found.is_valid() {
            continue;
        }
        let properties = properties_of(found, data);
        if properties != nil {
            found.patch_component(name, properties);
        }
    }
}

// Where a copy of `found` goes. A scene has one root, so a copy of the root
// joins it as a child rather than standing beside it as a second root.
fn beside(state: editor::State, found: Node) -> Node {
    if is_scene_root(state, found) { found } else { found.parent() }
}

/// What `found` asks, as a scene file's node table without its id or parent:
/// what a copy of it is built from. Its children are not in it.
fn own_entry(state: editor::State, found: Node) -> any {
    let written = toml::parse(scene::to_toml(found, scene::ToTomlOptions { root: state.game_root }));
    let entry = util::list_or_empty(written[inspector_fields::NODES])[0];
    entry.remove(fields::ID);
    entry.remove(PARENT);
    entry
}

/// A node and its subtree as a scene file's text: what it asks, for a check
/// that an edit and its undo left it as it was.
pub fn node_text(state: editor::State, found: Node) -> str {
    scene::to_toml(found, scene::ToTomlOptions { root: state.game_root })
}

// Duplicate every selected node, without its children, beside it.
pub fn duplicate_selected(state: &mut editor::State) {
    if refuse_structure(state, "duplicate a node") {
        return;
    }
    history::record(state, "duplicate node");
    let made: [Node] = [];
    for row in selection::all(state) {
        let found = node(state, row);
        if found.is_valid() {
            made.push(spawn(state, beside(state, found), found.name(), own_entry(state, found)));
        }
    }
    reindex(state);
    let rows: [int] = [];
    for found in made {
        rows.push(index_of_node(state, found).or(0));
    }
    selection::set(state, rows);
}

/// The selection as a scene document, for the clipboard. Its id goes: the
/// paste mints a fresh one, and two nodes with one id is what the engine
/// cannot tell apart.
pub fn copy_selected(state: editor::State) -> str {
    toml::encode({ inspector_fields::NODES: [own_entry(state, selected_node(state))] })
}

/// Paste a scene document beside the selection. Anything that is not one is
/// left alone, because the clipboard is shared with every other application.
pub fn paste_nodes(state: &mut editor::State, text: str) -> bool {
    // The clipboard holds whatever the last application put there, so a
    // parse failure is an answer, not an error.
    let doc = toml::parse(text);
    if doc.kind() != types::KIND_MAP {
        return false;
    }
    let nodes = util::list_or_empty(doc[inspector_fields::NODES]);
    if nodes.len() == 0 {
        return false;
    }
    history::record(state, "paste node");
    if !has_selection(state) {
        selection::only(state, 0);
    }
    let at = selected_node(state);
    // A pasted node joins the selection's parent, right after it.
    let parent = beside(state, at);
    let place = if is_scene_root(state, at) { parent.children().len() } else { at.sibling_index() + 1 };
    let last: Node = nil;
    for entry in nodes {
        if entry.kind() != types::KIND_MAP || !entry.has(fields::NAME) {
            continue;
        }
        last = spawn(state, parent, entry[fields::NAME].as_str(), util::deep(entry));
        last.set_sibling_index(place);
        place += 1;
    }
    reindex(state);
    if last.is_valid() {
        selection::only(state, index_of_node(state, last).or(0));
    }
    true
}

pub fn delete_selected(state: &mut editor::State) {
    if refuse_structure(state, "delete a node") {
        return;
    }
    let rows = selection::roots(state);
    for row in rows {
        if is_scene_root(state, node(state, row)) {
            log::warn("the scene's root stays: a scene has one");
            return;
        }
    }
    let label = if rows.len() > 1 { "delete {rows.len()} nodes" } else { "delete {selected_node(state).name()}" };
    history::record(state, label);
    let after = state.selected;
    for row in rows {
        let found = node(state, row);
        if found.is_valid() {
            found.free();
        }
    }
    reindex(state);
    selection::only(state, util::int_max(0, util::int_min(after, state.nodes.len() - 1)));
    log::info(label);
}

pub fn stats(state: editor::State) -> Stats {
    let scripts = 0;
    for found in state.nodes {
        if script_rel(found) != nil {
            scripts += 1;
        }
    }
    Stats { nodes: state.nodes.len(), scripts: scripts }
}

/// Write one kept change back (PLAN-editor-as-scene §10.2). The change names
/// its node by id, so it outlives a node an undo built again; a node already
/// gone, freed by a change written back before it, is left alone.
pub fn undo_change(state: &mut editor::State, change: any) {
    let kind = change[fields::KIND].as_str();
    if kind == FREED {
        let parent = node_by_id(state, change[PARENT].as_str());
        if !parent.is_valid() || change[WAS] == nil {
            return;
        }
        let document = toml::parse(change[WAS].as_str());
        // The scene's own blocks, so a `#id` the node names resolves.
        let assets = state.scene_doc[project_fields::ASSETS];
        if assets != nil {
            document[project_fields::ASSETS] = assets;
        }
        scene::instantiate(toml::encode(document), parent, scene::InstantiateOptions { scripts: false, root: state.game_root });
        let made = parent.children();
        made[made.len() - 1].set_sibling_index(change[PLACE].as_int());
        return;
    }
    let found = node_by_id(state, change[fields::ID].as_str());
    if !found.is_valid() {
        return;
    }
    if kind == COMPONENT || kind == REMOVED {
        found.set_component(change[COMPONENT].as_str(), util::map_or_empty(change[WAS]));
    } else if kind == ATTACHED {
        found.remove_component(change[COMPONENT].as_str());
    } else if kind == ADDED {
        found.free();
    } else if kind == RENAMED {
        found.set_name(change[WAS].as_str());
    } else if kind == tabs::SCRIPT {
        let was = change[WAS];
        if was == nil {
            found.set_script(nil);
        } else {
            found.set_script(was[inspector_fields::SOURCE].as_str(), util::map_or_empty(was[inspector_fields::PROPS]));
        }
    } else if kind == KEYS {
        restore_keys(found, change[WAS]);
    } else if kind == MOVED && change[WAS] != nil {
        let parent = node_by_id(state, change[WAS][PARENT].as_str());
        if parent.is_valid() && found.parent() != parent {
            found.set_parent(parent);
        }
        found.set_sibling_index(change[WAS][PLACE].as_int());
    }
}

/// What `found` asks of each component it carries, by name: the shape a
/// recipe rewrites (a sprite traced into a polygon, a preset's parts put on)
/// and `write_row` hands back. It lives for one edit; the node is what is
/// kept.
pub fn row_of(found: Node) -> any {
    let row: any = {};
    if !found.is_valid() {
        return row;
    }
    for name in found.component_names() {
        row[name] = util::map_or_empty(found.authored(name));
    }
    row
}

/// Make `found` carry what `row` asks: a component it no longer names taken
/// off, one it names written where it differs from what the node asks.
pub fn write_row(found: Node, row: any) {
    if !found.is_valid() {
        return;
    }
    for name in found.component_names() {
        if !row.has(name) {
            found.remove_component(name);
        }
    }
    for name in row.keys() {
        let wanted = util::map_or_empty(row[name]);
        if !found.has_component(name) || toml::encode({ "v": found.authored(name) }) != toml::encode({ "v": wanted }) {
            found.set_component(name, wanted);
        }
    }
}

/// A component's asked table held for a tool that changes it in place over
/// several calls: which node and component, the frame it was read in, and the
/// table. `write_edited` hands it to the node whole, as one write.
pub struct Edited {
    id: str,
    component: str,
    frame: int,
    table: any,
}

/// What `found` asks of `component`, to change in place and hand back with
/// `write_edited`: a polygon's mesh, a tilemap's cells. Read once a frame, so
/// every call in one edit changes the same table; nil when the node does not
/// carry the component.
pub fn edited(state: &mut editor::State, found: Node, component: str) -> any {
    if !found.is_valid() || !found.has_component(component) {
        return nil;
    }
    let id = found.stable_id();
    if state.edited != nil {
        let held = state.edited.unwrap();
        if held.id == id && held.component == component && held.frame == state.frame {
            return held.table;
        }
    }
    let table = util::map_or_empty(found.authored(component));
    state.edited = Edited { id: id, component: component, frame: state.frame, table: table };
    table
}

/// Hand the table `edited` holds for `found` back to it whole.
pub fn write_edited(state: &mut editor::State, found: Node, component: str) {
    let table = edited(state, found, component);
    if table != nil {
        found.set_component(component, table);
    }
}

/// Drop the held table: what an undo or a build changed under it is read
/// again.
pub fn drop_edited(state: &mut editor::State) {
    state.edited = nil;
}

// A node's own keys back to `was`, each only where it differs: a hide undone
// writes the one flag.
fn restore_keys(found: Node, was: any) {
    if found.visible() != was[VISIBLE].as_bool() {
        found.set_visible(was[VISIBLE].as_bool());
    }
    let tint = util::list_or_empty(was["tint"]);
    let now = found.tint();
    if tint.len() == 4 && (now.r != tint[0].as_float() || now.g != tint[1].as_float() || now.b != tint[2].as_float() || now.a != tint[3].as_float()) {
        found.set_tint(color(tint[0].as_float(), tint[1].as_float(), tint[2].as_float(), tint[3].as_float()));
    }
    if found.z_index() != was[Z_INDEX].as_int() {
        found.set_z_index(was[Z_INDEX].as_int(), was["z_as_relative"].as_bool());
    }
    if found.process() != was[PROCESS].as_str() {
        found.set_process(was[PROCESS].as_str());
    }
    let tags = util::list_or_empty(was[fields::TAGS]);
    for tag in found.tags() {
        if !util::contains(tags, tag) {
            found.remove_tag(tag);
        }
    }
    for tag in tags {
        if !found.has_tag(tag.as_str()) {
            found.add_tag(tag.as_str());
        }
    }
}
