// The Events view, which authors rather than lists: one row per
// `[[nodes.bindings.rows]]` entry, and the Rune each row is equivalent to.

use crate::history;
use crate::icons;
use crate::model;
use crate::util;

pub fn state() {
    // The row waiting for a node to be clicked in the tree, `None` when
    // nothing is picking.
    #{ picking: None }
}

/// The rows on the selected node. A hand-written file spells them
/// `[[nodes.bindings.rows]]`, and one the editor has saved spells them under
/// `rows`; both are the same list.
pub fn rows(S) {
    let node = match crate::model::selected_row(S) {
        Some(node) => node,
        None => return [],
    };
    let held = node.get("bindings").unwrap_or([]);
    if held is Object {
        return util::vec(util::obj(held).get("rows").unwrap_or([]));
    }
    util::vec(held)
}

fn write(S, rows, label) {
    if !crate::model::has_selection(S) {
        return;
    }
    history::record(S, label, None);
    let node = S.doc[S.sel];
    if rows.len() == 0 {
        node.remove("bindings");
    } else {
        node.bindings = #{ rows: rows };
    }
    model::record_override(S, node, "bindings");
    model::apply_component(S, "bindings");
    history::commit(S);
}

/// A copy of the rows, so a mutation lands after the history step rather than
/// before it: `rows` hands back the document's own list.
fn editable(S) {
    util::deep(rows(S))
}

// The event a new row answers to, and the prefix a hook's name carries.
const DEFAULT_EVENT = "pointer_click";
const HOOK_PREFIX = "on_";

pub fn add_row(S) {
    let rows = editable(S);
    rows.push(#{ event: DEFAULT_EVENT, action: "state", target: "", value: "" });
    write(S, rows, "add binding");
}

pub fn remove_row(S, at) {
    let rows = editable(S);
    if at >= rows.len() {
        return;
    }
    rows.remove(at);
    write(S, rows, "remove binding");
}

fn set_field(S, at, key, value) {
    let rows = editable(S);
    if at >= rows.len() {
        return;
    }
    if value == "" && key != "value" {
        rows[at].remove(key);
    } else {
        rows[at][key] = value;
    }
    write(S, rows, "edit binding");
}

/// The node paths a target picker offers: every node in the scene, spelled
/// from the bound node, plus the empty path that means the node itself.
fn target_paths(S) {
    let out = ["(this node)"];
    for node in S.doc {
        let path = model::node_path(S.doc, node);
        if path != "" {
            out.push(path);
        }
    }
    out
}

/// The variables a `set_variable` row targets.
fn variable_names(S) {
    let out = [];
    for entry in util::vec(scene::variables()) {
        out.push(entry.name);
    }
    out
}

const ROW_H = 26.0;

fn as_text(value) {
    match value {
        Some(value) => if value is String { value } else { format!("{}", value) },
        None => "",
    }
}

/// Whether an action's `target` names a variable rather than a node.
fn targets_a_variable(action) {
    action == "set_variable" || action == "add_variable"
}

// A dropdown over one of a row's fields.
fn pick(S, at, key, current, choices, width) {
    #{
        kind: "dropdown", role: "choice_form", width: width,
        text: current, options: choices,
        on: |picked| { set_field(S, at, key, picked); },
    }
}

// A field over one of a row's fields, written on Enter rather than per key.
fn typed(S, at, key, current, placeholder, width) {
    #{
        kind: "text_field", role: "input_form", width: width,
        text: current, placeholder: placeholder,
        on_submit: |text| {
            if text != current {
                set_field(S, at, key, text);
            }
        },
    }
}

// What a row on the selected node may answer: the core hooks, and the
// `emitted:` events the node and its components announce.
fn offered(S) {
    match crate::model::live(S, S.sel) {
        Some(found) => util::vec(scene::bindable_events(found)),
        None => util::vec(scene::bindable_events()),
    }
}

/// One binding: what happens, when, and what it does.
fn row_spec(S, at, row) {
    let event = row.get("event").unwrap_or(DEFAULT_EVENT);
    let action = row.get("action").unwrap_or("state");
    let target = row.get("target").unwrap_or("");
    let controls = [
        #{ kind: "label", role: "text_caption", width: 18, text: format!("{}", at + 1) },
        pick(S, at, "event", event, offered(S), 150.0),
        typed(S, at, "when", row.get("when").unwrap_or(""), "always", 130.0),
        #{ kind: "label", role: "text_caption", text: "→" },
        pick(S, at, "action", action, util::vec(scene::binding_actions()), 130.0),
    ];
    if targets_a_variable(action) {
        controls.push(pick(S, at, "target", if target == "" { "—" } else { target },
            variable_names(S), 120.0));
    } else {
        controls.push(#{
            kind: "dropdown", role: "choice_form", width: 140,
            text: if target == "" { "(this node)" } else { target },
            options: target_paths(S),
            on: |picked| {
                set_field(S, at, "target", if picked == "(this node)" { "" } else { picked });
            },
        });
    }
    controls.push(typed(S, at, "value", as_text(row.get("value")), "value", 110.0));
    controls.push(#{
        kind: "button", role: "chip_quiet", text: icons::ui("close"),
        tooltip: "Remove this binding",
        on: |_| { remove_row(S, at); },
    });
    #{ full: true, height: ROW_H, slot_role: "layout_actions", controls: controls }
}

/// The Rune a row is equivalent to, which is what "Convert to script" writes.
///
/// One arm per action, spelling the call the interpreter makes, so a scene
/// that outgrows the table graduates without a rewrite.
// The prefix an event row carries for what its own node emits by name.
pub const EMITTED = "emitted:";

pub fn as_script(S) {
    script_of(rows(S))
}

/// The same, for any list of rows.
pub fn script_of(rows) {
    let byhook = #{};
    // An `emitted:<name>` row hears the node's own event, which a script only
    // hears once it subscribes to it.
    let heard = [];
    for row in rows {
        let event = row.get("event").unwrap_or(DEFAULT_EVENT);
        let own = event.starts_with(EMITTED);
        let name = if own { event[EMITTED.len()..] } else { event };
        if own && !heard.iter().any(|h| h == name) {
            heard.push(name);
        }
        let hook = HOOK_PREFIX + name;
        if !byhook.contains_key(hook) {
            byhook[hook] = [];
        }
        byhook[hook].push(row);
    }
    let out = "// Written from this node's event bindings.\n";
    if heard.len() > 0 {
        out += "\npub fn init(this) {\n";
        for name in heard {
            out += format!("    events::subscribe(this.node, \"{}\", this.node);\n", name);
        }
        out += "}\n";
    }
    for hook in util::keys_sorted(byhook) {
        let args = if heard.iter().any(|h| HOOK_PREFIX + h == hook) { ", payload" } else { hook_args(hook) };
        out += format!("\npub fn {}(this{}) {{\n", hook, args);
        for row in byhook[hook] {
            out += "    " + guarded(row) + "\n";
        }
        out += "}\n";
    }
    out
}

/// The arguments each hook is handed, so the written function's signature is
/// the one the engine calls.
fn hook_args(hook) {
    match hook {
        "on_pointer_down" => ", button",
        "on_pointer_up" => ", button",
        "on_pointer_click" => ", button",
        "on_pointer_drag" => ", dx, dy",
        "on_pointer_drop" => ", dropped",
        "on_key_down" => ", key",
        "on_key_up" => ", key",
        "on_action" => ", action",
        "on_scroll" => ", dx, dy",
        "on_resize" => ", width, height",
        "on_variable_changed" => ", name, value",
        "on_state_changed" => ", from, to",
        "on_collision_enter" => ", other",
        "on_collision_exit" => ", other",
        _ => "",
    }
}

fn guarded(row) {
    let call = as_call(row);
    let when = row.get("when").unwrap_or("");
    if when == "" {
        return call;
    }
    format!("if {} {{ {} }}", rune_condition(when), call)
}

/// A condition rewritten as Rune: every bare name becomes the read that fetches
/// it, and the operators are the same in both.
fn rune_condition(when) {
    let out = "";
    for (i, clause) in when.split("&&").enumerate() {
        if i > 0 {
            out += " && ";
        }
        out += rune_clause(clause);
    }
    out
}

fn rune_clause(clause) {
    let text = clause.trim();
    for op in [">=", "<=", "==", "!=", ">", "<"] {
        if let Some(at) = util::index_of(text, op) {
            let name = text[..at].trim();
            let rest = text[at + op.len()..].trim();
            return format!("scene::variable(\"{}\") {} {}", name, op, rest);
        }
    }
    format!("scene::variable(\"{}\") == true", text)
}

fn as_call(row) {
    let action = row.get("action").unwrap_or("state");
    let target = row.get("target").unwrap_or("");
    let value = as_text(row.get("value"));
    // `this` is the script's own table; the node it runs on is `this.node`.
    let node = if target == "" { "this.node" } else { format!("this.node.get_node(\"{}\")", target) };
    match action {
        "state" => format!("{}.states.go(\"{}\");", node, value),
        "set_variable" => format!("scene::set_variable(\"{}\", {});", target, literal(value)),
        "add_variable" => format!(
            "scene::set_variable(\"{}\", scene::variable(\"{}\") + {});",
            target, target, literal(value)),
        "play" => format!("{}.animation.play(\"{}\");", node, value),
        "sound" => format!("{}.sound.play();", node),
        "spawn" => format!("scene::instantiate(fs::read(\"{}\"), {});", value, node),
        "free" => format!("{}.queue_free();", node),
        "switch" => format!("scene::switch(\"{}\", #{{}});", value),
        "open_url" => format!("engine::open_url(\"{}\");", value),
        "emit" => format!("{}.emit(\"{}\", ());", node, value),
        "call" => format!("{}.call(\"{}\", []);", node, value),
        "visible" => format!("{}.set_visible({});", node, literal(value)),
        _ => format!("// no call for `{}`", action),
    }
}

/// A written value as Rune source: a number and a bool stay as they are, and
/// everything else is a string.
fn literal(value) {
    if value == "true" || value == "false" {
        return value;
    }
    let digits = "0123456789.-";
    let numeric = value != "";
    for c in value.chars() {
        if !digits.contains(format!("{}", c)) {
            numeric = false;
        }
    }
    if numeric { value } else { format!("\"{}\"", value) }
}

/// Write the script this node's bindings are equivalent to, attach it, and
/// open it. The rows stay: deleting them is the author's call, once they have
/// read what was written.
pub fn convert_to_script(S) {
    if !crate::model::has_selection(S) {
        return;
    }
    if rows(S).len() == 0 {
        log::info("this node has no bindings to convert");
        return;
    }
    let node = S.doc[S.sel];
    let rel = format!("scripts/{}_events.rn", node.name.to_lowercase());
    fs::write(S.game_root + "/" + rel, as_script(S));
    model::forget(S, None);
    history::record(S, "convert bindings to a script", None);
    node.script = #{ source: rel };
    model::record_override(S, node, "script");
    history::commit(S);
    S.shader_rel = "";
    crate::shell::open_doc(S, "script");
    log::info("wrote " + rel);
}

/// The node the document area hands a tab whose rows are nodes.
const PANEL = "Editor/Shell/Body/Centre/UpperRow/Stack/Upper/Work/Canvas/Stage/DocPanel";

/// Stop showing the view, for the frame a document tab that draws is up.
pub fn hide() {
    util::hide(PANEL);
}

/// Where the rows go, which the self-test reads back.
pub fn rows_host() {
    PANEL + "/DocScroll/DocRows"
}

/// The document tab: the selected node's rows, and the variables they read.
pub fn view(S, k) {
    util::fill(PANEL, #{ visible: true });
    let node = model::selected_node(S);
    crate::pool::strip(S, PANEL + "/DocHead", [
        #{ kind: "label", role: "text_heading", grow: 1,
            text: format!("EVENT BINDINGS · {}", node.name) },
        #{
            kind: "button", role: "action_form_secondary", text: "‹›  Convert to script",
            on: |_| { convert_to_script(S); },
        },
        #{
            kind: "button", role: "action_form_primary", text: icons::ui("add") + "  Add row",
            on: |_| { add_row(S); },
        },
    ]);
    let specs = [];
    let held = rows(S);
    if held.len() == 0 {
        specs.push(note("no bindings on this node yet"));
    }
    for (at, row) in held.iter().enumerate() {
        specs.push(row_spec(S, at, util::obj(row)));
    }
    variable_specs(S, specs);
    hook_specs(S, specs);
    crate::pool::sync(S, rows_host(), specs, 0.0, false);
}

fn note(text) {
    #{ full: true, height: 0, controls: [#{
        kind: "label", role: "text_caption", grow: 1, wrap: true, text: text,
    }] }
}

fn head(text) {
    #{ full: true, height: 26, controls: [#{
        kind: "label", role: "text_heading", grow: 1, text: text.to_uppercase(),
    }] }
}

/// What the scene declares, so a `when` has something to name. Read-only: a
/// variable is declared in the scene file's `[variables]`.
fn variable_specs(S, out) {
    out.push(head("scene variables"));
    let declared = util::vec(scene::variables());
    if declared.len() == 0 {
        out.push(note("none; declare them under [variables] in the scene file"));
        return;
    }
    for entry in declared {
        out.push(#{ full: true, height: 24, slot_role: "layout_actions", controls: [
            #{ kind: "label", role: "text_code", text: entry.name },
            #{ kind: "label", role: "text_caption", text: entry["type"] },
            #{ kind: "row", grow: 1 },
            #{ kind: "label", role: "text_code_success", text: format!("{}", entry.value) },
        ] });
    }
}

/// The hooks the node's own script declares, which is what this view used to
/// be and is still worth showing beside the rows.
fn hook_specs(S, out) {
    let node = model::selected_node(S);
    let script_some = model::script_rel(node);
    let script = match script_some {
        Some(script) => script,
        None => return,
    };
    out.push(head("script hooks"));
    for hook in model::hooks(S, script) {
        let lifecycle = hook.name == "init" || hook.name == "update";
        out.push(#{ full: true, height: 28, controls: [#{
            kind: "row", role: "sheet_hook", controls: [
                #{
                    kind: "label", text: "•",
                    role: if lifecycle { "text_mark_primary" } else { "text_mark_secondary" },
                },
                #{ kind: "label", role: "text_code", text: format!("{}.{}()", node.name, hook.name) },
                #{ kind: "row", grow: 1 },
                #{ kind: "label", role: "text_caption", text: format!("{}:{}", script, hook.line) },
            ],
        }] });
    }
}
