// Small helpers the rest of the editor leans on: widget nodes, the unit
// separator rows split on, document vectors as `[x, y, z]`, colours, and the
// 2D frame a node's own space is drawn in.

/// A vector's direction and length.
pub struct Norm {
    internal direction: [float],
    internal length: float,
}

/// A colour as unit floats.
pub struct Rgb {
    internal red: float,
    internal green: float,
    internal blue: float,
}

/// The 2D world frame of a node's own space: where its origin sits, the
/// cosine and sine of its rotation, and its scale.
pub struct Frame {
    internal x: float,
    internal y: float,
    internal cosine: float,
    internal sine: float,
    internal scale_x: float,
    internal scale_y: float,
}

/// Texture pixels to one world unit when a component names none.
pub const DEFAULT_PIXELS_PER_UNIT: float = 100.0;

pub fn join(parts: [str], separator: str) -> str {
    let out = "";
    for index in 0..parts.len() {
        if index > 0 {
            out += separator;
        }
        out += parts[index];
    }
    out
}

pub fn last_segment(path: str) -> str {
    let parts = path.split("/");
    parts[parts.len() - 1]
}

/// The last segment of a `/`-separated path, which is what a column too
/// narrow for the whole thing shows.
pub fn leaf(path: str) -> str {
    last_segment(path)
}

/// Words joined by `_` or `-` as one capitalised name: `door_events` is
/// `DoorEvents`.
pub fn camel(words: str) -> str {
    let out = "";
    for part in words.replace("-", "_").split("_") {
        if part.len() > 0 {
            let first = part.chars()[0];
            out += first.to_upper() + part.slice(first.len(), part.len());
        }
    }
    out
}

/// The class a script file declares, named after the file as the engine
/// requires: `scripts/door_events.bs` names `DoorEvents`.
pub fn class_of(path: str) -> str {
    camel(leaf(path).replace(".bs", ""))
}

pub fn is_nil(value: any) -> bool {
    value == nil
}

/// `value` when it is a map, else an empty one.
pub fn map_or_empty(value: any) -> any {
    if value.kind() == "map" { value } else { {} }
}

/// `value` when it is a list, else an empty one.
pub fn list_or_empty(value: any) -> any {
    if value.kind() == "list" { value } else { [] }
}

/// Fill a widget node from a table.
///
/// `patch_component` rather than get-mutate-set: every property the table
/// leaves out stays where it was, and a view that only sets `options` and
/// `visible` cannot flatten the rest of the widget by forgetting one.
pub fn fill(id: str, parameters: any) {
    let found = scene::get_node(id);
    if !found.is_valid() {
        return;
    }
    found.patch_component("widget", parameters);
}

/// Whether a widget node draws, for a node that may not be there.
pub fn set_visible(id: str, visible: bool) {
    let found = scene::get_node(id);
    if found.is_valid() {
        found.set_visible(visible);
    }
}

/// A widget node's text, for a node that may not be there.
pub fn set_text(id: str, text: str) {
    let found = scene::get_node(id);
    if found.is_valid() {
        found.widget.text = text;
    }
}

/// Fill one of the components beside a widget node, `widget_range` or the
/// rest, from a table, as `fill` fills the widget.
pub fn fill_beside(id: str, component: str, parameters: any) {
    let found = scene::get_node(id);
    if !found.is_valid() {
        return;
    }
    found.patch_component(component, parameters);
}

/// One property of a component on a widget node, for a caller reading back
/// what the reader left on it.
pub fn property(id: str, component: str, key: str) -> any {
    let found = scene::get_node(id);
    if !found.is_valid() {
        return nil;
    }
    found.get_component(component, key)
}

/// Stop drawing a node. Only the dock that owns one may call this: every dock
/// draws each frame, so a global hide has one turning off another's node.
pub fn hide(id: str) {
    let found = scene::get_node(id);
    if !found.is_valid() {
        return;
    }
    found.set_visible(false);
}

/// `value` with `places` decimals, rounded: what `{:.2}` wrote.
pub fn fixed(value: float, places: int) -> str {
    let scale = 1;
    for _ in 0..places {
        scale *= 10;
    }
    let scaled = math::round(math::abs(value) * (scale as float)) as int;
    let sign = if value < 0.0 && scaled != 0 { "-" } else { "" };
    if places == 0 {
        return "{sign}{scaled}";
    }
    let digits = "{scaled % scale}";
    while digits.len() < places {
        digits = "0" + digits;
    }
    "{sign}{scaled / scale}.{digits}"
}

pub fn clamp(value: float, lowest: float, highest: float) -> float {
    if value < lowest { lowest } else if value > highest { highest } else { value }
}

pub fn max(first: float, second: float) -> float {
    if first > second { first } else { second }
}

pub fn min(first: float, second: float) -> float {
    if first < second { first } else { second }
}

pub fn int_max(first: int, second: int) -> int {
    if first > second { first } else { second }
}

pub fn int_min(first: int, second: int) -> int {
    if first < second { first } else { second }
}

pub fn int_abs(value: int) -> int {
    if value < 0 { -value } else { value }
}

pub fn abs(value: float) -> float {
    if value < 0.0 { -value } else { value }
}

/// Three floats from a document vector, or `fallback`.
pub fn list3_or(value: any, fallback: [float]) -> [float] {
    if value.kind() == "list" && value.len() >= 3 {
        [value[0].as_float(), value[1].as_float(), value[2].as_float()]
    } else {
        fallback
    }
}

/// Two floats from a document vector, or `fallback`.
pub fn list2_or(value: any, fallback: [float]) -> [float] {
    if value.kind() == "list" && value.len() >= 2 {
        [value[0].as_float(), value[1].as_float()]
    } else {
        fallback
    }
}

/// A live node's `Vec3` as the `[x, y, z]` the draw and document code uses.
pub fn xyz(vector: Vec3) -> [float] {
    [vector.x, vector.y, vector.z]
}

pub fn vector_add(first: [float], second: [float]) -> [float] {
    [first[0] + second[0], first[1] + second[1], first[2] + second[2]]
}

pub fn vector_subtract(first: [float], second: [float]) -> [float] {
    [first[0] - second[0], first[1] - second[1], first[2] - second[2]]
}

pub fn vector_scale(vector: [float], factor: float) -> [float] {
    [vector[0] * factor, vector[1] * factor, vector[2] * factor]
}

pub fn vector_dot(first: [float], second: [float]) -> float {
    first[0] * second[0] + first[1] * second[1] + first[2] * second[2]
}

pub fn vector_cross(first: [float], second: [float]) -> [float] {
    [
        first[1] * second[2] - first[2] * second[1],
        first[2] * second[0] - first[0] * second[2],
        first[0] * second[1] - first[1] * second[0],
    ]
}

/// The unit vector and the length; a zero vector normalises to zero, so a
/// caller can divide without checking first.
pub fn vector_normalise(vector: [float]) -> Norm {
    let length = math::sqrt(vector_dot(vector, vector));
    if length < 1e-6 {
        return Norm { direction: [0.0, 0.0, 0.0], length: 0.0 };
    }
    Norm { direction: vector_scale(vector, 1.0 / length), length: length }
}

pub fn distance(first: [float], second: [float]) -> float {
    vector_normalise(vector_subtract(first, second)).length
}

/// Where `needle` first sits in `text`, or nil.
pub fn index_of(text: str, needle: str) -> int? {
    if needle == "" {
        return nil;
    }
    let at = text.find(needle);
    if at < 0 { nil } else { at }
}

/// `text` cased the way `sample` is: all caps, capitalised, or left alone.
/// What keeps `Arm_L` mirroring to `Arm_R` rather than to `Arm_r`.
pub fn match_case(sample: str, text: str) -> str {
    if sample == sample.to_lower() {
        return text;
    }
    if sample == sample.to_upper() {
        return text.to_upper();
    }
    capitalised(text.to_lower())
}

fn capitalised(text: str) -> str {
    if text == "" {
        return text;
    }
    text.slice(0, 1).to_upper() + text.slice(1, text.len())
}

/// Words a schema key spells lowercase that a label spells in capitals.
fn acronyms() -> [str] {
    ["fov", "hdr", "id", "ik", "lod", "rgb", "rgba", "srgb", "ui", "uv"]
}

/// A schema key as a row label: `edge_radius` reads "Edge radius". The key
/// itself is untouched, so a label never becomes the name of anything.
pub fn property_label(property: str) -> str {
    if property == "" {
        return property;
    }
    let words: [str] = [];
    for word in property.split("_") {
        words.push(if contains(acronyms(), word) { word.to_upper() } else { word });
    }
    capitalised(join(words, " "))
}

pub fn contains(items: [str], needle: str) -> bool {
    for it in items {
        if it == needle {
            return true;
        }
    }
    false
}

pub fn position(items: [str], needle: str) -> int? {
    for index in 0..items.len() {
        if items[index] == needle {
            return index;
        }
    }
    nil
}

/// `contains` and `position` over rows of the document.
pub fn int_contains(items: [int], needle: int) -> bool {
    for it in items {
        if it == needle {
            return true;
        }
    }
    false
}

pub fn int_position(items: [int], needle: int) -> int? {
    for index in 0..items.len() {
        if items[index] == needle {
            return index;
        }
    }
    nil
}

pub fn keys_sorted(table: any) -> [str] {
    let keys = table.keys();
    keys.sort();
    keys
}

pub fn count_lines(text: str) -> int {
    text.split("\n").len()
}

pub fn repeat(text: str, count: int) -> str {
    let out = "";
    for _ in 0..count {
        out += text;
    }
    out
}

/// A shallow copy of a map or a list; anything else is a value already.
pub fn copy(value: any) -> any {
    if value.kind() == "map" {
        let out: any = {};
        for key in value.keys() {
            out[key] = value[key];
        }
        return out;
    }
    if value.kind() == "list" {
        let out: [any] = [];
        for item in value {
            out.push(item);
        }
        return out;
    }
    value
}

/// A copy all the way down.
pub fn deep(value: any) -> any {
    if value.kind() == "map" {
        let out: any = {};
        for key in value.keys() {
            out[key] = deep(value[key]);
        }
        return out;
    }
    if value.kind() == "list" {
        let out: [any] = [];
        for item in value {
            out.push(deep(item));
        }
        return out;
    }
    value
}

/// `#rrggbb` to unit floats.
pub fn hex_to_rgb(hex: str) -> Rgb {
    Rgb { red: hex_pair(hex, 1), green: hex_pair(hex, 3), blue: hex_pair(hex, 5) }
}

fn hex_pair(hex: str, at: int) -> float {
    let digits = "0123456789abcdef";
    let pair = hex.slice(at, at + 2).to_lower();
    let high_digit = int_max(digits.find(pair.slice(0, 1)), 0);
    let low_digit = int_max(digits.find(pair.slice(1, 2)), 0);
    (high_digit * 16 + low_digit) as float / 255.0
}

/// Unit floats to `#rrggbb`: what a colour swatch reports, as a theme spells it.
pub fn to_hex(rgba: [float]) -> str {
    let digits = "0123456789abcdef";
    let out = "#";
    for channel in 0..3 {
        let byte = int_min(int_max((rgba[channel] * 255.0 + 0.5) as int, 0), 255);
        out += digits.slice(byte / 16, byte / 16 + 1);
        out += digits.slice(byte % 16, byte % 16 + 1);
    }
    out
}

/// A colour as the `[r, g, b]` the draw calls take.
pub fn rgb(hex: str) -> [float] {
    let color = hex_to_rgb(hex);
    [color.red, color.green, color.blue]
}

// Rotation basis from the engine's ZYX euler (roll=x, pitch=y, yaw=z):
// R = Rz(yaw) * Ry(pitch) * Rx(roll). Returns the world-space directions of
// the node's local axes (the matrix columns).
pub fn basis_from_euler(euler: [float]) -> [[float]] {
    let cos_roll = math::cos(euler[0]);
    let sin_roll = math::sin(euler[0]);
    let cos_pitch = math::cos(euler[1]);
    let sin_pitch = math::sin(euler[1]);
    let cos_yaw = math::cos(euler[2]);
    let sin_yaw = math::sin(euler[2]);
    [
        [cos_yaw * cos_pitch, sin_yaw * cos_pitch, -sin_pitch],
        [cos_yaw * sin_pitch * sin_roll - sin_yaw * cos_roll, sin_yaw * sin_pitch * sin_roll + cos_yaw * cos_roll, cos_pitch * sin_roll],
        [cos_yaw * sin_pitch * cos_roll + sin_yaw * sin_roll, sin_yaw * sin_pitch * cos_roll - cos_yaw * sin_roll, cos_pitch * cos_roll],
    ]
}

pub fn euler_from_basis(basis: [[float]]) -> [float] {
    let pitch = math::asin(clamp(-basis[0][2], -1.0, 1.0));
    let yaw = math::atan2(basis[0][1], basis[0][0]);
    let roll = math::atan2(basis[1][2], basis[2][2]);
    [roll, pitch, yaw]
}

pub fn rotate_basis_local(basis: [[float]], axis: int, angle: float) -> [[float]] {
    let cosine = math::cos(angle);
    let sine = math::sin(angle);
    let first_axis = (axis + 1) % 3;
    let second_axis = (axis + 2) % 3;
    // Columns `first_axis` and `second_axis` rotate into each other around column
    // `axis`.
    let first_column = basis[first_axis];
    let second_column = basis[second_axis];
    let out = [basis[0], basis[1], basis[2]];
    out[first_axis] = [first_column[0] * cosine + second_column[0] * sine, first_column[1] * cosine + second_column[1] * sine, first_column[2] * cosine + second_column[2] * sine];
    out[second_axis] = [second_column[0] * cosine - first_column[0] * sine, second_column[1] * cosine - first_column[1] * sine, second_column[2] * cosine - first_column[2] * sine];
    out
}

/// Rotate a ZYX euler about one of its own axes.
pub fn rotate_euler(euler: [float], axis: int, angle: float) -> [float] {
    euler_from_basis(rotate_basis_local(basis_from_euler(euler), axis, angle))
}

/// Rotate a world point about `center` by `angle` around world axis `axis`.
pub fn rotate_about(point: [float], center: [float], axis: int, angle: float) -> [float] {
    let cosine = math::cos(angle);
    let sine = math::sin(angle);
    let offset = vector_subtract(point, center);
    let first_axis = (axis + 1) % 3;
    let second_axis = (axis + 2) % 3;
    let out = [offset[0], offset[1], offset[2]];
    out[first_axis] = offset[first_axis] * cosine - offset[second_axis] * sine;
    out[second_axis] = offset[first_axis] * sine + offset[second_axis] * cosine;
    vector_add(center, out)
}

/// The 2D world frame of a node's own space. A `path2d`'s control points
/// and a polygon's vertices are both authored in it.
pub fn frame_of(found: Node) -> Frame {
    let origin = found.transform.global_position();
    let angle = found.transform.global_rotation_euler().z;
    let scale = found.transform.global_scale();
    Frame { x: origin.x, y: origin.y, cosine: math::cos(angle), sine: math::sin(angle), scale_x: scale.x, scale_y: scale.y }
}

/// A point in that frame, in the world.
pub fn to_world(frame: Frame, local_x: float, local_y: float) -> Vec2 {
    let scaled_x = local_x * frame.scale_x;
    let scaled_y = local_y * frame.scale_y;
    vec2(frame.x + frame.cosine * scaled_x - frame.sine * scaled_y, frame.y + frame.sine * scaled_x + frame.cosine * scaled_y)
}

/// A world point back in that frame. A zero scale places everything at the
/// origin, so it is read as one rather than dividing by it.
pub fn to_local(frame: Frame, world_x: float, world_y: float) -> Vec2 {
    let offset_x = world_x - frame.x;
    let offset_y = world_y - frame.y;
    let rotated_x = frame.cosine * offset_x + frame.sine * offset_y;
    let rotated_y = -frame.sine * offset_x + frame.cosine * offset_y;
    let scale_x = if math::abs(frame.scale_x) > 1e-6 { frame.scale_x } else { 1.0 };
    let scale_y = if math::abs(frame.scale_y) > 1e-6 { frame.scale_y } else { 1.0 };
    vec2(rotated_x / scale_x, rotated_y / scale_y)
}

/// A project path where the engine wants one. The editor's engine resolves a
/// relative path against the *editor's* root, so a reference handed to it is
/// made absolute against `root`, the game's; one that already is comes back
/// as it is, never prefixed a second time.
pub fn engine_path(root: str, rel: str) -> str {
    if rel.starts_with("/") {
        return rel;
    }
    root + "/" + rel
}
