// The editor's verbs on its state `state`: selection, workspaces, play, the
// palette, breakpoints, the pause, and the start-up states.

use about;
use anim;
use center;
use complete;
use defs;
use docks;
use docs;
use dropin;
use editor;
use exporter;
use history;
use lint;
use manager;
use model;
use newnode;
use plugins;
use polygon;
use populate;
use selection;
use selftest;
use session;
use settings;
use showcase;
use signals;
use statemachine;
use suite;
use theme;
use themewin;
use tiles;
use util;
use window;

pub class DebugState {
    frame: int,
    breakpoints: any,
    paused: any,
    paused_rel: str,
    demo: int?,
    rows: [str],
    owners: [int],
}

/// A start-up state written `<prefix><argument>`, and what it runs with the
/// argument.
pub struct Prefixed {
    prefix: str,
    run: fn(&mut editor::State, str),
}

pub struct Capture {
    dir: str,
    from: int,
    every: int,
    count: int,
}

/// The debugger's own state, hung on `state.debug`. `demo` drives the breakdemo
/// self-test's step/continue alternation.
pub fn debug_state() -> DebugState {
    DebugState { frame: 0, breakpoints: map(), paused: nil, paused_rel: "", demo: nil, rows: [], owners: [] }
}

pub fn choose(state: &mut editor::State, row: int) {
    if row != state.sel {
        history::commit(state);
    }
    selection::only(state, row);
}

/// A click that may extend the set: ⌘ toggles one row, ⇧ takes the run
/// between the active row and this one, and a plain click replaces the set.
pub fn choose_click(state: &mut editor::State, row: int) {
    let additive = input::key_down(input::KEY_META) || input::key_down(input::KEY_CONTROL);
    let ranged = input::key_down(input::KEY_SHIFT);
    if !additive && !ranged {
        choose(state, row);
        return;
    }
    history::commit(state);
    if ranged {
        selection::extend_to(state, row);
    } else {
        selection::toggle(state, row);
    }
}

// An undo or a redo goes back to the scene as it was edited: a running game
// stops first, said so, since the step is the edited scene's and not the
// game's.
fn stop_for(state: &mut editor::State, label: str) {
    if state.playing {
        stop_play(state);
        log::info("{label} stopped the running scene");
    }
}

fn stepped(state: &mut editor::State, label: str, moved_or: str?) {
    if moved_or.is_none() {
        log::info("nothing to {label}");
        return;
    }
    log::info("{label}: {moved_or.unwrap()}");
}

pub fn undo(state: &mut editor::State) {
    stop_for(state, "undo");
    stepped(state, "undo", history::undo(state));
}

pub fn redo(state: &mut editor::State) {
    stop_for(state, "redo");
    stepped(state, "redo", history::redo(state));
}

pub fn set_workspace(state: &mut editor::State, id: str) {
    state.workspace = id;
    state.tool = "select";
    signals::inspector(state);
    if id == "script" {
        open_doc(state, "script");
    } else {
        state.doctab = "scene";
        signals::inspector(state);
    }
    // A workspace is a set of open panels and nothing more: what it opens can
    // be closed again from a tab, and what it leaves out opened from the menu.
    docks::apply_workspace(state, id);
}

/// Show a document tab, opening it when it was closed.
pub fn open_doc(state: &mut editor::State, id: str) {
    if id == "script" {
        state.script_open = true;
        signals::bars(state);
    }
    if id == "events" {
        state.events_open = true;
        signals::bars(state);
    }
    state.doctab = id;
    signals::inspector(state);
}

/// Close a document tab; the scene is what is left.
pub fn close_doc(state: &mut editor::State, id: str) {
    if id == "script" {
        state.script_open = false;
        signals::bars(state);
    }
    if id == "events" {
        state.events_open = false;
        signals::bars(state);
    }
    if state.doctab == id {
        state.doctab = "scene";
        signals::inspector(state);
    }
}

// Show the code and the viewport at once, or go back to one at a time. The
// split is only ever drawn over a document, so turning it on opens one.
pub fn toggle_split(state: &mut editor::State) {
    state.split = !state.split;
    signals::bars(state);
    if state.split && state.doctab == "events" {
        state.doctab = "scene";
        signals::inspector(state);
    }
    // Under focus this is the reader asking for the scene back beside the
    // code, so the record goes rather than undoing it on the way out.
    drop_focus(state);
}

/// Select the first node in the scene carrying a script; whether it found one.
pub fn select_scripted(state: &mut editor::State) -> bool {
    for row in 0..state.nodes.len() {
        if !model::script_rel(state.nodes[row]).is_nil() {
            selection::only(state, row);
            return true;
        }
    }
    false
}

/// Whether there is code to give the window to: the selection's script, or a
/// shader opened from a material.
pub fn focus_target(state: editor::State) -> bool {
    state.shader_rel != "" || !model::script_rel(model::selected_node(state)).is_nil()
}

// The code with the window to itself: the three docks fold, the split goes,
// and the layout they were in is kept for the way back.
pub fn toggle_focus(state: &mut editor::State) {
    if state.focus {
        leave_focus(state);
        return;
    }
    if !focus_target(state) {
        log::warn("nothing to focus: the selection has no script");
        return;
    }
    let was = map().with("split", state.split);
    for side in docks::sides() {
        was.set(side, state.docks.get(side).shut);
        state.docks.get(side).shut = true;
        signals::docks(state);
    }
    state.focus_was = was;
    state.focus = true;
    state.split = false;
    signals::bars(state);
    open_doc(state, "script");
}

/// Put back the layout focus folded away. A record that is gone means a panel
/// was opened under it, and what is open now is what was asked for.
pub fn leave_focus(state: &mut editor::State) {
    let was = state.focus_was;
    state.focus = false;
    signals::bars(state);
    state.focus_was = nil;
    if was.kind() != "map" {
        return;
    }
    for side in docks::sides() {
        state.docks.get(side).shut = was.get(side).as_bool();
        signals::docks(state);
    }
    state.split = was.split.as_bool();
    signals::bars(state);
}

/// Forget the layout focus folded, without putting it back: a verb asked for
/// under focus wins over the record it would have restored.
pub fn drop_focus(state: &mut editor::State) {
    state.focus = false;
    signals::bars(state);
    state.focus_was = nil;
}

/// Whether focus still holds, asked once a frame before the centre is laid
/// out. A panel opened under it keeps its dock; leaving the code ends it.
pub fn keep_focus(state: &mut editor::State) {
    if !state.focus {
        return;
    }
    if !docks::all_folded(state) {
        drop_focus(state);
        return;
    }
    if state.doctab != "script" {
        leave_focus(state);
    }
}

pub fn set_zoom(state: &mut editor::State, zoom: float) {
    state.zoom = util::clamp(zoom, 25.0, 400.0);
    apply_camera(state);
}

pub fn open_palette(state: &mut editor::State, query: str) {
    state.palette = true;
    state.palette_query = query;
    // Dropped on every opening, so a component a reloaded plugin registered is
    // in the list the next time it is asked for.
    state.palette_cache = nil;
    window::picker_changed(state);
}

/// The reader asking for a scale, which outranks what the screen wanted.
pub fn ask_ui_scale(state: &mut editor::State, scale: float) {
    state.asked_scale = util::clamp(scale, 0.75, 2.5);
    set_ui_scale(state, state.asked_scale);
}

pub fn set_ui_scale(state: &mut editor::State, scale: float) {
    state.ui_scale = util::clamp(scale, 0.75, 2.5);
    ui::set_scale(state.ui_scale);
}

// What a finger needs, and the box the theme's `touch` tables state for a
// control. The scale is what makes the one the other, rounded up to 0.05.
pub const TOUCH_TARGET: float = 44.0;

pub const TOUCH_CONTROL: float = 33.0;

fn touch_scale() -> float {
    math::ceil(TOUCH_TARGET / TOUCH_CONTROL * 20.0) / 20.0
}

/// The scale this screen wants: what the reader set, and at least enough on a
/// touch screen that the smallest control clears a finger.
pub fn scale_for_screen(state: editor::State) -> float {
    let asked = state.asked_scale;
    let wanted = touch_scale();
    if state.touchscreen && asked < wanted {
        return wanted;
    }
    asked
}

pub fn close_palette(state: &mut editor::State) {
    state.palette = false;
    window::picker_shut(state);
}

pub fn toggle_play(state: &mut editor::State) {
    if state.playing {
        stop_play(state);
    } else {
        begin_play(state);
        // Recording starts before the scripts attach: an `init` that opens a
        // socket belongs inside the session, and one that takes an await
        // token has to take the id the replay will hand back.
        session::start(state);
        // Real play-in-editor: attach the game's scripts to the mirrored
        // nodes (their init sets up physics etc.), then run.
        model::attach_game_scripts(state);
        // The game looks through its own camera from here.
        model::hold_game_cameras(state, true);
        state.playing = true;
        signals::inspector(state);
        signals::changed(state, "debugger");
        docks::show(state, "output");
        // Physics and every animation player start next frame: the one a
        // session opens in is not recorded, so nothing may step in it.
        state.release_at = state.frame + 1;
        log::info("play: running " + state.game_name);
    }
}

/// Let the world step: what play and a replay both do the frame after they
/// start, so a replay's first frame is stepped exactly as the recording's was.
pub fn release_world(state: &mut editor::State) {
    if state.release_at < 0 || state.frame < state.release_at {
        return;
    }
    state.release_at = -1;
    physics::set_paused(false);
    // The scene was built with every player held (`model::build`); play is
    // what lets the engine advance them.
    anim::resume_all(state);
}

/// The scene as authored, built again for a game to run in: the world a
/// replay rebuilds, since a scene scrubbed or posed while editing is not
/// where a recording starts. What it is now is what stop builds again, and
/// nothing the game does is the edited scene's to undo.
pub fn begin_play(state: &mut editor::State) {
    history::commit(state);
    state.played = model::scene_text(state);
    model::build(state, state.played);
    scene::keep_changes(nil);
}

pub fn stop_play(state: &mut editor::State) {
    if state.playing {
        log::info("stop: scene reset");
    }
    // A stop in the frame play started must not release the rebuilt scene.
    state.release_at = -1;
    session::end(state, "stop");
    if state.played != "" {
        model::build(state, state.played);
        state.played = "";
    }
    state.playing = false;
    // The game may have restyled the viewport (background, camera).
    theme::apply(state);
    apply_camera(state);
}

// Viewport chip side effects (chips themselves live in center.bs).
pub fn on_chip(state: editor::State, workspace: str, key: str, value: bool) {
    if workspace == defs::WORKSPACE_PHYSICS && key == defs::CHIP_SLEEP {
        physics::set_sleeping_allowed(value);
    }
}

// The other half of the pair: chips that command the engine read their
// state back from it, so nothing is mirrored in `state.chip_state`. Nil for a
// chip the editor owns outright.
pub fn chip_value(state: editor::State, workspace: str, key: str) -> bool? {
    if workspace == defs::WORKSPACE_PHYSICS && key == defs::CHIP_SLEEP {
        return physics::sleeping_allowed();
    }
    nil
}

// Breakpoints are kept per game-relative script path; the host keys the
// same file by the absolute path play attaches it under.
pub fn breakpoint_lines(state: editor::State, rel: str) -> [int] {
    let lines: [int] = [];
    for line in util::vec(state.debug.breakpoints.get(rel)) {
        lines.push(line.as_int());
    }
    lines.sort();
    lines
}

pub fn toggle_breakpoint(state: &mut editor::State, rel: str, line: int) {
    let kept: [int] = [];
    let had = false;
    for breakpoint in breakpoint_lines(state, rel) {
        if breakpoint == line {
            had = true;
        } else {
            kept.push(breakpoint);
        }
    }
    if !had {
        kept.push(line);
    }
    // The host reports where each request landed: a blank line moves to the
    // next line with code.
    state.debug.breakpoints.set(rel, debugger::set_breakpoints(state.game_root + "/" + rel, kept));
}

// Game-relative path of a script the host reports by absolute key.
pub fn script_rel(state: editor::State, path: str) -> str {
    let prefix = state.game_root + "/";
    if path.starts_with(prefix) {
        return path.slice(prefix.len(), path.len());
    }
    path
}

// The pause is over the moment it is asked to go; the poll would only
// notice next frame, and a pause that follows at once must read as new.
pub fn resume(state: &mut editor::State, mode: str) {
    debugger::resume(mode);
    state.debug.paused = nil;
    signals::changed(state, "debugger");
}

/// Where a script is stopped, as the engine says it moved: a fresh stop shows
/// its script and frame, and the self-test's walk steps on from each one.
pub fn stopped(state: &mut editor::State, stop: any) {
    if stop.kind() == "map" && state.debug.paused.kind() != "map" {
        on_pause(state, stop);
    }
    state.debug.paused = stop;
    signals::changed(state, "debugger");
    if state.debug.demo.is_some() {
        let pauses = state.debug.demo.unwrap();
        if stop.kind() == "map" {
            state.debug.demo = pauses + 1;
            resume(state, if (pauses + 1) % 2 == 1 { debugger::STEP_OVER } else { debugger::CONTINUE });
        }
    }
}

// A fresh pause: show the script and the frame it stopped in.
pub fn on_pause(state: &mut editor::State, pause: any) {
    state.debug.paused_rel = script_rel(state, pause.path.as_str());
    state.debug.frame = 0;
    let stopped = pause.node.as_node();
    for row in 0..state.nodes.len() {
        let found = state.nodes[row];
        if found == stopped || model::script_rel(found).as_str() == state.debug.paused_rel {
            choose(state, row);
            break;
        }
    }
    set_workspace(state, defs::WORKSPACE_SCRIPT);
    docks::show(state, "debugger");
    log::info("paused at {state.debug.paused_rel}:{pause.line} ({pause.reason})");
}

/// A new `.bs` script: a class named after the file, `door_bell.bs` a
/// `DoorBell`, with the two hooks a node calls.
fn bs_template(rel: str) -> str {
    let name = util::class_of(rel);
    "pub class " + name + " {{\n    node: Node,\n}}\n\nimpl " + name + " {{\n    fn init() {{\n    }}\n\n    fn update(dt: float) {{\n    }}\n}}\n"
}

pub fn attach_script(state: &mut editor::State) {
    if !model::has_selection(state) {
        return;
    }
    let node = model::selected_node(state);
    if !model::script_rel(node).is_nil() {
        return;
    }
    set_script_path(state, "scripts/" + node.name().to_lower() + ".bs");
}

/// Every `.bs` under scripts/, for the inspector's picker.
pub fn script_files(state: &mut editor::State) -> [str] {
    let files: [str] = [];
    for file in model::list(state, "scripts") {
        if !file.is_dir.as_bool() && file.name.as_str().ends_with(".bs") {
            files.push("scripts/" + file.name.as_str());
        }
    }
    files.sort();
    files
}

/// Take the script off the selected node. The file stays.
pub fn detach_script(state: &mut editor::State) {
    if !model::has_selection(state) {
        return;
    }
    let node = model::selected_node(state);
    let rel = model::script_rel(node);
    if rel.is_nil() {
        return;
    }
    history::record(state, "detach script", nil);
    node.set_script(nil, nil);
    close_doc(state, "script");
    log::info("detached " + rel.as_str() + " (undo re-attaches it; the file stays)");
}

/// Point the selected node's script at `path`. An existing file is attached
/// as it is; a name nothing is at moves the current file there, or starts a
/// new one when the node had none.
pub fn set_script_path(state: &mut editor::State, path: str) {
    if !model::has_selection(state) {
        return;
    }
    let node = model::selected_node(state);
    let rel = path.trim();
    if rel == "" {
        return;
    }
    if !rel.ends_with(".bs") {
        rel = rel + ".bs";
    }
    let was = model::script_rel(node);
    if was.as_str() == rel {
        return;
    }
    let abs = state.game_root + "/" + rel;
    history::record(state, if was.is_nil() { "attach script" } else { "move script" }, nil);
    if !was.is_nil() {
        let old = was.as_str();
        let old_abs = state.game_root + "/" + old;
        if fs::exists(old_abs) && !fs::exists(abs) {
            // What is typed but unsaved goes with the file.
            let buffer = state.script_buffers.get(old_abs);
            if !buffer.is_nil() {
                fs::write(old_abs, buffer.as_str());
            }
            make_parent(state, rel);
            fs::rename(old_abs, abs);
            carry_script_state(state, old, rel);
            log::info("moved {old} to {rel}");
        }
    }
    if !fs::exists(abs) {
        make_parent(state, rel);
        fs::write(abs, bs_template(rel));
    }
    // The node keeps the properties it set over the exports.
    node.set_script(rel, model::script_props(node));
    model::forget(state, nil);
    state.script_open = true;
    signals::bars(state);
    lint::run(state);
    log::info("script: " + rel + " (undo puts it back)");
}

fn make_parent(state: editor::State, rel: str) {
    let parts = rel.split("/");
    if parts.len() <= 1 {
        return;
    }
    parts.pop();
    let dir = state.game_root + "/" + util::join(parts, "/");
    if !fs::exists(dir) {
        fs::create_directory(dir);
    }
}

// The editor's per-file state follows a moved file: its buffer, whether it
// is unsaved, and its breakpoints.
fn carry_script_state(state: &mut editor::State, old: str, rel: str) {
    let old_abs = state.game_root + "/" + old;
    let abs = state.game_root + "/" + rel;
    let buffer = state.script_buffers.get(old_abs);
    if !buffer.is_nil() {
        state.script_buffers.set(abs, buffer);
        state.script_buffers.remove(old_abs);
    }
    if state.script_dirty.has(old_abs) {
        state.script_dirty.remove(old_abs);
        signals::bars(state);
    }
    if state.debug.breakpoints.has(old) {
        let lines = breakpoint_lines(state, old);
        state.debug.breakpoints.remove(old);
        state.debug.breakpoints.set(rel, debugger::set_breakpoints(abs, lines));
    }
}

fn BASE_EYE() -> [float] {
    [9.0, 6.0, 13.0]
}

fn TARGET() -> [float] {
    [0.0, 1.0, 0.0]
}

pub fn apply_camera(state: &mut editor::State) {
    if model::is_2d(state) {
        // Keep the current pan; zoom in logical px per world unit.
        let at = render::camera_2d();
        render::set_camera_2d(at.x, at.y, 55.0 * state.zoom / 100.0);
        return;
    }
    let scale = 100.0 / state.zoom;
    render::set_camera(TARGET()[0] + (BASE_EYE()[0] - TARGET()[0]) * scale, TARGET()[1] + (BASE_EYE()[1] - TARGET()[1]) * scale, TARGET()[2] + (BASE_EYE()[2] - TARGET()[2]) * scale, TARGET()[0], TARGET()[1], TARGET()[2]);
}

// Draw what a shader's line computes, for every pixel that reaches it.
// Clicking the marked line again puts the picture back.
pub fn toggle_shader_preview(state: &mut editor::State, rel: str, line: int) {
    if state.preview_line == line && state.preview_rel == rel {
        state.preview_line = 0;
        state.preview_rel = "";
        render::set_shader_preview("", 0);
    } else {
        state.preview_line = line;
        state.preview_rel = rel;
        render::set_shader_preview(rel, line);
    }
}

// cmd+S saves the visible script buffer when the code editor is open, the
// scene document otherwise.
/// Jump to where the name at the caret is defined. A definition in the
/// project opens that file at its line; engine API has no file, so the Docs
/// dock shows its module instead.
pub fn goto_definition(state: &mut editor::State) {
    let node = model::selected_node(state);
    if model::script_rel(node).is_nil() {
        return;
    }
    let rel = model::script_rel(node).as_str();
    if rel == "" {
        return;
    }
    let source = buffer_of(state, rel);
    let index = state.complete.at_index;
    if index < 0 {
        return;
    }
    let at = complete::line_col(source, index);
    let found_or = script::definition(rel, source, at.line, at.col);
    if found_or.is_none() {
        return;
    }
    let found = found_or.unwrap();
    if found.file == "" {
        // The URL names the module page; the dock renders it from the live
        // engine, so no browser is opened for something the editor holds.
        let module = found.url.split("/");
        docs::show(state, module[module.len() - 1], "");
        return;
    }
    open_script_at(state, found.file, found.line);
}

/// The script at `rel` as it is open: its unsaved buffer, or the file.
fn buffer_of(state: &mut editor::State, rel: str) -> str {
    let buffer = state.script_buffers.get(state.game_root + "/" + rel);
    if buffer.is_nil() { model::source(state, rel).as_str() } else { buffer.as_str() }
}

/// Show `rel` in the code pane, scrolled to `line`.
pub fn open_script_at(state: &mut editor::State, rel: str, line: int) {
    for row in 0..state.nodes.len() {
        if model::script_rel(state.nodes[row]).as_str() == rel {
            selection::only(state, row);
            set_workspace(state, defs::WORKSPACE_SCRIPT);
            state.doctab = "script";
            signals::inspector(state);
            state.preview_line = line;
            return;
        }
    }
    log::info(rel + " is attached to no node in this scene");
}

/// Lay the visible script buffer out with the language's own formatter. A
/// shader is not a script, so it is left alone.
pub fn format_active(state: &mut editor::State) {
    if state.shader_rel != "" && state.doctab == "script" {
        return;
    }
    let node = model::selected_node(state);
    if model::script_rel(node).is_nil() {
        return;
    }
    let rel = model::script_rel(node).as_str();
    if rel == "" {
        return;
    }
    let abs = state.game_root + "/" + rel;
    let source = buffer_of(state, rel);
    let formatted = script::format(rel, source);
    if formatted == source {
        return;
    }
    state.script_buffers.set(abs, formatted);
    state.script_dirty.set(abs, true);
    lint::touched(state);
    signals::bars(state);
    // The code sheet writes its text again only when told the buffer moved.
    center::code_written(state);
    log::info("formatted " + rel);
}

pub fn save_active(state: &mut editor::State) {
    // A shader is not a script: it is written and the watcher relinks the
    // materials naming it, with no unit to rebuild.
    if state.shader_rel != "" && state.doctab == "script" {
        let abs = state.game_root + "/" + state.shader_rel;
        let buffer = state.script_buffers.get(abs);
        if !buffer.is_nil() {
            fs::write(abs, buffer.as_str());
            state.script_dirty.remove(abs);
            signals::bars(state);
            // The watcher covers the editor's own root, not the game's.
            assets::invalidate();
            log::info("saved " + state.shader_rel);
        }
        return;
    }
    let node = model::selected_node(state);
    let in_script = (state.workspace == defs::WORKSPACE_SCRIPT || state.doctab == "script") && !model::script_rel(node).is_nil();
    if in_script {
        let rel = model::script_rel(node).as_str();
        let abs = state.game_root + "/" + rel;
        let buffer = state.script_buffers.get(abs);
        if !buffer.is_nil() {
            fs::write(abs, buffer.as_str());
            model::forget(state, rel);
            state.script_dirty.remove(abs);
            signals::bars(state);
            // A recording cannot survive its own code changing: the frames
            // after a reload came from a different game. The session ends
            // here, and what it caught until now is kept.
            session::end(state, "reload");
            // The reload is also the compile: it builds the unit whether or
            // not the script is live, and leaves the old one running on a
            // failure, so a save that does not compile can say so.
            let err = engine::reload_script(abs);
            // A save is the one moment the whole project is known good or
            // not; the idle sweep only catches up to it.
            lint::run(state);
            if err == "" {
                log::info("saved " + rel);
            } else {
                say_failed(state, err);
            }
        }
        return;
    }
    // An external clip is its own file; an inline one rides along with the
    // scene. `anim::save` knows which it is looking at.
    anim::save(state);
    model::save(state);
}

/// Write a picture of the scene as a run of it draws it, at the project's
/// window size, from the files: the scene is written first, so the picture
/// is of what the editor shows. Where it landed is logged when it has.
pub fn write_picture(state: &mut editor::State) {
    model::write(state);
    let output = picture::write(state.game_root, state.scene_rel);
    if output.is_none() {
        log::warn("a picture is drawn by a second run of the game, which a browser tab cannot start");
        return;
    }
    log::info("drawing a picture of {state.scene_rel}");
}

/// A picture the second run finished, or why it could not.
pub fn picture_done(event: any) {
    if event.kind == "written" {
        log::info("wrote " + event.path.as_str());
    } else {
        log::warn("no picture: " + event.message.as_str());
    }
}

// Rebuild every attached script's unit from disk, the way a save does for the
// one file it wrote. A recording cannot span the change, so it ends first.
pub fn reload_scripts(state: &mut editor::State) {
    let paths = map();
    for found in state.nodes {
        let rel = model::script_rel(found);
        if !rel.is_nil() {
            paths.set(rel.as_str(), true);
        }
    }
    session::end(state, "reload");
    model::forget(state, nil);
    let done = 0;
    for rel in util::keys_sorted(paths) {
        let err = engine::reload_script(state.game_root + "/" + rel);
        if err == "" {
            done += 1;
        } else {
            say_failed(state, err);
        }
    }
    lint::run(state);
    log::info("reloaded {done} of {paths.len()} script(s)");
}

// A compile failure, a line at a time and against the game's own paths: the
// dock is narrow, and the absolute key it was given says nothing more.
fn say_failed(state: editor::State, err: str) {
    for line in err.split("\n") {
        log::error(line.replace(state.game_root + "/", ""));
    }
}

fn select_named(state: &mut editor::State, name: str) {
    for row in 0..state.nodes.len() {
        if state.nodes[row].name() == name {
            selection::only(state, row);
        }
    }
}

// One handler per start-up state, looked up rather than branched on, so a
// self-test or a plugin registers its own.
fn states() -> any {
    map()
        .with("palette", state_palette)
        .with("newnode", newnode::open)
        .with("test:picker", selftest::node_picker)
        .with("test:every_node", selftest::every_node)
        .with("test:rename", selftest::rename)
        .with("test:autosave", selftest::autosaving)
        .with("light", state_light)
        .with("dark", state_dark)
        .with("play", state_play)
        .with("input", state_input)
        .with("pose", state_animdemo)
        .with("test:layout", selftest::layout)
        .with("manager", manager::open)
        .with("examples", manager::open_examples)
        .with("about", about::open)
        .with("populate", populate::open)
        .with("theme", themewin::open)
        .with("engine", manager::open_versions)
        .with("newproject", manager::open_new)
        .with("versions", manager::open_versions)
        .with("test:manager", selftest::manager_screen)
        .with("test:start_screen", selftest::start_screen)
        .with("test:gestures", selftest::gestures)
        .with("font_sheet", state_fontdemo)
        .with("menu", state_menudemo)
        .with("test:undo", selftest::undo)
        .with("test:populate", selftest::populate)
        .with("test:marks", selftest::tree_marks)
        .with("breakpoint", break_demo)
        .with("test:rig", selftest::rigging)
        .with("test:polygons", selftest::polygons)
        .with("test:weights", selftest::weighting)
        .with("test:bone_map", selftest::bonemap_panel)
        .with("test:state_machine", statemachine::selftest)
        .with("test:ragdoll", selftest::physical_bones)
        .with("test:physics", selftest::physics_panel)
        .with("test:deselect", selftest::deselected)
        .with("test:viewport_clicks", selftest::viewport_clicks)
        .with("test:camera", selftest::camera_keeps_pointer)
        .with("test:tiles", selftest::tiles_tool)
        .with("test:clipboard", selftest::clipboard)
        .with("test:assets", selftest::assets)
        .with("test:imports", selftest::imports)
        .with("test:picking", selftest::picking)
        .with("test:script_props", selftest::script_props)
        .with("test:composite_props", selftest::composite_props)
        .with("test:record_assets", selftest::record_assets)
        .with("test:system_fonts", selftest::system_fonts)
        .with("test:font_catalogue", selftest::font_catalogue)
        .with("test:script_paths", selftest::script_paths)
        .with("test:instances", selftest::instances)
        .with("test:timings", selftest::timings)
        .with("test:profiler", selftest::profiler)
        .with("test:placing", selftest::placing)
        .with("test:lint", selftest::linting)
        .with("test:tools", selftest::tooling)
        .with("test:recordings", selftest::sessions)
        .with("test:theme_switch", selftest::theme_switch)
        .with("test:theme_editing", selftest::theme_editing)
        .with("test:sheet_close", selftest::sheet_closing)
        .with("test:settings", selftest::settings_screen)
        .with("test:export_runtime", selftest::export_runtime)
        .with("test:panels", selftest::menu_panels)
        .with("test:palette", selftest::palette_screen)
        .with("test:focus", selftest::focusing)
        .with("focus", state_focus)
        .with("test:selection", selftest::selecting)
        .with("test:drop", selftest::dropping)
        .with("test:events", selftest::eventviews)
        .with("test:library", selftest::librarydemo)
        .with("test:rows", selftest::row_views)
        .with("test:pool", selftest::pool_kinds)
        .with("test:camera_document", selftest::camera_document)
        .with("test:picture", selftest::picture)
        .with("test:warnings", selftest::warning_marks)
        .with("test:recipes", selftest::soft_recipes)
        .with("test:change_types", selftest::change_types)
        .with("test:import_job", selftest::importing)
        .with("test:pen", selftest::pendemo)
        // The editor's half of the plugin seam; `counter.bs` registers the
        // plugin's half under the same name and both run.
        .with("test:plugin_docks", selftest::plugin_docks)
        .with("settings", settings::open)
        .with("export", exporter::open)
}

// States written `<prefix><argument>`, which take the rest of the string.
fn prefixed_states() -> [Prefixed] {
    [
        Prefixed { prefix: "find:", run: state_find },
        Prefixed { prefix: "suite:", run: suite::begin },
        Prefixed { prefix: "settings_search:", run: state_settings_search },
        Prefixed { prefix: "settings:", run: state_settings },
        Prefixed { prefix: "theme:", run: state_theme },
        Prefixed { prefix: "wear:", run: state_wear },
        Prefixed { prefix: "override:", run: state_override },
        Prefixed { prefix: "frames:", run: state_frames },
        Prefixed { prefix: "show:", run: state_show },
        Prefixed { prefix: "tool:", run: state_tool },
        Prefixed { prefix: "tiles:", run: state_tiles },
        Prefixed { prefix: "page:", run: state_page },
        Prefixed { prefix: "palette:", run: state_palette_query },
        Prefixed { prefix: "dock:", run: state_dock },
        Prefixed { prefix: "view:", run: state_view },
        Prefixed { prefix: "asset:", run: state_asset },
        Prefixed { prefix: "import:", run: state_import },
        Prefixed { prefix: "imports:", run: state_imports },
        Prefixed { prefix: "tab:", run: state_tab },
        Prefixed { prefix: "shut:", run: state_shut },
        Prefixed { prefix: "scale:", run: state_scale },
        Prefixed { prefix: "move:", run: state_move },
        Prefixed { prefix: "mode:", run: state_mode },
        Prefixed { prefix: "select:", run: state_select },
        Prefixed { prefix: "add:", run: state_add },
        Prefixed { prefix: "zoom:", run: state_zoom },
    ]
}

// `focus`: the shell folded round the code, over the first scripted node when
// the selection has none of its own.
fn state_focus(state: &mut editor::State) {
    if !focus_target(state) {
        select_scripted(state);
    }
    toggle_focus(state);
}

fn state_settings(state: &mut editor::State, category: str) {
    settings::open_at(state, category);
}

// `theme:controls` opens the theme window on a page, and `theme:controls:tab`
// with that role picked.
// `wear:<name>` wears a theme for this run, leaving the setting alone.
fn state_wear(state: &mut editor::State, name: str) {
    theme::use_named(state, name);
}

fn state_theme(state: &mut editor::State, arg: str) {
    let parts = arg.split(":");
    let path = if parts.len() > 1 { ["roles", parts[1]] } else { [] };
    themewin::open_at(state, parts[0], path);
}

fn state_settings_search(state: &mut editor::State, query: str) {
    settings::open_search(state, query);
}

// `override:<tag>` picks the settings page's override target, for a screenshot
// of the rows that add one.
fn state_override(state: &mut editor::State, tag: str) {
    state.settings.target = tag;
}

// `find:<query>` fills the scene tree's search, for a screenshot.
fn state_find(state: &mut editor::State, query: str) {
    let panel = scene::get_node("Editor/Shell/Body/Left/LeftSheet/SceneTree");
    if panel.is_valid() {
        panel.call("find", query);
    }
}

// One start-up state, mirroring the design prototype's startWorkspace prop. A
// plugin may extend a built-in state rather than replace it, so both run.
pub fn apply_start_state(state: &mut editor::State, start: str) {
    for one in prefixed_states() {
        if start.starts_with(one.prefix) {
            let run = one.run;
            run(state, start.slice(one.prefix.len(), start.len()));
            return;
        }
    }
    let ran = false;
    let found = states().get(start);
    if !found.is_nil() {
        let run: fn(&mut editor::State) = found;
        run(state);
        ran = true;
    }
    if plugins::has_start_state(state, start) {
        plugins::run_start_state(state, start);
        ran = true;
    }
    if ran || start == "" {
        return;
    }
    for workspace in defs::workspaces() {
        if workspace.id == start {
            state_workspace(state, start);
            return;
        }
    }
    log::error("--state names '{start}', which is no state");
}

/// `view:<panel>` brings one panel up and reports the rect it was drawn in,
/// so a design pass can cut it out of the shot and look at it on its own.
///
/// The rect is logged rather than cropped here: the renderer saves whole
/// frames, and the last line a run logs is all a script needs to cut them up.
fn state_view(state: &mut editor::State, id: str) {
    docks::show(state, id);
    state.view_shot = id;
}

// Every other frame from frame 30, so a clip is 30 fps and skips the frames
// the layout takes to settle.
fn state_frames(state: &mut editor::State, spec: str) {
    // `dir` or `dir:from:every`; the default skips the start-up frames a
    // showcase clip does not want, and `0:1` is how the start-up is watched.
    let parts = spec.split(":");
    let dir = parts[0];
    let from = if parts.len() > 1 { parts[1].parse_int() } else { 30 };
    let every = if parts.len() > 2 { util::imax(parts[2].parse_int(), 1) } else { 2 };
    // No `fs::create_directory` here: the directory is the caller's, outside every root
    // `fs` may reach, and the screenshot makes it on the way past.
    state.capture = Capture { dir: dir, from: from, every: every, count: 0 };
}

fn state_input(state: &mut editor::State) {
    state.show_input = true;
    signals::changed(state, "inputview");
}

fn state_show(state: &mut editor::State, name: str) {
    showcase::start(state, name);
}

/// Pick a viewport tool. The Tiles tool brings its palette forward with it:
/// there is nothing to paint with until a tile is chosen.
pub fn set_tool(state: &mut editor::State, tool: str) {
    state.tool = tool;
    signals::inspector(state);
    if tool == "tiles" {
        docks::show(state, "tiles");
    }
}

fn state_tool(state: &mut editor::State, tool: str) {
    set_tool(state, tool);
}

// `tab:<id>` picks a document tab; `tab:split` opens the code beside the
// viewport. Both are shell state a screenshot cannot otherwise reach.
fn state_tab(state: &mut editor::State, tab: str) {
    if tab == "split" {
        state.split = true;
        signals::bars(state);
    } else {
        state.doctab = tab;
        signals::inspector(state);
    }
}

// `page:<dock>/<name>`: the page a plugin dock's sidebar is on, which the kit
// remembers per dock. The one way in from outside it.
fn state_page(state: &mut editor::State, arg: str) {
    let parts = arg.split("/");
    if parts.len() < 2 {
        return;
    }
    if state.kit_state.is_nil() {
        state.kit_state = map();
    }
    state.kit_state.set("tab:" + parts[0], parts[1]);
}

fn state_fontdemo(state: &mut editor::State) {
    state.fontdemo = true;
    selftest::font_sheet(state);
}

fn state_menudemo(state: &mut editor::State) {
    state.menu_open = true;
    signals::bars(state);
}

// `scale:<f>`: the UI scale, which is what decides how many design pixels the
// window has. A narrow layout is reachable no other way from a fixed capture.
fn state_scale(state: &mut editor::State, arg: str) {
    set_ui_scale(state, arg.parse_float());
}

fn state_shut(state: &mut editor::State, side: str) {
    if side == "rail" {
        state.rail_shut = true;
        signals::bars(state);
        return;
    }
    // Everything the shell draws over the scene: the chip strip and the
    // reading at its foot. What a picture of the scene itself wants.
    if side == "chrome" {
        state.chrome_off = true;
        return;
    }
    state.docks.get(side).shut = true;
    signals::docks(state);
}

// `move:<panel>:<side>`: put a panel in another dock, as its tab menu does.
fn state_move(state: &mut editor::State, arg: str) {
    let parts = arg.split(":");
    if parts.len() == 2 {
        docks::move_to(state, parts[0], parts[1]);
    }
}

fn state_dock(state: &mut editor::State, dock: str) {
    docks::show(state, dock);
}

// Self-test state: open the Assets dock on a file, which is what the Import
// section draws for (e.g. asset:art/limb.png).
fn state_asset(state: &mut editor::State, rel: str) {
    docks::show(state, "assets");
    let leaf = util::leaf(rel);
    state.assets.dir = if leaf.len() < rel.len() { rel.slice(0, rel.len() - leaf.len() - 1) } else { "" };
    state.assets.sel = rel;
    signals::changed(state, "assets");
}

// `import:<path>`: the Assets dock, and that file imported into it.
fn state_import(state: &mut editor::State, path: str) {
    docks::show(state, "assets");
    dropin::take(state, path);
}

// `imports:<path>;<path>`: several imports, one a frame once the shell has
// formed, so a picture has the list of all of them.
fn state_imports(state: &mut editor::State, list: str) {
    docks::show(state, "assets");
    state.import_queue = list.split(";");
    state.import_drip = true;
}

fn state_mode(state: &mut editor::State, mode: str) {
    polygon::set_mode(state, mode);
}

// `tiles:<mode>`: the Tiles dock on one of its tools, and `tiles:set` on the
// rows that edit the tile itself.
fn state_tiles(state: &mut editor::State, mode: str) {
    docks::show(state, "tiles");
    if mode == "set" {
        state.tiles.editing = true;
        signals::changed(state, "tiles");
        return;
    }
    tiles::set_mode(state, mode);
}

// Self-test state: select a node by name (e.g. select:Pig1).
fn state_select(state: &mut editor::State, name: str) {
    select_named(state, name);
}

// `add:text2d` adds what the node picker's row of that name adds, under the
// selection.
fn state_add(state: &mut editor::State, kind: str) {
    newnode::add(state, kind);
}

fn state_zoom(state: &mut editor::State, pct: str) {
    set_zoom(state, pct.parse_float());
}

fn state_palette(state: &mut editor::State) {
    open_palette(state, "");
}

// `palette:<query>`: the palette open on what it matches, for a screenshot.
fn state_palette_query(state: &mut editor::State, query: str) {
    open_palette(state, query);
}

fn state_light(state: &mut editor::State) {
    theme::set_dark(state, false);
}

fn state_dark(state: &mut editor::State) {
    theme::set_dark(state, true);
}

fn state_play(state: &mut editor::State) {
    toggle_play(state);
}

// Self-test state: author a clip on the Spinner, otherwise on any node.
fn state_animdemo(state: &mut editor::State) {
    let pick: int? = nil;
    for row in 0..state.nodes.len() {
        if pick.is_none() || state.nodes[row].name() == "Spinner" {
            pick = row;
        }
    }
    if pick.is_none() {
        log::warn("animdemo: the scene has no node to animate");
    } else {
        let row = pick.unwrap();
        selection::only(state, row);
        anim::ensure_clip(state);
        anim::add_key(state, 0.0);
        let found = model::selected_node(state);
        if found.is_valid() {
            found.transform.position = Vec3 { x: 2.5, y: 2.5, z: 0.0 };
            found.transform.rotation_euler = Vec3 { x: 0.0, y: math::to_radians(180.0), z: 0.0 };
            anim::add_key(state, 1.0);
            found.transform.position = Vec3 { x: 2.5, y: 0.5, z: 0.0 };
            anim::add_key(state, 2.0);
            anim::seek(state, 0.6);
        }
    }
    set_workspace(state, defs::WORKSPACE_ANIMATION);
}

// A bare name is a workspace; the script workspace also picks a scripted node so
// the centre pane has something to show.
fn state_workspace(state: &mut editor::State, name: str) {
    set_workspace(state, name);
    if name == "script" {
        select_scripted(state);
    }
}

// Self-test state: a breakpoint on the first scripted node's update, then
// play; `update` alternates a step and a continue on every pause.
pub fn break_demo(state: &mut editor::State) {
    for row in 0..state.nodes.len() {
        let script = model::script_rel(state.nodes[row]);
        if !script.is_nil() {
            selection::only(state, row);
            for hook in model::hooks(state, script.as_str()) {
                if hook.name.as_str() == "update" {
                    toggle_breakpoint(state, script.as_str(), hook.line.as_int() + 1);
                }
            }
            break;
        }
    }
    state.debug.demo = 0;
    toggle_play(state);
}
