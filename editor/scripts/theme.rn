// The look lives in `themes/*.toml`, not here: colour tokens and the named
// roles a widget takes with `role:`. This module only loads one and applies it.

use crate::util;

/// A theme asset, flattened into the shape `ui::set_theme` and every script's
/// `k.<token>` lookup both want.
pub fn load(name) {
    let doc = toml::parse(fs::read("themes/" + name + ".toml"));
    let t = #{ dark: doc.dark, roles: doc.roles };
    for (key, value) in doc.colors {
        t[key] = value;
    }
    t
}

pub fn dark() {
    load("dark")
}

pub fn light() {
    load("light")
}

// Push the active theme into egui and the 3D viewport.
pub fn apply(S) {
    let t = S.theme;
    ui::set_theme(t);
    let (r, g, b) = util::hex_to_rgb(t.bg);
    render::set_background(r, g, b);
    let (mr, mg, mb) = util::hex_to_rgb(t.grid);
    let (jr, jg, jb) = util::hex_to_rgb(t.grid_major);
    render::set_grid_colors(mr, mg, mb, jr, jg, jb);
}

pub fn set_dark(S, dark) {
    S.theme = if dark { dark() } else { light() };
    apply(S);
}
