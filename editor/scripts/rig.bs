// Rigging: bones drawn as diamonds (2D) or octahedra (3D), the Rig bone tool
// that grows a chain, and the two rest-pose verbs. A bone is a node with
// `bone2d` or `bone3d`; this module only reads and writes those.

use defs;
use editor;
use gizmo;
use history;
use model;
use polygon;
use selection;
use shell;
use util;
use viewport;

pub class RigState {
    hover: int?,
    drag: int?,
}

pub struct Geometry {
    origin: [float],
    tip: [float],
}

pub struct ModifierReach {
    chain: [int],
    target: [float]?,
    kind: any,
}

/// The parts of a transform a write sets; an empty one is left alone.
pub struct Parts {
    position: [float],
    rotation_euler: [float],
    scale: [float],
}

pub struct Was {
    index: int,
    key: str,
    data: any,
}

/// The rig tool's own state, hung on `state.rig`. `drag` is the modifier target
/// handle being moved.
pub fn state() -> RigState {
    RigState { hover: nil, drag: nil }
}

const LINE_WIDTH: float = 2.4;

// A tip bone with no length set still needs a diamond to pick.
const TIP_LENGTH: float = 0.35;

const PICK_PIXELS: float = 10.0;

// A bone name is drawn at this many font pixels to the world unit, lifted
// clear of the joint it names.
const LABEL_PIXELS_PER_UNIT: float = 90.0;

const LABEL_LIFT: float = 0.12;

// The modifier target handle, in design px, and the width its chain is drawn
// at: heavier than a bone, because it sits on top of one.
const HANDLE_PIXELS: float = 7.0;

const CHAIN_WIDTH: float = 3.6;

pub fn is_bone(found: Node) -> bool {
    found.is_valid() && (found.has_component("bone2d") || found.has_component("bone3d"))
}

/// The bone component as the node asks for it.
fn bone_data(found: Node) -> any {
    util::map_or_empty(found.authored(if found.has_component("bone2d") { "bone2d" } else { "bone3d" }))
}

fn first_child_bone(state: editor::State, row: int) -> int? {
    let found = model::node(state, row);
    if !found.is_valid() {
        return nil;
    }
    for child in found.children() {
        if is_bone(child) {
            return model::index_of_node(state, child);
        }
    }
    nil
}

// A bone's world geometry: its origin and the tip its diamond points at —
// the first child bone, or `length` along `angle` for a tip bone.
pub fn geometry(state: editor::State, row: int) -> Geometry? {
    let found = model::node(state, row);
    if !is_bone(found) {
        return nil;
    }
    let origin = found.transform.global_position();
    let child = first_child_bone(state, row);
    let child_ref: Node = nil;
    if child.is_some() {
        child_ref = model::node(state, child.unwrap());
    }
    let tip = if child_ref.is_valid() {
        util::xyz(child_ref.transform.global_position())
    } else {
        let bone = bone_data(found);
        let length = bone.length.as_float();
        if length <= 0.0 {
            length = TIP_LENGTH;
        }
        let angle = found.transform.global_rotation_euler().z + bone.angle.as_float();
        let scale_x = found.transform.global_scale().x;
        // A 3D tip bone points along its own y, the way an imported joint
        // chain grows; a 2D one along `angle`.
        if found.has_component("bone3d") {
            [origin.x, origin.y + length * scale_x, origin.z]
        } else {
            [origin.x + math::cos(angle) * length * scale_x, origin.y + math::sin(angle) * length * scale_x, origin.z]
        }
    };
    Geometry { origin: util::xyz(origin), tip: tip }
}

// How far a point is from a bone's spine — what a weight by distance and
// the viewport's own picking both measure.
pub fn segment_distance(point: [float], from: [float], to: [float]) -> float {
    let span_x = to[0] - from[0];
    let span_y = to[1] - from[1];
    let length_squared = span_x * span_x + span_y * span_y;
    let fraction = 0.0;
    if length_squared > 1e-9 {
        fraction = util::clamp(((point[0] - from[0]) * span_x + (point[1] - from[1]) * span_y) / length_squared, 0.0, 1.0);
    }
    let closest_x = from[0] + span_x * fraction;
    let closest_y = from[1] + span_y * fraction;
    math::sqrt((point[0] - closest_x) * (point[0] - closest_x) + (point[1] - closest_y) * (point[1] - closest_y))
}

// The bone under the cursor: the one whose diamond's spine is nearest,
// within a screen-space radius.
pub fn pick(state: editor::State, world_x: any, world_y: any) -> int? {
    let best: int? = nil;
    let best_distance = PICK_PIXELS * viewport::world_per_pixel(state);
    for row in 0..state.nodes.len() {
        if is_bone(state.nodes[row]) {
            let spine_or = geometry(state, row);
            if spine_or.is_some() {
                let spine = spine_or.unwrap();
                let distance = segment_distance([world_x.as_float(), world_y.as_float()], spine.origin, spine.tip);
                if distance < best_distance {
                    best = row;
                    best_distance = distance;
                }
            }
        }
    }
    best
}

// The bone under the cursor in a 3D viewport: nearest projected spine, in
// design px. `project(point)` is the 3D gizmo's, handed in so this module
// stays free of camera math.
pub fn pick_3d(state: editor::State, pointer_x: float, pointer_y: float, camera: gizmo::Camera) -> int? {
    let best: int? = nil;
    let best_distance = PICK_PIXELS;
    for row in 0..state.nodes.len() {
        if is_bone(state.nodes[row]) {
            let spine_or = geometry(state, row);
            if spine_or.is_some() {
                let spine = spine_or.unwrap();
                let origin_or = gizmo::project(camera, spine.origin);
                if origin_or.is_some() {
                    let origin_x = origin_or.unwrap().x;
                    let origin_y = origin_or.unwrap().y;
                    let tip_or = gizmo::project(camera, spine.tip);
                    if tip_or.is_some() {
                        let tip_x = tip_or.unwrap().x;
                        let tip_y = tip_or.unwrap().y;
                        let distance = segment_distance([pointer_x, pointer_y], [origin_x, origin_y], [tip_x, tip_y]);
                        if distance < best_distance {
                            best = row;
                            best_distance = distance;
                        }
                    }
                }
            }
        }
    }
    best
}

fn line(from: [float], to: [float], color: [float]) {
    render::draw_line_2d(from[0], from[1], to[0], to[1], color[0], color[1], color[2], LINE_WIDTH);
}

// Godot's bone: a diamond from origin to tip, widest a fifth of the way.
fn draw_bone(state: editor::State, spine: Geometry, color: [float]) {
    let span_x = spine.tip[0] - spine.origin[0];
    let span_y = spine.tip[1] - spine.origin[1];
    let length = math::sqrt((span_x * span_x + span_y * span_y).as_float());
    if length < 1e-6 {
        return;
    }
    let normal_x = (-span_y).as_float() / length;
    let normal_y = span_x.as_float() / length;
    let half = util::min(0.12 * length, 6.0 * viewport::world_per_pixel(state));
    let waist_x = spine.origin[0].as_float() + span_x.as_float() * 0.2;
    let waist_y = spine.origin[1].as_float() + span_y.as_float() * 0.2;
    let left = [waist_x + normal_x * half, waist_y + normal_y * half];
    let right = [waist_x - normal_x * half, waist_y - normal_y * half];
    line(spine.origin, left, color);
    line(left, spine.tip, color);
    line(spine.tip, right, color);
    line(right, spine.origin, color);
}

// A 3D bone: an octahedron from origin to tip, its waist a fifth of the way.
fn draw_bone_3d(spine: Geometry, color: [float]) {
    let span = util::vector_subtract(spine.tip, spine.origin);
    let span_unit = util::vector_normalise(span);
    let length = span_unit.length;
    if length.as_float() < 1e-6 {
        return;
    }
    // Two directions across the bone: any vector not along it, crossed.
    let across = if util::abs(span[2].as_float()) > 0.9 * length.as_float() {
        [1.0, 0.0, 0.0]
    } else {
        [0.0, 0.0, 1.0]
    };
    let first_unit = util::vector_normalise(util::vector_cross(span, across));
    let first_side = first_unit.direction;
    let second_unit = util::vector_normalise(util::vector_cross(span, first_side));
    let second_side = second_unit.direction;
    let half = 0.1 * length.as_float();
    let waist_centre = util::vector_add(spine.origin, util::vector_scale(span, 0.2));
    let waist = [
        util::vector_add(waist_centre, util::vector_scale(first_side, half)),
        util::vector_add(waist_centre, util::vector_scale(second_side, half)),
        util::vector_subtract(waist_centre, util::vector_scale(first_side, half)),
        util::vector_subtract(waist_centre, util::vector_scale(second_side, half)),
    ];
    for corner in 0..waist.len() {
        let waist_point = waist[corner];
        let next_point = waist[(corner + 1) % 4];
        render::draw_line_3d(spine.origin[0].as_float(), spine.origin[1].as_float(), spine.origin[2].as_float(), waist_point[0].as_float(), waist_point[1].as_float(), waist_point[2].as_float(), color[0], color[1], color[2], LINE_WIDTH);
        render::draw_line_3d(waist_point[0].as_float(), waist_point[1].as_float(), waist_point[2].as_float(), spine.tip[0].as_float(), spine.tip[1].as_float(), spine.tip[2].as_float(), color[0], color[1], color[2], LINE_WIDTH);
        render::draw_line_3d(waist_point[0].as_float(), waist_point[1].as_float(), waist_point[2].as_float(), next_point[0].as_float(), next_point[1].as_float(), next_point[2].as_float(), color[0], color[1], color[2], LINE_WIDTH);
    }
}

// Every bone, whenever rigging is what the user is doing: the Animate
// workspace, the tool, or a selected bone.
pub fn draw(state: editor::State) {
    let selected_bone = is_bone(model::selected_node(state));
    let show = state.workspace == defs::WORKSPACE_ANIMATION || state.tool == "bone" || selected_bone;
    if !show {
        return;
    }
    let tokens = state.theme;
    let bone_ink = util::rgb(tokens.get("node_bone").as_str());
    let accent = util::rgb(tokens.get("primary_text").as_str());
    for row in 0..state.nodes.len() {
        let node = state.nodes[row];
        if is_bone(node) {
            let spine_or = geometry(state, row);
            if spine_or.is_some() {
                let spine = spine_or.unwrap();
                let color = if state.rig.hover == row {
                    viewport::hover_color()
                } else if row == state.selected {
                    accent
                } else {
                    bone_ink
                };
                if state.mode2d {
                    draw_bone(state, spine, color);
                } else {
                    draw_bone_3d(spine, color);
                }
                label_bone(state, row, node, spine, color);
            }
        }
    }
    draw_modifiers(state);
}

// The `modifier2d` or `modifier3d` table on a node, or `None`.
pub fn modifier(found: Node) -> any {
    if !found.is_valid() {
        return nil;
    }
    for key in ["modifier2d", "modifier3d"] {
        if found.has_component(key) {
            return util::map_or_empty(found.authored(key));
        }
    }
    nil
}

// What a modifier reaches for and with: the world point of its target, and
// the bones it actually solves, which `chain` makes a number not a shape.
fn modifier_reach(state: editor::State, row: int) -> ModifierReach? {
    let modifier_or = modifier(model::node(state, row));
    if modifier_or.is_nil() {
        return nil;
    }
    let modifier_component = modifier_or;
    if modifier_component.get("enabled") == false {
        return nil;
    }
    let found = model::node(state, row);
    if !found.is_valid() {
        return nil;
    }
    let bone_path = modifier_component.get("bone").as_str();
    let driven = if bone_path == "" { found } else { found.get_node(bone_path) };
    if !driven.is_valid() {
        return nil;
    }
    let target_path = modifier_component.get("target").as_str();
    let target: Node = nil;
    if target_path != "" {
        target = found.get_node(target_path);
    }
    let chain: [int] = [];
    let at = model::index_of_node(state, driven);
    let limit = util::max(1, (modifier_component.get("chain_count").as_float() as int));
    let authored_kind = modifier_component.get("kind");
    let kind = if authored_kind.is_nil() { animation::MODIFIER_LOOK_AT } else { authored_kind };
    // `look_at` drives one bone whatever the chain says; `two_bone_ik` is
    // three by definition. The rest walk as far as `chain` allows.
    let walk = if kind == animation::MODIFIER_LOOK_AT {
        1
    } else if kind == animation::MODIFIER_TWO_BONE_IK {
        3
    } else {
        if modifier_component.get("chain_count").as_float() > 0.0 {
            limit
        } else {
            64
        }
    };
    while at.is_some() && chain.len() < walk {
        let index = at.unwrap();
        chain.push(index);
        at = first_child_bone(state, index);
    }
    ModifierReach {
        chain: chain,
        target: if target.is_valid() { util::xyz(target.transform.global_position()) } else { nil },
        kind: kind,
    }
}

// Every enabled modifier's reach, over the bones already drawn: the chain in
// the modifier's own colour, a line from its last bone to the target, and a
// handle at the target itself.
fn draw_modifiers(state: editor::State) {
    let tokens = state.theme;
    let color = util::rgb(tokens.get("node_modifier").as_str());
    for row in 0..state.nodes.len() {
        let reach_or = modifier_reach(state, row);
        if reach_or.is_none() {
            continue;
        }
        let reach = reach_or.unwrap();
        let last: [float]? = nil;
        for index in reach.chain {
            let spine_or = geometry(state, index);
            if spine_or.is_none() {
                continue;
            }
            let spine = spine_or.unwrap();
            line_at(state, spine.origin, spine.tip, color, CHAIN_WIDTH);
            last = spine.tip;
        }
        if reach.target.is_none() {
            continue;
        }
        let target = reach.target.unwrap();
        // A jiggle has no target; every other kind reaches for one, and the
        // line is what says which bone is doing the reaching.
        if last.is_some() {
            dashed(state, last.unwrap(), target, color);
        }
        handle(state, target, if state.rig.drag == row { viewport::hover_color() } else { color });
    }
}

// A line in whichever layer the viewport is drawing: the 2D pass has its own,
// and a 3D line in a 2D scene lands where nothing is looking.
fn line_at(state: editor::State, from: [float], to: [float], color: [float], width: float) {
    if state.mode2d {
        render::draw_line_2d(from[0], from[1], to[0], to[1], color[0], color[1], color[2], width);
    } else {
        render::draw_line_3d(from[0], from[1], from[2], to[0], to[1], to[2], color[0], color[1], color[2], width);
    }
}

// A dashed run, so a modifier's reach reads differently from a bone.
fn dashed(state: editor::State, from: [float], to: [float], color: [float]) {
    let steps = 9;
    for step in 0..steps {
        if step % 2 == 1 {
            continue;
        }
        let from_fraction = step.as_float() / steps.as_float();
        let to_fraction = (step + 1).as_float() / steps.as_float();
        line_at(state, along(from, to, from_fraction), along(from, to, to_fraction), color, LINE_WIDTH);
    }
}

// The point `fraction` of the way from `from` to `to`.
fn along(from: [float], to: [float], fraction: float) -> [float] {
    [from[0] + (to[0] - from[0]) * fraction, from[1] + (to[1] - from[1]) * fraction, from[2] + (to[2] - from[2]) * fraction]
}

// A ring with a cross through it at the target, big enough to grab.
fn handle(state: editor::State, point: [float], color: [float]) {
    let radius = HANDLE_PIXELS * viewport::world_per_pixel(state);
    let sides = 12;
    for side in 0..sides {
        line_at(state, ring_at(point, radius, side, sides), ring_at(point, radius, side + 1, sides), color, LINE_WIDTH);
    }
    line_at(state, [point[0] - radius, point[1], point[2]], [point[0] + radius, point[1], point[2]], color, LINE_WIDTH);
    line_at(state, [point[0], point[1] - radius, point[2]], [point[0], point[1] + radius, point[2]], color, LINE_WIDTH);
}

// Point `side` of `sides` around a ring of radius `radius` about `centre`.
fn ring_at(centre: [float], radius: float, side: int, sides: int) -> [float] {
    let angle = math::PI * 2.0 * side.as_float() / sides.as_float();
    [centre[0] + math::cos(angle) * radius, centre[1] + math::sin(angle) * radius, centre[2]]
}

// The modifier whose target handle is under the cursor, for dragging it.
pub fn pick_handle(state: editor::State, world_x: any, world_y: any) -> int? {
    let best: int? = nil;
    let best_distance = HANDLE_PIXELS * 1.6 * viewport::world_per_pixel(state);
    for row in 0..state.nodes.len() {
        let found_or = modifier_reach(state, row);
        if found_or.is_none() {
            continue;
        }
        let found = found_or.unwrap();
        if found.target.is_some() {
            let point = found.target.unwrap();
            let distance = math::sqrt(((point[0] - world_x) * (point[0] - world_x) + (point[1] - world_y) * (point[1] - world_y)).as_float());
            if distance < best_distance {
                best = row;
                best_distance = distance;
            }
        } else {
            nil
        }
    }
    best
}

// Move a modifier's target node, which is what dragging its handle means:
// the modifier itself has no position, and the node it aims at does.
pub fn drag_handle(state: &mut editor::State, row: int, world_x: float, world_y: float) {
    let found = model::node(state, row);
    let modifier_component = modifier(found);
    if modifier_component.is_nil() || !found.is_valid() {
        return;
    }
    let target = found.get_node(modifier_component.target.as_str());
    if !target.is_valid() {
        return;
    }
    let at = model::index_of_node(state, target);
    if at.is_none() {
        return;
    }
    history::record(state, "move modifier target", "rig:target:{row}");
    // The click is in world space; a target under a moved parent has to take
    // it in that parent's frame, the way `add_bone` places a bone.
    let local = in_frame(target.parent(), world_x, world_y);
    let depth = model::transform_part(target, "position", [0.0, 0.0, 0.0])[2];
    model::set_transform(state, at.unwrap(), Parts { position: [local.x, local.y, depth], rotation_euler: [], scale: [] });
}

// A world point in `parent`'s own frame: what a child placed there holds.
fn in_frame(parent: Node, world_x: float, world_y: float) -> Vec2 {
    if !parent.is_valid() {
        return Vec2 { x: world_x, y: world_y };
    }
    let origin = parent.transform.global_position();
    let angle = parent.transform.global_rotation_euler().z;
    let parent_scale = parent.transform.global_scale();
    let offset_x = world_x - origin.x;
    let offset_y = world_y - origin.y;
    let cosine = math::cos(angle);
    let sine = math::sin(angle);
    Vec2 {
        x: (cosine * offset_x + sine * offset_y) / (if util::abs(parent_scale.x) > 1e-6 { parent_scale.x } else { 1.0 }),
        y: (-sine * offset_x + cosine * offset_y) / (if util::abs(parent_scale.y) > 1e-6 { parent_scale.y } else { 1.0 }),
    }
}

// The same name on the other side, or `None`. Shared spelling with the
// Polygon tool's, so a bone and its weights mirror to the same place.
pub fn mirror_name(path: str) -> str? {
    polygon::mirror_name(path)
}

// Mirror every bone under the selection, handing each bone's rest to the one
// whose name differs by a side. A rig with no side names reflects in place.
pub fn mirror(state: &mut editor::State, axis: str) {
    let root = model::selected_node(state);
    if !root.is_valid() {
        return;
    }
    let bones = util::list_or_empty(skeleton::bones(root));
    if bones.len() == 0 {
        log::warn("nothing to mirror: this node carries no bones");
        return;
    }
    history::record(state, "mirror rig over {axis}", nil);
    let base = root.path();
    // Read every rest first: a mirror is a swap, and swapping in place would
    // hand the second bone what the first had already been given.
    let was: any = {};
    for bone in bones {
        let found = bone.as_node();
        let at = model::index_of_node(state, found);
        if at.is_some() {
            let key = if found.has_component("bone3d") { "bone3d" } else { "bone2d" };
            was.set(found.path(), Was { index: at.unwrap(), key: key, data: util::map_or_empty(found.authored(key)) });
        }
    }
    let moved = 0;
    for bone in bones {
        let mine_or = was.get(bone.path());
        if mine_or.is_nil() {
            continue;
        }
        let mine = mine_or;
        let full = bone.path();
        let relative_path = if full == base { "" } else { full.as_str().slice(base.len() + 1, full.as_str().len()) };
        let other = mirror_name(relative_path);
        // Its opposite number's rest, reflected; or its own, for a bone with
        // no side in its name.
        let source = if other.is_some() {
            let twin = other.unwrap();
            let twin_was = was.get(base.as_str() + "/" + twin);
            if twin_was.is_nil() { mine } else { twin_was }
        } else {
            mine
        };
        let rest = reflect_rest(util::map_or_empty(source.get("data")), axis);
        moved += 1;
        let live = model::node(state, mine.get("index").as_int());
        if live.is_valid() {
            live.set_component(mine.get("key"), rest);
        }
    }
    apply_rest(state);
    log::info("{moved} bones mirrored over {axis}");
}

// One bone's rest reflected: the axis's own component and the rotation about
// z both change sign, because a reflection turns a right-handed frame into a
// left-handed one.
fn reflect_rest(data: any, axis: str) -> any {
    let out = util::map_or_empty(util::copy(data));
    let authored_position = out.get("rest_position");
    let position = util::list_or_empty(if authored_position.is_nil() { [] } else { authored_position });
    if position.len() >= 2 {
        let flipped: [float] = [];
        for coordinate in 0..position.len() {
            let value = position[coordinate];
            let sign = if (axis == "x" && coordinate == 0) || (axis == "y" && coordinate == 1) { -1.0 } else { 1.0 };
            flipped.push(value.as_float() * sign);
        }
        out.set("rest_position", flipped);
    }
    let rotation = out.rest_rotation;
    if rotation.kind() == "list" {
        let turned = util::vec3(rotation, [0.0, 0.0, 0.0]);
        out.set("rest_rotation", [turned[0], turned[1], -turned[2]]);
    } else {
        out.set("rest_rotation", -rotation.as_float());
    }
    // The gizmo angle is measured from +x; a mirror over y leaves it negated,
    // and one over x reflects it about the vertical instead.
    let was = out.get("angle");
    if !was.is_nil() {
        let angle = -was.as_float();
        out.set("angle", if axis == "x" { math::PI.as_float() + angle } else { angle });
    } else {
        nil
    }
    out
}

// The bone's name at its origin, for the one under the pointer and the one
// selected. Every bone at once is a wall of text; the Rig tool names them
// all, because placing one is when the chain's shape is the question.
fn label_bone(state: editor::State, row: int, node: Node, spine: Geometry, color: [float]) {
    if state.tool != "bone" && state.rig.hover != row && row != state.selected {
        return;
    }
    let options = render::TextOptions {
        font_size: 28.0,
        color: color,
        text_align: "center",
        pixels_per_unit: LABEL_PIXELS_PER_UNIT,
    };
    if state.mode2d {
        render::draw_text_2d(spine.origin[0].as_float(), spine.origin[1].as_float() + LABEL_LIFT, node.name(), options);
    } else {
        render::draw_text_3d(spine.origin[0].as_float(), spine.origin[1].as_float() + LABEL_LIFT, spine.origin[2].as_float(), node.name(), options);
    }
}

// A new bone under row `parent_index`, at world point (world_x, world_y), posed at its
// rest there. Returns the new row.
pub fn add_bone(state: &mut editor::State, parent_index: int, world_x: float, world_y: float) -> int? {
    let parent_node = model::node(state, parent_index);
    if !parent_node.is_valid() {
        return nil;
    }
    history::record(state, "add bone", nil);
    let local_x = 0.0;
    let local_y = 1.0;
    if state.mode2d {
        // The click, in the parent's own frame.
        let local = in_frame(parent_node, world_x, world_y);
        local_x = local.x;
        local_y = local.y;
    }
    // A 3D rig has no click to place a bone by, so it grows one unit up.
    let component = if state.mode2d { "bone2d" } else { "bone3d" };
    let rest: any = if state.mode2d {
        { "rest_position": [local_x, local_y], "rest_rotation": 0.0 }
    } else {
        { "rest_position": [local_x, local_y, 0.0] }
    };
    let child = model::spawn(state, parent_node, "Bone", {
        "transform": { "position": [local_x, local_y, 0.0] },
        component: rest,
    });
    model::reindex(state);
    let at = model::index_of_node(state, child).unwrap_or(0);
    selection::only(state, at);
    log::info("bone {child.name()} under {parent_node.name()}");
    at
}

// Runs from the 2D gizmo while the Rig bone tool is active: a click on a bone
// selects it, a click anywhere else grows a bone under the selection.
pub fn update(state: &mut editor::State, over_viewport: bool, world_x: any, world_y: any) {
    // No 3D picking: a 3D rig is selected in the tree and grown from the
    // inspector's Skeleton section.
    if !state.mode2d {
        state.rig.hover = nil;
        return;
    }
    if !input::mouse_down(input::MOUSE_BUTTON_LEFT.as_int()) {
        state.rig.drag = nil;
    }
    if state.rig.drag.is_some() {
        let drag = state.rig.drag.unwrap();
        drag_handle(state, drag, world_x, world_y);
        return;
    }
    state.rig.hover = if over_viewport { pick(state, world_x, world_y) } else { nil };
    if !(over_viewport && input::mouse_just_pressed(input::MOUSE_BUTTON_LEFT.as_int())) {
        return;
    }
    // A modifier's target handle wins over the bone under it: the handle is
    // drawn on top and is the smaller thing to hit.
    let handle_or = pick_handle(state, world_x, world_y);
    if handle_or.is_some() {
        let at = handle_or.unwrap();
        state.rig.drag = at;
        return;
    }
    if state.rig.hover.is_some() {
        let hover = state.rig.hover.unwrap();
        shell::choose(state, hover);
        return;
    }
    add_bone(state, state.selected, world_x.as_float(), world_y.as_float());
}

// How many bones the selection's subtree holds (itself included).
pub fn bone_count(state: editor::State, row: int) -> int {
    let found = model::node(state, row);
    if found.is_valid() {
        util::list_or_empty(skeleton::bones(found)).len()
    } else {
        0
    }
}

// File what a rest verb moved behind the components' backs, under row
// `root_index`: each bone's transform, or its `bone2d`, as what it asks for, so a
// save and an undo see it.
fn sync_bones(state: &mut editor::State, root_index: int, transforms: bool) {
    let root = model::node(state, root_index);
    if !root.is_valid() {
        return;
    }
    for bone in util::list_or_empty(skeleton::bones(root)) {
        let found = bone.as_node();
        let row_or = model::index_of_node(state, found);
        if row_or.is_none() {
            continue;
        }
        if transforms {
            model::set_transform(state, row_or.unwrap(), Parts {
                position: util::xyz(found.transform.position),
                rotation_euler: util::xyz(found.transform.rotation_euler),
                scale: util::xyz(found.transform.scale),
            });
        } else {
            let component = if found.has_component("bone3d") { "bone3d" } else { "bone2d" };
            found.set_component(component, found.get_component(component));
        }
    }
}

// Create Physical Skeleton: walk the rig into bodies and joints, and leave
// the `ragdoll` component that drives the bones back from them. The nodes it
// makes are ordinary ones, so they land in the tree and in the file.
pub fn physical_bones(state: &mut editor::State) {
    let found = model::selected_node(state);
    if !found.is_valid() {
        return;
    }
    history::record(state, "create physical skeleton", nil);
    // Kept in the scene, so they land in the tree and in the file; the rig
    // itself gains the `ragdoll` component that drives its bones from them.
    let options: any = { "parent": state.scene_root.unwrap() };
    let made = if state.mode2d { physics2d::ragdoll(found, options) } else { physics3d::ragdoll(found, options) };
    model::reindex(state);
    log::info("{util::list_or_empty(made).len()} physical bones built");
}

// Reset to Rest Pose, for every bone under the selection.
pub fn apply_rest(state: &mut editor::State) {
    let found = model::selected_node(state);
    if !found.is_valid() {
        return;
    }
    history::record(state, "reset to rest pose", nil);
    skeleton::apply_rest(found);
    sync_bones(state, state.selected, true);
}

// Overwrite Rest Pose: the pose every bone under the selection is in now
// becomes the one it returns to.
pub fn overwrite_rest(state: &mut editor::State) {
    let found = model::selected_node(state);
    if !found.is_valid() {
        return;
    }
    history::record(state, "overwrite rest pose", nil);
    skeleton::overwrite_rest(found);
    sync_bones(state, state.selected, false);
}
