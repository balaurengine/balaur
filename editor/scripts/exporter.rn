// The Export sheet: every target this install can build, what each one still
// needs, and where the last build landed. The verb is the engine's `export`
// module, which is the same library `balaur export` runs.

use crate::style;
use crate::util;

pub fn state() {
    #{
        // One row per target, as `export::targets()` reports them.
        rows: [],
        // Per target: "started", "done" or "failed", and what it said.
        status: #{},
        said: #{},
        // Where the last finished export landed, for the Open folder button.
        landed: "",
    }
}

pub fn open(S) {
    refresh(S);
    crate::window::show(S, "export");
}

fn refresh(S) {
    S.exporter.rows = export::targets();
}

// One event from the exporter, delivered on the tick it arrived.
pub fn report(S, e) {
    let ev = util::obj(e);
    let target = ev.get("target").unwrap_or("");
    let kind = ev.get("kind").unwrap_or("");
    if target == "" {
        return;
    }
    let status = S.exporter.status;
    status[target] = kind;
    let said = S.exporter.said;
    if kind == "done" {
        let where_ = ev.get("path").unwrap_or("");
        said[target] = where_;
        S.exporter.landed = where_;
        log::info(format!("exported {} -> {}", target, where_));
        // A runtime that was downloaded on the way is installed now.
        refresh(S);
    } else if kind == "failed" {
        let why = ev.get("message").unwrap_or("");
        said[target] = why;
        log::warn(format!("{}: {}", target, why));
    } else {
        said[target] = "";
    }
}

pub fn draw(S) {
    let k = S.theme;
    let hosts = crate::window::sheet_form(S, "export", "Export", || { folder_button(S, k); });
    if util::is_nil(hosts) {
        return;
    }
    // No sidebar: the sheet is one list of targets, and `sheet_form` left it
    // shut for us.
    crate::pool::sync(S, hosts.form, specs(S), 0.0, false);
}

/// Every row the sheet shows: what it builds, the link to the settings it
/// builds from, and a target with its verb.
fn specs(S) {
    if S.exporter.rows.is_empty() {
        let none = [note("no targets — this build has no exporter", "text_caption")];
        return none;
    }
    let out = [
        note("Builds the project this editor is editing.", "text_caption"),
        // The sheet builds; what it builds from is a settings page, so the
        // sentence that used to name the table is the link to it.
        #{ full: true, height: 24, slot_role: "layout_actions", controls: [#{
            kind: "button", role: "chip", text: "export settings",
            on: |_| { crate::settings::open_at(S, "export"); },
        }] },
    ];
    for row in S.exporter.rows {
        target_specs(S, util::obj(row), out);
    }
    out
}

fn note(text, role) {
    #{ full: true, height: 0, controls: [#{
        kind: "label", role: role, grow: 1, wrap: true, text: text,
    }] }
}

fn folder_button(S, k) {
    if S.exporter.landed == "" {
        return;
    }
    if ui::button("Reveal", #{
        height: 24, font_size: style::MD, corner_radius: 8, tooltip: "Show the last export in the file manager",
        fill: k.bg_control, text_color: k.text_muted,
    }) {
        engine::reveal(S.exporter.landed);
    }
}

// What a target can do right now, in the words the button will use.
fn readiness(installed, fetchable) {
    if installed {
        "installed"
    } else if fetchable {
        "downloads on first export"
    } else {
        "source build — no release to fetch a runtime from"
    }
}

fn target_specs(S, row, out) {
    let name = row.get("name").unwrap_or("");
    let installed = row.get("installed").unwrap_or(false);
    let fetchable = row.get("fetchable").unwrap_or(false);
    let note_text = row.get("note").unwrap_or("");
    let status = S.exporter.status.get(name).unwrap_or("");
    let said = S.exporter.said.get(name).unwrap_or("");
    let controls = [
        #{ kind: "label", role: "text_code", text: name },
        #{ kind: "label", role: "text_caption", text: readiness(installed, fetchable) },
    ];
    if note_text != "" {
        controls.push(#{ kind: "label", role: "note_warning", text: note_text });
    }
    controls.push(#{ kind: "row", grow: 1 });
    let verb = export_button(S, name, installed, fetchable, status);
    if verb is Object {
        controls.push(verb);
    }
    if status == "started" {
        controls.push(#{ kind: "label", role: "text_caption", text: "building…" });
    } else if status == "failed" {
        controls.push(#{ kind: "label", role: "note_danger", text: "failed" });
    } else if status == "done" {
        controls.push(#{ kind: "label", role: "text_caption", text: "done" });
    }
    out.push(#{ full: true, height: 24, slot_role: "layout_actions", controls: controls });
    // The path it wrote, or the reason it did not, under the row that says so.
    if said != "" {
        out.push(note(said, if status == "failed" { "note_danger" } else { "text_caption" }));
    }
}

// Nothing to build with, and nowhere to get one: nothing, instead of a
// button that can only fail. The same while one is building.
fn export_button(S, name, installed, fetchable, status) {
    if status == "started" || !(installed || fetchable) {
        return ();
    }
    #{
        kind: "button", role: "action_form",
        text: if installed { "export" } else { "download & export" },
        tooltip: "Export the project for this target",
        on: |_| {
            let status_map = S.exporter.status;
            status_map[name] = "started";
            // `download` is the consent this click just gave: the engine
            // never fetches a runtime without being told it may.
            export::start(name, #{ download: true });
        },
    }
}
