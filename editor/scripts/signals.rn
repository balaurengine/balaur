// What the Editor node tells the panels, as events they listen for. Each is
// emitted once however many edits a frame makes: the guard is cleared when
// the Editor hears its own event, at the next pump.

const OUTLINE = "outline_changed";
const INSPECTOR = "inspector_changed";
const DOCKS = "docks_changed";
const PLAY = "play_frame";
const CHROME = "chrome_changed";
const STATUS = "status_changed";
const RAIL = "rail_changed";
const STAGE = "stage_changed";
// What a panel showing one thing of the Editor's listens for, as
// `<what>_changed`: the Problems list, the Docs page, the files, the library,
// the tile brush, the state machine, the recordings and the debugger.
const PANELS = [
    "problems", "docs", "assets", "library", "tiles", "machine", "recordings", "debugger",
    "sheet", "picker", "manager", "textedit", "plugins", "inputview",
    "code", "complete", "refactor", "timeline", "weights", "bonemap",
];

/// Have the Editor hear its own words, which is what clears the guard. Here
/// rather than in editor.rn, where `events` names the Events view's module.
pub fn hear_own(editor) {
    events::listen(editor, OUTLINE, editor);
    events::listen(editor, INSPECTOR, editor);
    events::listen(editor, DOCKS, editor);
    events::listen(editor, PLAY, editor);
    events::listen(editor, CHROME, editor);
    events::listen(editor, STATUS, editor);
    events::listen(editor, RAIL, editor);
    events::listen(editor, STAGE, editor);
    for what in PANELS {
        events::listen(editor, what + "_changed", editor);
    }
}

/// Have the Editor hear when one of the shell's boxes moved, which lays the
/// shell out again.
pub fn hear_boxes(S, editor) {
    for id in crate::layout::watched() {
        let found = crate::layout::box_node(S, id);
        if !crate::util::is_nil(found) {
            events::listen(editor, "resized", found);
        }
    }
}

/// Have the Editor hear what the engine says from no node: a project file
/// reloaded, a script stopped or let go, a paste no field took, and what the
/// pointer did, which is when the viewport's tools look at it.
pub fn hear_engine(editor) {
    events::listen(editor, "assets_reloaded");
    events::listen(editor, "debugger_stopped");
    events::listen(editor, "pasted");
    for word in ["pointer_moved", "pointer_pressed", "pointer_released", "pointer_scrolled", "pointer_gestured"] {
        events::listen(editor, word);
    }
}

/// Clear the guard on `name`, as the Editor hears it back.
pub fn heard(S, name) {
    S.told[name] = false;
}

fn tell(S, name) {
    if S.told.get(name).unwrap_or(false) {
        return;
    }
    S.told[name] = true;
    scene::get_node("Editor").emit(name, ());
}

/// The document, the selection, a lock or a warning moved: what a panel
/// showing the document's outline listens for.
pub fn outline(S) {
    tell(S, OUTLINE);
    bars(S);
}

/// What the Inspector's form is built from beside the outline moved: the
/// workspace, the tool, play, the polygon being edited, the clip, the doc tab
/// or the screen's class. Called wherever one is written, so a write that
/// leaves it as it was says nothing.
pub fn inspector(S) {
    let key = [
        S.workspace, S.tool, S.playing, format!("{:?}", S.polygon), format!("{:?}", S.clip),
        S.shader_rel, S.doctab, S.compact, S.touchscreen,
    ];
    if key == S.inspector_key {
        return;
    }
    S.inspector_key = key;
    tell(S, INSPECTOR);
    bars(S);
}

/// A frame of play: every live value the Inspector and the state machine
/// show may have moved.
pub fn playing_frame(S) {
    tell(S, INSPECTOR);
    tell(S, PLAY);
    bars(S);
}

/// What a dock's tab row and its panel are built from moved: which panels
/// each dock holds and shows, a dock's width, the workspace (which names the
/// outline's tab), the screen's class, the Problems count, a plugin's dock,
/// and whether a recording is open, which the Recordings tab gives way to.
/// Called wherever one is written; a write that leaves the key says nothing.
pub fn docks(S) {
    let (errors, warnings) = crate::lint::counts(S);
    let key = [
        format!("{:?}", S.docks), S.layout.left.w, S.layout.right.w, S.layout.bottom.w,
        S.workspace, S.compact, errors + warnings, S.registry.panels.len(),
        crate::session::loaded(S),
    ];
    if key == S.docks_key {
        return;
    }
    S.docks_key = key;
    tell(S, DOCKS);
    bars(S);
}

/// Whether what the viewport's lines are drawn from beside the outline and
/// the Inspector's words moved: the tools' hover, a drag, the box select.
/// Asked after the pointer did something, and true whenever a drag is under
/// way or the pointer is over the stage, where a tool's lines follow it.
pub fn overlays_moved(S, over) {
    let key = format!("{:?}", [
        crate::viewport::hot_part(S), S.gizmo.marquee, S.rig.hover, S.pen.hover,
        S.tiles.hover, S.tiles.anchor, S.polygon.hover,
    ]);
    let moving = S.gizmo.drag is Object || S.camera_drag >= 0;
    if !over && !moving && key == S.overlays_key {
        return false;
    }
    S.overlays_key = key;
    true
}

/// What one panel shows moved, `what` being one of `PANELS`: emitted as
/// `<what>_changed`, once a frame.
pub fn changed(S, what) {
    tell(S, what + "_changed");
    bars(S);
}

/// The top bar, the status strip, the rail and the stage chrome are built from what the other words
/// cover and a little besides, so each of those asks after both; each says
/// only when its own key moved. Called where the little besides is written.
pub fn bars(S) {
    chrome(S);
    status(S);
    rail(S);
    stage(S);
}

fn stage(S) {
    let key = crate::center::stage_key(S);
    if key == S.stage_key {
        return;
    }
    S.stage_key = key;
    tell(S, STAGE);
}

fn rail(S) {
    let key = crate::center::rail_key(S);
    if key == S.rail_key {
        return;
    }
    S.rail_key = key;
    tell(S, RAIL);
}

fn chrome(S) {
    let key = crate::chrome::key(S);
    if key == S.chrome_key {
        return;
    }
    S.chrome_key = key;
    tell(S, CHROME);
}

fn status(S) {
    let key = crate::chrome::status_key(S);
    if key == S.status_key {
        return;
    }
    S.status_key = key;
    tell(S, STATUS);
}
