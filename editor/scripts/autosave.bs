//! Nothing to save: an edit to the scene is written to its file once the
//! edits stop for a moment, and a script or a shader once its typing stops
//! for a little longer, since writing a script is compiling it. A closed tab
//! or a crash loses at most that moment.

use anim;
use editor;
use history;
use manager;
use model;
use shell;

// Seconds without a new edit before the scene is written: past a drag's last
// frame and a typed number's last key, short of anyone reaching for a save.
pub const SETTLE: float = 0.6;

// Seconds a script or shader buffer rests before it is written: a pause in
// typing, not the gap between two words.
pub const TYPING_SETTLE: float = 1.5;

/// Write the scene if it has changed and the edits have settled by `now`, a
/// wall clock in seconds; answers whether it wrote. Not while a game plays,
/// whose scene is the run's rather than the file's, nor while isolate hides
/// part of it, nor mid-drag, nor for a dependency's scene, which is read-only.
pub fn write_settled(state: &mut editor::State, now: float) -> bool {
    if !history::dirty(state) || state.playing || state.isolated || state.gizmo.drag != nil || manager::showing(state) || model::read_only(state) {
        return false;
    }
    if now - state.history.at < SETTLE {
        return false;
    }
    anim::save(state);
    model::write(state);
    true
}

/// Once a frame. A run started with `--state` is a script's, a self-test's
/// or a showcase's, and keeps its edits off the project's files: a suite's
/// states each open the project as the last one left it on disk.
pub fn step(state: &mut editor::State) {
    if scripted(state) {
        return;
    }
    let now = engine::unix_time();
    write_settled(state, now);
    write_typed(state, now);
}

/// Write each code buffer whose typing has rested by `now`; answers how many
/// it wrote.
pub fn write_typed(state: &mut editor::State, now: float) -> int {
    let rested: [str] = [];
    for path in state.script_dirty.keys() {
        if now - state.script_dirty[path].as_float() >= TYPING_SETTLE {
            rested.push(path.as_str());
        }
    }
    for path in rested {
        shell::save_buffer(state, path);
    }
    rested.len()
}

fn scripted(state: editor::State) -> bool {
    state.start_states != "" || state.suite != nil
}

/// Whether an edit waits to be written, which asks for the frame that writes it.
pub fn waiting(state: editor::State) -> bool {
    let scene = history::dirty(state) && !state.playing && !state.isolated && !manager::showing(state) && !model::read_only(state);
    !scripted(state) && (scene || state.script_dirty.len() > 0)
}
