// Command palette: the single modal overlay. ⌘K opens; Esc, scrim click, or
// running a command closes. Substring filter, first result pre-highlighted.

use crate::anim;
use crate::defs;
use crate::history;
use crate::icons;
use crate::model;
use crate::shell;
use crate::theme;
use crate::util;

fn command(label, icon, key, run) {
    #{ label: label, icon: icon, key: key, tags: "", run: run }
}

// The engine's registries, asked once per opening rather than once per frame:
// every preset and every component type carries a tag list, and walking them
// all is a list rebuild on every keystroke.
fn catalogue(S) {
    let found = S.palette_cache;
    if found is Object {
        return found;
    }
    let presets = [];
    for preset in scene::presets() {
        let info = scene::preset_info(preset);
        presets.push(#{
            name: preset,
            tags: if info is Object { util::join(util::vec(info.tags), " ") } else { "" },
        });
    }
    let components = [];
    for name in scene::component_types() {
        components.push(#{
            name: name,
            tags: util::join(util::vec(scene::component_tags(name)), " "),
        });
    }
    found = #{ presets: presets, components: components, channels: render::debug_views() };
    S.palette_cache = found;
    found
}

fn commands(S) {
    let undo_label = match history::undo_label(S) {
        Some(label) => format!("Undo {}", label),
        None => "Undo",
    };
    let redo_label = match history::redo_label(S) {
        Some(label) => format!("Redo {}", label),
        None => "Redo",
    };
    let list = [];
    for (i, p) in defs::workspaces().iter().enumerate() {
        let id = p.id;
        list.push(command(p.name + " workspace", p.icon, format!("⌥{}", i + 1), || shell::set_workspace(S, id)));
    }
    for c in [
        command(undo_label, "⟲", "⌘Z", || shell::undo(S)),
        command(redo_label, "⟳", "⇧⌘Z", || shell::redo(S)),
        command("Add child node…", icons::ui("add"), "⇧A", || crate::newnode::open(S)),
        command("Change type of selection…", icons::ui("reset"), "", || crate::newnode::open_change(S)),
        command("Make selection a soft body", icons::ui("reset"), "", || {
            if crate::model::has_selection(S) {
                crate::recipes::soft_body(S, S.sel);
            }
        }),
        command("Attach Rune script to selection", "‹›", "⌥S", || shell::attach_script(S)),
        command("Run scene", "▶", "F5", || shell::toggle_play(S)),
        // One save behind one label: ⌘S writes whichever of the scene, the
        // open script and the open shader the centre is showing.
        command("Save", "◇", "⌘S", || shell::save_active(S)),
        command("Reload scripts", "⟳", "⇧R", || shell::reload_scripts(S)),
        command("Export game…", "⇧", "⌘E", || crate::exporter::open(S)),
        command("Settings…", "⚙", "⌘,", || crate::settings::open(S)),
        command("Toggle dark chrome", icons::ui("dark"), "⌥L", || theme::toggle(S)),
        command("Edit theme…", icons::ui("dark"), "", || crate::themewin::open(S)),
        command(if S.show_input { "Hide input overlay" } else { "Show input overlay" }, "⌨", "", || {
            S.show_input = !S.show_input;
        }),
        // No chord: ⌥3 is the Animation workspace's, and one chord names one verb.
        command("Open animation timeline", "◷", "", || crate::docks::show(S, "timeline")),
        command("Open state machine", "◷", "", || crate::docks::show(S, "statemachine")),
        command("Open the cost dock", icons::panel("cost"), "", || crate::docks::show(S, "cost")),
        command("Open the library", icons::ui("library"), "", || crate::docks::show(S, "library")),
        command("Show event bindings", icons::ui("events"), "", || shell::open_doc(S, "events")),
        command("Add an event binding", icons::ui("events"), "", || crate::events::add_row(S)),
        command("Convert bindings to a script", "‹›", "", || crate::events::convert_to_script(S)),
        command("Split code and scene", icons::ui("split"), "⌘\\", || shell::toggle_split(S)),
        command(if S.focus { "Put the docks back" } else { "Focus the code" },
            icons::ui(if S.focus { "unfocus" } else { "focus" }), "⇧⌘\\", || shell::toggle_focus(S)),
        command("Select all nodes", icons::ui("select-all"), "⌘A", || crate::selection::select_all(S)),
        command("Group selection", icons::ui("group"), "⌘G", || crate::arrange::group(S)),
        command("Ungroup", icons::ui("ungroup"), "⇧⌘G", || crate::arrange::ungroup(S)),
        command("Align left (−x)", icons::ui("align-left"), "", || crate::arrange::align(S, 0, "min")),
        command("Align centre (x)", icons::ui("align-center-h"), "", || crate::arrange::align(S, 0, "mid")),
        command("Align right (+x)", icons::ui("align-right"), "", || crate::arrange::align(S, 0, "max")),
        command("Align bottom (−y)", icons::ui("align-bottom"), "", || crate::arrange::align(S, 1, "min")),
        command("Align middle (y)", icons::ui("align-center-v"), "", || crate::arrange::align(S, 1, "mid")),
        command("Align top (+y)", icons::ui("align-top"), "", || crate::arrange::align(S, 1, "max")),
        command("Align back (−z)", icons::ui("align-left"), "", || crate::arrange::align(S, 2, "min")),
        command("Align depth (z)", icons::ui("align-center-h"), "", || crate::arrange::align(S, 2, "mid")),
        command("Align front (+z)", icons::ui("align-right"), "", || crate::arrange::align(S, 2, "max")),
        command("Distribute along x", icons::ui("distribute-h"), "", || crate::arrange::distribute(S, 0)),
        command("Distribute along y", icons::ui("distribute-v"), "", || crate::arrange::distribute(S, 1)),
        command("Distribute along z", icons::ui("distribute-h"), "", || crate::arrange::distribute(S, 2)),
        command("Hide or show selection", icons::ui("hidden"), "H", || crate::arrange::toggle_hidden(S)),
        command("Show every node", icons::ui("visible"), "⇧H", || crate::arrange::show_all(S)),
        command("Lock or unlock selection", icons::ui("lock"), "⌘L", || crate::arrange::toggle_locked(S)),
        command("Unlock every node", icons::ui("unlock"), "⇧⌘L", || crate::arrange::unlock_all(S)),
        command("Isolate the selection", icons::ui("isolate"), "/", || crate::arrange::toggle_isolate(S)),
        command("New path to draw with the Pen", icons::ui("pen"), "", || crate::pen::new_path(S)),
        command("Close or open the selected path", icons::ui("path"), "", || crate::pen::toggle_closed(S)),
        command("Duplicate selected node", icons::ui("instance"), "", || model::duplicate_selected(S)),
        command("Copy selected node", icons::ui("instance"), "⌘C", || {
            if model::has_selection(S) {
                ui::set_clipboard(model::copy_selected(S));
            }
        }),
        command("Delete selected node", icons::ui("close"), "", || model::delete_selected(S)),
        command("Create animation clip", "◷", "", || { anim::ensure_clip(S); }),
        command("Insert keyframe at playhead", "◆", "K", || anim::add_key(S, S.anim.time)),
        command("Save clip as file", "◷", "", || anim::promote(S)),
        command("Make clip inline", "◷", "", || anim::make_inline(S)),
        command("UI scale +", icons::ui("add"), "⌘=", || shell::set_ui_scale(S, S.ui_scale + 0.125)),
        command("UI scale −", "−", "⌘-", || shell::set_ui_scale(S, S.ui_scale - 0.125)),
    ] {
        list.push(c);
    }
    // The start screen, from inside a project: the same module, so what opens
    // from here is what opens on a bare launch. A tab has no folder picker and
    // nowhere to write a template, but it reopens what the browser keeps.
    if !crate::manager::in_tab() {
        list.push(command("Open project…", icons::panel("assets"), "", || crate::manager::pick(S)));
        list.push(command("New project…", icons::ui("add"), "", || crate::manager::open_over(S)));
    }
    list.push(command("Recent projects…", icons::panel("library"), "", || crate::manager::open_over(S)));
    // One command per scene file, the way the channel views are one per
    // channel: a prefab is placed by name rather than through a picker.
    for rel in model::scene_files(S) {
        if rel != S.scene_rel {
            let scene = rel;
            list.push(command("Instance " + scene, icons::ui("instance"), "", || model::instance_scene(S, scene)));
        }
    }
    list.push(command("Open the prefab behind the selection", icons::ui("instance"), "", || model::open_prefab(S)));
    let known = catalogue(S);
    // Channel views: draw normals, UVs or depth instead of the picture.
    list.push(command("View: color", "◐", "", || render::set_debug_view("")));
    for name in known.channels {
        let channel = name;
        list.push(command("View: " + channel, "◐", "", || render::set_debug_view(channel)));
    }
    for entry in S.registry.commands {
        let run = entry.run;
        list.push(command(entry.title, entry.icon, entry.shortcut, || run(S)));
    }
    for entry in S.registry.dialogs {
        let wid = entry.id;
        list.push(command(format!("Open {}", entry.title), "▭", "", || {
            S.registry.open[wid] = true;
        }));
    }
    // Component commands come from the engine's registry, so third-party
    // plugin components are addable without touching the editor.
    let (_, found) = model::selected(S);
    // Presets first: they are the shortcut most edits actually want, and
    // each is just the components it names.
    for known_preset in known.presets {
        let preset = known_preset.name;
        let entry = command(format!("Add {} node", preset), icons::ui("add"), "", || model::add_child(S, Some(preset)));
        entry.tags = known_preset.tags;
        list.push(entry);
    }
    let found_some = found;
    if let Some(found) = found_some {
        let present = #{};
        for name in found.component_names() {
            present[name] = true;
        }
        for known_comp in known.components {
            let name = known_comp.name;
            if present.contains_key(name) {
                list.push(command(format!("Remove {} component", name), icons::ui("close"), "", || model::remove_component(S, name)));
            } else {
                let entry = command(format!("Add {} component", name), icons::ui("add"), "", || model::add_component(S, name));
                // Facets, so typing "physics" or "2d" narrows the list.
                entry.tags = known_comp.tags;
                list.push(entry);
            }
        }
    }
    list
}

pub fn draw(S) {
    if !S.palette {
        return;
    }
    let matched = matches(S);
    let row_h = util::max(crate::style::row_h(S), 30.0);
    let host = crate::window::picker(S, #{
        width: 560.0,
        mark: icons::ui("search"),
        placeholder: "Nodes, commands, workspaces…",
        query: S.palette_query,
        rows_h: (matched.len() as f64) * (row_h + 2.0) + 4.0,
        on: |text| { S.palette_query = text; },
        on_submit: |text| {
            S.palette_query = text;
            S.palette_submit = true;
        },
    });
    if util::is_nil(host) {
        shell::close_palette(S);
        return;
    }
    crate::pool::sync(S, host, row_specs(S, matched, row_h), 0.0, false);
}

// What the query names, in the order the catalogue offers them. The facets
// are matched too, so "physics" or "2d" narrows the list even though neither
// word is in the label.
fn matches(S) {
    let query = S.palette_query.to_lowercase();
    let out = [];
    for cmd in commands(S) {
        let haystack = (cmd.label + " " + cmd.tags).to_lowercase();
        if query == "" || haystack.contains(query) {
            out.push(cmd);
        }
    }
    out
}

fn row_specs(S, matched, row_h) {
    let out = [];
    if matched.is_empty() {
        out.push(#{ full: true, height: 0, controls: [#{
            kind: "label", role: "text_caption", grow: 1, wrap: true, text: "no matches",
        }] });
        S.palette_submit = false;
        return out;
    }
    // Enter runs the first match, which is why it wears the held look.
    if S.palette_submit {
        let run = matched[0].run;
        run();
        shell::close_palette(S);
        S.palette_submit = false;
        return out;
    }
    for (at, entry) in matched.iter().enumerate() {
        // Bound afresh: a closure made in a loop captures the binding.
        let cmd = entry;
        out.push(#{ full: true, height: row_h, slot_role: "layout_actions", controls: [
            #{
                kind: "button", grow: 1, text: cmd.label, icon: cmd.icon,
                role: "item_picker", checked: at == 0,
                tooltip: cmd.key,
                on: |_| {
                    let run = cmd.run;
                    run();
                    shell::close_palette(S);
                },
            },
            #{ kind: "label", role: "text_caption", text: cmd.key },
        ] });
    }
    out
}
