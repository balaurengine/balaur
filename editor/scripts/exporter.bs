// The Export sheet: every target this install can build, what each one still
// needs, and where the last build landed. The verb is the engine's `export`
// module, which is the same library `balaur export` runs.

use editor;
use form;
use settings;
use util;
use window;
use words::fields;
use words::inspector_fields;
use words::log_fields;
use words::project_fields;
use words::roles;
use words::schema_fields;
use words::statuses;
use words::verbs;

const INSTALLED: str = "installed";

pub class ExporterState {
    internal rows: [any],
    status: any,
    said: any,
    landed: str,
}

// The runtime every target puts the game on; a server target keeps its own.
const RUNTIME_SETTING: str = "export/runtime";

pub fn state() -> ExporterState {
    ExporterState {
        // One row per target, as `export::targets()` reports them.
        rows: [],
        // Per target: "started", "done" or "failed", and what it said.
        status: {},
        said: {},
        // Where the last finished export landed, for the Open folder button.
        landed: "",
    }
}

pub fn open(state: &mut editor::State) {
    refresh(state);
    window::show(state, verbs::EXPORT);
}

fn refresh(state: &mut editor::State) {
    state.exporter.rows = export::targets();
}

// One event from the exporter, delivered on the tick it arrived.
pub fn report(state: &mut editor::State, event: any) {
    let export_event = util::map_or_empty(event);
    let target = export_event[inspector_fields::TARGET].as_str();
    let kind = export_event[fields::KIND].as_str();
    if target == "" {
        return;
    }
    let status: any = state.exporter.status;
    status[target] = kind;
    let said: any = state.exporter.said;
    if kind == statuses::DONE {
        let exported_path = export_event[project_fields::PATH].as_str();
        said[target] = exported_path;
        state.exporter.landed = exported_path;
        log::info("exported {target} -> {exported_path}");
        // A runtime that was downloaded on the way is installed now.
        refresh(state);
    } else if kind == statuses::FAILED {
        let why = export_event[log_fields::MESSAGE].as_str();
        said[target] = why;
        log::warn("{target}: {why}");
    } else {
        said[target] = "";
    }
    window::changed(state);
}

/// Fill the sheet: what its script asks for when Export is up.
pub fn fill(state: &mut editor::State) {
    let hosts: any = window::sheet_form(state, verbs::EXPORT, "Export", folder_button(state));
    if util::is_nil(hosts) {
        return;
    }
    // No sidebar: the sheet is one list of targets, and `sheet_form` left it
    // shut for us.
    form::fill(hosts["form"].as_str(), specs(state));
}

/// Every row the sheet shows: what it builds, the link to the settings it
/// builds from, and a target with its verb.
fn specs(state: editor::State) -> [form::Row] {
    if state.exporter.rows.len() == 0 {
        let none = [note("no targets — this build has no exporter", roles::TEXT_CAPTION)];
        return none;
    }
    let out: [form::Row] = [
        note("Builds the project this editor is editing.", roles::TEXT_CAPTION),
        // The sheet builds; what it builds from is a settings page, so the
        // sentence that used to name the table is the link to it.
        form::Row {
            height: 24,
            slot_role: roles::LAYOUT_ACTIONS,
            controls: [
                ui::Control {
                    kind: ui::WIDGET_BUTTON,
                    role: roles::CHIP,
                    text: "export settings",
                    on_click: "handle",
                    data: { fields::FN: on_settings_clicked },
                },
            ],
        },
    ];
    let picker = runtime_spec(state);
    if picker != nil {
        out.push(picker.unwrap());
    }
    for row in state.exporter.rows {
        target_specs(state, util::map_or_empty(row), out);
    }
    out
}

fn on_settings_clicked(state: &mut editor::State, data: any, _value: any) {
    settings::open_at(state, verbs::EXPORT);
}

/// The `[export] runtime` choice, with the options its schema declares.
fn runtime_spec(state: editor::State) -> form::Row? {
    let options = util::list_or_empty(nil);
    for setting in settings::all() {
        if setting.path == RUNTIME_SETTING {
            options = util::list_or_empty(setting.spec[schema_fields::OPTIONS]);
        }
    }
    if options.len() == 0 {
        return nil;
    }
    let now = settings::stated(state, RUNTIME_SETTING);
    form::Row {
        height: 24,
        slot_role: roles::LAYOUT_ACTIONS,
        controls: [
            ui::Control { kind: ui::WIDGET_LABEL, role: roles::TEXT_CAPTION, text: "Runtime" },
            ui::Control {
                kind: ui::WIDGET_DROPDOWN,
                role: roles::CHOICE_FORM,
                width: 120,
                text: if now.kind() == types::KIND_STRING { now } else { options[0] },
                options: options,
                on_change: "handle",
                data: { fields::FN: on_runtime_picked },
            },
        ],
    }
}

fn on_runtime_picked(state: &mut editor::State, data: any, picked: any) {
    pick_runtime(state, picked.as_str());
}

pub fn pick_runtime(state: &mut editor::State, picked: str) {
    settings::write(state, RUNTIME_SETTING, picked);
    // An export reads project.toml, so the choice is saved as it is made.
    settings::commit_project(state);
    refresh(state);
}

fn note(text: str, role: str) -> form::Row {
    form::Row {
        height: 0,
        controls: [
            ui::Control {
                kind: ui::WIDGET_LABEL,
                role: role,
                grow: 1,
                wrap: true,
                text: text,
            },
        ],
    }
}

// Reveal, beside the close, once an export has landed somewhere.
fn folder_button(state: editor::State) -> [ui::Control] {
    if state.exporter.landed == "" {
        return [];
    }
    let reveal: [ui::Control] = [
        ui::Control {
            kind: ui::WIDGET_BUTTON,
            role: roles::ACTION_FORM,
            text: "Reveal",
            tooltip: "Show the last export in the file manager",
            on_click: "handle",
            data: { fields::FN: on_reveal_clicked },
        },
    ];
    reveal
}

fn on_reveal_clicked(state: &mut editor::State, data: any, _value: any) {
    engine::reveal(state.exporter.landed);
}

// What a target can do right now, in the words the button will use.
fn readiness(installed: bool, fetchable: bool) -> str {
    if installed {
        INSTALLED
    } else if fetchable {
        "downloads on first export"
    } else {
        "source build — no release to fetch a runtime from"
    }
}

fn target_specs(state: editor::State, row: any, out: [form::Row]) {
    let name = row[fields::NAME].as_str();
    let own_runtime = row["runtime"];
    let runtime = if own_runtime == nil { name } else { own_runtime.as_str() };
    let installed = row[INSTALLED].as_bool();
    let fetchable = row["fetchable"].as_bool();
    let note_text = row[log_fields::NOTE].as_str();
    let status = state.exporter.status[name].as_str();
    let said = state.exporter.said[name].as_str();
    let controls: [ui::Control] = [ui::Control { kind: ui::WIDGET_LABEL, role: roles::TEXT_CODE, text: name }];
    if runtime != name {
        controls.push(ui::Control { kind: ui::WIDGET_LABEL, role: roles::TEXT_CAPTION, text: "→ " + runtime });
    }
    controls.push(ui::Control { kind: ui::WIDGET_LABEL, role: roles::TEXT_CAPTION, text: readiness(installed, fetchable) });
    if note_text != "" {
        controls.push(ui::Control { kind: ui::WIDGET_LABEL, role: roles::NOTE_WARNING, text: note_text });
    }
    controls.push(ui::Control { kind: ui::WIDGET_ROW, grow: 1 });
    let verb = export_button(state, name, installed, fetchable, status);
    if verb != nil {
        controls.push(verb.unwrap());
    }
    if status == statuses::STARTED {
        controls.push(ui::Control { kind: ui::WIDGET_LABEL, role: roles::TEXT_CAPTION, text: "building…" });
    } else if status == statuses::FAILED {
        controls.push(ui::Control { kind: ui::WIDGET_LABEL, role: roles::NOTE_DANGER, text: "failed" });
    } else if status == statuses::DONE {
        controls.push(ui::Control { kind: ui::WIDGET_LABEL, role: roles::TEXT_CAPTION, text: "done" });
    }
    out.push(form::Row { height: 24, slot_role: roles::LAYOUT_ACTIONS, controls: controls });
    // The path it wrote, or the reason it did not, under the row that says so.
    if said != "" {
        out.push(note(said, if status == statuses::FAILED { roles::NOTE_DANGER } else { roles::TEXT_CAPTION }));
    }
}

// Nothing to build with, and nowhere to get one: nothing, instead of a
// button that can only fail. The same while one is building.
fn export_button(state: editor::State, name: str, installed: bool, fetchable: bool, status: str) -> ui::Control? {
    if status == statuses::STARTED || !(installed || fetchable) {
        return nil;
    }
    ui::Control {
        kind: ui::WIDGET_BUTTON,
        role: roles::ACTION_FORM,
        text: if installed { verbs::EXPORT } else { "download & export" },
        tooltip: "Export the project for this target",
        on_click: "handle",
        data: { fields::FN: on_export_clicked, fields::NAME: name },
    }
}

fn on_export_clicked(state: &mut editor::State, data: any, _value: any) {
    let name: str = data[fields::NAME].as_str();
    // `download` is the consent this click just gave: the engine
    // never fetches a runtime without being told it may.
    if !export::start(name, export::StartOptions { download: true }) {
        log::info("{name}: not exporting while a recording plays");
        return;
    }
    let status_map: any = state.exporter.status;
    status_map[name] = statuses::STARTED;
}
