// A file dropped on the window becomes a node: copy it into the project, make
// the node that names it, record one history step. One function per extension.

use crate::history;
use crate::model;
use crate::selection;
use crate::util;

/// Where a dropped file of each kind is copied to inside the project.
const HOMES = #{
    image: "art",
    shader: "shaders",
    font: "fonts",
    sky: "skies",
};

/// The kind of a dropped file, by extension, or "" for one nothing claims.
pub fn kind_of(path) {
    let lower = path.to_lowercase();
    for extension in ["png", "jpg", "jpeg", "webp", "svg", "bmp", "tga"] {
        if lower.ends_with("." + extension) {
            return "image";
        }
    }
    // Asked, not listed: a second copy of what the importer reads drifts from
    // it. A whole `project.godot` makes a project, so it is the manager's.
    if !lower.ends_with("project.godot") && import::handles(path) {
        return "import";
    }
    if lower.ends_with(".wesl") {
        return "shader";
    }
    if lower.ends_with(".hdr") || lower.ends_with(".exr") {
        return "sky";
    }
    if lower.ends_with(".toml") {
        return "scene";
    }
    for extension in ["ttf", "otf"] {
        if lower.ends_with("." + extension) {
            return "font";
        }
    }
    ""
}

/// The file's name with no directory.
fn file_name(path) {
    let parts = path.replace("\\", "/").split('/').collect::<Vec>();
    parts[parts.len() - 1]
}

/// The name with no extension, lowercased with separators as underscores, the
/// way `balaur import` names what it writes.
pub fn stem_of(path) {
    let name = file_name(path);
    let stem = match name.split_once('.') {
        Some((stem, _)) => stem,
        None => name,
    };
    stem.to_lowercase().replace(" ", "_").replace("-", "_")
}

/// Copy a dropped file under `dir` inside the project, answering the
/// project-relative path. A name already taken gets a numbered suffix, so a
/// second drop of the same file never overwrites the first.
pub fn copy_in(S, path, dir) {
    let name = file_name(path);
    let target = dir + "/" + name;
    if fs::exists(S.game_root + "/" + target) {
        let stem = match name.split_once('.') {
            Some((stem, _)) => stem,
            None => name,
        };
        let extension = if name.len() > stem.len() { name[stem.len()..] } else { "" };
        let n = 2;
        while fs::exists(S.game_root + "/" + dir + "/" + format!("{}_{}{}", stem, n, extension)) {
            n += 1;
        }
        target = dir + "/" + format!("{}_{}{}", stem, n, extension);
    }
    if !fs::exists(path) {
        log::warn("could not read " + path);
        return None;
    }
    fs::copy(path, S.game_root + "/" + target);
    model::forget(S, None);
    Some(target)
}

/// Where a drop lands in the world: the pointer in 2D, and the point the
/// camera looks at in 3D, so a dropped thing is where the view already is.
fn drop_point(S) {
    if model::is_2d(S) {
        let (x, y) = render::mouse_world_2d();
        return [x, y, 0.0];
    }
    let (_, _, _, tx, ty, tz, _, _) = render::camera_pose();
    [tx, ty, tz]
}

/// Add one node carrying `parts`, parented to the scene's root, at the drop
/// point. History and the mirror rebuild are the caller's.
fn place(S, name, parts) {
    let unique = model::unique_name(S.doc, name);
    let entry = #{
        id: model::fresh_id(S.doc, unique),
        name: unique,
        parent: model::root_id(S.doc),
        transform: #{ position: drop_point(S) },
    };
    for (key, value) in parts.iter() {
        entry[key] = value;
    }
    S.doc.push(entry);
    entry
}

/// An image becomes a `sprite` in 2D and a textured `shape3d` plane in 3D.
fn drop_image(S, path) {
    let rel = match copy_in(S, path, HOMES.image) {
        Some(rel) => rel,
        None => return false,
    };
    history::record(S, "drop " + rel, None);
    let name = stem_of(path);
    if model::is_2d(S) {
        place(S, name, #{ sprite: #{ texture: rel } });
    } else {
        place(S, name, #{
            shape3d: #{ kind: render::SHAPE_CUBOID, half_extents: [0.5, 0.001, 0.5] },
            mesh: #{ texture: rel },
        });
    }
    true
}

/// A `.wesl` file becomes a shader and the `material` asset that names it.
fn drop_shader(S, path) {
    let rel = match copy_in(S, path, HOMES.shader) {
        Some(rel) => rel,
        None => return false,
    };
    let name = stem_of(path);
    let material = format!("materials/{}.toml", name);
    fs::mkdir(S.game_root + "/materials");
    fs::write(S.game_root + "/" + material, toml::encode(#{
        type: "material",
        shader: rel,
    }));
    model::forget(S, None);
    log::info("wrote " + material);
    false
}

/// An `.hdr` or `.exr` becomes the scene's sky.
fn drop_sky(S, path) {
    let rel = match copy_in(S, path, HOMES.sky) {
        Some(rel) => rel,
        None => return false,
    };
    name_sky(S, rel, "drop sky")
}

/// Point the scene at a sky image already inside the project, which is what
/// a drop and a library placement both end in.
pub fn name_sky(S, rel, label) {
    history::record(S, label, None);
    // The last `environment` in tree order wins, so an existing one is
    // retargeted rather than joined by a second.
    for node in S.doc {
        if node.contains_key("environment") {
            node.environment.sky = rel;
            log::info("sky is now " + rel);
            return true;
        }
    }
    place(S, "Environment", #{ environment: #{ sky: rel } });
    true
}

/// A font is copied and nothing is placed: a font is named by a `text`
/// component, not by a node of its own.
fn drop_font(S, path) {
    if let Some(rel) = copy_in(S, path, HOMES.font) {
        log::info("added " + rel);
    }
    false
}

/// A scene file is instanced as a prefab. A file already inside the project is
/// instanced where it lies rather than copied beside itself.
fn drop_scene(S, path) {
    let prefix = S.game_root + "/";
    let rel = if path.starts_with(prefix) {
        path[prefix.len()..]
    } else {
        match copy_in(S, path, "scenes") {
            Some(rel) => rel,
            None => return false,
        }
    };
    model::instance_scene(S, rel);
    false
}

/// A model, sprite sheet or level goes through `balaur import`, which runs a
/// few files a frame and reports to `report` below; the scene it wrote is
/// instanced when it says it is done.
fn drop_import(S, path) {
    if !import::start(path) {
        // Refused: a recording is playing, and an import writing files into
        // the project mid-replay is not something to do quietly.
        log::warn("not importing " + file_name(path) + " while a recording plays");
    }
    false
}

// How long an import that has ended stays in the list, in seconds.
const KEPT_FOR = 4.0;

/// Every import of this batch added up, for the bar: what is written of what
/// the whole batch holds, the ones that have ended included.
pub fn job_totals(S) {
    let done = 0;
    let files = 0;
    for (_, job) in S.jobs.iter() {
        done += job.done;
        files += job.files;
    }
    (done, files)
}

/// How many imports are still running. The rest of `S.jobs` are the ones that
/// ended and are still being shown.
pub fn in_flight(S) {
    let n = 0;
    for (_, job) in S.jobs.iter() {
        if job.over == "" {
            n += 1;
        }
    }
    n
}

/// Take the list down once the last of the batch has been finished a while.
/// The whole of it goes at once: a line that left while its neighbours ran
/// would take its files out of the count, and the bar would go backwards.
pub fn sweep(S) {
    if S.jobs.is_empty() || in_flight(S) > 0 {
        return;
    }
    let last = 0.0;
    for (_, job) in S.jobs.iter() {
        if job.at > last {
            last = job.at;
        }
    }
    if engine::time() - last > KEPT_FOR {
        S.jobs = #{};
    }
}

/// How many files the import of `source` has written, for the line that says
/// so when it ends.
fn written_by(S, source) {
    match S.jobs.get(source) {
        Some(job) => job.done,
        None => 0,
    }
}

/// Mark one import as ended, leaving it in the list for a while: a batch of
/// four files is over in two frames, and a reader who saw nothing at all
/// cannot tell an import from a freeze.
fn ended(S, source, over) {
    // Made here where there is none: a cancel is read at the top of a slice,
    // so one pressed early ends an import that never said it had started.
    let job = S.jobs.get(source)
        .unwrap_or(#{ name: file_name(source), done: 0, files: 0, over: "", at: 0.0 });
    job.over = over;
    job.at = engine::time();
    S.jobs[source] = job;
}

/// Every import reports here, one call per step: what is coming, each file as
/// it lands, then the end.
pub fn report(S, e) {
    let ev = util::obj(e);
    let kind = ev.get("kind").unwrap_or("");
    let source = ev.get("source").unwrap_or("");
    if kind == "started" {
        // Keyed by the source, because several can run at once and each
        // reports its own steps.
        S.jobs[source] = #{
            name: file_name(source),
            done: 0,
            files: ev.get("files").unwrap_or(0),
            over: "",
            at: 0.0,
        };
    } else if kind == "wrote" {
        if let Some(job) = S.jobs.get(source) {
            job.done = ev.get("done").unwrap_or(0);
            job.files = ev.get("files").unwrap_or(0);
            S.jobs[source] = job;
        }
    } else if kind == "done" {
        let written = written_by(S, source);
        ended(S, source, "imported");
        model::forget(S, None);
        log::info(format!("imported {} ({} files)", file_name(source), written));
        let note = ev.get("note").unwrap_or("");
        if note != "" {
            log::info(note);
        }
        if let Some(rel) = ev.get("scene") {
            if rel is String {
                model::instance_scene(S, rel);
            }
        }
    } else if kind == "cancelled" {
        let written = ev.get("done").unwrap_or(0);
        ended(S, source, "stopped");
        // This run's count, not one an earlier import of the same file left.
        let job = S.jobs[source];
        job.done = written;
        S.jobs[source] = job;
        model::forget(S, None);
        log::info(format!("stopped importing {} after {} files", file_name(source), written));
    } else if kind == "failed" {
        ended(S, source, "failed");
        log::error(format!("importing {} failed: {}", file_name(source),
            ev.get("message").unwrap_or("")));
        // A line in a dock nobody has open is not a report, so open it.
        crate::docks::show(S, "output");
    }
}

/// Take every file dropped this frame. Called once per frame from the root's
/// update; a frame with no drop costs one empty list.
pub fn update(S) {
    let dropped = util::vec(input::dropped_files());
    if dropped.len() == 0 {
        return;
    }
    for path in dropped {
        take(S, path);
    }
}

/// Handle one dropped file. Public so a test can drive it with no window.
pub fn take(S, path) {
    let kind = kind_of(path);
    if kind == "" {
        log::warn("nothing to do with " + file_name(path));
        return;
    }
    let placed = match kind {
        "image" => drop_image(S, path),
        "shader" => drop_shader(S, path),
        "sky" => drop_sky(S, path),
        "font" => drop_font(S, path),
        "scene" => drop_scene(S, path),
        "import" => drop_import(S, path),
        _ => false,
    };
    // Only a `place` needs the rebuild; the verbs that instance a scene did
    // their own, and the ones that only copied a file changed no node.
    if placed {
        model::build_mirror(S);
        selection::only(S, S.doc.len() - 1);
        history::commit(S);
    }
}
