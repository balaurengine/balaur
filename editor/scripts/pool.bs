//! A pool of widget nodes under one host: a form whose fields change with the
//! selection cannot be authored, so a script says which rows it needs.
//!
//! The pool itself is `ui::fill_strip` and `ui::fill_rows`: making, reusing
//! and hiding the nodes, writing only what changed, and calling a control's
//! `on_click` or `on_change` with the reader's edit. Spare rows are hidden rather than freed, so
//! scrolling a long component list does not churn the scene tree.

use editor;
use util;

/// `spec`, whose edit `handler` hears with `data` and the edit: what a closure over
/// the locals in `data` was. The Editor's `handle` makes the call.
pub fn on(spec: ui::Control, handler: fn(&mut editor::State, any, any), data: any) -> ui::Control {
    let carried = util::copy(util::map_or_empty(data));
    carried["fn"] = handler;
    if spec.kind.or("") == "button" {
        spec.on_click = "handle";
    } else {
        spec.on_change = "handle";
    }
    spec.data = carried;
    spec
}

/// The same for Enter in a field, beside or instead of its edit.
pub fn on_submit(spec: ui::Control, handler: fn(&mut editor::State, any, any), data: any) -> ui::Control {
    let held = spec.data;
    let carried = if held == nil { data } else { held };
    let kept = util::copy(util::map_or_empty(carried));
    kept["submit"] = handler;
    spec.on_submit = "handle_submit";
    spec.data = kept;
    spec
}
