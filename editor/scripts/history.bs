// Undo/redo as lists of changes. The engine keeps every change to the edited
// scene with what it replaced (`scene::keep_changes`); a step is the ones an
// action made, and undoing it writes each back (PLAN-editor-as-scene §10.2).

use editor;
use model;
use signals;
use util;

/// One undo step: the changes the action made, the selection and the scene's
/// `[[assets]]` as they were before it, and what it was called.
pub struct Step {
    changes: [any],
    selected: [str],
    assets: any,
    label: str,
}

/// The steps behind and ahead, where the last save sits among them, and the
/// drag a record may still fold into.
pub class History {
    past: [Step],
    future: [Step],
    saved: int,
    key: str?,
    at: float,
}

const MAX: int = 100;

// A drag reports a change every frame; records sharing a key inside this many
// seconds of the wall clock are one step.
const COALESCE: float = 0.4;

// The scene's `[[assets]]` travel with the step: a tool writes a block there,
// and undoing it has to put the block back.
fn step(state: editor::State, label: str, changes: [any]) -> Step {
    let assets = state.scene_doc.assets;
    let kept = if assets.is_nil() { assets } else { util::deep(assets) };
    Step { changes: changes, selected: model::selected_ids(state), assets: kept, label: label }
}

pub fn reset(state: &mut editor::State) {
    scene::take_changes();
    state.history = History { past: [], future: [], saved: 0, key: nil, at: -1.0 };
}

/// What the engine kept since it was last asked, into the step that is open:
/// every change between one record and the next is that record's.
pub fn take(state: &mut editor::State) {
    let kept = scene::take_changes();
    if kept.len() == 0 || state.history.past.len() == 0 {
        return;
    }
    let open = state.history.past[state.history.past.len() - 1];
    for change in kept {
        open.changes.push(change);
    }
}

// Called by every mutator *before* it mutates. `key` coalesces a continuing
// drag into the step it started; pass `nil` for a discrete action.
pub fn record(state: &mut editor::State, label: str, key: str?) {
    take(state);
    let stack = state.history;
    let now = engine::unix_time();
    if key.is_some() && stack.key == key && now - stack.at < COALESCE {
        stack.at = now;
        return;
    }
    stack.key = key;
    stack.at = now;
    // A new step: what undo offers, and the unsaved mark, may have moved.
    signals::bars(state);
    stack.past.push(step(state, label, []));
    if stack.past.len() > MAX {
        stack.past.remove(0);
        // The saved point scrolled off the end: nothing can reach it again.
        stack.saved = if stack.saved > 0 { stack.saved - 1 } else { -1 };
    }
    stack.future = [];
}

// Break any open coalescing run, so the next edit starts its own step. Called
// when the selection moves or a drag ends.
pub fn commit(state: &mut editor::State) {
    take(state);
    state.history.key = nil;
}

// Write a step's changes back, last first. What the writing itself changed is
// the step that takes this one back again: each of those changes replaced
// what the step wrote, so redo is the same walk over them.
fn restore(state: &mut editor::State, into: [Step], from: [Step]) -> str? {
    take(state);
    if from.len() == 0 {
        return nil;
    }
    let top = from.pop();
    let held = step(state, top.label, []);
    model::drop_edited(state);
    let changes = top.changes;
    for at in 0..changes.len() {
        model::undo_change(state, changes[changes.len() - 1 - at]);
    }
    held.changes = scene::take_changes();
    into.push(held);
    if !top.assets.is_nil() && blocks_text(top.assets) != blocks_text(state.scene_doc.assets) {
        state.scene_doc.assets = top.assets;
        // A scene's blocks are read when it is built, so it is built again.
        model::build(state, model::scene_text(state));
    }
    model::reindex(state);
    model::select_ids(state, top.selected);
    state.history.key = nil;
    signals::outline(state);
    top.label
}

// The scene's `[[assets]]` as text, to tell two apart.
fn blocks_text(assets: any) -> str {
    if assets.is_nil() { "" } else { toml::encode(map().with("assets", assets)) }
}

// Both return the label of the step they moved through, or `nil` when the
// stack is empty.
pub fn undo(state: &mut editor::State) -> str? {
    restore(state, state.history.future, state.history.past)
}

pub fn redo(state: &mut editor::State) -> str? {
    restore(state, state.history.past, state.history.future)
}

pub fn can_undo(state: editor::State) -> bool {
    state.history.past.len() > 0
}

// What ⌘Z would undo, for a menu or palette label.
pub fn undo_label(state: editor::State) -> str? {
    let past = state.history.past;
    if past.len() > 0 { past[past.len() - 1].label } else { nil }
}

pub fn redo_label(state: editor::State) -> str? {
    let future = state.history.future;
    if future.len() > 0 { future[future.len() - 1].label } else { nil }
}

pub fn mark_saved(state: &mut editor::State) {
    take(state);
    state.history.saved = state.history.past.len();
}

// Position in the stack, not a latch: undoing back to the last save is clean
// again, which a boolean set by every mutator could never say.
pub fn dirty(state: editor::State) -> bool {
    let stack = state.history;
    stack.saved < 0 || stack.past.len() != stack.saved
}
