// The start screen's engine page: the build this is, the builds a release
// check found, and one being downloaded and installed.

use editor;
use form;
use icons;
use manager;
use style;
use util;
use words::fields;
use words::inspector_fields;
use words::layout_fields;
use words::log_fields;
use words::roles;
use words::statuses;
use words::theme_tokens;

const DOWNLOADING: str = "downloading";
const INSTALL: str = "install";
const INSTALLED: str = "installed";
const OLDER: str = "older";
const UNPACKING: str = "unpacking";
const DOWNLOAD: str = "download";

// What this build is, which line it follows, and every release the project
// has published. The same code `balaur update` runs, so the screen and the
// command cannot disagree.
internal fn engine_specs(state: &mut editor::State, tokens: any, column_width: float) -> [form::Row] {
    if !state.manager.asked {
        check(state);
    }
    let mine = util::map_or_empty(release::installed());
    let row_height = math::max(style::row_height(state), 30.0);
    let newest = newest_on(state, state.manager.follow);
    let head: [ui::Control] = [
        ui::Control {
            kind: ui::WIDGET_COLUMN,
            grow: 1,
            controls: [
                ui::Control { kind: ui::WIDGET_LABEL, role: roles::TEXT_TITLE, text: "Balaur " + mine[fields::VERSION].as_str() },
                ui::Control { kind: ui::WIDGET_LABEL, role: roles::TEXT_CODE_QUIET, text: build_line(mine), font_size: 11 },
            ],
        },
    ];
    if !manager::narrow(column_width) {
        let fresh = newest[fields::ORDER].as_str() == statuses::NEWER;
        head.push(ui::Control {
            kind: ui::WIDGET_LABEL,
            role: roles::TEXT_CODE_QUIET,
            font_size: 11,
            text: standing(state, state.manager.follow),
            text_color: (if fresh { tokens[theme_tokens::SUCCESS_TEXT] } else { tokens[theme_tokens::TEXT_SUBTLE] }).as_str(),
        });
    }
    head.push(ui::Control {
        kind: ui::WIDGET_BUTTON,
        role: roles::ACTION_FORM,
        icon: icons::ui(icons::RESET),
        text: if state.manager.reading { "Checking" } else { "Check" },
        on_click: "handle",
        data: { fields::FN: on_check_pressed },
    });
    let out: [form::Row] = [form::Row { height: 44, slot_role: roles::LAYOUT_ACTIONS, controls: head }];
    if mine[inspector_fields::HELD].as_str() != "" {
        out.push(manager::say(mine[inspector_fields::HELD].as_str(), tokens[theme_tokens::TEXT_SUBTLE].as_str()));
    }
    let lines: [ui::Control] = [ui::Control { kind: ui::WIDGET_LABEL, role: roles::TEXT_CAPTION, text: "Follow", width: 60 }];
    for name in util::list_or_empty(release::channels()) {
        // Bound afresh: a closure made in a loop captures the binding.
        let line = name;
        lines.push(ui::Control {
            kind: ui::WIDGET_BUTTON,
            role: roles::CHIP,
            text: line,
            checked: state.manager.follow == line.as_str(),
            on_click: "handle",
            data: { fields::FN: on_line_pressed, layout_fields::LINE: line },
        });
    }
    out.push(form::Row { height: row_height + 6.0, slot_role: roles::LAYOUT_ACTIONS, controls: lines });
    release_specs(state, tokens, row_height, mine, out);
    out
}

fn on_check_pressed(state: &mut editor::State, data: any, _value: any) {
    check(state);
}

fn on_line_pressed(state: &mut editor::State, data: any, _value: any) {
    let line: any = data[layout_fields::LINE];
    state.manager.follow = line.as_str();
    manager::told(state);
}

fn release_specs(state: editor::State, tokens: any, row_height: float, mine: any, out: [form::Row]) {
    let rows: [any] = [];
    for entry in state.manager.releases {
        let row = util::map_or_empty(entry);
        if row[log_fields::CHANNEL].as_str() == state.manager.follow {
            rows.push(row);
        }
    }
    if rows.len() == 0 {
        let empty = if state.manager.reading { "Reading the release feed." } else { "Nothing published on this line yet." };
        out.push(manager::say(empty, tokens[theme_tokens::TEXT_SUBTLE].as_str()));
    }
    for row in rows {
        let current = row[inspector_fields::CURRENT].as_bool() == true;
        let controls: [ui::Control] = [
            ui::Control {
                kind: ui::WIDGET_COLUMN,
                grow: 1,
                controls: [
                    ui::Control {
                        kind: ui::WIDGET_LABEL,
                        role: roles::TEXT_TITLE,
                        font_size: 13,
                        text: row[fields::ID].as_str(),
                        text_color: (if current { tokens[theme_tokens::PRIMARY_TEXT] } else { tokens[theme_tokens::TEXT_DEFAULT] }).as_str(),
                    },
                    ui::Control { kind: ui::WIDGET_LABEL, role: roles::TEXT_CODE_QUIET, font_size: 11, text: util::said_ago_since(row[fields::PUBLISHED]) },
                ],
            },
        ];
        let press = press_spec(state, row, mine);
        if press != nil {
            controls.push(press.unwrap());
        }
        out.push(form::Row { height: row_height + 14.0, slot_role: roles::LAYOUT_ACTIONS, controls: controls });
        out.push(manager::rule());
    }
    // An install that cannot replace itself has nothing to name a release for.
    if mine[inspector_fields::HELD].as_str() != "" || installing(state) {
        return;
    }
    out.push(form::Row {
        height: row_height,
        controls: [
            ui::Control {
                kind: ui::WIDGET_TEXT_FIELD,
                role: roles::INPUT_FORM,
                grow: 1,
                text: state.manager.tag,
                placeholder: "v0.2.0",
                on_change: "handle",
                data: { fields::FN: on_tag_typed },
            },
            ui::Control {
                kind: ui::WIDGET_BUTTON,
                role: roles::ACTION_FORM,
                text: "Install",
                min_width: 88,
                on_click: "handle",
                data: { fields::FN: on_install_typed_pressed },
            },
        ],
        label: "Or a release by name",
    });
}

fn on_tag_typed(state: &mut editor::State, data: any, text: any) {
    state.manager.tag = text.as_str();
}

fn on_install_typed_pressed(state: &mut editor::State, data: any, _value: any) {
    if state.manager.tag == "" {
        state.manager.failed = "type a release tag first, like v0.2.0";
        manager::told(state);
        return;
    }
    put(state, "", state.manager.tag);
}

/// The build in one line: its id and the line it follows, or where it came
/// from when it came from no release.
pub fn build_line(mine: any) -> str {
    if mine[inspector_fields::SOURCE].as_bool() == true {
        return "built from a checkout";
    }
    mine[fields::ID].as_str() + "  ·  following " + mine[log_fields::CHANNEL].as_str()
}

/// Ask the feed what every line holds, unless a read is already out. The
/// answer arrives in `heard`.
pub fn check(state: &mut editor::State) {
    if state.manager.reading {
        return;
    }
    state.manager.asked = true;
    state.manager.reading = release::check();
    manager::told(state);
}

/// Whether an install is in flight.
pub fn installing(state: editor::State) -> bool {
    state.manager.installing.tag != ""
}

internal fn no_install() -> manager::Installing {
    manager::Installing { tag: "", done: 0, total: 0, unpacking: false }
}

/// A report on a check or an install. The start screen and the About sheet
/// both read what this keeps.
pub fn heard(state: &mut editor::State, report: any) {
    let release_event = util::map_or_empty(report);
    let kind = release_event[fields::KIND].as_str();
    if kind == statuses::LISTED {
        let rows: [any] = [];
        for row in util::list_or_empty(release_event[fields::ROWS]) {
            rows.push(row);
        }
        state.manager.releases = rows;
        state.manager.reading = false;
    } else if kind == DOWNLOADING {
        state.manager.installing = manager::Installing {
            tag: release_event[fields::TAG].as_str(),
            done: release_event[log_fields::DONE].as_int(),
            total: release_event["total"].as_int(),
            unpacking: false,
        };
    } else if kind == UNPACKING {
        state.manager.installing.unpacking = true;
    } else if kind == INSTALLED {
        state.manager.installing = no_install();
        state.manager.failed = "";
        state.manager.note = release_event[log_fields::NOTE].as_str();
        log::info(state.manager.note);
    } else if kind == statuses::FAILED {
        if release_event[log_fields::JOB].as_str() == INSTALL {
            state.manager.installing = no_install();
        } else {
            state.manager.reading = false;
        }
        state.manager.failed = release_event[log_fields::MESSAGE].as_str();
    }
    manager::told(state);
}

/// The newest release on a line, or an empty table when it holds none.
pub fn newest_on(state: editor::State, channel: str) -> any {
    for entry in state.manager.releases {
        let row = util::map_or_empty(entry);
        if row[log_fields::CHANNEL].as_str() == channel {
            return row;
        }
    }
    {}
}

/// What the newest release on a line means for this build, in a few words.
pub fn standing(state: editor::State, channel: str) -> str {
    let newest = newest_on(state, channel);
    let id = newest[fields::ID].as_str();
    if id == "" {
        return if state.manager.reading { "checking" } else { "no release on this line" };
    }
    let order = newest[fields::ORDER].as_str();
    if order == statuses::SAME {
        return "up to date";
    }
    if order == statuses::NEWER {
        return id + " is newer";
    }
    if order == OLDER {
        return id + " is older than this build";
    }
    id + " is published"
}

/// The verb a release row carries, as a control: what `row_press` draws.
/// Nil where there is none: an install already running, or a held build.
pub fn press_spec(state: editor::State, row: any, mine: any) -> ui::Control? {
    if row[inspector_fields::CURRENT].as_bool() == true {
        return ui::Control { kind: ui::WIDGET_LABEL, role: roles::TEXT_CODE_QUIET, font_size: 11, text: INSTALLED };
    }
    if installing(state) {
        return nil;
    }
    let download = row[DOWNLOAD].as_str();
    if download != "" {
        return ui::Control {
            kind: ui::WIDGET_BUTTON,
            role: roles::ACTION_FORM,
            text: "Download",
            min_width: 88,
            on_click: "handle",
            data: { fields::FN: on_download_pressed, DOWNLOAD: download },
        };
    }
    if mine[inspector_fields::HELD].as_str() != "" {
        return nil;
    }
    let tag = row[fields::TAG].as_str();
    ui::Control {
        kind: ui::WIDGET_BUTTON,
        role: roles::ACTION_FORM,
        min_width: 88,
        text: if row[fields::ORDER].as_str() == OLDER { "Downgrade" } else { "Install" },
        on_click: "handle",
        data: { fields::FN: on_install_row_pressed, fields::TAG: tag },
    }
}

fn on_download_pressed(state: &mut editor::State, data: any, _value: any) {
    let download: str = data[DOWNLOAD].as_str();
    engine::open_url(download);
}

fn on_install_row_pressed(state: &mut editor::State, data: any, _value: any) {
    let tag: str = data[fields::TAG].as_str();
    put(state, "", tag);
}

/// How far an install has got, as a row of controls: the megabytes as they
/// arrive, then the unpack, and a bar for it.
pub fn progress_controls(state: editor::State) -> [ui::Control] {
    let job = state.manager.installing;
    let said = if job.unpacking {
        "unpacking " + job.tag
    } else if job.total > 0 {
        "downloading {job.tag}  ·  {job.done / manager::MB} of {job.total / manager::MB} MB"
    } else {
        "downloading {job.tag}  ·  {job.done / manager::MB} MB"
    };
    let part = if job.unpacking {
        1.0
    } else if job.total > 0 {
        job.done as float / job.total as float
    } else {
        0.0
    };
    [
        ui::Control { kind: ui::WIDGET_LABEL, role: roles::TEXT_CODE_QUIET, font_size: 11, text: said, value: 0.0 },
        ui::Control { kind: ui::WIDGET_PROGRESS_BAR, width: 200, height: 4, value: part },
    ]
}

// Replace this install, on a thread; `heard` follows it. The reader pressed
// it, so a downgrade is allowed: the press said Downgrade where it is one.
pub fn put(state: &mut editor::State, channel: str, tag: str) {
    if installing(state) {
        return;
    }
    if !release::install(channel, tag, release::InstallOptions { allow_downgrade: true }) {
        state.manager.failed = "nothing installs while a recording plays";
        return;
    }
    let named = if tag == "" { channel } else { tag };
    state.manager.failed = "";
    state.manager.note = "installing " + named;
    state.manager.installing = manager::Installing { tag: named, done: 0, total: 0, unpacking: false };
    manager::told(state);
}
