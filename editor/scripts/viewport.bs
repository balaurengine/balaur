// What every viewport tool needs and each one used to define for itself: the
// selection palette, the world-per-pixel scale, and the three questions a
// tool asks about the current drag.

use defs;
use editor;
use gizmo;
use history;
use model;
use shell;
use util;
use words::tools;

const MACOS: str = "macos";

/// A rail tool's drag this frame: the pointer's travel in design px and the
/// selected node it moves.
pub struct RailDrag {
    internal delta_x: float,
    internal delta_y: float,
    internal node: Node,
}

/// Window pixels, as the input snapshot counts them, in design px, by the
/// engine's own figure: the UI zoom, the display's scale and the reader's text
/// size. A distance converts the same way as a place.
pub fn design_pixels(window_x: float, window_y: float) -> Vec2 {
    let per_design = util::max(ui::pixels_per_design(), 0.01);
    vec2(window_x / per_design, window_y / per_design)
}

/// Logical pixels per design pixel: the engine's figure without the display.
pub fn logical_per_design() -> float {
    util::max(ui::pixels_per_design(), 0.01) / util::max(render::camera_pose().scale_factor, 0.01)
}

/// Where the pointer is, in design px.
pub fn pointer(state: editor::State) -> Vec2 {
    let at = input::mouse_position();
    design_pixels(at.x, at.y)
}

/// A 2D world point in design px, through the camera the viewport draws with:
/// centred on the window, `zoom` logical pixels to a world unit, y up.
pub fn screen_of_2d(state: editor::State, world_x: float, world_y: float) -> Vec2 {
    let camera = render::camera_2d();
    let scale = logical_per_design();
    vec2(state.screen_width / 2.0 + (world_x - camera.center.x) * camera.zoom / scale, state.screen_height / 2.0 - (world_y - camera.center.y) * camera.zoom / scale)
}

/// A rail tool's drag this frame, or `None` when the pointer stood still or
/// a zoom took the drag instead. Recording the history step is part of
/// taking it.
pub fn rail_drag(state: &mut editor::State) -> RailDrag? {
    let moved = input::mouse_delta();
    let travel = design_pixels(moved.x, moved.y);
    if travel.x == 0.0 && travel.y == 0.0 {
        return nil;
    }
    let found = model::selected_node(state);
    if found.is_valid() && (state.tool == tools::MOVE || state.tool == tools::ROTATE || state.tool == tools::SCALE) {
        history::record(state, "{state.tool} node", "tool:{state.tool}:{state.selected}");
    }
    if found.is_valid() {
        RailDrag { delta_x: travel.x, delta_y: travel.y, node: found }
    } else {
        if state.tool == tools::ZOOM {
            shell::set_zoom(state, state.zoom - travel.y * 0.5);
        }
        nil
    }
}

/// Two fingers on the stage: pinch to dolly, drag to slide. Answered before
/// a tool sees the frame, and true while it holds the camera, so the gizmo
/// and the backend's own mouse orbit both stand off.
///
/// One finger is a mouse drag to everything below, which is the orbit a
/// cursor gets. Two is the gesture nothing else claims.
pub fn camera_gesture(state: editor::State) -> bool {
    let pinch = input::pinch();
    let pan = input::pan();
    let scale = pinch.scale.or(0.0);
    let pan_x = pan.x;
    let pan_y = pan.y;
    if scale <= 0.0 && pan_x == 0.0 && pan_y == 0.0 {
        return false;
    }
    // Where the fingers are, not where a mouse is: a sheet under them owns
    // them, the way a pointer over a sheet is the sheet's.
    let between = pinch.center.or(vec2(0.0, 0.0));
    let at = if scale > 0.0 { design_pixels(between.x, between.y) } else { pointer(state) };
    if !owns_pointer(state, at.x, at.y) {
        return false;
    }
    if state.mode2d {
        pan_zoom_2d(state, scale, pan_x, pan_y);
    } else {
        orbit_3d(state, scale, pan_x, pan_y);
    }
    true
}

/// The mouse's own camera: middle-drag orbits, right-drag pans, the wheel
/// dollies. Answered before a tool sees the frame, and true while it holds
/// the camera.
///
/// The editor drives this itself rather than leaving it to the backend. The
/// shell is one window-filling widget area, so egui claims a hovering pointer
/// everywhere in the editor and hands the backend's camera only drags: its
/// cursor memory is a drag old, and the wheel never reaches it at all.
pub fn mouse_camera(state: &mut editor::State) -> bool {
    // `mouse_position` counts physical pixels, `dpi` of them to a logical one.
    let pose = render::camera_pose();
    let dpi = pose.scale_factor;
    let dpi = util::max(dpi, 0.01);
    let at = pointer(state);
    let over = owns_pointer(state, at.x, at.y);
    let button = camera_drag(state, over);
    let scroll = input::scroll_delta();
    let wheel = scroll.y;
    let wheel = if over { wheel } else { 0.0 };
    let orbiting = button == input::MOUSE_BUTTON_MIDDLE;
    let panning = button == input::MOUSE_BUTTON_RIGHT;
    if wheel == 0.0 && !orbiting && !panning {
        return false;
    }
    let motion = input::mouse_delta();
    let motion_x = motion.x;
    let motion_y = motion.y;
    // A pan keeps the ground under the pointer, so it moves by the logical
    // pixel the stage is laid out in; an orbit turns by the physical one.
    let delta_x = if panning { motion_x / dpi } else { motion_x };
    let delta_y = if panning { motion_y / dpi } else { motion_y };
    if state.mode2d {
        let camera = render::camera_2d();
        let centre_x = camera.center.x;
        let centre_y = camera.center.y;
        let zoom = camera.zoom;
        let held = util::max(zoom, 0.01);
        let next = util::clamp(held * math::pow(dolly_step(), wheel), 0.02, 4000.0);
        if panning {
            model::set_view_2d((centre_x - delta_x / held), (centre_y + delta_y / held), next);
        } else {
            model::set_view_2d(centre_x, centre_y, next);
        }
        return true;
    }
    mouse_camera_3d(state, wheel, orbiting, panning, delta_x, delta_y);
    true
}

/// The button a camera drag holds, or -1. A drag is the camera's from a press
/// on the stage until that button comes up, wherever the pointer goes in
/// between; one pressed over a dock never is.
fn camera_drag(state: &mut editor::State, over: bool) -> int {
    if state.camera_drag >= 0 && !input::mouse_down(state.camera_drag) {
        state.camera_drag = -1;
    }
    if state.camera_drag < 0 && over {
        for button in [input::MOUSE_BUTTON_RIGHT, input::MOUSE_BUTTON_MIDDLE] {
            if input::mouse_just_pressed(button) {
                state.camera_drag = button;
            }
        }
    }
    state.camera_drag
}

// How far a pixel of drag turns the camera: the backend camera's own step, so
// a drag here moves the eye as far as one there.
const ORBIT_PER_PIXEL: float = 0.005;

/// What one unit of wheel takes off the camera's distance. macOS reports
/// scroll by the pixel and everything else by the notch, so the per-unit step
/// differs by two orders of magnitude; these are the backend camera's own
/// numbers, so the editor dollies at the speed the engine does.
pub fn dolly_step() -> float {
    if engine::target().os == MACOS { 1.0001 } else { 1.01 }
}

fn mouse_camera_3d(state: editor::State, wheel: any, orbiting: bool, panning: bool, delta_x: float, delta_y: float) {
    let pose = render::camera_pose();
    let eye_x = pose.eye.x;
    let eye_y = pose.eye.y;
    let eye_z = pose.eye.z;
    let target_x = pose.target.x;
    let target_y = pose.target.y;
    let target_z = pose.target.z;
    let fov = pose.fov;
    let offset_x = eye_x - target_x;
    let offset_y = eye_y - target_y;
    let offset_z = eye_z - target_z;
    let distance = math::sqrt(offset_x * offset_x + offset_y * offset_y + offset_z * offset_z);
    if distance < 0.0001 {
        return;
    }
    let want = util::clamp(distance / math::pow(dolly_step(), wheel.as_float()), 0.05, 10000.0);
    if orbiting {
        // The angles the backend's own camera keeps, so a drag here and a
        // drag there move the eye the same way.
        let yaw = math::atan2(offset_z, offset_x) + delta_x * ORBIT_PER_PIXEL;
        let pitch = util::clamp(math::acos(util::clamp(offset_y / distance, -1.0, 1.0)) + delta_y * ORBIT_PER_PIXEL, 0.02, 3.12);
        model::set_view_3d(target_x + want * math::cos(yaw) * math::sin(pitch), target_y + want * math::cos(pitch), target_z + want * math::sin(yaw) * math::sin(pitch), target_x, target_y, target_z);
        return;
    }
    let unit_x = offset_x / distance;
    let unit_y = offset_y / distance;
    let unit_z = offset_z / distance;
    let moved = if panning {
        let axes = slide_axes(state, [unit_x, unit_y, unit_z], want, fov);
        [
            target_x + axes[0] * (0.0 - delta_x) + axes[3] * delta_y,
            target_y + axes[1] * (0.0 - delta_x) + axes[4] * delta_y,
            target_z + axes[2] * (0.0 - delta_x) + axes[5] * delta_y,
        ]
    } else {
        [target_x, target_y, target_z]
    };
    let new_target_x = moved[0];
    let new_target_y = moved[1];
    let new_target_z = moved[2];
    model::set_view_3d(new_target_x + unit_x * want, new_target_y + unit_y * want, new_target_z + unit_z * want, new_target_x, new_target_y, new_target_z);
}

// Screen right and up in world units, scaled to the world a design pixel
// covers at the target's depth: six numbers, right then up. The scene draws
// across the whole window under the docks, so the window's height is the fov's.
fn slide_axes(state: editor::State, unit: [float], distance: float, fov: any) -> [float] {
    let unit_x = unit[0];
    let unit_y = unit[1];
    let unit_z = unit[2];
    let right = [unit_z, 0.0, 0.0 - unit_x];
    let length = math::sqrt(right[0] * right[0] + right[2] * right[2]);
    let right = if length < 0.0001 { [1.0, 0.0, 0.0] } else { [right[0] / length, 0.0, right[2] / length] };
    let up = [
        unit_y * right[2] - unit_z * right[1],
        unit_z * right[0] - unit_x * right[2],
        unit_x * right[1] - unit_y * right[0],
    ];
    let tall = util::max(state.screen_height, 1.0);
    let per_pixel = 2.0 * distance * math::tan(util::max(fov.as_float(), 0.01) / 2.0) / tall;
    let step = per_pixel / logical_per_design();
    let out = [
        right[0] * step,
        right[1] * step,
        right[2] * step,
        up[0] * step,
        up[1] * step,
        up[2] * step,
    ];
    out
}

// The 2D camera is a centre and a zoom, so a pinch is the zoom and a drag is
// the centre, both in the world units the centre is kept in.
fn pan_zoom_2d(state: editor::State, scale: float, delta_x: float, delta_y: float) {
    let camera = render::camera_2d();
    let centre_x = camera.center.x;
    let centre_y = camera.center.y;
    let zoom = camera.zoom;
    let held = util::max(zoom, 0.01);
    let next = if scale > 0.0 { util::clamp(held * scale, 0.02, 4000.0) } else { held };
    model::set_view_2d(centre_x - delta_x / next, centre_y + delta_y / next, next);
}

// The 3D camera is an eye and a target, so a pinch walks the eye along the
// line between them and a drag slides both across it.
fn orbit_3d(state: editor::State, scale: float, delta_x: float, delta_y: float) {
    let pose = render::camera_pose();
    let eye_x = pose.eye.x;
    let eye_y = pose.eye.y;
    let eye_z = pose.eye.z;
    let target_x = pose.target.x;
    let target_y = pose.target.y;
    let target_z = pose.target.z;
    let fov = pose.fov;
    let offset_x = eye_x - target_x;
    let offset_y = eye_y - target_y;
    let offset_z = eye_z - target_z;
    let distance = math::sqrt(offset_x * offset_x + offset_y * offset_y + offset_z * offset_z);
    if distance < 0.0001 {
        return;
    }
    // Apart is closer, the way a pinch out is on every phone.
    let want = if scale > 0.0 { util::clamp(distance / scale, 0.05, 10000.0) } else { distance };
    let unit_x = offset_x / distance;
    let unit_y = offset_y / distance;
    let unit_z = offset_z / distance;
    // Screen right and up in world units, from the view axis and world up.
    let right = [unit_z, 0.0, -unit_x];
    let length = math::sqrt(right[0] * right[0] + right[2] * right[2]);
    let right = if length < 0.0001 { [1.0, 0.0, 0.0] } else { [right[0] / length, 0.0, right[2] / length] };
    let up = [
        unit_y * right[2] - unit_z * right[1],
        unit_z * right[0] - unit_x * right[2],
        unit_x * right[1] - unit_y * right[0],
    ];
    // The world a design pixel covers at the target's depth, over the whole
    // window the scene draws across: the finger keeps the ground it started on.
    let tall = util::max(state.screen_height, 1.0);
    let per_pixel = 2.0 * want * math::tan(util::max(fov, 0.01) / 2.0) / tall;
    let step = per_pixel / logical_per_design();
    let new_target_x = target_x + slide(delta_x, delta_y, right, up, step, 0);
    let new_target_y = target_y + slide(delta_x, delta_y, right, up, step, 1);
    let new_target_z = target_z + slide(delta_x, delta_y, right, up, step, 2);
    model::set_view_3d(new_target_x + unit_x * want, new_target_y + unit_y * want, new_target_z + unit_z * want, new_target_x, new_target_y, new_target_z);
}

// One `axis` of a pan: the drag along screen right and up, in world units.
fn slide(delta_x: float, delta_y: float, right: [float], up: [float], step: float, axis: int) -> float {
    (0.0 - delta_x) * right[axis] * step + delta_y * up[axis] * step
}

/// steadyum's selection orange.
pub fn orange() -> [float] {
    [1.0, 0.647, 0.0]
}

/// The deep blue a hovered part tints to.
pub fn hover_color() -> [float] {
    [0.118, 0.314, 0.784]
}

/// World units per design pixel.
pub fn world_per_pixel() -> float {
    let camera = render::camera_2d();
    let zoom = camera.zoom;
    logical_per_design() / util::max(zoom, 0.01)
}

/// Whether the Snap chip is on.
pub fn snapping(state: editor::State) -> bool {
    defs::chip_on(state.chip_state, defs::WORKSPACE_SCENE, defs::CHIP_SNAP)
}

/// The gizmo part under the pointer: the dragged one wins over the hovered.
pub fn hot_part(state: editor::State) -> gizmo::Part? {
    if state.gizmo.drag != nil {
        let drag = state.gizmo.drag.unwrap();
        drag.part
    } else {
        state.gizmo.hover
    }
}

/// Whether a click at this point, in design px, is the viewport's to act on:
/// whatever the UI does not take, from an open dialog down to the seams
/// between the docks. The shell's own boxes let the pointer through.
pub fn owns_pointer(state: editor::State, point_x: float, point_y: float) -> bool {
    !ui::takes_pointer_at(vec2(point_x, point_y))
}
