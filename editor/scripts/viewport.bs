// What every viewport tool needs and each one used to define for itself: the
// selection palette, the world-per-pixel scale, and the three questions a
// tool asks about the current drag.

use defs;
use editor;
use gizmo;
use history;
use model;
use shell;
use util;

pub struct RailDrag {
    _0: any,
    _1: any,
    _2: Node?,
}

pub struct MouseCamera {
    _0: any,
    _1: any,
}

pub struct Pair23 {
    _0: any,
    _1: any,
    _2: any,
}

pub struct Pair24 {
    _0: float,
    _1: float,
    _2: float,
}

pub struct Pair25 {
    _0: any,
    _1: any,
    _2: any,
}

pub struct Pair26 {
    _0: float,
    _1: float,
    _2: float,
}

/// A rail tool's drag this frame: the pointer's travel in design px and the
/// selected node it moves, or `None` when the pointer stood still or a zoom
/// took the drag instead. Recording the history step is part of taking it.
pub fn rail_drag(S: &mut editor::State, dpi: any) -> RailDrag? {
    let dx_dy_1 = input::mouse_delta();
    let dx = dx_dy_1.at(0);
    let dy = dx_dy_1.at(1);
    dx = dx.as_float() / (dpi.as_float() * S.ui_scale);
    dy = dy.as_float() / (dpi.as_float() * S.ui_scale);
    if dx.as_float() == 0.0 && dy.as_float() == 0.0 {
        return nil;
    }
    let found_2 = model::selected(S);
    let found = found_2._1;
    if found.is_some() && (S.tool == "move" || S.tool == "rotate" || S.tool == "scale") {
        history::record(S, "{S.tool} node", "tool:{S.tool}:{S.sel}");
    }
    if found.is_some() {
        let found = found.unwrap();
        RailDrag { _0: dx, _1: dy, _2: found }
    } else {
        if S.tool == "zoom" {
            shell::set_zoom(S, S.zoom - dy.as_float() * 0.5);
        }
        nil
    }
}

/// Two fingers on the stage: pinch to dolly, drag to slide. Answered before
/// a tool sees the frame, and true while it holds the camera, so the gizmo
/// and the backend's own mouse orbit both stand off.
///
/// One finger is a mouse drag to everything below, which is the orbit a
/// cursor gets. Two is the gesture nothing else claims.
pub fn camera_gesture(S: editor::State) -> bool {
    let pinch = input::pinch();
    let pan = input::pan();
    let scale = pinch.scale.or(0.0);
    let dx = pan.x;
    let dy = pan.y;
    if scale <= 0.0 && dx == 0.0 && dy == 0.0 {
        return false;
    }
    // Where the fingers are, not where a mouse is: a sheet under them owns
    // them, the way a pointer over a sheet is the sheet's.
    let at = if scale > 0.0 {
        Vec2 { x: pinch.x.or(0.0), y: pinch.y.or(0.0) }
    } else {
        input::mouse_position()
    };
    if !owns_pointer(S, at.x / S.ui_scale, at.y / S.ui_scale) {
        return false;
    }
    if S.mode2d {
        pan_zoom_2d(S, scale, dx, dy);
    } else {
        orbit_3d(S, scale, dx, dy);
    }
    true
}

/// The mouse's own camera: middle-drag orbits, right-drag pans, the wheel
/// dollies. Answered before a tool sees the frame, and true while it holds
/// the camera.
///
/// The editor drives this itself rather than leaving it to the backend. The
/// shell is one window-filling widget area, so egui claims a hovering pointer
/// everywhere in the editor and hands the backend's camera only drags: its
/// cursor memory is a drag old, and the wheel never reaches it at all.
pub fn mouse_camera(S: &mut editor::State) -> bool {
    // `mouse_position` counts physical pixels, `dpi` of them to a logical one.
    let dpi_1 = render::camera_pose();
    let dpi = dpi_1.at(7);
    let dpi = util::max(dpi, 0.01);
    let mx_my_2 = input::mouse_position();
    let mx = mx_my_2.at(0);
    let my = mx_my_2.at(1);
    let over = owns_pointer(S, (mx / dpi).as_float() / S.ui_scale, (my / dpi).as_float() / S.ui_scale);
    let button = camera_drag(S, over);
    let wheel_3 = input::scroll_delta();
    let wheel = wheel_3.at(1);
    let wheel = if over { wheel } else { 0.0 };
    let orbiting = button == input::MOUSE_BUTTON_MIDDLE.as_int();
    let panning = button == input::MOUSE_BUTTON_RIGHT.as_int();
    if wheel.as_float() == 0.0 && !orbiting && !panning {
        return false;
    }
    let rx_ry_4 = input::mouse_delta();
    let rx = rx_ry_4.at(0);
    let ry = rx_ry_4.at(1);
    // A pan keeps the ground under the pointer, so it moves by the logical
    // pixel the stage is laid out in; an orbit turns by the physical one.
    let dx_dy_5 = if panning { MouseCamera { _0: rx / dpi, _1: ry / dpi } } else { MouseCamera { _0: rx, _1: ry } };
    let dx = dx_dy_5._0;
    let dy = dx_dy_5._1;
    if S.mode2d {
        let cx_cy_zoom_6 = render::camera_2d();
        let cx = cx_cy_zoom_6.at(0);
        let cy = cx_cy_zoom_6.at(1);
        let zoom = cx_cy_zoom_6.at(2);
        let held = util::max(zoom, 0.01);
        let next = util::clamp(held.as_float() * math::pow(dolly_step(), wheel.as_float()), 0.02, 4000.0);
        if panning {
            render::set_camera_2d((cx - dx / held).as_float(), (cy + dy / held).as_float(), next);
        } else {
            render::set_camera_2d(cx.as_float(), cy.as_float(), next);
        }
        return true;
    }
    mouse_camera_3d(S, wheel, orbiting, panning, dx, dy);
    true
}

/// The button a camera drag holds, or -1. A drag is the camera's from a press
/// on the stage until that button comes up, wherever the pointer goes in
/// between; one pressed over a dock never is.
fn camera_drag(S: &mut editor::State, over: bool) -> int {
    if S.camera_drag >= 0 && !input::mouse_down(S.camera_drag) {
        S.camera_drag = -1;
    }
    if S.camera_drag < 0 && over {
        for button in [input::MOUSE_BUTTON_RIGHT, input::MOUSE_BUTTON_MIDDLE] {
            if input::mouse_just_pressed(button.as_int()) {
                S.camera_drag = button.as_int();
            }
        }
    }
    S.camera_drag
}

// How far a pixel of drag turns the camera: the backend camera's own step, so
// a drag here moves the eye as far as one there.
const ORBIT_PER_PX: float = 0.005;

/// What one unit of wheel takes off the camera's distance. macOS reports
/// scroll by the pixel and everything else by the notch, so the per-unit step
/// differs by two orders of magnitude; these are the backend camera's own
/// numbers, so the editor dollies at the speed the engine does.
pub fn dolly_step() -> float {
    if engine::target().os.as_str() == "macos" { 1.0001 } else { 1.01 }
}

fn mouse_camera_3d(S: editor::State, wheel: any, orbiting: bool, panning: bool, dx: float, dy: float) {
    let ex_ey_ez_tx_ty_tz_fov_1 = render::camera_pose();
    let ex = ex_ey_ez_tx_ty_tz_fov_1.at(0);
    let ey = ex_ey_ez_tx_ty_tz_fov_1.at(1);
    let ez = ex_ey_ez_tx_ty_tz_fov_1.at(2);
    let tx = ex_ey_ez_tx_ty_tz_fov_1.at(3);
    let ty = ex_ey_ez_tx_ty_tz_fov_1.at(4);
    let tz = ex_ey_ez_tx_ty_tz_fov_1.at(5);
    let fov = ex_ey_ez_tx_ty_tz_fov_1.at(6);
    let ax_ay_az_2 = Pair23 { _0: ex - tx, _1: ey - ty, _2: ez - tz };
    let ax = ax_ay_az_2._0;
    let ay = ax_ay_az_2._1;
    let az = ax_ay_az_2._2;
    let dist = math::sqrt(ax * ax + ay * ay + az * az);
    if dist < 0.0001 {
        return;
    }
    let want = util::clamp(dist / math::pow(dolly_step(), wheel.as_float()), 0.05, 10000.0);
    if orbiting {
        // The angles the backend's own camera keeps, so a drag here and a
        // drag there move the eye the same way.
        let yaw = math::atan2(az, ax) + dx * ORBIT_PER_PX;
        let pitch = util::clamp(math::acos(util::clamp(ay / dist, -1.0, 1.0)) + dy * ORBIT_PER_PX, 0.02, 3.12);
        render::set_camera(tx.as_float() + want * math::cos(yaw) * math::sin(pitch), ty.as_float() + want * math::cos(pitch), tz.as_float() + want * math::sin(yaw) * math::sin(pitch), tx.as_float(), ty.as_float(), tz.as_float());
        return;
    }
    let ux_uy_uz_3 = Pair24 { _0: ax / dist, _1: ay / dist, _2: az / dist };
    let ux = ux_uy_uz_3._0;
    let uy = ux_uy_uz_3._1;
    let uz = ux_uy_uz_3._2;
    let moved = if panning {
        let s = slide_axes(S, [ux, uy, uz], want, fov);
        [
            tx.as_float() + s[0] * (0.0 - dx) + s[3] * dy,
            ty.as_float() + s[1] * (0.0 - dx) + s[4] * dy,
            tz.as_float() + s[2] * (0.0 - dx) + s[5] * dy,
        ]
    } else {
        [tx, ty, tz]
    };
    let nx_ny_nz_4 = Pair25 { _0: moved[0], _1: moved[1], _2: moved[2] };
    let nx = nx_ny_nz_4._0;
    let ny = nx_ny_nz_4._1;
    let nz = nx_ny_nz_4._2;
    render::set_camera(nx + ux * want, ny + uy * want, nz + uz * want, nx, ny, nz);
}

// Screen right and up in world units, scaled to the world a design pixel
// covers at the target's depth: six numbers, right then up. The scene draws
// across the whole window under the docks, so the window's height is the fov's.
fn slide_axes(S: editor::State, u: [float], dist: float, fov: any) -> [float] {
    let ux_uy_uz_1 = Pair26 { _0: u[0], _1: u[1], _2: u[2] };
    let ux = ux_uy_uz_1._0;
    let uy = ux_uy_uz_1._1;
    let uz = ux_uy_uz_1._2;
    let right = [uz, 0.0, 0.0 - ux];
    let len = math::sqrt(right[0] * right[0] + right[2] * right[2]);
    let right = if len < 0.0001 { [1.0, 0.0, 0.0] } else { [right[0] / len, 0.0, right[2] / len] };
    let up = [
        uy * right[2] - uz * right[1],
        uz * right[0] - ux * right[2],
        ux * right[1] - uy * right[0],
    ];
    let tall = util::max(S.screen_h, 1.0);
    let per_px = 2.0 * dist * math::tan(util::max(fov, 0.01).as_float() / 2.0) / tall;
    let step = per_px / util::max(S.ui_scale, 0.01);
    let out = [
        right[0] * step,
        right[1] * step,
        right[2] * step,
        up[0] * step,
        up[1] * step,
        up[2] * step,
    ];
    out
}

// The 2D camera is a centre and a zoom, so a pinch is the zoom and a drag is
// the centre, both in the world units the centre is kept in.
fn pan_zoom_2d(S: editor::State, scale: float, dx: float, dy: float) {
    let cx_cy_zoom_1 = render::camera_2d();
    let cx = cx_cy_zoom_1.at(0);
    let cy = cx_cy_zoom_1.at(1);
    let zoom = cx_cy_zoom_1.at(2);
    let held = util::max(zoom, 0.01);
    let next = if scale > 0.0 { util::clamp(held.as_float() * scale, 0.02, 4000.0) } else { held };
    render::set_camera_2d(cx.as_float() - dx / next.as_float(), cy.as_float() + dy / next.as_float(), next.as_float());
}

// The 3D camera is an eye and a target, so a pinch walks the eye along the
// line between them and a drag slides both across it.
fn orbit_3d(S: editor::State, scale: float, dx: float, dy: float) {
    let ex_ey_ez_tx_ty_tz_fov_1 = render::camera_pose();
    let ex = ex_ey_ez_tx_ty_tz_fov_1.at(0);
    let ey = ex_ey_ez_tx_ty_tz_fov_1.at(1);
    let ez = ex_ey_ez_tx_ty_tz_fov_1.at(2);
    let tx = ex_ey_ez_tx_ty_tz_fov_1.at(3);
    let ty = ex_ey_ez_tx_ty_tz_fov_1.at(4);
    let tz = ex_ey_ez_tx_ty_tz_fov_1.at(5);
    let fov = ex_ey_ez_tx_ty_tz_fov_1.at(6);
    let ax = ex - tx;
    let ay = ey - ty;
    let az = ez - tz;
    let dist = math::sqrt(ax * ax + ay * ay + az * az);
    if dist < 0.0001 {
        return;
    }
    // Apart is closer, the way a pinch out is on every phone.
    let want = if scale > 0.0 { util::clamp(dist / scale, 0.05, 10000.0) } else { dist };
    let ux = ax / dist;
    let uy = ay / dist;
    let uz = az / dist;
    // Screen right and up in world units, from the view axis and world up.
    let right = [uz, 0.0, -ux];
    let len = math::sqrt(right[0] * right[0] + right[2] * right[2]);
    let right = if len < 0.0001 { [1.0, 0.0, 0.0] } else { [right[0] / len, 0.0, right[2] / len] };
    let up = [
        uy * right[2] - uz * right[1],
        uz * right[0] - ux * right[2],
        ux * right[1] - uy * right[0],
    ];
    // The world a design pixel covers at the target's depth, over the whole
    // window the scene draws across: the finger keeps the ground it started on.
    let tall = util::max(S.screen_h, 1.0);
    let per_px = 2.0 * want * math::tan(util::max(fov, 0.01) / 2.0) / tall;
    let step = per_px / util::max(S.ui_scale, 0.01);
    let nx = tx + slide(dx, dy, right, up, step, 0);
    let ny = ty + slide(dx, dy, right, up, step, 1);
    let nz = tz + slide(dx, dy, right, up, step, 2);
    render::set_camera(nx + ux * want, ny + uy * want, nz + uz * want, nx, ny, nz);
}

// Axis `i` of a pan: the drag along screen right and up, in world units.
fn slide(dx: float, dy: float, right: [float], up: [float], step: float, i: int) -> float {
    (0.0 - dx) * right[i] * step + dy * up[i] * step
}

/// steadyum's selection orange.
pub fn orange() -> [float] {
    [1.0, 0.647, 0.0]
}

/// The deep blue a hovered part tints to.
pub fn hover_color() -> [float] {
    [0.118, 0.314, 0.784]
}

/// World units per design pixel (design px = logical px / ui scale).
pub fn world_per_px(S: editor::State) -> float {
    let zoom_1 = render::camera_2d();
    let zoom = zoom_1.at(2);
    S.ui_scale / util::max(zoom, 0.01).as_float()
}

/// Whether the Snap chip is on.
pub fn snapping(S: editor::State) -> any {
    defs::chip_on(S, defs::WORKSPACE_SCENE, defs::CHIP_SNAP)
}

/// The gizmo part under the pointer: the dragged one wins over the hovered.
pub fn hot_part(S: editor::State) -> gizmo::Part2? {
    if S.gizmo.drag.is_some() {
        let drag = S.gizmo.drag.unwrap();
        drag.part
    } else {
        S.gizmo.hover
    }
}

/// Whether a click at this point, in design px, is the viewport's to act on:
/// whatever the UI does not take, from an open dialog down to the seams
/// between the docks. The shell's own boxes let the pointer through.
pub fn owns_pointer(S: editor::State, x: float, y: float) -> bool {
    !ui::takes_pointer_at(x, y)
}
