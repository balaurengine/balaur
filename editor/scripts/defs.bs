use icons;
use words::dock_fields;
use words::panel_keys;
use words::tabs;
use words::tools;

const ASSETS: str = "assets";
const BONE: str = "bone";
const DEBUGGER: str = "debugger";
const DOCS: str = "docs";
const IMPORT: str = "import";
const INSPECTOR: str = "inspector";
const KEY: str = "key";
const LIBRARY: str = "library";
const MOVE: str = "move";
const OUTLINE: str = "outline";
const OUTPUT: str = "output";
const POLYGON: str = "polygon";
const PROBLEMS: str = "problems";
const PROFILER: str = "profiler";
const SCALE: str = "scale";
const SCENE: str = "scene";
const SELECT: str = "select";
const STATEMACHINE: str = "statemachine";
const TILES: str = "tiles";
const TIMELINE: str = "timeline";
const ZOOM: str = "zoom";

pub struct Workspace {
    internal id: str,
    internal name: str,
    internal icon: str,
}

/// A viewport chip: its key, its label, and what it starts as; nil for one
/// the engine backs, which `shell::chip_value` reads live each frame.
pub struct Chip {
    internal key: str,
    internal label: str,
    internal starts: bool?,
}

fn chip(key: str, label: str, starts: bool?) -> Chip {
    Chip { key: key, label: label, starts: starts }
}

/// The id each workspace is known by; `workspaces` lists them in order.
pub const WORKSPACE_SCENE: str = "scene";

pub const WORKSPACE_SCRIPT: str = "script";

pub const WORKSPACE_ANIMATION: str = "animation";

pub const WORKSPACE_PHYSICS: str = "physics";

pub const WORKSPACE_UI: str = "ui";

/// The viewport chips by key; `chips` says which workspace shows each and
/// what it starts as.
pub const CHIP_PROJECTION: str = "proj";

pub const CHIP_SNAP: str = "snap";

pub const CHIP_GUIDES: str = "guides";

pub const CHIP_LIGHTS: str = "lights";

pub const CHIP_PATH: str = "path";

pub const CHIP_COLLIDERS: str = "colliders";

pub const CHIP_SLEEP: str = "sleep";

pub const CHIP_SAFE: str = "safe";

pub const CHIP_RESOLUTION: str = "res";

pub fn workspaces() -> [Workspace] {
    [
        Workspace { id: WORKSPACE_SCENE, name: "Scene", icon: icons::workspace(WORKSPACE_SCENE) },
        Workspace { id: WORKSPACE_SCRIPT, name: "Script", icon: icons::workspace(WORKSPACE_SCRIPT) },
        Workspace { id: WORKSPACE_ANIMATION, name: "Animation", icon: icons::workspace(WORKSPACE_ANIMATION) },
        Workspace { id: WORKSPACE_PHYSICS, name: "Physics", icon: icons::workspace(WORKSPACE_PHYSICS) },
        Workspace { id: WORKSPACE_UI, name: "UI", icon: icons::workspace(WORKSPACE_UI) },
    ]
}

/// The panels a workspace opens, per dock, and which of them it brings
/// forward. A workspace says what to have open, not what may be opened: the
/// logo menu adds and the tab marks close whatever the work needs after that.
pub fn workspace_docks(id: str) -> any {
    if id == tabs::SCRIPT {
        docks([SCENE, OUTLINE], [OUTPUT, PROBLEMS, DOCS, DEBUGGER], [panel_keys::INSPECTOR])
    } else if id == tabs::ANIMATION {
        docks([SCENE, OUTLINE], [TIMELINE, STATEMACHINE, OUTPUT, LIBRARY], [panel_keys::INSPECTOR])
    } else if id == tabs::PHYSICS {
        docks([panel_keys::SCENE], [OUTPUT, PROBLEMS, PROFILER], [panel_keys::INSPECTOR])
    } else if id == tabs::UI {
        docks([SCENE, OUTLINE], [OUTPUT, PROBLEMS, ASSETS], [INSPECTOR, IMPORT])
    } else {
        docks([SCENE, OUTLINE], [OUTPUT, PROBLEMS, ASSETS], [INSPECTOR, IMPORT])
    }
}

fn docks(left: [str], bottom: [str], right: [str]) -> any {
    {
        dock_fields::LEFT: { dock_fields::TABS: left, dock_fields::ACTIVE: left[0], dock_fields::SHUT: false },
        dock_fields::BOTTOM: { dock_fields::TABS: bottom, dock_fields::ACTIVE: bottom[0], dock_fields::SHUT: false },
        dock_fields::RIGHT: { dock_fields::TABS: right, dock_fields::ACTIVE: right[0], dock_fields::SHUT: false },
    }
}

pub fn workspace_name(id: str) -> str {
    for workspace in workspaces() {
        if workspace.id == id {
            return workspace.name;
        }
    }
    id
}

// Only tools something reads: a button that sets `state.tool` and is then ignored
// advertises an editor that does not exist. Re-add each on its `gizmo` handler.
pub fn tools(workspace: str) -> [str] {
    if workspace == tabs::SCENE {
        [SELECT, MOVE, "rotate", SCALE, "pen", TILES, ZOOM]
    } else if workspace == tabs::ANIMATION {
        [SELECT, MOVE, BONE, POLYGON, KEY, ZOOM]
    } else if workspace == tabs::PHYSICS {
        [SELECT, MOVE, POLYGON, ZOOM]
    } else if workspace == tabs::UI {
        [SELECT, MOVE, ZOOM]
    } else {
        []
    }
}

pub fn tool_name(tool: str) -> str {
    if tool == tools::SELECT {
        "Select"
    } else if tool == tools::MOVE {
        "Translate"
    } else if tool == tools::ROTATE {
        "Rotate"
    } else if tool == tools::SCALE {
        "Scale"
    } else if tool == tools::ZOOM {
        "Zoom"
    } else if tool == tools::KEY {
        "Keyframe"
    } else if tool == tools::BONE {
        "Rig bone"
    } else if tool == tools::POLYGON {
        "Polygon"
    } else if tool == tools::PEN {
        "Pen"
    } else if tool == tools::TILES {
        "Tiles"
    } else {
        tool
    }
}

pub fn tool_icon(tool: str) -> str {
    icons::tool(tool)
}

/// The viewport's overlay chips in a workspace.
pub fn chips(workspace: str) -> [Chip] {
    if workspace == tabs::SCENE {
        [
            chip(CHIP_PROJECTION, "3D · Perspective", true),
            chip(CHIP_SNAP, "Snap 8 px", false),
            chip(CHIP_GUIDES, "Guides", false),
            chip(CHIP_LIGHTS, "Lights", true),
        ]
    } else if workspace == tabs::ANIMATION {
        [chip(CHIP_PATH, "Motion path", true), chip(CHIP_SNAP, "Snap 8 px", false)]
    } else if workspace == tabs::PHYSICS {
        [chip(CHIP_COLLIDERS, "Show colliders", true), chip(CHIP_SLEEP, "Sleep bodies")]
    } else if workspace == tabs::UI {
        [chip(CHIP_SAFE, "Safe area", true), chip(CHIP_RESOLUTION, "1920 × 1080", false)]
    } else {
        []
    }
}

/// Whether a chip is on in a workspace: what `chip_states`, the editor's
/// `chip_state` by workspace, holds for it, or what `chips` starts it as
/// before the chip is first drawn.
pub fn chip_on(chip_states: any, workspace: str, key: str) -> bool {
    let held = chip_states[workspace][key];
    if held != nil {
        return held.as_bool();
    }
    for chip in chips(workspace) {
        if chip.key == key {
            return chip.starts.or(false);
        }
    }
    false
}
