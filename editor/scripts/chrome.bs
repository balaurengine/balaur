// The one bar across the top — brand, workspaces, the open documents, and the
// transport, command and theme controls — and the status strip the bottom
// dock carries at its foot, which is all of it once minimised.

use defs;
use docks;
use dropin;
use editor;
use history;
use icons;
use layout;
use manager;
use menu;
use model;
use session;
use shell;
use util;
use words::command;
use words::dock_fields;
use words::fields;
use words::layout_fields;
use words::log_fields;
use words::panel_keys;
use words::project_fields;
use words::roles;
use words::tabs;

const DARK_CHROME: str = "dark_chrome";

const FILE: str = "file";

/// The mark and the name at the head of the bar.
pub struct Brand {
    logo: str,
    name: str,
}

/// A control's centre in design px.
pub struct Spot {
    internal x: float,
    internal y: float,
}

pub struct FillImports {
    internal shown: bool,
    internal bar: bool,
    internal value: float,
    internal until: float,
}

// What the head sheet keeps inside its edge, plus the row's own first step.
const PAD_X: float = 7.0;

// The brand mark, and the name beside it when there is room.
const MARK_WIDTH: float = 24.0;

const NAME_WIDTH: float = 52.0;

// The transport's three buttons: 26 px each on 3 px spacing, in an 87 px block.
const BUTTON_PITCH: float = 29.0;

const BLOCK_WIDTH: float = 87.0;

// The theme switch and the command pill at the bar's right end.
const THEME_WIDTH: float = 26.0;

const COMMAND_WIDTH: float = 118.0;

const COMMAND_WIDTH_COMPACT: float = 26.0;

// The dock plate under the dark mark: the mark's own dark ink, #14181d.
fn DARK_PLATE() -> Color {
    color(0.078, 0.094, 0.114, 1.0)
}

// One document tab, as the showcase's pointer estimates it.
const TAB_WIDTH: float = 104.0;

// Here rather than in editor.bs, whose own `window` module hides the engine's.
// A dark system gets the light-inked mark on a dark plate.
pub fn set_app_icon(dark: bool) {
    if dark {
        window::set_app_icon("assets/balaur-logo-dark.png", window::AppIconOptions { plate: DARK_PLATE() });
    } else {
        window::set_app_icon("assets/balaur-logo.png");
    }
}

// The edited project's mark, when it ships one, else balaur's. A project
// that brought its own logo gets its own name beside it too.
fn brand_logo(state: editor::State) -> str {
    let named = declared_icon(state);
    if named != "" && fs::exists(state.game_root + "/" + named) {
        return state.game_root + "/" + named;
    }
    for rel in ["icon.png", "assets/icon.png", "assets/logo.png"] {
        if fs::exists(state.game_root + "/" + rel) {
            return state.game_root + "/" + rel;
        }
    }
    ""
}

// `[application] icon`, or "" for a project that names none.
fn declared_icon(state: editor::State) -> str {
    let text = fs::read(state.game_root + "/project.toml");
    if text == nil {
        return "";
    }
    toml::parse(text.unwrap())[project_fields::APPLICATION][fields::ICON].as_str()
}

// Answered once per session: whether the project ships a mark is up to five disk
// reads, and the bar asked for them on every frame it drew.
fn brand(state: &mut editor::State) -> Brand {
    if state.brand != nil {
        return state.brand.unwrap();
    }
    let logo = brand_logo(state);
    let found = if logo == "" {
        Brand { logo: "assets/balaur-logo.png", name: "Balaur" }
    } else {
        Brand { logo: logo, name: state.game_name }
    };
    state.brand = found;
    found
}

fn plural(count: int, word: str) -> str {
    if count == 1 { word } else { word + "s" }
}

// Where the first workspace pill starts, after the brand.
fn workspaces_x(state: editor::State) -> float {
    let name = if state.compact { 0.0 } else { 3.0 + NAME_WIDTH };
    state.layout[dock_fields::BAR]["x"].as_float() + PAD_X + 2.0 + MARK_WIDTH + name + 8.0
}

/// Where one workspace pill's centre lands in the bar, in design px, so the
/// showcase's drawn cursor can be put on the pill its command presses.
pub fn workspace_spot(state: editor::State, id: str) -> Spot {
    let bar: any = state.layout[dock_fields::BAR];
    let per = layout::workspace_width(state);
    let slot = 0;
    let workspaces = defs::workspaces();
    for index in 0..workspaces.len() {
        let workspace = workspaces[index];
        if workspace.id == id {
            slot = index;
        }
    }
    let found = spot_of(STRIP_NODE + "/" + WORKSPACE + "{slot + 1}");
    if found != nil {
        let spot = found.unwrap();
        return spot;
    }
    // `return`: a bare tuple after a block parses as a call on the block.
    return Spot { x: workspaces_x(state) + ((slot as float) + 0.5) * per, y: bar["y"].as_float() + bar[layout_fields::HEIGHT].as_float() / 2.0 };
}

/// Where a document tab's centre lands: the scene's, then the script's.
pub fn doc_spot(state: editor::State, id: str) -> Spot {
    let bar: any = state.layout[dock_fields::BAR];
    let per = layout::workspace_width(state);
    let first = workspaces_x(state) + (defs::workspaces().len() as float) * per + 12.0;
    let slot = if id == tabs::SCRIPT { 1.0 } else { 0.0 };
    let found = spot_of(DOCS_NODE + "/" + id);
    if found != nil {
        let spot = found.unwrap();
        return spot;
    }
    return Spot { x: first + slot * (TAB_WIDTH + 4.0) + TAB_WIDTH / 2.0, y: bar["y"].as_float() + bar[layout_fields::HEIGHT].as_float() / 2.0 };
}

/// Where the Focus chip sits, so the showcase's drawn cursor lands on the
/// control its command presses.
pub fn focus_spot(state: editor::State) -> Spot {
    let bar: any = state.layout[dock_fields::BAR];
    let found = spot_of(STRIP_NODE + "/" + command::FOCUS);
    if found != nil {
        let spot = found.unwrap();
        return spot;
    }
    return Spot { x: bar["x"].as_float() + bar[layout_fields::WIDTH].as_float() / 2.0, y: bar["y"].as_float() + bar[layout_fields::HEIGHT].as_float() / 2.0 };
}

/// Where one of the transport's three buttons sits: play, pause, stop.
pub fn transport_spot(state: editor::State, index: int) -> Spot {
    let bar: any = state.layout[dock_fields::BAR];
    let names = [command::PLAY, command::PAUSE, command::STOP];
    let found = spot_of(STRIP_NODE + "/" + names[index]);
    if found != nil {
        let spot = found.unwrap();
        return spot;
    }
    let command_width = if state.compact { COMMAND_WIDTH_COMPACT } else { COMMAND_WIDTH };
    let block = (bar["x"].as_float() + bar[layout_fields::WIDTH].as_float()) - PAD_X - THEME_WIDTH - 4.0 - command_width - 6.0 - BLOCK_WIDTH;
    return Spot { x: block + 14.0 + (index as float) * BUTTON_PITCH, y: bar["y"].as_float() + bar[layout_fields::HEIGHT].as_float() / 2.0 };
}

/// The centre of the control at `path`, in design px, from where it drew;
/// `None` until it has drawn, when a caller estimates instead.
fn spot_of(path: str) -> Spot? {
    let node = scene::root().get_node(path);
    if !node.is_valid() {
        return nil;
    }
    let rect = ui::widget_rect(node);
    if rect == nil {
        return nil;
    }
    let box = rect.unwrap();
    Spot { x: box.x + box.width / 2.0, y: box.y + box.height / 2.0 }
}

// The strip beside the brand, which every control past it lives on.
const STRIP_NODE: str = "Editor/Shell/Head/HeadRow/HeadScroll/HeadStrip";

const DOCS_NODE: str = "Editor/Shell/Head/HeadRow/HeadScroll/HeadStrip/Docs";

const WORKSPACE: str = "workspace_";

const PICK: str = "Pick";

const BRAND_NODE: str = "Editor/Shell/Head/HeadRow/Brand";

const STATUS_NODE: str = "Editor/Shell/Body/Centre/Bottom/Status";

/// The brand: the project's mark and name on the menu node the scene lays
/// out, the menu's rows under it, and the strip. What the bar's script asks
/// for on `chrome_changed`.
pub fn fill(state: &mut editor::State) {
    // The start screen has the window to itself, and no project to name.
    if manager::showing(state) {
        return;
    }
    let tokens = state.theme;
    let mark = brand(state);
    let node = scene::root().get_node(BRAND_NODE);
    if node.is_valid() {
        node.widget_button.image = mark.logo;
        node.widget.text = mark.name;
        node.widget_button.trailing_icon = icons::ui(icons::CARET_DOWN);
        node.widget_menu.showing = state.menu_open;
        menu::fill(state, node);
    }
    strip(state, tokens);
    docs(state);
}

/// What the whole bar is built from, which `signals::chrome` compares.
pub fn key(state: &mut editor::State) -> [any] {
    [menu_key(state), strip_key(state, state.theme), state.menu_open, state.game_name, manager::showing(state)]
}

// The menu lists every panel, ticked where it is open, under the names the
// Outline's among them changes.
fn menu_key(state: &mut editor::State) -> [any] {
    [
        state.workspace,
        "{state.docks}",
        docks::name(state, tabs::OUTLINE),
        state.registry.panels.len(),
    ]
}

// What the strip is built from: the workspace and the toggles beside it, the
// open documents and whether they are saved, the transport, and the theme.
fn strip_key(state: editor::State, tokens: any) -> [any] {
    let replaying = session::loaded(state);
    let paused = if replaying {
        replay::state() == replay::STATE_PAUSED
    } else {
        state.playing && physics::is_paused()
    };
    [
        state.workspace,
        state.compact,
        state.split,
        state.focus,
        state.touchscreen,
        state.selected,
        state.nodes.len(),
        state.history.past.len(),
        state.playing,
        replaying,
        paused,
        state.theme_revision,
        state.scene_rel,
        history::dirty(state),
        state.script_open,
        "{state.script_dirty}",
        state.events_open,
        state.doctab,
    ]
}

// What each of the bar's buttons reads now: the workspaces, the split and
// the focus, the transport, the theme and the palette.
fn strip(state: editor::State, tokens: any) {
    let strip = scene::root().get_node(STRIP_NODE);
    if !strip.is_valid() {
        return;
    }
    let named = !state.compact;
    let spaces = defs::workspaces();
    for index in 0..spaces.len() {
        let workspace = spaces[index];
        let node = strip.get_node(WORKSPACE + "{index + 1}");
        face(node, if named { workspace.name } else { "" }, workspace.icon, workspace.name);
        node.widget_check.checked = state.workspace == workspace.id;
    }
    let split = strip.get_node(command::SPLIT);
    face(split, if named { "Split" } else { "" }, icons::ui(icons::SPLIT), "Show the code and the viewport at once (⌘\\)");
    split.widget_check.checked = state.split;
    // Beside the split, because the two are the same question: how much of the
    // window the code is worth.
    let can_focus = state.focus || shell::focus_target(state);
    let focus = strip.get_node(command::FOCUS);
    let focus_tip = if state.focus {
        "Put the docks back (⇧⌘\\)"
    } else if can_focus {
        "Give the code the whole window (⇧⌘\\)"
    } else {
        "The selection has no script to focus"
    };
    face(focus, if named { "Focus" } else { "" }, icons::ui(if state.focus { "unfocus" } else { command::FOCUS }), focus_tip);
    focus.widget_check.checked = state.focus;
    focus.widget.enabled = can_focus;
    transport(state, strip);
    let dark = tokens[panel_keys::DARK].as_bool();
    face(strip.get_node(DARK_CHROME), "", icons::ui(if dark { icons::DARK } else { icons::LIGHT }), "Toggle theme");
    face(strip.get_node(command::PALETTE), if named { "Run a command" } else { "" }, icons::ui(icons::SEARCH), "⌘K");
}

fn face(node: Node, text: str, icon: str, tooltip: str) {
    node.widget.text = text;
    node.widget_button.icon = icon;
    node.widget.tooltip = tooltip;
}

// The open documents: the scene, always; the selection's script and the event
// bindings while they are open.
fn docs(state: editor::State) {
    let host = scene::root().get_node(DOCS_NODE);
    if !host.is_valid() {
        return;
    }
    let scene = util::last_segment(state.scene_rel) + (if history::dirty(state) { " ●" } else { "" });
    doc_tab(state, host, tabs::SCENE, icons::panel(icons::SCENE), scene, true);
    let attached = model::script_rel(model::selected_node(state));
    let label = if attached != nil {
        let script = attached;
        let dirty = state.script_dirty.has(state.game_root + "/" + script.as_str());
        util::last_segment(script.as_str()) + (if dirty { " ●" } else { "" })
    } else {
        "no script"
    };
    doc_tab(state, host, tabs::SCRIPT, icons::ui(icons::SCRIPTFILE), label, state.script_open);
    doc_tab(state, host, tabs::EVENTS, icons::ui(icons::EVENTS), command::BINDINGS, state.events_open);
}

// One open document's tab, its tile lit while it is the one showing.
fn doc_tab(state: editor::State, host: Node, id: str, icon: str, label: str, open: bool) {
    let tile = host.get_node(id);
    tile.set_visible(open);
    if !open {
        return;
    }
    let active = state.doctab == id;
    tile.widget.role = if active { roles::TILE_TAB_PRIMARY } else { roles::TILE_TAB };
    let pick = tile.get_node(PICK);
    pick.widget.text = label;
    pick.widget_button.icon = icon;
    pick.widget_check.checked = active;
}

// Play, pause and stop; the last two are off until something runs.
fn transport(state: editor::State, strip: Node) {
    let replaying = session::loaded(state);
    let running = state.playing || replaying;
    let paused = if replaying {
        replay::state() == replay::STATE_PAUSED
    } else {
        state.playing && (physics::is_paused())
    };
    let play = strip.get_node(command::PLAY);
    face(play, "", icons::ui(command::PLAY), if state.playing { "Stop the scene (F5)" } else { "Run the scene (F5)" });
    play.widget_check.checked = state.playing;
    let pause = strip.get_node(command::PAUSE);
    let pause_tip = if !running {
        "Run the scene first"
    } else if replaying {
        "Pause playback"
    } else {
        "Pause simulation"
    };
    face(pause, "", icons::ui(command::PAUSE), pause_tip);
    pause.widget_check.checked = paused;
    pause.widget.enabled = running;
    let stop = strip.get_node(command::STOP);
    face(stop, "", icons::ui(command::STOP), if running { "Stop" } else { "Nothing is running" });
    stop.widget.enabled = running;
}

/// The status strip: what the editor is doing, how big the scene is, and the
/// workspace and tool in hand. `room` is the width it has; `trailing` draws
/// whatever the dock wants at the far right, which minimised is the handle
/// that reopens it.
/// The status strip's controls. The scene owns the row; this says what goes
/// in it, so the theme dresses the labels rather than the call site.
// Every import of the batch, top right under the bar: one line each, and one
// bar for the lot of them. It takes no pointer: a root over the viewport would
// swallow clicks meant for the scene.
const IMPORTS: str = "Editor/Imports";

const LINE_SCENE: str = "scenes/items/note_line.toml";

/// Fill the import list's lines and say what its bar and its clock read: what
/// the list's script asks for when an import reported.
pub fn fill_imports(state: &mut editor::State) -> FillImports {
    dropin::sweep(state);
    let lines: [str] = [];
    for source in state.jobs.keys() {
        let job = state.jobs[source];
        let name = job[fields::NAME].as_str();
        let done = job[log_fields::DONE].as_int();
        let files = job[project_fields::FILES].as_int();
        lines.push(if job[layout_fields::OVER].as_str() == "" {
            if files > 0 { "{name} {done}/{files}" } else { name }
        } else {
            "{name} {job["over"].as_str()} · {done} {plural(done, FILE)}"
        });
    }
    let items: [scene::RepeatItem] = [];
    for at in 0..lines.len() {
        items.push(scene::RepeatItem { key: "{at}", scene: LINE_SCENE });
    }
    let nodes = scene::repeat(scene::root().get_node(IMPORTS + "/Lines"), items);
    for at in 0..lines.len() {
        nodes[at].widget.text = lines[at];
    }
    let totals = dropin::job_totals(state);
    FillImports {
        shown: lines.len() > 0,
        bar: totals.files > 0,
        value: if totals.files > 0 { (totals.done as float) / (totals.files as float) } else { 0.0 },
        until: dropin::kept_until(state),
    }
}

/// The status strip, what its script asks for on `status_changed`.
pub fn fill_status(state: &mut editor::State) {
    status(state, state.layout[dock_fields::BOTTOM][layout_fields::WIDTH].as_float());
}

/// What the strip is built from: `status_mode` carries the pause, the play,
/// the frame rate while playing and an import in flight; the rows and the
/// steps taken stand for the node and script counts.
pub fn status_key(state: editor::State) -> [any] {
    [status_mode(state), state.playing, state.theme_revision, state.layout[dock_fields::BOTTOM][layout_fields::WIDTH], state.nodes.len(), state.history.past.len(), state.workspace, state.tool]
}

fn status_mode(state: editor::State) -> str {
    if state.debug.paused.kind() == types::KIND_MAP {
        return "paused · {state.debug.paused_rel}:{state.debug.paused["line"]}";
    }
    if state.playing {
        let recording = if state.session.recording != "" { "recording · " } else { "" };
        return "playing · {recording}{state.fps as int} fps";
    }
    // An import in flight is the state, and no more than that: which files
    // and how far along are the toast's, which draws them in one pass.
    if dropin::in_flight(state) > 0 {
        return "importing";
    }
    "editing"
}

// Narrow: the columns go one at a time rather than running together.
fn status(state: editor::State, room: float) {
    let strip = scene::root().get_node(STATUS_NODE);
    if !strip.is_valid() {
        return;
    }
    let stopped = state.debug.paused.kind() == types::KIND_MAP;
    strip.get_node("Lamp").widget.role = if stopped {
        roles::MARK_LAMP_PRIMARY
    } else if state.playing {
        roles::MARK_LAMP_SUCCESS
    } else {
        roles::MARK_LAMP
    };
    strip.get_node("Mode").widget.text = status_mode(state);
    let stats = strip.get_node("Stats");
    stats.set_visible(room > 300.0);
    if room > 300.0 {
        let counts = model::stats(state);
        let nodes = counts.nodes;
        let scripts = counts.scripts;
        stats.widget.text = "{nodes} {plural(nodes, "node")} · {scripts} {plural(scripts, tabs::SCRIPT)}";
    }
    strip.get_node("Backend").set_visible(room > 560.0);
    let place = strip.get_node("Place");
    place.set_visible(room > 420.0);
    place.widget.text = "{defs::workspace_name(state.workspace)} · {defs::tool_name(state.tool)}";
}
