// The one bar across the top — brand, workspaces, the open documents, and the
// transport, command and theme controls — and the status strip the bottom
// dock carries at its foot, which is all of it once minimised.

use defs;
use docks;
use dropin;
use editor;
use history;
use icons;
use layout;
use manager;
use menu;
use model;
use pool;
use session;
use shell;
use theme;
use util;

/// The mark and the name at the head of the bar.
pub struct Brand {
    logo: str,
    name: str,
}

/// A control's centre in design px.
pub struct Spot {
    internal x: float,
    internal y: float,
}

pub struct FillImports {
    shown: bool,
    bar: bool,
    value: float,
    until: float,
}

// What the head sheet keeps inside its edge, plus the row's own first step.
const PAD_X: float = 7.0;

// The brand mark, and the name beside it when there is room.
const MARK_WIDTH: float = 24.0;

const NAME_WIDTH: float = 52.0;

// The transport's three buttons: 26 px each on 3 px spacing, in an 87 px block.
const BUTTON_PITCH: float = 29.0;

const BLOCK_WIDTH: float = 87.0;

// The theme switch and the command pill at the bar's right end.
const THEME_WIDTH: float = 26.0;

// The play triangle fills its em box where the pause bars and the stop square
// sit inside theirs, so at one font size the three do not read as one set.
const PLAY_SIZE: float = 11.0;

const STEP_SIZE: float = 16.0;

const COMMAND_WIDTH: float = 118.0;

const COMMAND_WIDTH_COMPACT: float = 26.0;

// The dock plate under the dark mark: the mark's own dark ink, #14181d.
fn DARK_PLATE() -> [float] {
    [0.078, 0.094, 0.114]
}

// One document tab, as the showcase's pointer estimates it.
const TAB_WIDTH: float = 104.0;

// The bar's own row, a step shorter in a small window.
fn row_height(state: editor::State) -> float {
    if state.touchscreen { 33.0 } else if state.compact { 26.0 } else { 30.0 }
}

/// The tabs sit a little inside the bar where a cursor drives them. Under a
/// finger everything in the bar is one height, so no two of them disagree.
fn tab_height(state: editor::State) -> float {
    if state.touchscreen { row_height(state) } else { row_height(state) - 4.0 }
}

/// An icon-only control is square, and states it: left to itself a button is
/// as wide as its glyph plus the theme's side padding, which is a different
/// width per glyph and squeezes the glyph off centre in a stated box.
fn icon_width(state: editor::State) -> float {
    row_height(state)
}

// Here rather than in editor.bs, whose own `window` module hides the engine's.
// A dark system gets the light-inked mark on a dark plate.
pub fn set_app_icon(dark: bool) {
    if dark {
        window::set_app_icon("assets/balaur-logo-dark.png", window::AppIconOptions { plate: DARK_PLATE() });
    } else {
        window::set_app_icon("assets/balaur-logo.png");
    }
}

// The edited project's mark, when it ships one, else balaur's. A project
// that brought its own logo gets its own name beside it too.
fn brand_logo(state: editor::State) -> str {
    let named = declared_icon(state);
    if named != "" && fs::exists(state.game_root + "/" + named) {
        return state.game_root + "/" + named;
    }
    for rel in ["icon.png", "assets/icon.png", "assets/logo.png"] {
        if fs::exists(state.game_root + "/" + rel) {
            return state.game_root + "/" + rel;
        }
    }
    ""
}

// `[application] icon`, or "" for a project that names none.
fn declared_icon(state: editor::State) -> str {
    let text = fs::read(state.game_root + "/project.toml");
    if text == nil {
        return "";
    }
    toml::parse(text.unwrap())["application"]["icon"].as_str()
}

// Answered once per session: whether the project ships a mark is up to five disk
// reads, and the bar asked for them on every frame it drew.
fn brand(state: &mut editor::State) -> Brand {
    if state.brand != nil {
        return state.brand.unwrap();
    }
    let logo = brand_logo(state);
    let found = if logo == "" {
        Brand { logo: "assets/balaur-logo.png", name: "Balaur" }
    } else {
        Brand { logo: logo, name: state.game_name }
    };
    state.brand = found;
    found
}

fn plural(count: int, word: str) -> str {
    if count == 1 { word } else { word + "s" }
}

// Where the first workspace pill starts, after the brand.
fn workspaces_x(state: editor::State) -> float {
    let name = if state.compact { 0.0 } else { 3.0 + NAME_WIDTH };
    state.layout["bar"]["x"].as_float() + PAD_X + 2.0 + MARK_WIDTH + name + 8.0
}

/// Where one workspace pill's centre lands in the bar, in design px, so the
/// showcase's drawn cursor can be put on the pill its verb presses.
pub fn workspace_spot(state: editor::State, id: str) -> Spot {
    let bar: any = state.layout["bar"];
    let per = layout::workspace_width(state);
    let slot = 0;
    let workspaces = defs::workspaces();
    for index in 0..workspaces.len() {
        let workspace = workspaces[index];
        if workspace.id == id {
            slot = index;
        }
    }
    let found = strip_spot(state, slot);
    if found != nil {
        let spot = found.unwrap();
        return spot;
    }
    // `return`: a bare tuple after a block parses as a call on the block.
    return Spot { x: workspaces_x(state) + ((slot as float) + 0.5) * per, y: bar["y"].as_float() + bar["height"].as_float() / 2.0 };
}

/// Where a document tab's centre lands: the scene's, then the script's.
pub fn doc_spot(state: editor::State, id: str) -> Spot {
    let bar: any = state.layout["bar"];
    let per = layout::workspace_width(state);
    let first = workspaces_x(state) + (defs::workspaces().len() as float) * per + 12.0;
    let slot = if id == "script" { 1.0 } else { 0.0 };
    let found = strip_spot(state, defs::workspaces().len() + (slot as int));
    if found != nil {
        let spot = found.unwrap();
        return spot;
    }
    return Spot { x: first + slot * (TAB_WIDTH + 4.0) + TAB_WIDTH / 2.0, y: bar["y"].as_float() + bar["height"].as_float() / 2.0 };
}

/// Where the Focus chip sits, so the showcase's drawn cursor lands on the
/// control its verb presses. The strip runs workspaces, documents, split,
/// focus, the spring, then the transport, so it is two slots back.
pub fn focus_spot(state: editor::State) -> Spot {
    let bar: any = state.layout["bar"];
    let found = strip_spot(state, transport_slot(state) - 2);
    if found != nil {
        let spot = found.unwrap();
        return spot;
    }
    return Spot { x: bar["x"].as_float() + bar["width"].as_float() / 2.0, y: bar["y"].as_float() + bar["height"].as_float() / 2.0 };
}

/// Where one of the transport's three buttons sits: play, pause, stop.
pub fn transport_spot(state: editor::State, index: int) -> Spot {
    let bar: any = state.layout["bar"];
    let found = strip_spot(state, transport_slot(state) + index);
    if found != nil {
        let spot = found.unwrap();
        return spot;
    }
    let command_width = if state.compact { COMMAND_WIDTH_COMPACT } else { COMMAND_WIDTH };
    let block = (bar["x"].as_float() + bar["width"].as_float()) - PAD_X - THEME_WIDTH - 4.0 - command_width - 6.0 - BLOCK_WIDTH;
    return Spot { x: block + 14.0 + (index as float) * BUTTON_PITCH, y: bar["y"].as_float() + bar["height"].as_float() / 2.0 };
}

// The transport comes after the workspaces, the open documents, the split, the
// focus and the spring that pushes the right end over.
fn transport_slot(state: editor::State) -> int {
    defs::workspaces().len() + doc_controls(state, state.theme, row_height(state) - 4.0).len() + 3
}

/// The centre of the strip's `slot`-th control, in design px, from the node it
/// was drawn on; `None` until it has drawn, when a caller estimates instead.
fn strip_spot(state: editor::State, slot: int) -> Spot? {
    let strip = scene::get_node(STRIP_NODE);
    if !strip.is_valid() {
        return nil;
    }
    let kids = strip.children();
    if slot < 0 || slot >= kids.len() {
        return nil;
    }
    let rect = ui::widget_rect(kids[slot]);
    if rect == nil {
        return nil;
    }
    let box = rect.unwrap();
    Spot { x: box.x + box.width / 2.0, y: box.y + box.height / 2.0 }
}

// The strip beside the brand, which every control past it lives on.
const STRIP_NODE: str = "Editor/Shell/Head/HeadRow/HeadScroll/HeadStrip";

const BRAND_NODE: str = "Editor/Shell/Head/HeadRow/Brand";

const STATUS_NODE: str = "Editor/Shell/Body/Centre/Bottom/Status";

/// The brand: the project's mark and name on the menu node the scene lays
/// out, the menu's rows under it, and the strip. What the bar's script asks
/// for on `chrome_changed`.
pub fn fill(state: &mut editor::State) {
    // The start screen has the window to itself, and no project to name.
    if manager::showing(state) {
        return;
    }
    let tokens = state.theme;
    let mark = brand(state);
    let node = scene::get_node(BRAND_NODE);
    if node.is_valid() {
        node.widget.image = mark.logo;
        node.widget.text = mark.name;
        node.widget.trailing = icons::ui("caret-down");
        node.widget.height = row_height(state) - 4.0;
        node.widget_menu.showing = state.menu_open;
    }
    ui::fill_strip(BRAND_NODE, menu::rows(state));
    ui::fill_strip(STRIP_NODE, bar_controls(state, tokens));
}

/// What the whole bar is built from, which `signals::chrome` compares.
pub fn key(state: &mut editor::State) -> [any] {
    [menu_key(state), strip_key(state, state.theme), state.menu_open, state.game_name, manager::showing(state)]
}

// The menu lists every panel, ticked where it is open, under the names the
// Outline's among them changes.
fn menu_key(state: &mut editor::State) -> [any] {
    [
        state.workspace,
        "{state.docks}",
        docks::name(state, "outline"),
        state.registry.panels.len(),
    ]
}

// What the strip is built from: the workspace and the toggles beside it, the
// open documents and whether they are saved, the transport, and the theme.
fn strip_key(state: editor::State, tokens: any) -> [any] {
    let replaying = session::loaded(state);
    let paused = if replaying {
        replay::state() == replay::STATE_PAUSED
    } else {
        state.playing && physics::is_paused()
    };
    [
        state.workspace,
        state.compact,
        state.split,
        state.focus,
        state.touchscreen,
        state.selected,
        state.nodes.len(),
        state.history.past.len(),
        state.playing,
        replaying,
        paused,
        state.theme_revision,
        state.scene_rel,
        history::dirty(state),
        state.script_open,
        "{state.script_dirty}",
        state.events_open,
        state.doctab,
    ]
}

// Everything on the bar past the brand, in the order it reads: the workspaces,
// the open documents, then the split, and the right end after a spring.
fn bar_controls(state: editor::State, tokens: any) -> [ui::Control] {
    let height = tab_height(state);
    let out: [ui::Control] = [];
    for workspace in defs::workspaces() {
        let id = workspace.id;
        out.push(ui::Control {
            kind: "button",
            height: height,
            role: "tab_workspace",
            checked: state.workspace == id,
            text: if state.compact { "" } else { workspace.name },
            icon: workspace.icon,
            tooltip: workspace.name,
            on_click: "handle",
            data: { "fn": on_workspace_pressed, "id": id },
        });
    }
    for entry in doc_controls(state, tokens, height) {
        out.push(entry);
    }
    out.push(ui::Control {
        kind: "button",
        height: height,
        icon: icons::ui("split"),
        role: "tab_workspace",
        checked: state.split,
        text: if state.compact { "" } else { "Split" },
        tooltip: "Show the code and the viewport at once (⌘\\)",
        on_click: "handle",
        data: { "fn": on_split_pressed },
    });
    // Beside the split, because the two are the same question: how much of the
    // window the code is worth.
    let can_focus = state.focus || shell::focus_target(state);
    out.push(ui::Control {
        kind: "button",
        height: height,
        icon: icons::ui(if state.focus { "unfocus" } else { "focus" }),
        role: "tab_workspace",
        checked: state.focus,
        text: if state.compact { "" } else { "Focus" },
        enabled: can_focus,
        tooltip: if state.focus {
            "Put the docks back (⇧⌘\\)"
        } else if can_focus {
            "Give the code the whole window (⇧⌘\\)"
        } else {
            "The selection has no script to focus"
        },
        on_click: "handle",
        data: { "fn": on_focus_pressed },
    });
    // The spring: what is after it sits against the bar's right edge.
    out.push(ui::Control { kind: "row", grow: 1 });
    for entry in transport_controls(state) {
        out.push(entry);
    }
    out.push(ui::Control {
        kind: "button",
        height: row_height(state),
        width: icon_width(state),
        padding: 0,
        role: "item_bar",
        text: "",
        icon: if tokens["dark"].as_bool() { icons::ui("dark") } else { icons::ui("light") },
        tooltip: "Toggle theme",
        on_click: "handle",
        data: { "fn": on_theme_pressed },
    });
    let named = !state.compact;
    out.push(ui::Control {
        kind: "button",
        height: row_height(state),
        role: "item_bar",
        width: if named { 0.0 } else { icon_width(state) },
        padding: if named { -1.0 } else { 0.0 },
        text: if named { "Run a command" } else { "" },
        icon: icons::ui("search"),
        tooltip: "⌘K",
        on_click: "handle",
        data: { "fn": on_command_pressed },
    });
    out
}

fn on_workspace_pressed(state: &mut editor::State, data: any, _value: any) {
    let id: str = data["id"].as_str();
    shell::set_workspace(state, id);
}

fn on_split_pressed(state: &mut editor::State, data: any, _value: any) {
    shell::toggle_split(state);
}

fn on_focus_pressed(state: &mut editor::State, data: any, _value: any) {
    shell::toggle_focus(state);
}

fn on_theme_pressed(state: &mut editor::State, data: any, _value: any) {
    theme::toggle(state);
}

fn on_command_pressed(state: &mut editor::State, data: any, _value: any) {
    shell::open_palette(state, "");
}

// The open documents: the scene, always; the selection's script and the event
// bindings while they are open. Only the last two close.
fn doc_controls(state: editor::State, tokens: any, height: float) -> [ui::Control] {
    let node = model::selected_node(state);
    let out: [ui::Control] = [];
    let scene = util::last_segment(state.scene_rel) + (if history::dirty(state) { " ●" } else { "" });
    for entry in doc_tab(state, "scene", icons::panel("scene"), scene, false, height) {
        out.push(entry);
    }
    if state.script_open {
        let attached = model::script_rel(node);
        let label = if attached != nil {
            let script = attached;
            let dirty = state.script_dirty.has(state.game_root + "/" + script.as_str());
            util::last_segment(script.as_str()) + (if dirty { " ●" } else { "" })
        } else {
            "no script"
        };
        for entry in doc_tab(state, "script", icons::ui("scriptfile"), label, true, height) {
            out.push(entry);
        }
    }
    if state.events_open {
        for entry in doc_tab(state, "events", icons::ui("events"), "bindings", true, height) {
            out.push(entry);
        }
    }
    out
}

// One tab: the label, and the close mark beside it when it closes.
fn doc_tab(state: editor::State, id: str, icon: str, label: str, closable: bool, height: float) -> [ui::Control] {
    let active = state.doctab == id;
    let role = "tab_workspace";
    // Built by pushing: a `[` after an `if` block is read as indexing it.
    let inner: [ui::Control] = [];
    inner.push(ui::Control {
        kind: "button",
        height: height,
        text: label,
        icon: icon,
        role: role,
        checked: active,
        corner_radius: 0,
        fill: "none",
        padding: [7, -1, 7, -1],
        on_click: "handle",
        data: { "fn": on_doc_picked, "id": id },
    });
    if closable {
        inner.push(ui::Control {
            kind: "button",
            height: height,
            width: 13,
            padding: 0,
            text: "",
            icon: icons::ui("close"),
            role: role,
            checked: active,
            corner_radius: 0,
            fill: "none",
            tooltip: "Close",
            on_click: "handle",
            data: { "fn": on_doc_close_pressed, "id": id },
        });
    }
    inner.push(ui::Control { kind: "row", width: 5 });
    // One tile: the row carries the fill and the corners, and the halves
    // inside it paint nothing.
    let out: [ui::Control] = [];
    out.push(ui::Control {
        height: height,
        corner_radius: 4,
        controls: inner,
        fill: if active { "primary_bg" } else { "none" },
    });
    out
}

fn on_doc_picked(state: &mut editor::State, data: any, _value: any) {
    let id: str = data["id"].as_str();
    shell::open_doc(state, id);
}

fn on_doc_close_pressed(state: &mut editor::State, data: any, _value: any) {
    let id: str = data["id"].as_str();
    shell::close_doc(state, id);
}

// Play, pause and stop; the last two are off until something runs.
fn transport_controls(state: editor::State) -> [ui::Control] {
    let replaying = session::loaded(state);
    let running = state.playing || replaying;
    let paused = if replaying {
        replay::state() == replay::STATE_PAUSED
    } else {
        state.playing && (physics::is_paused())
    };
    [
        ui::Control {
            kind: "button",
            text: "",
            icon: icons::ui("play"),
            height: row_height(state),
            width: icon_width(state),
            padding: 0,
            icon_size: PLAY_SIZE,
            role: "icon_action_primary",
            checked: state.playing,
            tooltip: if state.playing { "Stop the scene (F5)" } else { "Run the scene (F5)" },
            on_click: "handle",
            data: { "fn": on_play_pressed },
        },
        ui::Control {
            kind: "button",
            text: "",
            icon: icons::ui("pause"),
            enabled: running,
            height: row_height(state),
            width: icon_width(state),
            padding: 0,
            icon_size: STEP_SIZE,
            role: "icon_action_primary",
            checked: paused,
            tooltip: if !running {
                "Run the scene first"
            } else if replaying {
                "Pause playback"
            } else {
                "Pause simulation"
            },
            on_click: "handle",
            data: { "fn": on_pause_pressed, "replaying": replaying },
        },
        ui::Control {
            kind: "button",
            text: "",
            icon: icons::ui("stop"),
            enabled: running,
            height: row_height(state),
            width: icon_width(state),
            padding: 0,
            icon_size: STEP_SIZE,
            role: "icon_action_primary",
            tooltip: if running { "Stop" } else { "Nothing is running" },
            on_click: "handle",
            data: { "fn": on_stop_pressed, "replaying": replaying },
        },
    ]
}

fn on_play_pressed(state: &mut editor::State, data: any, _value: any) {
    shell::toggle_play(state);
}

fn on_pause_pressed(state: &mut editor::State, data: any, _value: any) {
    let replaying: bool = data["replaying"].as_bool();
    if replaying {
        session::toggle_pause(state);
    } else {
        physics::set_paused(!physics::is_paused());
    }
}

fn on_stop_pressed(state: &mut editor::State, data: any, _value: any) {
    let replaying: bool = data["replaying"].as_bool();
    if replaying {
        session::close(state);
    } else {
        shell::stop_play(state);
    }
}

/// The status strip: what the editor is doing, how big the scene is, and the
/// workspace and tool in hand. `room` is the width it has; `trailing` draws
/// whatever the dock wants at the far right, which minimised is the handle
/// that reopens it.
/// The status strip's controls. The scene owns the row; this says what goes
/// in it, so the theme dresses the labels rather than the call site.
// Every import of the batch, top right under the bar: one line each, and one
// bar for the lot of them. It takes no pointer: a root over the viewport would
// swallow clicks meant for the scene.
const IMPORTS: str = "Editor/Imports";

/// Fill the import list's lines and say what its bar and its clock read: what
/// the list's script asks for when an import reported.
pub fn fill_imports(state: &mut editor::State) -> FillImports {
    dropin::sweep(state);
    let tokens = state.theme;
    let lines: [ui::Control] = [];
    for source in state.jobs.keys() {
        let job = state.jobs[source];
        let name = job["name"].as_str();
        let done = job["done"].as_int();
        let files = job["files"].as_int();
        let line = if job["over"].as_str() == "" {
            if files > 0 { "{name} {done}/{files}" } else { name }
        } else {
            "{name} {job["over"].as_str()} · {done} {plural(done, "file")}"
        };
        lines.push(ui::Control { kind: "label", role: "text_note", text: line, text_color: tokens["text_muted"] });
    }
    ui::fill_strip(IMPORTS + "/Lines", lines);
    let totals = dropin::job_totals(state);
    FillImports {
        shown: lines.len() > 0,
        bar: totals.files > 0,
        value: if totals.files > 0 { (totals.done as float) / (totals.files as float) } else { 0.0 },
        until: dropin::kept_until(state),
    }
}

/// The status strip, what its script asks for on `status_changed`.
pub fn fill_status(state: &mut editor::State) {
    ui::fill_strip(STATUS_NODE, status_controls(state, state.theme, state.layout["bottom"]["width"].as_float()));
}

/// What the strip is built from: `status_mode` carries the pause, the play,
/// the frame rate while playing and an import in flight; the rows and the
/// steps taken stand for the node and script counts.
pub fn status_key(state: editor::State) -> [any] {
    [status_mode(state), state.playing, state.theme_revision, state.layout["bottom"]["width"], state.nodes.len(), state.history.past.len(), state.workspace, state.tool]
}

fn status_mode(state: editor::State) -> str {
    if state.debug.paused.kind() == "map" {
        return "paused · {state.debug.paused_rel}:{state.debug.paused["line"]}";
    }
    if state.playing {
        let recording = if state.session.recording != "" { "recording · " } else { "" };
        return "playing · {recording}{state.fps as int} fps";
    }
    // An import in flight is the state, and no more than that: which files
    // and how far along are the toast's, which draws them in one pass.
    if dropin::in_flight(state) > 0 {
        return "importing";
    }
    "editing"
}

fn status_controls(state: editor::State, tokens: any, room: float) -> [ui::Control] {
    let stopped = state.debug.paused.kind() == "map";
    let lamp = (if stopped {
        tokens["primary_text"]
    } else if state.playing {
        tokens["success_text"]
    } else {
        tokens["text_subtle"]
    }).as_str();
    let out: [ui::Control] = [
        ui::Control { kind: "row", width: 6, corner_radius: 0 },
        ui::Control { kind: "row", width: 5, height: 5, corner_radius: 3, fill: lamp },
        ui::Control {
            kind: "label",
            corner_radius: 0,
            text: status_mode(state),
            role: "text_caption",
            text_color: tokens["text_muted"].as_str(),
        },
    ];
    // Narrow: the columns go one at a time rather than running together.
    if room > 300.0 {
        let stats = model::stats(state);
        let nodes = stats.nodes;
        let scripts = stats.scripts;
        out.push(ui::Control {
            kind: "label",
            corner_radius: 0,
            text: "{nodes} {plural(nodes, "node")} · {scripts} {plural(scripts, "script")}",
            role: "text_caption",
            text_color: tokens["text_subtle"].as_str(),
        });
    }
    if room > 560.0 {
        out.push(ui::Control {
            kind: "label",
            corner_radius: 0,
            text: "kiss3d · wgpu",
            role: "text_caption",
            text_color: tokens["text_subtle"].as_str(),
        });
    }
    out.push(ui::Control { kind: "row", corner_radius: 0, grow: 1 });
    if room > 420.0 {
        out.push(ui::Control {
            kind: "label",
            corner_radius: 0,
            text: "{defs::workspace_name(state.workspace)} · {defs::tool_name(state.tool)}",
            role: "text_caption",
            text_color: tokens["text_subtle"].as_str(),
        });
    }
    out.push(ui::Control { kind: "row", width: 6, corner_radius: 0 });
    out
}
