// The one menu the shell has, under the mark at the head of the bar: the
// screens that are not panels, and a tick beside every panel there is, open
// or not. A tab's close mark takes one away; this is where it comes back.

use crate::defs;
use crate::docks;
use crate::icons;
use crate::shell;

// A row, and the two columns the panel list runs in: seventeen panels down
// one column is taller than the window the editor is asked to fit.
const ROW_W = 216.0;
const CELL_W = 108.0;

/// The menu's rows, as the nodes the pool keeps under the mark. Filled once a
/// pass; the menu node draws them in its popup when it is opened.
pub fn rows(S) {
    let out = [
        action(icons::ui("search"), "Command palette", "⌘K", |_| { shell::open_palette(S, ""); }),
        action(icons::ui("settings"), "Settings", "⌘,", |_| { crate::settings::open(S); }),
        action(icons::ui("export"), "Export", "⌘E", |_| { crate::exporter::open(S); }),
        rule(),
        #{ kind: "label", role: "menu_heading", text: "PANELS", width: ROW_W },
    ];
    for pair in panel_pairs(S) {
        out.push(pair);
    }
    out.push(rule());
    let reset = format!("Reset to {}", defs::persona_name(S.persona));
    out.push(action(icons::ui("reset"), reset, "", |_| { docks::apply_persona(S, S.persona); }));
    out
}

fn action(icon, label, key, on) {
    #{ kind: "button", role: "menu_row", icon: icon, text: label, trailing: key, width: ROW_W, on: on }
}

// A rule the width of the menu: a bare one takes the width it is offered.
fn rule() {
    #{ kind: "separator", width: ROW_W }
}

// Every panel, ticked where it is open, two to a line. Clicking one closes it
// or puts it back in the dock it belongs to, and the menu stays up.
fn panel_pairs(S) {
    let ids = docks::known(S);
    let out = [];
    let n = 0;
    while n < ids.len() {
        let pair = [cell(S, ids[n])];
        if n + 1 < ids.len() {
            pair.push(cell(S, ids[n + 1]));
        }
        out.push(#{ kind: "row", controls: pair });
        n += 2;
    }
    out
}

fn cell(S, id) {
    let open = docks::side_of(S, id).is_some();
    #{
        kind: "button", role: if open { "menu_row" } else { "menu_row_off" },
        // An em space where the tick would be: as wide as the glyph, so a shut
        // panel's name starts where an open one's does.
        icon: if open { icons::ui("check") } else { "\u{2003}" }, text: docks::name(S, id),
        width: CELL_W, keep_open: true,
        on: |_| { docks::toggle(S, id); },
    }
}
