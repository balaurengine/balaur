// The library dock: stock materials, skies, models, lighting setups and
// project templates.
// Placing one copies its files in and then does what dropping them would.

use defs;
use dropin;
use editor;
use icons;
use model;
use signals;
use util;
use words::asset_kinds;
use words::changes;
use words::components;
use words::fields;
use words::log_fields;
use words::project_fields;
use words::statuses;
use words::tabs;
use words::theme_tokens;
use words::verbs;

const ADDON: str = "addon";
const DEPENDENCY: str = "dependency";
const DEPS: str = "deps";
const FETCHED: str = "fetched";
const RIG: str = "rig";
const TEMPLATE: str = "template";
const FORGE: str = "forge";
const MATERIAL: str = "material";
const MODEL: str = "model";
const SCENE: str = "scene";
const SKY: str = "sky";
const ENTRIES: str = "entries";
const NEEDS: str = "needs";
const LIBRARY: str = "library";

pub class LibraryState {
    kind: str,
    catalogue: Catalogue?,
    shown: Shown,
    /// Projects on Forge, as the last search answered.
    forge: [any],
    /// What the Forge kind says while it searches, or why it could not.
    forge_says: str,
}

/// The library's manifest.
pub struct Catalogue {
    entries: any,
    templates: any,
}

/// What each row the panel shows places, by the row's key.
pub struct Shown {
    held: any,
}

/// What the Library panel shows.
pub struct View {
    internal kind: str,
    internal templates: bool,
    internal items: [ui::Item],
    internal says: str,
}

pub fn state() -> LibraryState {
    LibraryState { kind: asset_kinds::MATERIAL, catalogue: nil, shown: Shown { held: {} }, forge: [], forge_says: "" }
}

/// The kinds the dock filters by, in the order the chips offer them.
pub fn kinds() -> [[str]] {
    [
        [MATERIAL, "Materials"],
        [SKY, "Skies"],
        [MODEL, "Models"],
        [SCENE, "Lighting"],
        [RIG, "Rigs"],
        [ADDON, "Addons"],
        [TEMPLATE, "Templates"],
        [DEPS, "Dependencies"],
        [FORGE, "On Forge"],
    ]
}

/// The library's own directory, inside the editor project rather than the
/// edited one: `fs` resolves a bare path against the editor.
const ROOT: str = "library";

/// The manifest, read once per session. A library that fails to parse is
/// reported once and treated as empty.
fn catalogue(state: &mut editor::State) -> Catalogue {
    if state.library.catalogue != nil {
        return state.library.catalogue.unwrap();
    }
    let text = fs::read(ROOT + "/catalog.toml");
    let table: any = if text != nil { util::map_or_empty(toml::parse(text.unwrap())) } else { {} };
    if text == nil {
        log::warn("no library manifest at " + ROOT);
    } else if table.len() == 0 {
        log::warn("the library manifest does not parse");
    }
    let known = Catalogue { entries: util::list_or_empty(table[ENTRIES]), templates: util::list_or_empty(table["templates"]) };
    state.library.catalogue = known;
    known
}

/// Copy one library file into the edited project, keeping its directory and
/// never writing over a file already there: a project with its own
/// `materials/metal.toml` keeps it, and the library's lands beside it.
/// Answers the project-relative path, or `None` when it could not be read.
fn install(state: &mut editor::State, rel: str) -> str? {
    let from = ROOT + "/" + rel;
    if !fs::exists(from) {
        log::warn("the library has no " + rel);
        return nil;
    }
    // The directory is everything up to the last separator.
    let directory = rel.slice(0, rel.len() - util::leaf(rel).len());
    if directory != "" {
        fs::create_directory(state.game_root + "/" + directory);
    }
    let target = free_name(state, rel);
    fs::copy(from, state.game_root + "/" + target);
    model::forget(state);
    target
}

/// Copy a library directory into the project at the same path. One already
/// there is kept as it is, and said so: the game's copy may carry edits.
fn install_tree(state: &mut editor::State, rel: str) {
    let from = ROOT + "/" + rel;
    if !fs::exists(from) {
        log::warn("the library has no " + rel);
        return;
    }
    let to = state.game_root + "/" + rel;
    if fs::exists(to) {
        log::info(rel + " is already in the project");
        return;
    }
    copy_tree(from, to);
    model::forget(state);
    log::info("added " + rel);
}

/// Every file under `from`, into `to`, directories included.
fn copy_tree(from: str, to: str) {
    fs::create_directory(to);
    for entry in util::list_or_empty(fs::list(from)) {
        let name = entry[fields::NAME].as_str();
        if entry[project_fields::IS_DIR].as_bool() {
            copy_tree(from + "/" + name, to + "/" + name);
        } else {
            fs::copy(from + "/" + name, to + "/" + name);
        }
    }
}

/// `rel`, or `rel` with a number before its extension when the project
/// already has that file.
fn free_name(state: editor::State, rel: str) -> str {
    if !fs::exists(state.game_root + "/" + rel) {
        return rel;
    }
    let cut = util::index_of(rel, ".");
    let stem = if cut != nil { rel.slice(0, cut.unwrap()) } else { rel };
    let extension = if rel.len() > stem.len() { rel.slice(stem.len(), rel.len()) } else { "" };
    let suffix = 2;
    while fs::exists(state.game_root + "/" + "{stem}_{suffix}{extension}") {
        suffix += 1;
    }
    "{stem}_{suffix}{extension}"
}

/// Put an entry into the project: its own file, then whatever it needs.
pub fn place(state: &mut editor::State, entry: any) {
    // An addon is a directory a game requires by path, so it lands at that
    // path or not at all: a numbered copy would answer no `require`.
    let kind = entry[fields::KIND].as_str();
    if kind == ADDON {
        install_tree(state, entry[project_fields::FILE].as_str());
        return;
    }
    for needed in util::list_or_empty(entry[NEEDS]) {
        install(state, needed.as_str());
    }
    let rel_or = install(state, entry[project_fields::FILE].as_str());
    if rel_or == nil {
        return;
    }
    let rel = rel_or.unwrap();
    if kind == asset_kinds::SKY {
        // A sky is already under `skies/`, so only the naming is left.
        dropin::name_sky(state, rel, "library sky");
    } else if kind == tabs::SCENE || kind == asset_kinds::MODEL || kind == RIG {
        // A lighting setup, a model and a rig are all scenes: instanced where
        // a dropped one would be, with the scripts a rig needs already in.
        dropin::take(state, state.game_root + "/" + rel);
    } else {
        // A material is a file the inspector then points a node at, so the
        // placing is the copy and the log line says where it landed.
        log::info("added " + rel);
    }
}

/// Point the selected node's 3D shape at a library material, which is what a
/// designer means by dropping one onto something.
pub fn apply_material(state: &mut editor::State, entry: any) {
    if !model::has_selection(state) {
        return;
    }
    for needed in util::list_or_empty(entry[NEEDS]) {
        install(state, needed.as_str());
    }
    let rel_or = install(state, entry[project_fields::FILE].as_str());
    if rel_or == nil {
        return;
    }
    let rel = rel_or.unwrap();
    let found = model::selected_node(state);
    let key = if found.is_valid() && found.has_component(components::MESH) {
        components::MESH
    } else if found.is_valid() && found.has_component(components::SHAPE3D) {
        components::SHAPE3D
    } else {
        log::info("select a node with a 3D shape to give it " + entry[fields::NAME].as_str());
        return;
    };
    model::set_component_property(state, key, asset_kinds::MATERIAL, rel);
    log::info("{found.name()} is now {entry["name"].as_str()}");
}

/// A mark per kind, so a card says what it places before its name is read.
fn kind_icon(kind: str) -> str {
    if kind == "material" {
        return icons::workspace(defs::WORKSPACE_UI);
    }
    if kind == asset_kinds::SKY {
        return icons::ui("viewmode");
    }
    if kind == RIG {
        return icons::panel(icons::BONEMAP);
    }
    if kind == ADDON {
        return icons::workspace(defs::WORKSPACE_SCRIPT);
    }
    return icons::panel(icons::SCENE);
}

/// What the Library panel shows for its kind: the kind's cards, or the
/// templates as table rows, and what to say when there are none. The entries
/// are kept, so a pick names the one it placed.
pub fn view(state: &mut editor::State) -> View {
    let tokens = state.theme;
    let known = catalogue(state);
    let items: [ui::Item] = [];
    let held: any = {};
    if state.library.kind == TEMPLATE {
        // Listed rather than placed, because a template makes a project and
        // the editor is already in one.
        for entry in known.templates {
            let command = "balaur new my-game --template {entry["id"].as_str()}";
            items.push(ui::Item { cells: [entry["name"].as_str(), entry[log_fields::NOTE].as_str(), command], key: command });
            held[command] = command;
        }
        state.library.shown = Shown { held: held };
        let says = if items.len() == 0 {
            "no templates in the library"
        } else {
            "a row is copied as the command that makes it"
        };
        return View { kind: state.library.kind, templates: true, items: items, says: says };
    }
    if state.library.kind == DEPS {
        return dependency_view(state);
    }
    if state.library.kind == tabs::FORGE {
        return forge_view(state);
    }
    for entry in known.entries {
        if entry[fields::KIND].as_str() == state.library.kind {
            // The kind's mark, the entry's name, and its note as the hover.
            let key = entry[fields::ID].as_str();
            items.push(ui::Item { icon: kind_icon(state.library.kind), label: entry[fields::NAME].as_str(), note: entry[log_fields::NOTE].as_str(), tint: tokens[theme_tokens::TEXT_DEFAULT].as_str(), key: key });
            held[key] = entry;
        }
    }
    state.library.shown = Shown { held: held };
    let says = if items.len() == 0 { "nothing of that kind in the library" } else { "" };
    View { kind: state.library.kind, templates: false, items: items, says: says }
}

/// Files a dependency lists at most, so a large one stays a list to read.
const DEPENDENCY_ROWS: int = 400;

/// Each of the game's dependencies, file by file, with the names and notes
/// its own `catalog.toml` gives where it has one.
fn dependency_view(state: &mut editor::State) -> View {
    let tokens = state.theme;
    let items: [ui::Item] = [];
    let held: any = {};
    for dependency_entry in dependency::list() {
        if dependency_entry.game != state.game_root {
            continue;
        }
        let alias = dependency_entry.alias;
        let folder = "deps/" + alias;
        let named = catalogue_of(state.game_root + "/" + folder);
        for rel in files_under(state.game_root + "/" + folder, "") {
            if items.len() >= DEPENDENCY_ROWS {
                break;
            }
            let entry = named[rel];
            let title = if entry == nil { rel } else { entry[fields::NAME].as_str() };
            let note = if entry == nil { folder + "/" + rel } else { entry[log_fields::NOTE].as_str() };
            let file = folder + "/" + rel;
            items.push(ui::Item { icon: file_icon(rel), label: alias + " · " + title, note: note, tint: tokens[theme_tokens::TEXT_DEFAULT].as_str(), key: file });
            held[file] = { fields::KIND: DEPENDENCY, project_fields::FILE: file };
        }
    }
    state.library.shown = Shown { held: held };
    let says = if items.len() == 0 {
        "no dependencies: `balaur add owner/name`, or pick one On Forge"
    } else {
        "placed linked: an update to the dependency reaches it"
    };
    View { kind: state.library.kind, templates: false, items: items, says: says }
}

/// A dependency's `catalog.toml` entries by file, or an empty map.
fn catalogue_of(root: str) -> any {
    let out: any = {};
    let text = fs::read(root + "/catalog.toml");
    if text == nil {
        return out;
    }
    let table = util::map_or_empty(toml::parse(text.unwrap()));
    for entry in util::list_or_empty(table[ENTRIES]) {
        out[entry[project_fields::FILE].as_str()] = entry;
    }
    out
}

/// Every file under `root`/`directory`, relative to `root`, less the ones that
/// describe the project rather than ship with it.
fn files_under(root: str, directory: str) -> [str] {
    let out: [str] = [];
    let at = if directory == "" { root } else { root + "/" + directory };
    for entry in util::list_or_empty(fs::list(at)) {
        let name = entry[fields::NAME].as_str();
        let rel = if directory == "" { name } else { directory + "/" + name };
        if entry[project_fields::IS_DIR].as_bool() {
            if !(directory == "" && name == DEPS) {
                for inner in files_under(root, rel) {
                    out.push(inner);
                }
            }
        } else if !(directory == "" && (name == "project.toml" || name == "project.lock" || name == "catalog.toml")) {
            out.push(rel);
        }
    }
    out
}

/// A mark by what a file is.
fn file_icon(rel: str) -> str {
    if rel.ends_with(".toml") {
        return icons::panel(icons::SCENE);
    }
    if rel.ends_with(".bs") {
        return icons::workspace(defs::WORKSPACE_SCRIPT);
    }
    icons::workspace(defs::WORKSPACE_UI)
}

/// Projects on Forge, from the last search; the first look starts one.
fn forge_view(state: &mut editor::State) -> View {
    let tokens = state.theme;
    if state.library.forge.len() == 0 && state.library.forge_says == "" {
        if forge::search("", "") {
            state.library.forge_says = "asking " + forge::url();
        }
    }
    let items: [ui::Item] = [];
    let held: any = {};
    for row in state.library.forge {
        let tags = "";
        for tag in util::list_or_empty(row[fields::TAGS]) {
            tags = if tags == "" { tag.as_str() } else { tags + ", " + tag.as_str() };
        }
        let note = if tags == "" { row[fields::DESCRIPTION].as_str() } else { row[fields::DESCRIPTION].as_str() + " · " + tags };
        let project = row[project_fields::PROJECT].as_str();
        items.push(ui::Item { icon: icons::panel(icons::ASSETS), label: project, note: note, tint: tokens[theme_tokens::TEXT_DEFAULT].as_str() });
        held[project] = { fields::KIND: tabs::FORGE, project_fields::FILE: project };
    }
    state.library.shown = Shown { held: held };
    let says = if state.library.forge_says != "" {
        state.library.forge_says
    } else if items.len() == 0 {
        "no public projects yet"
    } else {
        "a pick adds it to this game as a dependency"
    };
    View { kind: state.library.kind, templates: false, items: items, says: says }
}

/// What a Forge job reported: the projects a search found, a dependency
/// added, or why either failed.
pub fn heard(state: &mut editor::State, event: any) {
    let kind = event[fields::KIND].as_str();
    if kind == statuses::LISTED {
        state.library.forge = util::list_or_empty(event[fields::ROWS]);
        state.library.forge_says = "";
    } else if kind == FETCHED {
        let alias = event["alias"].as_str();
        // Its files are on disk; installing makes the new one a root.
        dependency::install(state.game_root);
        model::forget(state);
        state.library.forge_says = "";
        if alias == "" {
            log::info("dependencies fetched");
        } else {
            log::info("added deps/{alias}");
        }
    } else if kind == statuses::FAILED && event[log_fields::JOB].as_str() != verbs::COPY {
        state.library.forge_says = event[log_fields::MESSAGE].as_str();
        log::warn("Forge: " + event[log_fields::MESSAGE].as_str());
    } else {
        return;
    }
    signals::changed(state, LIBRARY);
    signals::changed(state, changes::ASSETS);
}

/// The kind the panel's chips filter by.
pub fn choose(state: &mut editor::State, kind: str) {
    state.library.kind = kind;
    signals::changed(state, LIBRARY);
}

/// A card or a template row picked: a material goes on the selection, any
/// other entry into the project, and a template's command to the clipboard.
pub fn pick(state: &mut editor::State, row: str) {
    let held = state.library.shown.held[row];
    if held == nil {
        return;
    }
    if held.kind() == types::KIND_STRING {
        ui::set_clipboard(held.as_str());
        log::info("copied: " + held.as_str());
    } else if held[fields::KIND].as_str() == DEPENDENCY {
        // Linked: placed by the path the game names it with.
        dropin::place_file(state, held[project_fields::FILE].as_str());
    } else if held[fields::KIND].as_str() == tabs::FORGE {
        if forge::add(state.game_root, held[project_fields::FILE].as_str()) {
            state.library.forge_says = "adding " + held[project_fields::FILE].as_str();
            signals::changed(state, LIBRARY);
        }
    } else if held[fields::KIND].as_str() == asset_kinds::MATERIAL {
        apply_material(state, held);
    } else {
        place(state, held);
    }
}
