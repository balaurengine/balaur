// The node picker: every preset and component, grouped by dimension tag, or
// what the selection can be changed to. A soft body asks what it is built
// from first. Esc, a scrim click or a pick closes it.

use crate::icons;
use crate::model;
use crate::style;
use crate::util;

// Group order, each a tag the engine already carries. A row is filed under
// the first group whose tag it has, so a `2d` `physics` preset lands in 2D
// rather than twice.
fn groups() {
    [["3d", "3D"], ["2d", "2D"], ["ui", "UI"], ["physics", "Physics"], ["", "Other"]]
}

/// Which group a tag list belongs to: the first that matches, `Other` if none.
fn group_of(tags) {
    for group in groups() {
        if group[0] == "" || util::contains(tags, group[0]) {
            return group[1];
        }
    }
    "Other"
}

fn entry(name, note, tags, preset) {
    #{ name: name, note: note, tags: util::join(tags, " "), group: group_of(tags), preset: preset }
}

// Asked once per opening rather than once per frame: both registries are
// walked whole, and doing that on every keystroke is a list rebuild.
pub fn catalogue(S) {
    let found = S.newnode_cache;
    if found is Vec {
        return found;
    }
    let rows = if S.newnode_soft != "" {
        crate::recipes::soft_sources(S, S.newnode_soft == "2d")
    } else if S.newnode_change {
        changes(S)
    } else {
        everything(S)
    };
    S.newnode_cache = rows;
    rows
}

// What the selected node can become, filed like the presets it names.
fn changes(S) {
    let rows = [];
    for target in crate::recipes::targets(S, S.sel) {
        rows.push(entry(target.name, target.note, target.tags, true));
    }
    rows
}

fn everything(S) {
    let rows = [];
    for name in scene::presets() {
        let info = scene::preset_info(name);
        let note = if info is Object { info.get("description").unwrap_or("") } else { "" };
        let tags = if info is Object { util::vec(info.tags) } else { [] };
        rows.push(entry(name, note, tags, true));
    }
    // Components too, so a node can be made of one thing the presets do not
    // cover; `camera3d` has no preset and is still a node someone adds.
    for name in scene::component_types() {
        // `transform` is not a node to add: `add_child` has already given the
        // new node one, and every node in the tree carries it.
        if name == "transform" {
            continue;
        }
        let tags = util::vec(scene::component_tags(name));
        rows.push(entry(name, "", tags, false));
    }
    rows
}

pub fn open(S) {
    S.newnode = true;
    S.newnode_query = "";
    S.newnode_cache = ();
    S.newnode_change = false;
    S.newnode_soft = "";
}

/// The picker over what the selected node can be changed to.
pub fn open_change(S) {
    if !model::has_selection(S) {
        return;
    }
    open(S);
    S.newnode_change = true;
}

pub fn close(S) {
    S.newnode = false;
    S.newnode_change = false;
    S.newnode_soft = "";
    crate::window::picker_shut(S);
}

pub fn place(S, row) {
    // A soft body is built from something, so it asks what before building:
    // unless a node being changed already draws a thing to build it from.
    let soft = crate::recipes::soft_dimension(row.name);
    let drawn = S.newnode_change && crate::recipes::soft_body_source(S, S.sel).is_some();
    if row.preset && soft != "" && !drawn {
        S.newnode_soft = soft;
        S.newnode_query = "";
        S.newnode_cache = ();
        return;
    }
    if S.newnode_change {
        crate::recipes::change_type(S, S.sel, row.name);
    } else if row.preset {
        model::add_child(S, Some(row.name));
    } else {
        // A child first, then the one component: `add_component` acts on the
        // selection, and `add_child` has just made this the selection.
        model::add_child(S, None);
        model::add_component(S, row.name);
    }
    close(S);
}

// A source picked in the soft body's step: a new child built from it, or the
// node being changed rebuilt from it.
pub fn place_source(S, source) {
    if S.newnode_change {
        crate::recipes::give_soft_body(S, S.sel, source);
    } else {
        crate::recipes::add_soft_body(S, source);
    }
    close(S);
}

pub fn draw(S) {
    if !S.newnode {
        return;
    }
    let row_h = util::max(style::row_h(S), 30.0);
    let specs = if S.newnode_soft != "" { source_specs(S, S.theme, row_h) } else { row_specs(S, S.theme, row_h) };
    let placeholder = if S.newnode_soft != "" {
        "Build the soft body from a shape or a file…"
    } else if S.newnode_change {
        format!("Change {} to…", model::selected_node(S).get("name").unwrap_or("the node"))
    } else {
        "Nodes, components, 2d, physics…"
    };
    let mark = if S.newnode_change { icons::ui("reset") } else { icons::ui("add") };
    let host = crate::window::picker(S, #{
        width: 520.0,
        mark: mark,
        placeholder: placeholder,
        query: S.newnode_query,
        rows_h: (specs.len() as f64) * (row_h + 2.0) + 4.0,
        on: |text| { S.newnode_query = text; },
        on_submit: |text| { S.newnode_query = text; },
    });
    if util::is_nil(host) {
        close(S);
        return;
    }
    crate::pool::sync(S, host, specs, 0.0, false);
}

/// Every row the picker shows: the empty node ahead of the groups, then a
/// heading and its matches per group.
fn row_specs(S, k, row_h) {
    let query = S.newnode_query.to_lowercase();
    let rows = catalogue(S);
    let out = [];
    // Ahead of the groups and in none of them: a node with no components has
    // no dimension to be filed under.
    if !S.newnode_change && (query == "" || "empty node".contains(query)) {
        out.push(row_spec(row_h, "Empty node  ·  a transform and nothing else",
            icons::node("world"), k.text_subtle, || {
                model::add_child(S, None);
                close(S);
            }));
    }
    for group in groups() {
        let title = group[1];
        let shown = [];
        for row in rows {
            // The tags join the haystack, so "physics" or "2d" narrows the
            // list even where the name does not say it.
            let haystack = (row.name + " " + row.note + " " + row.tags).to_lowercase();
            if row.group == title && (query == "" || haystack.contains(query)) {
                shown.push(row);
            }
        }
        if shown.len() == 0 {
            continue;
        }
        out.push(#{ full: true, height: 20, controls: [#{
            kind: "label", role: "text_caption", grow: 1, text: title,
        }] });
        for entry in shown {
            // Bound afresh: a closure made in a loop captures the binding.
            let row = entry;
            // The type's own mark and colour, the same pair the inspector and
            // the tree draw a component with.
            let (mark, tint) = icons::component(row.name);
            let caption = if row.note == "" { row.name } else { row.name + "  ·  " + row.note };
            out.push(row_spec(row_h, caption, mark,
                k.get(tint).unwrap_or(k.primary_text), || { place(S, row); }));
        }
    }
    if out.is_empty() {
        out.push(#{ full: true, height: 0, controls: [#{
            kind: "label", role: "text_caption", grow: 1, wrap: true,
            text: crate::search::nothing_says(S.newnode_query),
        }] });
    }
    out
}

/// The soft body's second step: a shape, or a file in the project, to build
/// it from.
fn source_specs(S, k, row_h) {
    let query = S.newnode_query.to_lowercase();
    let out = [#{ full: true, height: 20, controls: [#{
        kind: "label", role: "text_caption", grow: 1, text: "Soft body from",
    }] }];
    for found in catalogue(S) {
        let source = found;
        let caption = source.label + "  ·  " + source.note;
        if query != "" && !caption.to_lowercase().contains(query) {
            continue;
        }
        let drawn = source.parts.keys().next().unwrap_or("");
        let (mark, tint) = icons::component(drawn);
        out.push(row_spec(row_h, caption, mark, k.get(tint).unwrap_or(k.primary_text),
            || { place_source(S, source); }));
    }
    out
}

// `icon_color` is the component's own mark colour, which is data rather than
// styling: the tree and the inspector draw the same pair.
fn row_spec(row_h, caption, mark, color, act) {
    #{ full: true, height: row_h, controls: [#{
        kind: "button", role: "item_picker", grow: 1,
        text: caption, icon: mark, icon_color: color,
        on: |_| { act(); },
    }] }
}
