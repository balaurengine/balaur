// Refills the editor's plugin docks when the game saves, while the game
// carries this addon.

use addons::save::save;

pub class Saves {
    node: Node,
}

impl Saves {
    pub fn init() {
        events::listen(self.node, save::SAVED);
    }

    /// A save the game wrote: the docks that list saves fill again.
    pub fn on_saved(_slot: any) {
        scene::root().get_node("Editor").call("kit_changed");
    }
}
