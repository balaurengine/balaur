// Lists `[save] version` in the editor's Settings window while the game
// carries this addon, and refills the plugin docks when the game saves. A run
// reads the setting with `settings::get`, declared or not.

use addons::save::save;

const TYPE: str = "type";
const DEFAULT: str = "default";
const MIN: str = "min";
const MAX: str = "max";
const HELP: str = "help";

pub class Saves {
    node: Node,
}

impl Saves {
    pub fn init() {
        events::listen(self.node, save::SAVED);
    }

    /// A save the game wrote: the docks that list saves fill again.
    pub fn on_saved(_count: any) {
        scene::get_node("Editor").call("kit_changed");
    }

    pub fn register() -> any {
        settings::define(save::VERSION_SETTING, {
            TYPE: "int",
            DEFAULT: 1,
            MIN: 1,
            MAX: 9999,
            HELP: "The save version this build writes. An older file is brought forward by the step `save::migrate_with` names; a newer one is refused.",
        });
        {}
    }
}
