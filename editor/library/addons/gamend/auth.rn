// Signing in, and staying signed in. `gamend::login` knows a device id and
// an email; every provider is an OAuth session the player finishes in a
// browser and this polls until it resolves, then keeps in a `save::` slot.

/// The save slot the session is kept in.
pub const SLOT = "gamend";

/// How long to wait for the player to finish at the provider, in seconds,
/// and how often to ask whether they have.
pub const SIGN_IN_TIMEOUT = 300.0;
pub const POLL_SECONDS = 1.0;

/// The providers this server offers, as `list_auth_providers` reports them.
pub async fn providers(node) {
    let reply = task::wait(gamend::authentication::list_auth_providers(node)).await;
    if !gamend::core::ok(reply) {
        log::warn(gamend::core::error_of(reply));
        return [];
    }
    let providers = data_of(gamend::core::body(reply));
    if providers is Vec {
        return providers;
    }
    return [];
}

/// Sign in with a provider: open its page, then wait for the server to say
/// the session resolved. Signs in with the tokens it carries, keeps them for
/// the next run, and answers them; nil when the player gave up, the provider
/// refused, or the wait ran out. Always a sign-in, even for a player signed
/// in already: `link` adds a provider to their account instead.
pub async fn sign_in(node, provider) {
    let status = provider_page(
        node,
        provider,
        |node| gamend::authentication::oauth_request(node, provider),
        |node, session| gamend::authentication::oauth_session_status(node, session),
    ).await;
    if !(status is Object) {
        return ();
    }
    // The tokens ride under `session`, once; signing in from them is what
    // `restore` does for a kept session, so a fresh one goes the same way.
    let session = status["session"];
    if !(session is Object) {
        log::warn(`gamend: ${provider} sign-in completed without a session`);
        return ();
    }
    gamend::restore(session);
    keep(session);
    return session;
}

/// Link a provider to the signed-in account: open its page, then wait for
/// the server to say the link resolved. True once linked; the user channel's
/// `user_updated` carries the new `linked_providers`.
pub async fn link(node, provider) {
    let status = provider_page(
        node,
        provider,
        |node| gamend::authentication::link_provider_request(node, provider),
        |node, session| gamend::authentication::link_session_status(node, session),
    ).await;
    return status is Object;
}

/// Start with `start`, open the page it answers, and ask `poll` until the
/// player is done there. The completed status, or nil.
async fn provider_page(node, provider, start, poll) {
    let started = task::wait(start(node)).await;
    if !gamend::core::ok(started) {
        log::warn(gamend::core::error_of(started));
        return ();
    }
    let started = data_of(gamend::core::body(started));
    if !(started is Object) {
        return ();
    }
    let session = format!("{}", started["session_id"]);
    engine::open_url(format!("{}", started["authorization_url"]));
    let waited = 0.0;
    while waited < SIGN_IN_TIMEOUT {
        task::wait(POLL_SECONDS).await;
        waited += POLL_SECONDS;
        let reply = task::wait(poll(node, session)).await;
        if !gamend::core::ok(reply) {
            continue;
        }
        let status = data_of(gamend::core::body(reply));
        if !(status is Object) {
            continue;
        }
        let state = format!("{}", status["status"]);
        if state == "completed" {
            return status;
        }
        if state != "pending" {
            log::warn(`gamend: ${provider} ${status["error"]}: ${status["message"]}`);
            return ();
        }
    }
    log::warn(`gamend: ${provider} timed out`);
    return ();
}

/// What `{"data": ...}` carries, or nil for any other body.
fn data_of(body) {
    if body is Object && body.contains_key("data") {
        return body["data"];
    }
    return ();
}

/// Keep a session for the next run. Not `save`: a function of that name
/// would shadow the engine's `save::` module inside this one.
pub fn keep(session) {
    save::write(SLOT, session);
    return ();
}

/// The session the last run kept, or nil.
pub fn saved() {
    let stored = save::read(SLOT);
    if stored is Object {
        return stored;
    }
    return ();
}

/// Sign out here: the saved session is dropped. The server's own logout is
/// `authenticate_logout`, which a caller makes first when it is online.
pub fn forget() {
    save::remove(SLOT);
    return ();
}

/// Whether this run has a session to restore.
pub fn restorable() {
    return !(saved() is Tuple);
}

/// The signed-in session, or nil: `user_id`, `username`, `display_name` and
/// the tokens.
pub fn session() {
    return gamend::session();
}

/// Whether a session is open, which is what a screen asks before it draws
/// anything of the player's.
pub fn signed_in() {
    let held = session();
    return held is Object && held.contains_key("access_token");
}

/// The signed-in user's id, or an empty string.
pub fn user_id() {
    let held = session();
    if held is Object && held["user_id"] is String {
        return held["user_id"];
    }
    return "";
}
