use core;

/// Claim a completed quest
/// `POST /api/v1/me/quests/{key}/claim`
pub fn claim_quest(key: str) -> int {
    if key == "" {
        return core::missing("gamend::quests::claim_quest", "key");
    }
    core::rest("POST", "/api/v1/me/quests/{key}/claim")
}

/// List quests
/// `GET /api/v1/quests`
pub fn list_quests(options: any) -> int {
    let query = core::query(options, ["category", "page", "page_size"]);
    core::rest("GET", "/api/v1/quests{query}")
}

/// List quests a code can finish
/// `GET /api/v1/quests/redeemable`
pub fn list_redeemable_quests(options: any) -> int {
    let query = core::query(options, ["quest", "page", "page_size"]);
    core::rest("GET", "/api/v1/quests/redeemable{query}")
}

/// List my quests
/// `GET /api/v1/me/quests`
pub fn my_quests(options: any) -> int {
    let query = core::query(options, ["category", "group", "page", "page_size"]);
    core::rest("GET", "/api/v1/me/quests{query}")
}

/// Quest progress counts
/// `GET /api/v1/quests/stats`
pub fn quest_stats() -> int {
    core::rest("GET", "/api/v1/quests/stats")
}

/// Redeem a code
/// `POST /api/v1/me/quests/redeem`
pub fn redeem_quest_code(params: any) -> int {
    if !core::given(params, "token") {
        return core::missing("gamend::quests::redeem_quest_code", "token");
    }
    core::rest("POST", "/api/v1/me/quests/redeem", params)
}

/// List a user's completed quests
/// `GET /api/v1/quests/user/{user_id}`
pub fn user_quests(user_id: str, options: any) -> int {
    if user_id == "" {
        return core::missing("gamend::quests::user_quests", "user_id");
    }
    let query = core::query(options, ["category", "page", "page_size"]);
    core::rest("GET", "/api/v1/quests/user/{user_id}{query}")
}
