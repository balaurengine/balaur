use core;

/// Claim a completed quest
/// `POST /api/v1/me/quests/{key}/claim`
pub async fn claim_quest(key: str) -> any {
    if key == "" {
        return core::missing("gamend::quests::claim_quest", "key");
    }
    let reply = await core::rest("POST", "/api/v1/me/quests/{key}/claim");
    reply
}

/// List quests
/// `GET /api/v1/quests`
pub async fn list_quests(options: any) -> any {
    let query = core::query(options, ["category", "page", "page_size"]);
    let reply = await core::rest("GET", "/api/v1/quests{query}");
    reply
}

/// List quests a code can finish
/// `GET /api/v1/quests/redeemable`
pub async fn list_redeemable_quests(options: any) -> any {
    let query = core::query(options, ["quest", "page", "page_size"]);
    let reply = await core::rest("GET", "/api/v1/quests/redeemable{query}");
    reply
}

/// List my quests
/// `GET /api/v1/me/quests`
pub async fn my_quests(options: any) -> any {
    let query = core::query(options, ["category", "group", "page", "page_size"]);
    let reply = await core::rest("GET", "/api/v1/me/quests{query}");
    reply
}

/// Quest progress counts
/// `GET /api/v1/quests/stats`
pub async fn quest_stats() -> any {
    let reply = await core::rest("GET", "/api/v1/quests/stats");
    reply
}

/// Redeem a code
/// `POST /api/v1/me/quests/redeem`
pub async fn redeem_quest_code(params: any) -> any {
    if !core::given(params, "token") {
        return core::missing("gamend::quests::redeem_quest_code", "token");
    }
    let reply = await core::rest("POST", "/api/v1/me/quests/redeem", params);
    reply
}

/// List a user's completed quests
/// `GET /api/v1/quests/user/{user_id}`
pub async fn user_quests(user_id: str, options: any) -> any {
    if user_id == "" {
        return core::missing("gamend::quests::user_quests", "user_id");
    }
    let query = core::query(options, ["category", "page", "page_size"]);
    let reply = await core::rest("GET", "/api/v1/quests/user/{user_id}{query}");
    reply
}
