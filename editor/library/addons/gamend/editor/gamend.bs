// The Gamend dock: the engine's `gamend` state, the addon's activity log, and
// GETs whose replies `await_reply` keeps, which refills it. Nothing runs on a
// clock.

use activity;
use addons::save::save;
use core;

const CALLS: str = "calls";
const CLAIM: str = "claim";
const ERROR: str = "error";
const ERRORS: str = "errors";
const LINK: str = "link";
const LOGIN: str = "login";
const MESSAGE: str = "message";
const MESSAGES: str = "messages";
const OK: str = "ok";
const OPEN: str = "open";
const PRODUCTION: str = "production";
const ACCEPTED: str = "accepted";
const ALL: str = "all";
const APPROVE_URL: str = "approve_url";
const BODY: str = "body";
const CHECKED: str = "checked";
const CLOUD_DISCONNECT: str = "cloud_disconnect";
const CLOUD_REFRESH: str = "cloud_refresh";
const CODE: str = "code";
const CONTROLS: str = "controls";
const COPY: str = "copy";
const DATA: str = "data";
const DROPPED: str = "dropped";
const FEATURE: str = "feature";
const FILTER: str = "filter";
const GAMEND: str = "gamend";
const GROW: str = "grow";
const HEADERS: str = "headers";
const HEALTH: str = "health";
const HEIGHT: str = "height";
const ID: str = "id";
const KEY: str = "key";
const KIND: str = "kind";
const LABEL: str = "label";
const MASK: str = "mask";
const ME: str = "me";
const METHOD: str = "method";
const NAME: str = "name";
const NAMES: str = "names";
const OPEN_SITE: str = "open_site";
const PARTY: str = "party";
const PATH: str = "path";
const ROLE: str = "role";
const SECRET: str = "secret";
const SERVER: str = "server";
const SERVERS: str = "servers";
const SPECS: str = "specs";
const STATUS: str = "status";
const TEXT: str = "text";
const TIMEOUT_SECONDS: str = "timeout_seconds";
const TITLE: str = "title";
const TOKEN: str = "token";
const TOOLTIP: str = "tooltip";
const TRUNCATE: str = "truncate";
const UNKNOWN: str = "unknown";
const URL: str = "url";
const USER: str = "user";
const USERNAME: str = "username";
const VIEWS: str = "views";

/// The save slots the addon keeps on the device.
const SESSION_SLOT: str = "gamend";
const PREFS_SLOT: str = "gamend_prefs";

/// Where `log_sink.bs` reports, and where the dock asks it to flush now, in
/// the script store.
const LOGS_KEY: str = "gamend:logs";
const FLUSH_KEY: str = "gamend:logs_flush";

/// Where `client.bs` keeps the key-value rows a game subscribed to.
const ROWS_KEY: str = "gamend:rows";

/// The person's Gamend Cloud account, which this dock declares as editor
/// settings, kept in the editor's own file, and the editor API on it.
const CLOUD: str = "editor/gamend/cloud";
const CLOUD_TOKEN: str = "editor/gamend/cloud_token";
const DEFAULT: str = "default";
const HELP: str = "help";
const ORDER: str = "order";
const TYPE: str = "type";
const STRING: str = "string";
const LINKS_PATH: str = "/api/v1/cloud/editor/links";
const CLAIM_PATH: str = "/api/v1/cloud/editor/links/claim";
const SERVERS_PATH: str = "/api/v1/cloud/editor/servers";
/// The claim is held until the person approves the code; the server answers
/// before its own ten minutes, so this only ends a lost connection.
const CLAIM_SECONDS: float = 600.0;

/// What a reply that came back fine, failed, or says little is written in.
const QUIET: str = "text_code_quiet";
const MUTED: str = "text_note";
const FAILED: str = "text_caption_primary";
const SIGNED_IN: str = "text_code_success";

pub class Gamend {
    node: Node,
    // Each GET the dock made, by key: its request id, and its reply once one
    // came back, kept here since the engine keeps only the newest.
    requests: { str: any },
    replies: { str: any },
    // What a person typed into a feature's id field, and the id its views
    // were asked with, by feature.
    drafts: { str: any },
    ids: { str: any },
    kv_draft: str,
    kv_key: str,
    filter: str = "all",
    // The activity rows opened, by `seq`.
    open: { str: any },
    // The newest message's `seq` acted on, by topic.
    seen: { str: any },
    // Gamend Cloud: the code shown while the person approves it, and the
    // requests out to the account and their replies, by kind.
    cloud_link: any,
    cloud_asked: { str: any },
    cloud_replies: { str: any },
}

// The Editor, whose methods are what a plugin reaches the editor through.
fn editor() -> Node {
    scene::get_node("Editor")
}

fn core_pages() -> [str] {
    ["Overview", "Cloud", "User", "Lobby", "Data", "Activity", "Logs"]
}

/// One page per server feature: the id its paths take, where one does, and
/// what it reads.
fn features() -> [any] {
    [
        feature("Leaderboards", "leaderboard id", [
            view("leaderboards", "/api/v1/leaderboards"),
            view("records", "/api/v1/leaderboards/{{id}}/records"),
            view("my record", "/api/v1/leaderboards/{{id}}/records/me"),
        ]),
        feature("Quests", "", [
            view("my quests", "/api/v1/me/quests"),
            view("all quests", "/api/v1/quests"),
            view("progress", "/api/v1/quests/stats"),
        ]),
        feature("Economy", "", [
            view("wallet", "/api/v1/me/wallet"),
            view("inventory", "/api/v1/me/inventory"),
            view("ledger", "/api/v1/me/wallet/ledger"),
        ]),
        feature("Friends", "", [
            view("friends", "/api/v1/me/friends"),
            view("requests", "/api/v1/me/friend_requests"),
            view("blocked", "/api/v1/me/blocked"),
        ]),
        feature("Chat", "", [view("unread", "/api/v1/chat/unread"), view(MESSAGES, "/api/v1/chat/messages")]),
        feature("Parties", "", [view("my party", "/api/v1/parties/me"), view("invitations", "/api/v1/parties/invitations")]),
        feature("Groups", "group id", [
            view("mine", "/api/v1/groups/me"),
            view("all groups", "/api/v1/groups"),
            view("members", "/api/v1/groups/{{id}}/members"),
        ]),
        feature("Tournaments", "tournament id", [
            view("tournaments", "/api/v1/tournaments"),
            view("standings", "/api/v1/tournaments/{{id}}/standings"),
            view("bracket", "/api/v1/tournaments/{{id}}/bracket"),
        ]),
        feature("Matchmaking", "", [view("my ticket", "/api/v1/matchmaking/tickets/me"), view("queues", "/api/v1/matchmaking/stats")]),
        feature("Notifications", "", [view("notifications", "/api/v1/notifications")]),
        feature("Payments", "", [view("catalog", "/api/v1/payments/catalog"), view("entitlements", "/api/v1/payments/entitlements")]),
        feature("Hooks", "", [view("hooks", "/api/v1/hooks")]),
        feature("Users", "", [view(ME, "/api/v1/me"), view("counts", "/api/v1/users/stats")]),
    ]
}

fn feature(name: str, id: str, views: [any]) -> any {
    { NAME: name, ID: id, VIEWS: views }
}

fn view(label: str, path: str) -> any {
    { LABEL: label, PATH: path }
}

fn groups() -> [any] {
    let names: [str] = [];
    for one in features() {
        names.push(one[NAME].as_str());
    }
    [{ TITLE: "", NAMES: core_pages() }, { TITLE: "FEATURES", NAMES: names }]
}

impl Gamend {
    pub fn register() -> any {
        settings::define(CLOUD, {
            TYPE: STRING,
            DEFAULT: "https://gamend.org",
            ORDER: 1,
            HELP: "Where your Gamend Cloud account is: the Gamend dock lists your servers from it.",
        });
        // The settings window draws a `secret` setting as dots.
        settings::define(CLOUD_TOKEN, {
            TYPE: STRING,
            DEFAULT: "",
            SECRET: true,
            ORDER: 2,
            HELP: "What the Gamend dock got when you connected it to your Gamend Cloud account. Kept in the editor's own file; empty disconnects it.",
        });
        { "panels": [{ ID: GAMEND, TITLE: "Gamend", "tall": true, "draw": "fill" }] }
    }

    /// The dock: the two servers and the links in its head, who is signed
    /// in at its foot, a page per view down its side, and that page's rows.
    pub fn fill(payload: any) {
        let host = payload["host"].as_str();
        if gamend::connection().url == "" {
            gamend::configure(nil);
        }
        let ed = editor();
        ed.call("kit_bar", host, "head", header(self.node));
        ed.call("kit_bar", host, "foot", [status_line()]);
        let page = ed.call("kit_pages", host, GAMEND, groups()).as_str();
        ed.call("kit_rows", host, BODY, self.page(page));
    }

    /// A Gamend Cloud request came back: a link starts its claim, a claim
    /// keeps its token, and every reply is kept for the page.
    pub async fn await_cloud_reply(request: int) {
        let reply = await task::wait(request);
        let kind = "";
        for key in self.cloud_asked.keys() {
            if self.cloud_asked[key].as_int() == request {
                kind = key;
            }
        }
        if kind == "" {
            return;
        }
        self.cloud_asked.remove(kind);
        self.cloud_replies[kind] = reply;
        let status = reply[STATUS].as_int();
        let data = parsed(reply[BODY])[DATA];
        if kind == LINK && status == 201 {
            self.cloud_link = { CODE: data[CODE], APPROVE_URL: data[APPROVE_URL] };
            engine::open_url(data[APPROVE_URL].as_str());
            let body = json::encode({ CODE: data[CODE], SECRET: data[SECRET] });
            self.cloud_send(CLAIM, "POST", CLAIM_PATH, body, CLAIM_SECONDS);
        }
        if kind == CLAIM {
            self.cloud_link = nil;
            if status == 200 {
                settings::set(CLOUD_TOKEN, data[TOKEN].as_str());
                editor().call("kit_save_prefs");
                self.cloud_replies.remove(SERVERS);
            }
        }
        editor().call("kit_changed");
    }

    /// A call the dock made came back: kept under the key it was asked for.
    pub async fn await_reply(request: int) {
        let e = await task::wait(request);
        for key in self.requests.keys() {
            if self.requests[key].as_int() == request {
                self.replies[key] = e;
            }
        }
        editor().call("kit_changed");
    }

    fn page(name: str) -> [any] {
        if name == "Overview" {
            return self.overview();
        }
        if name == "Cloud" {
            return self.cloud();
        }
        if name == "User" {
            return self.user();
        }
        if name == "Lobby" {
            return self.lobby();
        }
        if name == "Data" {
            return self.data();
        }
        if name == "Activity" {
            return self.activity();
        }
        if name == "Logs" {
            return logs(self.node);
        }
        self.feature_page(name)
    }

    fn overview() -> [any] {
        let target = gamend::server();
        let link = gamend::connection();
        let out: [any] = [heading("Server")];
        out.push(field(URL, link.url, { COPY: true }));
        out.push(field("target", target.name, {}));
        out.push(field("hook plugin", if target.plugin == "" { "none: set [gamend] plugin" } else { target.plugin }, {}));
        out.push(field(HEALTH, brief(self.fetch(HEALTH, "/api/v1/health")), {}));
        out.push(field("addon", addon_version(), {}));
        out.push(heading("Player"));
        out.push(field(USER, if link.username != nil { link.username.unwrap() } else { "not signed in" }, {}));
        for socket in link.sockets {
            let state = if socket.open { OPEN } else { "closed" };
            out.push(field("socket {socket.socket}", state + ": " + listed(socket.topics), {}));
        }
        out.push(field("saved session", if saved_session() == nil { "none" } else { "yes, readable signed out" }, {}));
        out.push(buttons([refresh_button(self.node, "")]));
        out
    }

    /// The person's Gamend Cloud servers, any of which becomes this
    /// project's `gamend/url` with one press; connecting the editor first.
    fn cloud() -> [any] {
        let base = cloud_url();
        let out: [any] = [heading("Gamend Cloud · " + host_of(base))];
        if cloud_token() == "" {
            return self.cloud_connect_rows(out);
        }
        let reply = self.cloud_servers();
        if reply == nil {
            out.push(line("asking for your servers…", QUIET));
            return out;
        }
        let status = reply[STATUS].as_int();
        if status == 401 {
            out.push(line("This editor was disconnected on " + host_of(base) + ". Connect it again.", FAILED));
            out.push(buttons([button(self.node, "Connect again", CLOUD_DISCONNECT, {})]));
            return out;
        }
        if status != 200 {
            out.push(line("Your servers could not be read: " + describe(reply), FAILED));
            out.push(buttons([button(self.node, "Try again", CLOUD_REFRESH, {})]));
            return out;
        }
        let servers = parsed(reply[BODY])[DATA];
        let current = gamend::server().production;
        if servers.len() == 0 {
            out.push(empty("no servers yet: make one on " + host_of(base) + "/servers"));
        }
        for i in 0..servers.len() {
            let one = servers[i];
            let url = one[URL].as_str();
            out.push(heading(one["slug"].as_str()));
            out.push(field("address", url, { COPY: true }));
            out.push(field(STATUS, one[STATUS].as_str() + " · " + one["size"].as_str(), {}));
            let picked = url == current;
            let pick = button(self.node, if picked { "This project's server" } else { "Use for this project" }, "cloud_pick", { URL: url });
            pick[CHECKED] = picked;
            out.push(buttons([pick]));
        }
        out.push(buttons([
            button(self.node, "Refresh", CLOUD_REFRESH, {}),
            button(self.node, "Open on " + host_of(base), OPEN_SITE, { URL: base + "/servers" }),
            button(self.node, "Disconnect", CLOUD_DISCONNECT, {}),
        ]));
        out
    }

    fn cloud_connect_rows(out: [any]) -> [any] {
        if self.cloud_link != nil {
            out.push(field(CODE, self.cloud_link[CODE].as_str(), {}));
            out.push(line("Approve this code on the page that opened in your browser. The dock waits for it.", MUTED));
            out.push(buttons([
                button(self.node, "Open the page again", OPEN_SITE, { URL: self.cloud_link[APPROVE_URL].as_str() }),
                button(self.node, "Cancel", "cloud_cancel", {}),
            ]));
            return out;
        }
        out.push(line("Connect this editor to your Gamend Cloud account to list your servers here and make one this project's server.", MUTED));
        out.push(buttons([button(self.node, "Connect", "cloud_connect", {})]));
        let failed = self.cloud_replies[CLAIM];
        if failed == nil {
            failed = self.cloud_replies[LINK];
        }
        if failed != nil && failed[STATUS].as_int() != 200 && failed[STATUS].as_int() != 201 {
            let text = if failed[STATUS].as_int() == 410 { "The code ran out before it was approved. Connect again." } else { "Not connected: " + describe(failed) };
            out.push(line(text, FAILED));
        }
        out
    }

    /// The servers' reply, asked for once and kept until Refresh.
    fn cloud_servers() -> any {
        let held = self.cloud_replies[SERVERS];
        if held != nil {
            return held;
        }
        if !self.cloud_asked.has(SERVERS) {
            self.cloud_send(SERVERS, "GET", SERVERS_PATH, nil, 15.0);
        }
        nil
    }

    /// A request to the person's Gamend Cloud account, with the editor's
    /// token when it has one; `await_cloud_reply` takes its reply.
    fn cloud_send(kind: str, method: str, path: str, body: any, seconds: float) {
        let headers = [
            http::Header { name: "content-type", value: "application/json" },
            http::Header { name: "accept", value: "application/json" },
        ];
        let token = cloud_token();
        if token != "" {
            headers.push(http::Header { name: "authorization", value: "Bearer " + token });
        }
        let opts: any = { METHOD: method, HEADERS: headers, TIMEOUT_SECONDS: seconds };
        if body != nil {
            opts[BODY] = body;
        }
        let asked = http::request(cloud_url() + path, opts);
        self.cloud_asked[kind] = asked;
        self.node.call("await_cloud_reply", asked);
    }

    fn user() -> [any] {
        let held = gamend::session();
        if held == nil {
            return self.signed_out();
        }
        let session = held.unwrap();
        // A token is masked here and on a saved session: a screenshot of the
        // dock should never carry one.
        let secret: any = { MASK: true, COPY: true };
        let out: [any] = [heading("Session")];
        out.push(field("user id", session.user_id, { COPY: true }));
        out.push(field(USERNAME, session.username, {}));
        out.push(field("display name", session.display_name, {}));
        out.push(field("access token", session.access_token, secret));
        out.push(field("expires", expires(session.expires_at), {}));
        out.push(field("refresh token", session.refresh_token, secret));
        out.push(buttons([
            button(self.node, "Keep for the next run", "keep_session", {}),
            button(self.node, "Sign out here", "sign_out", {}),
        ]));
        out.push(heading("Profile"));
        show(out, ME, self.fetch(ME, "/api/v1/me"));
        out
    }

    fn signed_out() -> [any] {
        let out: [any] = [empty("not signed in")];
        out.push(buttons([button(self.node, "Sign in with this device", "sign_in", {})]));
        let login = self.replies[LOGIN];
        if login != nil {
            out.push(line(brief(login), MUTED));
        }
        let saved = saved_session();
        if saved != nil {
            out.push(heading("Saved session, from an earlier run"));
            for key in saved.keys() {
                let secret = key.ends_with(TOKEN);
                out.push(field(key, saved[key], { MASK: secret, COPY: secret }));
            }
            out.push(buttons([
                button(self.node, "Restore it", "restore_saved", {}),
                button(self.node, "Forget it", "forget_saved", {}),
            ]));
        }
        out
    }

    fn lobby() -> [any] {
        let ids: [str] = [];
        for socket in gamend::connection().sockets {
            for topic in socket.topics {
                if topic.starts_with("lobby:") {
                    ids.push(topic.replace("lobby:", ""));
                }
            }
        }
        self.follow(ids);
        let out: [any] = [];
        if ids.len() == 0 {
            out.push(empty("not in a lobby: its topic shows here once the game joins one"));
        }
        for id in ids {
            out.push(heading("Lobby {id}"));
            show(out, "lobby:" + id, self.fetch("lobby:" + id, "/api/v1/lobbies/" + id));
        }
        out.push(heading("Party"));
        show(out, PARTY, self.fetch(PARTY, "/api/v1/parties/me"));
        out.push(buttons([refresh_button(self.node, "")]));
        out
    }

    /// Ask again for what a newer message on its topic changed: a member
    /// joining, leaving or going offline arrives as one.
    fn follow(ids: [str]) {
        let newest = newest_messages();
        for id in ids {
            self.refresh_on(newest, "lobby:" + id, "lobby:" + id);
        }
        for topic in newest.keys() {
            if topic.starts_with("party:") {
                self.refresh_on(newest, topic, PARTY);
            }
        }
    }

    fn refresh_on(newest: any, topic: str, key: str) {
        let seq = newest[topic].as_int();
        if seq > self.seen[topic].as_int() {
            self.seen[topic] = seq;
            self.drop_key(key);
        }
    }

    fn data() -> [any] {
        let ed = editor();
        let out: [any] = [heading("On this device")];
        append(out, ed.call("kit_files", "gamend-data", { "only": [SESSION_SLOT + ".toml", PREFS_SLOT + ".toml"] }));
        out.push(heading("On the server, key-value"));
        out.push(buttons([
            text_field(self.node, "kv_typed", self.kv_draft, "a key", {}),
            button(self.node, "Get", "kv_get", {}),
        ]));
        let key = "kv:" + self.kv_key;
        if self.kv_key != "" && self.requests.has(key) {
            show(out, key, self.fetch(key, "/api/v1/kv/" + self.kv_key));
        }
        out.push(heading("Rows the game keeps"));
        let rows = script::stored(ROWS_KEY);
        if rows.keys().len() == 0 {
            out.push(line("none: the rows a playing game subscribed to with `register_kv` show here", QUIET));
        } else {
            append(out, ed.call("kit_tree", "gamend:rows", rows, {})[SPECS]);
        }
        out
    }

    fn activity() -> [any] {
        let chips: [any] = [];
        for name in [ALL, CALLS, MESSAGES, ERRORS] {
            let chip = button(self.node, name, "filter_by", { FILTER: name });
            chip[CHECKED] = self.filter == name;
            chips.push(chip);
        }
        chips.push(button(self.node, "Clear", "clear_activity", {}));
        let out: [any] = [buttons(chips)];
        let rows = activity::rows();
        if rows.len() == 0 {
            out.push(empty("no calls yet"));
        }
        for row in rows {
            if kept(self.filter, row) {
                self.activity_row(out, row);
            }
        }
        out
    }

    fn activity_row(out: [any], row: activity::Entry) {
        let key = "{row.seq}";
        let open = self.open[key].as_bool();
        let took = "";
        if row.ms != nil {
            let ms = row.ms.unwrap() as int;
            took = "{ms} ms";
        }
        let mark = if open { "▾" } else { "▸" };
        let role = if failed(row) { FAILED } else if row.kind == MESSAGE { QUIET } else { MUTED };
        let what = label(row.what + "  " + row.status + "  " + took, role);
        what[GROW] = 1;
        what[TRUNCATE] = true;
        out.push(buttons([button(self.node, mark + " " + row.kind, "toggle_row", { KEY: key }), what]));
        if open {
            let both: any = { "args": row.args, "reply": row.reply };
            append(out, editor().call("kit_tree", "gamend:" + key, both, {})[SPECS]);
        }
    }

    fn feature_page(name: str) -> [any] {
        let found: any = {};
        for one in features() {
            if one[NAME].as_str() == name {
                found = one;
            }
        }
        let out: [any] = [];
        if gamend::session() == nil {
            out.push(line("not signed in: most of these are the player's own, so sign in on the User tab", QUIET));
        }
        let wants = found[ID].as_str();
        let id = self.ids[name].as_str();
        let bar: [any] = [];
        if wants != "" {
            bar.push(text_field(self.node, "id_typed", self.drafts[name].as_str(), wants, { FEATURE: name }));
        }
        bar.push(refresh_button(self.node, name));
        out.push(buttons(bar));
        let views = found[VIEWS];
        for i in 0..views.len() {
            let title = views[i][LABEL].as_str();
            let path = views[i][PATH].as_str();
            out.push(heading(title + " · GET " + path));
            if path.contains("{{id}}") && id == "" {
                out.push(line("needs a " + wants, QUIET));
                continue;
            }
            let key = name + "/" + title + "/" + id;
            show(out, key, self.fetch(key, path.replace("{{id}}", id)));
        }
        out
    }

    /// A GET the dock made, by key: sent once, and nil until `await_reply`
    /// keeps its reply.
    fn fetch(key: str, path: str) -> any {
        let held = self.replies[key];
        if held != nil {
            return held;
        }
        if !self.requests.has(key) {
            let asked = core::rest("GET", path);
            self.requests[key] = asked;
            self.node.call("await_reply", asked);
        }
        nil
    }

    /// Drop one fetched key, so it is asked for again.
    fn drop_key(key: str) {
        self.requests.remove(key);
        self.replies.remove(key);
    }

    /// Drop what the dock fetched under a key prefix, so it asks again.
    fn forget(prefix: str) {
        for key in self.requests.keys() {
            if key.starts_with(prefix) {
                self.drop_key(key);
            }
        }
    }

    // What the dock's controls call, through the Editor's `relay`: each is
    // handed the control's `data` and its edit, and the dock fills again
    // after it.

    /// Talk to the other of the project's servers from now on, remembered
    /// for this person only.
    pub fn pick_server(data: any, _value: any) {
        let name = data[SERVER].as_str();
        if gamend::server().name == name && gamend::connection().url == gamend::server().url {
            return;
        }
        settings::set("gamend/server", name);
        editor().call("kit_save_prefs");
        gamend::configure(nil);
        self.forget("");
    }

    /// Ask the account for a code, then wait for the person to approve it.
    pub fn cloud_connect(_data: any, _value: any) {
        self.cloud_replies = {};
        let body = json::encode({ LABEL: "Balaur editor" });
        self.cloud_send(LINK, "POST", LINKS_PATH, body, 15.0);
    }

    /// Stop waiting: the held claim is cut and the code left to run out.
    pub fn cloud_cancel(_data: any, _value: any) {
        if self.cloud_asked.has(CLAIM) {
            http::cancel(self.cloud_asked[CLAIM].as_int());
            self.cloud_asked.remove(CLAIM);
        }
        self.cloud_link = nil;
    }

    pub fn cloud_refresh(_data: any, _value: any) {
        self.cloud_replies.remove(SERVERS);
    }

    /// Forget the token here. gamend.org's `/editor/connect` lists it until
    /// it is disconnected there too.
    pub fn cloud_disconnect(_data: any, _value: any) {
        settings::set(CLOUD_TOKEN, "");
        editor().call("kit_save_prefs");
        self.cloud_replies = {};
    }

    /// Make a server this project's: `gamend/url`, kept in `project.toml`,
    /// and the dock talking to it when production is the target.
    pub fn cloud_pick(data: any, _value: any) {
        settings::set("gamend/url", data[URL].as_str());
        editor().call("kit_save_project");
        gamend::configure(nil);
        self.forget("");
    }

    pub fn open_site(data: any, _value: any) {
        engine::open_url(data[URL].as_str());
    }

    /// Ask again for what a page shows; a feature's page takes the id
    /// typed into it too.
    pub fn refresh(data: any, _value: any) {
        let name = data[FEATURE].as_str();
        if name == "" {
            self.forget("");
            return;
        }
        self.ids[name] = self.drafts[name].as_str();
        self.forget(name + "/");
    }

    pub fn sign_in(_data: any, _value: any) {
        self.forget(LOGIN);
        let asked = core::login(gamend::Credentials { device_id: engine::device_id() }, "device");
        self.requests[LOGIN] = asked;
        self.node.call("await_reply", asked);
    }

    /// The session as `auth.bs` keeps it.
    pub fn keep_session(_data: any, _value: any) {
        let held = gamend::session();
        if held == nil {
            return;
        }
        let s = held.unwrap();
        save::write(SESSION_SLOT, {
            "user_id": s.user_id,
            USERNAME: s.username,
            "display_name": s.display_name,
            "access_token": s.access_token,
            "refresh_token": s.refresh_token,
            "expires_in": s.expires_in,
        });
    }

    pub fn sign_out(_data: any, _value: any) {
        gamend::restore(nil);
        self.forget("");
    }

    pub fn restore_saved(_data: any, _value: any) {
        gamend::restore(saved_session());
        self.forget("");
    }

    pub fn forget_saved(_data: any, _value: any) {
        save::remove(SESSION_SLOT);
    }

    /// A field's change and its Enter both land here: Enter brings the text
    /// the field already said, and is what asks.
    pub fn kv_typed(_data: any, value: any) {
        let typed = value.as_str();
        if typed == self.kv_draft {
            self.kv_get();
        }
        self.kv_draft = typed;
    }

    pub fn kv_get(_data: any, _value: any) {
        self.kv_key = self.kv_draft;
        let key = "kv:" + self.kv_key;
        self.drop_key(key);
        if self.kv_key != "" {
            self.fetch(key, "/api/v1/kv/" + self.kv_key);
        }
    }

    /// As `kv_typed`, for a feature's id: Enter asks its views with it.
    pub fn id_typed(data: any, value: any) {
        let name = data[FEATURE].as_str();
        let typed = value.as_str();
        if typed == self.drafts[name].as_str() {
            self.ids[name] = typed;
        }
        self.drafts[name] = typed;
    }

    pub fn filter_by(data: any, _value: any) {
        self.filter = data[FILTER].as_str();
    }

    pub fn clear_activity(_data: any, _value: any) {
        activity::clear();
    }

    pub fn toggle_row(data: any, _value: any) {
        let key = data[KEY].as_str();
        self.open[key] = !self.open[key].as_bool();
    }

    pub fn flush_logs(_data: any, _value: any) {
        script::store(FLUSH_KEY, "yes");
    }
}

/// The two servers, and the links to the one in use.
fn header(to: Node) -> [any] {
    let target = gamend::server();
    let url = gamend::connection().url;
    let out: [any] = [];
    for name in [PRODUCTION, "local"] {
        let at = if name == PRODUCTION { target.production } else { target.local };
        let on = target.name == name && url == at;
        let pick = button(to, name + " · " + host_of(at), "pick_server", { SERVER: name });
        pick[CHECKED] = on;
        pick[TOOLTIP] = at;
        out.push(pick);
    }
    let site = button(to, "Open", OPEN_SITE, { URL: url });
    site[TOOLTIP] = url;
    out.push(site);
    let admin = button(to, "Admin", OPEN_SITE, { URL: url + "/admin" });
    admin[TOOLTIP] = url + "/admin";
    out.push(admin);
    out
}

/// Who is signed in, over what.
fn status_line() -> any {
    let link = gamend::connection();
    let signed = link.username != nil;
    let who = if signed { "signed in as " + link.username.unwrap() } else { "not signed in" };
    let open = 0;
    let topics = 0;
    for socket in link.sockets {
        if socket.open {
            open += 1;
        }
        topics += socket.topics.len();
    }
    let sockets = if open > 0 { "socket open, {topics} topics" } else { "no socket open" };
    let line = label(who + "  ·  " + sockets, if signed { SIGNED_IN } else { MUTED });
    line[GROW] = 1;
    line[TRUNCATE] = true;
    line
}

fn logs(to: Node) -> [any] {
    let out: [any] = [heading("This run")];
    let path = log::file();
    if path != nil {
        let near = editor().call("kit_short_path", path.unwrap()).as_str();
        out.push(field("log file", near, { COPY: true, "copy_text": path.unwrap() }));
    } else {
        out.push(field("log file", "none: [log] file is off", {}));
    }
    out.push(heading("Shipping to Gamend"));
    let report = script::stored(LOGS_KEY);
    if report.kind() != types::KIND_MAP {
        out.push(line("not shipping: put addons/gamend/log_sink.bs on a node that lives as long as the game", QUIET));
        return out;
    }
    for name in ["shipping", "floor", "run", "pending", "last flush", ACCEPTED, DROPPED] {
        out.push(field(name, report[name], {}));
    }
    out.push(buttons([button(to, "Flush now", "flush_logs", {})]));
    out
}

/// The newest message's `seq` on each topic.
fn newest_messages() -> any {
    let out: any = {};
    for row in activity::rows() {
        if row.kind != MESSAGE {
            continue;
        }
        let parts = row.what.split(" ");
        let topic = parts[0];
        if !out.has(topic) {
            out[topic] = row.seq;
        }
    }
    out
}

fn kept(filter: str, row: activity::Entry) -> bool {
    if filter == CALLS {
        return row.kind != MESSAGE;
    }
    if filter == MESSAGES {
        return row.kind == MESSAGE;
    }
    if filter == ERRORS {
        return failed(row);
    }
    true
}

/// A call that came back refused or not at all: anything but a 1xx-3xx
/// status, a socket reply of "ok", or one still waiting.
fn failed(row: activity::Entry) -> bool {
    let status = row.status;
    if row.kind == MESSAGE || status == activity::WAITING || status == OK || status == OPEN {
        return false;
    }
    !(status.starts_with("1") || status.starts_with("2") || status.starts_with("3"))
}

/// A reply as rows: a structure when it came back, a line when it did not.
fn show(out: [any], key: str, reply: any) {
    if reply == nil {
        out.push(line("loading…", QUIET));
        return;
    }
    if reply[KIND].as_str() == ERROR {
        out.push(line(reply[ERROR].as_str(), FAILED));
        return;
    }
    let status = reply[STATUS].as_int();
    let body = reply[BODY];
    if status >= 400 {
        out.push(line("{status}: " + short(body), FAILED));
        return;
    }
    let shown = if body.kind() == types::KIND_MAP && body.has(DATA) { body[DATA] } else { body };
    if shown == nil {
        out.push(line("{status}: empty", QUIET));
        return;
    }
    append(out, editor().call("kit_tree", "gamend:" + key, shown, {})[SPECS]);
}

/// A reply in a few words, for a single row.
fn brief(reply: any) -> str {
    if reply == nil {
        return "…";
    }
    let kind = reply[KIND].as_str();
    if kind == ERROR {
        return reply[ERROR].as_str();
    }
    if kind == LOGIN {
        return "signed in as " + reply[USERNAME].as_str();
    }
    let status = reply[STATUS].as_int();
    "{status}: " + short(reply[BODY])
}

fn short(value: any) -> str {
    let chars = json::encode(value).chars();
    let out = "";
    for n in 0..chars.len() {
        if n == 90 {
            return out + "…";
        }
        out = out + chars[n];
    }
    out
}

/// When the token stops working, read from its own `exp` claim.
fn expires(at: int?) -> str {
    if at == nil {
        return UNKNOWN;
    }
    let left = at.unwrap() - (engine::unix_time() as int);
    if left <= 0 {
        return "expired: the next call refreshes it";
    }
    if left >= 172800 {
        let days = left / 86400;
        return "in {days} days";
    }
    if left >= 7200 {
        let hours = left / 3600;
        let minutes = (left % 3600) / 60;
        return "in {hours} h {minutes} min";
    }
    let minutes = left / 60;
    let seconds = left % 60;
    "in {minutes} min {seconds} s"
}

/// The session `auth.bs` kept for the next run, or nil.
fn saved_session() -> any {
    for slot in save::slots() {
        if slot == SESSION_SLOT {
            let held = save::read(SESSION_SLOT);
            if held.kind() == types::KIND_MAP {
                return held;
            }
        }
    }
    nil
}

fn addon_version() -> str {
    let text = fs::read(editor().call("game_root").as_str() + "/addons/gamend/version.bs");
    if text == nil {
        return UNKNOWN;
    }
    let parts = text.unwrap().split("\"");
    if parts.len() >= 2 { parts[1] } else { UNKNOWN }
}

fn cloud_url() -> str {
    let set = settings::get(CLOUD);
    let url = if set.kind() == types::KIND_STRING { set.as_str() } else { "" };
    if url == "" { "https://gamend.org" } else { url.trim() }
}

fn cloud_token() -> str {
    let set = settings::get(CLOUD_TOKEN);
    if set.kind() == types::KIND_STRING { set.as_str() } else { "" }
}

/// A reply's body as data: `http::` answers text.
fn parsed(body: any) -> any {
    if body.kind() == types::KIND_STRING { json::parse(body.as_str()) } else { body }
}

/// Why a raw reply failed, in a few words.
fn describe(reply: any) -> str {
    if reply[KIND].as_str() == ERROR {
        return reply[ERROR].as_str();
    }
    let body = parsed(reply[BODY]);
    let error = body[ERROR];
    let status = reply[STATUS].as_int();
    if error.kind() == types::KIND_STRING { "{status} " + error.as_str() } else { "status {status}" }
}

fn host_of(url: str) -> str {
    url.replace("https://", "").replace("http://", "")
}

fn listed(items: [str]) -> str {
    let out = "";
    for item in items {
        if out != "" {
            out = out + ", ";
        }
        out = out + item;
    }
    if out == "" { "no topics" } else { out }
}

// The kit's rows, which the Editor builds: see editor/scripts/kit.bs.

fn heading(title: str) -> any {
    editor().call("kit_heading", title)
}

fn empty(text: str) -> any {
    editor().call("kit_empty", text)
}

fn field(name: str, value: any, opts: any) -> any {
    editor().call("kit_field", name, value, opts)
}

/// Put every spec of a list the kit answered onto `out`.
fn append(out: [any], specs: any) {
    for i in 0..specs.len() {
        out.push(specs[i]);
    }
}

fn label(text: str, role: str) -> any {
    { KIND: ui::WIDGET_LABEL, ROLE: role, TEXT: text }
}

/// A line of text across the dock, wrapped.
fn line(text: str, role: str) -> any {
    let words = label(text, role);
    words[GROW] = 1;
    words["wrap"] = true;
    { HEIGHT: 0, CONTROLS: [words] }
}

/// A row of controls across the dock.
fn buttons(controls: [any]) -> any {
    { HEIGHT: 26, CONTROLS: controls }
}

/// A chip whose press calls `method` on the dock's node, with `data`.
fn button(to: Node, text: str, method: str, data: any) -> any {
    {
        KIND: ui::WIDGET_BUTTON,
        ROLE: "chip",
        TEXT: text,
        "on_click": "relay",
        DATA: relayed(data, to, method),
    }
}

// `data` with the node and the method a relayed press calls.
fn relayed(data: any, to: Node, method: str) -> any {
    let out: any = {};
    for key in data.keys() {
        out[key] = data[key];
    }
    out["to"] = to;
    out[METHOD] = method;
    out
}

/// A field whose every edit, and its Enter, call `method` on the dock's node.
fn text_field(to: Node, method: str, text: str, placeholder: str, data: any) -> any {
    {
        KIND: ui::WIDGET_TEXT_FIELD,
        ROLE: "input_form",
        "width": 220,
        TEXT: text,
        "placeholder": placeholder,
        "on_change": "relay",
        "on_submit": "relay",
        DATA: relayed(data, to, method),
    }
}

fn refresh_button(to: Node, page: str) -> any {
    button(to, "Refresh", "refresh", { FEATURE: page })
}
