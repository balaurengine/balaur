// The Gamend dock, an editor plugin this addon carries. It keeps nothing of
// the server's: it reads the engine's `gamend` state, and asks the server with
// the session the played game made, reading each reply on a later frame.

/// The save slots the addon keeps on the device.
const SESSION_SLOT = "gamend";
const PREFS_SLOT = "gamend_prefs";

/// Where `log_sink.rn` reports, and where the dock asks it to flush now.
const LOGS_KEY = "gamend:logs";
const FLUSH_KEY = "gamend:logs_flush";

/// Where `client.rn` caches the key-value rows a game subscribed to.
const ROWS_KEY = "gamend:rows";

/// How many draws the rows scan is reused for: it walks the whole scene.
const ROWS_EVERY = 30;

pub fn state() {
    #{
        requests: #{}, replies: #{}, ids: #{}, filter: "all", open: #{}, kv_key: "",
        seen: #{}, rows: #{}, rows_in: 0,
    }
}

pub fn register() {
    #{ panels: [#{ id: "gamend", title: "Gamend", tall: true, draw: draw }] }
}

fn core_tabs() {
    ["Overview", "User", "Lobby", "Data", "Activity", "Logs"]
}

/// One tab per server feature: the id its paths take, where one does, and
/// what it reads, each `[label, path]`.
fn features() {
    [
        #{ name: "Leaderboards", id: "leaderboard id", views: [
            ["leaderboards", "/api/v1/leaderboards"],
            ["records", "/api/v1/leaderboards/{id}/records"],
            ["my record", "/api/v1/leaderboards/{id}/records/me"],
        ] },
        #{ name: "Quests", id: "", views: [
            ["my quests", "/api/v1/me/quests"],
            ["all quests", "/api/v1/quests"],
            ["progress", "/api/v1/quests/stats"],
        ] },
        #{ name: "Economy", id: "", views: [
            ["wallet", "/api/v1/me/wallet"],
            ["inventory", "/api/v1/me/inventory"],
            ["ledger", "/api/v1/me/wallet/ledger"],
        ] },
        #{ name: "Friends", id: "", views: [
            ["friends", "/api/v1/me/friends"],
            ["requests", "/api/v1/me/friend_requests"],
            ["blocked", "/api/v1/me/blocked"],
        ] },
        #{ name: "Chat", id: "", views: [
            ["unread", "/api/v1/chat/unread"],
            ["messages", "/api/v1/chat/messages"],
        ] },
        #{ name: "Parties", id: "", views: [
            ["my party", "/api/v1/parties/me"],
            ["invitations", "/api/v1/parties/invitations"],
        ] },
        #{ name: "Groups", id: "group id", views: [
            ["mine", "/api/v1/groups/me"],
            ["all groups", "/api/v1/groups"],
            ["members", "/api/v1/groups/{id}/members"],
        ] },
        #{ name: "Tournaments", id: "tournament id", views: [
            ["tournaments", "/api/v1/tournaments"],
            ["standings", "/api/v1/tournaments/{id}/standings"],
            ["bracket", "/api/v1/tournaments/{id}/bracket"],
        ] },
        #{ name: "Matchmaking", id: "", views: [
            ["my ticket", "/api/v1/matchmaking/tickets/me"],
            ["queues", "/api/v1/matchmaking/stats"],
        ] },
        #{ name: "Notifications", id: "", views: [
            ["notifications", "/api/v1/notifications"],
        ] },
        #{ name: "Payments", id: "", views: [
            ["catalog", "/api/v1/payments/catalog"],
            ["entitlements", "/api/v1/payments/entitlements"],
        ] },
        #{ name: "Hooks", id: "", views: [
            ["hooks", "/api/v1/hooks"],
        ] },
        #{ name: "Users", id: "", views: [
            ["me", "/api/v1/me"],
            ["counts", "/api/v1/users/stats"],
        ] },
    ]
}

pub fn draw(S, k, host) {
    // Live numbers: the dock asks for the next pass while it is open.
    ui::request_repaint();
    let me = S.plugins["gamend"];
    if gamend::connection()["url"] == "" {
        gamend::configure(());
    }
    let strip = S.kit.strip;
    let pages = S.kit.pages;
    let rows = S.kit.rows;
    strip(S, host, "head", header(S, me));
    let names = [];
    for feature in features() {
        names.push(feature.name);
    }
    let groups = [#{ title: "", names: core_tabs() }, #{ title: "FEATURES", names: names }];
    let tab = pages(S, host, "gamend", groups);
    rows(S, host, "body", page(S, me, tab));
}

/// Every row the open tab shows.
fn page(S, me, tab) {
    let out = [];
    if tab == "Overview" {
        overview(S, me, out);
    } else if tab == "User" {
        user(S, me, out);
    } else if tab == "Lobby" {
        lobby(S, me, out);
    } else if tab == "Data" {
        data(S, me, out);
    } else if tab == "Activity" {
        activity(S, me, out);
    } else if tab == "Logs" {
        logs(S, out);
    } else {
        feature_tab(S, me, tab, out);
    }
    out
}

/// A row of chips and verbs, which the head and several pages are made of.
fn verbs(controls) {
    #{ full: true, height: 26, slot_role: "layout_actions", controls: controls }
}

/// A line of prose, in the role its news deserves.
fn note(text, role) {
    #{ full: true, height: 0, controls: [#{
        kind: "label", role: role, grow: 1, wrap: true, text: text,
    }] }
}

fn chip(text, on, tip, act) {
    #{
        kind: "button", text: text, tooltip: tip,
        role: "chip", checked: on,
        on: |_| { act(); },
    }
}

/// The two servers, the links, and who is signed in over what. The head is a
/// `flow`, so these wrap rather than measuring the width themselves.
fn header(S, me) {
    let target = gamend::target();
    let link = gamend::connection();
    let url = link["url"];
    let out = [];
    for entry in ["production", "local"] {
        // Bound afresh: a closure made in a loop captures the binding.
        let name = entry;
        let at = target[name];
        let on = target["name"] == name && url == at;
        out.push(chip(format!("{} · {}", name, host_of(at)), on, at, || {
            if !on {
                pick(S, me, name);
            }
        }));
    }
    out.push(chip("Open", false, url, || { engine::open_url(url); }));
    out.push(chip("Admin", false, url + "/admin", || { engine::open_url(url + "/admin"); }));
    out.push(status(link));
    out
}

/// Talk to the other of the project's servers from now on, remembered for
/// this person only.
fn pick(S, me, name) {
    settings::set("gamend/target", name);
    let commit = S.kit.save_prefs;
    commit(S);
    gamend::configure(());
    forget(me, "");
}

fn status(link) {
    let user = link["username"];
    let who = if user is String { format!("signed in as {}", user) } else { "not signed in" };
    let open = 0;
    let topics = 0;
    for socket in link["sockets"] {
        if socket["open"] {
            open += 1;
        }
        topics += socket["topics"].len();
    }
    let sockets = if open > 0 { format!("socket open, {} topics", topics) } else { "no socket open" };
    // No `truncate`: the head is a `flow`, and a line that reports no width
    // of its own is one the row cannot wrap around.
    #{
        kind: "label",
        role: if user is String { "text_code_success" } else { "text_code_quiet" },
        text: format!("{}  ·  {}", who, sockets),
    }
}

fn overview(S, me, out) {
    let section = S.kit.section;
    let field = S.kit.field;
    let target = gamend::target();
    let link = gamend::connection();
    out.push(section("Server"));
    out.push(field(S, "url", link["url"], #{ copy: true }));
    out.push(field(S, "target", target["name"], #{}));
    let plugin = if target["plugin"] == "" { "none: set [gamend] plugin" } else { target["plugin"] };
    out.push(field(S, "hook plugin", plugin, #{}));
    out.push(field(S, "health", brief(fetch(me, "health", "/api/v1/health")), #{}));
    out.push(field(S, "addon", addon_version(S), #{}));
    out.push(section("Player"));
    let user = link["username"];
    let who = if user is String { user } else { "not signed in" };
    out.push(field(S, "user", who, #{}));
    for socket in link["sockets"] {
        let state = if socket["open"] { "open" } else { "closed" };
        out.push(field(S, format!("socket {}", socket["socket"]),
            format!("{}: {}", state, listed(socket["topics"])), #{}));
    }
    let saved = if saved_session() is Object { "yes, readable signed out" } else { "none" };
    out.push(field(S, "saved session", saved, #{}));
    out.push(verbs([refresh_button(me, "")]));
}

fn user(S, me, out) {
    let session = gamend::session();
    if !(session is Object) {
        signed_out(S, me, out);
        return;
    }
    let section = S.kit.section;
    let field = S.kit.field;
    out.push(section("Session"));
    out.push(field(S, "user id", session["user_id"], #{ copy: true }));
    out.push(field(S, "username", session["username"], #{}));
    out.push(field(S, "display name", session["display_name"], #{}));
    out.push(field(S, "access token", session["access_token"], #{ mask: true, copy: true }));
    out.push(field(S, "expires", expires(session["expires_at"]), #{}));
    out.push(field(S, "refresh token", session["refresh_token"], #{ mask: true, copy: true }));
    out.push(verbs([
        chip("Keep for the next run", false, "", || { keep_session(session); }),
        chip("Sign out here", false, "", || {
            gamend::restore(());
            forget(me, "");
        }),
    ]));
    out.push(section("Profile"));
    show(S, "me", fetch(me, "me", "/api/v1/me"), out);
}

fn signed_out(S, me, out) {
    let empty = S.kit.empty;
    out.push(empty("not signed in"));
    out.push(verbs([chip("Sign in with this device", false, "", || {
        forget(me, "login");
        let (ok, id) = script::attempt(|| gamend::login((), #{ device_id: engine::device_id() }));
        if ok {
            me.requests["login"] = id;
        } else {
            let refused = #{ kind: "error", error: format!("{}", id) };
            me.replies["login"] = refused;
        }
    })]));
    let login = me.replies.get("login").unwrap_or(());
    let asked = me.requests.get("login").unwrap_or(());
    let reply = if login is Tuple && asked is i64 { gamend::reply(asked) } else { login };
    if !(reply is Tuple) {
        out.push(note(brief(reply), "text_caption"));
    }
    let saved = saved_session();
    if !(saved is Object) {
        return;
    }
    let section = S.kit.section;
    let field = S.kit.field;
    out.push(section("Saved session, from an earlier run"));
    for key in saved.keys() {
        // A token is masked here as on a live session: a screenshot of the
        // dock should never carry one.
        let secret = key.ends_with("token");
        out.push(field(S, key, saved[key], #{ mask: secret, copy: secret }));
    }
    out.push(verbs([
        chip("Restore it", false, "", || {
            gamend::restore(saved);
            forget(me, "");
        }),
        chip("Forget it", false, "", || { save::remove(SESSION_SLOT); }),
    ]));
}

fn lobby(S, me, out) {
    let section = S.kit.section;
    let empty = S.kit.empty;
    let ids = [];
    for socket in gamend::connection()["sockets"] {
        for topic in socket["topics"] {
            if topic.starts_with("lobby:") {
                ids.push(topic.replace("lobby:", ""));
            }
        }
    }
    follow(me, ids);
    if ids.len() == 0 {
        out.push(empty("not in a lobby: its topic shows here once the game joins one"));
    }
    for id in ids {
        out.push(section(format!("Lobby {}", id)));
        show(S, "lobby:" + id, fetch(me, "lobby:" + id, "/api/v1/lobbies/" + id), out);
    }
    out.push(section("Party"));
    show(S, "party", fetch(me, "party", "/api/v1/parties/me"), out);
    out.push(verbs([refresh_button(me, "")]));
}

fn data(S, me, out) {
    let section = S.kit.section;
    let files = S.kit.files;
    out.push(section("On this device"));
    for spec in files(S, "gamend-data", #{ only: [SESSION_SLOT + ".toml", PREFS_SLOT + ".toml"] }) {
        out.push(spec);
    }
    out.push(section("On the server, key-value"));
    out.push(verbs([
        #{
            kind: "text_field", role: "input_form", width: 220, placeholder: "a key",
            text: me.kv_key,
            on: |typed| { me.kv_key = typed; },
            on_submit: |typed| {
                me.kv_key = typed;
                drop_key(me, "kv:" + typed);
            },
        },
        chip("Get", false, "", || { drop_key(me, "kv:" + me.kv_key); }),
    ]));
    let key = "kv:" + me.kv_key;
    if me.kv_key != "" && me.requests.contains_key(key) {
        show(S, key, fetch(me, key, "/api/v1/kv/" + me.kv_key), out);
    }
    out.push(section("Rows the game keeps"));
    let rows = game_rows(me);
    if rows.len() == 0 {
        out.push(note("none: the rows a playing game subscribed to with `register_kv` show here", "text_caption"));
        return;
    }
    let tree = S.kit.tree;
    let (specs, _, _) = tree(S, "gamend:rows", rows, #{});
    for spec in specs {
        out.push(spec);
    }
}

/// Every row `client.rn` caches, from whichever nodes hold them.
fn game_rows(me) {
    me.rows_in -= 1;
    if me.rows_in > 0 {
        return me.rows;
    }
    me.rows_in = ROWS_EVERY;
    let found = #{};
    let root = scene::root();
    let nodes = if root is Tuple { [] } else { [root] };
    if !(root is Tuple) {
        for node in root.descendants() {
            nodes.push(node);
        }
    }
    for node in nodes {
        let raw = node.meta[ROWS_KEY];
        if raw is String && raw != "" {
            let (ok, rows) = script::attempt(|| json::parse(raw));
            if ok && rows is Object {
                for (key, value) in rows {
                    found[key] = value;
                }
            }
        }
    }
    me.rows = found;
    found
}

/// Ask again for what a newer message on its topic changed: a member joining,
/// leaving or going offline arrives as one.
fn follow(me, ids) {
    let newest = newest_messages();
    for id in ids {
        refresh_on(me, newest, "lobby:" + id, "lobby:" + id);
    }
    for (topic, _) in newest {
        if topic.starts_with("party:") {
            refresh_on(me, newest, topic, "party");
        }
    }
}

/// The newest message's `seq` on each topic.
fn newest_messages() {
    let out = #{};
    for row in gamend::activity() {
        if row["kind"] != "message" {
            continue;
        }
        let parts = row["what"].split(' ').collect::<Vec>();
        let topic = parts[0];
        if !out.contains_key(topic) {
            out[topic] = row["seq"];
        }
    }
    out
}

fn refresh_on(me, newest, topic, key) {
    let seq = newest.get(topic).unwrap_or(0);
    if seq > me.seen.get(topic).unwrap_or(0) {
        me.seen[topic] = seq;
        drop_key(me, key);
    }
}

fn activity(S, me, out) {
    let chips = [];
    for entry in ["all", "calls", "messages", "errors"] {
        // Bound afresh: a closure made in a loop captures the binding.
        let name = entry;
        chips.push(chip(name, me.filter == name, "", || { me.filter = name; }));
    }
    chips.push(chip("Clear", false, "", || { gamend::clear_activity(); }));
    out.push(verbs(chips));
    let rows = gamend::activity();
    if rows.len() == 0 {
        let empty = S.kit.empty;
        out.push(empty("no calls yet"));
    }
    let n = 0;
    for row in rows {
        if kept(me.filter, row) {
            activity_row(S, me, row, n, out);
        }
        n += 1;
    }
}

fn kept(filter, row) {
    if filter == "calls" {
        return row["kind"] != "message";
    }
    if filter == "messages" {
        return row["kind"] == "message";
    }
    if filter == "errors" {
        return failed(row);
    }
    true
}

/// A call that came back refused or not at all: anything but a 1xx-3xx
/// status, a socket reply of "ok", or one still waiting.
fn failed(row) {
    let status = format!("{}", row["status"]);
    if row["kind"] == "message" || status == "waiting" || status == "ok" || status == "open" {
        return false;
    }
    !(status.starts_with("1") || status.starts_with("2") || status.starts_with("3"))
}

fn activity_row(S, me, row, n, out) {
    let key = format!("{}:{}:{}", row["kind"], row["request"], n);
    let open = me.open.get(key).unwrap_or(false);
    let ms = row["ms"];
    let took = if ms is f64 { format!("{} ms", ms as i64) } else { "" };
    let mark = if open { "▾" } else { "▸" };
    let role = if failed(row) {
        "note_danger"
    } else if row["kind"] == "message" {
        "text_code_quiet"
    } else {
        "text_caption"
    };
    out.push(verbs([
        chip(format!("{} {}", mark, row["kind"]), false, "", || { me.open[key] = !open; }),
        #{
            kind: "label", role: role, grow: 1, truncate: true,
            text: format!("{}  {}  {}", row["what"], row["status"], took),
        },
    ]));
    if !open {
        return;
    }
    let tree = S.kit.tree;
    let (specs, _, _) = tree(S, "gamend:" + key, #{ args: row["args"], reply: row["reply"] }, #{});
    for spec in specs {
        out.push(spec);
    }
}

fn logs(S, out) {
    let section = S.kit.section;
    let field = S.kit.field;
    out.push(section("This run"));
    let path = log::file();
    if path is String {
        let short = S.kit.short_path;
        out.push(field(S, "log file", short(path), #{ copy: true, copy_text: path }));
    } else {
        out.push(field(S, "log file", "none: [log] file is off", #{}));
    }
    out.push(section("Shipping to Gamend"));
    let report = sink_report();
    if !(report is Object) {
        out.push(note("not shipping: put addons/gamend/log_sink.rn on a node that lives as long as the game", "text_caption"));
        return;
    }
    for name in ["shipping", "floor", "run", "pending", "last flush", "accepted", "dropped"] {
        out.push(field(S, name, report.get(name).unwrap_or(""), #{}));
    }
    out.push(verbs([chip("Flush now", false, "", || {
        let root = scene::root();
        root.meta[FLUSH_KEY] = "yes";
    })]));
}

/// What the played game's `log_sink.rn` last reported, or nil.
fn sink_report() {
    let root = scene::root();
    let raw = if root is Tuple { () } else { root.meta[LOGS_KEY] };
    if !(raw is String) || raw == "" {
        return ();
    }
    let (ok, report) = script::attempt(|| json::parse(raw));
    if ok && report is Object { report } else { () }
}

fn feature_tab(S, me, name, out) {
    let section = S.kit.section;
    let feature = #{ name: name, id: "", views: [] };
    for found in features() {
        if found.name == name {
            feature = found;
        }
    }
    if !(gamend::session() is Object) {
        out.push(note("not signed in: most of these are the player's own, so sign in on the User tab", "text_caption"));
    }
    let row = [];
    if feature.id != "" {
        row.push(#{
            kind: "text_field", role: "input_form", width: 220, placeholder: feature.id,
            text: me.ids.get(name).unwrap_or(""),
            on: |typed| { me.ids[name] = typed; },
        });
    }
    row.push(refresh_button(me, name + "/"));
    out.push(verbs(row));
    let id = me.ids.get(name).unwrap_or("");
    for view in feature.views {
        let label = view[0];
        let path = view[1];
        out.push(section(format!("{} · GET {}", label, path)));
        if path.contains("{id}") && id == "" {
            out.push(note(format!("needs a {}", feature.id), "text_caption"));
            continue;
        }
        let key = format!("{}/{}/{}", name, label, id);
        show(S, key, fetch(me, key, path.replace("{id}", id)), out);
    }
}

fn refresh_button(me, prefix) {
    chip("Refresh", false, "", || { forget(me, prefix); })
}

/// A GET the dock made, by key: sent once, answered on a later frame, and
/// kept here, since the engine keeps only the newest replies.
fn fetch(me, key, path) {
    let held = me.replies.get(key).unwrap_or(());
    if !(held is Tuple) {
        return held;
    }
    if !me.requests.contains_key(key) {
        let (ok, id) = script::attempt(|| gamend::rest((), "GET", path));
        if !ok {
            let refused = #{ kind: "error", error: format!("{}", id) };
            me.replies[key] = refused;
            return refused;
        }
        me.requests[key] = id;
    }
    let reply = gamend::reply(me.requests[key]);
    if !(reply is Tuple) {
        me.replies[key] = reply;
    }
    reply
}

/// Drop one fetched key, so it is asked for again.
fn drop_key(me, key) {
    me.requests.remove(key);
    me.replies.remove(key);
}

/// Drop what the dock fetched under a key prefix, so it asks again.
fn forget(me, prefix) {
    for table in [me.requests, me.replies] {
        let keys = [];
        for (key, _) in table.iter() {
            if key.starts_with(prefix) {
                keys.push(key);
            }
        }
        for key in keys {
            table.remove(key);
        }
    }
}

/// A reply drawn: a structure when it came back, a line when it did not.
fn show(S, key, reply, out) {
    if reply is Tuple {
        out.push(note("loading…", "text_caption"));
        return;
    }
    if reply["kind"] == "error" {
        out.push(note(reply["error"], "note_danger"));
        return;
    }
    let status = reply.get("status").unwrap_or(0);
    let body = reply.get("body").unwrap_or(());
    if status >= 400 {
        out.push(note(format!("{}: {}", status, short(body)), "note_danger"));
        return;
    }
    let shown = if body is Object && body.contains_key("data") { body["data"] } else { body };
    if shown is Tuple {
        out.push(note(format!("{}: empty", status), "text_caption"));
        return;
    }
    let tree = S.kit.tree;
    let (specs, _, _) = tree(S, "gamend:" + key, shown, #{});
    for spec in specs {
        out.push(spec);
    }
}

/// A reply in a few words, for a single row.
fn brief(reply) {
    if reply is Tuple {
        return "…";
    }
    let kind = reply["kind"];
    if kind == "error" {
        return reply["error"];
    }
    if kind == "login" {
        return format!("signed in as {}", reply["username"]);
    }
    format!("{}: {}", reply.get("status").unwrap_or(0), short(reply.get("body").unwrap_or(())))
}

fn short(value) {
    let (ok, text) = script::attempt(|| json::encode(value));
    let text = if ok { text } else { "…" };
    let out = "";
    let n = 0;
    for c in text.chars() {
        if n == 90 {
            return out + "…";
        }
        out.push(c);
        n += 1;
    }
    out
}

/// When the token stops working, read from its own `exp` claim.
fn expires(at) {
    if !(at is i64) {
        return "unknown";
    }
    let now = engine::unix_time();
    let whole = if now is f64 { now as i64 } else { now };
    let left = at - whole;
    if left <= 0 {
        return "expired: the next call refreshes it";
    }
    if left >= 172800 {
        return format!("in {} days", left / 86400);
    }
    if left >= 7200 {
        return format!("in {} h {} min", left / 3600, (left % 3600) / 60);
    }
    format!("in {} min {} s", left / 60, left % 60)
}

fn saved_session() {
    let (ok, saved) = script::attempt(|| save::read(SESSION_SLOT));
    if ok && saved is Object { saved } else { () }
}

/// The session as `auth.rn` keeps it, minus what a save cannot hold.
fn keep_session(session) {
    let kept = #{};
    for (key, value) in session {
        if !(value is Tuple) {
            kept[key] = value;
        }
    }
    save::write(SESSION_SLOT, kept);
}

fn addon_version(S) {
    let text = fs::read(S.game_root + "/addons/gamend/version.rn");
    if !(text is String) {
        return "unknown";
    }
    let parts = text.split("\"").collect::<Vec>();
    if parts.len() >= 2 { parts[1] } else { "unknown" }
}

fn host_of(url) {
    url.replace("https://", "").replace("http://", "")
}

fn listed(items) {
    let out = "";
    for item in items {
        if out != "" {
            out += ", ";
        }
        out += item;
    }
    if out == "" { "no topics" } else { out }
}
