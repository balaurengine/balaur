// The session every call carries, a sign-in through an OAuth provider, and a
// session kept in a `save::` slot for the next run. A device id or an email
// signs in through `client::login_device` and `client::login_email`.

use addons::save::save;
use core;
use authentication;

const COMPLETED: str = "completed";
const PENDING: str = "pending";
const EXPIRES_IN: str = "expires_in";
const EXPIRES_AT: str = "expires_at";

/// A signed-in session: who, the token pair, and when the access token
/// stops working, in seconds since 1970; nil when it is not known.
pub struct Session {
    pub user_id: str,
    pub username: str,
    pub display_name: str,
    pub access_token: str,
    pub refresh_token: str,
    pub expires_in: int,
    pub expires_at: int?,
}

/// The session every call carries, or nil when nobody is signed in.
pub fn session() -> Session? {
    let held = core::held();
    if held == nil {
        return nil;
    }
    let open: Session = held;
    open
}

/// Sign in from a session a previous run kept, as `session` answers it,
/// without asking the server; nil signs out here. False when the map carries
/// no `access_token`. A session with no `expires_at` is renewed before the
/// socket opens with it.
pub fn restore(session: any) -> bool {
    core::hold(session)
}

/// The save slot the session is kept in.
pub const SLOT: str = "gamend";

/// How long to wait for the player to finish at the provider, in seconds,
/// and how long between two questions to the server whether they have.
pub const SIGN_IN_TIMEOUT: float = 300.0;
pub const ASK_EVERY: float = 1.0;

/// The providers this server offers, as `list_auth_providers` reports them.
pub async fn providers() -> any {
    let reply = await authentication::list_auth_providers();
    if !core::ok(reply) {
        log::warn(core::error_of(reply));
        return {};
    }
    data_of(core::body(reply))
}

/// Sign in with a provider: open its page, then wait for the server to say
/// the session resolved. Signs in with the tokens it carries, keeps them for
/// the next run, and answers them; nil when the player gave up, the provider
/// refused, or the wait ran out. Always a sign-in, even for a player signed
/// in already: `link` adds a provider to their account instead.
pub async fn sign_in(provider: str) -> any {
    let status = await provider_page(provider, false);
    if status.kind() != types::KIND_MAP {
        return nil;
    }
    // The tokens ride under `session`, once; signing in from them is what
    // `restore` does for a kept session, so a fresh one goes the same way.
    let session = status["session"];
    if session.kind() != types::KIND_MAP {
        log::warn("gamend: {provider} sign-in completed without a session");
        return nil;
    }
    fresh(session);
    restore(session);
    keep(session);
    session
}

/// Link a provider to the signed-in account: open its page, then wait for
/// the server to say the link resolved. True once linked; the user channel's
/// `user_updated` carries the new `linked_providers`.
pub async fn link(provider: str) -> bool {
    let status = await provider_page(provider, true);
    status.kind() == types::KIND_MAP
}

/// Start a sign-in, or a link with `linking`, open the page it answers, and
/// ask until the player is done there. The completed status, or nil.
async fn provider_page(provider: str, linking: bool) -> any {
    let started: any = nil;
    if linking {
        started = await authentication::link_provider_request(provider);
    } else {
        started = await authentication::oauth_request(provider);
    }
    if !core::ok(started) {
        log::warn(core::error_of(started));
        return nil;
    }
    let opened = data_of(core::body(started));
    if opened.kind() != types::KIND_MAP {
        return nil;
    }
    let session = opened["session_id"].text();
    engine::open_url(opened["authorization_url"].text());
    let waited = 0.0;
    while waited < SIGN_IN_TIMEOUT {
        await task::seconds(ASK_EVERY);
        waited += ASK_EVERY;
        let reply: any = nil;
        if linking {
            reply = await authentication::link_session_status(session);
        } else {
            reply = await authentication::oauth_session_status(session);
        }
        if !core::ok(reply) {
            continue;
        }
        let now = data_of(core::body(reply));
        if now.kind() != types::KIND_MAP {
            continue;
        }
        let state = now[core::STATUS].text();
        if state == COMPLETED {
            return now;
        }
        if state != PENDING {
            log::warn("gamend: {provider} {now["error"].text()}: {now[core::MESSAGE].text()}");
            return nil;
        }
    }
    log::warn("gamend: {provider} timed out");
    nil
}

/// A session the server just made expires `expires_in` seconds from now.
fn fresh(session: any) {
    if session[EXPIRES_IN].kind() == types::KIND_INT {
        session[EXPIRES_AT] = (engine::unix_time() as int) + session[EXPIRES_IN].as_int();
    }
}

/// What `{"data": ...}` carries, or nil for any other body.
fn data_of(body: any) -> any {
    if body.has(core::DATA) { body[core::DATA] } else { nil }
}

/// Keep a session for the next run. Not `save`: a function of that name
/// would read as the save addon's `save::` module.
pub fn keep(session: any) {
    save::write(SLOT, session);
}

/// The session the last run kept, or nil.
pub fn saved() -> any {
    let kept = save::read(SLOT);
    if kept.kind() == types::KIND_MAP { kept } else { nil }
}

/// Sign out here: the saved session is dropped. The server's own logout is
/// `authentication::logout`, which a caller makes first when it is online.
pub fn forget() {
    save::remove(SLOT);
}

/// Whether this run has a session to restore.
pub fn restorable() -> bool {
    saved() != nil
}

/// Whether a session is open, which is what a screen asks before it draws
/// anything of the player's.
pub fn signed_in() -> bool {
    core::held() != nil
}

/// The signed-in user's id, or an empty string.
pub fn user_id() -> str {
    core::held()[core::USER_ID].as_str()
}
