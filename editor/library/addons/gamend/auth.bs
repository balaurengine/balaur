// Signing in, and staying signed in. `gamend::login` knows a device id and
// an email; every provider is an OAuth session the player finishes in a
// browser and this asks after until it resolves, then keeps in a `save::`
// slot.

use core;
use authentication;

/// The save slot the session is kept in.
pub const SLOT: str = "gamend";

/// How long to wait for the player to finish at the provider, in seconds,
/// and how long between two questions to the server whether they have.
pub const SIGN_IN_TIMEOUT: float = 300.0;
pub const ASK_EVERY: float = 1.0;

/// The providers this server offers, as `list_auth_providers` reports them.
pub async fn providers(node: Node) -> any {
    let reply = await task::wait(authentication::list_auth_providers(node).as_int());
    if !core::ok(reply) {
        log::warn(core::error_of(reply));
        return map();
    }
    data_of(core::body(reply))
}

/// Sign in with a provider: open its page, then wait for the server to say
/// the session resolved. Signs in with the tokens it carries, keeps them for
/// the next run, and answers them; nil when the player gave up, the provider
/// refused, or the wait ran out. Always a sign-in, even for a player signed
/// in already: `link` adds a provider to their account instead.
pub async fn sign_in(node: Node, provider: str) -> any {
    let status = await provider_page(node, provider, sign_in_start, sign_in_status);
    if status.kind() != "map" {
        return nil();
    }
    // The tokens ride under `session`, once; signing in from them is what
    // `restore` does for a kept session, so a fresh one goes the same way.
    let session = status.get("session");
    if session.kind() != "map" {
        log::warn("gamend: {provider} sign-in completed without a session");
        return nil();
    }
    gamend::restore(session);
    keep(session);
    session
}

fn sign_in_start(node: Node, provider: str) -> any {
    authentication::oauth_request(node, provider)
}

fn sign_in_status(node: Node, session: str) -> any {
    authentication::oauth_session_status(node, session)
}

/// Link a provider to the signed-in account: open its page, then wait for
/// the server to say the link resolved. True once linked; the user channel's
/// `user_updated` carries the new `linked_providers`.
pub async fn link(node: Node, provider: str) -> bool {
    let status = await provider_page(node, provider, link_start, link_status);
    status.kind() == "map"
}

fn link_start(node: Node, provider: str) -> any {
    authentication::link_provider_request(node, provider)
}

fn link_status(node: Node, session: str) -> any {
    authentication::link_session_status(node, session)
}

/// Start with `start`, open the page it answers, and ask with `status`
/// until the player is done there. The completed status, or nil.
async fn provider_page(node: Node, provider: str, start: fn(Node, str) -> any, status: fn(Node, str) -> any) -> any {
    let started = await task::wait(start(node, provider).as_int());
    if !core::ok(started) {
        log::warn(core::error_of(started));
        return nil();
    }
    let opened = data_of(core::body(started));
    if opened.kind() != "map" {
        return nil();
    }
    let session = opened.get("session_id").text();
    engine::open_url(opened.get("authorization_url").text());
    let waited = 0.0;
    while waited < SIGN_IN_TIMEOUT {
        await task::seconds(ASK_EVERY);
        waited += ASK_EVERY;
        let reply = await task::wait(status(node, session).as_int());
        if !core::ok(reply) {
            continue;
        }
        let now = data_of(core::body(reply));
        if now.kind() != "map" {
            continue;
        }
        let state = now.get("status").text();
        if state == "completed" {
            return now;
        }
        if state != "pending" {
            log::warn("gamend: {provider} {now.get("error").text()}: {now.get("message").text()}");
            return nil();
        }
    }
    log::warn("gamend: {provider} timed out");
    nil()
}

/// Confirm a `client::register_email` account with the code from its email,
/// set its password, and sign in: the session is restored, kept for the next
/// run, and answered. Nil when the server refused, and the warning says why:
/// `invalid_code` (wrong, spent or expired), `account_locked` (too many wrong
/// codes; the code is void, so ask for a new one with
/// `client::resend_confirmation`), or `validation_failed` (the password).
pub async fn confirm_registration(node: Node, email: str, code: str, password: str) -> any {
    let params = map().with("email", email).with("code", code).with("password", password);
    let reply = await task::wait(authentication::confirm_registration(node, params).as_int());
    if !core::ok(reply) {
        log::warn(core::error_of(reply));
        return nil();
    }
    let session = data_of(core::body(reply));
    if session.kind() != "map" {
        return nil();
    }
    gamend::restore(session);
    keep(session);
    session
}

/// What `{"data": ...}` carries, or nil for any other body.
fn data_of(body: any) -> any {
    if body.has("data") { body.get("data") } else { nil() }
}

/// Keep a session for the next run. Not `save`: a function of that name
/// would read as the engine's `save::` module.
pub fn keep(session: any) {
    save::write(SLOT, session);
}

/// The session the last run kept, or nil.
pub fn saved() -> any {
    for slot in save::slots() {
        if slot == SLOT {
            let kept = save::read(SLOT);
            if kept.kind() == "map" {
                return kept;
            }
        }
    }
    nil()
}

/// Sign out here: the saved session is dropped. The server's own logout is
/// `authentication::logout`, which a caller makes first when it is online.
pub fn forget() {
    save::remove(SLOT);
}

/// Whether this run has a session to restore.
pub fn restorable() -> bool {
    !saved().is_nil()
}

/// Whether a session is open, which is what a screen asks before it draws
/// anything of the player's.
pub fn signed_in() -> bool {
    let held = gamend::session();
    held.is_some() && held.unwrap().access_token != ""
}

/// The signed-in user's id, or an empty string.
pub fn user_id() -> str {
    let held = gamend::session();
    if held.is_some() { held.unwrap().user_id } else { "" }
}
