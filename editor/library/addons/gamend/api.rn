/// `GET /api/v1/quests/stats`
pub fn quests_quest_stats(node) {
    gamend::rest(node, "GET", "/api/v1/quests/stats")
}

/// List a user's completed quests
/// `GET /api/v1/quests/user/{user_id}`
pub fn quests_user_quests(node, user_id, options) {
    let core = script::require(CORE);
    let query = (core.query)(options, ["category", "page", "page_size"]);
    gamend::rest(node, "GET", `/api/v1/quests/user/${user_id}${query}`)
}

/// Call off the ready check in the caller's lobby (host only)
/// `DELETE /api/v1/lobbies/ready_check`
pub fn ready_checks_cancel_lobby(node) {
    gamend::rest(node, "DELETE", "/api/v1/lobbies/ready_check")
}

/// Call off the ready check in the caller's party (leader only)
/// `DELETE /api/v1/parties/ready_check`
pub fn ready_checks_cancel_party(node) {
    gamend::rest(node, "DELETE", "/api/v1/parties/ready_check")
}

/// Get the caller's open ready checks
/// `GET /api/v1/me/ready_check`
pub fn ready_checks_get_mine(node) {
    gamend::rest(node, "GET", "/api/v1/me/ready_check")
}

/// Open (or reset) the ready board in the caller's lobby (host only)
/// `POST /api/v1/lobbies/ready_check`
pub fn ready_checks_open_lobby(node, params) {
    gamend::rest(node, "POST", "/api/v1/lobbies/ready_check", params)
}

/// Open (or reset) the ready board in the caller's party (leader only)
/// `POST /api/v1/parties/ready_check`
pub fn ready_checks_open_party(node, params) {
    gamend::rest(node, "POST", "/api/v1/parties/ready_check", params)
}

/// Answer one of the caller's open ready checks
/// `POST /api/v1/me/ready_check`
pub fn ready_checks_respond_ready_check(node, params) {
    let core = script::require(CORE);
    if !(core.given)(params, "ready") {
        return (core.missing)("ready_checks_respond_ready_check", "ready");
    }
    gamend::rest(node, "POST", "/api/v1/me/ready_check", params)
}

