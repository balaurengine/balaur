    gamend::rest(node, "POST", `/api/v1/me/quests/${key}/claim`)
}

/// List quests
/// `GET /api/v1/quests`
pub fn quests_list_quests(node, options) {
    let core = script::require(CORE);
    let query = (core.query)(options, ["category", "page", "page_size"]);
    gamend::rest(node, "GET", `/api/v1/quests${query}`)
}

/// List my quests
/// `GET /api/v1/me/quests`
pub fn quests_my_quests(node, options) {
    let core = script::require(CORE);
    let query = (core.query)(options, ["category", "group", "page", "page_size"]);
    gamend::rest(node, "GET", `/api/v1/me/quests${query}`)
}

