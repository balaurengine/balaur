/// The channel a topic names: `lobby:12` is `lobby`, `lobbies` is itself.
pub fn channel_of(topic) {
    let parts = topic.split(":").collect::<Vec>();
    parts[0]
}

/// A socket message as this client names it. The payload is carried
/// through under `kind`; an event no row names comes back as `message`.
pub fn decode(topic, event, payload) {
    let channel = channel_of(topic);
    let named = "message";
    for row in table() {
        if row[0] == channel && row[1] == event {
            named = row[2];
            break;
        }
    }
    let out = #{};
    if payload is Object {
        for key in payload.keys() {
            out[key] = payload[key];
        }
    }
    out["kind"] = named;
    out["topic"] = topic;
    out["event"] = event;
    out
}
