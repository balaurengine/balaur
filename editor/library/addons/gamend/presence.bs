// Who else is here: the users this client has seen, kept so a name or an
// avatar is drawn without asking the server again. One roster for the run,
// in the script store, so every script reads the same one.

const ROSTER_KEY: str = "gamend:users";
const ID: str = "id";

/// Remember a user payload, as a `user_updated` or a member event carries it.
pub fn cache(user: any) {
    if user.kind() != types::KIND_MAP || !user.has(ID) {
        return;
    }
    let roster = all();
    roster[user[ID].text()] = user;
    script::store(ROSTER_KEY, roster);
}

/// The user this client last saw under that id, or nil.
pub fn user(id: str) -> any {
    all()[id]
}

/// Everyone cached, by id.
pub fn all() -> any {
    let kept = script::stored(ROSTER_KEY);
    if kept.kind() == types::KIND_MAP { kept } else { {} }
}

/// Forget everyone: the roster after a sign-out.
pub fn forget() {
    script::store(ROSTER_KEY, {});
}
