// The session, the socket and the server's hooks, over the engine's
// `gamend::` calls. The socket id is the caller's; the rows, the topics and
// the keys are this module's own, so every script in a game sees one cache.

/// Where the hook calls go. Godot's SDK called this `plugin`.
const PLUGIN_KEY = "gamend:plugin";
/// The rows the server sent, by key.
const ROWS_KEY = "gamend:rows";
const KEYS_KEY = "gamend:keys";

/// Point the plugin at a server, and name the server plugin `rpc_call`
/// reaches; nil for either takes `[gamend]`'s. Every other call errors until
/// this one runs. Answers the server's url.
pub fn configure(url, plugin) {
    let at = gamend::configure(url);
    let root = scene::root();
    if !(root is Tuple) && plugin is String {
        root.meta[PLUGIN_KEY] = plugin;
    }
    return at;
}

/// The server plugin this game's hooks live in.
pub fn plugin() {
    let root = scene::root();
    let name = if root is Tuple { () } else { root.meta[PLUGIN_KEY] };
    if name is String && name != "" {
        return name;
    }
    return gamend::target()["plugin"];
}

/// Open a session from a device id. The reply reaches `node`'s handler as
/// `kind = "login"`, and the returned id can be awaited instead.
pub fn login_device(node, device_id) {
    return gamend::login(node, #{ "device_id": device_id });
}

/// Open a session from an email and a password.
pub fn login_email(node, email, password) {
    return gamend::login(node, #{ "email": email, "password": password });
}

/// Make an account from an email and a password and open its session. The
/// reply reaches `node`'s handler as `kind = "login"`; `username` may be nil,
/// and the server picks one.
pub fn register_email(node, email, password, username) {
    let account = #{ "email": email, "password": password };
    if username is String {
        account["username"] = username;
    }
    return gamend::register(node, account);
}

/// Open the realtime socket. The worker joins this session's own `user:<id>`
/// topic before reporting `open`, so hooks work as soon as it does. A dropped
/// connection comes back on its own and joins its topics again: `route`
/// hands the node `on_socket_reconnecting`, then `on_socket_reopened`.
pub fn connect(node) {
    return gamend::connect(node);
}

/// Hand an event to the node's own handler for it. A server message goes to
/// `on_<kind>`, named as `gamend::events::decode` names it
/// (`on_lobby_member_joined`); the socket's own to `on_socket_<kind>`
/// (`open`, `reconnecting`, `reopened`, `closed`, `error`); a call's result
/// to `on_<kind>`. Call it from `on_gamend_event`; answers whether a handler
/// took the event.
pub fn route(node, e) {
    let kind = e["kind"];
    if e.contains_key("socket") {
        note_socket(kind);
    }
    let event = e;
    let method = if e.contains_key("socket") { `on_socket_${kind}` } else { `on_${kind}` };
    if kind == "message" {
        event = gamend::events::decode(e["topic"], e["event"], e["payload"]);
        method = `on_${event["kind"]}`;
    }
    if !node.has_method(method) {
        return false;
    }
    node.call(method, event);
    return true;
}

pub fn close(socket) {
    forget_topics();
    return gamend::close(socket);
}

/// Where the topics this socket joined are kept, so `joined` can answer and
/// a caller can leave them all at once.
const TOPICS = "gamend:topics";

/// Join a topic and remember it: `party:<id>`, `group:<id>`, `lobbies`. A
/// dropped connection rejoins what it held, so this is the whole record a
/// game needs of what it is listening to.
pub fn join(socket, topic) {
    let held = joined();
    if !held.iter().any(|name| name == topic) {
        held.push(topic);
        script::store(TOPICS, held);
    }
    return gamend::join(socket, topic);
}

/// Leave a topic and drop it from the record.
pub fn leave(socket, topic) {
    script::store(TOPICS, joined().iter().filter(|name| name != topic).collect::<Vec>());
    return gamend::leave(socket, topic);
}

/// Every topic this session joined, in the order it joined them.
pub fn joined() {
    let held = script::stored(TOPICS);
    if held is Vec {
        return held;
    }
    return [];
}

fn forget_topics() {
    script::store(TOPICS, []);
}

/// Call a server hook and await the reply. The result is
/// `#{ ok, data, error }` — the caller decides what to say about a failure,
/// which is what the Godot client did.
pub async fn rpc_call(socket, name, args) {
    if !(socket is i64) {
        return #{ "ok": false, "data": (), "error": `gamend: ${name} needs a connection` };
    }
    let reply = task::wait(gamend::call_hook(socket, plugin(), name, args)).await;
    return unpack_hook(name, reply);
}

/// Fire a hook and do not wait. The push leaves in the frame it is made,
/// which is the only transport that escapes a process about to stop
/// ticking; the caller reconciles from a later payload.
pub fn rpc_send(socket, name, args) {
    if !(socket is i64) {
        return false;
    }
    return gamend::push(socket, "user", "hook", #{
        "plugin": plugin(),
        "fn": name,
        "args": args,
    });
}

/// A hook reply as `#{ ok, data, error }`.
pub fn unpack_hook(name, reply) {
    if reply is Tuple {
        return #{ "ok": false, "data": (), "error": `gamend: ${name} sent no reply` };
    }
    let response = if reply is Object { reply["response"] } else { () };
    if response is Object && response.contains_key("error") {
        let message = format!("{}", response["error"]);
        log::warn(`gamend: hook ${name}: ${message}`);
        return #{ "ok": false, "data": (), "error": message };
    }
    let data = if response is Object { response["data"] } else { () };
    return #{ "ok": true, "data": data, "error": "" };
}

/// Subscribe to a key-value row and keep it. The server pushes `kv_updated`
/// when it changes, which `absorb` files into the cache.
pub fn register_kv(socket, key) {
    if !(socket is i64) {
        return false;
    }
    let held = registered();
    if !held.iter().any(|name| name == key) {
        held.push(key);
        script::store(KEYS_KEY, held);
    }
    return gamend::push(socket, "user", "kv:subscribe", #{ "key": key });
}

pub fn unregister_kv(socket, key) {
    if !(socket is i64) {
        return false;
    }
    script::store(KEYS_KEY, registered().iter().filter(|name| name != key).collect::<Vec>());
    return gamend::push(socket, "user", "kv:unsubscribe", #{ "key": key });
}

/// Every key this session subscribed, in the order it asked for them.
pub fn registered() {
    let held = script::stored(KEYS_KEY);
    if held is Vec {
        return held;
    }
    return [];
}

/// Subscribe to exactly `keys`: what is new is subscribed, what is gone is
/// dropped. A key that depends on the player, such as a locale pair or a
/// lobby, changes by calling this again with the new list.
pub fn refresh_keys(socket, keys) {
    for key in registered() {
        if !keys.iter().any(|want| want == key) {
            unregister_kv(socket, key);
        }
    }
    for key in keys {
        if !registered().iter().any(|held| held == key) {
            register_kv(socket, key);
        }
    }
    return registered();
}

/// File a decoded `kv_updated` or `kv_deleted` into the node's cache. Give
/// it what `gamend::events::decode` returned and it takes the rows it knows.
pub fn absorb(event) {
    if !(event is Object) {
        return false;
    }
    let kind = event["kind"];
    if kind != gamend::events::user::KV_UPDATED && kind != gamend::events::user::KV_DELETED {
        return false;
    }
    let key = format!("{}", event["key"]);
    let rows = read_rows();
    if kind == gamend::events::user::KV_DELETED {
        rows.remove(key);
    } else {
        rows[key] = event["value"];
    }
    write_rows(rows);
    return true;
}

/// The row this client last saw for a key, or nil.
pub fn row(key) {
    let rows = read_rows();
    if rows.contains_key(key) {
        return rows[key];
    }
    return ();
}

pub fn has_row(key) {
    return !(row(key) is Tuple);
}

/// The cached row, or the server's, fetched once and kept. `force` asks the
/// server even when a row is cached. A key the server has no row for caches
/// an empty table, so `has_row` answers without asking again; anything else
/// that went wrong caches nothing and the next call retries.
pub async fn fetch_row(node, key, force) {
    if !force && has_row(key) {
        return row(key);
    }
    let reply = task::wait(gamend::kv::get_kv(node, key, ())).await;
    if !gamend::core::ok(reply) {
        let status = if reply is Object { reply["status"] } else { () };
        if status == 404 {
            store_row(key, #{});
            return #{};
        }
        log::warn(gamend::core::error_of(reply));
        return ();
    }
    let value = gamend::core::body(reply);
    store_row(key, value);
    return value;
}

/// The signed-in player's profile, fetched fresh: `#{ ok, data, error }`.
pub async fn fetch_current_user(node) {
    return gamend::core::unpack(task::wait(gamend::users::get_current_user(node)).await);
}

/// One lobby, fetched fresh, its members inside it as the server sends them.
pub async fn fetch_lobby(node, lobby_id) {
    return gamend::core::unpack(task::wait(gamend::lobbies::get_lobby(node, lobby_id)).await);
}

/// Where a write in flight is kept, so an identical one is not sent twice.
const WRITES_KEY = "gamend:writes";

/// Call a hook to write a key, unless the same value for that key is already
/// on its way. Answers `#{ skipped, result }`, where `result` is what
/// `rpc_call` answered and nil for a write that was skipped.
pub async fn write_deduped(socket, key, value, hook, args) {
    let sent = json::encode(value);
    let pending = pending_writes();
    if pending.contains_key(key) && pending[key] == sent {
        return #{ "skipped": true, "result": () };
    }
    pending[key] = sent;
    script::store(WRITES_KEY, pending);
    let result = rpc_call(socket, hook, args).await;
    let after = pending_writes();
    if after.contains_key(key) && after[key] == sent {
        after.remove(key);
        script::store(WRITES_KEY, after);
    }
    return #{ "skipped": false, "result": result };
}

fn pending_writes() {
    let held = script::stored(WRITES_KEY);
    if held is Object {
        return held;
    }
    return #{};
}

/// Listen to one lobby's channel, or to none: `lobby:<id>` is joined and any
/// other lobby topic this session held is left.
pub fn sync_lobby_channel(socket, lobby_id) {
    let topic = if lobby_id == "" { "" } else { `lobby:${lobby_id}` };
    for held in joined() {
        if held.starts_with("lobby:") && held != topic {
            leave(socket, held);
        }
    }
    if topic != "" && !joined().iter().any(|held| held == topic) {
        join(socket, topic);
    }
    return topic;
}

/// File a value under a key as if the server had sent it: what a caller with
/// its own fetch, a hook rather than `kv`, keeps its answer with.
pub fn keep_row(key, value) {
    return store_row(key, value);
}

/// Forget one row, or all of them: what a sign-out does.
pub fn clear_row(key) {
    let rows = read_rows();
    rows.remove(key);
    write_rows(rows);
    return ();
}

pub fn clear_rows() {
    write_rows(#{});
    return ();
}

/// What this client thinks of its connection.
const NETWORK_KEY = "gamend:network";

/// `"open"`, `"reconnecting"` or `"failed"`. The socket's own events move the
/// first two as `route` sees them; `fail_network` is what moves it to the
/// third.
pub fn network_state() {
    let held = script::stored(NETWORK_KEY);
    if held is String {
        return held;
    }
    return "open";
}

/// Say the connection is gone: what a game calls when a request it needed
/// failed and it wants its offline screen. `retry_network` is the way back.
pub fn fail_network() {
    script::store(NETWORK_KEY, "failed");
    return ();
}

/// Cut the socket so the worker opens it again, and report reconnecting
/// until it does. False when the socket was already gone, which is when a
/// caller opens a new one with `connect`.
pub fn retry_network(socket) {
    script::store(NETWORK_KEY, "reconnecting");
    return gamend::interrupt(socket);
}

fn note_socket(kind) {
    if kind == "reconnecting" {
        script::store(NETWORK_KEY, "reconnecting");
    } else if kind == "open" || kind == "reopened" {
        script::store(NETWORK_KEY, "open");
    } else if kind == "closed" {
        script::store(NETWORK_KEY, "failed");
    }
    return ();
}

fn store_row(key, value) {
    let rows = read_rows();
    rows[key] = value;
    write_rows(rows);
    return ();
}

fn read_rows() {
    let held = script::stored(ROWS_KEY);
    if held is Object {
        return held;
    }
    return #{};
}

fn write_rows(rows) {
    script::store(ROWS_KEY, rows);
    return ();
}
