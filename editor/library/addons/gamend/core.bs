// What every generated call needs: query strings, required fields, reply
// helpers, and the engine's calls, each kept in the activity log.

use activity;

const OK: str = "ok";
const CONNECT: str = "connect";
const HOOK: str = "hook";
const JOIN: str = "join";
const LEAVE: str = "leave";
const LOGIN: str = "login";
const PUSH: str = "push";
const REFUSED: str = "refused";
const REST: str = "rest";
internal const BODY: str = "body";
internal const DATA: str = "data";
internal const EMAIL: str = "email";
internal const ERROR: str = "error";
internal const MESSAGE: str = "message";
internal const STATUS: str = "status";

/// Whether a map carries a key with a value. A key set to nil is absent:
/// the server would refuse it, and refusing here names the field instead.
pub fn given(table: any, key: str) -> bool {
    table.kind() == types::KIND_MAP && table.has(key) && table[key] != nil
}

/// A call this SDK would not send. It logs which field was missing and
/// answers an id whose reply is an `error` naming it, so an await resumes.
pub fn missing(call: str, field: str) -> int {
    let message = "gamend: {call} needs `{field}`";
    log::error(message);
    activity::started(gamend::refuse(message), REFUSED, message, nil)
}

// The engine's calls, each kept in the activity log as it goes out: what the
// generated modules, `client` and the dock send through.

/// `gamend::rest`: a path on the server over HTTP.
pub fn rest(method: str, path: str, body: any) -> int {
    activity::started(gamend::rest(method, path, body), REST, method + " " + path, body)
}

/// `gamend::login`; `who` is what the row shows: "device", or the email.
pub fn login(credentials: gamend::Credentials, who: str) -> int {
    activity::started(gamend::login(credentials), LOGIN, who, nil)
}

/// `gamend::connect`: the realtime socket, its events to `node`.
pub fn connect(node: Node) -> int {
    activity::started(gamend::connect(node), CONNECT, "realtime", nil)
}

pub fn join(socket: int, topic: str) -> int {
    activity::started(gamend::join(socket, topic), JOIN, topic, nil)
}

pub fn leave(socket: int, topic: str) -> int {
    activity::started(gamend::leave(socket, topic), LEAVE, topic, nil)
}

pub fn push(socket: int, topic: str, event: str, payload: any) -> int {
    activity::started(gamend::push(socket, topic, event, payload), PUSH, topic + " " + event, payload)
}

pub fn call_hook(socket: int, plugin: str, name: str, args: any) -> int {
    activity::started(gamend::call_hook(socket, plugin, name, args), HOOK, plugin + "." + name, args)
}

/// `?a=1&b=2` for the keys an operation declares, in the order it declares
/// them, skipping the ones the caller left out. Empty when none are given,
/// so the path stays exactly as the document wrote it.
pub fn query(options: any, allowed: [str]) -> str {
    if options.kind() != types::KIND_MAP {
        return "";
    }
    let out = "";
    for key in allowed {
        if !given(options, key) {
            continue;
        }
        let lead = if out == "" { "?" } else { "&" };
        out = out + lead + key + "=" + escape(options[key].text());
    }
    out
}

/// Percent-encoding for what a query value may hold. The server's keys are
/// ids, page numbers and search terms, so this covers the reserved set
/// rather than every byte above 127. `%` goes first, so it is never doubled.
pub fn escape(text: str) -> str {
    text.replace("%", "%25")
        .replace(" ", "%20")
        .replace("&", "%26")
        .replace("=", "%3D")
        .replace("?", "%3F")
        .replace("#", "%23")
        .replace("+", "%2B")
        .replace("/", "%2F")
}

/// Whether a `rest` completion carried a 2xx status.
pub fn ok(reply: any) -> bool {
    let status = reply[STATUS];
    status.kind() == types::KIND_INT && status.as_int() >= 200 && status.as_int() < 300
}

/// The decoded body of a reply, or nil.
pub fn body(reply: any) -> any {
    reply[BODY]
}

/// What the server said went wrong, for a reply that is not 2xx.
pub fn error_of(reply: any) -> str {
    let payload = body(reply);
    if payload.has(ERROR) {
        return payload[ERROR].text();
    }
    if reply.has(ERROR) {
        return reply[ERROR].text();
    }
    if reply.has(STATUS) {
        return "gamend: HTTP " + reply[STATUS].text();
    }
    "gamend: no reply"
}

/// What a REST call answered, in the shape a hook's reply takes:
/// `ok`, `data`, `error` and `status`. A 2xx carries the body's `data`
/// where the server wrapped it, and the body itself where it did not.
pub fn unpack(reply: any) -> any {
    if reply == nil {
        return { OK: false, DATA: nil, ERROR: "gamend: the call sent no reply" };
    }
    let status = reply[STATUS];
    let payload = reply[BODY];
    if !ok(reply) {
        let message = if payload.has(ERROR) {
            payload[ERROR].text()
        } else if reply.has(ERROR) {
            reply[ERROR].text()
        } else {
            "gamend: the call answered " + status.text()
        };
        return { OK: false, DATA: nil, ERROR: message, STATUS: status };
    }
    let data = if payload.has(DATA) { payload[DATA] } else { payload };
    { OK: true, DATA: data, ERROR: "", STATUS: status }
}
