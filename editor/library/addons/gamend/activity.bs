// What `core`'s calls, the socket and `client::route` saw lately, for the
// Gamend dock: a ring of rows on the client's node.

use service;

/// How many rows are kept, oldest dropped first, and how many of the newest
/// keep their arguments and reply.
pub const KEPT: int = 200;
pub const DETAILED: int = 50;

/// The status of a call no reply has reached yet.
pub const WAITING: str = "waiting";

/// One call or socket message: `seq` counts every row ever kept, so a reader
/// that saw one knows anything above it is new. `ms` is nil while it waits.
pub struct Entry {
    pub seq: int,
    pub kind: str,
    pub what: str,
    pub status: str,
    pub ms: float?,
    pub args: any,
    pub reply: any,
}

/// A payload past this many bytes of JSON is kept as its size alone.
const LARGEST: int = 16384;

const ARGS: str = "args";
const ERROR: str = "error";
const KIND: str = "kind";
const LOGIN: str = "login";
const MS: str = "ms";
const OK: str = "ok";
const REASON: str = "reason";
const REPLY: str = "reply";
const REST: str = "rest";
const SEQ: str = "seq";
const STATUS: str = "status";
const WHAT: str = "what";

/// Keep a call that just went out, waiting for its reply. Answers the row's
/// `seq`, which `finished` takes when the reply comes.
pub fn started(kind: str, what: str, args: any) -> int {
    push({ KIND: kind, WHAT: what, STATUS: WAITING, MS: nil, ARGS: kept(args), REPLY: nil })
}

/// Keep something the connection did on its own, not the answer to a call.
pub fn noted(kind: str, what: str, payload: any) {
    push({ KIND: kind, WHAT: what, STATUS: "", MS: nil, ARGS: nil, REPLY: kept(payload) });
}

/// A reply's status in a word: the HTTP status, a socket reply's, `ok` for a
/// login, or why it failed; and its round trip where the call measured one.
/// A row already dropped from the ring is left alone.
pub fn finished(seq: int, reply: any) {
    let key = "{seq % KEPT}";
    let row = ring()[key];
    if row.kind() != types::KIND_MAP || row[SEQ].as_int() != seq {
        return;
    }
    let kind = reply[KIND].text();
    row[STATUS] = if kind == ERROR {
        if reply.has(ERROR) { reply[ERROR].text() } else { reply[REASON].text() }
    } else if reply.has(STATUS) {
        reply[STATUS].text()
    } else if kind == LOGIN {
        OK
    } else {
        kind
    };
    row[MS] = reply[MS];
    if seq > count() - DETAILED {
        row[REPLY] = kept(if kind == REST { reply["body"] } else { reply });
    }
    keep(key, row);
}

/// Every row, newest first.
pub fn rows() -> [Entry] {
    let out: [Entry] = [];
    let last = count();
    let first = max(service::get().activity_from, last - KEPT);
    let seq = last;
    while seq > first {
        let row = ring()["{seq % KEPT}"];
        if row.kind() == types::KIND_MAP && row[SEQ].as_int() == seq {
            out.push(entry(row));
        }
        seq -= 1;
    }
    out
}

/// Forget the rows kept so far; a reply to one of them is dropped.
pub fn clear() {
    let state = service::get();
    state.activity_from = count();
}

fn push(row: any) -> int {
    let seq = count() + 1;
    row[SEQ] = seq;
    keep("{seq % KEPT}", row);
    let state = service::get();
    state.activity_count = seq;
    let plain = seq - DETAILED;
    let older = ring()["{plain % KEPT}"];
    if plain > 0 && older.kind() == types::KIND_MAP && older[SEQ].as_int() == plain {
        older[ARGS] = nil;
        older[REPLY] = nil;
        keep("{plain % KEPT}", older);
    }
    seq
}

fn entry(row: any) -> Entry {
    let ms: float? = nil;
    if row[MS].kind() == types::KIND_FLOAT {
        ms = row[MS].as_float();
    }
    Entry {
        seq: row[SEQ].as_int(),
        kind: row[KIND].text(),
        what: row[WHAT].text(),
        status: row[STATUS].text(),
        ms: ms,
        args: row[ARGS],
        reply: row[REPLY],
    }
}

/// A payload as the dock shows it, or its size when it is too big to keep.
fn kept(payload: any) -> any {
    if payload == nil {
        return nil;
    }
    let size = json::encode(payload).len();
    if size > LARGEST { "{size} bytes, not kept" } else { payload }
}

fn count() -> int {
    service::get().activity_count
}

/// Every row kept, by its place in the ring.
fn ring() -> any {
    let held = service::get().activity;
    if held.kind() == types::KIND_MAP { held } else { {} }
}

fn keep(place: str, row: any) {
    let held = ring();
    held[place] = row;
    let state = service::get();
    state.activity = held;
}

fn max(a: int, b: int) -> int {
    if a > b { a } else { b }
}
