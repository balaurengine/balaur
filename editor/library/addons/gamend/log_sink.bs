// Ships this run's log to Gamend: put it on a node that lives as long as the
// game. The server comes from `[gamend]`, and its policy decides what goes.

use logs;
use service;

pub class LogSink {
    node: Node,
    sink: logs::Sink,
    report_in: int,
}

impl LogSink {
    pub fn init() {
        self.sink = logs::setup("");
        self.report_in = 0;
    }

    pub fn update(dt: float) {
        logs::pump(self.sink, self.node, dt);
        // The dock reads the report, and asks for a flush, on the client's node.
        let state = service::get();
        if state.flush {
            state.flush = false;
            logs::flush(self.sink, self.node);
        }
        // Twice a second is enough for a person reading the dock.
        self.report_in -= 1;
        if self.report_in <= 0 {
            self.report_in = 30;
            state.logs = logs::report(self.sink);
        }
    }

    /// What `logs` asked comes back: the node's own wait, so it asks from
    /// `update`.
    pub async fn settle_reply(request: int) {
        let reply = await task::wait(request);
        logs::settle(self.sink, reply);
    }
}
