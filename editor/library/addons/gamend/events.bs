/// The channel a topic names: `lobby:12` is `lobby`, `lobbies` is itself.
pub fn channel_of(topic: str) -> str {
    topic.split(":")[0]
}

/// A socket message as this client names it: `kind` (one of the
/// channels' constants, or `message`), `topic`, `event`, and the
/// server's `payload` as it came.
pub fn decode(topic: str, event: str, payload: any) -> any {
    let channel = channel_of(topic);
    let named = "message";
    for row in table() {
        if row[0] == channel && row[1] == event {
            named = row[2];
            break;
        }
    }
    map().with("kind", named).with("topic", topic).with("event", event).with("payload", payload)
}
