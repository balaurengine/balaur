// The session, the socket and the server's hooks. Rows, topics and keys live
// in the script store, so every script sees one cache.

use activity;
use auth;
use core;
use events;
use events::user;
use kv;
use users;
use lobbies;

const CLOSED: str = "closed";
const ERROR: str = "error";
const REASON: str = "reason";
const MESSAGE: str = "message";
const OPEN: str = "open";
const RECONNECTING: str = "reconnecting";
const REOPENED: str = "reopened";
const FAILED: str = "failed";
const KEY: str = "key";
const LOGIN: str = "login";
const PASSWORD: str = "password";
const KIND: str = "kind";
const PAYLOAD: str = "payload";
const SOCKET: str = "socket";
const TOPIC: str = "topic";
const EVENT: str = "event";
const USERNAME: str = "username";

/// A hook's reply: what the call answered, or why it did not.
pub struct HookReply {
    pub ok: bool,
    pub data: any,
    pub error: str,
}

/// A `write_deduped`: whether it was skipped as a repeat, and the hook's
/// reply when it was sent.
pub struct Write {
    pub skipped: bool,
    pub reply: HookReply,
}

/// A realtime socket, whether it is open and the topics it joined.
pub struct SocketRow {
    pub socket: int,
    pub open: bool,
    pub topics: [str],
    pub reason: str?,
}

/// The server, who is signed in and each socket.
pub struct Connection {
    pub url: str,
    pub user_id: str?,
    pub username: str?,
    pub sockets: [SocketRow],
}

/// Where the hook calls go. Godot's SDK called this `plugin`.
const PLUGIN_KEY: str = "gamend:plugin";
/// The rows the server sent, by key.
const ROWS_KEY: str = "gamend:rows";
/// The keys this session subscribed, and the topics it joined.
const KEYS_KEY: str = "gamend:keys";
const TOPICS_KEY: str = "gamend:topics";
/// Writes in flight, by key, so an identical one is not sent twice.
const WRITES_KEY: str = "gamend:writes";
/// What this client thinks of its connection.
const NETWORK_KEY: str = "gamend:network";

/// Point every call at another server, and name the server plugin `call`
/// reaches; empty for either takes `[gamend]`'s, which is what a game that
/// never calls this talks to. A different server signs out here. Answers the
/// server's url.
pub fn configure(url: str, plugin: str) -> str {
    if plugin != "" {
        engine::store(PLUGIN_KEY, plugin);
    }
    core::point(url)
}

/// The server this run talks to until a script names another, and the two
/// the project names: `{ name, url, production, local, plugin }` from
/// `[gamend]`, `name` being `production` or `local`.
pub fn server() -> core::Server {
    core::target()
}

/// The configured server, who is signed in, and each socket.
pub fn connection() -> Connection {
    let held = core::held();
    let rows: [SocketRow] = [];
    let all = core::sockets();
    for key in all.keys() {
        let row: SocketRow = all[key].as_node().call("row");
        rows.push(row);
    }
    let user_id: str? = nil;
    let username: str? = nil;
    if held != nil {
        user_id = held[core::USER_ID].as_str();
        username = held[USERNAME].as_str();
    }
    Connection { url: core::url(), user_id: user_id, username: username, sockets: rows }
}

/// The server plugin this game's hooks live in.
pub fn plugin() -> str {
    let named = engine::stored(PLUGIN_KEY);
    if named.kind() == types::KIND_STRING && named.as_str() != "" {
        return named.as_str();
    }
    core::target().plugin
}

/// Open a session from a device id, which makes an account the first time
/// the server sees one. Answers `{ kind: "login", user_id, username,
/// display_name, ms }`, or `{ kind: "error", error }`.
pub async fn login_device(device_id: str) -> any {
    let reply = await signed("/api/v1/login/device", { "device_id": device_id }, "device");
    reply
}

/// Open a session from an email and a password, answered as `login_device`.
pub async fn login_email(email: str, password: str) -> any {
    let reply = await signed("/api/v1/login", { core::EMAIL: email, PASSWORD: password }, email);
    reply
}

/// Open a session at a sign-in path: the reply's tokens become the session
/// every later call carries. `who` is what the activity row shows.
async fn signed(path: str, body: any, who: str) -> any {
    while engine::unix_time() <= 0.0 {
        await task::frames(1);
    }
    let row = activity::started(LOGIN, who);
    let asked = core::request(core::POST, path, body, false);
    let sent = engine::unix_time();
    let reply = await task::wait(http::request(asked[core::URL].as_str(), asked[core::OPTIONS]));
    let answer = core::opened(core::received(reply, sent), LOGIN);
    activity::finished(row, answer);
    answer
}

/// Confirm an account `authentication::register` made, with the six-digit
/// code from its email, set its password, and open its session: answered as
/// `login_device` is. A refusal's `error` says why: `invalid_code` (wrong,
/// spent or expired), `account_locked` (too many wrong codes; the code is
/// void, so `authentication::resend_confirmation` sends a new one), or
/// `validation_failed` (the password).
pub async fn confirm_registration(email: str, code: str, password: str) -> any {
    let body: any = { core::EMAIL: email, "code": code, PASSWORD: password };
    let reply = await signed("/api/v1/register/confirm", body, email);
    reply
}

/// Open the realtime socket, on a node of its own under `node`, and answer
/// the id the other socket calls take. `task::wait` on it resumes with the
/// `open` event once the session's own `user:<id>` topic is joined, so hooks
/// work as soon as it does, or with the `error` that kept it shut. What the
/// socket says reaches `node`'s `on_gamend_event`: `open`, `message`,
/// `reconnecting` and `reopened` as a drop comes back on its own, `closed`
/// and `error`. `route` hands each on to its own handler.
pub fn connect(node: Node) -> int {
    core::connect(node)
}

/// Hand an event to the node's own handler for it. A server message goes to
/// `on_<kind>`, named as `events::decode` names it (`on_lobby_member_joined`),
/// with the decoded event; the socket's own to `on_socket_<kind>` (`open`,
/// `reconnecting`, `reopened`, `closed`, `error`). Call it from
/// `on_gamend_event`; answers whether a handler took the event. What it
/// routes is kept in the activity log.
pub fn route(node: Node, e: any) -> bool {
    let kind = e[KIND].text();
    let socket = e.has(SOCKET);
    if socket {
        note_socket(kind);
        keep_socket_event(kind, e);
        if kind == REOPENED {
            subscribe_again(e[SOCKET].as_int());
        }
    }
    let event = e;
    let method = if socket { "on_socket_" + kind } else { "on_" + kind };
    if kind == MESSAGE {
        event = events::decode(e[TOPIC].text(), e[EVENT].text(), e[PAYLOAD]);
        method = "on_" + event[KIND].text();
    }
    if !node.has_method(method) {
        return false;
    }
    node.call(method, event);
    true
}

/// Shut the socket down; false when it was already gone.
pub fn close(socket: int) -> bool {
    engine::store(TOPICS_KEY, {});
    engine::store(KEYS_KEY, {});
    let held = core::socket_node(socket);
    held.is_valid() && held.call("close").as_bool()
}

/// Join a topic and remember it: `party:<id>`, `group:<id>`, `lobbies`. A
/// dropped connection rejoins what it held, so this is the whole record a
/// game needs of what it is listening to. The id answers the server's
/// `reply`.
pub fn join(socket: int, topic: str) -> int {
    let held = joined();
    if !contains(held, topic) {
        held.push(topic);
        engine::store(TOPICS_KEY, held);
    }
    core::join(socket, topic)
}

/// Leave a topic and drop it from the record.
pub fn leave(socket: int, topic: str) -> int {
    engine::store(TOPICS_KEY, without(joined(), topic));
    core::leave(socket, topic)
}

/// Every topic this session joined, in the order it joined them.
pub fn joined() -> [str] {
    stored_list(TOPICS_KEY)
}

/// Call a server hook and await the reply. The caller decides what to say
/// about a failure, which is what the Godot client did.
pub async fn call(socket: int, name: str, args: any) -> HookReply {
    if socket <= 0 {
        return HookReply { ok: false, data: nil, error: "gamend: {name} needs a connection" };
    }
    let reply = await task::wait(core::call_hook(socket, plugin(), name, args));
    unpack_hook(name, reply)
}

/// Fire a hook and do not wait. The push leaves in the frame it is made,
/// which is the only transport that escapes a process about to stop
/// ticking; the caller reconciles from a later payload.
pub fn send(socket: int, name: str, args: any) -> bool {
    if socket <= 0 {
        return false;
    }
    core::call_hook(socket, plugin(), name, args) > 0
}

/// A nil reply, a call the socket could not send, or a server error is
/// `ok: false` with the reason in `error`; a server error is also logged as
/// a warning.
pub fn unpack_hook(name: str, reply: any) -> HookReply {
    if reply == nil {
        return HookReply { ok: false, data: nil, error: "gamend: {name} sent no reply" };
    }
    if reply[KIND].text() == ERROR {
        return HookReply { ok: false, data: nil, error: reply[ERROR].text() };
    }
    let response = reply["response"];
    if response.has(core::ERROR) {
        let message = response[core::ERROR].text();
        log::warn("gamend: hook {name}: {message}");
        return HookReply { ok: false, data: nil, error: message };
    }
    HookReply { ok: true, data: response[core::DATA], error: "" }
}

/// Subscribe to a key-value row and keep it. The server pushes `kv_updated`
/// when it changes, which `absorb` files into the cache. A dropped connection
/// subscribes it again when `route` sees the socket reopen.
pub fn register_kv(socket: int, key: str) -> bool {
    if socket <= 0 {
        return false;
    }
    let held = registered();
    if !contains(held, key) {
        held.push(key);
        engine::store(KEYS_KEY, held);
    }
    core::push(socket, user_topic(), "kv:subscribe", { KEY: key }) > 0
}

pub fn unregister_kv(socket: int, key: str) -> bool {
    if socket <= 0 {
        return false;
    }
    engine::store(KEYS_KEY, without(registered(), key));
    core::push(socket, user_topic(), "kv:unsubscribe", { KEY: key }) > 0
}

/// Every key this session subscribed, in the order it asked for them.
pub fn registered() -> [str] {
    stored_list(KEYS_KEY)
}

/// Subscribe to exactly `keys`: what is new is subscribed, what is gone is
/// dropped. A key that depends on the player, such as a locale pair or a
/// lobby, changes by calling this again with the new list.
pub fn refresh_keys(socket: int, keys: [str]) -> [str] {
    for key in registered() {
        if !contains(keys, key) {
            unregister_kv(socket, key);
        }
    }
    for key in keys {
        if !contains(registered(), key) {
            register_kv(socket, key);
        }
    }
    registered()
}

/// File a decoded `kv_updated` or `kv_deleted` into the cache. Give it what
/// `events::decode` returned and it takes the rows it knows.
pub fn absorb(event: any) -> bool {
    let kind = event[KIND].text();
    if kind != user::KV_UPDATED && kind != user::KV_DELETED {
        return false;
    }
    let payload = event[PAYLOAD];
    let key = payload[KEY].text();
    if kind == user::KV_DELETED {
        clear_row(key);
    } else {
        keep_row(key, payload["value"]);
    }
    true
}

/// The row this client last saw for a key, or nil.
pub fn row(key: str) -> any {
    rows()[key]
}

pub fn has_row(key: str) -> bool {
    rows().has(key)
}

/// The cached row, or the server's, fetched once and kept. `force` asks the
/// server even when a row is cached. A key the server has no row for caches
/// an empty map, so `has_row` answers without asking again; anything else
/// that went wrong caches nothing and the next call retries.
pub async fn fetch_row(key: str, force: bool) -> any {
    if !force && has_row(key) {
        return row(key);
    }
    let reply = await kv::get_kv(key);
    if !core::ok(reply) {
        if reply[core::STATUS].as_int() == 404 {
            keep_row(key, {});
            return {};
        }
        log::warn(core::error_of(reply));
        return nil;
    }
    let value = core::body(reply);
    keep_row(key, value);
    value
}

/// The signed-in player's profile, fetched fresh, as `core::unpack` shapes it.
pub async fn fetch_current_user() -> any {
    let reply = await users::get_current_user();
    core::unpack(reply)
}

/// One lobby, fetched fresh, its members inside it as the server sends them.
pub async fn fetch_lobby(lobby_id: str) -> any {
    let reply = await lobbies::get_lobby(lobby_id);
    core::unpack(reply)
}

/// Call a hook to write a key, unless the same value for that key is already
/// on its way.
pub async fn write_deduped(socket: int, key: str, value: any, hook: str, args: any) -> Write {
    let sent = json::encode(value);
    if writes()[key].text() == sent {
        return Write { skipped: true, reply: HookReply { ok: true, data: nil, error: "" } };
    }
    let held = writes();
    held[key] = sent;
    engine::store(WRITES_KEY, held);
    let reply = await call(socket, hook, args);
    if writes()[key].text() == sent {
        engine::store(WRITES_KEY, dropped(writes(), key));
    }
    Write { skipped: false, reply: reply }
}

/// Listen to one lobby's channel, or to none: `lobby:<id>` is joined and any
/// other lobby topic this session held is left.
pub fn sync_lobby_channel(socket: int, lobby_id: str) -> str {
    let topic = if lobby_id == "" { "" } else { "lobby:" + lobby_id };
    for held in joined() {
        if held.starts_with("lobby:") && held != topic {
            leave(socket, held);
        }
    }
    if topic != "" && !contains(joined(), topic) {
        join(socket, topic);
    }
    topic
}

/// File a value under a key as if the server had sent it: what a caller with
/// its own fetch, a hook rather than `kv`, keeps its answer with.
pub fn keep_row(key: str, value: any) {
    let held = rows();
    held[key] = value;
    engine::store(ROWS_KEY, held);
}

/// Forget one row, or all of them: what a sign-out does.
pub fn clear_row(key: str) {
    engine::store(ROWS_KEY, dropped(rows(), key));
}

pub fn clear_rows() {
    engine::store(ROWS_KEY, {});
}

/// `"open"`, `"reconnecting"` or `"failed"`. The socket's own events move the
/// first two as `route` sees them; `fail_network` is what moves it to the
/// third.
pub fn network_state() -> str {
    let held = engine::stored(NETWORK_KEY);
    if held.kind() == types::KIND_STRING { held.as_str() } else { OPEN }
}

/// Say the connection is gone: what a game calls when a request it needed
/// failed and it wants its offline screen. `retry_network` is the way back.
pub fn fail_network() {
    engine::store(NETWORK_KEY, FAILED);
}

/// Cut the socket as a network failure would, so it opens again and joins
/// its topics, and report reconnecting until it does: a game's way back
/// from `fail_network`, and a test's way to try the reconnect path. False
/// when the socket was already gone, which is when a caller opens a new one
/// with `connect`.
pub fn retry_network(socket: int) -> bool {
    engine::store(NETWORK_KEY, RECONNECTING);
    let held = core::socket_node(socket);
    held.is_valid() && held.call("interrupt").as_bool()
}

/// The session's own channel, which `connect` joins before reporting `open`.
fn user_topic() -> str {
    "user:" + auth::user_id()
}

/// A channel the server brought back holds none of the last one's
/// subscriptions, so every key is asked for again.
fn subscribe_again(socket: int) {
    for key in registered() {
        core::push(socket, user_topic(), "kv:subscribe", { KEY: key });
    }
}

/// What the socket said on its own, for the activity log: a message, a drop
/// and the way back, or its end. Its `open` is the answer to `connect`.
fn keep_socket_event(kind: str, e: any) {
    if kind == MESSAGE {
        activity::noted(kind, e[TOPIC].text() + " " + e[EVENT].text(), e[PAYLOAD]);
    } else if kind == RECONNECTING {
        activity::noted(kind, "try {e["attempt"].as_int()} in {e["wait"].as_float()}s: {e[REASON].text()}");
    } else if kind == REOPENED {
        let lost = e["lost"];
        let what = if lost.len() == 0 { "every topic joined again" } else { "refused again: " + json::encode(lost) };
        activity::noted(kind, what);
    } else if kind == CLOSED || kind == ERROR {
        activity::noted(kind, e[REASON].text());
    }
}

fn note_socket(kind: str) {
    if kind == RECONNECTING {
        engine::store(NETWORK_KEY, RECONNECTING);
    } else if kind == OPEN || kind == REOPENED {
        engine::store(NETWORK_KEY, OPEN);
    } else if kind == CLOSED {
        engine::store(NETWORK_KEY, FAILED);
    }
}

fn rows() -> any {
    let held = engine::stored(ROWS_KEY);
    if held.kind() == types::KIND_MAP { held } else { {} }
}

fn writes() -> any {
    let held = engine::stored(WRITES_KEY);
    if held.kind() == types::KIND_MAP { held } else { {} }
}

/// A list of names the store holds, as names.
fn stored_list(key: str) -> [str] {
    let held = engine::stored(key);
    let out: [str] = [];
    for i in 0..held.len() {
        out.push(held[i].text());
    }
    out
}

fn contains(names: [str], name: str) -> bool {
    for held in names {
        if held == name {
            return true;
        }
    }
    false
}

fn without(names: [str], name: str) -> [str] {
    let out: [str] = [];
    for held in names {
        if held != name {
            out.push(held);
        }
    }
    out
}

/// A map without one key.
fn dropped(table: any, key: str) -> any {
    let out: any = {};
    for name in table.keys() {
        if name != key {
            out[name] = table[name];
        }
    }
    out
}
