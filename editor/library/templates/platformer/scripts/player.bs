// Left, right and jump, over the 2D character controller.

pub class Player {
    node: Node,
    pub speed: float = 6.0,
    pub jump: float = 9.0,
    vy: float,
    on_floor: bool,
}

impl Player {
    pub fn fixed_update(dt: float) {
        let sideways = input::action_value("move");
        // Whether the last move ended on the ground decides between falling
        // and being able to jump.
        if self.on_floor {
            self.vy = if input::action_just_pressed("jump") { self.jump } else { 0.0 };
        } else {
            self.vy -= 24.0 * dt;
        }
        self.on_floor = self.node.character2d.move_by(vec2(sideways * self.speed * dt, self.vy * dt)).on_floor;
    }
}
