// Left, right and jump, over the 2D character controller.

pub fn exports() {
    #{ speed: 6.0, jump: 9.0 }
}

pub fn init(this) {
    this.vy = 0.0;
}

pub fn fixed_update(this, dt) {
    let sideways = input::action_value("move");
    // The controller reports whether the last move ended on the ground, which
    // is what decides between falling and being able to jump.
    if physics2d::is_grounded(this.node) {
        this.vy = if input::action_just_pressed("jump") { this.jump } else { 0.0 };
    } else {
        this.vy -= 24.0 * dt;
    }
    physics2d::move_character(this.node, sideways * this.speed * dt, this.vy * dt);
}
