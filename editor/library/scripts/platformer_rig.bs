// Left, right and jump over the 2D character controller. Raw keys rather than
// actions, so the rig works in a project that has declared none: swap them for
// `input::action_*` to rebind.

pub struct PlatformerRig {
    node: Node,
    pub speed: float = 6.0,
    pub jump: float = 9.0,
    pub gravity: float = 24.0,
    vy: float,
}

impl PlatformerRig {
    fn fixed_update(dt: float) {
        let right = if input::key_down(input::KEY_D) { 1.0 } else { 0.0 };
        let left = if input::key_down(input::KEY_A) { 1.0 } else { 0.0 };
        let sideways = right - left;
        // The controller reports whether the last move ended on the ground,
        // which is what decides between falling and being able to jump.
        if self.node.character2d.is_on_floor() {
            self.vy = if input::key_just_pressed(input::KEY_SPACE) { self.jump } else { 0.0 };
        } else {
            self.vy -= self.gravity * dt;
        }
        self.node.character2d.move_character(sideways * self.speed * dt, self.vy * dt);
    }
}
