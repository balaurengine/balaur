// A worked example of an editor plugin, and the editor's own check that the
// plugin seam holds: how many nodes carry a script, as a dock tab, a palette
// command, a floating window and a start-up state that asserts the count.

const BODY: str = "body";
const COMPONENT: str = "component";
const CONTROLS: str = "controls";
const COUNT: str = "count";
const COUNTER: str = "counter";
const COUNTER_WINDOW: str = "counter-window";
const DEFAULT: str = "default";
const DESCRIPTION: str = "description";
const DRAW: str = "draw";
const HOST: str = "host";
const ICON: str = "icon";
const ID: str = "id";
const KIND: str = "kind";
const NODES: str = "nodes";
const PANELS: str = "panels";
const READ: str = "read";
const READONLY: str = "readonly";
const ROLE: str = "role";
const ROWS: str = "rows";
const RUN: str = "run";
const SCHEMA: str = "schema";
const SCRIPTED: str = "scripted";
const SHORTCUT: str = "shortcut";
const TEXT: str = "text";
const TEXT_CAPTION: str = "text_caption";
const TITLE: str = "title";
const TYPE: str = "type";

pub class Counter {
    node: Node,
    // What the last count found; -1 before anyone asked.
    shown: int = -1,
}

const ASK: str = "run “Count scripted nodes” from the palette";

// The Editor, whose methods are what a plugin reaches the editor through.
fn editor() -> Node {
    scene::get_node("Editor")
}

// How many nodes of the scene name a script.
fn scripted() -> int {
    let count = 0;
    for found in editor().call("nodes") {
        if found.as_node().script_path() != "" {
            count += 1;
        }
    }
    count
}

impl Counter {
    /// What this plugin adds, each entry naming the method that answers it.
    /// Every list is optional.
    pub fn register() -> any {
        {
            PANELS: [{ ID: COUNTER, TITLE: "Counter", DRAW: "panel" }],
            "dialogs": [{ ID: COUNTER_WINDOW, TITLE: "Counter", ROWS: "dialog" }],
            "commands": [{ TITLE: "Count scripted nodes", ICON: "Σ", SHORTCUT: "", RUN: COUNT }],
            "inspector_sections": [{
                COMPONENT: COUNTER,
                SCHEMA: { SCRIPTED: { TYPE: "int", READONLY: true, DEFAULT: 0, DESCRIPTION: "How many nodes named a script at the last count" } },
                READ: "section",
            }],
            "startup_states": { "test:plugin_docks": "selftest" },
        }
    }

    pub fn count(payload: any) {
        self.shown = scripted();
        log::info("{self.shown} scripted nodes");
        editor().call("kit_changed");
    }

    /// The dock: `payload.host` is the node the editor made for it, and the
    /// kit's rows are what fill it.
    pub fn panel(payload: any) {
        let editor_node = editor();
        let specs = [editor_node.call("kit_heading", "Scripted nodes")];
        if self.shown < 0 {
            specs.push(editor_node.call("kit_empty", ASK));
        } else {
            specs.push(editor_node.call("kit_field", NODES, "{self.shown}", { "copy": true }));
        }
        editor_node.call("kit_rows", payload[HOST], BODY, specs);
    }

    /// The floating window's rows: the editor makes the window, its title and
    /// its close, and fills it with these when the plugin says it moved.
    pub fn dialog(payload: any) -> any {
        let said = if self.shown < 0 { ASK } else { "{self.shown} scripted nodes" };
        [{ CONTROLS: [{ KIND: ui::WIDGET_LABEL, ROLE: TEXT_CAPTION, "wrap": true, TEXT: said }] }]
    }

    /// An inspector section's values: a component of the plugin's own, whose
    /// rows the Inspector draws like any other. Nil until there is a count.
    pub fn section(payload: any) -> any {
        if self.shown < 0 {
            return nil;
        }
        { SCRIPTED: self.shown }
    }

    /// `--state test:plugin_docks`: the plugin seam, asserted the way the
    /// editor's own self-tests are. `log::error` is what fails the run.
    pub fn selftest(payload: any) {
        let expected = scripted();
        self.count(nil);
        if self.shown == expected {
            log::info("selftest ok: a plugin keeps its own state ({expected})");
        } else {
            log::error("selftest FAILED: a plugin's state did not stick");
        }
        let loaded = editor().call("plugins").len();
        if loaded > 0 {
            log::info("selftest ok: the registry lists {loaded} plugin(s)");
        } else {
            log::error("selftest FAILED: the registry lists no plugin");
        }
        editor().call("kit_open_dialog", COUNTER_WINDOW);
        log::info("selftest plugin: done");
    }
}
