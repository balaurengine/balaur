# LF in the index and on every checkout: a CRLF checkout (Windows CI) exports
# different pack bytes than Linux and macOS from the same sources.
* text=auto eol=lf
# Fuzz seeds are inputs byte for byte: an HTTP handshake keeps its CRLFs.
fuzz/seeds/** -text
# Valve's libraries, byte for byte.
crates/balaur_steam/sdk/redistributable_bin/** binary
