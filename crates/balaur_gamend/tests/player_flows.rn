// What a player does on a live Gamend, through the SDK addon the way a game
// calls it. `player_flows.rs` fills the `@...@` slots: player B signed in
// there and answers over plain `http::request`.

const URL = "@URL@";
const FLOW = "@FLOW@";
const DEVICE = "@DEVICE@";
const TAG = "@TAG@";
const B_ID = "@B_ID@";
const B_TOKEN = "@B_TOKEN@";
/// A live server limits calls per minute; a flow waits out a 429.
const LIMITED_WAIT = 15.0;
const LIMITED_TRIES = 6;
const HEARD_WAIT = 5.0;

pub async fn init(this) {
    gamend::configure(URL);
    this.heard = [];
    this.lost = [];
    let steps = [];
    let login = sign_in(DEVICE).await;
    let me = field(login, "user_id");
    if !(me is String) {
        log::info(`flow ${FLOW}: login failed`);
        return;
    }
    if FLOW == "profile" {
        profile(this, steps, me).await;
    } else if FLOW == "lobby" {
        lobby(this, steps, me).await;
    } else if FLOW == "social" {
        friends(steps, me).await;
        party(steps).await;
        groups(steps).await;
        goodbye(steps, me, ()).await;
    } else if FLOW == "catalog" {
        catalog(steps, me).await;
    } else if FLOW == "realtime" {
        realtime(this, steps, me).await;
    } else if FLOW == "kicked" {
        kicked(this, steps, me).await;
    }
    let line = `flow ${FLOW}:`;
    for step in steps {
        line += ` ${step}`;
    }
    log::info(`${line} end`);
}

async fn profile(this, steps, me) {
    let name = `Tester ${TAG}`;
    let user = TAG;
    call(steps, "me", || gamend::users::get_current_user(())).await;
    call(steps, "display_name", || gamend::users::update_current_user_display_name((), #{ "display_name": name })).await;
    call(steps, "username", || gamend::users::update_current_user_username((), #{ "username": user })).await;
    let mine = data(call(steps, "me_again", || gamend::users::get_current_user(())).await);
    check(steps, "renamed", same(field(mine, "display_name"), name) && same(field(mine, "username"), user));
    let public = data(call(steps, "get_user", || gamend::users::get_user((), me)).await);
    check(steps, "public_name", same(field(public, "display_name"), name));
    let found = data(call(steps, "search", || gamend::users::search_users((), #{ "q": user })).await);
    check(steps, "found", has(found, "id", me));

    let session = gamend::session();
    let fresh = data(call(steps, "refresh", || gamend::authentication::refresh_token((), #{ "refresh_token": session["refresh_token"] })).await);
    check(steps, "refreshed", field(fresh, "access_token") is String);

    // A token the server will not take heals: a call refreshes on its 401,
    // and a socket renews a token it cannot read before connecting.
    let kept = gamend::session();
    kept["access_token"] = "stale";
    gamend::restore(kept);
    call(steps, "healed", || gamend::users::get_current_user(())).await;
    let token = field(gamend::session(), "access_token");
    check(steps, "renewed", token is String && token != "stale");
    gamend::restore(kept);
    this.socket = gamend::connect(this.node);
    check(steps, "socket_healed", heard(this, "open").await);
    gamend::close(this.socket);

    // Linking moves the account to the new device; the old one is a stranger.
    let second = `${DEVICE}-2`;
    call(steps, "link_device", || gamend::authentication::link_device((), #{ "device_id": second })).await;
    let moved = sign_in(second).await;
    check(steps, "linked", same(field(moved, "user_id"), me));
    call(steps, "unlink_last", || gamend::authentication::unlink_device(())).await;

    // A new password signs every session out, this one included.
    let password = `pw-${TAG}-long`;
    call(steps, "set_password", || gamend::users::update_current_user_password((), #{ "password": password })).await;
    call(steps, "signed_out", || gamend::users::get_current_user(())).await;
    sign_in(second).await;
    call(steps, "delete_refused", || gamend::users::delete_current_user((), ())).await;
    goodbye(steps, me, #{ "current_password": password }).await;
}

async fn lobby(this, steps, me) {
    let title = `lobby ${TAG}`;
    let made = data(call(steps, "create", || gamend::lobbies::create_lobby((), #{ "title": title, "max_users": 4, "metadata": #{ "mode": "duel" } })).await);
    let id = field(made, "id");
    this.socket = gamend::connect(this.node);
    check(steps, "socket_open", heard(this, "open").await);
    let joined = task::wait(gamend::join(this.socket, `lobby:${id}`)).await;
    check(steps, "channel_joined", same(field(joined, "status"), "ok"));
    let got = data(call(steps, "get", || gamend::lobbies::get_lobby((), id)).await);
    check(steps, "hosted", same(field(got, "host_id"), me));
    let listed = data(call(steps, "list", || gamend::lobbies::list_lobbies((), #{ "title": title })).await);
    check(steps, "listed", has(listed, "id", id));
    let renamed = `renamed ${TAG}`;
    let updated = data(call(steps, "update", || gamend::lobbies::update_lobby((), #{ "title": renamed, "metadata": #{ "mode": "ffa" } })).await);
    check(steps, "updated", same(field(updated, "title"), renamed) && same(field(field(updated, "metadata"), "mode"), "ffa"));
    let playing = data(call(steps, "state", || gamend::lobbies::set_lobby_state((), #{ "state": "playing" })).await);
    check(steps, "playing", same(field(playing, "state"), "playing"));
    as_b(steps, "join", "POST", `/api/v1/lobbies/${id}/join`, #{}).await;
    let full = data(call(steps, "get_full", || gamend::lobbies::get_lobby((), id)).await);
    check(steps, "two", count(field(full, "members")) == 2);

    let sent = data(call(steps, "chat_send", || gamend::chat::send_chat_message((), #{ "chat_type": "lobby", "chat_ref_id": id, "content": "gg" })).await);
    let message = field(sent, "id");
    let unread = data(as_b(steps, "unread", "GET", `/api/v1/chat/unread?chat_type=lobby&chat_ref_id=${id}`, ()).await);
    check(steps, "b_unread_one", same(field(unread, "unread_count"), 1));
    let history = data(call(steps, "chat_list", || gamend::chat::list_chat_messages((), #{ "chat_type": "lobby", "chat_ref_id": id })).await);
    check(steps, "chat_listed", has(history, "id", message));
    call(steps, "chat_edit", || gamend::chat::update_chat_message((), message, #{ "content": "good game" })).await;
    let edited = data(call(steps, "chat_get", || gamend::chat::get_chat_message((), message)).await);
    check(steps, "chat_edited", same(field(edited, "content"), "good game"));
    call(steps, "chat_read", || gamend::chat::mark_chat_read((), #{ "chat_type": "lobby", "chat_ref_id": id, "message_id": message })).await;
    call(steps, "chat_delete", || gamend::chat::delete_chat_message((), message)).await;

    call(steps, "ready_open", || gamend::ready_checks::open_lobby_ready_check((), #{ "timeout_ms": 30000 })).await;
    let answer = data(as_b(steps, "ready", "POST", "/api/v1/me/ready_check", #{ "ready": true, "scope": "lobby" }).await);
    check(steps, "ready_passed", same(field(answer, "status"), "passed"));
    call(steps, "mute", || gamend::chat::mute_lobby_member((), #{ "target_user_id": B_ID })).await;
    let mutes = data(call(steps, "mutes", || gamend::chat::list_lobby_mutes((), #{})).await);
    check(steps, "b_muted", has(mutes, "user_id", B_ID));
    call(steps, "unmute", || gamend::chat::unmute_lobby_member((), #{ "target_user_id": B_ID })).await;
    call(steps, "kick", || gamend::lobbies::kick_user((), #{ "target_user_id": B_ID })).await;
    let kicked = data(call(steps, "get_kicked", || gamend::lobbies::get_lobby((), id)).await);
    check(steps, "one", count(field(kicked, "members")) == 1);
    let expected = [
        gamend::events::lobby::UPDATED,
        gamend::events::lobby::STATE_CHANGED,
        gamend::events::lobby::MEMBER_JOINED,
        gamend::events::lobby::CHAT_MESSAGE,
        gamend::events::lobby::READY_CHECK_PASSED,
        gamend::events::lobby::MEMBER_KICKED,
    ];
    for kind in expected {
        check(steps, `heard_${kind}`, heard(this, kind).await);
    }
    gamend::close(this.socket);
    call(steps, "leave", || gamend::lobbies::leave_lobby(())).await;
    call(steps, "gone", || gamend::lobbies::get_lobby((), id)).await;

    let quick = data(call(steps, "quick_join", || gamend::lobbies::quick_join((), #{ "title": `quick ${TAG}`, "max_users": 2 })).await);
    call(steps, "disband", || gamend::lobbies::disband_lobby(())).await;
    call(steps, "quick_gone", || gamend::lobbies::get_lobby((), field(quick, "id"))).await;
    call(steps, "stats", || gamend::lobbies::lobby_stats(())).await;
    goodbye(steps, me, ()).await;
}

async fn friends(steps, me) {
    let asked = data(as_b(steps, "befriend", "POST", "/api/v1/friends", #{ "target_user_id": me }).await);
    let friendship = field(asked, "id");
    let requests = data(call(steps, "requests", || gamend::friends::list_friend_requests((), #{})).await);
    check(steps, "incoming", has(field(requests, "incoming"), "id", friendship));
    call(steps, "accept", || gamend::friends::accept_friend_request((), friendship)).await;
    let listed = data(call(steps, "friends", || gamend::friends::list_friends((), #{})).await);
    check(steps, "befriended", has(listed, "id", B_ID));

    let note = data(call(steps, "notify", || gamend::notifications::send_notification((), #{ "user_id": B_ID, "title": `hello ${TAG}`, "content": "gg" })).await);
    let note_id = field(note, "id");
    let inbox = data(as_b(steps, "inbox", "GET", "/api/v1/notifications", ()).await);
    check(steps, "delivered", has(inbox, "id", note_id));
    as_b(steps, "dismiss", "DELETE", "/api/v1/notifications", #{ "ids": [note_id] }).await;
    call(steps, "own_inbox", || gamend::notifications::list_notifications((), #{})).await;

    call(steps, "unfriend", || gamend::friends::remove_friendship((), friendship)).await;
    call(steps, "block", || gamend::friends::block_user((), B_ID)).await;
    let blocked = data(call(steps, "blacklist", || gamend::friends::list_blacklisted_users((), #{})).await);
    check(steps, "b_blocked", has(blocked, "id", B_ID));
    call(steps, "unblock", || gamend::friends::unblock_user((), B_ID)).await;
    // Parties and groups invite friends only.
    let again = data(as_b(steps, "befriend_again", "POST", "/api/v1/friends", #{ "target_user_id": me }).await);
    call(steps, "accept_again", || gamend::friends::accept_friend_request((), field(again, "id"))).await;
}

async fn party(steps) {
    let made = data(call(steps, "party", || gamend::parties::create_party((), #{ "max_size": 4 })).await);
    let party_id = field(made, "id");
    call(steps, "invite", || gamend::parties::invite_to_party((), #{ "target_user_id": B_ID })).await;
    let sent = data(call(steps, "sent", || gamend::parties::list_sent_party_invitations((), #{})).await);
    check(steps, "invite_sent", has(sent, "party_id", party_id));
    as_b(steps, "join_party", "POST", "/api/v1/parties/invite/accept", #{ "party_id": party_id }).await;
    let shown = data(call(steps, "show", || gamend::parties::show_party(())).await);
    check(steps, "party_of_two", count(field(shown, "members")) == 2);
    call(steps, "party_update", || gamend::parties::update_party((), #{ "metadata": #{ "mode": "duel" } })).await;
    call(steps, "ready_open", || gamend::ready_checks::open_party_ready_check((), #{ "timeout_ms": 30000 })).await;
    let answer = data(as_b(steps, "ready", "POST", "/api/v1/me/ready_check", #{ "ready": true, "scope": "party" }).await);
    check(steps, "ready_passed", same(field(answer, "status"), "passed"));
    let lobby = data(call(steps, "party_lobby", || gamend::parties::party_create_lobby((), #{ "title": `party ${TAG}`, "max_users": 4 })).await);
    let b_me = data(as_b(steps, "me", "GET", "/api/v1/me", ()).await);
    check(steps, "b_followed", same(field(b_me, "lobby_id"), field(lobby, "id")));
    as_b(steps, "leave_lobby", "POST", "/api/v1/lobbies/leave", ()).await;
    call(steps, "leave_lobby", || gamend::lobbies::leave_lobby(())).await;
    call(steps, "party_kick", || gamend::parties::kick_party_member((), #{ "target_user_id": B_ID })).await;
    call(steps, "disband", || gamend::parties::disband_party(())).await;
}

async fn groups(steps) {
    let title = `group ${TAG}`;
    let made = data(call(steps, "group", || gamend::groups::create_group((), #{ "title": title, "type": "private" })).await);
    let id = field(made, "id");
    call(steps, "group_invite", || gamend::groups::invite_to_group((), id, #{ "target_user_id": B_ID })).await;
    let invites = data(as_b(steps, "invites", "GET", "/api/v1/groups/invitations", ()).await);
    let invite = field(first_with(invites, "group_id", id), "id");
    as_b(steps, "join_group", "POST", `/api/v1/groups/invitations/${invite}/accept`, ()).await;
    let members = data(call(steps, "members", || gamend::groups::list_group_members((), id, #{})).await);
    check(steps, "group_of_two", count(members) == 2);
    let mine = data(call(steps, "my_groups", || gamend::groups::list_my_groups((), #{})).await);
    check(steps, "mine", has(mine, "id", id));
    call(steps, "group_update", || gamend::groups::update_group((), id, #{ "description": "test" })).await;
    call(steps, "promote", || gamend::groups::promote_group_member((), id, #{ "target_user_id": B_ID })).await;
    call(steps, "demote", || gamend::groups::demote_group_member((), id, #{ "target_user_id": B_ID })).await;
    call(steps, "group_mute", || gamend::chat::mute_group_member((), id, #{ "target_user_id": B_ID })).await;
    let mutes = data(call(steps, "group_mutes", || gamend::chat::list_group_mutes((), id, #{})).await);
    check(steps, "b_muted", has(mutes, "user_id", B_ID));
    call(steps, "group_unmute", || gamend::chat::unmute_group_member((), id, #{ "target_user_id": B_ID })).await;
    call(steps, "group_chat", || gamend::chat::send_chat_message((), #{ "chat_type": "group", "chat_ref_id": id, "content": "gm" })).await;
    let unread = data(as_b(steps, "unread", "GET", `/api/v1/chat/unread?chat_type=group&chat_ref_id=${id}`, ()).await);
    check(steps, "b_unread_one", same(field(unread, "unread_count"), 1));
    call(steps, "group_kick", || gamend::groups::kick_group_member((), id, #{ "target_user_id": B_ID })).await;
    call(steps, "group_leave", || gamend::groups::leave_group((), id)).await;
    let left = data(call(steps, "group_gone", || gamend::groups::list_groups((), #{ "title": title })).await);
    check(steps, "no_group", count(left) == 0);

    // A private group takes a join request, which its admin approves.
    let asked_title = `asked ${TAG}`;
    let asked = data(call(steps, "asked_group", || gamend::groups::create_group((), #{ "title": asked_title, "type": "private" })).await);
    let asked_id = field(asked, "id");
    let request = data(as_b(steps, "ask", "POST", `/api/v1/groups/${asked_id}/join`, ()).await);
    let pending = data(call(steps, "join_requests", || gamend::groups::list_join_requests((), asked_id, #{})).await);
    check(steps, "pending", has(pending, "id", field(request, "id")));
    call(steps, "approve", || gamend::groups::approve_join_request((), asked_id, field(request, "id"))).await;
    as_b(steps, "leave_asked", "POST", `/api/v1/groups/${asked_id}/leave`, ()).await;
    call(steps, "leave_asked", || gamend::groups::leave_group((), asked_id)).await;
    let asked_left = data(call(steps, "asked_gone", || gamend::groups::list_groups((), #{ "title": asked_title })).await);
    check(steps, "no_asked_group", count(asked_left) == 0);
}

async fn catalog(steps, me) {
    call(steps, "wallet", || gamend::economy::get_current_user_wallet(())).await;
    call(steps, "inventory", || gamend::economy::get_current_user_inventory(())).await;
    call(steps, "ledger", || gamend::economy::list_current_user_ledger((), #{})).await;
    call(steps, "quests", || gamend::quests::list_quests((), #{})).await;
    call(steps, "my_quests", || gamend::quests::my_quests((), #{})).await;
    call(steps, "user_quests", || gamend::quests::user_quests((), me, #{})).await;
    call(steps, "quest_stats", || gamend::quests::quest_stats(())).await;
    call(steps, "store", || gamend::payments::catalog((), #{})).await;
    call(steps, "entitlements", || gamend::payments::entitlements((), #{})).await;
    call(steps, "kv_missing", || gamend::kv::get_kv((), `missing-${TAG}`, #{})).await;
    call(steps, "log_policy", || gamend::client_logs::get_client_log_policy(())).await;
    call(steps, "hooks", || gamend::hooks::list_hooks((), #{})).await;
    let now = data(call(steps, "time", || gamend::time::get_server_time(())).await);
    check(steps, "clock", field(now, "server_now") is i64);
    call(steps, "stats", || gamend::stats::get_stats(())).await;
    call(steps, "user_stats", || gamend::users::user_stats(())).await;
    call(steps, "signaling", || gamend::signaling::stats(())).await;
    call(steps, "providers", || gamend::authentication::list_auth_providers(())).await;
    call(steps, "health", || gamend::health::index(())).await;
    call(steps, "party_invites", || gamend::parties::list_party_invitations((), #{})).await;
    call(steps, "group_invites", || gamend::groups::list_group_invitations((), #{})).await;
    call(steps, "party_stats", || gamend::parties::party_stats(())).await;

    let boards = data(call(steps, "boards", || gamend::leaderboards::list_leaderboards((), #{})).await);
    let board = field(first_with(boards, "", ""), "id");
    call(steps, "board", || gamend::leaderboards::get_leaderboard((), board)).await;
    call(steps, "records", || gamend::leaderboards::list_leaderboard_records((), board, #{})).await;
    call(steps, "my_record", || gamend::leaderboards::get_my_record((), board)).await;
    call(steps, "around_me", || gamend::leaderboards::list_records_around_user((), board, me, #{})).await;
    call(steps, "resolve", || gamend::leaderboards::resolve_leaderboard_slugs((), #{ "slugs": [`missing-${TAG}`] })).await;

    let open = data(call(steps, "tournaments", || gamend::tournaments::list_tournaments((), #{ "state": "registration" })).await);
    let cup = field(first_with(open, "", ""), "id");
    call(steps, "cup", || gamend::tournaments::get_tournament((), cup)).await;
    let entry = data(call(steps, "enter", || gamend::tournaments::join_tournament((), cup)).await);
    let entries = data(call(steps, "entries", || gamend::tournaments::tournament_entries((), cup, #{})).await);
    check(steps, "entered", has(entries, "id", field(entry, "id")) && same(field(entry, "leader_id"), me));
    call(steps, "my_match", || gamend::tournaments::tournament_my_match((), cup)).await;
    call(steps, "standings", || gamend::tournaments::tournament_standings((), cup)).await;
    call(steps, "withdraw", || gamend::tournaments::leave_tournament((), cup)).await;

    let token = data(call(steps, "push_register", || gamend::push_tokens::register_push_token((), #{ "platform": "android", "token": `t-${TAG}` })).await);
    let tokens = data(call(steps, "push_list", || gamend::push_tokens::list_push_tokens((), #{})).await);
    check(steps, "push_listed", has(tokens, "id", field(token, "id")));
    call(steps, "push_delete", || gamend::push_tokens::delete_push_token((), field(token, "id"))).await;
    // No ticket: a 404 from a current server, an empty 200 from an older one.
    let ticket = fetch(|| gamend::matchmaking::my_ticket(())).await;
    check(steps, "no_ticket", same(field(ticket, "status"), 404) || data(ticket) is Tuple);
    call(steps, "cancel", || gamend::matchmaking::cancel(())).await;
    call(steps, "queues", || gamend::matchmaking::stats(())).await;
    goodbye(steps, me, ()).await;
}

/// A dropped connection comes back by itself, joins its topics again and
/// says so, and an event after it still reaches its own handler.
async fn realtime(this, steps, me) {
    let made = data(call(steps, "create", || gamend::lobbies::create_lobby((), #{ "title": `live ${TAG}`, "max_users": 2 })).await);
    let id = field(made, "id");
    this.socket = gamend::connect(this.node);
    check(steps, "open", heard(this, "routed_socket_open").await);
    let joined = task::wait(gamend::join(this.socket, `lobby:${id}`)).await;
    check(steps, "channel_joined", same(field(joined, "status"), "ok"));
    check(steps, "interrupted", gamend::interrupt(this.socket));
    check(steps, "reconnecting", heard(this, "routed_socket_reconnecting").await);
    check(steps, "reopened", heard(this, "routed_socket_reopened").await);
    check(steps, "nothing_lost", count(this.lost) == 0);
    call(steps, "rename", || gamend::lobbies::update_lobby((), #{ "title": `after ${TAG}` })).await;
    check(steps, "heard_after", heard(this, "routed_lobby_updated").await);
    // No plugin answers `sdk_probe`, so the reply is an error: the socket
    // carries calls again.
    let hook = task::wait(gamend::call_hook(this.socket, "sdk_probe", "echo", ["hi"])).await;
    check(steps, "hook_after", same(field(hook, "status"), "error"));
    gamend::close(this.socket);
    check(steps, "closed", heard(this, "routed_socket_closed").await);
    call(steps, "leave", || gamend::lobbies::leave_lobby(())).await;
    goodbye(steps, me, ()).await;
}

/// A player the host kicks loses the lobby's channel, which the server
/// closes on purpose: a reconnect after it does not join it again.
async fn kicked(this, steps, me) {
    let made = data(as_b(steps, "create", "POST", "/api/v1/lobbies", #{ "title": `kick ${TAG}`, "max_users": 2 }).await);
    let id = field(made, "id");
    call(steps, "join", || gamend::lobbies::join_lobby((), id, #{})).await;
    this.socket = gamend::connect(this.node);
    check(steps, "open", heard(this, "routed_socket_open").await);
    let joined = task::wait(gamend::join(this.socket, `lobby:${id}`)).await;
    check(steps, "channel_joined", same(field(joined, "status"), "ok"));
    as_b(steps, "kick", "POST", "/api/v1/lobbies/kick", #{ "target_user_id": me }).await;
    check(steps, "kicked", heard(this, "routed_lobby_member_kicked").await);
    check(steps, "channel_closed", heard(this, "phx_close").await);
    check(steps, "interrupted", gamend::interrupt(this.socket));
    check(steps, "reopened", heard(this, "routed_socket_reopened").await);
    // The server lets anyone watch a lobby, so a rejoin would be let in and
    // would hear the rename; only a forgotten topic stays quiet.
    this.heard = [];
    as_b(steps, "rename", "PATCH", "/api/v1/lobbies", #{ "title": `renamed ${TAG}` }).await;
    let rejoined = heard(this, "lobby_updated").await;
    check(steps, "not_rejoined", !rejoined);
    gamend::close(this.socket);
    as_b(steps, "leave", "POST", "/api/v1/lobbies/leave", ()).await;
    goodbye(steps, me, ()).await;
}

/// Every socket event, named as `gamend::events::decode` names it, or by
/// the server's own event where the table names none, for `heard`; and
/// handed on to the handlers below.
pub fn on_gamend_event(this, e) {
    let kind = e["kind"];
    if kind == "message" {
        let named = gamend::events::decode(e["topic"], e["event"], e["payload"])["kind"];
        kind = e["event"];
        if named != "message" {
            kind = named;
        }
    }
    this.heard.push(kind);
    gamend::client::route(this.node, e);
}

pub fn on_lobby_member_kicked(this, e) {
    this.heard.push("routed_lobby_member_kicked");
}

pub fn on_socket_open(this, e) {
    this.heard.push("routed_socket_open");
}

pub fn on_socket_reconnecting(this, e) {
    this.heard.push("routed_socket_reconnecting");
}

pub fn on_socket_reopened(this, e) {
    this.lost = e["lost"];
    this.heard.push("routed_socket_reopened");
}

pub fn on_socket_closed(this, e) {
    this.heard.push("routed_socket_closed");
}

pub fn on_lobby_updated(this, e) {
    this.heard.push("routed_lobby_updated");
}

/// Whether the socket delivers `kind` within a few seconds.
async fn heard(this, kind) {
    let until = engine::unix_time() + HEARD_WAIT;
    loop {
        for seen in this.heard {
            if seen == kind {
                return true;
            }
        }
        if engine::unix_time() > until {
            let got = "";
            for seen in this.heard {
                got += ` ${seen}`;
            }
            log::info(`waited for ${kind}; heard${got}`);
            return false;
        }
        task::frames(1).await;
    }
}

/// Delete the account and prove it: nobody can look it up any more.
async fn goodbye(steps, me, params) {
    call(steps, "delete", || gamend::users::delete_current_user((), params)).await;
    send(steps, "lookup_deleted", "", "GET", `/api/v1/users/${me}`, ()).await;
}

/// Sign in, waiting out the server's limit on sign-ins.
async fn sign_in(device) {
    let login = task::wait(gamend::login((), #{ "device_id": device })).await;
    let tries = 0;
    while limited(field(login, "error")) && tries < LIMITED_TRIES {
        pause().await;
        login = task::wait(gamend::login((), #{ "device_id": device })).await;
        tries += 1;
    }
    login
}

fn limited(error) {
    error is String && error.contains("(429)")
}

/// Let a rate-limit window pass. Wall-clock seconds: this harness ticks
/// faster than real time.
async fn pause() {
    let until = engine::unix_time() + LIMITED_WAIT;
    while engine::unix_time() < until {
        task::frames(1).await;
    }
}

/// Make an SDK call, note its status and answer the reply.
async fn call(steps, name, make) {
    let reply = fetch(make).await;
    steps.push(`${name}=${status_of(reply)}`);
    reply
}

/// Make an SDK call, again while the server answers 429.
async fn fetch(make) {
    let reply = task::wait(make()).await;
    let tries = 0;
    while same(field(reply, "status"), 429) && tries < LIMITED_TRIES {
        pause().await;
        reply = task::wait(make()).await;
        tries += 1;
    }
    reply
}

/// A call as player B, who signed in outside the SDK.
async fn as_b(steps, name, method, path, payload) {
    send(steps, `b_${name}`, B_TOKEN, method, path, payload).await
}

/// A plain HTTP call, with `token` when it is not empty.
async fn send(steps, name, token, method, path, payload) {
    let headers = #{ "content-type": "application/json" };
    if token != "" {
        headers["authorization"] = `Bearer ${token}`;
    }
    let opts = #{ "method": method, "headers": headers };
    if !(payload is Tuple) {
        opts["body"] = json::encode(payload);
    }
    let reply = task::wait(http::request(`${URL}${path}`, opts)).await;
    let tries = 0;
    while same(field(reply, "status"), 429) && tries < LIMITED_TRIES {
        pause().await;
        reply = task::wait(http::request(`${URL}${path}`, opts)).await;
        tries += 1;
    }
    let status = status_of(reply);
    steps.push(`${name}=${status}`);
    let text = field(reply, "body");
    let body = if text is String && text != "" { json::parse(text) } else { () };
    #{ "status": status, "body": body }
}

/// The HTTP status, or `error` for a call that never got one.
fn status_of(reply) {
    let status = field(reply, "status");
    if status is Tuple { "error" } else { status }
}

fn check(steps, name, held) {
    let word = if held { "yes" } else { "NO" };
    steps.push(`${name}=${word}`);
}

fn field(value, key) {
    if value is Object && value.contains_key(key) { value[key] } else { () }
}

/// A reply's `data`, or its whole body where the server sends it bare.
fn data(reply) {
    let body = field(reply, "body");
    if body is Object && body.contains_key("data") { body["data"] } else { body }
}

fn same(a, b) {
    if a is String && b is String {
        return a == b;
    }
    if a is i64 && b is i64 {
        return a == b;
    }
    false
}

fn count(list) {
    if list is Vec { list.len() } else { -1 }
}

fn has(list, key, value) {
    !(first_with(list, key, value) is Tuple)
}

/// The first row whose `key` is `value`; an empty key takes the first row.
fn first_with(list, key, value) {
    if !(list is Vec) {
        return ();
    }
    for row in list {
        if key == "" || same(field(row, key), value) {
            return row;
        }
    }
    return ();
}
