// The engine's vectors, colours and transforms, as every program sees them.

pub struct Vec2 { x: float, y: float }
pub struct Vec3 { x: float, y: float, z: float }
pub struct Color { r: float, g: float, b: float, a: float }
pub struct Transform2d { x: Vec2, y: Vec2, origin: Vec2 }
pub struct Transform3d { x: Vec3, y: Vec3, z: Vec3, origin: Vec3 }
