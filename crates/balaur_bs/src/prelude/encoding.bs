//! Bytes to base64 text and back, and UTF-8 bytes back to text.

const ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
const PAD = 61;

/// Bytes as standard base64 with padding; a value outside 0 to 255 traps.
pub fn base64(data: [int]) -> str {
    let length = data.len();
    let out = __str_new((length + 2) / 3 * 4);
    let at = 0;
    let put = 0;
    while at + 3 <= length {
        let first = data[at];
        let second = data[at + 1];
        let third = data[at + 2];
        if (first | second | third) & -256 != 0 {
            __trap();
        }
        let group = first << 16 | second << 8 | third;
        __str_put(out, put, __byte(ALPHABET, group >> 18));
        __str_put(out, put + 1, __byte(ALPHABET, group >> 12 & 63));
        __str_put(out, put + 2, __byte(ALPHABET, group >> 6 & 63));
        __str_put(out, put + 3, __byte(ALPHABET, group & 63));
        at += 3;
        put += 4;
    }
    let left = length - at;
    if left == 1 {
        write(out, put, byte(data, at) << 16, 2);
    } else if left == 2 {
        write(out, put, byte(data, at) << 16 | byte(data, at + 1) << 8, 3);
    }
    out
}

/// The bytes a base64 string encodes, in the standard alphabet with its
/// padding; text that is not base64 traps.
pub fn from_base64(text: str) -> [int] {
    let length = text.len();
    if length % 4 != 0 {
        __trap();
    }
    let pads = 0;
    if length > 0 && __byte(text, length - 1) == PAD {
        pads = if __byte(text, length - 2) == PAD { 2 } else { 1 };
    }
    let out = [0; length / 4 * 3 - pads];
    let at = 0;
    let put = 0;
    while at < length {
        let last = at + 4 == length;
        let group = digit(text, at) << 18 | digit(text, at + 1) << 12;
        if last && pads == 2 {
            if group & 65535 != 0 {
                __trap();
            }
        } else {
            group |= digit(text, at + 2) << 6;
            if last && pads == 1 {
                if group & 255 != 0 {
                    __trap();
                }
            } else {
                group |= digit(text, at + 3);
            }
        }
        out[put] = group >> 16;
        if put + 1 < out.len() {
            out[put + 1] = group >> 8 & 255;
        }
        if put + 2 < out.len() {
            out[put + 2] = group & 255;
        }
        at += 4;
        put += 3;
    }
    out
}

/// The text UTF-8 bytes spell; nil when they are not UTF-8, a value outside
/// 0 to 255 included.
pub fn from_utf8(data: [int]) -> str? {
    let length = data.len();
    let at = 0;
    while at < length {
        let lead = data[at];
        let width = if lead >= 0 && lead < 128 {
            1
        } else if lead >= 194 && lead < 224 {
            2
        } else if lead >= 224 && lead < 240 {
            3
        } else if lead >= 240 && lead < 245 {
            4
        } else {
            0
        };
        if width == 0 || at + width > length {
            return nil;
        }
        // Past the lead, only the second byte's range narrows: that keeps
        // out an overlong form, a surrogate and a code point past U+10FFFF.
        let low = if lead == 224 { 160 } else if lead == 240 { 144 } else { 128 };
        let high = if lead == 237 { 159 } else if lead == 244 { 143 } else { 191 };
        let next = 1;
        while next < width {
            let follow = data[at + next];
            if follow < low || follow > high {
                return nil;
            }
            low = 128;
            high = 191;
            next += 1;
        }
        at += width;
    }
    let out = __str_new(length);
    for index in 0..length {
        __str_put(out, index, data[index]);
    }
    out
}

fn byte(data: [int], at: int) -> int {
    let value = data[at];
    if value & -256 != 0 {
        __trap();
    }
    value
}

// The first `count` digits of a 24-bit group from `put`, padded to four.
fn write(out: str, put: int, group: int, count: int) {
    for index in 0..4 {
        let code = if index < count {
            __byte(ALPHABET, group >> 18 - index * 6 & 63)
        } else {
            PAD
        };
        __str_put(out, put + index, code);
    }
}

fn digit(text: str, at: int) -> int {
    let code = __byte(text, at);
    if code >= 65 && code <= 90 {
        code - 65
    } else if code >= 97 && code <= 122 {
        code - 71
    } else if code >= 48 && code <= 57 {
        code + 4
    } else if code == 43 {
        62
    } else if code == 47 {
        63
    } else {
        __trap();
        0
    }
}
