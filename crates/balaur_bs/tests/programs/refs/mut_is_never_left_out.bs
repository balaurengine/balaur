// A `&mut` parameter is a place the call stores back: never left out, though
// its type is optional, and neither is what comes before it.
fn set(out: &mut int?) { out = 1; }
fn after(a: int?, out: &mut int?) { out = a; }

pub fn alone() { set(); }
pub fn last() {
    let x: int? = nil;
    after(x);
}
pub fn neither() { after(); }

