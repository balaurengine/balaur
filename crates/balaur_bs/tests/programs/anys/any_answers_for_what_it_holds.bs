pub fn run(a: any) -> str {
    let gone = a.remove("n");
    let list = a["tags"];
    let first = list.remove(0);
    let total = 0;
    for t in a["tags"] { total += 1; }
    let name: str = a["name"].as_str();
    "{gone.as_int()} {first.as_str()} {total} {a.has("n")} {name.starts_with("or")} {a["name"] == a["name"]} {a["name"].or("x")} {a["missing"].is_none()} {-a["score"].as_float()}"
}
pub fn plain(n: int, s: str) -> str { "{n.as_float()} {s.as_str()} {n.as_str()}" }

// expect: run({ "name": "orc", "n": 3, "score": 1.5, "tags": ["a", "b"] }) == "3 a 1 false true true orc true -1.5"
// expect: plain(2, "s") == "2.0 s 2"
