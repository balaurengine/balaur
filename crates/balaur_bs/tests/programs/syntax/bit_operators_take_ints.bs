pub fn mixed(a: int) -> int { a & 2.0 }
pub fn floats(x: float) -> float { x << 1 }
pub fn flags(a: bool, b: bool) -> bool { a | b }
pub fn flipped(x: float) -> float { ~x }
pub fn into_a_float(x: float) -> float {
    x ^= 1;
    x
}

