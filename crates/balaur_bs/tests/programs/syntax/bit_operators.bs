// The bit operators on ints, with Rust's precedence. A shift takes its
// count's low six bits, as wasm does, and `>>` keeps the sign.

pub fn and(a: int, b: int) -> int { a & b }
pub fn or(a: int, b: int) -> int { a | b }
pub fn xor(a: int, b: int) -> int { a ^ b }
pub fn not(a: int) -> int { ~a }
pub fn left(a: int, n: int) -> int { a << n }
pub fn right(a: int, n: int) -> int { a >> n }
pub fn shifted_past_plus() -> int { 1 << 2 + 1 }
pub fn and_past_shift() -> int { 12 & 1 << 3 }
pub fn xor_past_and() -> int { 6 ^ 3 & 5 }
pub fn or_past_xor() -> int { 1 | 6 ^ 2 }
pub fn compared_last() -> bool { 4 | 1 == 5 }
pub fn not_before_times() -> int { ~2 * 3 }
pub fn compound(a: int) -> int {
    let x = a;
    x &= 255;
    x |= 256;
    x ^= 1;
    x <<= 4;
    x >>= 2;
    x
}
pub fn in_a_list(a: int) -> int {
    let xs = [a, a];
    xs[1] |= 16;
    xs[1] <<= 1;
    xs[0] ^ xs[1]
}

// expect: and(12, 10) == 8
