pub fn first_square_over(limit: int) -> int {
    let i = 0;
    loop {
        i += 1;
        if i * i <= limit { continue; }
        break;
    }
    i
}
pub fn evens(n: int) -> int {
    let count = 0;
    for i in 0..n { if i % 2 == 0 { count += 1; } }
    while count > 100 { return -1; }
    count
}
pub fn first(xs: [int]) -> int {
    let x = if xs.len() > 0 { xs[0] } else { return -1; };
    x * 2
}
pub fn sum(xs: [int?]) -> int {
    let t = 0;
    for o in xs {
        let v = if o.is_some() { o.unwrap() } else { continue; };
        t += v;
    }
    t
}

// expect: first_square_over(50) == 8
// expect: evens(9) == 5
// expect: first([]) == -1
// expect: first([4]) == 8
// expect: sum([1, (), 3]) == 4
