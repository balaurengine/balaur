// A value no byte holds, and text that is not canonical base64, trap. A trap
// leaves what the call allocated behind.

pub fn encoded(data: [int]) -> str { encoding::base64(data) }
pub fn decoded(text: str) -> [int] { encoding::from_base64(text) }

// expect: encoded([256]) traps unreachable
// expect: encoded([1, 2, -1]) traps unreachable
// expect: encoded([1, 300, 2, 4]) traps unreachable
// expect: decoded("@@@@") traps unreachable
// expect: decoded("Zg=") traps unreachable
// expect: decoded("Zg=a") traps unreachable
// expect: decoded("Zh==") traps unreachable
// expect: decoded("Zm9=") traps unreachable
// expect: decoded("Zg==Zg==") traps unreachable
// expect: decoded("Zm 9") traps unreachable
