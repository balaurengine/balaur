// A string's UTF-8 bytes, and back to text: nil for bytes that are not
// UTF-8, an overlong form, a surrogate and a code point past U+10FFFF
// among them.

pub fn bytes(text: str) -> [int] { text.bytes() }
pub fn back(data: [int]) -> str { encoding::from_utf8(data).unwrap() }
pub fn is_text(data: [int]) -> bool { encoding::from_utf8(data) != nil }
pub fn round_trip(text: str) -> bool { encoding::from_utf8(text.bytes()).unwrap() == text }

// expect: bytes("") == []
