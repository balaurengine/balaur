// A counted loop past either end of an array still traps, and the module
// runs on.

pub fn sum_from(from: int, to: int) -> float {
    let xs = [0.0; 8];
    for i in 0..8 { xs[i] = i; }
    let t = 0.0;
    for i in from..to { t += xs[i]; }
    t
}

// expect: sum_from(0, 9) traps
// expect: sum_from(-1, 3) traps
// expect: sum_from(1, 2) == 1.0
