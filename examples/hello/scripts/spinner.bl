// spinner.rn in balaur_lang. Spins in place; the `reverse` action (Space, or
// the pad's south button) flips it. `speed` and `clockwise` are exported.

pub struct Spinner {
    pub speed: float = 2.0,
    pub clockwise: bool = true,
    node: Node,
    angle: float,
    direction: float,
}

impl Spinner {
    fn init() {
        self.angle = 0.0;
        self.direction = if self.clockwise { 1.0 } else { -1.0 };
    }

    // Called by the menu's buttons, not by anything here.
    pub fn reverse() {
        self.direction = -self.direction;
    }

    pub fn scale_speed(factor: float) {
        self.speed = clamp(self.speed * factor, 0.25, 32.0);
    }

    fn update(dt: float) {
        if input::action_just_pressed("reverse") {
            self.direction = -self.direction;
        }
        // `spin` is an axis: A/D or the left stick nudge the speed either way.
        let nudge = input::action_value("spin");
        self.angle += dt * (self.speed + nudge * 3.0) * self.direction;
        self.node.transform.rotation_euler = vec3(0.0, self.angle, 0.0);
    }
}

fn clamp(v: float, lo: float, hi: float) -> float {
    if v < lo { lo } else if v > hi { hi } else { v }
}
