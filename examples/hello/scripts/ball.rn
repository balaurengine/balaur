// A bouncing ball: sets up its own physics in init (Godot-style _ready), then
// watches its own fall from update.

pub fn init(this) {
    this.node.body3d.set(#{ kind: physics3d::BODY_DYNAMIC });
    this.node.collider3d.set(#{ kind: physics3d::SHAPE_BALL, radius: 0.5 });
    this.reported = false;
}

pub fn update(this, dt) {
    let y = this.node.transform.position.y;
    if y < 0.2 && !this.reported {
        this.reported = true;
        log::info(format!("ball touched down at t = {:.2}", engine::time()));
    }
}
