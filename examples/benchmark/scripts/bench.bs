// The runner: build a case's world, settle it, time it, report it. Every
// number comes out of `engine::timings()`, the profiler's own table, and
// `docs/BENCHMARKS.md` is the report `scripts/bench_compare.py` writes from it.

use cases2d;
use cases3d;
use cases_kinds;
use cases_scripts;
use load;
use nodes;
use stats;
use world;

const AFTER: str = "after";
const COOL: str = "cool";
const DONE: str = "done";
const IDLE: str = "idle";
const LINK: str = "link";
const LOAD: str = "load";
const NODES: str = "nodes";
const PHYSICS: str = "physics";
const PLACE: str = "place";
const PREP: str = "prep";
const SETTLE: str = "settle";
const SETUP: str = "setup";
const TIME: str = "time";
const WARM: str = "warm";
const WORK: str = "work";
const BUILD_MS: str = "build_ms";
const CASE: str = "case";
const DIMENSIONS: str = "dimensions";
const ENGINE_LABEL: str = "engine_label";
const EXTRA_METRICS: str = "extra_metrics";
const FRAME_MS: str = "frame_ms";
const INSTRUCTIONS: str = "instructions";
const KIND: str = "kind";
const LOOP_MS: str = "loop_ms";
const MIRROR_MS: str = "mirror_ms";
const P50_MS: str = "p50_ms";
const PHYSICS_MS: str = "physics_ms";
const PLATFORM: str = "platform";
const RENDER_CPU_MS: str = "render_cpu_ms";
const RENDER_GPU_MS: str = "render_gpu_ms";
const SCRIPT: str = "script";
const SCRIPT_MS: str = "script_ms";
const STEP_MS: str = "step_ms";
const STEPS_KEY: str = "steps";
const SYNC_MS: str = "sync_ms";
const UI_MS: str = "ui_ms";
const UPDATE: str = "update";
const UPDATE_MS: str = "update_ms";
const WALL_MS: str = "wall_ms";
const WARMUP_KEY: str = "warmup";

const STEPS: int = 300;
const WARMUP: int = 60;
const PLACE_PER_FRAME: int = 1500;
const FRAME_BUDGET_MS: float = 16.667;

/// A case as the catalogue holds it: the key a `--case` argument names, and
/// the seed its world is built from.
pub class Entry {
    pub key: str,
    pub case: load::Case,
    pub seed: int,
}

pub class Bench {
    node: Node,
    cases: [Entry],
    headless: bool,
    queue: [Entry],
    results: [any],
    /// `idle`, then `setup`, `place`, `link`, `after`, `warm`, `time` for a
    /// physics or load case, `prep`, `work`, `settle` for a node case, and
    /// `cool` between cases.
    state: str,
    entry: Entry?,
    world: world::World?,
    made: int,
    tick: int,
    repeat: int,
    /// Each measure's samples, a list of numbers under its name.
    samples: any,
    status: str,
    out: str,
    /// `--count` overrides what a load case declares, so one case answers at
    /// any size: it is how a capacity is found.
    count: int,
    shot: str,
    draw: bool,
    steps: int,
    warmup: int,
    started: float,
    build_ms: float,
}

impl Bench {
    fn init() {
        self.cases = catalogue();
        self.queue = [];
        self.results = [];
        self.state = IDLE;
        self.samples = {};
        self.status = "pick a case";
        self.draw = true;
        self.steps = STEPS;
        self.warmup = WARMUP;
        self.read_args();
        render::set_background(color(0.09, 0.10, 0.12, 1.0));
        frame_view(self.node, 3, []);
        self.show_menu();
    }

    /// `--case=3d/pyramid --steps=300 --warmup=60 --out=path`, or `--all`.
    /// A `--case` or `--all` means a headless run: no menu, no shapes, one
    /// BENCH line per case, then quit.
    fn read_args() {
        let wanted: [str] = [];
        for arg in engine::args() {
            let parts = arg.split("=");
            let key = parts[0];
            let value = if parts.len() > 1 { parts[1] } else { "" };
            if key == "--case" {
                wanted.push(value);
            } else if key == "--all" {
                for c in self.cases {
                    wanted.push(c.key);
                }
            } else if key == "--steps" {
                self.steps = number(value, STEPS);
            } else if key == "--warmup" {
                self.warmup = number(value, WARMUP);
            } else if key == "--count" {
                self.count = number(value, 0);
            } else if key == "--out" {
                self.out = value;
            } else if key == "--shot" {
                self.shot = value;
            } else if key == "--list" {
                for c in self.cases {
                    log::print("CASE {c.key}");
                }
                engine::quit();
                return;
            }
        }
        if wanted.len() == 0 {
            return;
        }
        self.headless = true;
        // Shapes are the viewer's, not the measurement's: off for a number,
        // on for a picture.
        self.draw = self.shot != "";
        for key in wanted {
            let found = self.find(key);
            if found != nil {
                self.queue.push(found.unwrap());
            } else {
                log::error("no such case '{key}'");
            }
        }
        self.start_next();
    }

    fn find(key: str) -> Entry? {
        for c in self.cases {
            if c.key == key {
                return c;
            }
        }
        nil
    }

    fn update(dt: float) {
        self.sample();
        let before = self.status;
        self.advance();
        if self.status != before {
            self.show_status();
        }
    }

    fn fixed_update(dt: float) {
        if self.state == WARM || self.state == TIME {
            self.tick += 1;
            let c = self.entry.unwrap().case;
            let step = c.step;
            step(self.world.unwrap(), c, self.tick);
        }
    }

    /// One entry per frame, read from the profiler's table for the frame
    /// before.
    fn sample() {
        if self.state != TIME && self.state != SETTLE {
            return;
        }
        let found = engine::timings();
        if found == nil {
            return;
        }
        let t = found.unwrap();
        let stages: any = t.stages;
        let spans = t.spans;
        let c = self.entry.unwrap().case;
        if self.state == SETTLE {
            // A node case is one loop, timed whole, in whichever stages its
            // work lands in.
            let total = 0.0;
            for name in c.stages {
                total += ms(stages[name]);
            }
            self.push(LOOP_MS, total);
            return;
        }
        if c.kind == LOAD {
            self.sample_load(t.frame, t.wall, stages, spans);
            return;
        }
        if t.fixed_steps < 1 {
            return;
        }
        let per = 1000.0 / (t.fixed_steps as float);
        let span = if c.dimensions == 2 { "physics2d/step" } else { "physics3d/step" };
        self.push(STEP_MS, secs(stages["fixed_update"]) * per);
        self.push(PHYSICS_MS, span_seconds(spans, span) * per);
        self.push(SCRIPT_MS, span_seconds(spans, "scripts/fixed_update") * per);
        self.push(FRAME_MS, t.frame * 1000.0);
    }

    /// One frame of a load case: the whole frame, and the four places its
    /// work lands. `scripts/update` is where a shape case spends itself, the
    /// mirror is where a kind case does, and the two render spans are what
    /// the GPU was asked for.
    fn sample_load(frame: float, wall: float, stages: any, spans: [engine::Span]) {
        self.push(FRAME_MS, frame * 1000.0);
        self.push(UPDATE_MS, ms(stages[UPDATE]));
        self.push(SYNC_MS, ms(stages["scene_sync"]));
        self.push(SCRIPT_MS, span_seconds(spans, "scripts/update") * 1000.0);
        self.push(MIRROR_MS, span_seconds(spans, "scene mirror") * 1000.0);
        self.push(UI_MS, span_seconds(spans, "ui") * 1000.0);
        self.push(RENDER_CPU_MS, span_seconds(spans, "render cpu") * 1000.0);
        self.push(RENDER_GPU_MS, span_seconds(spans, "render gpu") * 1000.0);
        self.push(WALL_MS, wall * 1000.0);
        // Statements run rather than milliseconds: the same frame runs the
        // same statements on every machine, so this is the half a baseline
        // can hold. Kept under the name the report has always used.
        let total = 0;
        for row in engine::script_costs() {
            total += row.instructions;
        }
        engine::set_script_profiling(true);
        self.push(INSTRUCTIONS, total as float);
    }

    fn push(key: str, value: float) {
        if self.samples.has(key) {
            self.samples[key].push(value);
        } else {
            self.samples[key] = [value];
        }
    }

    fn taken(key: str) -> int {
        if self.samples.has(key) { self.samples[key].len() } else { 0 }
    }

    /// The state machine: build, settle, measure, report, tear down.
    fn advance() {
        let state = self.state;
        if state == IDLE || state == DONE {
            return;
        }
        if state == COOL {
            physics::clear();
            self.state = IDLE;
            self.status = "ready";
            self.start_next();
            return;
        }
        let e = self.entry.unwrap();
        let c = e.case;
        if state == SETUP {
            if self.count > 0 && c.kind == LOAD {
                c.count = self.count;
            }
            random::seed(e.seed);
            tune(c);
            frame_view(self.node, c.dimensions, c.view);
            let w = world::new(self.node, c.dimensions, self.draw);
            self.world = w;
            self.started = engine::time();
            if c.kind == NODES {
                self.state = PREP;
                self.build_ms = 0.0;
            } else {
                if c.kind == LOAD {
                    engine::set_script_profiling(true);
                }
                let setup = c.setup;
                setup(w, c);
                self.state = PLACE;
            }
            return;
        }
        let w = self.world.unwrap();
        if state == PLACE {
            let next = if c.links > 0 { LINK } else { AFTER };
            self.chunk(c.place, c.count, next);
            return;
        }
        if state == LINK {
            self.chunk(c.link, c.links, AFTER);
            return;
        }
        if state == AFTER {
            let after = c.after;
            after(w, c);
            self.build_ms = (engine::time() - self.started) * 1000.0;
            self.tick = 0;
            self.state = WARM;
            self.status = "{e.key}: settling";
            return;
        }
        if state == WARM {
            let needed = if c.settle > self.warmup { c.settle } else { self.warmup };
            if self.tick >= needed {
                self.tick = 0;
                self.samples = {};
                self.state = TIME;
                self.status = "{e.key}: measuring";
                if self.shot != "" {
                    render::screenshot(self.shot);
                }
            }
            return;
        }
        if state == TIME {
            if self.taken(if c.kind == LOAD { FRAME_MS } else { STEP_MS }) >= self.steps {
                self.finish();
            }
            return;
        }
        // A node case runs on three frames so only the middle one holds the
        // work: the tree is rebuilt, the loop runs, the profiler is read.
        if state == PREP {
            release(w);
            let started = engine::time();
            let prepare = c.prepare;
            prepare(w, c);
            self.build_ms = (engine::time() - started) * 1000.0;
            self.state = WORK;
            return;
        }
        if state == WORK {
            let run = c.run;
            run(w, c);
            self.repeat += 1;
            self.status = "{e.key}: pass {self.repeat} of {c.repeats}";
            self.state = SETTLE;
            return;
        }
        if state == SETTLE {
            if self.taken(LOOP_MS) >= c.repeats {
                self.finish();
            } else {
                self.state = PREP;
            }
        }
    }

    /// `PLACE_PER_FRAME` at a time, so a ten thousand body build does not
    /// hold the editor or the browser for a second and a half.
    fn chunk(step: fn(world::World, load::Case, int), total: int, next: str) {
        let e = self.entry.unwrap();
        let w = self.world.unwrap();
        let end = self.made + PLACE_PER_FRAME;
        if end > total {
            end = total;
        }
        for i in self.made..end {
            step(w, e.case, i);
        }
        self.made = end;
        self.status = "{e.key}: building {self.made} of {total}";
        if self.made >= total {
            self.made = 0;
            self.state = next;
        }
    }

    fn finish() {
        let c = self.entry.unwrap().case;
        let w = self.world.unwrap();
        let result = if c.kind == NODES {
            self.node_result(c)
        } else if c.kind == LOAD {
            self.load_result(c, w)
        } else {
            self.physics_result(c, w)
        };
        self.results.push(result);
        let text = json::encode(result);
        log::print("BENCH {text}");
        if self.out != "" {
            fs::write(self.out, text);
        }
        world::tear_down(w);
        self.state = COOL;
        self.show_results();
    }

    fn physics_result(c: load::Case, w: world::World) -> any {
        let extra = c.extra;
        {
            CASE: c.name,
            DIMENSIONS: if c.dimensions == 2 { "2d" } else { "3d" },
            ENGINE_LABEL: "Balaur",
            STEPS_KEY: self.steps,
            WARMUP_KEY: self.warmup,
            "physics_ticks_per_second": 60,
            "body_count": w.bodies.len(),
            "static_count": w.statics,
            "joint_count": w.joints,
            "work_units": w.queries,
            EXTRA_METRICS: extra(w, c),
            "fingerprint": stats::fingerprint(w.bodies, c.dimensions),
            BUILD_MS: self.build_ms,
            STEP_MS: self.summary(STEP_MS),
            PHYSICS_MS: self.summary(PHYSICS_MS),
            SCRIPT_MS: self.summary(SCRIPT_MS),
            FRAME_MS: self.summary(FRAME_MS),
            PLATFORM: engine::target(),
        }
    }

    /// What a load case reports: how many there were, the frame they
    /// produced, and where that frame went.
    fn load_result(c: load::Case, w: world::World) -> any {
        let extra = c.extra;
        {
            CASE: c.name,
            DIMENSIONS: LOAD,
            ENGINE_LABEL: "Balaur",
            STEPS_KEY: self.steps,
            WARMUP_KEY: self.warmup,
            "count": c.count,
            SCRIPT: c.script,
            BUILD_MS: self.build_ms,
            FRAME_MS: self.summary(FRAME_MS),
            WALL_MS: self.summary(WALL_MS),
            UPDATE_MS: self.summary(UPDATE_MS),
            SYNC_MS: self.summary(SYNC_MS),
            SCRIPT_MS: self.summary(SCRIPT_MS),
            MIRROR_MS: self.summary(MIRROR_MS),
            UI_MS: self.summary(UI_MS),
            RENDER_CPU_MS: self.summary(RENDER_CPU_MS),
            RENDER_GPU_MS: self.summary(RENDER_GPU_MS),
            INSTRUCTIONS: self.summary(INSTRUCTIONS),
            EXTRA_METRICS: extra(w, c),
            PLATFORM: engine::target(),
        }
    }

    fn node_result(c: load::Case) -> any {
        {
            CASE: c.name,
            DIMENSIONS: NODES,
            ENGINE_LABEL: "Balaur",
            "iterations": c.iterations,
            "repeats": c.repeats,
            "stages": c.stages,
            BUILD_MS: self.build_ms,
            LOOP_MS: self.summary(LOOP_MS),
            PLATFORM: engine::target(),
        }
    }

    fn summary(key: str) -> any {
        let list: [float] = [];
        if self.samples.has(key) {
            for v in self.samples[key] {
                list.push(v.as_float());
            }
        }
        stats::summarize(list)
    }

    fn start_next() {
        self.repeat = 0;
        self.made = 0;
        self.samples = {};
        if self.queue.len() == 0 {
            if self.headless {
                engine::quit();
            }
            self.entry = nil;
            self.state = IDLE;
            self.show_status();
            return;
        }
        let e = self.queue.remove(0);
        self.entry = e;
        self.state = SETUP;
        self.status = "{e.key}: building";
        self.show_status();
    }

    /// The menu: every case in a list, a pick queueing it. A headless run
    /// has no one to pick, and frees it so its UI pass costs no case a
    /// frame.
    fn show_menu() {
        let menu = self.node.get_node("Menu");
        if !menu.is_valid() {
            return;
        }
        if self.headless {
            menu.queue_free();
            return;
        }
        let keys: [ui::Item] = [];
        for c in self.cases {
            keys.push(ui::Item { label: c.key });
        }
        menu.get_node("Cases").widget_rows.items = keys;
        self.show_status();
    }

    fn show_status() {
        let label = self.node.get_node("Menu/Status");
        if label.is_valid() {
            label.widget.text = self.status;
        }
    }

    fn show_results() {
        let label = self.node.get_node("Menu/Results");
        if !label.is_valid() {
            return;
        }
        let lines = "";
        for row in self.results {
            lines = if lines == "" { line_of(row) } else { "{lines}\n{line_of(row)}" };
        }
        label.widget.text = lines;
    }

    pub fn on_pick(key: any) {
        let found = self.find(key.as_str());
        if found == nil {
            return;
        }
        self.queue.push(found.unwrap());
        if self.state == IDLE {
            self.start_next();
        }
    }

    pub fn on_draw(on: any) {
        self.draw = on.as_bool();
    }
}

/// Every case, keyed the way a `--case` argument names one.
///
/// A case's seed is its place in this list, so every run of it builds the
/// same world; inserting a case ahead of another changes which world the
/// later one gets, never what it measures.
fn catalogue() -> [Entry] {
    let out: [Entry] = [];
    add(out, "3d", cases3d::all());
    add(out, "2d", cases2d::all());
    add(out, NODES, nodes::all());
    add(out, KIND, cases_kinds::all());
    add(out, SCRIPT, cases_scripts::all());
    out
}

fn add(out: [Entry], prefix: str, group: [load::Case]) {
    for c in group {
        out.push(Entry { key: "{prefix}/{c.name}", case: c, seed: 8191 + out.len() * 131 });
    }
}

fn number(text: str, otherwise: int) -> int {
    if text == "" { otherwise } else { text.parse_int() }
}

/// Seconds out of a stage or span lookup, zero where the name is absent.
fn secs(value: any) -> float {
    if value == nil { 0.0 } else { value.as_float() }
}

fn ms(value: any) -> float {
    secs(value) * 1000.0
}

/// One named span's seconds, zero where nothing measured it this frame.
fn span_seconds(spans: [engine::Span], name: str) -> float {
    for span in spans {
        if span.name == name {
            return span.seconds;
        }
    }
    0.0
}

/// Drop what the last pass built, in its own frame: a node case leaves a
/// tree of fifty thousand behind, and the next pass must not measure the
/// engine walking it.
fn release(w: world::World) {
    for node in w.made {
        node.queue_free();
    }
    w.made = [];
}

/// Where to stand to watch a case: its own `view` when it names one, an eye
/// and a target in 3D, a centre and a zoom in 2D, else a default that fits
/// most of them.
fn frame_view(bench: Node, dimensions: int, view: [float]) {
    if dimensions == 2 {
        let picked = if view.len() == 3 { view } else { [0.0, 0.0, 0.16] };
        let camera = bench.get_node("Camera2D");
        camera.transform.position = vec3(picked[0], picked[1], 0.0);
        camera.camera2d.pixels_per_unit = picked[2];
    } else {
        let picked = if view.len() == 6 { view } else { [0.0, 40.0, 110.0, 0.0, 10.0, 0.0] };
        let camera = bench.get_node("Camera3D");
        camera.transform.position = vec3(picked[0], picked[1], picked[2]);
        camera.transform.look_at(vec3(picked[3], picked[4], picked[5]));
    }
}

/// The solver settings the case is measured under. A 2D case is in pixels at
/// Godot's gravity, so `length_unit` is 100 as godot-rapier's 2D default is;
/// without it every tolerance in the solver is a hundred times too loose.
fn tune(c: load::Case) {
    if c.kind != PHYSICS {
        return;
    }
    physics::set_sleeping_allowed(false);
    if c.dimensions == 2 {
        physics::set_tuning(physics::TuningOptions { length_unit: 100.0 });
        physics2d::set_gravity(vec2(0.0, -980.0));
    } else {
        physics::set_tuning(physics::TuningOptions { length_unit: 1.0 });
        physics3d::set_gravity(vec3(0.0, -9.81, 0.0));
    }
}

/// One finished case as a line: the median tick, what rapier took inside it,
/// and its share of a 60 Hz frame.
fn line_of(row: any) -> str {
    let case = row[CASE].as_str();
    let dimensions = row[DIMENSIONS].as_str();
    if dimensions == NODES {
        let p50 = row[LOOP_MS][P50_MS].as_float();
        return "{case}  {fixed(p50, 1)} ms  over {row["iterations"].as_int()} iterations";
    }
    if dimensions == LOAD {
        let p50 = row[FRAME_MS][P50_MS].as_float();
        return "load/{case}  frame {fixed(p50, 2)} ms  of {row["count"].as_int()}";
    }
    let step = row["step_ms"][P50_MS].as_float();
    let rapier = row[PHYSICS_MS][P50_MS].as_float();
    let share = fixed(100.0 * step / FRAME_BUDGET_MS, 0);
    "{dimensions}/{case}  step {fixed(step, 2)} ms  rapier {fixed(rapier, 2)} ms  {share}% of a frame  fp {row["fingerprint"].as_str()}"
}

/// `x` with `places` decimals, rounded half away from zero.
fn fixed(x: float, places: int) -> str {
    let scale = 1;
    for k in 0..places {
        scale *= 10;
    }
    let n = math::round(math::abs(x) * (scale as float)) as int;
    let sign = if x < 0.0 && n != 0 { "-" } else { "" };
    if places == 0 {
        return "{sign}{n}";
    }
    let digits = "{n % scale}";
    while digits.len() < places {
        digits = "0{digits}";
    }
    "{sign}{n / scale}.{digits}"
}
