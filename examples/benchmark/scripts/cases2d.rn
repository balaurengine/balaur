// The six 2D cases, body for body the ones `bench2d/cases/*.gd` builds. Every
// y is the GDScript's negated: Godot's 2D plane points down and ours points
// up, which is a reflection and changes no distance or contact.

use crate::stats;
use crate::world;

const BOX = 20.0;

pub fn all() {
    [pyramid(), mixed_pile(), joint_grid(), smash(), query_storm(), drop()]
}

fn case(name, count, settle, parts) {
    let out = #{
        name: name, dimensions: 2, count: count, settle: settle, links: 0,
        setup: |w| {}, place: |w, i| {}, link: |w, i| {}, after: |w| {},
        step: |w, tick| {}, extra: |w| #{},
    };
    for (key, value) in parts {
        out.insert(key, value);
    }
    out
}

/// Solver throughput on one large, well-conditioned stack: 10,000 boxes
/// placed exactly touching, so the solver starts from resting contact rather
/// than from a settling drop.
const PYRAMID_COUNT = 10000;

fn pyramid() {
    let spots = pyramid_spots();
    let base = pyramid_base();
    case("pyramid", spots.len(), 0, [
        ("view", [[0.0, 1450.0], 0.32]),
        ("setup", |w| { world::fixed(w, [0.0, -20.0], rect((base as f64) * BOX * 2.0, 40.0)); }),
        ("place", |w, i| { world::body(w, spots[i], rect(BOX, BOX)); }),
    ])
}

fn pyramid_base() {
    math::ceil((math::sqrt(8.0 * (PYRAMID_COUNT as f64) + 1.0) - 1.0) * 0.5) as i64
}

fn pyramid_spots() {
    let base = pyramid_base();
    let out = [];
    let level = 0;
    while out.len() < PYRAMID_COUNT {
        let width = base - level;
        let left = PYRAMID_COUNT - out.len();
        if width > left {
            width = left;
        }
        let x = -0.5 * ((width - 1) as f64) * BOX;
        for i in 0..width {
            out.push([x + (i as f64) * BOX, BOX * (0.5 + (level as f64))]);
        }
        level = level + 1;
    }
    out
}

/// Narrow-phase breadth: 5,000 bodies across every shape pair the engines
/// share, a real convex polygon included, which defeats box and circle fast
/// paths.
const HALF = 1400.0;

fn mixed_pile() {
    case("mixed_pile", 5000, 90, [
        ("view", [[0.0, -500.0], 0.5]),
        ("setup", |w| {
            world::fixed(w, [0.0, -960.0], rect(HALF * 2.0, 40.0));
            world::fixed(w, [-HALF, 0.0], rect(40.0, 3000.0));
            world::fixed(w, [HALF, 0.0], rect(40.0, 3000.0));
        }),
        ("place", |w, i| {
            let at = world::lattice_2d(i, [30.0, 30.0], 88, [-1305.0, 930.0], 0.05);
            let node = world::body(w, [at[0], -at[1]], pile_shape(i % 4));
            node.set_rotation_euler(0.0, 0.0, rng::range(-3.14159, 3.14159));
        }),
    ])
}

fn pile_shape(kind) {
    if kind == 0 {
        rect(rng::range(14.0, 26.0), rng::range(14.0, 26.0))
    } else if kind == 1 {
        #{ kind: "circle", radius: rng::range(7.0, 13.0) }
    } else if kind == 2 {
        #{ kind: "capsule", radius: rng::range(6.0, 10.0), height: rng::range(22.0, 34.0) }
    } else {
        // A fixed pentagon rather than a sized one: a hull comes from a mesh
        // asset, and the collider has no scale to vary it with.
        #{ kind: "convex_hull", mesh: "#pentagon" }
    }
}

/// A 100x50 lattice pinned to its right and lower neighbours — 5,000 bodies
/// and about 9,950 joints — hung from a static anchor. The contact solver
/// barely runs, and the lattice has cycles.
const COLS = 100;
const ROWS = 50;
const PITCH = 24.0;

fn joint_grid() {
    case("joint_grid", COLS * ROWS, 0, [
        ("view", [[0.0, -580.0], 0.6]),
        ("links", COLS * ROWS),
        ("setup", |w| {
            w.anchor = world::fixed(w, anchor_at(), rect((COLS as f64) * PITCH + 80.0, 16.0));
        }),
        ("place", |w, i| { world::body(w, lattice_at(i), #{ kind: "circle", radius: 5.0 }); }),
        ("link", |w, i| {
            let col = i % COLS;
            let row = i / COLS;
            if col + 1 < COLS {
                world::pin(w, w.bodies[i], w.bodies[i + 1], lattice_at(i), lattice_at(i + 1));
            }
            if row + 1 < ROWS {
                world::pin(w, w.bodies[i], w.bodies[i + COLS], lattice_at(i), lattice_at(i + COLS));
            }
            if row == 0 {
                world::pin(w, w.bodies[i], w.anchor, lattice_at(i), anchor_at());
            }
        }),
        ("extra", |w| {
            let worst = 0.0;
            for (i, body) in w.bodies.iter().enumerate() {
                let p = body.position();
                let moved = world::distance([p.x, p.y, 0.0], lattice_at(i));
                if moved > worst {
                    worst = moved;
                }
            }
            #{ displacement_max: worst }
        }),
    ])
}

/// The anchor bar's own origin: a joint anchor is an offset in the other
/// body's space, not a point above the body being pinned.
fn anchor_at() {
    [0.0, PITCH, 0.0]
}

fn lattice_at(i) {
    let origin = -0.5 * ((COLS - 1) as f64) * PITCH;
    [origin + ((i % COLS) as f64) * PITCH, -((i / COLS) as f64) * PITCH, 0.0]
}

/// A heavy fast projectile into a 100x50 wall of 5,000 boxes placed exactly
/// touching, and the shock front that follows.
const SMASH_COLUMNS = 100;
const SMASH_ROWS = 50;

fn smash() {
    case("smash", SMASH_COLUMNS * SMASH_ROWS, 90, [
        ("view", [[0.0, 500.0], 0.5]),
        ("setup", |w| { world::fixed(w, [0.0, -20.0], rect(8000.0, 40.0)); }),
        ("place", |w, i| { world::body(w, smash_at(i), rect(BOX, BOX)); }),
        ("after", |w| {
            let ox = -0.5 * ((SMASH_COLUMNS - 1) as f64) * BOX;
            let shot = world::body(w, [ox - 900.0, (SMASH_ROWS as f64) * BOX * 0.5],
                #{ kind: "circle", radius: 40.0 });
            shot.patch_component("body2d", #{ mass: 800.0, gravity_scale: 0.0, ccd: true });
            physics2d::set_linear_velocity(shot, 4000.0, 0.0);
        }),
        ("extra", |w| { spread(w) }),
    ])
}

fn smash_at(i) {
    let ox = -0.5 * ((SMASH_COLUMNS - 1) as f64) * BOX;
    [ox + ((i / SMASH_ROWS) as f64) * BOX, BOX * (0.5 + ((i % SMASH_ROWS) as f64))]
}

fn spread(w) {
    let centre = [0.0, 0.0];
    let counted = 0;
    for body in w.bodies {
        let p = body.position();
        if stats::finite(p.x) && stats::finite(p.y) {
            centre = [centre[0] + p.x, centre[1] + p.y];
            counted = counted + 1;
        }
    }
    if counted > 0 {
        centre = [centre[0] / (counted as f64), centre[1] / (counted as f64)];
    }
    let worst = 0.0;
    let non_finite = 0;
    for body in w.bodies {
        let p = body.position();
        if stats::finite(p.x) && stats::finite(p.y) {
            let far = world::distance([p.x, p.y, 0.0], [centre[0], centre[1], 0.0]);
            if far > worst {
                worst = far;
            }
        } else {
            non_finite = non_finite + 1;
        }
    }
    #{ spread: worst, non_finite: non_finite }
}

/// Queries against a populated broad phase: 8,000 static and 2,000 moving
/// bodies, hit every tick with a sweeping mix of rays, shape casts and point
/// queries.
const STATICS = 8000;
const MOVERS = 2000;
const FIELD = 3000.0;
const RAYS = 600;
const CASTS = 120;
const POINTS = 180;

fn query_storm() {
    case("query_storm", STATICS + MOVERS, 0, [
        ("view", [[0.0, 0.0], 0.25]),
        ("place", |w, i| {
            if i < STATICS {
                let node = world::fixed(w, scatter(),
                    rect(rng::range(20.0, 60.0), rng::range(20.0, 60.0)));
                node.set_rotation_euler(0.0, 0.0, rng::range(-3.14159, 3.14159));
            } else {
                let node = world::body(w, scatter(), #{ kind: "circle", radius: rng::range(10.0, 24.0) });
                node.patch_component("body2d", #{ gravity_scale: 0.0 });
                physics2d::set_linear_velocity(node, rng::range(-60.0, 60.0), rng::range(-60.0, 60.0));
            }
        }),
        ("step", |w, tick| { storm(w, tick); }),
        ("extra", |w| { #{ queries: w.queries, hits: w.hits } }),
    ])
}

fn scatter() {
    [rng::range(-FIELD, FIELD), rng::range(-FIELD, FIELD)]
}

fn storm(w, tick) {
    let phase = (tick as f64) * 0.017;
    for i in 0..RAYS {
        let a = phase + 6.28318 * (i as f64) / (RAYS as f64);
        let from = [math::cos(a) * FIELD, math::sin(a) * FIELD];
        let hit = physics2d::raycast(#{
            from: from, dir: [-from[0], -from[1]], max: FIELD * 2.5,
        });
        count(w, !(hit is Tuple));
    }
    for i in 0..CASTS {
        let a = phase * 1.7 + 6.28318 * (i as f64) / (CASTS as f64);
        let from = [math::cos(a) * FIELD, math::sin(a) * FIELD];
        let hit = physics2d::shapecast(#{
            shape: #{ kind: "circle", radius: 24.0 },
            from: from, dir: [-from[0], -from[1]], max: 2.0,
        });
        count(w, !(hit is Tuple));
    }
    for i in 0..POINTS {
        let a = phase * 2.3 + 6.28318 * (i as f64) / (POINTS as f64);
        let hits = physics2d::point_hits(#{
            point: [math::cos(a) * FIELD * 0.6, math::sin(a) * FIELD * 0.6],
        });
        count(w, !hits.is_empty());
    }
}

fn count(w, hit) {
    w.queries = w.queries + 1;
    if hit {
        w.hits = w.hits + 1;
    }
}

/// 8,000 boxes dropped into a walled pit: an active, contact-heavy pile
/// rather than a settled one.
const DROP_COLS = 120;
const GAP = 22.0;

fn drop() {
    case("drop", 8000, 0, [
        ("view", [[0.0, 750.0], 0.5]),
        ("setup", |w| {
            let half = 0.5 * (DROP_COLS as f64) * GAP;
            world::fixed(w, [0.0, -20.0], rect((DROP_COLS as f64) * GAP + 80.0, 40.0));
            world::fixed(w, [-half - 20.0, 600.0], rect(40.0, 1400.0));
            world::fixed(w, [half + 20.0, 600.0], rect(40.0, 1400.0));
        }),
        ("place", |w, i| { world::body(w, drop_at(i), rect(BOX, BOX)); }),
    ])
}

fn drop_at(i) {
    let origin = -0.5 * ((DROP_COLS - 1) as f64) * GAP;
    [
        origin + ((i % DROP_COLS) as f64) * GAP,
        40.0 + ((i / DROP_COLS) as f64) * GAP,
    ]
}

/// Godot's `rect` takes a whole size; a `collider2d` takes half-extents.
fn rect(w, h) {
    #{ kind: "rect", half_extents: [w * 0.5, h * 0.5] }
}
