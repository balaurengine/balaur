// One case per core component, N of them on screen at once. Each reports
// where its frame went, so a kind says on its own whether it costs a mirror,
// a UI pass or fill. Adding one is a single entry in `all`.

use crate::load;
use crate::world;

/// How many of each kind. One number across the catalogue, so two kinds are
/// read against each other rather than against their own counts.
const COUNT = 5000;

/// A 3D case builds fewer: a mesh is drawn with a shadow and lit, and 5,000
/// of them is a minute of settling on a laptop rather than a measurement.
const COUNT_3D = 2000;

const PITCH = 6.0;
const PITCH_3D = 2.5;

pub fn all() {
    [
        // 2D: what a sprite game is made of.
        kind("shape2d", COUNT, 2, "shape2d", #{ kind: "circle", radius: 1.5 }),
        kind("shape2d_rect", COUNT, 2, "shape2d", #{ kind: "rectangle", size: [3.0, 3.0] }),
        kind("polygon", COUNT, 2, "polygon", #{
            points: [[-1.5, -1.5], [1.5, -1.5], [1.5, 1.5], [-1.5, 1.5]],
        }),
        kind("text2d", 1000, 2, "text2d", #{ text: "balaur", pixels_per_unit: 32.0 }),
        kind("light2d", 200, 2, "light2d", #{ kind: "point", range: 12.0 }),
        kind("particles2d", 200, 2, "particles", #{ rate: 20.0, lifetime: 1.0, speed: 4.0 }),
        // 3D: the same question for meshes and lights.
        kind("shape3d", COUNT_3D, 3, "shape3d", #{ kind: "sphere", radius: 0.6 }),
        kind("shape3d_cuboid", COUNT_3D, 3, "shape3d", #{ kind: "box", size: [1.0, 1.0, 1.0] }),
        kind("text3d", 500, 3, "text3d", #{ text: "balaur", pixels_per_unit: 64.0 }),
        kind("light3d", 200, 3, "light3d", #{ kind: "point", range: 8.0, shadow_enabled: false }),
        kind("light3d_shadow", 40, 3, "light3d", #{ kind: "point", range: 8.0, shadow_enabled: true }),
        // Neither: the node itself, and what a component with no drawing costs.
        bare(),
        kind("timer", COUNT, 2, "timer", #{ wait_time: 1.0, running: true }),
        kind("collider2d", COUNT, 2, "collider2d", #{ kind: "circle", radius: 1.0 }),
        kind("body2d", COUNT, 2, "body2d", #{ kind: "dynamic" }),
        widgets(),
    ]
}

/// One node, one component, N times.
fn kind(name, count, dimensions, component, params) {
    let pitch = if dimensions == 2 { PITCH } else { PITCH_3D };
    load::case(name, [
        ("count", count),
        ("dimensions", dimensions),
        ("make", |w, i| { load::with(w, i, pitch, component, params); }),
    ])
}

/// The node with nothing on it: what the tree, the transform and the mirror
/// cost before any component is asked for.
fn bare() {
    load::case("node", [
        ("count", COUNT),
        ("make", |w, i| { world::plain(w, i); }),
    ])
}

/// A widget is placed in design pixels rather than in the world, and the UI
/// pass draws it: its own path from end to end.
fn widgets() {
    load::case("widget", [
        ("count", 2000),
        ("make", |w, i| {
            let node = world::plain(w, i);
            let at = world::grid(i, 20000, 24.0);
            node.set_component("widget", #{
                kind: "label", text: "balaur", anchor: "top_left",
                x: 8.0 + at[0], y: 8.0 + at[1],
            });
        }),
    ])
}
