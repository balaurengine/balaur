// The six 2D cases, body for body the ones `bench2d/cases/*.gd` builds. Every
// y is the GDScript's negated: Godot's 2D plane points down and ours points
// up, which is a reflection and changes no distance or contact.

use load;
use stats;
use world;

const BOX: float = 20.0;

pub fn all() -> [load::Case] {
    [pyramid(), mixed_pile(), joint_grid(), smash(), query_storm(), drop()]
}

fn case(name: str, count: int, settle: int, view: [float]) -> load::Case {
    let c = load::blank(name, "physics");
    c.dimensions = 2;
    c.count = count;
    c.settle = settle;
    c.view = view;
    c
}

/// Solver throughput on one large, well-conditioned stack: 10,000 boxes
/// placed exactly touching, so the solver starts from resting contact rather
/// than from a settling drop.
const PYRAMID_COUNT: int = 10000;

fn pyramid() -> load::Case {
    let spots = pyramid_spots();
    let c = case("pyramid", spots.len(), 0, [0.0, 1450.0, 0.32]);
    c.spots = spots;
    c.setup = pyramid_ground;
    c.place = box_at_spot;
    c
}

fn pyramid_ground(w: world::World, c: load::Case) {
    world::fixed(w, [0.0, -20.0, 0.0], rect((pyramid_base() as float) * BOX * 2.0, 40.0));
}

fn box_at_spot(w: world::World, c: load::Case, i: int) {
    world::body(w, c.spots[i], rect(BOX, BOX));
}

fn pyramid_base() -> int {
    math::ceil((math::sqrt(8.0 * (PYRAMID_COUNT as float) + 1.0) - 1.0) * 0.5) as int
}

fn pyramid_spots() -> [Vec3] {
    let base = pyramid_base();
    let out: [Vec3] = [];
    let level = 0;
    while out.len() < PYRAMID_COUNT {
        let width = base - level;
        let left = PYRAMID_COUNT - out.len();
        if width > left {
            width = left;
        }
        let x = -0.5 * ((width - 1) as float) * BOX;
        for i in 0..width {
            out.push([x + (i as float) * BOX, BOX * (0.5 + (level as float)), 0.0]);
        }
        level += 1;
    }
    out
}

/// Narrow-phase breadth: 5,000 bodies across every shape pair the engines
/// share, a real convex polygon included, which defeats box and circle fast
/// paths.
const HALF: float = 1400.0;

fn mixed_pile() -> load::Case {
    let c = case("mixed_pile", 5000, 90, [0.0, -500.0, 0.5]);
    c.setup = pile_walls;
    c.place = pile_body;
    c
}

fn pile_walls(w: world::World, c: load::Case) {
    world::fixed(w, [0.0, -960.0, 0.0], rect(HALF * 2.0, 40.0));
    world::fixed(w, [-HALF, 0.0, 0.0], rect(40.0, 3000.0));
    world::fixed(w, [HALF, 0.0, 0.0], rect(40.0, 3000.0));
}

fn pile_body(w: world::World, c: load::Case, i: int) {
    let at = world::lattice_2d(i, [30.0, 30.0], 88, [-1305.0, 930.0], 0.05);
    let node = world::body(w, [at.x, -at.y, 0.0], pile_shape(i % 4));
    node.transform.rotation_euler = [0.0, 0.0, random::range(-3.14159, 3.14159)];
}

fn pile_shape(kind: int) -> any {
    if kind == 0 {
        rect(random::range(14.0, 26.0), random::range(14.0, 26.0))
    } else if kind == 1 {
        map().with("kind", "circle").with("radius", random::range(7.0, 13.0))
    } else if kind == 2 {
        let radius = random::range(6.0, 10.0);
        map()
            .with("kind", "capsule")
            .with("radius", radius)
            .with("height", random::range(22.0, 34.0) + 2.0 * radius)
    } else {
        // A fixed pentagon rather than a sized one: a hull comes from a mesh
        // asset, and the collider has no scale to vary it with.
        map().with("kind", "convex_hull").with("mesh", "#pentagon")
    }
}

/// A 100x50 lattice pinned to its right and lower neighbours (5,000 bodies
/// and about 9,950 joints) hung from a static anchor. The contact solver
/// barely runs, and the lattice has cycles.
const COLS: int = 100;
const ROWS: int = 50;
const PITCH: float = 24.0;

fn joint_grid() -> load::Case {
    let c = case("joint_grid", COLS * ROWS, 0, [0.0, -580.0, 0.6]);
    c.links = COLS * ROWS;
    c.setup = grid_anchor;
    c.place = grid_body;
    c.link = grid_link;
    c.extra = grid_extra;
    c
}

fn grid_anchor(w: world::World, c: load::Case) {
    w.anchor = world::fixed(w, anchor_at(), rect((COLS as float) * PITCH + 80.0, 16.0));
}

fn grid_body(w: world::World, c: load::Case, i: int) {
    world::body(w, lattice_at(i), map().with("kind", "circle").with("radius", 5.0));
}

fn grid_link(w: world::World, c: load::Case, i: int) {
    let col = i % COLS;
    let row = i / COLS;
    if col + 1 < COLS {
        world::pin(w, w.bodies[i], w.bodies[i + 1], lattice_at(i), lattice_at(i + 1));
    }
    if row + 1 < ROWS {
        world::pin(w, w.bodies[i], w.bodies[i + COLS], lattice_at(i), lattice_at(i + COLS));
    }
    if row == 0 {
        world::pin(w, w.bodies[i], w.anchor, lattice_at(i), anchor_at());
    }
}

fn grid_extra(w: world::World, c: load::Case) -> any {
    let worst = 0.0;
    for i in 0..w.bodies.len() {
        let p = w.bodies[i].transform.position;
        let moved = world::distance([p.x, p.y, 0.0], lattice_at(i));
        if moved > worst {
            worst = moved;
        }
    }
    map().with("displacement_max", worst)
}

/// The anchor bar's own origin: a joint anchor is an offset in the other
/// body's space, not a point above the body being pinned.
fn anchor_at() -> Vec3 {
    [0.0, PITCH, 0.0]
}

fn lattice_at(i: int) -> Vec3 {
    let origin = -0.5 * ((COLS - 1) as float) * PITCH;
    [origin + ((i % COLS) as float) * PITCH, -((i / COLS) as float) * PITCH, 0.0]
}

/// A heavy fast projectile into a 100x50 wall of 5,000 boxes placed exactly
/// touching, and the shock front that follows.
const SMASH_COLUMNS: int = 100;
const SMASH_ROWS: int = 50;

fn smash() -> load::Case {
    let c = case("smash", SMASH_COLUMNS * SMASH_ROWS, 90, [0.0, 500.0, 0.5]);
    c.setup = smash_ground;
    c.place = smash_body;
    c.after = smash_shot;
    c.extra = spread;
    c
}

fn smash_ground(w: world::World, c: load::Case) {
    world::fixed(w, [0.0, -20.0, 0.0], rect(8000.0, 40.0));
}

fn smash_body(w: world::World, c: load::Case, i: int) {
    world::body(w, smash_at(i), rect(BOX, BOX));
}

fn smash_shot(w: world::World, c: load::Case) {
    let ox = -0.5 * ((SMASH_COLUMNS - 1) as float) * BOX;
    let shot = world::body(w, [ox - 900.0, (SMASH_ROWS as float) * BOX * 0.5, 0.0],
        map().with("kind", "circle").with("radius", 40.0));
    shot.patch_component("body2d", map()
        .with("mass", 800.0)
        .with("gravity_scale", 0.0)
        .with("continuous_collision", true));
    shot.body2d.set_linear_velocity(4000.0, 0.0);
}

fn smash_at(i: int) -> Vec3 {
    let ox = -0.5 * ((SMASH_COLUMNS - 1) as float) * BOX;
    [ox + ((i / SMASH_ROWS) as float) * BOX, BOX * (0.5 + ((i % SMASH_ROWS) as float)), 0.0]
}

fn spread(w: world::World, c: load::Case) -> any {
    let cx = 0.0;
    let cy = 0.0;
    let counted = 0;
    for body in w.bodies {
        let p = body.transform.position;
        if stats::finite(p.x) && stats::finite(p.y) {
            cx += p.x;
            cy += p.y;
            counted += 1;
        }
    }
    if counted > 0 {
        cx = cx / (counted as float);
        cy = cy / (counted as float);
    }
    let worst = 0.0;
    let non_finite = 0;
    for body in w.bodies {
        let p = body.transform.position;
        if stats::finite(p.x) && stats::finite(p.y) {
            let far = world::distance([p.x, p.y, 0.0], [cx, cy, 0.0]);
            if far > worst {
                worst = far;
            }
        } else {
            non_finite += 1;
        }
    }
    map().with("spread", worst).with("non_finite", non_finite)
}

/// Queries against a populated broad phase: 8,000 static and 2,000 moving
/// bodies, hit every tick with a sweeping mix of rays, shape casts and point
/// queries.
const STATICS: int = 8000;
const MOVERS: int = 2000;
const FIELD: float = 3000.0;
const RAYS: int = 600;
const CASTS: int = 120;
const POINTS: int = 180;

fn query_storm() -> load::Case {
    let c = case("query_storm", STATICS + MOVERS, 0, [0.0, 0.0, 0.25]);
    c.place = storm_body;
    c.step = storm;
    c.extra = storm_extra;
    c
}

fn storm_body(w: world::World, c: load::Case, i: int) {
    if i < STATICS {
        let node = world::fixed(w, scatter(),
            rect(random::range(20.0, 60.0), random::range(20.0, 60.0)));
        node.transform.rotation_euler = [0.0, 0.0, random::range(-3.14159, 3.14159)];
    } else {
        let node = world::body(w, scatter(), map().with("kind", "circle").with("radius", random::range(10.0, 24.0)));
        node.patch_component("body2d", map().with("gravity_scale", 0.0));
        node.body2d.set_linear_velocity(random::range(-60.0, 60.0), random::range(-60.0, 60.0));
    }
}

fn storm_extra(w: world::World, c: load::Case) -> any {
    map().with("queries", w.queries).with("hits", w.hits)
}

fn scatter() -> Vec3 {
    [random::range(-FIELD, FIELD), random::range(-FIELD, FIELD), 0.0]
}

fn storm(w: world::World, c: load::Case, tick: int) {
    let phase = (tick as float) * 0.017;
    for i in 0..RAYS {
        let a = phase + 6.28318 * (i as float) / (RAYS as float);
        let x = math::cos(a) * FIELD;
        let y = math::sin(a) * FIELD;
        let hit = physics2d::raycast(map()
            .with("from", [x, y])
            .with("dir", [-x, -y])
            .with("max", FIELD * 2.5));
        count(w, !hit.is_nil());
    }
    for i in 0..CASTS {
        let a = phase * 1.7 + 6.28318 * (i as float) / (CASTS as float);
        let x = math::cos(a) * FIELD;
        let y = math::sin(a) * FIELD;
        let hit = physics2d::shapecast(map()
            .with("shape", map().with("kind", "circle").with("radius", 24.0))
            .with("from", [x, y])
            .with("dir", [-x, -y])
            .with("max", 2.0));
        count(w, !hit.is_nil());
    }
    for i in 0..POINTS {
        let a = phase * 2.3 + 6.28318 * (i as float) / (POINTS as float);
        let hits = physics2d::overlap_point(map()
            .with("point", [math::cos(a) * FIELD * 0.6, math::sin(a) * FIELD * 0.6]));
        count(w, hits.len() > 0);
    }
}

fn count(w: world::World, hit: bool) {
    w.queries += 1;
    if hit {
        w.hits += 1;
    }
}

/// 8,000 boxes dropped into a walled pit: an active, contact-heavy pile
/// rather than a settled one.
const DROP_COLS: int = 120;
const GAP: float = 22.0;

fn drop() -> load::Case {
    let c = case("drop", 8000, 0, [0.0, 750.0, 0.5]);
    c.setup = pit;
    c.place = drop_body;
    c
}

fn pit(w: world::World, c: load::Case) {
    let half = 0.5 * (DROP_COLS as float) * GAP;
    world::fixed(w, [0.0, -20.0, 0.0], rect((DROP_COLS as float) * GAP + 80.0, 40.0));
    world::fixed(w, [-half - 20.0, 600.0, 0.0], rect(40.0, 1400.0));
    world::fixed(w, [half + 20.0, 600.0, 0.0], rect(40.0, 1400.0));
}

fn drop_body(w: world::World, c: load::Case, i: int) {
    let origin = -0.5 * ((DROP_COLS - 1) as float) * GAP;
    let at: Vec3 = [origin + ((i % DROP_COLS) as float) * GAP, 40.0 + ((i / DROP_COLS) as float) * GAP, 0.0];
    world::body(w, at, rect(BOX, BOX));
}

fn rect(w: float, h: float) -> any {
    map().with("kind", "rectangle").with("size", [w, h])
}
