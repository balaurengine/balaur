// The six 3D cases, body for body the ones `bench3d/cases/*.gd` builds in
// github.com/Ughuuu/benchmarks-repo. A case is a `setup`, a `place` per body,
// an optional `link` pass, an `after`, a `step` per tick and its `extra`.

use load;
use stats;
use world;

const BOX: float = 1.0;
const PYRAMID_LEVELS: int = 22;

pub fn all() -> [load::Case] {
    [pyramid(), mixed_pile(), joint_grid(), smash(), query_storm(), drop()]
}

fn case(name: str, count: int, settle: int, view: [float]) -> load::Case {
    let c = load::blank(name, "physics");
    c.dimensions = 3;
    c.count = count;
    c.settle = settle;
    c.view = view;
    c
}

/// Solver throughput on one large, well-conditioned stack: 3,795 boxes in a
/// 22-level stepped pyramid, placed exactly touching so the solver starts
/// from resting contact. Box against box only, the pair every engine
/// special-cases.
fn pyramid() -> load::Case {
    let spots = pyramid_spots();
    let c = case("pyramid", spots.len(), 0, [0.0, 22.0, 52.0, 0.0, 9.0, 0.0]);
    c.spots = spots;
    c.setup = ground;
    c.place = box_at_spot;
    c
}

fn ground(w: world::World, c: load::Case) {
    world::fixed(w, [0.0, -0.5, 0.0], box3(200.0, 0.5, 200.0));
}

fn box_at_spot(w: world::World, c: load::Case, i: int) {
    world::body(w, c.spots[i], box3(0.5, 0.5, 0.5));
}

fn pyramid_spots() -> [Vec3] {
    let out: [Vec3] = [];
    for level in 0..PYRAMID_LEVELS {
        let side = PYRAMID_LEVELS - level;
        let y = BOX * (0.5 + (level as float));
        let origin = -0.5 * ((side - 1) as float) * BOX;
        for ix in 0..side {
            for iz in 0..side {
                out.push([origin + (ix as float) * BOX, y, origin + (iz as float) * BOX]);
            }
        }
    }
    out
}

/// Narrow-phase breadth: 5,000 bodies across boxes, spheres, capsules and a
/// convex hull that defeats shape-specific fast paths.
fn mixed_pile() -> load::Case {
    let c = case("mixed_pile", 5000, 90, [0.0, 26.0, 52.0, 0.0, 5.0, 0.0]);
    c.setup = bin;
    c.place = pile_body;
    c
}

fn pile_body(w: world::World, c: load::Case, i: int) {
    let at = world::lattice(i, [1.0, 1.0, 1.0], 28, 28, [-13.5, 0.6, -13.5], 0.05);
    let node = world::body(w, at, pile_shape(i % 4));
    node.transform.rotation_euler = [
        random::range(-3.14159, 3.14159),
        random::range(-3.14159, 3.14159),
        random::range(-3.14159, 3.14159),
    ];
}

fn pile_shape(kind: int) -> any {
    if kind == 0 {
        box3(random::range(0.25, 0.45), random::range(0.25, 0.45), random::range(0.25, 0.45))
    } else if kind == 1 {
        map().with("kind", "sphere").with("radius", random::range(0.25, 0.45))
    } else if kind == 2 {
        let radius = random::range(0.2, 0.32);
        map()
            .with("kind", "capsule")
            .with("radius", radius)
            .with("height", random::range(0.9, 1.4) + 2.0 * radius)
    } else {
        // One size rather than a random one: a hull is built from a mesh
        // asset, and the collider has no scale to vary it with.
        map().with("kind", "convex_hull").with("mesh", "#octahedron")
    }
}

const BIN_HALF: float = 16.0;
const BIN_HEIGHT: float = 60.0;

fn bin(w: world::World, c: load::Case) {
    world::fixed(w, [0.0, -0.5, 0.0], box3(BIN_HALF, 0.5, BIN_HALF));
    for s in [-1.0, 1.0] {
        world::wall(w, [s * BIN_HALF, BIN_HEIGHT * 0.5, 0.0], box3(0.5, BIN_HEIGHT * 0.5, BIN_HALF));
        world::wall(w, [0.0, BIN_HEIGHT * 0.5, s * BIN_HALF], box3(BIN_HALF, BIN_HEIGHT * 0.5, 0.5));
    }
}

/// A 100x50 lattice pinned to its right and lower neighbours (5,000 bodies
/// and about 9,950 joints) hung from a static anchor. Constraint-driven
/// rather than contact-driven, and the lattice has cycles, so a solver
/// leaning on tree-shaped island ordering cannot shortcut it.
const COLS: int = 100;
const ROWS: int = 50;
const PITCH: float = 1.2;

fn joint_grid() -> load::Case {
    let c = case("joint_grid", COLS * ROWS, 0, [0.0, 32.0, 150.0, 0.0, 32.0, 0.0]);
    c.links = COLS * ROWS;
    c.setup = grid_anchor;
    c.place = grid_body;
    c.link = grid_link;
    c.extra = grid_extra;
    c
}

fn grid_anchor(w: world::World, c: load::Case) {
    w.anchor = world::fixed(w, anchor_at(), box3(0.5 * ((COLS as float) * PITCH + 4.0), 0.25, 0.5));
}

fn grid_body(w: world::World, c: load::Case, i: int) {
    world::body(w, lattice_at(i), map().with("kind", "sphere").with("radius", 0.25));
}

fn grid_link(w: world::World, c: load::Case, i: int) {
    let col = i % COLS;
    let row = i / COLS;
    if col + 1 < COLS {
        world::pin(w, w.bodies[i], w.bodies[i + 1], lattice_at(i), lattice_at(i + 1));
    }
    if row + 1 < ROWS {
        world::pin(w, w.bodies[i], w.bodies[i + COLS], lattice_at(i), lattice_at(i + COLS));
    }
    if row == 0 {
        world::pin(w, w.bodies[i], w.anchor, lattice_at(i), anchor_at());
    }
}

/// The silent failure this guards: joints that never resolved leave 5,000
/// bodies free-falling, which is fast and meaningless.
fn grid_extra(w: world::World, c: load::Case) -> any {
    let worst = 0.0;
    for i in 0..w.bodies.len() {
        let moved = world::distance(w.bodies[i].transform.position, lattice_at(i));
        if moved > worst {
            worst = moved;
        }
    }
    map().with("displacement_max", worst)
}

/// Where the anchor bar stands. A joint anchor is an offset in the other
/// body's own space, so this has to be the bar's real origin, not the point
/// on it above the body being pinned.
fn anchor_at() -> Vec3 {
    [0.0, (ROWS as float) * PITCH + PITCH, 0.0]
}

fn lattice_at(i: int) -> Vec3 {
    let origin = -0.5 * ((COLS - 1) as float) * PITCH;
    [origin + ((i % COLS) as float) * PITCH, ((ROWS - i / COLS) as float) * PITCH, 0.0]
}

/// A heavy fast projectile into a 25x25x8 wall of 5,000 boxes placed exactly
/// touching. Impact rather than steady state: one tick goes from a quiet
/// island to thousands of simultaneous high-energy contacts.
const SMASH_COLUMNS: int = 25;
const SMASH_ROWS: int = 25;
const SMASH_DEPTH: int = 8;

fn smash() -> load::Case {
    let c = case("smash", SMASH_COLUMNS * SMASH_ROWS * SMASH_DEPTH, 90, [-24.0, 26.0, 62.0, -4.0, 11.0, 0.0]);
    c.setup = ground;
    c.place = smash_body;
    c.after = smash_shot;
    c.extra = spread;
    c
}

fn smash_body(w: world::World, c: load::Case, i: int) {
    world::body(w, smash_at(i), box3(0.5, 0.5, 0.5));
}

fn smash_shot(w: world::World, c: load::Case) {
    let ox = -0.5 * ((SMASH_COLUMNS - 1) as float) * BOX;
    let shot = world::body(w, [ox - 30.0, (SMASH_ROWS as float) * BOX * 0.5, 0.0],
        map().with("kind", "sphere").with("radius", 1.6));
    shot.patch_component("body3d", map()
        .with("mass", 800.0)
        .with("gravity_scale", 0.0)
        .with("continuous_collision", true));
    shot.body3d.set_linear_velocity(120.0, 0.0, 0.0);
}

fn smash_at(i: int) -> Vec3 {
    let ox = -0.5 * ((SMASH_COLUMNS - 1) as float) * BOX;
    let oz = -0.5 * ((SMASH_DEPTH - 1) as float) * BOX;
    let per_column = SMASH_ROWS * SMASH_DEPTH;
    let col = i / per_column;
    let rest = i % per_column;
    [
        ox + (col as float) * BOX,
        BOX * (0.5 + ((rest / SMASH_DEPTH) as float)),
        oz + ((rest % SMASH_DEPTH) as float) * BOX,
    ]
}

/// How far the wall flew, and whether anything went non-finite: the two
/// numbers that tell an unstable solver's speed from a stable one's.
fn spread(w: world::World, c: load::Case) -> any {
    let centre: Vec3 = [0.0, 0.0, 0.0];
    let counted = 0;
    for body in w.bodies {
        let p = body.transform.position;
        if finite(p) {
            centre = [centre.x + p.x, centre.y + p.y, centre.z + p.z];
            counted += 1;
        }
    }
    if counted > 0 {
        let n = counted as float;
        centre = [centre.x / n, centre.y / n, centre.z / n];
    }
    let worst = 0.0;
    let non_finite = 0;
    for body in w.bodies {
        let p = body.transform.position;
        if finite(p) {
            let far = world::distance(p, centre);
            if far > worst {
                worst = far;
            }
        } else {
            non_finite += 1;
        }
    }
    map().with("spread", worst).with("non_finite", non_finite)
}

fn finite(p: Vec3) -> bool {
    stats::finite(p.x) && stats::finite(p.y) && stats::finite(p.z)
}

/// Queries against a populated broad phase: 8,000 static and 2,000 moving
/// bodies, hit every tick with a fixed mix of rays, shape casts and point
/// queries whose origins sweep the volume. This measures the acceleration
/// structure, and the seam a script crosses to reach it.
const STATICS: int = 8000;
const MOVERS: int = 2000;
const FIELD: float = 60.0;
const RAYS: int = 500;
const CASTS: int = 100;
const POINTS: int = 150;

fn query_storm() -> load::Case {
    let c = case("query_storm", STATICS + MOVERS, 0, [165.0, 120.0, 165.0, 0.0, 0.0, 0.0]);
    c.place = storm_body;
    c.step = storm;
    c.extra = storm_extra;
    c
}

fn storm_body(w: world::World, c: load::Case, i: int) {
    if i < STATICS {
        let node = world::fixed(w, scatter(),
            box3(random::range(0.4, 1.2), random::range(0.4, 1.2), random::range(0.4, 1.2)));
        node.transform.rotation_euler = [
            random::range(-3.14159, 3.14159),
            random::range(-3.14159, 3.14159),
            random::range(-3.14159, 3.14159),
        ];
    } else {
        let node = world::body(w, scatter(), map().with("kind", "sphere").with("radius", random::range(0.3, 0.8)));
        node.patch_component("body3d", map().with("gravity_scale", 0.0));
        node.body3d.set_linear_velocity(random::range(-2.0, 2.0), random::range(-2.0, 2.0), random::range(-2.0, 2.0));
    }
}

fn storm_extra(w: world::World, c: load::Case) -> any {
    map().with("queries", w.queries).with("hits", w.hits)
}

fn scatter() -> Vec3 {
    [random::range(-FIELD, FIELD), random::range(-FIELD, FIELD), random::range(-FIELD, FIELD)]
}

fn storm(w: world::World, c: load::Case, tick: int) {
    let phase = (tick as float) * 0.017;
    for i in 0..RAYS {
        let a = phase + 6.28318 * (i as float) / (RAYS as float);
        let h = math::sin(phase * 0.7 + (i as float)) * FIELD * 0.5;
        let x = math::cos(a) * FIELD;
        let z = math::sin(a) * FIELD;
        let hit = physics3d::raycast(map()
            .with("from", [x, h, z])
            .with("dir", [-x, -h, -z])
            .with("max", FIELD * 2.5));
        count(w, !hit.is_nil());
    }
    for i in 0..CASTS {
        let a = phase * 1.7 + 6.28318 * (i as float) / (CASTS as float);
        let x = math::cos(a) * FIELD;
        let y = math::sin(a) * FIELD * 0.4;
        let z = math::sin(a) * FIELD;
        let hit = physics3d::shapecast(map()
            .with("shape", map().with("kind", "sphere").with("radius", 0.8))
            .with("from", [x, y, z])
            .with("dir", [-x, -y, -z])
            .with("max", 2.0));
        count(w, !hit.is_nil());
    }
    for i in 0..POINTS {
        let a = phase * 2.3 + 6.28318 * (i as float) / (POINTS as float);
        let hits = physics3d::overlap_point(map().with("point", [
            math::cos(a) * FIELD * 0.6,
            math::sin(a * 1.3) * FIELD * 0.4,
            math::sin(a) * FIELD * 0.6,
        ]));
        count(w, hits.len() > 0);
    }
}

fn count(w: world::World, hit: bool) {
    w.queries += 1;
    if hit {
        w.hits += 1;
    }
}

/// 8,000 boxes dropped into a walled pit: they fall, collide and pile deep,
/// so the measurement is an active contact-heavy pile rather than a settled
/// one.
const PIT: float = 9.2;
const GAP: float = 1.15;

fn drop() -> load::Case {
    let c = case("drop", 8000, 0, [0.0, 46.0, 80.0, 0.0, 20.0, 0.0]);
    c.setup = pit;
    c.place = drop_body;
    c
}

fn pit(w: world::World, c: load::Case) {
    world::fixed(w, [0.0, -0.5, 0.0], box3(PIT + 4.0, 0.5, PIT + 4.0));
    let along = PIT + 0.5;
    world::wall(w, [along, 40.0, 0.0], box3(0.5, 40.0, PIT));
    world::wall(w, [-along, 40.0, 0.0], box3(0.5, 40.0, PIT));
    world::wall(w, [0.0, 40.0, along], box3(PIT, 40.0, 0.5));
    world::wall(w, [0.0, 40.0, -along], box3(PIT, 40.0, 0.5));
}

fn drop_body(w: world::World, c: load::Case, i: int) {
    let per_side = math::floor(PIT * 2.0 / GAP) as int;
    let per_layer = per_side * per_side;
    let origin = -0.5 * ((per_side - 1) as float) * GAP;
    let within = i % per_layer;
    let at: Vec3 = [
        origin + ((within / per_side) as float) * GAP,
        1.0 + ((i / per_layer) as float) * GAP,
        origin + ((within % per_side) as float) * GAP,
    ];
    world::body(w, at, box3(0.5, 0.5, 0.5));
}

/// A box from its half extents, which is how every case here measures one.
fn box3(x: float, y: float, z: float) -> any {
    map().with("kind", "box").with("size", [x * 2.0, y * 2.0, z * 2.0])
}
