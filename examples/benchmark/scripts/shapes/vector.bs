// Vector maths, which is what a movement or a look-at does several times a
// frame: a sum, a length and a scale, written out on the fields.

pub class Vector {
    node: Node,
    out: Vec3,
}

impl Vector {
    fn update(dt: float) {
        let a = vec3(1.0, 2.0, 3.0);
        let b = vec3(dt, 0.5, 1.0);
        let sum = vec3(a.x + b.x, a.y + b.y, a.z + b.z);
        let scale = 2.0 / math::sqrt(sum.x * sum.x + sum.y * sum.y + sum.z * sum.z);
        self.out = vec3(sum.x * scale, sum.y * scale, sum.z * scale);
    }
}
