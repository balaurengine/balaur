// Writing the node's transform every frame, which is what anything that
// moves under its own script does.
pub fn init(this) {
    this.t = 0.0;
    this.home = this.node.transform.position;
}

pub fn update(this, dt) {
    this.t += dt;
    let at = this.home;
    this.node.transform.position = [at[0], at[1] + math::sin(this.t) * 4.0, at[2]];
}
