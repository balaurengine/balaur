// The figure falls over and gets back up: a blend tweened between the clip
// and the bodies the scene carries for each bone. Nothing else here is a
// script, because everything else is what a scene file says.

pub class Fall {
    node: Node,
    at: float,
    limp: bool,
}

const LIMP: float = 2.2;

const UPRIGHT: float = 3.4;

impl Fall {
    pub fn init() {
        self.at = 0.0;
        self.limp = false;
    }

    pub fn update(dt: float) {
        self.at += dt;
        // Upright for a few seconds, limp for a couple, forever. Upright first,
        // so the figure is seen doing what the clip says before it falls.
        let period = LIMP + UPRIGHT;
        let phase = self.at - math::floor(self.at / period) * period;
        let limp = phase >= UPRIGHT;
        if limp != self.limp {
            self.limp = limp;
            // Not a step: a tween is what makes the transfer readable, and the
            // way back up is slower than the way down.
            animation::tween(self.node, animation::Tween {
                steps: [
                    animation::Step {
                        property: "ragdoll/influence",
                        to: if limp { 1.0 } else { 0.0 },
                        duration: if limp { 0.25 } else { 0.9 },
                        ease: animation::EASE_IN_OUT_SINE,
                    },
                ],
            });
        }
    }
}
