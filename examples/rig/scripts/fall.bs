// The figure falls over and gets back up: a ragdoll built from its own bones
// at load, and a blend tweened between the clip and the simulation. Nothing
// else here is a script, because everything else is what a scene file says.

pub struct Fall {
    node: Node,
    at: float,
    limp: bool,
}

pub struct Ax {
    axis: any,
    limits: [float],
}

pub struct Step {
    property: str,
    to: float,
    duration: float,
    ease: any,
}

const LIMP: float = 2.2;

const UPRIGHT: float = 3.4;

impl Fall {
    pub fn init() {
        self.at = 0.0;
        self.limp = false;
        // An influence of zero: the bodies simulate from the first frame, so the pose
        // is one they fell into. The hinge limits keep a collapse a body, not a bag.
        physics2d::ragdoll(self.node, map()
            .with("influence", 0.0)
            .with("thickness", 0.22)
            .with("friction", 0.9)
            .with("axes", [Ax { axis: physics2d::AXIS_ROTATION, limits: [-0.7, 0.7] }]));
    }

    pub fn update(dt: float) {
        self.at += dt;
        // Upright for a few seconds, limp for a couple, forever. Upright first,
        // so the figure is seen doing what the clip says before it falls.
        let period = LIMP + UPRIGHT;
        let phase = self.at - math::floor(self.at / period) * period;
        let limp = phase >= UPRIGHT;
        if limp != self.limp {
            self.limp = limp;
            // Not a step: a tween is what makes the transfer readable, and the
            // way back up is slower than the way down.
            animation::tween(self.node, map()
                .with("steps", [
                    Step {
                        property: "ragdoll/influence",
                        to: if limp { 1.0 } else { 0.0 },
                        duration: if limp { 0.25 } else { 0.9 },
                        ease: animation::EASE_IN_OUT_SINE,
                    },
                ]));
        }
    }
}
