// Spins in place; press Space (windowed runs) to reverse direction. Edit SPEED
// while `balaur run` is going: the change applies the moment you save.
//
// A script is a set of free functions taking the instance as `this`. The host
// makes one instance per node and hands it back on every call.

const SPEED = 2.0;

pub fn init(this) {
    this.angle = 0.0;
    this.direction = 1.0;
}

pub fn update(this, dt) {
    if input::just_pressed(input::KEY_SPACE) {
        this.direction = -this.direction;
    }
    this.angle += dt * SPEED * this.direction;
    this.node.set_rotation_euler(0.0, this.angle, 0.0);
}
