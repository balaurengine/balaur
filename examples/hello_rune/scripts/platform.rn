// A moving platform that this script does not move.
//
// The motion comes from animations/platform.toml, sampled by the engine on a
// fixed 1/60 timestep, and the platform is a kinematic body, so physics reads
// the animated transform and anything standing on it is carried along.
//
// The `animation` module is declared once against the scripting seam, so this
// is the same API the Luau twin calls, spelled the way Rune spells it.

pub fn init(this) {
    this.turns = 0;
}

pub fn update(this, dt) {
    // P holds the clip where it is; P again carries on from there. `stop`
    // would end it instead, leaving nothing to resume.
    if input::just_pressed(input::KEY_P) {
        if animation::is_playing(this.node) {
            animation::pause(this.node);
        } else {
            animation::resume(this.node);
        }
    }
}

// Called by the clip's method track, not by anything here.
pub fn on_reached_end(this) {
    this.turns += 1;
    // A tween is a clip generated on the spot: it reads the value the node
    // has right now and animates from it, through the same sampler and the
    // same fixed step a clip asset goes through.
    animation::tween(this.node, #{
        "steps": [
            #{ "property": "color/rgba", "to": [1.0, 0.8, 0.25, 1.0], "duration": 0.25 },
            #{ "property": "color/rgba", "to": [0.55, 0.35, 0.8, 1.0], "duration": 0.75, "ease": "out_quad" },
        ],
    });
    println!("platform turned {} time(s)", this.turns);
}
