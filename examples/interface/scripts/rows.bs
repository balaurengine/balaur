// The three row views over one set of entries. The rows are `screen.bs`'s,
// used as a module, so the gallery and this screen say the same thing about
// the same data.

use screen;

pub class Rows {
    /// Where a picture of the screen goes, for the manual's shot.
    /// `--shot=<path>` after `--` says where; without it the screen is a
    /// screen, as `shot.bs` has it for the other two scenes here.
    pub shot: str = "",
    node: Node,
    frame: int,
    cards: [ui::Item],
}

fn asked() -> str {
    for arg in engine::args() {
        let parts = arg.split("=");
        if parts[0] == "--shot" && parts.len() > 1 {
            return parts[1];
        }
    }
    ""
}

const LIST: str = "Sheet/Views/ListBox/List";

impl Rows {
    fn fill(name: str, params: any) {
        let found = self.node.get_node(name);
        if found.is_valid() {
            found.patch_component("widget", params);
        }
    }

    fn init() {
        self.frame = 0;
        self.shot = asked();
        self.cards = screen::cards_in_order();
        // Two rows held at once, which is what `multi` is for; a script reads
        // `selection` back rather than the one row `text` carries.
        self.fill(LIST, {
            "items": self.cards,
            "selection": [self.cards[1].label.unwrap(), self.cards[2].label.unwrap()],
            "text": self.cards[2].label.unwrap(),
        });
        self.fill("Sheet/Views/TreeBox/Outline", { "items": screen::outline() });
        self.fill("Sheet/Views/TableBox/Table", { "items": screen::table() });
    }

    /// A row dropped somewhere else in the list, which the kind reports and this
    /// acts on: the view draws the rows a script hands it, so moving one is
    /// moving it here.
    pub fn on_move(what: any) {
        let moved = what[0].as_str();
        let onto = what[1].as_str();
        let side = what[2].as_str();
        let held = self.cards[0];
        for row in self.cards {
            if row.label.unwrap() == moved {
                held = row;
            }
        }
        let out: [ui::Item] = [];
        for row in self.cards {
            let name = row.label.unwrap();
            if name == moved {
                continue;
            }
            if name == onto && side == "before" {
                out.push(held);
            }
            out.push(row);
            if name == onto && side != "before" {
                out.push(held);
            }
        }
        self.cards = out;
        self.fill(LIST, { "items": out, "text": moved, "selection": [moved] });
    }

    // Late enough that the layout has settled and the rows are in.
    fn update(dt: float) {
        self.frame += 1;
        if self.frame == 30 && self.shot != "" {
            render::screenshot(self.shot);
        }
    }
}
