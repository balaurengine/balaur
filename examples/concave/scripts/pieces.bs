// What a `convex_decomposition` collider2d actually holds, drawn over the
// body itself: convex pieces, each grown through the seams it shares.
// Why: https://box2d.org/posts/2020/04/stuck-inside/

pub struct Pieces {
    pub shot: str = "",
    pub frames: str = "",
    node: Node,
    frame: int,
}

fn TABLE() -> [[float]] {
    [
        [0.0, 0.0],
        [0.3, 0.0],
        [0.3, 1.0],
        [1.7, 1.0],
        [1.7, 0.0],
        [2.0, 0.0],
        [2.0, 1.2],
        [0.0, 1.2],
    ]
}

// Where each table's node stands, so a piece comes back in world space.
fn PLAIN_AT() -> [float] {
    [-2.6, -0.6]
}

fn GROWN_AT() -> [float] {
    [0.6, -0.6]
}

// One per piece, translucent: where two pieces cover the same ground the
// tints stack, and that band is the overlap the seam gained.
fn TINTS() -> [[float]] {
    [
        [0.88, 0.42, 0.28, 0.55],
        [0.29, 0.56, 0.82, 0.55],
        [0.37, 0.69, 0.54, 0.55],
        [0.79, 0.63, 0.25, 0.55],
    ]
}

fn EDGE() -> [float] {
    [1.0, 1.0, 1.0, 0.35]
}

fn INK() -> [float] {
    [0.93, 0.94, 0.96, 1.0]
}

fn FAINT() -> [float] {
    [0.62, 0.66, 0.72, 1.0]
}

impl Pieces {
    pub fn init() {
        self.frame = 0;
        render::set_background(0.07, 0.08, 0.10);
        render::set_camera_2d(0.0, 0.05, 250.0);
    }
}

// The table's outline where that table stands, so the pieces come back in
// world space and go straight to the renderer.
fn table_at(at: [float]) -> [[float]] {
    let out: [[float]] = [];
    for point in TABLE() {
        out.push([point[0] + at[0], point[1] + at[1]]);
    }
    out
}

fn draw_pieces(at: [float], overlap: float) -> int {
    let cut = geometry2d::convex_decomposition(table_at(at), map().with("overlap", overlap));
    let which = 0;
    for piece in cut {
        render::draw_polygon_2d(piece, TINTS()[which % TINTS().len()]);
        render::draw_polyline_2d(piece, 1.5, EDGE());
        which += 1;
    }
    cut.len()
}

fn label(x: float, y: float, text: str, size: float, color: [float]) {
    render::draw_text_2d(x, y, text, map().with("font_size", size).with("color", color).with("text_align", "center"));
}

impl Pieces {
    pub fn update(dt: float) {
        let plain = draw_pieces(PLAIN_AT(), 0.0);
        let grown = draw_pieces(GROWN_AT(), 0.9);
        label(-1.6, 1.25, "overlap = 0", 26.0, INK());
        label(1.6, 1.25, "overlap = 0.9", 26.0, INK());
        label(-1.6, 0.95, "{plain} pieces, edge to edge", 18.0, FAINT());
        label(1.6, 0.95, "{grown} pieces, grown through the seams", 18.0, FAINT());
        label(-1.6, -1.15, "the beam stays wedged", 18.0, FAINT());
        label(1.6, -1.15, "the beam is pushed out", 18.0, FAINT());
        self.frame += 1;
        // Late enough that both beams have settled where the solver leaves them.
        if self.frame == 100 && self.shot != "" {
            render::screenshot(self.shot);
        }
        // Four seconds at one picture a frame, the beam being pushed out. The
        // very first frame is taken before anything has drawn, so it is skipped.
        if self.frames != "" && self.frame >= 2 && self.frame <= 121 {
            render::screenshot("{self.frames}/{padded(self.frame)}.png");
        }
    }
}

// Three digits, so a directory listing plays the frames in order.
fn padded(n: int) -> str {
    if n < 10 {
        "00{n}"
    } else if n < 100 {
        "0{n}"
    } else {
        "{n}"
    }
}
